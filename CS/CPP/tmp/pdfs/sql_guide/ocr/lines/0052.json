{"page":52,"width":1898,"height":2501,"text_angle":0,"lines":[{"text":"과목 1 데이터 모일링의 이해","words":[{"text":"과목","x":185,"y":101,"width":60,"height":31},{"text":"1","x":273,"y":102,"width":12,"height":30},{"text":"데이터","x":312,"y":100,"width":86,"height":32},{"text":"모일링의","x":416,"y":103,"width":113,"height":31},{"text":"이해","x":548,"y":103,"width":54,"height":31}]},{"text":"에매한 동수를 피한다. 예를 들면 \u0027관계된다\u0027, \u0027관련이 있다\u0027, \u0027이다\u0027, \u0027한다\u0027 등은 구체적이지 않아 어떤 행위가","words":[{"text":"에매한","x":269,"y":254,"width":95,"height":33},{"text":"동수를","x":376,"y":252,"width":91,"height":35},{"text":"피한다.","x":480,"y":253,"width":95,"height":34},{"text":"예를","x":589,"y":253,"width":59,"height":33},{"text":"들면","x":661,"y":252,"width":58,"height":34},{"text":"\u0027관계된다\u0027,","x":731,"y":251,"width":141,"height":37},{"text":"\u0027관련이","x":887,"y":251,"width":94,"height":33},{"text":"있다\u0027,","x":998,"y":250,"width":72,"height":37},{"text":"\u0027이다\u0027,","x":1084,"y":250,"width":83,"height":38},{"text":"\u0027한다\u0027","x":1181,"y":251,"width":74,"height":32},{"text":"등은","x":1267,"y":251,"width":61,"height":31},{"text":"구체적이지","x":1340,"y":250,"width":150,"height":33},{"text":"않아","x":1506,"y":250,"width":61,"height":33},{"text":"어떤","x":1579,"y":249,"width":61,"height":33},{"text":"행위가","x":1653,"y":249,"width":96,"height":34}]},{"text":"있는지 또는 두 참여자 간 어떤 관계가 있는지 파악할 수 없다.","words":[{"text":"있는지","x":272,"y":307,"width":91,"height":32},{"text":"또는","x":382,"y":309,"width":61,"height":30},{"text":"두","x":459,"y":309,"width":31,"height":31},{"text":"참여자","x":506,"y":306,"width":89,"height":33},{"text":"간","x":610,"y":306,"width":31,"height":32},{"text":"어떤","x":655,"y":305,"width":57,"height":34},{"text":"관계가","x":730,"y":304,"width":90,"height":34},{"text":"있는지","x":837,"y":304,"width":86,"height":33},{"text":"파악할","x":942,"y":304,"width":92,"height":33},{"text":"수","x":1048,"y":304,"width":32,"height":32},{"text":"없다.","x":1095,"y":303,"width":66,"height"