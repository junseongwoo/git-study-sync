0,"width":56,"height":24},{"text":"알고리즘을","x":1223,"y":619,"width":137,"height":28},{"text":"사용","x":1372,"y":618,"width":59,"height":28}]},{"text":"한다 SQL 뇨n℃1어서 같은 역할을 하는 메모리 영역을 \u0027프로시저 개시(Procedure Cache)\u0027라고 부른다.","words":[{"text":"한다","x":164,"y":663,"width":54,"height":28},{"text":"SQL","x":232,"y":665,"width":48,"height":29},{"text":"뇨n℃1어서","x":292,"y":662,"width":122,"height":28},{"text":"같은","x":428,"y":663,"width":48,"height":27},{"text":"역할을","x":489,"y":663,"width":70,"height":28},{"text":"하는","x":572,"y":664,"width":48,"height":27},{"text":"메모리","x":633,"y":664,"width":68,"height":27},{"text":"영역을","x":716,"y":664,"width":72,"height":28},{"text":"\u0027프로시저","x":800,"y":663,"width":100,"height":29},{"text":"개시(Procedure","x":915,"y":663,"width":184,"height":31},{"text":"Cache)\u0027라고","x":1112,"y":664,"width":148,"height":30},{"text":"부른다.","x":1275,"y":663,"width":89,"height":29}]},{"text":"ㆍ 딕셔너리 개시","words":[{"text":"ㆍ","x":194,"y":755,"width":23,"height":24},{"text":"딕셔너리","x":230,"y":752,"width":92,"height":29},{"text":"개시","x":337,"y":752,"width":45,"height":28}]},{"text":"데이터베이스 딕서너리(Dic而n町)는 테이블, 인덱스 같은 오브젝트는 물론 테이불스페이싀 데이터 파일, 세그","words":[{"text":"데이터베이스","x":194,"y":810,"width":137,"height":28},{"text":"딕서너리(Dic而n町)는","x":341,"y":810,"width":253,"height":33},{"text":"테이블,","x":603,"y":810,"width":75,"height":31},{"text":"인덱스","x":691,"y":811,"width":71,"height":28},{"text":"같은","x":771,"y":812,"width":48,"height":27},{"text":"오브젝트는","x":828,"y":812,"width":121,"height":28},{"text":"물론","x":957,"y":813,"width":49,"height":26},{"text":"테이불스페이싀","x":1017,"y":811,"width":178,"height":32},{"text":"데이터","x":1209,"y":813,"width":75,"height":28},{"text":"파일,","x":1298,"y":812,"width":61,"height":31},{"text":"세그","x":1374,"y":813,"width":60,"height":27}]},{"text":"먼특 익스텐특 사용자, 제으새 관한 메타 정보를 저장하는 곳이다. 그리고 딕셔너리 개시는 말 그대로 딕서너리","words":[{"text":"먼특","x":163,"y":856,"width":52,"height":30},{"text":"익스텐특","x":227,"y":855,"width":99,"height":31},{"text":"사용자,","x":338,"y":855,"width":77,"height":31},{"text":"제으새","x":428,"y":855,"width":69,"height":28},{"text":"관한","x":507,"y":856,"width":49,"height":27},{"text":"메타","x":566,"y":856,"width":49,"height":27},{"text":"정보를","x":625,"y":856,"width":71,"height":28},{"text":"저장하는","x":706,"y":856,"width":97,"height":28},{"text":"곳이다.","x":812,"y":857,"width":79,"height":28},{"text":"그리고","x":904,"y":857,"width":74,"height":28},{"text":"딕셔너리","x":989,"y":856,"width":95,"height":29},{"text":"개시는","x":1098,"y":857,"width":76,"height":28},{"text":"말","x":1185,"y":857,"width":26,"height":28},{"text":"그대로","x":1221,"y":858,"width":83,"height":28},{"text":"딕서너리","x":1317,"y":857,"width":110,"height":29}]},{"text":"정보를 캐상하는 메모리 영역이다. \u0027주문\u0027 테이블을 예로 들면, 입력한 주문 데이터는 데이터 파일에 저장됐다가","words":[{"text":"정보를","x":163,"y":901,"width":69,"height":28},{"text":"캐상하는","x":242,"y":901,"width":94,"height":28},{"text":"메모리","x":347,"y":900,"width":69,"height":28},{"text":"영역이다.","x":430,"y":900,"width":100,"height":29},{"text":"\u0027주문\u0027","x":544,"y":902,"width":58,"height":27},{"text":"테이블을","x":615,"y":902,"width":96,"height":28},{"text":"예로","x":721,"y":901,"width":48,"height":28},{"text":"들면,","x":780,"y":901,"width":55,"height":32},{"text":"입력한","x":850,"y":902,"width":73,"height":28},{"text":"주문","x":934,"y":904,"width":49,"height":27},{"text":"데이터는","x":995,"y":902,"width":99,"height":29},{"text":"데이터","x":1107,"y":902,"width":71,"height":28},{"text":"파일에","x":1193,"y":902,"width":79,"height":28},{"text":"저장됐다가","x":1286,"y":902,"width":145,"height":30}]},{"text":"버퍼 캐시를 경유해 읽히지만, 테이블 메다 정보는 딕셔너리에 저장됐다가 딕셔너리 개시를 경유해 읽힌다.","words":[{"text":"버퍼","x":161,"y":947,"width":44,"height":27},{"text":"캐시를","x":219,"y":947,"width":71,"height":29},{"text":"경유해","x":303,"y":947,"width":68,"height":29},{"text":"읽히지만,","x":386,"y":947,"width":99,"height":31},{"text":"테이블","x":500,"y":947,"width":73,"height":29},{"text":"메다","x":585,"y":948,"width":49,"height":28},{"text":"정보는","x":64