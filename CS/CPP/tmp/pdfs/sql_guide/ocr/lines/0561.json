42,"width":74,"height":29},{"text":"전체를","x":322,"y":942,"width":74,"height":29},{"text":"스캔할","x":404,"y":941,"width":74,"height":29},{"text":"때보다","x":488,"y":940,"width":72,"height":29},{"text":"오히려","x":570,"y":941,"width":71,"height":28},{"text":"더","x":654,"y":941,"width":21,"height":28},{"text":"느려진다.","x":687,"y":939,"width":102,"height":29},{"text":"lndex","x":801,"y":940,"width":70,"height":25},{"text":"Range","x":882,"y":942,"width":77,"height":31},{"text":"Scan에","x":970,"y":940,"width":85,"height":28},{"text":"의한","x":1067,"y":940,"width":54,"height":29},{"text":"테이블","x":1132,"y":942,"width":80,"height":29},{"text":"액세스가","x":1224,"y":942,"width":110,"height":29},{"text":"Table","x":1344,"y":943,"width":81,"height":25},{"text":"Full","x":1440,"y":942,"width":57,"height":25}]},{"text":"뇨n보다 느려지는 지점을 흔히 \u0027손익 분기점\u0027이라고 부른다. 예를 들어 인덱스 손익분기점이 10%라는 의미는","words":[{"text":"뇨n보다","x":176,"y":990,"width":112,"height":27},{"text":"느려지는","x":298,"y":989,"width":100,"height":29},{"text":"지점을","x":410,"y":989,"width":73,"height":28},{"text":"흔히","x":494,"y":987,"width":47,"height":29},{"text":"\u0027손익","x":555,"y":987,"width":52,"height":29},{"text":"분기점\u0027이라고","x":621,"y":987,"width":153,"height":29},{"text":"부른다.","x":786,"y":986,"width":80,"height":29},{"text":"예를","x":881,"y":986,"width":50,"height":29},{"text":"들어","x":944,"y":986,"width":48,"height":30},{"text":"인덱스","x":1009,"y":986,"width":78,"height":30},{"text":"손익분기점이","x":1099,"y":989,"width":157,"height":29},{"text":"10%라는","x":1275,"y":988,"width":117,"height":28},{"text":"의미는","x":1406,"y":987,"width":92,"height":29}]},{"text":"1勵개 중 1%개 레코드 이상을 읽을 때는 인덱스를 이용하는 것보다 테이블 전체를 스캔하는 것이 더 빠르다는","words":[{"text":"1勵개","x":177,"y":1035,"width":78,"height":29},{"text":"중","x":267,"y":1037,"width":26,"height":27},{"text":"1%개","x":304,"y":1035,"width":63,"height":29},{"text":"레코드","x":380,"y":1036,"width":73,"height":28},{"text":"이상을","x":464,"y":1034,"width":72,"height":29},{"text":"읽을","x":547,"y"