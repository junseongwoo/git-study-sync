{"page":14,"width":1993,"height":2535,"text_angle":0,"lines":[{"text":"과목 1 데이터 모델링의 이해","words":[{"text":"과목","x":202,"y":105,"width":62,"height":33},{"text":"1","x":292,"y":106,"width":12,"height":30},{"text":"데이터","x":331,"y":105,"width":87,"height":32},{"text":"모델링의","x":435,"y":106,"width":119,"height":33},{"text":"이해","x":573,"y":106,"width":58,"height":31}]},{"text":"소중한 비즈니스의 기회 상실로 연결될 수 있는 문제다. 데이터 품질(Data Quahty)의 문제가 중요한 이유가 여기에","words":[{"text":"소중한","x":203,"y":261,"width":95,"height":34},{"text":"비즈니스의","x":310,"y":258,"width":149,"height":36},{"text":"기회","x":476,"y":258,"width":56,"height":35},{"text":"상실로","x":548,"y":258,"width":91,"height":35},{"text":"연결될","x":650,"y":258,"width":88,"height":34},{"text":"수","x":752,"y":259,"width":31,"height":32},{"text":"있는","x":795,"y":257,"width":60,"height":34},{"text":"문제다.","x":866,"y":259,"width":97,"height":33},{"text":"데이터","x":979,"y":258,"width":85,"height":35},{"text":"품질(Data","x":1078,"y":259,"width":139,"height":37},{"text":"Quahty)의","x":1229,"y":260,"width":144,"height":40},{"text":"문제가","x":1387,"y":261,"width":93,"height":34},{"text":"중요한","x":1490,"y":262,"width":91,"height":34},{"text":"이유가","x":1593,"y":262,"width":91,"height":34},{"text":"여기에","x":1695,"y":261,"width":91,"height":35}]},{"text":"있다. 데이터 품질의 문제는 데이터 구조가 설계되고 초기에 데이터가 조금 쌓일 때에는 인지하지 못하는 경우가","words":[{"text":"있다.","x":204,"y":315,"width":71,"height":34},{"text":"데이터","x":292,"y":313,"width":92,"height":34},{"text":"품질의","x":398,"y":313,"width":91,"height":35},{"text":"문제는","x":504,"y":314,"width":96,"height":33},{"text":"데이터","x":613,"y":312,"width":87,"height":35},{"text":"구조가","x":715,"y":312,"width":94,"height":35},{"text":"설계되고","x":823,"y":312,"width":122,"height":34},{"text":"초기에","x":957,"y":313,"width":91,"height":34},{"text":"데이터가","x":1063,"y":313,"width":121,"height":35},{"text":"조금","x":1196,"y":315,"width":62,"height":31},{"text":"쌓일","x":1272,"y":313,"width":59,"height":35},{"text":"때에는","x":1348,"y":314,"width":92,"height":34},{"text":"인지하지","x":1454,"y":315,"width":117,"height":35},{"text":"못하는","x":1587,"y":317,"width":93,"height":34},{"text":"경우가","x":1693,"y":316,"width":96,"height":34}]},{"text":"대부분이다. 이러한 데이터의 문제는 오랜 기간 숙성된 데이터를 전략적으로 활용하려고 하는 시점에 대두된다.","words":[{"text":"대부분이다.","x":204,"y":368,"width":166,"height":35},{"text":"이러한","x":387,"y":367,"width":96,"height":34},{"text":"데이터의","x":496,"y":367,"width":120,"height":34},{"text":"문제는","x":632,"y":368,"width":94,"height":33},{"text":"오랜","x":738,"y":367,"width":62,"height":33},{"text":"기간","x":816,"y":366,"width":61,"height":35},{"text":"숙성된","x":890,"y":368,"width":91,"height":34},{"text":"데이터를","x":998,"y":368,"width":121,"height":35},{"text":"전략적으로","x":1134,"y":368,"width":154,"height":34},{"text":"활용하려고","x":1301,"y":368,"width":156,"height":35},{"text":"하는","x":1471,"y":370,"width":62,"height":33},{"text":"시점에","x":1547,"y":370,"width":88,"height":33},{"text":"대두된다.","x":1652,"y":369,"width":134,"height":34}]},{"text":"데이터 품질의 문제가 야기되는 중대한 이유 중 하나가 바로 데이터 구조 때문이다. 중복 데이터의 미정의, 데이터","words":[{"text":"데이터","x":245,"y":423,"width":90,"height":35},{"text":"품질의","x":350,"y":422,"width":89,"height":35},{"text":"문제가","x":453,"y":422,"width":92,"height":34},{"text":"야기되는","x":555,"y":422,"width":120,"height":35},{"text":"중대한","x":685,"y":422,"width":90,"height":35},{"text":"이유","x":786,"y":421,"width":60,"height":35},{"text":"중","x":856,"y":424,"width":32,"height":32},{"text":"하나가","x":898,"y":422,"width":92,"height":35},{"text":"바로","x":1000,"y":423,"width":60,"height":34},{"text":"데이터","x":1072,"y":423,"width":85,"height":33},{"text":"구조","x":1172,"y":425,"width":60,"height":31},{"text":"때문이다.","x":1244,"y":422,"width":124,"height":34},{"text":"중복","x":1382,"y":424,"width":62,"height":34},{"text":"데이터의","x":1456,"y":423,"width":114,"height":35},{"text":"미정의,","x":1585,"y":423,"width":95,"height":38},{"text":"데이터","x":1696,"y":422,"width":90,"height":36}]},{"text":"구조에서 비즈니스 정의의 불충분 동일한 성격의 데이터를 통합하지 않고 분리함으로써 나타나는 데이터 불일치","words":[{"text":"구조에서","x":205,"y":480,"width":126,"height":34},{"text":"비즈니스","x":347,"y":478,"width":126,"height":35},{"text":"정의의","x":486,"y":478,"width":88,"height":35},{"text":"불충분","x":589,"y":479,"width":93,"height":34},{"text":"동일한","x":704,"y":478,"width":92,"height":35},{"text":"성격의","x":808,"y":477,"width":89,"height":35},{"text":"데이터를","x":913,"y":478,"width":122,"height":34},{"text":"통합하지","x":1047,"y":478,"width":119,"height":35},{"text":"않고","x":1182,"y":477,"width":62,"height":34},{"text":"분리함으로써","x":1256,"y":477,"width":182,"height":35},{"text":"나타나는","x":1454,"y":478,"width":121,"height":35},{"text":"데이터","x":1588,"y":478,"width":88,"height":34},{"text":"불일치","x":1692,"y":479,"width":93,"height":34}]},{"text":"등의 데이터 구조의 문제 때문에 데이터 품질 문제는 바로잡기 불가능한 경우가 대부분이다.","words":[{"text":"등의","x":205,"y":535,"width":62,"height":34},{"text":"데이터","x":288,"y":534,"width":92,"height":35},{"text":"구조의","x":398,"y":533,"width":91,"height":35},{"text":"문제","x":507,"y":534,"width":61,"height":34},{"text":"때문에","x":586,"y":534,"width":90,"height":34},{"text":"데이터","x":695,"y":533,"width":87,"height":35},{"text":"품질","x":800,"y":532,"width":60,"height":35},{"text":"문제는","x":877,"y":533,"width":93,"height":33},{"text":"바로잡기","x":985,"y":532,"width":119,"height":36},{"text":"불가능한","x":1123,"y":531,"width":124,"height":35},{"text":"경우가","x":1263,"y":531,"width":92,"height":35},{"text":"대부분이다.","x":1371,"y":533,"width":159,"height":35}]},{"text":"데이터 모델링을 할 때 유의할 점은 다음과 같다.","words":[{"text":"데이터","x":248,"y":590,"width":93,"height":34},{"text":"모델링을","x":360,"y":588,"width":125,"height":35},{"text":"할","x":500,"y":589,"width":33,"height":34},{"text":"때","x":549,"y":589,"width":28,"height":34},{"text":"유의할","x":595,"y":589,"width":93,"height":34},{"text":"점은","x":704,"y":589,"width":60,"height":34},{"text":"다음과","x":779,"y":588,"width":92,"height":34},{"text":"같다.","x":886,"y":587,"width":68,"height":35}]},{"text":"1) 중복","words":[{"text":"1)","x":251,"y":701,"width":27,"height":35},{"text":"중복","x":296,"y":699,"width":65,"height":35}]},{"text":"데이터 모델은 같은 데이터를 A卜우하는 사구려 시간, 장소를 고빨ö卜는 데 도음을 준다. 이러한 지식 응용은 데이터베","words":[{"text":"데이터","x":251,"y":769,"width":89,"height":34},{"text":"모델은","x":353,"y":768,"width":90,"height":33},{"text":"같은","x":455,"y":768,"width":60,"height":33},{"text":"데이터를","x":528,"y":768,"width":118,"height":34},{"text":"A卜우하는","x":656,"y":768,"width":119,"height":35},{"text":"사구려","x":785,"y":768,"width":66,"height":38},{"text":"시간,","x":865,"y":768,"width":66,"height":38},{"text":"장소를","x":944,"y":768,"width":89,"height":35},{"text":"고빨ö卜는","x":1043,"y":767,"width":119,"height":35},{"text":"데","x":1174,"y":767,"width":27,"height":35},{"text":"도음을","x":1215,"y":769,"width":89,"height":33},{"text":"준다.","x":1315,"y":768,"width":66,"height":35},{"text":"이러한","x":1396,"y":768,"width":89,"height":35},{"text":"지식","x":1496,"y":768,"width":55,"height":35},{"text":"응용은","x":1565,"y":769,"width":91,"height":34},{"text":"데이터베","x":1670,"y":768,"width":118,"height":35}]},{"text":"이스가 여러 장소에 같은 정보를 저장하는 잘못을 하지 않도록 한다.","words":[{"text":"이스가","x":211,"y":823,"width":96,"height":35},{"text":"여러","x":323,"y":822,"width":59,"height":35},{"text":"장소에","x":401,"y":822,"width":90,"height":34},{"text":"같은","x":509,"y":823,"width":63,"height":34},{"text":"정보를","x":588,"y":823,"width":91,"height":34},{"text":"저장하는","x":696,"y":823,"width":121,"height":35},{"text":"잘못을","x":834,"y":823,"width":91,"height":34},{"text":"하지","x":940,"y":823,"width":59,"height":35},{"text":"않도록","x":1018,"y":823,"width":92,"height":34},{"text":"한다.","x":1125,"y":822,"width":70,"height":34}]},{"text":"2) 비유연성","words":[{"text":"2)","x":251,"y":937,"width":29,"height":34},{"text":"비유연성","x":300,"y":933,"width":119,"height":34}]},{"text":"데이터 모델을 어떻게 설계했느L는하 따라 사소한 업무 변화에도 데이터 모델이 수시로 변경됨으로써 유지보수의","words":[{"text":"데이터","x":254,"y":1002,"width":88,"height":36},{"text":"모델을","x":355,"y":1002,"width":91,"height":34},{"text":"어떻게","x":458,"y":1002,"width":89,"height":35},{"text":"설계했느L는하","x":562,"y":1002,"width":178,"height":36},{"text":"따라","x":755,"y":1002,"width":61,"height":35},{"text":"사소한","x":827,"y":1002,"width":92,"height":34},{"text":"업무","x":931,"y":1002,"width":61,"height":35},{"text":"변화에도","x":1004,"y":1003,"width":121,"height":35},{"text":"데이터","x":1137,"y":1003,"width":85,"height":35},{"text":"모델이","x":1237,"y":1002,"width":87,"height":35},{"text":"수시로","x":1340,"y":1004,"width":92,"height":34},{"text":"변경됨으로써","x":1445,"y":1003,"width":175,"height":36},{"text":"유지보수의","x":1635,"y":1004,"width":150,"height":35}]},{"text":"어려움을 가중시킬 수 있다. 데이터의 정의를 데이터의 사용 프로세스와 분리함으로써 데이터 모델링은 데이터","words":[{"text":"어려움을","x":214,"y":1059,"width":124,"height":34},{"text":"가중시킬","x":353,"y":1057,"width":119,"height":35},{"text":"수","x":488,"y":1059,"width":32,"height":34},{"text":"있다.","x":536,"y":1058,"width":69,"height":35},{"text":"데이터의","x":624,"y":1059,"width":120,"height":35},{"text":"정의를","x":763,"y":1058,"width":90,"height":35},{"text":"데이터의","x":869,"y":1058,"width":120,"height":35},{"text":"사용","x":1007,"y":1059,"width":62,"height":35},{"text":"프로세스와","x":1082,"y":1059,"width":154,"height":35},{"text":"분리함으로써","x":1250,"y":1059,"width":182,"height":35},{"text":"데이터","x":1452,"y":1059,"width":86,"height":35},{"text":"모델링은","x":1556,"y":1059,"width":124,"height":35},{"text":"데이터","x":1696,"y":1060,"width":90,"height":35}]},{"text":"혹은 프로세스의 작은 변화가 애플리케이션과 데이터베이스에 중대한 변화를 일으킬 기능성을 줄인다.","words":[{"text":"혹은","x":213,"y":1114,"width":64,"height":35},{"text":"프로세스의","x":291,"y":1113,"width":149,"height":35},{"text":"작은","x":459,"y":1113,"width":63,"height":36},{"text":"변화가","x":540,"y":1114,"width":92,"height":35},{"text":"애플리케이션과","x":647,"y":1113,"width":216,"height":35},{"text":"데이터베이스에","x":880,"y":1113,"width":212,"height":35},{"text":"중대한","x":1109,"y":1114,"width":94,"height":35},{"text":"변화를","x":1219,"y":1115,"width":91,"height":34},{"text":"일으킬","x":1327,"y":1114,"width":89,"height":35},{"text":"기능성을","x":1435,"y":1115,"width":120,"height":35},{"text":"줄인다.","x":1571,"y":1114,"width":100,"height":36}]},{"text":"3) 비일관성","words":[{"text":"3)","x":253,"y":1229,"width":29,"height":35},{"text":"비일관성","x":301,"y":1226,"width":118,"height":36}]},{"text":"데이터의 중복이 없더라도 비일관성(lnconsistency)은 발생한다. 예를 들어 신용 상대에 대한 갱신 없이 고객의","words":[{"text":"데이터의","x":256,"y":1299,"width":117,"height":34},{"text":"중복이","x":388,"y":1298,"width":87,"height":35},{"text":"없더라도","x":491,"y":1297,"width":123,"height":36},{"text":"비일관성(lnconsistency)은","x":625,"y":1297,"width":381,"height":40},{"text":"발생한다.","x":1018,"y":1296,"width":128,"height":35},{"text":"예를","x":1160,"y":1296,"width":62,"height":37},{"text":"들어","x":1233,"y":1298,"width":58,"height":35},{"text":"신용","x":1308,"y":1297,"width":58,"height":35},{"text":"상대에","x":1378,"y":1298,"width":89,"height":35},{"text":"대한","x":1482,"y":1298,"width":60,"height":35},{"text":"갱신","x":1553,"y":1299,"width":59,"height":34},{"text":"없이","x":1628,"y":1298,"width":56,"height":34},{"text":"고객의","x":1699,"y":1298,"width":90,"height":35}]},{"text":"납부 이력 정보를 갱신하는 것이다. 개발자가 다른 데이터와 모순된다는 고려 없이 일련의 데이터를 수정할 수","words":[{"text":"납부","x":216,"y":1352,"width":63,"height":35},{"text":"이력","x":294,"y":1354,"width":58,"height":35},{"text":"정보를","x":371,"y":1354,"width":92,"height":35},{"text":"갱신하는","x":477,"y":1353,"width":125,"height":36},{"text":"것이다.","x":617,"y":1353,"width":99,"height":35},{"text":"개발자가","x":733,"y":1352,"width":125,"height":34},{"text":"다른","x":872,"y":1352,"width":63,"height":35},{"text":"데이터와","x":950,"y":1352,"width":123,"height":35},{"text":"모순된다는","x":1087,"y":1352,"width":153,"height":35},{"text":"고려","x":1255,"y":1353,"width":59,"height":35},{"text":"없이","x":1333,"y":1353,"width":57,"height":35},{"text":"일련의","x":1409,"y":1354,"width":86,"height":34},{"text":"데이터를","x":1514,"y":1354,"width":123,"height":34},{"text":"수정할","x":1651,"y":1352,"width":93,"height":35},{"text":"수","x":1759,"y":1355,"width":32,"height":32}]},{"text":"있기 때문이다. 데이터 모델링을 할 때, 데이터와 데이터 간 상호 연관 관계에 대한 명확한 정의는 이러한 위험을","words":[{"text":"있기","x":217,"y":1408,"width":59,"height":36},{"text":"때문이다.","x":291,"y":1410,"width":132,"height":36},{"text":"데이터","x":437,"y":1409,"width":90,"height":35},{"text":"모델링을","x":542,"y":1410,"width":125,"height":35},{"text":"할","x":679,"y":1409,"width":32,"height":35},{"text":"때,","x":724,"y":1409,"width":37,"height":39},{"text":"데이터와","x":777,"y":1408,"width":123,"height":34},{"text":"데이터","x":913,"y":1408,"width":89,"height":34},{"text":"간","x":1018,"y":1408,"width":31,"height":33},{"text":"상호","x":1061,"y":1408,"width":61,"height":34},{"text":"연관","x":1135,"y":1407,"width":61,"height":34},{"text":"관계에","x":1207,"y":1409,"width":90,"height":33},{"text":"대한","x":1314,"y":1408,"width":60,"height":34},{"text":"명확한","x":1387,"y":1409,"width":90,"height":35},{"text":"정의는","x":1490,"y":1409,"width":91,"height":34},{"text":"이러한","x":1594,"y":1408,"width":94,"height":35},{"text":"위험을","x":1699,"y":1407,"width":92,"height":35}]},{"text":"사전에 예방할 수 있도록 해준다.","words":[{"text":"사전에","x":217,"y":1465,"width":91,"height":36},{"text":"예방할","x":327,"y":1466,"width":93,"height":35},{"text":"수","x":434,"y":1466,"width":32,"height":32},{"text":"있도록","x":482,"y":1464,"width":94,"height":36},{"text":"해준다.","x":591,"y":1466,"width":102,"height":34}]},{"text":"4. 데이터 모델링의 3단계 진행","words":[{"text":"4.","x":214,"y":1660,"width":40,"height":39},{"text":"데이터","x":282,"y":1653,"width":129,"height":51},{"text":"모델링의","x":437,"y":1653,"width":175,"height":51},{"text":"3단계","x":637,"y":1653,"width":112,"height":49},{"text":"진행","x":774,"y":1652,"width":84,"height":52}]},{"text":"특별히 데이터 모델은 데이터베이스를 만들어내는 설계서로서 분명한 목표를 가지고 있다. 현실세계에서 데이터","words":[{"text":"특별히","x":254,"y":1775,"width":92,"height":35},{"text":"데이터","x":363,"y":1774,"width":89,"height":35},{"text":"모델은","x":467,"y":1773,"width":95,"height":35},{"text":"데이터베이스를","x":575,"y":1771,"width":211,"height":37},{"text":"만들어내는","x":799,"y":1773,"width":152,"height":35},{"text":"설계서로서","x":962,"y":1772,"width":146,"height":36},{"text":"분명한","x":1123,"y":1772,"width":91,"height":35},{"text":"목표를","x":1224,"y":1773,"width":92,"height":34},{"text":"가지고","x":1328,"y":1770,"width":91,"height":35},{"text":"있다.","x":1432,"y":1769,"width":65,"height":36},{"text":"현실세계에서","x":1512,"y":1769,"width":175,"height":36},{"text":"데이터","x":1704,"y":1768,"width":86,"height":35}]},{"text":"베이스까지 만들어지는 과정은 [그림 1-1-3]과 같이 시간에 따라 진행되는 과정이다. 추상화 수준에 따라 개념적","words":[{"text":"베이스까지","x":216,"y":1831,"width":156,"height":35},{"text":"만들어지는","x":388,"y":1830,"width":158,"height":35},{"text":"과정은","x":557,"y":1830,"width":94,"height":35},{"text":"[그림","x":664,"y":1828,"width":68,"height":38},{"text":"1-1-3]과","x":758,"y":1830,"width":122,"height":37},{"text":"같이","x":892,"y":1830,"width":58,"height":34},{"text":"시간에","x":966,"y":1827,"width":89,"height":37},{"text":"따라","x":1069,"y":1827,"width":62,"height":36},{"text":"진행되는","x":1144,"y":1827,"width":121,"height":37},{"text":"과정이다.","x":1278,"y":1825,"width":129,"height":36},{"text":"추상화","x":1421,"y":1825,"width":92,"height":35},{"text":"수준에","x":1525,"y":1826,"width":89,"height":35},{"text":"따라","x":1628,"y":1824,"width":63,"height":35},{"text":"개념적","x":1702,"y":1824,"width":88,"height":35}]},{"text":"데이터 모델, 논리적 데이터 모델, 물리적 데이터 모델로 정리할 수 있다.","words":[{"text":"데이터","x":216,"y":1887,"width":92,"height":36},{"text":"모델,","x":328,"y":1885,"width":71,"height":39},{"text":"논리적","x":418,"y":1886,"width":92,"height":34},{"text":"데이터","x":530,"y":1885,"width":89,"height":35},{"text":"모델,","x":637,"y":1884,"width":71,"height":38},{"text":"물리적","x":727,"y":1883,"width":90,"height":37},{"text":"데이터","x":839,"y":1885,"width":88,"height":35},{"text":"모델로","x":946,"y":1885,"width":93,"height":33},{"text":"정리할","x":1055,"y":1884,"width":90,"height":35},{"text":"수","x":1159,"y":1885,"width":31,"height":33},{"text":"있다.","x":1208,"y":1883,"width":67,"height":35}]}]}