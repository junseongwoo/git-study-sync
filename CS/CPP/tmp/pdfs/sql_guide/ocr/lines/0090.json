th":74,"height":29},{"text":"주은하면","x":1198,"y":1085,"width":103,"height":30},{"text":"판매자가","x":1312,"y":1085,"width":103,"height":30},{"text":"배송을","x":1425,"y":1085,"width":76,"height":30}]},{"text":"진행한다고 앞서 설명하였다. 이 말은 고객이 주문하는 시점에는 송장번호를 알 수가 없다는 뜻이다. 고객이 주문을","words":[{"text":"진행한다고","x":192,"y":1136,"width":125,"height":32},{"text":"앞서","x":327,"y":1136,"width":47,"height":30},{"text":"설명하였다.","x":387,"y":1134,"width":126,"height":32},{"text":"이","x":526,"y":1134,"width":22,"height":30},{"text":"말은","x":561,"y":1134,"width":49,"height":30},{"text":"고객이","x":619,"y":1134,"width":71,"height":31},{"text":"주문하는","x":702,"y":1136,"width":100,"height":30},{"text":"시점에는","x":812,"y":1134,"width":101,"height":30},{"text":"송장번호를","x":921,"y":1134,"width":128,"height":31},{"text":"알","x":1059,"y":1134,"width":27,"height":30},{"text":"수가","x":1095,"y":1133,"width":52,"height":30},{"text":"없다는","x":1156,"y":1134,"width":77,"height":29},{"text":"뜻이다.","x":1242,"y":1133,"width":84,"height":30},{"text":"고객이","x":1336,"y":1134,"width":75,"height":30},{"text":"주문을","x":1423,"y":1133,"width":77,"height":29}]},{"text":"하였다고 해서 판매자가 바로 비명하지는 않는다. 재고 소진으로 판매자 취소가 발생할 수도 있다. 무엇보다 송장번호는","words":[{"text":"하였다고","x":190,"y":1185,"width":98,"height":31},{"text":"해서","x":298,"y":1184,"width":46,"height":30},{"text":"판매자가","x":355,"y":1183,"width":96,"height":32},{"text":"바로","x":459,"y":1182,"width":48,"height":30},{"text":"비명하지는","x":516,"y":1182,"width":118,"height":31},{"text":"않는다.","x":642,"y":1183,"width":76,"height":31},{"text":"재고","x":730,"y":1184,"width":49,"height":30},{"text":"소진으로","x":787,"y":1182,"width":98,"height":29},{"text":"판매자","x":893,"y":1181,"width":75,"height":30},{"text":"취소가","x":976,"y":1182,"width":75,"height":30},{"text":"발생할","x":1059,"y":1181,"width":75,"height":31},{"text":"수도","x":1142,"y":1182,"width":51,"height":29},{"text":"있다.","x":1202,"y":1181,"width":54,"height":30},{"text":"무엇보다","x":1267,"y":1181,"width":101,"height":31},{"text":"송장번호는","x":1377,"y":1181,"width":123,"height":31}]},{"text":"택배사에게 부여받는 번호이기 때문이다. 고객의 주문이 완료되면, 판매자는 보통 하루에 2~3번 정도 자신에게","words":[{"text":"택배사에게","x":192,"y":1233,"width":126,"height":31},{"text":"부여받는","x":332,"y":1233,"width":100,"height":31},{"text":"번호이기","x":445,"y":1231,"width":96,"height":32},{"text":"때문이다.","x":556,"y":1232,"width":104,"height":31},{"text":"고객의","x":675,"y":1233,"width":74,"height":30},{"text":"주문이","x":763,"y":1230,"width":74,"height":32},{"text":"완료되면,","x":852,"y":1230,"width":108,"height":34},{"text":"판매자는","x":976,"y":1230,"width":103,"height":31},{"text":"보통","x":1091,"y":1232,"width":52,"height":28},{"text":"하루에","x":1155,"y":1229,"width":78,"height":30},{"text":"2~3번","x":1246,"y":1229,"width":70,"height":30},{"text":"정도","x":1331,"y":1231,"width":52,"height":29},{"text":"자신에게","x":1395,"y":1228,"width":103,"height":32}]},{"text":"들어온 주문을 확인한다. 상품페이지에서 \u0027xx시까지 주문한 상품은 당일 발송을 진행합니다과는 문구를 떠올리면","words":[{"text":"들어온","x":190,"y":1282,"width":78,"height":31},{"text":"주문을","x":278,"y":1282,"width":77,"height":30},{"text":"확인한다.","x":364,"y":1281,"width":105,"height":31},{"text":"상품페이지에서","x":482,"y":1280,"width":171,"height":31},{"text":"\u0027xx시까지","x":665,"y":1280,"width":108,"height":31},{"text":"주문한","x":786,"y":1279,"width":77,"height":31},{"text":"상품은","x":873,"y":1278,"width":76,"height":31},{"text":"당일","x":959,"y":1278,"width":49,"height":31},{"text":"발송을","x":1021,"y":1278,"width":78,"height":30},{"text":"진행합니다과는","x":1110,"y":1277,"width":186,"height":31},{"text":"문구를","x":1307,"y":1279,"width":78,"height":30},{"text":"떠올리면","x":1396,"y":1277,"width":103,"height":30}]},{"text":"된다. 판매자가 주문정보를 보고 상품을 포장하여 택배 박스에 팀이야 비로소 송장번호를 받을 준비가 끝난다","words":[{"text":"된다.","x":190,"y":1330,"width":58,"height":30},{"text":"판매자가","x":264,"y":1329,"width":103,"height":31},{"text":"주문정보를","x":378,"y":1329,"width":125,"height":31},{"text":"보고","x":514,"y":1331,"width":52,"height":24},{"text":"상품을","x":579,"y":1328,"width":73,"height":31},{"text":"포장