y":1335,"width":47,"height":30},{"text":"관계는","x":587,"y":1335,"width":73,"height":30},{"text":"이렇게","x":669,"y":1334,"width":70,"height":31},{"text":"설계되지","x":751,"y":1335,"width":95,"height":31},{"text":"않아","x":858,"y":1335,"width":50,"height":30},{"text":"위와","x":916,"y":1336,"width":53,"height":30},{"text":"같은","x":977,"y":1335,"width":52,"height":30},{"text":"어처구니없는","x":1038,"y":1334,"width":152,"height":31},{"text":"일은","x":1200,"y":1334,"width":51,"height":30},{"text":"발생하지","x":1260,"y":1334,"width":102,"height":31},{"text":"않을","x":1374,"y":1334,"width":54,"height":30},{"text":"것이다.","x":1438,"y":1333,"width":81,"height":31}]},{"text":"\u0027반드시 지하철 문이 닫혀야만 지하철은 출발한다\u0027 지하철 출발과 지하철문 닫힘은 필수(Mandato다)적으로 연결","words":[{"text":"\u0027반드시","x":211,"y":1383,"width":85,"height":30},{"text":"지하철","x":310,"y":1383,"width":76,"height":30},{"text":"문이","x":397,"y":1383,"width":49,"height":30},{"text":"닫혀야만","x":459,"y":1382,"width":101,"height":32},{"text":"지하철은","x":569,"y":1383,"width":96,"height":30},{"text":"출발한다\u0027","x":674,"y":1383,"width":105,"height":31},{"text":"지하철","x":790,"y":1383,"width":74,"height":30},{"text":"출발과","x":875,"y":1382,"width":77,"height":31},{"text":"지하철문","x":962,"y":1383,"width":102,"height":31},{"text":"닫힘은","x":1075,"y":1383,"width":79,"height":30},{"text":"필수(Mandato다)적으로","x":1164,"y":1382,"width":294,"height":35},{"text":"연결","x":1468,"y":1381,"width":51,"height":30}]},{"text":"관계가 있는 것이다. 이와 같은 것이 데이터 모델의 관계에서는 필수참여관계(Mandato다)가 된다.","words":[{"text":"관계가","x":211,"y":1430,"width":82,"height":31},{"text":"있는","x":307,"y":1431,"width":52,"height":30},{"text":"것이다.","x":372,"y":1430,"width":82,"height":31},{"text":"이와","x":469,"y":1430,"width":51,"height":32},{"text":"같은","x":532,"y":1431,"width":49,"height":30},{"text":"것이","x":594,"y":1431,"width":46,"height":31},{"text":"데이터","x":655,"y":1430,"width":71,"height":32},{"text":"모델의","x":740,"y":1430,"width":73,"height":31},{"text":"관계에서는","x":828,"y":1430,"width":127,"height":31},{"text":"필수참여관계(Mandato다)가","x":968,"y":1429,"width":342,"height":37},{"text":"된다.","x":1322,"y":1430,"width":60,"height":31}]},{"text":"또 지하철 안내방송 시스템의 예를 들어보자. 지하철 출발을 알리는 안내방송은 지하철의 출발과 상관없이","words":[{"text":"또","x":246,"y":1483,"width":28,"height":22},{"text":"지하철","x":283,"y":1478,"width":73,"height":31},{"text":"안내방송","x":366,"y":1478,"width":98,"height":31},{"text":"시스템의","x":473,"y":1479,"width":91,"height":30},{"text":"예를","x":575,"y":1479,"width":47,"height":30},{"text":"들어보자.","x":630,"y":1479,"width":99,"height":30},{"text":"지하철","x":740,"y":1479,"width":70,"height":30},{"text":"출발을","x":819,"y":1479,"width":73,"height":30},{"text":"알리는","x":901,"y":1478,"width":73,"height":31},{"text":"안내방송은","x":983,"y":1478,"width":126,"height":31},{"text":"지하철의","x":1117,"y":1478,"width":95,"height":31},{"text":"출발과","x":1224,"y":1478,"width":76,"height":31},{"text":"상관없이","x":1308,"y":1478,"width":99,"height":32}]},{"text":"아무런 문제가 발생하지 않는다. 물론 정해진 시간에 방송하면 승객에게 정보로서 유익하겠지만, 꼭 그렇게 할","words":[{"text":"아무런","x":212,"y":1527,"width":79,"height":30},{"text":"문제가","x":305,"y":1526,"width":79,"height":30},{"text":"발생하지","x":396,"y":1526,"width":98,"height":31},{"text":"않는다.","x":509,"y":1526,"width":79,"height":31},{"text":"물론","x":602,"y":1528,"width":49,"height":29},{"text":"정해진","x":664,"y":1527,"width":72,"height":31},{"text":"시간에","x":750,"y":1526,"width":72,"height":31},{"text":"방송하면","x":836,"y":1525,"width":100,"height":31},{"text":"승객에게","x":949,"y":1526,"width":103,"height":32},{"text":"정보로서","x":1067,"y":1526,"width":100,"height":30},{"text":"유익하겠지만,","x":1181,"y":1526,"width":164,"height":35},{"text":"꼭","x":1360,"y":1528,"width":28,"height":30},{"text":"그렇게","x":1400,"y":1526,"width":78,"height":31},{"text":"할","x":1493,"y":1526,"width":27,"height":30}]},{"text":"필요는 없다. 그래서 가끔씩 시스템의 녹•음된 여성의 목소리가 아닌, 남자 기장이 방송8는 경우가 있다. 안내방송","words":[{"text":"필요는","x":212,"y":1575,"width":81,"height":30},{"text":"없다.","x":303,"y":1573,"width":57,"height":30},{"text":"그래서","x":371,"y":1573,"width":74,"height":31},{"text":"가끔씩","x":457,"y":1574,"width":72,"height":31},{"text":"시스템의","x":542,"y":1574,"width":94,"height":31},{"text":"녹•음된","x":647,"y":1575,"width":72,"height":31},{"text":"여성의","x":731,"y":1574,"width":71,"height":32},{"text":"목소리가","x":814,"y":1573,"width":100,"height":32},{"text":"아닌,","x":923,"y":1574,"width":58,"height":35},{"text":"남자","x":994,"y":1575,"width":52,"height":31},{"text":"기장이","x":1056,"y":1574,"width":73,"height":31},{"text":"방송8는","x":1142,"y":1574,"width":104,"height":32},{"text":"경우가","x":1257,"y":1574,"width":78,"height":31},{"text":"있다.","x":1345,"y":1575,"width":58,"height":30},{"text":"안내방송","x":1415,"y":1574,"width":105,"height":31}]},{"text":"시스템이 고장 나도 지하철 운행에는 별로 영향을 주지 않는다. 방송 시점도 조금씩 다르더라도 지하철이 출발하는","words":[{"text":"시스템이","x":212,"y":1622,"width":103,"height":32},{"text":"고장","x":326,"y":1621,"width":52,"height":31},{"text":"나도","x":388,"y":1622,"width":51,"height":29},{"text":"지하철","x":448,"y":1623,"width":72,"height":30},{"text":"운행에는","x":531,"y":1623,"width":97,"height":30},{"text":"별로","x":638,"y":1624,"width":49,"height":29},{"text":"영향을","x":696,"y":1624,"width":72,"height":30},{"text":"주지","x":777,"y":1622,"width":48,"height":31},{"text":"않는다.","x":837,"y":1622,"width":80,"height":31},{"text":"방송","x":929,"y":1623,"width":52,"height":31},{"text":"시점도","x":990,"y":1623,"width":77,"height":30},{"text":"조금씩","x":1074,"y":1622,"width":77,"height":31},{"text":"다르더라도","x":1164,"y":1623,"width":128,"height":31},{"text":"지하철이","x":1301,"y":1622,"width":102,"height":31},{"text":"출발하는","x":1415,"y":1622,"width":104,"height":31}]},{"text":"것과는 밀접하게 연관되지 않는다. 이와 같이 지하철의 출발과 지하철 방송과는 정보로서 관련은 있지만, 서로","words":[{"text":"것과는","x":212,"y":1671,"width":80,"height":30},{"text":"밀접하게","x":305,"y":1669,"width":100,"height":30},{"text":"연관되지","x":419,"y":1670,"width":98,"height":30},{"text":"않는다.","x":532,"y":1669,"width":80,"height":31},{"text":"이와","x":626,"y":1670,"width":50,"height":31},{"t