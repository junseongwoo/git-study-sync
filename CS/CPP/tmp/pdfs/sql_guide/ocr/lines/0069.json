height":33},{"text":"\u0027목록-번호","x":1397,"y":1573,"width":115,"height":29}]},{"text":"등-을 들 수 있다. 이런 속성은 부모엔터티를 조회할 때도 당연히 쓰이지만, 자식엔터티의 데이터를 사할 때도","words":[{"text":"등-을","x":192,"y":1621,"width":52,"height":29},{"text":"들","x":256,"y":1621,"width":27,"height":28},{"text":"수","x":294,"y":1621,"width":28,"height":28},{"text":"있다.","x":333,"y":1619,"width":56,"height":31},{"text":"이런","x":403,"y":1620,"width":48,"height":29},{"text":"속성은","x":464,"y":1619,"width":75,"height":31},{"text":"부모엔터티를","x":550,"y":1620,"width":151,"height":30},{"text":"조회할","x":712,"y":1620,"width":77,"height":29},{"text":"때도","x":801,"y":1620,"width":51,"height":30},{"text":"당연히","x":864,"y":1620,"width":75,"height":30},{"text":"쓰이지만,","x":953,"y":1620,"width":111,"height":33},{"text":"자식엔터티의","x":1078,"y":1620,"width":156,"height":30},{"text":"데이터를","x":1249,"y":1619,"width":104,"height":30},{"text":"사할","x":1364,"y":1620,"width":82,"height":29},{"text":"때도","x":1458,"y":1620,"width":52,"height":28}]},{"text":"해당 조건이 조회의 조건으로 걸리는 경우가 다수다 그런데 데이터 모델링을 전개할 때 각 엔터티 간의 관계를","words":[{"text":"해당","x":192,"y":1667,"width":53,"height":30},{"text":"조건이","x":256,"y":1667,"width":75,"height":31},{"text":"조회의","x":344,"y":1666,"width":75,"height":32},{"text":"조건으로","x":432,"y":1668,"width":101,"height":29},{"text":"걸리는","x":544,"y":1668,"width":75,"height":30},{"text":"경우가","x":631,"y":1667,"width":74,"height":31},{"text":"다수다","x":716,"y":1668,"width":83,"height":31},{"text":"그런데","x":811,"y":1668,"width":77,"height":30},{"text":"데이터","x":902,"y":1667,"width":74,"height":31},{"text":"모델링을","x":990,"y":1667,"width":106,"height":30},{"text":"전개할","x":1108,"y":1667,"width":78,"height":30},{"text":"때","x":1198,"y":1667,"width":25,"height":29},{"text":"각","x":1236,"y":1666,"width":28,"height":30},{"text":"엔터티","x":1275,"y":1666,"width":75,"height":29},{"text":"간의","x":1363,"y":1667,"width":52,"height":29},{"text":"관계를","x":1429,"y":1667,"width":80,"height":31}]},{"text":"비식별자관계로 설정하면 이런 유형의 속성이 자식엔터티로 