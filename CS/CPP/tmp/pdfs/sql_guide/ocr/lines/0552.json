","x":548,"y":813,"width":68,"height":27},{"text":"가질","x":628,"y":812,"width":44,"height":28},{"text":"수","x":685,"y":813,"width":23,"height":26},{"text":"없으므로","x":720,"y":812,"width":92,"height":28},{"text":"너무나","x":825,"y":812,"width":69,"height":28},{"text":"당연한","x":906,"y":812,"width":70,"height":29},{"text":"제약이다","x":988,"y":813,"width":99,"height":28}]},{"text":"테이블에 클러스터형 인덱스를 생성하면 항상 정릴된 상태를 유지해야 하기 때문에 데이터 입력 시 성능이 느린","words":[{"text":"테이블에","x":188,"y":858,"width":90,"height":28},{"text":"클러스터형","x":289,"y":858,"width":111,"height":28},{"text":"인덱스를","x":412,"y":858,"width":90,"height":29},{"text":"생성하면","x":511,"y":857,"width":86,"height":30},{"text":"항상","x":607,"y":857,"width":46,"height":29},{"text":"정릴된","x":662,"y":856,"width":65,"height":29},{"text":"상태를","x":738,"y":856,"width":68,"height":29},{"text":"유지해야","x":814,"y":857,"width":94,"height":28},{"text":"하기","x":915,"y":858,"width":44,"height":28},{"text":"때문에","x":971,"y":858,"width":68,"height":27},{"text":"데이터","x":1050,"y":858,"width":66,"height":27},{"text":"입력","x":1129,"y":857,"width":43,"height":28},{"text":"시","x":1185,"y":858,"width":20,"height":27},{"text":"성능이","x":1218,"y":856,"width":67,"height":29},{"text":"느린","x":1296,"y":856,"width":45,"height":27}]},{"text":"단점을 갖는다. 비클러스터형 인덱스를 생성해도 정렬을 유지해야 한다는 점은 같지만, 클러스터형 인덱스는 인덱스","words":[{"text":"단점을","x":159,"y":902,"width":69,"height":28},{"text":"갖는다.","x":237,"y":902,"width":73,"height":28},{"text":"비클러스터형","x":322,"y":902,"width":131,"height":29},{"text":"인덱스를","x":465,"y":903,"width":86,"height":28},{"text":"생성해도","x":560,"y":902,"width":89,"height":28},{"text":"정렬을","x":658,"y":901,"width":66,"height":28},{"text":"유지해야","x":732,"y":901,"width":90,"height":28},{"text":"한다는","x":830,"y":901,"width":69,"height":28},{"text":"점은","x":909,"y":902,"width":45,"height":27},{"text":"같지만,","x":963,"y":902,"width":73,"height":31},{"text":"클러스터형","x":1048,"y":902,"width":112,"height":28},{"text":"인덱스는","x":1172,"y":902,"width":92,"heigh