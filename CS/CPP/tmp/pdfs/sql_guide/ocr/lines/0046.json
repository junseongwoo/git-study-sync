{"page":46,"width":1984,"height":2513,"text_angle":0,"lines":[{"text":"과목 I 데이터 모일|렁,의 이해","words":[{"text":"과목","x":186,"y":102,"width":62,"height":30},{"text":"I","x":277,"y":103,"width":13,"height":29},{"text":"데이터","x":317,"y":102,"width":90,"height":30},{"text":"모일|렁,의","x":426,"y":102,"width":116,"height":32},{"text":"이해","x":562,"y":102,"width":56,"height":30}]},{"text":"그 속성이 가지고 있는 계산 방법에 대해 반드시 어떤 엔터EI와 어떤 속성에 의해 영향을 받는지 정의가 되어야","words":[{"text":"그","x":184,"y":261,"width":33,"height":24},{"text":"속성이","x":232,"y":254,"width":95,"height":35},{"text":"가지고","x":345,"y":255,"width":95,"height":33},{"text":"있는","x":454,"y":254,"width":62,"height":33},{"text":"계산","x":531,"y":255,"width":63,"height":33},{"text":"방법에","x":606,"y":255,"width":91,"height":35},{"text":"대해","x":713,"y":255,"width":61,"height":33},{"text":"반드시","x":790,"y":255,"width":89,"height":33},{"text":"어떤","x":896,"y":256,"width":60,"height":33},{"text":"엔터EI와","x":973,"y":255,"width":123,"height":33},{"text":"어떤","x":1109,"y":255,"width":61,"height":33},{"text":"속성에","x":1186,"y":254,"width":92,"height":34},{"text":"의해","x":1294,"y":253,"width":60,"height":35},{"text":"영향을","x":1372,"y":253,"width":94,"height":34},{"text":"받는지","x":1480,"y":252,"width":92,"height":33},{"text":"정의가","x":1591,"y":251,"width":97,"height":34},{"text":"되어야","x":1702,"y":251,"width":103,"height":35}]},{"text":"예를 들어 \u0027이자\u0027 속성이 존재한다고 하면, 이재는 원금이 1,(IX)원이고 예치기간이 5개월이며, 이자율이 5.0%에서","words":[{"text":"예를","x":225,"y":366,"width":64,"height":33},{"text":"들어","x":302,"y":365,"width":60,"height":34},{"text":"\u0027이자\u0027","x":376,"y":364,"width":76,"height":33},{"text":"속성이","x":464,"y":363,"width":90,"height":34},{"text":"존재한다고","x":568,"y":364,"width":152,"height":33},{"text":"하면,","x":731,"y":363,"width":68,"height":38},{"text":"이재는","x":815,"y":362,"width":91,"height":35},{"text":"원금이","x":918,"y":363,"width":87,"height":34},{"text":"1,(IX)원이고","x":1022,"y":362,"width":164,"height":38},{"text":"예치기간이","x":1197,"y":361,"width":151,"height":35},{"text":"5개월이며,","x":1362,"y":360,"width":148,"height":38},{"text":"이자율이","x":1527,"y":360,"width":121,"height":34},{"text":"5.0%에서","x":1663,"y":360,"width":140,"height":35}]},{"text":"계산되는 속성값이다. 그렇다면 이자는 원금이 1 (Ⅷ원에서 2,(XX)원으로 변하여도 영향을 받고, 예치기간이 5개월","words":[{"text":"계산되는","x":186,"y":419,"width":128,"height":36},{"text":"속성값이다.","x":325,"y":417,"width":166,"height":36},{"text":"그렇다면","x":506,"y":418,"width":123,"height":34},{"text":"이자는","x":643,"y":418,"width":93,"height":33},{"text":"원금이","x":748,"y":417,"width":90,"height":34},{"text":"1","x":854,"y":421,"width":14,"height":27},{"text":"(Ⅷ원에서","x":878,"y":417,"width":140,"height":34},{"text":"2,(XX)원으로","x":1034,"y":416,"width":168,"height":39},{"text":"변하여도","x":1216,"y":416,"width":126,"height":33},{"text":"영향을","x":1354,"y":415,"width":94,"height":34},{"text":"받고,","x":1461,"y":415,"width":70,"height":38},{"text":"예치기간이","x":1547,"y":415,"width":158,"height":34},{"text":"5개월","x":1722,"y":415,"width":84,"height":35}]},{"text":"에서 7개월로 늘어나도 값이 변하며, 이자율이 5.0%에서 6.0%로 바뀌어도 이자속성이 갖는 값은 변할 것이다.","words":[{"text":"에서","x":183,"y":476,"width":63,"height":34},{"text":"7개월로","x":263,"y":476,"width":117,"height":34},{"text":"늘어나도","x":393,"y":472,"width":129,"height":35},{"text":"값이","x":536,"y":473,"width":60,"height":33},{"text":"변하며,","x":614,"y":473,"width":101,"height":37},{"text":"이자율이","x":732,"y":472,"width":121,"height":34},{"text":"5.0%에서","x":870,"y":472,"width":136,"height":35},{"text":"6.0%로","x":1022,"y":474,"width":106,"height":29},{"text":"바뀌어도","x":1142,"y":471,"width":127,"height":34},{"text":"이자속성이","x":1284,"y":470,"width":156,"height":35},{"text":"갖는","x":1458,"y":470,"width":64,"height":33},{"text":"값은","x":1536,"y":470,"width":65,"height":34},{"text":"변할","x":1616,"y":471,"width":66,"height":34},{"text":"것이다.","x":1696,"y":471,"width":110,"height":35}]},{"text":"한 번 값이 변해도 또다시 영통을 미치는 속성값 조건이 변한다면, 이자의 값은 지속적으로 변경될 것이다.","words":[{"text":"한","x":183,"y":531,"width":33,"height":34},{"text":"번","x":233,"y":531,"width":31,"height":32},{"text":"값이","x":283,"y":529,"width":62,"height":35},{"text":"변해도","x":366,"y":529,"width":98,"height":33},{"text":"또다시","x":480,"y":527,"width":93,"height":34},{"text":"영통을","x":593,"y":527,"width":94,"height":35},{"text":"미치는","x":704,"y":527,"width":94,"height":34},{"text":"속성값","x":814,"y":526,"width":96,"height":34},{"text":"조건이","x":925,"y":527,"width":91,"height":34},{"text":"변한다면,","x":1037,"y":525,"width":131,"height":38},{"text":"이자의","x":1189,"y":525,"width":91,"height":34},{"text":"값은","x":1300,"y":526,"width":66,"height":34},{"text":"지속적으로","x":1383,"y":524,"width":161,"height":34},{"text":"변경될","x":1562,"y":525,"width":95,"height":35},{"text":"것이다.","x":1679,"y":526,"width":108,"height":34}]},{"text":"이와 같이 타 속성으로부터 지속적으로 영향을 받아 자신의 값이 변하는 성질을 갖는 속성이 파생속성이다.","words":[{"text":"이와","x":224,"y":584,"width":66,"height":33},{"text":"같이","x":305,"y":584,"width":61,"height":33},{"text":"타","x":385,"y":583,"width":33,"height":33},{"text":"속성으로부터","x":432,"y":582,"width":189,"height":34},{"text":"지속적으로","x":642,"y":582,"width":155,"height":34},{"text":"영향을","x":812,"y":581,"width":94,"height":34},{"text":"받아","x":920,"y":582,"width":63,"height":34},{"text":"자신의","x":997,"y":580,"width":90,"height":36},{"text":"값이","x":1106,"y":579,"width":57,"height":35},{"text":"변하는","x":1183,"y":580,"width":95,"height":34},{"text":"성질을","x":1294,"y":580,"width":95,"height":35},{"text":"갖는","x":1404,"y":579,"width":65,"height":33},{"text":"속성이","x":1482,"y":580,"width":95,"height":34},{"text":"파생속성이다.","x":1596,"y":581,"width":210,"height":34}]},{"text":"파생속성은 될 수 있으면 꼭 필요한 경우에만 정의하여 업무 로직이 속성 내부에 숨지 않게 하는 것이 좋다","words":[{"text":"파생속성은","x":183,"y":638,"width":166,"height":34},{"text":"될","x":366,"y":638,"width":29,"height":33},{"text":"수","x":413,"y":638,"width":33,"height":32},{"text":"있으면","x":464,"y":636,"width":94,"height":34},{"text":"꼭","x":576,"y":639,"width":32,"height":31},{"text":"필요한","x":625,"y":637,"width":94,"height":34},{"text":"경우에만","x":736,"y":635,"width":126,"height":36},{"text":"정의하여","x":878,"y":636,"width":120,"height":35},{"text":"업무","x":1019,"y":637,"width":61,"height":33},{"text":"로직이","x":1096,"y":634,"width":91,"height":35},{"text":"속성","x":1207,"y":634,"width":60,"height":35},{"text":"내부에","x":1288,"y":634,"width":93,"height":35},{"text":"숨지","x":1400,"y":633,"width":61,"height":34},{"text":"않게","x":1481,"y":634,"width":62,"height":34},{"text":"하는","x":1563,"y":635,"width":67,"height":33},{"text":"것이","x":1648,"y":635,"width":61,"height":34},{"text":"좋다","x":1731,"y":634,"width":75,"height":35}]},{"text":"파생속성을 정의한 경우는 속성정의서에 파생속성이 갖는 업무로직을 기술하여 데이터의 정합성을 유지할 수","words":[{"text":"파생속성을","x":183,"y":692,"width":166,"height":34},{"text":"정의한","x":368,"y":691,"width":94,"height":34},{"text":"경우는","x":480,"y":690,"width":95,"height":33},{"text":"속성정의서에","x":591,"y":691,"width":186,"height":34},{"text":"파생속성이","x":795,"y":689,"width":154,"height":35},{"text":"갖는","x":969,"y":691,"width":62,"height":33},{"text":"업무로직을","x":1048,"y":689,"width":156,"height":35},{"text":"기술하여","x":1222,"y":689,"width":122,"height":34},{"text":"데이터의","x":1365,"y":688,"width":123,"height":34},{"text":"정합성을","x":1511,"y":688,"width":129,"height":34},{"text":"유지할","x":1656,"y":689,"width":103,"height":33},{"text":"수","x":1774,"y":689,"width":33,"height":31}]},{"text":"있도록 해야 한다. 그 파생속성에 원인이 되는 속성을 이용하는 모든 애플리케이션에서는 값을 생성•수정•삭제할","words":[{"text":"있도록","x":184,"y":746,"width":98,"height":33},{"text":"해야","x":296,"y":745,"width":66,"height":33},{"text":"한다.","x":374,"y":745,"width":72,"height":33},{"text":"그","x":461,"y":749,"width":34,"height":23},{"text":"파생속성에","x":507,"y":744,"width":156,"height":34},{"text":"원인이","x":678,"y":745,"width":90,"height":34},{"text":"되는","x":784,"y":744,"width":62,"height":34},{"text":"속성을","x":858,"y":744,"width":95,"height":34},{"text":"이용하는","x":967,"y":744,"width":125,"height":35},{"text":"모든","x":1104,"y":746,"width":63,"he