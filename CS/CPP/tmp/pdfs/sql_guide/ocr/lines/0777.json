{"page":777,"width":1755,"height":2233,"text_angle":0,"lines":[{"text":"과목 III 고급 활용 및 튜닝","words":[{"text":"과목","x":190,"y":97,"width":49,"height":27},{"text":"III","x":255,"y":99,"width":25,"height":25},{"text":"고급","x":360,"y":96,"width":48,"height":29},{"text":"활용","x":422,"y":96,"width":48,"height":29},{"text":"및","x":486,"y":96,"width":22,"height":28},{"text":"튜닝","x":523,"y":95,"width":48,"height":29}]},{"text":"문제는 동시성이다. [그림 III구11처럼 한 건씩 읽어 처리할 때는 잘 느끼지 못하는 수준이겠지만, 대량의 데이터를","words":[{"text":"문제는","x":221,"y":238,"width":77,"height":30},{"text":"동시성이다.","x":308,"y":237,"width":131,"height":32},{"text":"[그림","x":452,"y":237,"width":55,"height":34},{"text":"III구11처럼","x":520,"y":236,"width":122,"height":34},{"text":"한","x":654,"y":236,"width":27,"height":31},{"text":"건씩","x":691,"y":235,"width":47,"height":32},{"text":"읽어","x":751,"y":235,"width":48,"height":32},{"text":"처리할","x":811,"y":235,"width":77,"height":31},{"text":"때는","x":897,"y":234,"width":51,"height":31},{"text":"잘","x":959,"y":233,"width":27,"height":31},{"text":"느끼지","x":995,"y":232,"width":77,"height":32},{"text":"못하는","x":1086,"y":232,"width":83,"height":32},{"text":"수준이겠지만,","x":1180,"y":232,"width":178,"height":36},{"text":"대량의","x":1374,"y":232,"width":88,"height":32},{"text":"데이터를","x":1479,"y":230,"width":136,"height":33}]},{"text":"읽어 처리할 때는 동시성이 심각하게 낮아진다. 완벽한 데이터 일관성 유지를 위해 심지어 테이블 레벨 Lock을","words":[{"text":"읽어","x":187,"y":287,"width":51,"height":31},{"text":"처리할","x":254,"y":288,"width":78,"height":31},{"text":"때는","x":344,"y":287,"width":53,"height":31},{"text":"동시성이","x":408,"y":287,"width":101,"height":32},{"text":"심각하게","x":524,"y":286,"width":100,"height":32},{"text":"낮아진다.","x":638,"y":285,"width":108,"height":33},{"text":"완벽한","x":760,"y":285,"width":79,"height":32},{"text":"데이터","x":851,"y":285,"width":76,"height":31},{"text":"일관성","x":943,"y":283,"width":77,"height":32},{"text":"유지를","x":1036,"y":283,"width":83,"height":32},{"text":"위해","x":1133,"y":283,"width":55,"height