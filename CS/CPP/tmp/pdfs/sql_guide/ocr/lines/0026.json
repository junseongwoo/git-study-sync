ight":39},{"text":"정보공학을","x":770,"y":554,"width":154,"height":36},{"text":"기반으로","x":938,"y":554,"width":122,"height":35},{"text":"하는","x":1073,"y":553,"width":62,"height":35},{"text":"모델링에서는","x":1147,"y":553,"width":188,"height":36},{"text":"해당","x":1348,"y":554,"width":63,"height":36},{"text":"업무에","x":1426,"y":554,"width":91,"height":36},{"text":"가장","x":1534,"y":554,"width":64,"height":36},{"text":"적절한","x":1613,"y":555,"width":94,"height":36},{"text":"ERD를","x":1722,"y":558,"width":102,"height":33}]},{"text":"그려내는 것이 프로젝트의 지상과제다. 오브젝트 모델링을 하더라도 관계형 데이터베이스를 대부-분 사용하므로","words":[{"text":"그려내는","x":205,"y":611,"width":136,"height":35},{"text":"것이","x":356,"y":611,"width":61,"height":35},{"text":"프로젝트의","x":435,"y":611,"width":157,"height":36},{"text":"지상과제다.","x":612,"y":612,"width":160,"height":36},{"text":"오브젝트","x":790,"y":611,"width":126,"height":36},{"text":"모델링을","x":930,"y":611,"width":124,"height":36},{"text":"하더라도","x":1069,"y":610,"width":123,"height":36},{"text":"관계형","x":1206,"y":611,"width":90,"height":36},{"text":"데이터베이스를","x":1317,"y":612,"width":220,"height":36},{"text":"대부-분","x":1554,"y":613,"width":95,"height":35},{"text":"사용하므로","x":1663,"y":613,"width":161,"height":35}]},{"text":"데이터베이스를 생성할 수 있는 데이터 모델 생성이 프로젝트에서 아주 중요한 다스크에 포함된다.","words":[{"text":"데이터베이스를","x":208,"y":666,"width":228,"height":37},{"text":"생성할","x":454,"y":667,"width":95,"height":36},{"text":"수","x":563,"y":669,"width":33,"height":34},{"text":"있는","x":613,"y":669,"width":63,"height":34},{"text":"데이터","x":693,"y":668,"width":88,"height":35},{"text":"모델","x":799,"y":668,"width":63,"height":35},{"text":"생성이","x":880,"y":668,"width":88,"height":36},{"text":"프로젝트에서","x":987,"y":667,"width":182,"height":37},{"text":"아주","x":1188,"y":667,"width":62,"height":36},{"text":"중요한","x":1266,"y":669,"width":95,"height":35},{"text":"다스크에","x":1378,"y":669,"width":124,"height":36},{"text":"포함된다.","x":1521,"y":670,"width":134,"height":35}]},{"text":"데이터 분석이 어느 정도 완료되면, 즉 엔터티 • 관계 • 속성 등이 데이