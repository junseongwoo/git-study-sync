{"page":56,"width":1939,"height":2497,"text_angle":0,"lines":[{"text":"과목 I 데이터 모일렁의 이해","words":[{"text":"과목","x":184,"y":74,"width":61,"height":33},{"text":"I","x":272,"y":74,"width":14,"height":31},{"text":"데이터","x":312,"y":72,"width":86,"height":34},{"text":"모일렁의","x":417,"y":76,"width":113,"height":33},{"text":"이해","x":548,"y":75,"width":56,"height":33}]},{"text":"앞의 관계를 정의한 사형에 대해 뒷부분만 의문문으로 만들면 바로 관계를 도출하기 위한 질문 문장으로 만들","words":[{"text":"앞의","x":222,"y":233,"width":62,"height":37},{"text":"관계를","x":299,"y":234,"width":96,"height":37},{"text":"정의한","x":410,"y":235,"width":93,"height":37},{"text":"사형에","x":514,"y":237,"width":90,"height":37},{"text":"대해","x":617,"y":236,"width":59,"height":36},{"text":"뒷부분만","x":690,"y":236,"width":124,"height":37},{"text":"의문문으로","x":826,"y":235,"width":154,"height":36},{"text":"만들면","x":991,"y":234,"width":92,"height":37},{"text":"바로","x":1096,"y":234,"width":62,"height":37},{"text":"관계를","x":1171,"y":233,"width":93,"height":37},{"text":"도출하기","x":1276,"y":233,"width":124,"height":36},{"text":"위한","x":1416,"y":232,"width":64,"height":37},{"text":"질문","x":1496,"y":233,"width":62,"height":37},{"text":"문장으로","x":1569,"y":232,"width":133,"height":37},{"text":"만들","x":1714,"y":233,"width":66,"height":37}]},{"text":"수 있다. 위의 질문을 업무를 분석하는 자기 스스로에게 질문하거나, 장표나 업무기술서 또는 업무를 잘 알고 있는","words":[{"text":"수","x":180,"y":290,"width":34,"height":34},{"text":"있다.","x":227,"y":291,"width":72,"height":37},{"text":"위의","x":314,"y":293,"width":61,"height":36},{"text":"질문을","x":391,"y":293,"width":92,"height":37},{"text":"업무를","x":496,"y":294,"width":90,"height":37},{"text":"분석하는","x":596,"y":294,"width":123,"height":37},{"text":"자기","x":731,"y":294,"width":58,"height":37},{"text":"스스로에게","x":804,"y":293,"width":151,"height":37},{"text":"질문하거나,","x":969,"y":293,"width":158,"height":41},{"text":"장표나","x":1141,"y":291,"width":93,"height":39},{"text":"업무기술서","x":1245,"y":290,"width":152,"height":38},{"text":"또는","x":1413,"y":293,"width":64,"height":3