75,"width":61,"height":37},{"text":"I","x":1000,"y":1578,"width":12,"height":27},{"text":"-2-11]은","x":1020,"y":1577,"width":103,"height":34},{"text":"주문과","x":1134,"y":1574,"width":87,"height":33},{"text":"배송에","x":1233,"y":1574,"width":84,"height":34},{"text":"대한","x":1331,"y":1575,"width":58,"height":32},{"text":"모델이다.","x":1399,"y":1575,"width":122,"height":33},{"text":"업무적으로","x":1538,"y":1576,"width":148,"height":32}]},{"text":"생각해보면, 고객이 주-문하면 이후 판매자가 배송을 한다. 대부분의 쇼핑몰은 고객이 주-문한 주문내역에 대해 배송정","words":[{"text":"생각해보면,","x":205,"y":1630,"width":143,"height":37},{"text":"고객이","x":359,"y":1630,"width":80,"height":33},{"text":"주-문하면","x":452,"y":1629,"width":110,"height":34},{"text":"이후","x":574,"y":1629,"width":56,"height":33},{"text":"판매자가","x":640,"y":1629,"width":112,"height":33},{"text":"배송을","x":761,"y":1630,"width":86,"height":33},{"text":"한다.","x":858,"y":1629,"width":63,"height":33},{"text":"대부분의","x":935,"y":1628,"width":107,"height":35},{"text":"쇼핑몰은","x":1056,"y":1629,"width":114,"height":32},{"text":"고객이","x":1179,"y":1627,"width":83,"height":34},{"text":"주-문한","x":1276,"y":1628,"width":87,"height":32},{"text":"주문내역에","x":1372,"y":1628,"width":140,"height":34},{"text":"대해","x":1526,"y":1629,"width":57,"height":32},{"text":"배송정","x":1596,"y":1628,"width":86,"height":33}]},{"text":"보를 조회할 수 있는 기능을 갖추고 있다. 즉 현재 내가 주문한 상품이 어디쯤 배송되었는지를 조회할 수 있는","words":[{"text":"보를","x":204,"y":1686,"width":58,"height":32},{"text":"조회할","x":275,"y":1685,"width":86,"height":32},{"text":"수","x":373,"y":1685,"width":30,"height":32},{"text":"있는","x":416,"y":1683,"width":56,"height":34},{"text":"기능을","x":487,"y":1684,"width":83,"height":34},{"text":"갖추고","x":584,"y":1683,"width":86,"height":33},{"text":"있다.","x":685,"y":1683,"width":63,"height":34},{"text":"즉","x":763,"y":1685,"width":31,"height":32},{"text":"현재","x":808,"y":1683,"width":56,"height":33},{"text":"내가","x":882,"y":1682,"width":58,"height":35},{"text":"주문한","x":952,"y":1683,"width":87,"height":35},{"text":"상품이","x":1052,"y":1682,"width":84,"height":33},{"text":"어디쯤","x":1154,"y":1682,"width":87,"height":34},{"text":"배송되었는지를","x":1256,"y":1681,"width":203,"height":34},{"text":"조회할","x":1472,"y":1682,"width":91,"height":33},{"text":"수","x":1576,"y":1683,"width":31,"height":32},{"text":"있는","x":1624,"y":1682,"width":60,"height":33}]},{"text":"화면이다","words":[{"text":"화면이다","x":205,"y":1738,"width":122,"height":33}]},{"text":"이런 화면은 어떻게 구현할 수 있을까? 우선은 고객이 주문한 주문정보가 필요할 것이괴 주문한 상품의 송장번호가","words":[{"text":"이런","x":242,"y":1792,"width":54,"height":33},{"text":"화면은","x":307,"y":1791,"width":82,"height":33},{"text":"어떻게","x":399,"y":1790,"width":79,"height":35},{"text":"구현할","x":488,"y":1790,"width":83,"height":34},{"text":"수","x":580,"y":1792,"width":30,"height":32},{"text":"있을까?","x":620,"y":1790,"width":91,"height":34},{"text":"우선은","x":722,"y":1792,"width":83,"height":32},{"text":"고객이","x":814,"y":1791,"width":83,"height":34},{"text":"주문한","x":910,"y":1792,"width":84,"height":33},{"text":"주문정보가","x":1003,"y":1789,"width":140,"height":36},{"text":"필요할","x":1153,"y":1792,"width":84,"height":33},{"text":"것이괴","x":1248,"y":1791,"width":88,"height":37},{"text":"주문한","x":1349,"y":1790,"width":85,"height":34},{"text":"상품의","x":1443,"y":1790,"width":81,"height":34},{"text":"송장번호가","x":1538,"y":1789,"width":146,"height":36}]},{"text":"필요하다. 송장번호는 판매자가 고객의 상품을 배송하기 위해 택배사로부터 전달받은 번호다. 흔히 택배박스 스티커","words":[{"text":"필요하다.","x":205,"y":1845,"width":118,"height":32},{"text":"송장번호는","x":336,"y":1845,"width":137,"height":33},{"text":"판매자가","x":483,"y":1844,"width":112,"height":34},{"text":"고객의","x":604,"y":1845,"width":81,"height":34},{"text":"상품을","x":699,"y":1845,"width":83,"height":34},{"text":"배송하기","x":794,"y":1845,"width":111,"height":34},{"text":"위해","x":920,"y":1846,"width":55,"height":33},{"text":"택배사로부터","x":989,"y":1844,"width":165,"height":35},{"text":"전달받은","x":1169,"y":1846,"width":112,"height":33},{"text":"번호다.","x":1293,"y":1845,"width":90,"height":33},{"text":"흔히","x":1398,"y":1845,"width":52,"height":33},{"text":"택배박스","x":1466,"y":1845,"width":114,"height":34},{"text":"스티커","x":1591,"y":1844,"width":88,"height":34}]},{"text":"에서 확인할 수 있다. 그럼 해당 쇼핑몰에서는 송장번호를 택배회사에 전달하여 현재 어디쯤 배달됐는지에 대한","words":[{"text":"에서","x":203,"y":1897,"width":55,"height":33},{"text":"확인할","x":273,"y":1897,"width":87,"height":34},{"text":"수","x":372,"y":1898,"width":29,"height":30},{"text":"있다.","x":414,"y":1897,"width":62,"height":32},{"text":"그럼","x":491,"y":1899,"width":54,"height":32},{"text":"해당","x":561,"y":1898,"width":57,"height":33},{"text":"쇼핑몰에서는","x":629,"y":1898,"width":173,"height":34},{"text":"송장번호를","x":814,"y":1898,"width":146,"height":35},{"text":"택배회사에","x":975,"y":1898,"width":142,"height":35},{"text":"전달하여","x":1132,"y":1900,"width":113,"height":33},{"text":"현재","x":1261,"y":1899,"width":55,"height":34},{"text":"어디쯤","x":1331,"y":1899,"width":86,"height":33},{"text":"배달됐는지에","x":1431,"y":1898,"width":174,"height":34},{"text":"대한","x":1622,"y":1899,"width":61,"height":32}]},{"text":"정보를 요청하고, 수신된 데이터를 고객에게 보여준다.","words":[{"text":"정보를","x":205,"y":1950,"width":83,"height":34},{"text":"요청하고,","x":302,"y":1950,"width":123,"height":36},{"text":"수신된","x":440,"y":1951,"width":84,"height":33},{"text":"데이터를","x":542,"y":1951,"width":112,"height":33},{"text":"고객에게","x":668,"y":1952,"width":112,"height":33},{"text":"보여준다.","x":798,"y":1952,"width":124,"height":33}]},{"text":"위와 같은 요건을 개발한다고 생각해보자 주유정보는 주문 엔터티에서 가져올 수 있괴 송장번호는 배송 엔터티에서","words":[{"text":"위와","x":239,"y":2003,"width":55,"height":33},{"text":"같은","x":303,"y":2003,"width":56,"height":32},{"text":"요건을","x":368,"y":2003,"width":82,"height":33},{"text":"개발한다고","x":459,"y":2005,"width":134,"height":33},{"text":"생각해보자","x":603,"y":2005,"width":136,"height":33},{"text":"주유정보는","x":755,"y":2006,"width":140,"height":33},{"text":"주문","x":904,"y":2008,"width":56,"height":32},{"text":"엔터티에서","x":971,"y":2007,"width":134,"height":34},{"text":"가져올","x":1118,"y":2006,"width":82,"height":33},{"text":"수","x"