"text":"언뜻","x":1575,"y":1929,"width":59,"height":31}]},{"text":"보면 큰 차이는 없어 보이지만 실제 개발 시 편의성이 향상되는 방식이다. 다음 데이터로 어떤 부분에서 개발의","words":[{"text":"보면","x":207,"y":1980,"width":52,"height":30},{"text":"큰","x":272,"y":1982,"width":27,"height":28},{"text":"차이는","x":311,"y":1979,"width":81,"height":31},{"text":"없어","x":405,"y":1980,"width":52,"height":31},{"text":"보이지만","x":472,"y":1979,"width":111,"height":31},{"text":"실제","x":595,"y":1979,"width":53,"height":32},{"text":"개발","x":664,"y":1979,"width":55,"height":31},{"text":"시","x":731,"y":1980,"width":25,"height":30},{"text":"편의성이","x":772,"y":1979,"width":105,"height":32},{"text":"향상되는","x":892,"y":1979,"width":111,"height":32},{"text":"방식이다.","x":1016,"y":1979,"width":119,"height":32},{"text":"다음","x":1152,"y":1979,"width":55,"height":32},{"text":"데이터로","x":1221,"y":1979,"width":112,"height":32},{"text":"어떤","x":1345,"y":1980,"width":55,"height":31},{"text":"부분에서","x":1415,"y":1981,"width":112,"height":31},{"text":"개발의","x":1544,"y":1980,"width":86,"height":33}]},{"text":"편의성이 향상되었는지 확인해 보자.","words":[{"text":"편의성이","x":209,"y":2029,"width":103,"height":30},{"text":"향상되었는지","x":326,"y":2028,"width":163,"height":32},{"text":"확인해","x":504,"y":2029,"width":83,"height":30},{"text":"보자.","x":602,"y":2030,"width":64,"height":30}]},{"text":"116 전문가 가이드","words":[{"text":"116","x":221,"y":2218,"width":52,"height":29},{"text":"전문가","x":338,"y":2218,"width":55,"height":27},{"text":"가이드","x":403,"y":2218,"width":56,"height":27}]}]}