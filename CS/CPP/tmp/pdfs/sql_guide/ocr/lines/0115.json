}]},{"text":"바람직하다고 할 수 있다.","words":[{"text":"바람직하다고","x":168,"y":612,"width":176,"height":35},{"text":"할","x":358,"y":611,"width":31,"height":34},{"text":"수","x":404,"y":613,"width":30,"height":31},{"text":"있다.","x":448,"y":611,"width":67,"height":33}]},{"text":"120","words":[{"text":"120","x":216,"y":2301,"width":56,"height":32}]},{"text":"전우가 ,까드","words":[{"text":"전우가","x":343,"y":2300,"width":58,"height":28},{"text":",까드","x":410,"y":2299,"width":58,"height":27}]}]}