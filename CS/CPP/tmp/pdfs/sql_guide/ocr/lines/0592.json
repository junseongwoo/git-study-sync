{"page":592,"width":1492,"height":1993,"text_angle":0,"lines":[{"text":"璃장 조인 류님","words":[{"text":"璃장","x":1196,"y":84,"width":50,"height":24},{"text":"조인","x":1256,"y":84,"width":36,"height":24},{"text":"류님","x":1302,"y":84,"width":37,"height":24}]},{"text":"ㆍ 테이불별 검색 조건에 의해 전체 일렁삐 좌우된다","words":[{"text":"ㆍ","x":168,"y":212,"width":26,"height":27},{"text":"테이불별","x":209,"y":211,"width":97,"height":30},{"text":"검색","x":320,"y":212,"width":47,"height":30},{"text":"조건에","x":379,"y":211,"width":70,"height":30},{"text":"의해","x":462,"y":211,"width":44,"height":30},{"text":"전체","x":518,"y":210,"width":44,"height":30},{"text":"일렁삐","x":574,"y":210,"width":66,"height":30},{"text":"좌우된다","x":653,"y":210,"width":93,"height":30}]},{"text":"NL 조인은 Outer 집합의 건마다 lnner 집합을 탐색한다. 이 때문에 Outer 집힘에서 조인 대상이 되는 건수에","words":[{"text":"NL","x":199,"y":280,"width":36,"height":23},{"text":"조인은","x":245,"y":278,"width":72,"height":28},{"text":"Outer","x":326,"y":280,"width":66,"height":24},{"text":"집합의","x":402,"y":277,"width":65,"height":29},{"text":"건마다","x":479,"y":276,"width":65,"height":29},{"text":"lnner","x":553,"y":279,"width":60,"height":23},{"text":"집합을","x":623,"y":275,"width":65,"height":29},{"text":"탐색한다.","x":698,"y":275,"width":94,"height":29},{"text":"이","x":804,"y":274,"width":20,"height":28},{"text":"때문에","x":836,"y":273,"width":65,"height":29},{"text":"Outer","x":912,"y":275,"width":64,"height":24},{"text":"집힘에서","x":986,"y":271,"width":88,"height":29},{"text":"조인","x":1085,"y":272,"width":45,"height":28},{"text":"대상이","x":1141,"y":272,"width":65,"height":29},{"text":"되는","x":1217,"y":272,"width":45,"height":28},{"text":"건수에","x":1272,"y":270,"width":64,"height":29}]},{"text":"의해 전체 일량이 좌우된다. 그러나 소트 머지 조인은 두 집합을 각각 정렬한 후에 조인함으로 각 집합의 크기,","words":[{"text":"의해","x":167,"y":322,"width":49,"height":29},{"text":"전체","x":230,"y":323,"width":47,"height":29},{"text":"일량이","x":290,"y":323,"width":69,"height":29},{"text":"좌우된다.","x":371,"y":322,"width":98,"height":29},{"text":"그러나","x":481,"y":321,"width":66,"height":30},{"text":"소트","x":557,"y":323,"width":45,"height":23},{"text":"머지","x":613,"y":320,"width":41,"height":29},{"text":"조인은","x":667,"y":321,"width":69,"height":28},{"text":"두","x":746,"y":322,"width":23,"height":27},{"text":"집합을","x":780,"y":320,"width":67,"height":29},{"text":"각각","x":858,"y":318,"width":46,"height":30},{"text":"정렬한","x":916,"y":317,"width":67,"height":30},{"text":"후에","x":993,"y":316,"width":45,"height":30},{"text":"조인함으로","x":1050,"y":317,"width":116,"height":29},{"text":"각","x":1176,"y":317,"width":23,"height":28},{"text":"집합의","x":1211,"y":316,"width":63,"height":29},{"text":"크기,","x":1286,"y":315,"width":51,"height":31}]},{"text":"즉 테이불별 검색 조건에 의해 전체 일량이 좌우된다.","words":[{"text":"즉","x":166,"y":370,"width":27,"height":27},{"text":"테이불별","x":208,"y":369,"width":94,"height":28},{"text":"검색","x":318,"y":368,"width":44,"height":29},{"text":"조건에","x":376,"y":368,"width":68,"height":29},{"text":"의해","x":456,"y":368,"width":43,"height":29},{"text":"전체","x":513,"y":367,"width":42,"height":29},{"text":"일량이","x":568,"y":367,"width":64,"height":29},{"text":"좌우된다.","x":646,"y":366,"width":95,"height":29}]},{"text":"스킨 위주의 조인 방식이다.","words":[{"text":"스킨","x":208,"y":461,"width":50,"height":30},{"text":"위주의","x":272,"y":461,"width":72,"height":30},{"text":"조인","x":357,"y":461,"width":47,"height":29},{"text":"방식이다.","x":418,"y":461,"width":96,"height":30}]},{"text":"NL 조인이 랜덤 액세스 위주의 조인 방식이라면 소트 머지 조인은 스캔(뇨an) 위주의 조인 방식이다. lnner","words":[{"text":"NL","x":199,"y":529,"width":36,"height":23},{"text":"조인이","x":246,"y":526,"width":71,"height":28},{"text":"랜덤","x":331,"y":526,"width":44,"height":28},{"text":"액세스","x":388,"y":526,"width":69,"height":28},{"text":"위주의","x":467,"y":526,"width":65,"height":28},{"text":"조인","x":544,"y":525,"width":44,"height":28},{"text":"방식이라면","x":599,"y":524,"width":110,"height":30},{"text":"소트","x":720,"y":526,"width":45,"height":22},{"text":"머지","x":776,"y":522,"width":43,"height":28},{"text":"조인은","x":832,"y":522,"width":68,"height":27},{"text":"스캔(뇨an)","x":910,"y":521,"width":115,"height":30},{"text":"위주의","x":1037,"y":520,"width":67,"height":28},{"text":"조인","x":1116,"y":520,"width":44,"height":28},{"text":"방식이다.","x":1173,"y":518,"width":95,"height":30},{"text":"lnner","x":1280,"y":520,"width":61,"height":24}]},{"text":"테이블을 반복 액세스하지 않으므로 머지 과정에서 랜덤 액세스가 발생하지 않는다. 하지만 랜덤 액세스가 전혀","words":[{"text":"테이블을","x":167,"y":572,"width":100,"height":28},{"text":"반복","x":278,"y":572,"width":48,"height":28},{"text":"액세스하지","x":337,"y":570,"width":114,"height":30},{"text":"않으므로","x":463,"y":571,"width":91,"height":28},{"text":"머지","x":565,"y":570,"width":42,"height":30},{"text":"과정에서","x":619,"y":569,"width":87,"height":30},{"text":"랜덤","x":719,"y":568,"width":41,"height":29},{"text":"액세스가","x":773,"y":567,"width":92,"height":29},{"text":"발생하지","x":875,"y":566,"width":88,"height":29},{"text":"않는다.","x":976,"y":565,"width":74,"height":29},{"text":"하지만","x":1062,"y":565,"width":69,"height":28},{"text":"랜덤","x":1143,"y":565,"width":42,"height":28},{"text":"액세스가","x":1197,"y":563,"width":91,"height":29},{"text":"전혀","x":1299,"y":561,"width":40,"height":29}]},{"text":"없는 것은 아니다. 각 테이블 검색 조건에 해당하는 대상 집합을 찾을 때 인덱스를 이용한 랜덤 액세스 방식으로","words":[{"text":"없는","x":167,"y":619,"width":51,"height":28},{"text":"것은","x":230,"y":618,"width":48,"height":29},{"text":"아니다.","x":287,"y":618,"width":78,"height":28},{"text":"각","x":378,"y":618,"width":23,"height":29},{"text":"테이블","x":412,"y":617,"width":68,"height":29},{"text":"검색","x":490,"y":617,"width":43,"height":29},{"text":"조건에","x":544,"y":617,"width":67,"height":29},{"text":"해당하는","x":622,"y":616,"width":89,"height":30},{"text":"대상","x":721,"y":614,"width":43,"height":29},{"text":"집합을","x":776,"y":613,"width":67,"height":29},{"text":"찾을","x":854,"y":613,"width":43,"height":29},{"text":"때","x":909,"y":612,"width":20,"height":28},{"text":"인덱스를","x":941,"y":611,"width":90,"height":29},{"text":"이용한","x":1042,"y":611,"width":68,"height":29},{"text":"랜덤","x":1121,"y":611,"width":42,"height":28},{"text":"액세스","x":1176,"y":610,"width":67,"height":28},{"text":"방식으로","x":1253,"y":609,"width":89,"height":28}]},{"text":"처리될 수 있고, 이때 발생하는 랜덤 액세스량이 많다면 소-트 머지 조인의 이점이 사라질 수 있다","words":[{"text":"처리될","x":168,"y":664,"width":72,"height":29},{"text":"수","x":256,"y":666,"width":24,"height":27},{"text":"있고,","x":293,"y":664,"width":54,"height":32},{"text":"이때","x":362,"y":664,"width":45,"height":28},{"text":"발생하는","x":421,"y":663,"width":90,"height":30},{"text":"랜덤","x":524,"y":664,"width":42,"height":28},{"text":"액세스량이","x":580,"y":661,"width":110,"height":31},{"text":"많다면","x":703,"y":659,"width":66,"height":31},{"text":"소-트","x":782,"y":661,"width":46,"height":23},{"text":"머지","x":840,"y":658,"width":42,"height":29},{"text":"조인의","x":897,"y":657,"width":65,"height":29},{"text":"이점이","x":977,"y":656,"width":65,"height":29},{"text":"사라질","x":1056,"y":656,"width":67,"height":29},{"text":"수","x":1137,"y":657,"width":23,"height":26},{"text":"있다","x":1173,"y":654,"width":49,"height":28}]},{"text":"전문가 가이드 ㈚1","words":[{"text":"전문가","x":1146,"y":1888,"width":48,"height":22},{"text":"가이드","x":1203,"y":1888,"width":49,"height":22},{"text":"㈚1","x":1267,"y":1890,"width":48,"height":25}]}]}