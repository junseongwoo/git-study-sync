{"page":49,"width":1696,"height":2238,"text_angle":0,"lines":[{"text":"제1장 (꿰터 모일랑의 이해","words":[{"text":"제1장","x":1231,"y":83,"width":60,"height":27},{"text":"(꿰터","x":1302,"y":83,"width":69,"height":27},{"text":"모일랑의","x":1383,"y":83,"width":86,"height":28},{"text":"이해","x":1481,"y":83,"width":42,"height":27}]},{"text":"제4절 관계","words":[{"text":"제4절","x":202,"y":232,"width":147,"height":55},{"text":"관계","x":376,"y":232,"width":90,"height":54}]},{"text":"1. 관계의 개념","words":[{"text":"1.","x":201,"y":397,"width":32,"height":35},{"text":"관계의","x":256,"y":391,"width":114,"height":43},{"text":"개념","x":393,"y":391,"width":73,"height":43}]},{"text":"개 관계의 정의","words":[{"text":"개","x":197,"y":496,"width":37,"height":31},{"text":"관계의","x":250,"y":494,"width":83,"height":33},{"text":"정의","x":349,"y":494,"width":52,"height":32}]},{"text":"관계(Relationship)를 사전적으로 정의하면 상호 연관성이 있는 상대로 말할 수 있다. 이것을 데이터 모델에","words":[{"text":"관계(Relationship)를","x":231,"y":565,"width":270,"height":34},{"text":"사전적으로","x":512,"y":565,"width":125,"height":30},{"text":"정의하면","x":650,"y":564,"width":94,"height":31},{"text":"상호","x":758,"y":564,"width":49,"height":30},{"text":"연관성이","x":820,"y":563,"width":97,"height":31},{"text":"있는","x":933,"y":562,"width":50,"height":30},{"text":"상대로","x":996,"y":562,"width":78,"height":30},{"text":"말할","x":1086,"y":562,"width":54,"height":30},{"text":"수","x":1152,"y":563,"width":27,"height":29},{"text":"있다.","x":1192,"y":561,"width":58,"height":31},{"text":"이것을","x":1266,"y":561,"width":79,"height":31},{"text":"데이터","x":1358,"y":560,"width":75,"height":31},{"text":"모델에","x":1447,"y":560,"width":77,"height":30}]},{"text":"대입하여 정의하면, \u0027엔터티의 인스턴스 사이의 논리적인 연관성으로서 존재의 형태로서나 행위로서 서로에게 연관","words":[{"text":"대입하여","x":196,"y":613,"width":106,"height":31},{"text":"정의하면,","x":317,"y":612,"width":108,"height":34},{"text":"\u0027엔터티의","x":438,"y":612,"width":105,"height":31},{"text":"인스턴스","x":557,"y":613,"width":96,"height":30},{"text":"사이의","x":662,"y":613,"width":71,"height":30},{"text":"논리적인","x":745,"y":612,"width":97,"height":30},{"text":"연관성으로서","x":855,"y":610,"width":148,"height":32},{"text":"존재의","x":1015,"y":610,"width":75,"height":30},{"text":"형태로서나","x":1104,"y":610,"width":132,"height":31},{"text":"행위로서","x":1246,"y":610,"width":103,"height":31},{"text":"서로에게","x":1362,"y":609,"width":102,"height":31},{"text":"연관","x":1476,"y":608,"width":51,"height":30}]},{"text":"성이 부여된 상대\u0027라고 할 수 있다. 관계는 엔터티와 엔터티 간 연관성을 표현하기 때문에 엔터티의 정의에 따라","words":[{"text":"성이","x":194,"y":662,"width":53,"height":32},{"text":"부여된","x":261,"y":662,"width":81,"height":31},{"text":"상대\u0027라고","x":356,"y":661,"width":111,"height":31},{"text":"할","x":478,"y":661,"width":27,"height":31},{"text":"수","x":515,"y":663,"width":26,"height":29},{"text":"있다.","x":552,"y":662,"width":54,"height":30},{"text":"관계는","x":620,"y":662,"width":74,"height":30},{"text":"엔터티와","x":705,"y":661,"width":99,"height":30},{"text":"엔터티","x":816,"y":661,"width":74,"height":31},{"text":"간","x":903,"y":661,"width":26,"height":30},{"text":"연관성을","x":940,"y":660,"width":103,"height":30},{"text":"표현하기","x":1055,"y":659,"width":104,"height":31},{"text":"때문에","x":1175,"y":660,"width":78,"height":31},{"text":"엔터티의","x":1267,"y":660,"width":104,"height":31},{"text":"정의에","x":1387,"y":659,"width":76,"height":31},{"text":"따라","x":1477,"y":658,"width":51,"height":32}]},{"text":"영통을 받기도 하고, 속성 정의 및 관계 정의에 따라서도 다0c斜게 변할 수 있다.","words":[{"text":"영통을","x":193,"y":712,"width":83,"height":30},{"text":"받기도","x":291,"y":711,"width":81,"height":30},{"text":"하고,","x":385,"y":710,"width":58,"height":34},{"text":"속성","x":459,"y":710,"width":49,"height":31},{"text":"정의","x":525,"y":710,"width":46,"height":31},{"text":"및","x":588,"y":710,"width":21,"height":30},{"text":"관계","x":623,"y":710,"width":48,"height":31},{"text":"정의에","x":687,"y":710,"width":72,"height":31},{"text":"따라서도","x":774,"y":710,"width":102,"height":30},{"text":"다0c斜게","x":889,"y":709,"width":100,"height":31},{"text":"변할","x":1005,"y":708,"width":53,"height":30},{"text":"수","x":1070,"y":709,"width":27,"height":29},{"text":"있다.","x":1113,"y":708,"width":58,"height":31}]},{"text":"인스던스 사이의 논리적인 연관성으로서 존재 또는 행위로서 서로에게 연관성이 부여된 상태","words":[{"text":"인스던스","x":358,"y":1199,"width":92,"height":27},{"text":"사이의","x":462,"y":1198,"width":68,"height":28},{"text":"논리적인","x":543,"y":1198,"width":91,"height":27},{"text":"연관성으로서","x":646,"y":1198,"width":137,"height":28},{"text":"존재","x":796,"y":1200,"width":46,"height":26},{"text":"또는","x":856,"y":1201,"width":48,"height":25},{"text":"행위로서","x":915,"y":1199,"width":94,"height":27},{"text":"서로에게","x":1022,"y":1197,"width":94,"height":27},{"text":"연관성이","x":1130,"y":1196,"width":97,"height":28},{"text":"부여된","x":1240,"y":1195,"width":72,"height":28},{"text":"상태","x":1326,"y":1196,"width":48,"height":28}]},{"text":"[그림 I•1•3이 관계의 정의","words":[{"text":"[그림","x":694,"y":1267,"width":56,"height":31},{"text":"I•1•3이","x":772,"y":1268,"width":92,"height":31},{"text":"관계의","x":880,"y":1267,"width":73,"height":29},{"text":"정의","x":969,"y":1267,"width":48,"height":29}]},{"text":"나. 관계의 패어링","words":[{"text":"나.","x":199,"y":1363,"width":34,"height":32},{"text":"관계의","x":249,"y":1363,"width":79,"height":31},{"text":"패어링","x":342,"y":1363,"width":76,"height":30}]},{"text":"유의해야 할 점은 관계는 엔터티 인에 인스턴스가 개별적으로 관계를 가지는 것(패어렁)이괵 이것의 집합을 관겨L!로","words":[{"text":"유의해야","x":231,"y":1430,"width":101,"height":30},{"text":"할","x":340,"y":1430,"width":26,"height":29},{"text":"점은","x":375,"y":1430,"width":49,"height":29},{"text":"관계는","x":431,"y":1430,"width":75,"height":30},{"text":"엔터티","x":514,"y":1430,"width":70,"height":30},{"text":"인에","x":595,"y":1430,"width":48,"height":30},{"text":"인스턴스가","x":654,"y":1430,"width":123,"height":31},{"text":"개별적으로","x":786,"y":1431,"width":125,"height":30},{"text":"관계를","x":920,"y":1431,"width":77,"height":31},{"text":"가지는","x":1007,"y":1432,"width":79,"height":31},{"text":"것(패어렁)이괵","x":1094,"y":1431,"width":175,"height":34},{"text":"이것의","x":1282,"y":1431,"width":74,"height":31},{"text":"집합을","x":1369,"y":1432,"width":78,"height":30},{"text":"관겨L!로","x":1456,"y":1433,"width":77,"height":29}]},{"text":"표현한다는 것이다. 따라서 개별 인스턴스가 각각 다른 종류의 관계를 가지고 있다면, 두 엔터티 사이에 두 개","words":[{"text":"표현한다는","x":197,"y":1477,"width":131,"height":30},{"text":"것이다.","x":341,"y":1476,"width":80,"height":31},{"text":"따라서","x":437,"y":1477,"width":73,"height":31},{"text":"개별","x":525,"y":1478,"width":48,"height":30},{"text":"인스턴스가","x":589,"y":1477,"width":126,"height":31},{"text":"각각","x":727,"y":1479,"width":52,"height":31},{"text":"다른","x":792,"y":1478,"width":51,"height":30},{"text":"종류의","x":856,"y":1478,"width":77,"height":31},{"text":"관계를","x":948,"y":1480,"width":82,"height":32},{"text":"가지고","x":1043,"y":1480,"width":81,"height":32},{"text":"있다면,","x":1138,"y":1479,"width":85,"height":35},{"text":"두","x":1238,"y":1482,"width":27,"height":29},{"text":"엔터티","x":1278,"y":1480,"width":78,"height":30},{"text":"사이에","x":1372,"y":1480,"width":79,"height":31},{"text":"두","x":1465,"y":1482,"width":28,"height":28},{"text":"개","x":1507,"y":1480,"width":24,"height":31}]},{"text":"이상의 관계가 형성될 수 있다.","words":[{"text":"이상의","x":198,"y":1525,"width":75,"height":32},{"text":"관계가","x":288,"y":1525,"width":78,"height":31},{"text":"형성될","x":378,"y":1525,"width":73,"height":31},{"text":"수","x":466,"y":1528,"width":27,"height":29},{"text":"있다.","x":505,"y":1526,"width":55,"height":31}]},{"text":"각각의 엔터티의 인스턴스들은 자신이 관런된 인스턴스들과 관계의 어커런스로 참여하는 형태를 관계 피|어림","words":[{"text":"각각의","x":230,"y":1574,"width":75,"height":32},{"text":"엔터티의","x":319,"y":1573,"width":98,"height":31},{"text":"인스턴스들은","x":432,"y":1573,"width":150,"height":32},{"text":"자신이","x":592,"y":1575,"width":74,"height":31},{"text":"관런된","x":680,"y":1576,"width":75,"height":31},{"text":"인스턴스들과","x":769,"y":1576,"width":156,"height":32},{"text":"관계의","x":936,"y":1577,"width":79,"height":31},{"text":"어커런스로","x":1030,"y":1577,"width":135,"height":31},{"text":"참여하는","x":1177,"y":1578,"width":106,"height":30},{"text":"형태를","x":1294,"y":1578,"width":80,"height":31},{"text":"관계","x":1385,"y":1578,"width":52,"height":30},{"text":"피|어림","x":1451,"y":1578,"width":77,"height":31}]},{"text":"(Relationsh1p Panng)이라 한다. [그림 •1•311에서는 강사 정성철은 이춘식과 황종하에게 강의하는 형태로 관계가","words":[{"text":"(Relationsh1p","x":198,"y":1624,"width":163,"height":34},{"text":"Panng)이라","x":370,"y":1623,"width":137,"height":35},{"text":"한다.","x":516,"y":1623,"width":54,"height":31},{"text":"[그림","x":583,"y":1624,"width":54,"height":34},{"text":"•1•311에서는","x":674,"y":1625,"width":141,"height":33},{"text":"강사","x":824,"y":1625,"width":52,"height":31},{"text":"정성철은","x":886,"y":1626,"width":103,"height":30},{"text":"이춘식과","x":999,"y":1625,"width":105,"height":32},{"text":"황종하에게","x":1113,"y":1626,"width":129,"height":30},{"text":"강의하는","x":1252,"y":1627,"width":104,"height":31},{"text":"형태로","x":1366,"y":1627,"width":77,"height":30},{"text":"관계가","x":1452,"y":1626,"width":80,"height":30}]},{"text":"표현되어 있다. 또 조시형은 황종하에게 강의를 하는 형대로 되어 있다. 이와 김이 엔터티 내에 인스턴스와 인스턴스","words":[{"text":"표현되어","x":197,"y":1671,"width":99,"height":32},{"text":"있다.","x":309,"y":1671,"width":54,"height":32},{"text":"또","x":374,"y":1674,"width":26,"height":23},{"text":"조시형은","x":408,"y":1671,"width":99,"height":33},{"text":"황종하에게","x":516,"y":1672,"width":121,"height":31},{"text":"강의를","x":648,"y":1673,"width":75,"height":32},{"text":"하는","x":732,"y":1673,"width":51,"height":31},{"text":"형대로","x":792,"y":1674,"width":77,"height":32},{"text":"되어","x":878,"y":1673,"width":49,"height":31},{"text":"있다.","x":941,"y":1673,"width":58,"height":31},{"text":"이와","x":1012,"y":1674,"width":52,"height":31},{"text":"김이","x":1074,"y":1674,"width":50,"height":30},{"text":"엔터티","x":1138,"y":1674,"width":74,"height":31},{"text":"내에","x":1227,"y":1674,"width":49,"height":32},{"text":"인스턴스와","x":1289,"y":1674,"width":129,"height":31},{"text":"인스턴스","x":1428,"y":1674,"width":104,"height":31}]},{"text":"사이에 관계가 설정된 어커런스를 관계 패어링이라고 한다. 엔터티는 인스턴스의 집합을 논리적으로 표현하였다면,","words":[{"text":"사이에","x":197,"y":1721,"width":76,"height":31},{"text":"관계가","x":284,"y":1720,"width":76,"height":32},{"text":"설정된","x":370,"y":1720,"width":72,"height":31},{"text":"어커런스를","x":454,"y":1721,"width":123,"height":31},{"text":"관계","x":586,"y":1722,"width":49,"height":30},{"text":"패어링이라고","x":646,"y":1722,"width":152,"height":31},{"text":"한다.","x":807,"y":1722,"width":57,"height":31},{"text":"엔터티는","x":878,"y":1722,"width":104,"height":30},{"text":"인스턴스의","x":993,"y":1721,"width":128,"height":30},{"text":"집합을","x":1136,"y":1722,"width":77,"height":30},{"text":"논리적으로","x":1224,"y":1723,"width":131,"height":30},{"text":"표현하였다면,","x":1365,"y":1723,"width":163,"height":32}]},{"text":"관계는 관계 패어링의 집합을 논리적으로 표현한 것이다.","words":[{"text":"관계는","x":196,"y":1770,"width":80,"height":30},{"text":"관계","x":288,"y":1769,"width":50,"height":31},{"text":"패어링의","x":353,"y":1769,"width":98,"height":30},{"text":"집합을","x":468,"y":1769,"width":74,"height":31},{"text":"논리적으로","x":554,"y":1770,"width":126,"height":31},{"text":"표현한","x":693,"y":1769,"width":78,"height":32},{"text":"것이다.","x":784,"y":1770,"width":83,"height":31}]},{"text":"최초의 ERD(R! 모텔)에서 관계는 속성을 가질 수 있었으나, 요즘 ERD에서는 관계를 위해 속성을 도출하지는","words":[{"text":"최초의","x":230,"y":1818,"width":75,"height":31},{"text":"ERD(R!","x":318,"y":1818,"width":90,"height":33},{"text":"모텔)에서","x":419,"y":1818,"width":107,"height":34},{"text":"관계는","x":539,"y":1818,"width":75,"height":31},{"text":"속성을","x":624,"y":1819,"width":75,"height":31},{"text":"가질","x":710,"y":1818,"width":49,"height":32},{"text":"수","x":772,"y":1821,"width":26,"height":29},{"text":"있었으나,","x":809,"y":1819,"width":110,"height":35},{"text":"요즘","x":933,"y":1821,"width":53,"height":29},{"text":"ERD에서는","x":997,"y":1819,"width":139,"height":30},{"text":"관계를","x":1147,"y":1819,"width":80,"height":31},{"text":"위해","x":1239,"y":1819,"width":52,"height":30},{"text":"속성을","x":1304,"y":1820,"width":80,"height":31},{"text":"도출하지는","x":1394,"y":18