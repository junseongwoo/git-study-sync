ight":32},{"text":"존재한다.","x":734,"y":740,"width":119,"height":32},{"text":"하지만","x":867,"y":741,"width":84,"height":32},{"text":"상품번호는","x":961,"y":740,"width":139,"height":33},{"text":"고객이","x":1110,"y":740,"width":82,"height":33},{"text":"상품을","x":1206,"y":740,"width":85,"height":33},{"text":"주문함으로써","x":1302,"y":740,"width":171,"height":33},{"text":"발생하는","x":1487,"y":741,"width":118,"height":33},{"text":"매핑","x":1617,"y":740,"width":57,"height":32}]},{"text":"정보로서 의미를 가지고 있다. 주문번호와 함께 주문상세 엔터티의 식별자 의미를 가지고 있기에 중복된 데이터라고","words":[{"text":"정보로서","x":198,"y":790,"width":110,"height":33},{"text":"의미를","x":320,"y":790,"width":87,"height":34},{"text":"가지고","x":418,"y":791,"width":83,"height":32},{"text":"있다.","x":513,"y":790,"width":60,"height":33},{"text":"주문번호와","x":587,"y":792,"width":140,"height":31},{"text":"함께","x":737,"y":791,"width":55,"height":32},{"text":"주문상세","x":804,"y":792,"width":111,"height":32},{"text":"엔터티의","x":928,"y":791,"width":105,"height":33},{"text":"식별자","x":1048,"y":790,"width":83,"height":34},{"text":"의미를","x":1141,"y":791,"width":85,"height":33},{"text":"가지고","x":1236,"y":792,"width":86,"height":32},{"text":"있기에","x":1333,"y":792,"width":85,"height":32},{"text":"중복된","x":1431,"y":793,"width":84,"height":33},{"text":"데이터라고","x":1530,"y":792,"width":148,"height":34}]},{"text":"볼 수 없다. 하지만 상품명은 주문번호와는 관계없이 오직 상품번호에 의해서만 결정된다. 이러한 것을 우리는","words":[{"text":"볼","x":196,"y":841,"width":30,"height":33},{"text":"수","x":240,"y":843,"width":30,"height":31},{"text":"없다.","x":284,"y":842,"width":64,"height":32},{"text":"하지만","x":365,"y":843,"width":87,"height":32},{"text":"상품명은","x":465,"y":842,"width":115,"height":33},{"text":"주문번호와는","x":593,"y":842,"width":172,"height":33},{"text":"관계없이","x":779,"y":842,"width":112,"height":33},{"text":"오직","x":907,"y":843,"width":54,"height":33},{"text":"상품번호에","x":979,"y":842,"width":139,"height":34},{"text":"의해서만","x":1134,"y":843,"width":116,"height":33},{"text":"결정된다.","x":1264,"y":843,"width":123,"height":34},{"text":"이러한","x":1405,"y":844,"width":90,"height":33},{"text":"것을","x":1510,"y":846,"width":59,"height":31},{"text":"우리는","x":1584,"y":843,"width":93,"height":34}]},{"text":"\u0027종속적이다\u0027라고 한다. 정리하면 상품명은 주문상세의 식별자인 \u0027주문번호+상품번호\u0027가 아닌 오직 상품번호에만 종속","words":[{"text":"\u0027종속적이다\u0027라고","x":195,"y":894,"width":210,"height":34},{"text":"한다.","x":414,"y":894,"width":62,"height":33},{"text":"정리하면","x":491,"y":894,"width":108,"height":33},{"text":"상품명은","x":612,"y":894,"width":113,"height":34},{"text":"주문상세의","x":734,"y":894,"width":136,"height":34},{"text":"식별자인","x":885,"y":895,"width":107,"height":33},{"text":"\u0027주문번호+상품번호\u0027가","x":1003,"y":894,"width":280,"height":34},{"text":"아닌","x":1292,"y":896,"width":57,"height":32},{"text":"오직","x":1361,"y":896,"width":55,"height":33},{"text":"상품번호에만","x":1430,"y":897,"width":176,"height":32},{"text":"종속","x":1616,"y":896,"width":62,"height":33}]},{"text":"적이다. 이를 함수적 종속성으로 표기하면 [그림 I-2-5]와 같다","words":[{"text":"적이다.","x":199,"y":946,"width":91,"height":33},{"text":"이를","x":307,"y":946,"width":58,"height":33},{"text":"함수적","x":379,"y":946,"width":83,"height":33},{"text":"종속성으로","x":478,"y":946,"width":145,"height":33},{"text":"표기하면","x":638,"y":947,"width":113,"height":33},{"text":"[그림","x":768,"y":947,"width":63,"height":35},{"text":"I-2-5]와","x":858,"y":947,"width":110,"height":36},{"text":"같다","x":982,"y":947,"width":63,"height":33}]},{"text":"함수종속성","words":[{"text":"함수종속성","x":865,"y":1076,"width":127,"height":31}]},{"text":"결정자(DETERMINANT)","words":[{"text":"결정자(DETERMINANT)","x":490,"y":1144,"width":279,"height":34}]},{"text":"종속자(DEPENDENT)","words":[{"text":"종속자(DEPENDENT)","x":1119,"y":1144,"width":253,"height":34}]},{"text":"종속자는 근본적으로 결정자에 함수적으로 종속성을 가지고 있음","words":[{"text":"종속자는","x":542,"y":1238,"width":103,"height":28},{"text":"근본적으로","x":659,"y":1237,"width":130,"height":29},{"text":"결정자에","x":803,"y":1237,"width":101,"height":29},{"text":"함수적으로","x":920,"y":1236,"width":128,"height":30},{"