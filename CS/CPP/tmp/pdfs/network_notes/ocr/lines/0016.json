:38},{"text":"GET","x":1497,"y":1536,"width":78,"height":29},{"text":"메시지에","x":1590,"y":1532,"width":136,"height":38},{"text":"넣어서","x":1744,"y":1532,"width":96,"height":39},{"text":"보","x":1857,"y":1537,"width":32,"height":29}]},{"text":"낸다. 마지막으로, 웹 서버는 여러분의 컴퓨터로 웹 페이지 내용(웹 파일)을 전송한다.","words":[{"text":"낸다.","x":549,"y":1593,"width":75,"height":38},{"text":"마지막으로,","x":639,"y":1593,"width":180,"height":39},{"text":"웹","x":835,"y":1593,"width":30,"height":37},{"text":"서버는","x":882,"y":1593,"width":103,"height":39},{"text":"여러분의","x":999,"y":1592,"width":133,"height":38},{"text":"컴퓨터로","x":1151,"y":1592,"width":137,"height":38},{"text":"웹","x":1302,"y":1592,"width":30,"height":37},{"text":"페이지","x":1350,"y":1593,"width":99,"height":38},{"text":"내용(웹","x":1469,"y":1593,"width":113,"height":39},{"text":"파일)을","x":1598,"y":1593,"width":120,"height":40},{"text":"전송한다.","x":1732,"y":1593,"width":140,"height":39}]},{"text":"앞에서 보았던 사람의 네트워킹 예처럼, 메시지 교환과 이들 메시지를 송수신할","words":[{"text":"앞에서","x":616,"y":1655,"width":98,"height":37},{"text":"보았던","x":735,"y":1655,"width":101,"height":37},{"text":"사람의","x":855,"y":1656,"width":100,"height":37},{"text":"네트워킹","x":978,"y":1655,"width":133,"height":38},{"text":"예처럼,","x":1134,"y":1654,"width":110,"height":38},{"text":"메시지","x":1265,"y":1654,"width":100,"height":38},{"text":"교환과","x":1387,"y":1654,"width":106,"height":38},{"text":"이들","x":1511,"y":1655,"width":69,"height":37},{"text":"메시지를","x":1598,"y":1655,"width":140,"height":38},{"text":"송수신할","x":1754,"y":1655,"width":136,"height":39}]},{"text":"때 취한 행동은 프로토콜의 요소를 정의하는 주요인들이다.","words":[{"text":"때","x":549,"y":1716,"width":28,"height":37},{"text":"취한","x":594,"y":1716,"width":69,"height":38},{"text":"행동은","x":675,"y":1716,"width":104,"height":38},{"text":"프로토콜의","x":790,"y":1718,"width":170,"height":37},{"text":"요소를","x":976,"y":1718,"width":104,"height":35},{"text":"정의하는","x":1095,"y":1716,"width":137,"height":38},{"text":"주요인들이다.","x":1244,"y":1716,"width":219,"height":38}]},{"text":"프로토콜은 둘 이상의 통신 개체 간에 교환되는 메시지 포맷과 순서뿐 아니라, 메시지","words":[{"text":"프로토콜은","x":626,"y":1801,"width":161,"height":34},{"text":"둘","x":800,"y":1802,"width":33,"height":33},{"text":"이상의","x":848,"y":1802,"width":94,"height":35},{"text":"통신","x":957,"y":1802,"width":63,"height":35},{"text":"개체","x":1037,"y":1802,"width":62,"height":34},{"text":"간에","x":1115,"y":1801,"width":63,"height":35},{"text":"교환되는","x":1193,"y":1801,"width":131,"height":35},{"text":"메시지","x":1340,"y":1801,"width":94,"height":35},{"text":"포맷과","x":1449,"y":1802,"width":100,"height":35},{"text":"순서뿐","x":1562,"y":1802,"width":99,"height":35},{"text":"아니라,","x":1676,"y":1801,"width":104,"height":35},{"text":"메시지","x":1798,"y":1801,"width":90,"height":35}]},{"text":"의 송수신과 다른 이벤트에 따른 행동들을 정의한다.”","words":[{"text":"의","x":614,"y":1859,"width":29,"height":35},{"text":"송수신과","x":656,"y":1858,"width":129,"height":36},{"text":"다른","x":797,"y":1859,"width":63,"height":35},{"text":"이벤트에","x":873,"y":1859,"width":126,"height":36},{"text":"따른","x":1014,"y":1859,"width":63,"height":35},{"text":"행동들을","x":1090,"y":1859,"width":125,"height":36},{"text":"정의한다.”","x":1231,"y":1858,"width":152,"height":36}]},{"text":"인터넷과 일반 컴퓨터 네트워크는 많은 프로토콜을 이용한다. 다양한 프로토콜이","words":[{"text":"인터넷과","x":615,"y":1939,"width":136,"height":38},{"text":"일반","x":767,"y":1938,"width":67,"height":37},{"text":"컴퓨터","x":851,"y":1939,"width":96,"height":38},{"text":"네트워크는","x":968,"y":1939,"width":173,"height":38},{"text":"많은","x":1156,"y":1939,"width":69,"height":37},{"text":"프로토콜을","x":1240,"y":1939,"width":176,"height":37},{"text":"이용한다.","x":1432,"y":1939,"width":147,"height":37},{"text":"다양한","x":1598,"y":1938,"width":106,"height":37},{"text":"프로토콜이","x":1719,"y":1938,"width":166,"height":37}]},{"text":"여러 가지 통신 목적을 위해 사용된다. 이 책에서 어떤 프로토콜은 간단하지만 어떤 것","words":[{"text":"여러","x":547,"y":2000,"width":62,"height":38},{"text":"가지","x":629,"y":2000,"width":62,"height":39},{"text":"통신","x":708,"y":2000,"width":67,"height":38},{"text":"목적을","x":788,"y":2000,"width":104,"height":38},{"text":"위해","x":906,"y":2001,"width":65,"height":37},{"text":"사용된다.","x":986,"y":2000,"width":146,"height":38},{"text":"이","x":1150,"y":2000,"width":28,"height":37},{"text":"책에서","x":1196,"y":2000,"width":100,"height":38},{"text":"어떤","x":1315,"y":2000,"width":66,"height":38},{"text":"프로토콜은","x":1396,"y":2000,"width":177,"height":37},{"text":"간단하지만","x":1586,"y":1999,"width":177,"height":38},{"text":"어떤","x":1777,"y":1998,"width":65,"height":38},{"text":"것","x":1858,"y":1999,"width":29,"height":37}]},{"text":"은 매우 복잡하다는 것을 알게 될 것이다. 컴퓨터 네트워킹 분야의 전문가가 된다는 것","words":[{"text":"은","x":545,"y":2062,"width":35,"height":37},{"text":"매우","x":593,"y":2063,"width":68,"height":37},{"text":"복잡하다는","x":673,"y":2062,"width":172,"height":38},{"text":"것을","x":860,"y":2062,"width":67,"height":37},{"text":"알게","x":940,"y":2062,"width":64,"height":37},{"text":"될","x":1021,"y":2061,"width":31,"height":37},{"text":"것이다.","x":1070,"y":2061,"width":108,"height":38},{"text":"컴퓨터","x":1197,"y":2062,"width":98,"height":37},{"text":"네트워킹","x":1314,"y":2061,"width":135,"height":38},{"text":"분야의","x":1466,"y":2061,"width":102,"height":37},{"text":"전문가가","x":1586,"y":2060,"width":142,"height":37},{"text":"된다는","x":1741,"y":2060,"width":103,"height":37},{"text":"것","x":1858,"y":2060,"width":28,"height":37}]},{"text":"은 네트워킹 프로토콜이 무엇이고, 왜 필요하며 또한 어떻게 운영되는지 잘 이해한다","words":[{"text":"은","x":545,"y":2125,"width":35,"height":36},{"text":"네트워킹","x":596,"y":2124,"width":131,"height":38},{"text":"프로토콜이","x":747,"y":2124,"width":166,"height":37},{"text":"무엇이고,","x":933,"y":2122,"width":146,"height":39},{"text":"왜","x":1096,"y":2122,"width":31,"height":38},{"text":"필요하며","x":1148,"y":2123,"width":133,"height":38},{"text":"또한","x":1301,"y":2123,"width":71,"height":36},{"text":"어떻게","x":1388,"y":2122,"width":101,"height":39},{"text":"운영되는지","x":1507,"y":2122,"width":174,"height":38},{"text":"잘","x":1701,"y":2121,"width":36,"height":38},{"text":"이해한다","x":17