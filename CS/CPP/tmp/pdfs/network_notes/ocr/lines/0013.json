{"page":13,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"1.1 • 인터넷이란 무엇인가?","words":[{"text":"1.1","x":1053,"y":148,"width":37,"height":24},{"text":"•","x":1126,"y":153,"width":12,"height":13},{"text":"인터넷이란","x":1171,"y":146,"width":128,"height":30},{"text":"무엇인가?","x":1309,"y":146,"width":122,"height":30}]},{"text":"을 살피보는 것으로 시작하지만 이는 시작에 들\u0027%고빠다. 이 책의 대부분은 컴퓨터 네트","words":[{"text":"을","x":168,"y":274,"width":32,"height":36},{"text":"살피보는","x":215,"y":274,"width":131,"height":37},{"text":"것으로","x":362,"y":275,"width":96,"height":36},{"text":"시작하지만","x":474,"y":274,"width":166,"height":38},{"text":"이는","x":655,"y":275,"width":64,"height":36},{"text":"시작에","x":734,"y":275,"width":95,"height":38},{"text":"들\u0027%고빠다.","x":846,"y":275,"width":139,"height":38},{"text":"이","x":1002,"y":275,"width":28,"height":36},{"text":"책의","x":1050,"y":275,"width":61,"height":36},{"text":"대부분은","x":1131,"y":274,"width":131,"height":38},{"text":"컴퓨터","x":1277,"y":274,"width":92,"height":38},{"text":"네트","x":1389,"y":275,"width":63,"height":38}]},{"text":"위그 프로토콜들과 관린되이 있기 때문이다.","words":[{"text":"위그","x":169,"y":333,"width":65,"height":37},{"text":"프로토콜들과","x":247,"y":334,"width":198,"height":37},{"text":"관린되이","x":458,"y":334,"width":129,"height":37},{"text":"있기","x":605,"y":334,"width":60,"height":37},{"text":"때문이다.","x":683,"y":334,"width":138,"height":38}]},{"text":"인터넷에서 프로토콜이 아주 중요하r,한, 각각의 프로토콜 또는 모든 프로토콜이 무","words":[{"text":"인터넷에서","x":235,"y":394,"width":160,"height":37},{"text":"프로토콜이","x":411,"y":394,"width":162,"height":36},{"text":"아주","x":591,"y":394,"width":66,"height":37},{"text":"중요하r,한,","x":670,"y":394,"width":140,"height":38},{"text":"각각의","x":826,"y":394,"width":95,"height":38},{"text":"프로토콜","x":937,"y":395,"width":134,"height":36},{"text":"또는","x":1086,"y":396,"width":66,"height":35},{"text":"모든","x":1165,"y":396,"width":66,"height":35},{"text":"프로토콜이","x":1245,"y":395,"width":160,"height":38},{"text":"무","x":1422,"y":396,"width":32,"height"