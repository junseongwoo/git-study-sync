x":1361,"y":1882,"width":64,"height":37},{"text":"값","x":1443,"y":1882,"width":35,"height":37}]},{"text":"에 의해서 식별된다. 그 다음에 도착하는 모든 세그먼트의 출발지 포드, 출발지 IP","words":[{"text":"에","x":244,"y":1940,"width":29,"height":38},{"text":"의해서","x":290,"y":1941,"width":97,"height":37},{"text":"식별된다.","x":405,"y":1940,"width":146,"height":37},{"text":"그","x":567,"y":1946,"width":34,"height":25},{"text":"다음에","x":614,"y":1940,"width":98,"height":38},{"text":"도착하는","x":727,"y":1941,"width":133,"height":38},{"text":"모든","x":871,"y":1942,"width":65,"height":35},{"text":"세그먼트의","x":948,"y":1941,"width":161,"height":38},{"text":"출발지","x":1124,"y":1941,"width":97,"height":38},{"text":"포드,","x":1241,"y":1946,"width":70,"height":34},{"text":"출발지","x":1327,"y":1941,"width":98,"height":38},{"text":"IP","x":1442,"y":1947,"width":35,"height":27}]},{"text":"주소, 목적지 포트, 그리고 목적지 IP 주소가 이들 네 가지 값과 일치하면, 세그먼","words":[{"text":"주소,","x":243,"y":2003,"width":74,"height":35},{"text":"목적지","x":332,"y":2001,"width":101,"height":38},{"text":"포트,","x":452,"y":2004,"width":77,"height":35},{"text":"그리고","x":545,"y":2001,"width":103,"height":37},{"text":"목적지","x":661,"y":2001,"width":96,"height":38},{"text":"IP","x":774,"y":2006,"width":33,"height":28},{"text":"주소가","x":820,"y":2001,"width":99,"height":38},{"text":"이들","x":933,"y":2002,"width":64,"height":37},{"text":"네","x":1011,"y":2003,"width":28,"height":38},{"text":"가지","x":1056,"y":2002,"width":61,"height":39},{"text":"값과","x":1134,"y":2001,"width":68,"height":38},{"text":"일치하면,","x":1216,"y":2002,"width":141,"height":38},{"text":"세그먼","x":1372,"y":2001,"width":102,"height":38}]},{"text":"트는 이 소켓으로 역다중화될 것이다. 적절한 TCP 연결과 함께 클라이언트와 서","words":[{"text":"트는","x":244,"y":2064,"width":66,"height":34},{"text":"이","x":326,"y":2062,"width":28,"height":37},{"text":"소켓으로","x":374,"y":2062,"width":140,"height":36},{"text":"역다중화될","x":531,"y":2062,"width":166,"height":37},{"text":"것이다.","x":715,"y":2062,"width":104,"height":38},{"text":"적절한","x":837,"y":2062,"width":96,"height":37},{"text":"TCP","x":945,"y":2067,"width":70,"height":29},{"text":"연결과","x":1031,"y":2063,"width":97,"height":37},{"text":"함께","x":1141,"y":2062,"width":64,"height":37},{"text":"클라이언트와","x":1221,"y":2062,"width":206,"height":37},{"text":"서","x":1441,"y":2063,"width":30,"height":37}]},{"text":"버는 데이터를 서로 주고받을 수 있다.","words":[{"text":"버는","x":246,"y":2122,"width":64,"height":37},{"text":"데이터를","x":323,"y":2121,"width":139,"height":38},{"text":"서로","x":474,"y":2122,"width":70,"height":38},{"text":"주고받을","x":555,"y":2121,"width":138,"height":39},{"text":"수","x":703,"y":2123,"width":35,"height":37},{"text":"있다.","x":751,"y":2122,"width":70,"height":39}]},{"text":"서버 호스트는 동시에 존재하는 많은 TCP 소켓을 지원할 수 있다. 이 각각의 소켓은","words":[{"text":"서버","x":186,"y":2226,"width":56,"height":39},{"text":"호스트는","x":260,"y":2228,"width":136,"height":34},{"text":"동시에","x":410,"y":2226,"width":103,"height":38},{"text":"존재하는","x":531,"y":2226,"width":138,"height":38},{"text":"많은","x":683,"y":2226,"width":68,"height":37},{"text":"TCP","x":762,"y":2231,"width":69,"height":29},{"text":"소켓을","x":846,"y":2227,"width":98,"height":37},{"text":"지원할","x":958,"y":2227,"width":99,"height":38},{"text":"수","x":1069,"y":2229,"width":33,"height":35},{"text":"있다.","x":1118,"y":2226,"width":71,"height":38},{"text":"이","x":1207,"y":2226,"width":28,"height":37},{"text":"각각의","x":1254,"y":2225,"width":99,"height":38},{"text":"소켓은","x":1371,"y":2226,"width":105,"height":37}]},{"text":"프로세스에 접속되어 있으며, 이들 소켓은 4개 요소들의 집합(four-tuple)에 의해서 식","words":[{"text":"프로세스에","x":186,"y":2286,"width":157,"height":37},{"text":"접속되어","x":361,"y":2286,"width":134,"height":38},{"text":"있으며,","x":515,"y":2286,"width":110,"height":38},{"text":"이들","x":640,"y":2286,"width":67,"height":38},{"text":"소켓은","x":718,"y":2287,"width":99,"height":36},{"text":"4개","x":828,"y":2287,"width":50,"height":37},{"text":"요소들의","x":892,"y":2287,"width":127,"height":38},{"text":"집합(four-tuple)에","x":1036,"y":2286,"width":272,"height":41},{"text":"의해서","x":1325,"y":2285,"width":98,"height":38},{"text":"식","x":1442,"y":2286,"width":29,"height":38}]},{"text":"별된다. TCP 세그먼트가 호스트에 도작하면, 모든 네 가지 필드(출발지 IP 주소, 출발","words":[{"text":"별된다.","x":186,"y":2345,"width":99,"height":38},{"text":"TCP","x":300,"y":2350,"width":72,"height":29},{"text":"세그먼트가","x":386,"y":2346,"width":177,"height":39},{"text":"호스트에","x":574,"y":2346,"width":134,"height":38},{"text":"도작하면,","x":722,"y":2346,"width":140,"height":38},{"text":"모든","x":875,"y":2349,"width":65,"height":34},{"text":"네","x":953,"y":2348,"width":29,"height":36},{"text":"가지","x":997,"y":2347,"width":62,"height":38},{"text":"필드(출발지","x":1076,"y":2346,"width":173,"height":39},{"text":"IP","x":1266,"y":2350,"width":35,"height":28},{"text":"주소,","x":1313,"y":2347,"width":78,"height":36},{"text":"출발","x":1406,"y":2346,"width":71,"height":38}]},{"text":"지 포트, 목적지 IP 주소, 목적지 포트)는 해당되는 소켓으로 세그먼트를 전달하기(역","words":[{"text":"지","x":186,"y":2406,"width":25,"height":37},{"text":"포트,","x":228,"y":2409,"width":72,"height":33},{"text":"목적지","x":316,"y":2406,"width":100,"height":37},{"text":"IP","x":435,"y":2411,"width":36,"height":28},{"text":"주소,","x":486,"y":2409,"width":79,"height":36},{"text":"목적지","x":580,"y":2406,"width":99,"height":38},{"text":"포트)는","x":696,"y":2408,"width":113,"height":38},{"text":"해당되는","x":822,"y":2406,"width":129,"height":38},{"text":"소켓으로","x":964,"y":2407,"width":131,"height":37},{"text":"세그먼트를","x":1108,"y":2406,"width":169,"height":37},{"text":"전달하기(역","x":1291,"y":2405,"width":181,"height":40}]},{"text":"다중화) 위해서 사용된다.","words":[{"text":"다중화)","x":186,"y":2466,"width":105,"height":38},{"text":"위해서","x":305,"y":2466,"width":98,"height":38},{"text":"사용된다.","x":419,"y":2467,"width":149,"height":38}]}]}