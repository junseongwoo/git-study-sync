:38},{"text":"손실","x":713,"y":649,"width":63,"height":37},{"text":"이벤트가","x":796,"y":650,"width":134,"height":37},{"text":"발생한","x":947,"y":649,"width":101,"height":38},{"text":"시점에서","x":1066,"y":650,"width":129,"height":37},{"text":"전송률을","x":1219,"y":649,"width":132,"height":38},{"text":"줄이는","x":1367,"y":650,"width":101,"height":36}]},{"text":"것이다. 그러므로 TCP 송신자는 혼잡이 발생하는 시점까지 전송률을 증가시기고","words":[{"text":"것이다.","x":249,"y":710,"width":102,"height":39},{"text":"그러므로","x":368,"y":711,"width":133,"height":36},{"text":"TCP","x":514,"y":714,"width":68,"height":29},{"text":"송신자는","x":596,"y":710,"width":130,"height":37},{"text":"혼잡이","x":739,"y":710,"width":95,"height":38},{"text":"발생하는","x":853,"y":710,"width":135,"height":38},{"text":"시점까지","x":1003,"y":710,"width":131,"height":38},{"text":"전송률을","x":1154,"y":710,"width":133,"height":38},{"text":"증가시기고","x":1301,"y":710,"width":167,"height":37}]},{"text":"(전송률을 탐색) 그 시점 이후부터는 줄여 나가고, 다시 혼잡 시작이 발생하는지를","words":[{"text":"(전송률을","x":246,"y":770,"width":145,"height":41},{"text":"탐색)","x":404,"y":771,"width":76,"height":38},{"text":"그","x":493,"y":776,"width":34,"height":25},{"text":"시점","x":540,"y":770,"width":60,"height":38},{"text":"이후부터는","x":616,"y":770,"width":162,"height":38},{"text":"줄여","x":790,"y":772,"width":63,"height":36},{"text":"나가고,","x":870,"y":771,"width":109,"height":37},{"text":"다시","x":995,"y":771,"width":62,"height":38},{"text":"혼잡","x":1074,"y":772,"width":69,"height":37},{"text":"시작이","x":1155,"y":772,"width":96,"height":37},{"text":"발생하는지를","x":1269,"y":771,"width":200,"height":38}]},{"text":"보기 위한 탐색을 시작한다. TCP 송신자의 행동은 마치 자기가 좋아하는 것을 조","words":[{"text":"보기","x":246,"y":832,"width":60,"height":36},{"text":"위한","x":325,"y":831,"width":67,"height":36},{"text":"탐색을","x":404,"y":831,"width":99,"height":37},{"text":"시작한다.","x":517,"y":831,"width":136,"height":38},{"text":"TCP","x":667,"y":836,"width":69,"height":28},{"text":"송신자의","x":749,"y":832,"width":130,"height":37},{"text":"행동은","x":897,"y":83