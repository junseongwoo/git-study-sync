{"page":33,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"1.3 • 네트위크코어","words":[{"text":"1.3","x":1164,"y":154,"width":39,"height":26},{"text":"•","x":1237,"y":159,"width":12,"height":15},{"text":"네트위크코어","x":1283,"y":151,"width":164,"height":32}]},{"text":"을 요구하는 레스토i!寸과 예약이 필요 없는(또한 받지도 않는) 레스토랑이다. 예약올 요","words":[{"text":"을","x":155,"y":285,"width":32,"height":35},{"text":"요구하는","x":201,"y":284,"width":134,"height":36},{"text":"레스토i!寸과","x":350,"y":282,"width":169,"height":38},{"text":"예약이","x":532,"y":283,"width":98,"height":38},{"text":"필요","x":649,"y":284,"width":65,"height":37},{"text":"없는(또한","x":730,"y":285,"width":148,"height":37},{"text":"받지도","x":892,"y":285,"width":100,"height":37},{"text":"않는)","x":1006,"y":285,"width":80,"height":36},{"text":"레스토랑이다.","x":1103,"y":283,"width":209,"height":38},{"text":"예약올","x":1327,"y":282,"width":98,"height":39},{"text":"요","x":1438,"y":283,"width":33,"height":31}]},{"text":"구하는 레스토i!*卜은 집을 떠나기 전에 전화로 예약하면 레스토랑에 도착하자마자 바로","words":[{"text":"구하는","x":155,"y":343,"width":101,"height":37},{"text":"레스토i!*卜은","x":272,"y":343,"width":168,"height":37},{"text":"집을","x":457,"y":343,"width":65,"height":37},{"text":"떠나기","x":539,"y":343,"width":95,"height":38},{"text":"전에","x":656,"y":343,"width":62,"height":38},{"text":"전화로","x":740,"y":345,"width":98,"height":36},{"text":"예약하면","x":853,"y":345,"width":134,"height":37},{"text":"레스토랑에","x":1006,"y":343,"width":168,"height":39},{"text":"도착하자마자","x":1192,"y":343,"width":200,"height":38},{"text":"바로","x":1406,"y":343,"width":65,"height":37}]},{"text":"자리에 앉을 수 있고 음식을 주문할 수 있다. 반면 예약을 받지 않는 레스토랑은 테이","words":[{"text":"자리에","x":157,"y":403,"width":96,"height":37},{"text":"앉을","x":271,"y":403,"width":66,"height":36},{"text":"수","x":352,"y":403,"width":33,"height":36},{"text":"있고","x":402,"y":402,"width":65,"height":37},{"text":"음식을","x":483,"y":403,"width":102,"height":37},{"text":"주문할","x":600,"y":404,"width":102,"height":37},{"text":"수","x":717,"y":404,"width":34,"height":36},{"text":"있다.","x":768,"y":404,"width":72,"height":38},{"text":"반면","x":859,"y":405,"width":64,"height":37},{"text":"예약을","x":942,"y":404,"width":102,"height":38},{"text":"받지","x":1061,"y":403,"width":62,"height":39},{"text":"않는","x":1143,"y":405,"width":68,"height":37},{"text":"레스토랑은","x":1228,"y":404,"width":165,"height":39},{"text":"테이","x":1407,"y":402,"width":61,"height":38}]},{"text":"불을 예약하는 준비작업은 필요 없지만 레스토랑에 갔을 때, 바로 앉지 못하고 기다릴","words":[{"text":"불을","x":155,"y":463,"width":67,"height":37},{"text":"예약하는","x":237,"y":463,"width":134,"height":36},{"text":"준비작업은","x":385,"y":462,"width":171,"height":38},{"text":"필요","x":573,"y":464,"width":65,"height":37},{"text":"없지만","x":654,"y":464,"width":101,"height":37},{"text":"레스토랑에","x":770,"y":464,"width":167,"height":39},{"text":"갔을","x":957,"y":464,"width":66,"height":37},{"text":"때,","x":1039,"y":463,"width":40,"height":37},{"text":"바로","x":1097,"y":465,"width":67,"height":37},{"text":"앉지","x":1180,"y":465,"width":63,"height":38},{"text":"못하고","x":1261,"y":466,"width":99,"height":37},{"text":"기다릴","x":1376,"y":464,"width":94,"height":38}]},{"text":"수도 있다.","words":[{"text":"수도","x":155,"y":523,"width":67,"height":37},{"text":"있다.","x":237,"y":523,"width":72,"height":37}]},{"text":"회선 교환 네트워크의 예로 전통적인 전화망이 있다. 어떤 사람이 전화망을 통해","words":[{"text":"회선","x":224,"y":583,"width":63,"height":37},{"text":"교환","x":304,"y":583,"width":68,"height":36},{"text":"네트워크의","x":388,"y":583,"width":166,"height":38},{"text":"예로","x":574,"y":584,"width":66,"height":37},{"text":"전통적인","x":658,"y":584,"width":134,"height":38},{"text":"전화망이","x":811,"y":585,"width":131,"height":38},{"text":"있다.","x":964,"y":584,"width":74,"height":38},{"text":"어떤","x":1058,"y":585,"width":66,"height":37},{"text":"사람이","x":1143,"y":586,"width":99,"height":38},{"text":"전화망을","x":1264,"y":586,"width":131,"height":38},{"text":"통해","x":1408,"y":585,"width":64,"height":38}]},{"text":"다른 사람에게 정보(음성이나 팩시밀리)를 보내려고 할 때 어떤 일이 일어나는지 생각","words":[{"text":"다른","x":156,"y":644,"width":67,"height":37},{"text":"사람에게","x":237,"y":643,"width":131,"height":38},{"text":"정보(음성이나","x":386,"y":644,"width":218,"height":38},{"text":"팩시밀리)를","x":618,"y":644,"width":183,"height":39},{"text":"보내려고","x":814,"y":645,"width":137,"height":38},{"text":"할","x":967,"y":645,"width":33,"height":37},{"text":"때","x":1016,"y":645,"width":29,"height":37},{"text":"어떤","x":1064,"y":646,"width":66,"height":37},{"text":"일이","x":1148,"y":646,"width":64,"height":38},{"text":"일어나는지","x":1231,"y":646,"width":162,"height":39},{"text":"생각","x":1411,"y":646,"width":65,"height":38}]},{"text":"해 보자. 송신자가 정보를 보내기 전에 네트워크는 송신자와 수신자 간의 연결을 설정","words":[{"text":"해","x":156,"y":705,"width":30,"height":37},{"text":"보자.","x":203,"y":705,"width":74,"height":37},{"text":"송신자가","x":293,"y":704,"width":136,"height":38},{"text":"정보를","x":445,"y":704,"width":100,"height":38},{"text":"보내기","x":559,"y":705,"width":97,"height":37},{"text":"전에","x":677,"y":705,"width":63,"height":38},{"text":"네트워크는","x":758,"y":705,"width":171,"height":38},{"text":"송신자와","x":943,"y":706,"width":140,"height":37},{"text":"수신자","x":1096,"y":707,"width":106,"height":37},{"text":"간의","x":1217,"y":707,"width":64,"height":38},{"text":"연결을","x":1301,"y":706,"width":97,"height":38},{"text":"설정","x":1413,"y":706,"width":60,"height":38}]},{"text":"해야 한다. 이것은 송신자와 수신자 간의 경로에 있는 스위치들이 해당 연결 상대를 유","words":[{"text":"해야","x":156,"y":765,"width":68,"height":38},{"text":"한다.","x":236,"y":766,"width":73,"height":37},{"text":"이것은","x":326,"y":765,"width":101,"height":38},{"text":"송신자와","x":438,"y":765,"width":139,"height":38},{"text":"수신자","x":588,"y":765,"width":103,"height":38},{"text":"간의","x":704,"y":766,"width":65,"height":37},{"text":"경로에","x":787,"y":766,"width":98,"height":38},{"text":"있는","x":903,"y":766,"width":68,"height":37},{"text":"스위치들이","x":984,"y":766,"width":169,"height":37},{"text":"해당","x":1172,"y":767,"width":69,"height":38},{"text":"연결","x":1256,"y":768,"width":63,"height":36},{"text":"상대를","x":1334,"y":766,"width":100,"height":39},{"text":"유","x":1446,"y":766,"width":33,"height":37}]},{"text":"지해야 하는 연결이다. 전기통신 용어로 이 연결을 회선(circuit)이라고 한다. 네트워","words":[{"text":"지해야","x":157,"y":826,"width":100,"height":37},{"text":"하는","x":274,"y":827,"width":66,"height":37},{"text":"연결이다.","x":358,"y":826,"width":140,"height":37},{"text":"전기통신","x":519,"y":826,"width":134,"height":38},{"text":"용어로","x":670,"y":826,"width":103,"height":38},{"text":"이","x":791,"y":827,"width":29,"height":37},{"text":"연결을","x":842,"y":827,"width":102,"height":37},{"text":"회선(circuit)이라고","x":960,"y":826,"width":311,"height":38},{"text":"한다.","x":1287,"y":828,"width":75,"height":37},{"text":"네트워","x":1382,"y":827,"width":94,"height":37}]},{"text":"그가 회선을 설정할 때, 그 연결이 이루어지는 동안 네트워크 링그(각 링크의 전송 용","words":[{"text":"그가","x":156,"y":887,"width":68,"height":37},{"text":"회선을","x":239,"y":887,"width":99,"height":37},{"text":"설정할","x":354,"y":887,"width":101,"height":38},{"text":"때,","x":470,"y":887,"width":40,"height":36},{"text":"그","x":526,"y":892,"width":34,"height":25},{"text":"연결이","x":578,"y":887,"width":95,"height":37},{"text":"이루어지는","x":693,"y":887,"width":173,"height":37},{"text":"동안","x":879,"y":887,"width":71,"height":39},{"text":"네트워크","x":966,"y":886,"width":137,"height":38},{"text":"링그(각","x":1120,"y":887,"width":117,"height":38},{"text":"링크의","x":1253,"y":888,"width":96,"height":38},{"text":"전송","x":1369,"y":887,"width":65,"height":38},{"text":"용","x":1447,"y":887,"width":34,"height":37}]},{"text":"량의 일부를 나타냄)에 일정한 전송률을 예약한다. 주어진 전송속도가 송신자-수신자","words":[{"text":"량의","x":156,"y":947,"width":63,"height":37},{"text":"일부를","x":239,"y":948,"width":98,"height":37},{"text":"나타냄)에","x":352,"y":947,"width":144,"height":39},{"text":"일정한","x":516,"y":947,"width":101,"height":38},{"text":"전송률을","x":632,"y":947,"width":136,"height":38},{"text":"예약한다.","x":783,"y":948,"width":145,"height":37},{"text":"주어진","x":945,"y":947,"width":103,"height":38},{"text":"전송속도가","x":1066,"y":947,"width":173,"height":38},{"text":"송신자-수신자","x":1252,"y":947,"width":230,"height":39}]},{"text":"연결을 위해 예약되므로, 송신자는 수신자에게 보장된(guaranteed) 일정 전송률로 데","words":[{"text":"연결을","x":158,"y":1007,"width":99,"height":38},{"text":"위해","x":274,"y":1008,"width":62,"height":38},{"text":"예약되므로,","x":356,"y":1008,"width":176,"height":37},{"text":"송신자는","x":549,"y":1007,"width":139,"height":38},{"text":"수신자에게","x":703,"y":1008,"width":171,"height":38},{"text":"보장된(guaranteed)","x":892,"y":1009,"width":306,"height":40},{"text":"일정","x":1217,"y":1008,"width":63,"height":39},{"text":"전송률로","x":1301,"y":1009,"width":133,"height":38},{"text":"데","x":1450,"y":1007,"width":28,"height":38}]},{"text":"이터를 보낼 수 있다.","words":[{"text":"이터를","x":157,"y":1068,"width":100,"height":38},{"text":"보낼","x":269,"y":1069,"width":65,"height":37},{"text":"수","x":349,"y":1069,"width":33,"height":37},{"text":"있다.","x":397,"y":1069,"width":71,"height":37}]},{"text":"그림 1.13은 회선 교환 네트워크를 보여 준다. 이 네트워크는 4개의 회선 스위치","words":[{"text":"그림","x":223,"y":1129,"width":61,"height":37},{"text":"1.13은","x":307,"y":1130,"width":98,"height":36},{"text":"회선","x":422,"y":1129,"width":64,"height":37},{"text":"교환","x":503,"y":1129,"width":69,"height":37},{"text":"네트워크를","x":587,"y":1129,"width":173,"height":38},{"text":"보여","x":775,"y":1130,"width":66,"height":37},{"text":"준다.","x":861,"y":1130,"width":78,"height":38},{"text":"이","x":959,"y":1130,"width":29,"height":37},{"text":"네트워크는","x":1008,"y":1129,"width":175,"height":39},{"text":"4개의","x":1197,"y":1131,"width":86,"height":38},{"text":"회선","x":1304,"y":1131,"width":63,"height":37},{"text":"스위치","x":1383,"y":1130,"width":95,"height":38}]},{"text":"가 4개의 링크에 연결되어 있다. 이들 각 링크는 4개의 회선을 가지므로 각 링크는4개","words":[{"text":"가","x":157,"y":1190,"width":33,"height":37},{"text":"4개의","x":200,"y":1190,"width":84,"height":37},{"text":"링크에","x":303,"y":1190,"width":95,"height":37},{"text":"연결되어","x":417,"y":1190,"width":129,"height":37},{"text":"있다.","x":565,"y":1190,"width":73,"height":37},{"text":"이들","x":655,"y":1190,"width":68,"height":37},{"text":"각","x":736,"y":1190,"width":35,"height":37},{"text":"링크는","x":786,"y":1191,"width":103,"height":37},{"text":"4개의","x":900,"y":1192,"width":88,"height":37},{"text":"회선을","x":1007,"y":1191,"width":104,"height":38},{"text":"가지므로","x":1125,"y":1191,"width":136,"height":38},{"text":"각","x":1275,"y":1193,"width":33,"height":37},{"text":"링크는4개","x":1322,"y":1192,"width":157,"height":38}]},{"text":"의 동시 연결을 지원할 수 있다. 호스트(예: PC와 워크스테이션)는 스위치 중 하나에","words":[{"text":"의","x":158,"y":1250,"width":28,"height":37},{"text":"동시","x":205,"y":1251,"width":63,"height":37},{"text":"연결을","x":290,"y":1251,"width":99,"height":37},{"text":"지원할","x":406,"y":1250,"width":100,"height":38},{"text":"수","x":519,"y":1250,"width":36,"height":37},{"text":"있다.","x":572,"y":1250,"width":74,"height":38},{"text":"호스트(예:","x":664,"y":1251,"width":162,"height":38},{"text":"PC와","x":845,"y":1252,"width":86,"height":38},{"text":"워크스테이션)는","x":946,"y":1253,"width":259,"height":38},{"text":"스위치","x":1219,"y":1254,"width":99,"height":38},{"text":"중","x":1336,"y":1254,"width":33,"height":38},{"text":"하나에","x":1384,"y":1253,"width":95,"height":38}]},{"text":"직접 연결된다. 두 호스트가 통신하고 싶을 때 네트워크는 두 호스트 사이에 지정된 종","words":[{"text":"직접","x":158,"y":1310,"width":62,"height":37},{"text":"연결된다.","x":238,"y":1311,"width":140,"height":38},{"text":"두","x":393,"y":1314,"width":34,"height":35},{"text":"호스트가","x":439,"y":1311,"width":137,"height":37},{"text":"통신하고","x":587,"y":1311,"width":141,"height":37},{"text":"싶을","x":741,"y":1311,"width":70,"height":37},{"text":"때","x":825,"y":1312,"width":30,"height":37},{"text":"네트워크는","x":873,"y":1313,"width":176,"height":37},{"text":"두","x":1061,"y":1315,"width":35,"height":36},{"text":"호스트","x":1109,"y":1315,"width":104,"height":30},{"text":"사이에","x":1225,"y":1315,"width":98,"height":38},{"text":"지정된","x":1340,"y":1315,"width":96,"height":38},{"text":"종","x":1448,"y":1316,"width":34,"height":36}]},{"text":"단간 연결(end-to-end connection)을 설정한다. 그러므로 호스트 A가 호스트 B와 통","words":[{"text":"단간","x":156,"y":1370,"width":69,"height":37},{"text":"연결(end-to-end","x":239,"y":1371,"width":255,"height":39},{"text":"connection)을","x":506,"y":1371,"width":233,"height":38},{"text":"설정한다.","x":754,"y":1372,"width":147,"height":38},{"text":"그러므로","x":917,"y":1374,"width":141,"height":36},{"text":"호스트","x":1072,"y":1376,"width":105,"height":30},{"text":"A가","x":1189,"y":1375,"width":64,"height":37},{"text":"호스트","x":1265,"y":1378,"width":100,"height":30},{"text":"B와","x":1378,"y":1375,"width":59,"height":37},{"text":"통","x":1448,"y":1376,"width":33,"height":36}]},{"text":"신하기 위해 네트워크는 먼저 2개의 링크 각각에 한 회선을 예약한다. 이 예에서, 지정","words":[{"text":"신하기","x":158,"y":1431,"width":95,"height":38},{"text":"위해","x":272,"y":1432,"width":63,"height":38},{"text":"네트워크는","x":353,"y":1433,"width":167,"height":37},{"text":"먼저","x":536,"y":1432,"width":62,"height":37},{"text":"2개의","x":615,"y":1432,"width":86,"height":38},{"text":"링크","x":721,"y":1432,"width":68,"height":38},{"text":"각각에","x":802,"y":1433,"width":102,"height":38},{"text":"한","x":921,"y":1434,"width":35,"height":35},{"text":"회선을","x":969,"y":1434,"width":105,"height":37},{"text":"예약한다.","x":1088,"y":1434,"width":144,"height":38},{"text":"이","x":1249,"y":1436,"width":28,"height":36},{"text":"예에서,","x":1295,"y":1436,"width":106,"height":37},{"text":"지정","x":1416,"y":1435,"width":61,"height":38}]},{"text":"된 종단간 연결은 첫 번째 링크의 두 번째 회선을 사용하고 두 번째 링크의 네 번째 회","words":[{"text":"된","x":157,"y":1491,"width":32,"height":37},{"text":"종단간","x":203,"y":1492,"width":102,"height":37},{"text":"연결은","x":319,"y":1493,"width":100,"height":37},{"text":"첫","x":433,"y":1493,"width":31,"height":37},{"text":"번째","x":479,"y":1493,"width":64,"height":37},{"text":"링크의","x":561,"y":1492,"width":98,"height":38},{"text":"두","x":676,"y":1495,"width":36,"height":34},{"text":"번째","x":727,"y":1493,"width":64,"height":37},{"text":"회선을","x":809,"y":1494,"width":104,"height":36},{"text":"사용하고","x":925,"y":149