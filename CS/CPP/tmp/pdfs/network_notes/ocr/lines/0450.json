":596,"width":367,"height":31},{"text":"갖는","x":1273,"y":596,"width":57,"height":31},{"text":"어댑터의","x":1341,"y":596,"width":117,"height":31},{"text":"위치를","x":1471,"y":595,"width":90,"height":31},{"text":"알게","x":1573,"y":595,"width":58,"height":31},{"text":"된다","x":1644,"y":594,"width":58,"height":31}]},{"text":"에 연결하는 것 이외의 일은 하지 않는다. 네트워크 관리자는 설치 시나 호스트를 랜","words":[{"text":"에","x":532,"y":745,"width":29,"height":37},{"text":"연결하는","x":581,"y":744,"width":131,"height":38},{"text":"것","x":728,"y":743,"width":29,"height":37},{"text":"이외의","x":775,"y":742,"width":95,"height":39},{"text":"일은","x":890,"y":742,"width":65,"height":37},{"text":"하지","x":971,"y":742,"width":62,"height":38},{"text":"않는다.","x":1054,"y":741,"width":107,"height":38},{"text":"네트워크","x":1182,"y":741,"width":135,"height":38},{"text":"관리자는","x":1334,"y":741,"width":143,"height":38},{"text":"설치","x":1495,"y":740,"width":67,"height":37},{"text":"시나","x":1585,"y":740,"width":71,"height":38},{"text":"호스트를","x":1674,"y":741,"width":137,"height":35},{"text":"랜","x":1827,"y":742,"width":25,"height":36}]},{"text":"세그먼트에서 제거할 때 스위치 테이블을 구성할 필요가 없다. 또한 스위치는 전이중","words":[{"text":"세그먼트에서","x":531,"y":803,"width":194,"height":38},{"text":"제거할","x":745,"y":803,"width":99,"height":38},{"text":"때","x":859,"y":803,"width":29,"height":37},{"text":"스위치","x":905,"y":803,"width":97,"height":37},{"text":"테이블을","x":1022,"y":802,"width":135,"height":38},{"text":"구성할","x":1171,"y":802,"width":104,"height":38},{"text":"필요가","x":1291,"y":801,"width":105,"height":37},{"text":"없다.","x":1414,"y":801,"width":76,"height":37},{"text":"또한","x":1510,"y":801,"width":74,"height":36},{"text":"스위치는","x":1599,"y":801,"width":146,"height":38},{"text":"전이중","x":1763,"y":801,"width":90,"height":38}]},{"text":"이며, 따라서 노드와 스위치는 이 둘 사이를 연결해 주는 링크로 덩*- 없이 동시에 전","words":[{"text":"이며,","x":530,"y":864,"width":73,"height":38},{"text":"따라서","x":619,"y":864,"width":96,"height":38},{"text":"노드와","x":732,"y":864,"width":102,"height":37},{"text":"스위치는","x":846,"y":864,"width":135,"height":37},{"text":"이","x":996,"y":863,"width":27,"height":37},{"text":"둘","x":1041,"y":864,"width":34,"height":35},{"text":"사이를","x":1089,"y":862,"width":103,"height":37},{"text":"연결해","x":1208,"y":862,"width":98,"height":37},{"text":"주는","x":1323,"y":864,"width":71,"height":35},{"text":"링크로","x":1412,"y":861,"width":105,"height":37},{"text":"덩*-","x":1533,"y":862,"width":74,"height":36},{"text":"없이","x":1625,"y":862,"width":65,"height":37},{"text":"동시에","x":1710,"y":862,"width":98,"height":37},{"text":"전","x":1827,"y":864,"width":23,"height":35}]},{"text":"송할 수 있다.","words":[{"text":"송할","x":528,"y":925,"width":68,"height":36},{"text":"수","x":606,"y":925,"width":34,"height":37},{"text":"있다.","x":654,"y":924,"width":72,"height":38}]},{"text":"림크 계층 스위치의 특성","words":[{"text":"림크","x":530,"y":1029,"width":69,"height":41},{"text":"계층","x":607,"y":1027,"width":72,"height":43},{"text":"스위치의","x":685,"y":1027,"width":138,"height":35},{"text":"특성","x":834,"y":1028,"width":67,"height":41}]},{"text":"지금까지 링크 계층 스위치의 기본 동작에 대해서 설명했으며, 이제 그 특징과 특성을","words":[{"text":"지금까지","x":528,"y":1098,"width":129,"height":37},{"text":"링크","x":676,"y":1099,"width":65,"height":36},{"text":"계층","x":757,"y":1098,"width":65,"height":37},{"text":"스위치의","x":834,"y":1097,"width":130,"height":37},{"text":"기본","x":984,"y":1098,"width":64,"height":36},{"text":"동작에","x":1061,"y":1096,"width":98,"height":37},{"text":"대해서","x":1178,"y":1096,"width":96,"height":37},{"text":"설명했으며,","x":1294,"y":1095,"width":184,"height":37},{"text":"이제","x":1497,"y":1095,"width":68,"height":37},{"text":"그","x":1583,"y":1100,"width":36,"height":25},{"text":"특징과","x":1634,"y":1095,"width":110,"height":36},{"text":"특성을","x":1757,"y":1094,"width":93,"height":36}]},{"text":"살펴보자. 버스나 허브 기반의 스타 토폴로지와 같은 브로드개스트 링크가 아닌 스위","words":[{"text":"살펴보자.","x":527,"y":1157,"width":141,"height":37},{"text":"버스나","x":687,"y":1157,"width":100,"height":37},{"text":"허브","x":802,"y":1157,"width":64,"height":36},{"text":"기반의","x":883,"y":1156,"width":95,"height":37},{"text":"스타","x":995,"y":1157,"width":68,"height":36},{"text":"토폴로지와","x":1077,"y":1155,"width":170,"height":36},{"text":"같은","x":1262,"y":1155,"width":68,"height":36},{"text":"브로드개스트","x":1345,"y":1155,"width":218,"height":37},{"text":"링크가","x":1583,"y":1154,"width":107,"height":36},{"text":"아닌","x":1707,"y":1153,"width":65,"height":36},{"text":"스위","x":1789,"y":1154,"width":57,"height":35}]},{"text":"치를 사용하면 다음과 같은 장점이 있다.","words":[{"text":"치를","x":528,"y":1216,"width":67,"height":37},{"text":"사용하면","x":606,"y":1216,"width":133,"height":38},{"text":"다음과","x":753,"y":1216,"width":99,"height":36},{"text":"같은","x":864,"y":1215,"width":67,"height":36},{"text":"장점이","x":942,"y":1216,"width":97,"height":36},{"text":"있다.","x":1057,"y":1215,"width":70,"height":37}]},{"text":"충돌 제거. 스위치로 (허브 없이) 구축된 랜에는 충돌로 인해 당비되는 대역폭이 없","words":[{"text":"충돌","x":593,"y":1310,"width":63,"height":34},{"text":"제거.","x":666,"y":1309,"width":69,"height":34},{"text":"스위치로","x":750,"y":1306,"width":132,"height":36},{"text":"(허브","x":894,"y":1306,"width":79,"height":37},{"text":"없이)","x":988,"y":1307,"width":75,"height":37},{"text":"구축된","x":1076,"y":1306,"width":99,"height":37},{"text":"랜에는","x":1191,"y":1306,"width":101,"height":35},{"text":"충돌로","x":1304,"y":1305,"width":106,"height":36},{"text":"인해","x":1426,"y":1305,"width":67,"height":37},{"text":"당비되는","x":1510,"y":1305,"width":147,"height":37},{"text":"대역폭이","x":1671,"y":1304,"width":134,"height":36},{"text":"없","x":1822,"y":1305,"width":25,"height":35}]},{"text":"다. 스위치는 프레임을 버퍼링하며 어느 시점이든 세그먼트에 하나 이상의 프레임","words":[{"text":"다.","x":594,"y":1367,"width":40,"height":36},{"text":"스위치는","x":649,"y":1366,"width":132,"height":36},{"text":"프레임을","x":794,"y":1365,"width":133,"height":36},{"text":"버퍼링하며","x":940,"y":1365,"width":161,"height":37},{"text":"어느","x":1120,"y":1365,"width":65,"height":37},{"text":"시점이든","x":1199,"y":1364,"width":137,"height":38},{"text":"세그먼트에","x":1349,"y":1365,"width":178,"height":37},{"text":"하나","x":1545,"y":1365,"width":73,"height":37},{"text":"이상의","x":1634,"y":1364,"width":104,"height":37},{"text":"프레임","x":1755,"y":1364,"width":89,"height":36}]},{"text":"을 전송하지 않는다. 라우터에서와 마찬가지로 스위치의 최대 총처리율은 모든 스","words":[{"text":"을","x":593,"y":1428,"width":34,"height":35},{"text":"전송하지","x":641,"y":1424,"width":127,"height":39},{"text":"않는다.","x":785,"y":1424,"width":105,"height":38},{"text":"라우터에서와","x":907,"y":1424,"width":200,"height":40},{"text":"마찬가지로","x":1119,"y":1425,"width":169,"height":39},{"text":"스위치의","x":1302,"y":1425,"width":137,"height":38},{"text":"최대","x":1458,"y":1426,"width":69,"height":37},{"text":"총처리율은","x":1544,"y":1425,"width":185,"height":38},{"text":"모든","x":1742,"y":1426,"width":66,"height":34},{"text":"스","x":1819,"y":1427,"width":29,"height":28}]},{"text":"위치 인터페이스 속도의 합이다. 따라서 스위치는 브로드캐스트 링크를 사용하는","words":[{"text":"위치","x":594,"y":1486,"width":62,"height":38},{"text":"인터페이스","x":676,"y":1484,"width":164,"height":38},{"text":"속도의","x":853,"y":1485,"width":96,"height":38},{"text":"합이다.","x":967,"y":1486,"width":107,"height":38},{"text":"따라서","x":1091,"y":1487,"width":96,"height":38},{"text":"스위치는","x":1206,"y":1486,"width":139,"height":38},{"text":"브로드캐스트","x":1359,"y":1487,"width":219,"height":37},{"text":"링크를","x":1596,"y":1486,"width":108,"height":38},{"text":"사용하는","x":1720,"y":1485,"width":129,"height":38}]},{"text":"랜보다 성능-을 월등히 향상시킨다.","words":[{"text":"랜보다","x":594,"y":1545,"width":99,"height":38},{"text":"성능-을","x":705,"y":1545,"width":99,"height":37},{"text":"월등히","x":817,"y":1545,"width":94,"height":38},{"text":"향상시킨다.","x":927,"y":1546,"width":174,"height":39}]},{"text":"이질적인(heterogeneous) 링크들. 스위치는 링크들을 별개로 분리하기 때문에 랜의","words":[{"text":"이질적인(heterogeneous)","x":593,"y":1619,"width":367,"height":39},{"text":"링크들.","x":974,"y":1621,"width":99,"height":35},{"text":"스위치는","x":1087,"y":1621,"width":135,"height":38},{"text":"링크들을","x":1236,"y":1620,"width":138,"height":38},{"text":"별