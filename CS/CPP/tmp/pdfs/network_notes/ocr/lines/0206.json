text":"시간은","x":719,"y":1114,"width":99,"height":36},{"text":"다이어그램의","x":834,"y":1114,"width":199,"height":38},{"text":"위로부터","x":1055,"y":1116,"width":132,"height":37},{"text":"아래로","x":1209,"y":1116,"width":105,"height":36},{"text":"움직인다.","x":1330,"y":1114,"width":150,"height":36}]},{"text":"즉, 패킷에 대한 수신 시간은 전송 지연과 전파 지연 때문에 패것 전송 시간보다 더 늦","words":[{"text":"즉,","x":168,"y":1174,"width":41,"height":36},{"text":"패킷에","x":226,"y":1171,"width":97,"height":38},{"text":"대한","x":341,"y":1171,"width":66,"height":37},{"text":"수신","x":418,"y":1171,"width":65,"height":37},{"text":"시간은","x":499,"y":1172,"width":97,"height":37},{"text":"전송","x":610,"y":1173,"width":64,"height":37},{"text":"지연과","x":687,"y":1173,"width":99,"height":37},{"text":"전파","x":800,"y":1173,"width":66,"height":37},{"text":"지연","x":879,"y":1173,"width":65,"height":36},{"text":"때문에","x":960,"y":1174,"width":99,"height":37},{"text":"패것","x":1076,"y":1175,"width":66,"height":37},{"text":"전송","x":1160,"y":1176,"width":68,"height":36},{"text":"시간보다","x":1242,"y":1173,"width":141,"height":38},{"text":"더","x":1399,"y":1173,"width":28,"height":37},{"text":"늦","x":1444,"y":1175,"width":37,"height":35}]},{"text":"다. 그림 3.16(b)~(d)에서 송신 측 네모 괄호는 타이머가 설정된 후에 타임 아못된 시","words":[{"text":"다.","x":169,"y":1233,"width":39,"height":36},{"text":"그림","x":224,"y":1232,"width":64,"height":36},{"text":"3.16(b)~(d)에서","x":306,"y":1232,"width":251,"height":38},{"text":"송신","x":573,"y":1232,"width":65,"height":36},{"text":"측","x":652,"y":1233,"width":32,"height":36},{"text":"네모","x":698,"y":1232,"width":64,"height":36},{"text":"괄호는","x":775,"y":1232,"width":101,"height":35},{"text":"타이머가","x":889,"y":1232,"width":137,"height":37},{"text":"설정된","x":1040,"y":1233,"width":102,"height":37},{"text":"후에","x":1156,"y":1235,"width":68,"height":35},{"text":"타임","x":1240,"y":1233,"width":66,"height":37},{"text":"아못된","x":1324,"y":1233,"width":106,"height":36},{"text":"시","x":1445,"y":1233,"width":30,"height":36}]},{"text":"간을 가리킨다. 이 프로