":221,"height":32},{"text":"구조의","x":1146,"y":992,"width":85,"height":31},{"text":"분배","x":1243,"y":993,"width":56,"height":31},{"text":"시간","x":1311,"y":994,"width":58,"height":30}]},{"text":"비트토렌트","words":[{"text":"비트토렌트","x":564,"y":1138,"width":175,"height":39}]},{"text":"비트토렌트는 파일 분배를 위한 인기 있는 P2P 프로토콜이다[Chao 2011]. 비트토렌트","words":[{"text":"비트토렌트는","x":561,"y":1209,"width":201,"height":36},{"text":"파일","x":773,"y":1208,"width":66,"height":37},{"text":"분배를","x":852,"y":1208,"width":104,"height":38},{"text":"위한","x":970,"y":1209,"width":68,"height":38},{"text":"인기","x":1053,"y":1209,"width":61,"height":38},{"text":"있는","x":1134,"y":1209,"width":67,"height":37},{"text":"P2P","x":1213,"y":1213,"width":63,"height":28},{"text":"프로토콜이다[Chao","x":1289,"y":1208,"width":300,"height":39},{"text":"2011].","x":1602,"y":1213,"width":99,"height":35},{"text":"비트토렌트","x":1720,"y":1211,"width":161,"height":39}]},{"text":"용어로특정 파일의 분배에 참여하는 모든 피어들의 모임을 토렌트(torrent)라고 부른다.","words":[{"text":"용어로특정","x":556,"y":1268,"width":166,"height":38},{"text":"파일의","x":738,"y":1269,"width":98,"height":38},{"text":"분배에","x":852,"y":1269,"width":100,"height":39},{"text":"참여하는","x":967,"y":1269,"width":139,"height":39},{"text":"모든","x":1118,"y":1272,"width":69,"height":34},{"text":"피어들의","x":1201,"y":1270,"width":133,"height":39},{"text":"모임을","x":1349,"y":1269,"width":103,"height":38},{"text":"토렌트(torrent)라고","x":1463,"y":1270,"width":300,"height":38},{"text":"부른다.","x":1776,"y":1271,"width":102,"height":42}]},{"text":"토렌트에 참여하는 피어들은 서로에게서 같은 크기의 청크(chunk)를 다운로드한다. 일","words":[{"text":"토렌트에","x":555,"y":1329,"width":133,"height":39},{"text":"참여하는","x":706,"y":1329,"width":136,"height":39},{"text":"피어들은","x":856,"y":1330,"width":136,"height":39},{"text":"서로에게서","x":1006,"y":1331,"width":168,"height":39},{"text":"같은","x":1193,"y":1331,"width":68,"height":38},{"text":"크기의","x":1274,"y":1331,"width":100,"height":38},{"text":"청크(chunk)를","x":1391,"y":1331,"width":217,"height":39},{"text":"다운로드한다.","x":1622,"y":1330,"width":211,"height":39},{"text":"일","x":1851,"y":1338,"width":26,"height":37}]},{"text":"반적인 정크의 크기는 256킬로바이트다. 피어가 처음으로 토렌트에 가입하면, 그 피어","words":[{"text":"반적인","x":556,"y":1391,"width":100,"height":38},{"text":"정크의","x":672,"y":1392,"width":97,"height":38},{"text":"크기는","x":786,"y":1393,"width":103,"height":38},{"text":"256킬로바이트다.","x":902,"y":1393,"width":272,"height":39},{"text":"피어가","x":1192,"y":1392,"width":102,"height":38},{"text":"처음으로","x":1308,"y":1393,"width":135,"height":37},{"text":"토렌트에","x":1456,"y":1391,"width":134,"height":39},{"text":"가입하면,","x":1608,"y":1392,"width":145,"height":38},{"text":"그","x":1768,"y":1397,"width":34,"height":26},{"text":"피어","x":1817,"y":1394,"width":57,"height":42}]},{"text":"에는 청크가 없지만 시간이 지남에 따라 점점 많은 청크들을 쌓을 수 있다. 피어가 청","words":[{"text":"에는","x":558,"y":1454,"width":66,"height":36},{"text":"청크가","x":640,"y":1454,"width":102,"height":38},{"text":"없지만","x":757,"y":1455,"width":101,"height":39},{"text":"시간이","x":872,"y":1455,"width":97,"height":38},{"text":"지남에","x":989,"y":1455,"width":99,"height":38},{"text":"따라","x":1106,"y":1454,"width":69,"height":38},{"text":"점점","x":1190,"y":1454,"width":63,"height":37},{"text":"많은","x":1272,"y":1453,"width":68,"height":39},{"text":"청크들을","x":1356,"y":1453,"width":135,"height":37},{"text":"쌓을","x":1505,"y":1453,"width":70,"height":38},{"text":"수","x":1588,"y":1453,"width":36,"height":37},{"text":"있다.","x":1641,"y":1453,"width":73,"height":37},{"text":"피어가","x":1733,"y":1453,"width":100,"height":38},{"text":"청","x":1848,"y":1458,"width":25,"height":38}]},{"text":"크를 다운로드할 때 피어는 또한 청크를 다른 피어들에게 업로드한다. 일단 한 피어가","words":[{"text":"크를","x":556,"y":1517,"width":68,"height":35},{"text":"다운로드할","x":638,"y":1515,"width":170,"height":39},{"text":"때","x":822,"y":1517,"width":29,"height":38},{"text":"피어는","x":871,"y":1517,"width":101,"height":38},{"text":"또한","x":985,"y":1516,"width":70,"height":37},{"text":"청크를","x":1069,"y":1516,"width":102,"height":38},{"text":"다른","x":1185,"y":1515,"width":68,"height":37},{"text":"피어들에게","x":1267,"y":1514,"width":168,"height":38},{"text":"업로드한다.","x":1454,"y":1514,"width":176,"height":38},{"text":"일단","x":1650,"y":1514,"width":67,"height":37},{"text":"한","x":1731,"y":1514,"width":35,"height":36},{"text":"피어가","x":1781,"y":1514,"width":95,"height":44}]},{"text":"전체 파일을 얻으면, 토렌트를 (이기적으로) 떠날 수 있거나 혹은 (이타적으로) 토렌트","words":[{"text":"전체","x":557,"y":1576,"width":63,"height":38},{"text":"파일을","x":636,"y":1577,"width":103,"height":38},{"text":"얻으면,","x":754,"y":1578,"width":107,"height":38},{"text":"토렌트를","x":877,"y":1579,"width":136,"height":36},{"text":"(이기적으로)","x":1027,"y":1577,"width":195,"height":40},{"text":"떠날","x":1238,"y":1575,"width":68,"height":39},{"text":"수","x":1318,"y":1576,"width":36,"height":37},{"text":"있거나","x":1369,"y":1575,"width":101,"height":39},{"text":"혹은","x":1482,"y":1576,"width":71,"height":37},{"text":"(이타적으로)","x":1566,"y":1576,"width":197,"height":39},{"text":"토렌트","x":1778,"y":1578,"width":96,"height":36}]},{"text":"에 남아서 다른 피어들로 정크를 계속해서 업로드할 수 있다. 또한 어떤 피어는 일부","words":[{"text":"에","x":554,"y":1637,"width":31,"height":37},{"text":"남아서","x":604,"y":1638,"width":97,"height":38},{"text":"다른","x":721,"y":1639,"width":68,"height":38},{"text":"피어들로","x":805,"y":1640,"width":134,"height":38},{"text":"정크를","x":956,"y":1639,"width":103,"height":39},{"text":"계속해서","x":1074,"y":1638,"width":132,"height":39},{"text":"업로드할","x":1229,"y":1637,"width":134,"height":38},{"text":"수","x":1377,"y":1638,"width":36,"height":37},{"text":"있다.","x":1431,"y":1637,"width":73,"height":38},{"text":"또한","x":1522,"y":1637,"width":70,"height":37},{"text":"어떤","x":1610,"y":1638,"width":64,"height":37},{"text":"피어는","x":1694,"y":1637,"width":102,"height":38},{"text":"일부","x":1814,"y":1639,"width":60,"height":39}]},{"text":"청크만을 가진 채로 토런!트를 떠날 수 있으며, 나중에 토렌트에 재가입할 수 있다.","words":[{"text":"청크만을","x":553,"y":1698,"width":134,"height":38},{"text":"가진","x":699,"y":1700,"width":67,"height":38},{"text":"채로","x":780,"y":1702,"width":66,"height":36},{"text":"토런!트를","x":859,"y":1701,"width":136,"height":37},{"text":"떠날","x":1008,"y":1700,"width":68,"height":39},{"text":"수","x":1086,"y":1701,"width":36,"height":37},{"text":"있으며,","x":1136,"y":1699,"width":106,"height":40},{"text":"나중에","x":1258,"y":1698,"width":99,"height":39},{"text":"토렌트에","x":1371,"y":1699,"width":135,"height":38},{"text":"재가입할","x":1522,"y":1699,"width":139,"height":38},{"text":"수","x":1671,"y":1699,"width":36,"height":38},{"text":"있다.","x":1722,"y":1698,"width":73,"height":38}]},{"text":"이제 비트토렌트가 어떻게 동작하는지 자세히 살펴보자. 비트토렌트는 좀 복잡한","words":[{"text":"이제","x":617,"y":1760,"width":64,"height":38},{"text":"비트토렌트가","x":701,"y":1761,"width":203,"height":39},{"text":"어떻게","x":920,"y":1762,"width":98,"height":38},{"text":"동작하는지","x":1035,"y":1761,"width":168,"height":39},{"text":"자세히","x":1220,"y":1759,"width":100,"height":39},{"text":"살펴보자.","x":1338,"y":1760,"width":147,"height":38},{"text":"비트토렌트는","x":1504,"y":1761,"width":208,"height":38},{"text":"좀","x":1726,"y":1762,"width":36,"height":36},{"text":"복잡한","x":1775,"y":1761,"width":99,"height":41}]},{"text":"프로토콜이기 때문에 가장 중요한 기법들만을 기술할 것이다. 이렇게 해서 나무를 통","words":[{"text":"프로토콜이기","x":551,"y":1822,"width":198,"height":39},{"text":"때문에","x":769,"y":1823,"width":98,"height":38},{"text":"가장","x":885,"y":1823,"width":68,"height":38},{"text":"중요한","x":966,"y":1823,"width":105,"height":38},{"text":"기법들만을","x":1086,"y":1822,"width":171,"height":38},{"text":"기술할","x":1273,"y":1821,"width":104,"height":38},{"text":"것이다.","x":1392,"y":1822,"width":110,"height":39},{"text":"이렇게","x":1521,"y":1823,"width":100,"height":39},{"text":"해서","x":1640,"y":1823,"width":65,"height":39},{"text":"나무를","x":1725,"y":1822,"width":105,"height":38},{"text":"통","x":1843,"y":1827,"width":31,"height":36}]},{"text":"해 숲을 보게 될 것이다. 각 토렌트는 트랙커(tracker)라고 부르는 기반구조 노드를 갖","words":[{"text":"해","x":552,"y":1884,"width":29,"height":38},{"text":"숲을","x":597,"y":1884,"width":68,"height":38},{"text":"보게","x":678,"y":1885,"width":65,"height":37},{"text":"될","x":760,"y":1885,"width":30,"height":37},{"text":"것이다.","x":808,"y":1885,"width":107,"height":38},{"text":"각","x":933,"y":1885,"width":34,"height":37},{"text":"토렌트는","x":980,"y":1885,"width":138,"height":36},{"text":"트랙커(tracker)라고","x":1131,"y":1884,"width":305,"height":38},{"text":"부르는","x":1451,"y":1886,"width":105,"height":37},{"text":"기반구조","x":1572,"y":1886,"width":138,"height":37},{"text":"노드를","x":1725,"y":1886,"width":106,"height":36},{"text":"갖","x":1844,"y":1888,"width":31,"height":38}]},{"text":"고 있다. 한 피어가 토렌트에 가입할 때 트랙커에 자신을 등록하고 주기적으로 자신이","words":[{"text":"고","x":553,"y":1952,"width":32,"height":26},{"text":"있다.","x":600,"y":1946,"width":71,"height":38},{"text":"한","x":686,"y":1947,"width":35,"height":36},{"text":"피어가","x":735,"y":1946,"width":99,"height":38},{"text":"토렌트에","x":846,"y":1946,"width":134,"height":37},{"text":"가입할","x":997,"y":1946,"width":102,"height":37},{"text":"때","x":1114,"y":1946,"width":29,"height":37},{"text":"트랙커에","x":1160,"y":1944,"width":134,"height":39},{"text":"자신을","x":1311,"y":1945,"width":105,"height":38},{"text":"등록하고","x":1429,"y":1947,"width":141,"height":38},{"text":"주기적으로","x":1583,"y":1947,"width":178,"height":39},{"text":"자신이","x":1776,"y":1946,"width":96,"height":42}]},{"text":"아직 토렌트에 있음을 알린다. 이러한 방식으로, 트랙커는 토렌트에 참여하는 피어들","words":[{"text":"아직","x":554,"y":2008,"width":60,"height":38},{"text":"토렌트에","x":633,"y":2008,"width":130,"height":38},{"text":"있음을","x":783,"y":2008,"width":98,"height":38},{"text":"알린다.","x":897,"y":2007,"width":107,"height":38},{"text":"이러한","x":1024,"y":2006,"width":103,"height":40},{"text":"방식으로,","x":1142,"y":2007,"width":143,"height":38},{"text":"트랙커는","x":1303,"y":2007,"width":141,"height":38},{"text":"토렌트에","x":1459,"y":2009,"width":138,"height":39},{"text":"참여하는","x":1616,"y":2008,"width":144,"height":38},{"text":"피어들","x":1777,"y":2008,"width":99,"height":41}]},{"text":"을 추적한다. 주어진 토렌트는 어느 순간에 수백 혹은 수천의 피어들이 참여하고 있을","words":[