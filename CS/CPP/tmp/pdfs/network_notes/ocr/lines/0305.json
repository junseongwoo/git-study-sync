height":39}]},{"text":"대해서 잘 알고 있고, 도착한 클라이언트는 대기 중인 줄 뒤쪽에서 기다리며 줄의 맨","words":[{"text":"대해서","x":153,"y":1751,"width":87,"height":38},{"text":"잘","x":259,"y":1752,"width":34,"height":36},{"text":"알고","x":309,"y":1752,"width":68,"height":38},{"text":"있고,","x":395,"y":1753,"width":74,"height":38},{"text":"도착한","x":486,"y":1752,"width":105,"height":38},{"text":"클라이언트는","x":604,"y":1753,"width":203,"height":39},{"text":"대기","x":823,"y":1754,"width":60,"height":38},{"text":"중인","x":903,"y":1756,"width":67,"height":37},{"text":"줄","x":986,"y":1758,"width":35,"height":34},{"text":"뒤쪽에서","x":1035,"y":1756,"width":130,"height":38},{"text":"기다리며","x":1185,"y":1756,"width":129,"height":38},{"text":"줄의","x":1333,"y":1757,"width":65,"height":38},{"text":"맨","x":1417,"y":1757,"width":33,"height":38}]},{"text":"앞으로 도착하면 서비스를 제공받는다. 그림 4.11은 FIFO 큐의 동작을 보여준다. 도착","words":[{"text":"앞으로","x":153,"y":1813,"width":91,"height":38},{"text":"도착하면","x":256,"y":1813,"width":136,"height":38},{"text":"서비스를","x":407,"y":1814,"width":137,"height":38},{"text":"제공받는다.","x":557,"y":1814,"width":175,"height":39},{"text":"그림","x":746,"y":1815,"width":63,"height":37},{"text":"4.11은","x":824,"y":1817,"width":102,"height":35},{"text":"FIFO","x":938,"y":1821,"width":82,"height":30},{"text":"큐의","x":1033,"y":1817,"width":64,"height":38},{"text":"동작을","x":1112,"y":1818,"width":102,"height":37},{"text":"보여준다.","x":1225,"y":1818,"width":142,"height":38},{"text":"도착","x":1382,"y":1819,"width":69,"height":38}]},{"text":"한 패킷은 도착한 순서를 나타내는 숫자와 함께 상단 타임라인 위에 번호가 매겨진 화","words":[{"text":"한","x":153,"y":1874,"width":29,"height":37},{"text":"패킷은","x":194,"y":1874,"width":97,"height":38},{"text":"도착한","x":304,"y":1876,"width":105,"height":37},{"text":"순서를","x":420,"y":1875,"width":104,"height":38},{"text":"나타내는","x":538,"y":1875,"width":136,"height":38},{"text":"숫자와","x":686,"y":1877,"width":102,"height":37},{"text":"함께","x":800,"y":1876,"width":64,"height":37},{"text":"상단","x":879,"y":1877,"width":69,"height":37},{"text":"타임라인","x":960,"y":1878,"width":133,"height":38},{"text":"위에","x":1108,"y":1878,"width":64,"height":38},{"text":"번호가","x":1189,"y":1879,"width":100,"height":38},{"text":"매겨진","x":1302,"y":1879,"width":98,"height":38},{"text":"화","x":1414,"y":1881,"width":36,"height":36}]},{"text":"살표로 표시된다. 개별 패킷의 전송은 하단 타임라인 아래 표시된다. 패것이 전송 중에","words":[{"text":"살표로","x":153,"y":1936,"width":91,"height":37},{"text":"표시된다.","x":256,"y":1937,"width":145,"height":38},{"text":"개별","x":418,"y":1936,"width":65,"height":38},{"text":"패킷의","x":499,"y":1936,"width":98,"height":38},{"text":"전송은","x":615,"y":1936,"width":100,"height":39},{"text":"하단","x":728,"y":1938,"width":66,"height":37},{"text":"타임라인","x":806,"y":1937,"width":133,"height":38},{"text":"아래","x":953,"y":1939,"width":63,"height":38},{"text":"표시된다.","x":1031,"y":1939,"width":141,"height":37},{"text":"패것이","x":1188,"y":1940,"width":97,"height":37},{"text":"전송","x":1302,"y":1940,"width":66,"height":37},{"text":"중에","x":1379,"y":1941,"width":66,"height":37}]},{"text":"소비하는 시간은 두 타임라인 사이의 사각형으로 표시된다. 이 예에서 패킷이 전송되","words":[{"text":"소비하는","x":153,"y":1997,"width":126,"height":37},{"text":"시간은","x":294,"y":1999,"width":103,"height":37},{"text":"두","x":411,"y":2001,"width":34,"height":35},{"text":"타임라인","x":461,"y":1997,"width":136,"height":38},{"text":"사이의","x":612,"y":1998,"width":98,"height":38},{"text":"사각형으로","x":728,"y":1998,"width":167,"height":38},{"text":"표시된다.","x":910,"y":2000,"width":140,"height":37},{"text":"이","x":1069,"y":2000,"width":28,"height":37},{"text":"예에서","x":1117,"y":1999,"width":95,"height":39},{"text":"패킷이","x":1231,"y":2000,"width":96,"height":38},{"text":"전송되","x":1346,"y":2000,"width":97,"height":38}]},{"text":"는 데 세 단위 시간이 걸린다고 가정하자. FIFO에서 패킷은 도착한 순서와 동일한 순","words":[{"text":"는","x":152,"y":2061,"width":29,"height":35},{"text":"데","x":195,"y":2058,"width":26,"height":38},{"text":"세","x":238,"y":2059,"width":30,"height":37},{"text":"단위","x":285,"y":2059,"width":65,"height":39},{"text":"시간이","x"