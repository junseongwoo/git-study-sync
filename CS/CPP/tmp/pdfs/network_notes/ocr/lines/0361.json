{"page":361,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"5.2 • 라우팅 알고리즘","words":[{"text":"5.2","x":1108,"y":139,"width":40,"height":24},{"text":"•","x":1182,"y":145,"width":11,"height":13},{"text":"라우팅","x":1229,"y":139,"width":75,"height":29},{"text":"알고리즘","x":1317,"y":138,"width":106,"height":30}]},{"text":"즘의 14번째 줄이 최솟값이 되게 하는 노드이다. 그러므로 알고리즘의 이 단계에서 노","words":[{"text":"즘의","x":157,"y":265,"width":60,"height":39},{"text":"14번째","x":239,"y":264,"width":102,"height":38},{"text":"줄이","x":358,"y":265,"width":65,"height":37},{"text":"최솟값이","x":442,"y":265,"width":129,"height":38},{"text":"되게","x":590,"y":265,"width":62,"height":38},{"text":"하는","x":668,"y":266,"width":64,"height":37},{"text":"노드이다.","x":745,"y":268,"width":133,"height":37},{"text":"그러므로","x":894,"y":268,"width":129,"height":36},{"text":"알고리즘의","x":1037,"y":266,"width":164,"height":37},{"text":"이","x":1220,"y":267,"width":27,"height":36},{"text":"단계에서","x":1266,"y":266,"width":131,"height":37},{"text":"노","x":1414,"y":269,"width":33,"height":27}]},{"text":"듸에는 v*(y) = y와 v*(z) = y가 기록된다.","words":[{"text":"듸에는","x":158,"y":325,"width":129,"height":37},{"text":"v*(y)","x":300,"y":327,"width":82,"height":40},{"text":"=","x":399,"y":341,"width":25,"height":12},{"text":"y와","x":439,"y":326,"width":54,"height":42},{"text":"v*(z)","x":505,"y":327,"width":76,"height":38},{"text":"=","x":598,"y":341,"width":23,"height":11},{"text":"y가","x":636,"y":326,"width":52,"height":41},{"text":"기록된다.","x":701,"y":326,"width":133,"height":39}]},{"text":"노드들이 거리 벡터를 재계산한 후에, 만약 변화가 있다면 갱신된 기리 벡터를 다","words":[{"text":"노드들이","x":221,"y":387,"width":136,"height":37},{"text":"거리","x":377,"y":388,"width":63,"height":38},{"text":"벡터를","x":460,"y":388,"width":99,"height":37},{"text":"재계산한","x":573,"y":387,"width":131,"height":37},{"text":"후에,","x":716,"y":387,"width":71,"height":37},{"text":"만약","x":803,"y":387,"width":63,"height":37},{"text":"변화가","x":882,"y":387,"width":96,"height":37},{"text":"있다면","x":992,"