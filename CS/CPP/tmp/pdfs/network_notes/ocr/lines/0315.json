{"page":315,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"4.3 • 인터넷 프로토콜(|P): lPvd, 주소 지정, lPv6S","words":[{"text":"4.3","x":733,"y":149,"width":40,"height":24},{"text":"•","x":806,"y":154,"width":11,"height":13},{"text":"인터넷","x":850,"y":149,"width":75,"height":30},{"text":"프로토콜(|P):","x":936,"y":148,"width":158,"height":30},{"text":"lPvd,","x":1110,"y":149,"width":70,"height":30},{"text":"주소","x":1194,"y":147,"width":51,"height":29},{"text":"지정,","x":1256,"y":147,"width":60,"height":32},{"text":"lPv6S","x":1332,"y":145,"width":98,"height":31}]},{"text":"223.1.1.0/24","words":[{"text":"223.1.1.0/24","x":616,"y":370,"width":168,"height":25}]},{"text":"223.1.2 0/24","words":[{"text":"223.1.2","x":830,"y":431,"width":98,"height":26},{"text":"0/24","x":939,"y":430,"width":57,"height":26}]},{"text":"223.1.3 0/24","words":[{"text":"223.1.3","x":724,"y":795,"width":101,"height":24},{"text":"0/24","x":836,"y":795,"width":60,"height":24}]},{"text":"309","words":[{"text":"309","x":1731,"y":136,"width":73,"height":34}]},{"text":"그림 4.19 • 서브넷 주소","words":[{"text":"그림","x":157,"y":1093,"width":51,"height":30},{"text":"4.19","x":221,"y":1095,"width":69,"height":28},{"text":"•","x":306,"y":1101,"width":15,"height":14},{"text":"서브넷","x":338,"y":1092,"width":83,"height":32},{"text":"주소","x":433,"y":1091,"width":57,"height":30}]},{"text":"하나의 라우터 인터페이스(223.1.1.4)를 구성한다. 네트워크 223.1.1.0/24에 새로 부착","words":[{"text":"하나의","x":160,"y":1227,"width":93,"height":38},{"text":"라우터","x":271,"y":1227,"width":96,"height":38},{"text":"인터페이스(223.1.1.4)를","x":387,"y":1222,"width":376,"height":41},{"text":"구성한다.","x":775,"y":1224,"width":141,"height":39},{"text":"네트워크","x":932,"y":1225,"width":132,"height":38},{"text":"223.1.1.0/24에","x":1076,"y":1226,"width":222,"height":38},{"text":"새로","x":1313,"y":1226,"width":67,"height":38},{"text":"부착","x":1392,"y":1227,"width":67,"height":37}]},{"text":"할 호스트에는 223.1.1.xxx 형식의 주소가 필요할 것이다. 그림 4.18에 2개의 다른 서","words":[{"text":"할","x":160,"y":1288,"width":31,"height":37},{"text":"호스트에는","x":203,"y":1289,"width":170,"height":37},{"text":"223.1.1.xxx","x":387,"y":1289,"width":185,"height":30},{"text":"형식의","x":589,"y":1284,"width":98,"height":38},{"text":"주소가","x":704,"y":1285,"width":103,"height":38},{"text":"필요할","x":821,"y":1286,"width":95,"height":37},{"text":"것이다.","x":931,"y":1286,"width":104,"height":38},{"text":"그림","x":1052,"y":1286,"width":62,"height":38},{"text":"4.18에","x":1130,"y":1287,"width":99,"height":38},{"text":"2개의","x":1245,"y":1288,"width":83,"height":37},{"text":"다른","x":1346,"y":1288,"width":67,"height":38},{"text":"서","x":1426,"y":1289,"width":28,"height":38}]},{"text":"보넷(223.1.2.0/24와 223.1.3.0/24 네트워크)이 있다. 그림 4.19는 그림 4.18에서 보인","words":[{"text":"보넷(223.1.2.0/24와","x":160,"y":1346,"width":308,"height":41},{"text":"223.1.3.0/24","x":480,"y":1350,"width":197,"height":30},{"text":"네트워크)이","x":692,"y":1347,"width":176,"height":39},{"text":"있다.","x":887,"y":1347,"width":71,"height":37},{"text":"그림","x":974,"y":1348,"width":62,"height":36},{"text":"4.19는","x":1052,"y":1349,"width":102,"height":35},{"text":"그림","x":1165,"y":1348,"width":63,"height":37},{"text":"4.18에서","x":1244,"y":1349,"width":131,"height":38},{"text":"보인","x":1392,"y":1350,"width":66,"height":37}]},{"text":"이 세 IP 서브넷을 보여 준다.","words":[{"text":"이","x":161,"y":1411,"width":25,"height":37},{"text":"세","x":202,"y":1410,"width":29,"height":37},{"text":"IP","x":247,"y":1415,"width":33,"height":29},{"text":"서브넷을","x":293,"y":1409,"width":138,"height":40},{"text":"보여","x":443,"y":1407,"width":64,"height":39},{"text":"준다.","x":523,"y":1407,"width":77,"height":39}]},{"text":"서브넷의 IP 정의는 여러 호스트를 라우터 인터페이스에 연결하는 이더넷 세그먼","words":[{"text":"서브넷의","x":223,"y":1472,"width":130,"height":39},{"text":"IP","x":371,"y":1477,"width":34,"height":28},{"text":"정의는","x":422,"y":1470,"width":102,"height":39},{"text":"여러","x":540,"y":1469,"width":62,"height":39},{"text":"호스트를","x":621,"y":1472,"width":137,"height":36},{"text":"라우터","x":773,"y":1470,"width":93,"height":39},{"text":"인터페이스에","x":887,"y":1470,"width":194,"height":39},{"text":"연결하는","x":1100,"y":1470,"width":132,"height":39},{"text":"이더넷","x":1247,"y":1471,"width":97,"height":39},{"text":"세그먼","x":1360,"y":1473,"width":98,"height":37}]},{"text":"트만을 의미하는 것은 아니다. 세 개의 라우터가 점대점 링크로 연결된 그림 4.20을 보","words":[{"text":"트만을","x":160,"y":1533,"width":96,"height":37},{"text":"의미하는","x":270,"y":1534,"width":136,"height":39},{"text":"것은","x":421,"y":1533,"width":67,"height":38},{"text":"아니다.","x":502,"y":1532,"width":108,"height":38},{"text":"세","x":626,"y":1532,"width":31,"height":39},{"text":"개의","x":674,"y":1533,"width":63,"height":38},{"text":"라우터가","x":755,"y":1532,"width":131,"height":39},{"text":"점대점","x":899,"y":1532,"width":95,"height":38},{"text":"링크로","x":1012,"y":1532,"width":98,"height":39},{"text":"연결된","x":1125,"y":1533,"width":96,"height":37},{"text":"그림","x":1235,"y":1533,"width":63,"height":37},{"text":"4.20을","x":1313,"y":1534,"width":101,"height":38},{"text":"보","x":1426,"y":1538,"width":34,"height":29}]},{"text":"자. 각 라우터는 각 점대점 링크를 위해 2개, 두 호스트를 직접 연결하는 브로드개스트","words":[{"text":"자.","x":160,"y":1595,"width":36,"height":37},{"text":"각","x":213,"y":1594,"width":33,"height":38},{"text":"라우터는","x":260,"y":1596,"width":136,"height":38},{"text":"각","x":409,"y":1595,"width":35,"height":38},{"text":"점대점","x":458,"y":1594,"width":98,"height":38},{"text":"링크를","x":575,"y":1594,"width":101,"height":38},{"text":"위해","x":690,"y":1595,"width":63,"height":38},{"text":"2개,","x":768,"y":1594,"width":60,"height":39},{"text":"두","x":842,"y":1596,"width":34,"height":36},{"text":"호스트를","x":888,"y":1596,"width":134,"height":36},{"text":"직접","x":1036,"y":1594,"width":61,"height":38},{"text":"연결하는","x":1116,"y":1594,"width":131,"height":39},{"text":"브로드개스트","x":1260,"y":1596,"width":200,"height":38}]},{"text":"링크를 위해 1개, 모두 3개의 인터페이스를 갖는다. 여기에서 어떤 IP 서브넷이 존재하","words":[{"text":"링크를","x":162,"y":1656,"width":95,"height":38},{"text":"위해","x":270,"y":1658,"width":64,"height":39},{"text":"1개,","x":353,"y":1658,"width":59,"height":38},{"text":"모두","x":427,"y":1658,"width":70,"height":37},{"text":"3개의","x":509,"y":1656,"width":84,"height":39},{"text":"인터페이스를","x":613,"y":1656,"width":198,"height":39},{"text":"갖는다.","x":825,"y":1656,"width":105,"height":38},{"text":"여기에서","x":946,"y":1656,"width":127,"height":38},{"text":"어떤","x":1091,"y":1656,"width":64,"height":38},{"text":"IP","x":1169,"y":1661,"width":33,"height":29},{"text":"서브넷이","x":1215,"y":1656,"width":128,"height":39},{"text":"존재하","x":1359,"y":1658,"width":101,"height":38}]},{"text":"는가? 세 개의 서브넷 223.1.1.0/24, 223.1.2.0/24, 223.1.3.0/24는 그림 4.18의 서브넷","words":[{"text":"는가?","x":160,"y":1719,"width":79,"height":37},{"text":"세","x":253,"y":1720,"width":31,"height":37},{"text":"개의","x":303,"y":1720,"width":63,"height":38},{"text":"서브넷","x":385,"y":1719,"width":102,"height":39},{"text":"223.1.1.0/24,","x":502,"y":1723,"width":202,"height":33},{"text":"223.1.2.0/24,","x":719,"y":1722,"width":198,"height":33},{"text":"223.1.3.0/24는","x":932,"y":1720,"width":224,"height":35},{"text":"그림","x":1168,"y":1719,"width":62,"height":36},{"text":"4.18의","x":1246,"y":1719,"width":97,"height":38},{"text":"서브넷","x":1360,"y":1719,"width":97,"height":39}]},{"text":"과 유사하지만 세 서브넷 라우터 RI, R2를 연결하는 인터페이스용으로 223.1.9.0/24","words":[{"text":"과","x":160,"y":1781,"width":32,"height":37},{"text":"유사하지만","x":206,"y":1781,"width":171,"height":39},{"text":"세","x":393,"y":1782,"width":31,"height":38},{"text":"서브넷","x":445,"y":1781,"width":101,"height":38},{"text":"라우터","x":565,"y":1781,"width":96,"height":37},{"text":"RI,","x":681,"y":1785,"width":52,"height":33},{"text":"R2를","x":750,"y":1782,"width":78,"height":35},{"text":"연결하는","x":845,"y":1780,"width":131,"height":38},{"text":"인터페이스용으로","x":993,"y":1780,"width":263,"height":39},{"text":"223.1.9.0/24","x":1271,"y":1785,"width":188,"height":30}]},{"text":"서브넷, 그리고 R2와 R3을 연결하는 인터페이스용 223.1.8.0/24 서브넷, 그리고 RI과","words":[{"text":"서브넷,","x":162,"y":1842,"width":103,"height":40},{"text":"그리고","x":281,"y":1845,"width":103,"height":37},{"text":"R2와","x":398,"y":1843,"width":83,"height":39},{"text":"R3을","x":493,"y":1843,"width":80,"height":37},{"text":"연결하는","x":589,"y":1842,"width":134,"height":37},{"text":"인터페이스용","x":737,"y":1842,"width":198,"height":38},{"text":"223.1.8.0/24","x":947,"y":1846,"width":188,"height":30},{"text":"서브넷,","x":1150,"y":1842,"width":105,"height":38},{"text":"그리고","x":1269,"y":1843,"width":100,"height":37},{"text":"RI과","x":1381,"y":1843,"width":78,"height":37}]},{"text":"R3를 연결하는 인터페이스용 223.1.7.0/24 서브넷이 추가되었다. 일반적인 라우터와","words":[{"text":"R3를","x":161,"y":1906,"width":75,"height":36},{"text":"연결하는","x":254,"y":1907,"width":137,"height":37},{"text":"인터페이스용","x":410,"y":1905,"width":207,"height":39},{"text":"223.1.7.0/24","x":632,"y":1909,"width":192,"height":29},{"text":"서브넷이","x":842,"y":1905,"width":128,"height":38},{"text":"추가되었다.","x":989,"y":1904,"width":172,"height":39},{"text":"일반적인","x":1181,"y":1904,"width":128,"height":38},{"text":"라우터와","x":1328,"y":1905,"width":131,"height":38}]},{"text":"호스트를 연결한 시스템에서 서브넷을 정의하기 위해 다음과 같은 방법을 사용할 수","words":[{"text":"호스트를","x":161,"y":1967,"width":132,"height":39},{"text":"연결한","x":312,"y":1968,"width":103,"height":38},{"text":"시스템에서","x":432,"y":1967,"width":169,"height":40},{"text":"서브넷을","x":623,"y":1967,"width":134,"height":39},{"text":"정의하기","x":775,"y":1967,"width":126,"height":39},{"text":"위해","x":922,"y":1967,"width":63,"height":39},{"text":"다음과","x":1002,"y":1967,"width":100,"height":39},{"text":"같은","x":1117,"y":1967,"width":65,"height":37},{"text":"방법을","x":1197,"y":1967,"width":100,"height":38},{"text":"사용할","x":1311,"y":1967,"width":100,"height":38},{"text":"수","x":1425,"y":1967,"width":34,"height":38}]},{"text":"있다.","words":[{"text":"있다.","x":164,"y":2028,"width":67,"height":39}]},{"text":"서브넷을 결정하려면 먼저 호스트나 라우터에서 각 인터페이스를 분리하고 고립된 네트","words":[{"text":"서브넷을","x":223,"y":2115,"width":130,"height":36},{"text":"결정하려면","x":367,"y":2117,"width":161,"height":35},{"text":"먼저","x":544,"y":2117,"width":63,"height":35},{"text":"호스트나","x":620,"y":2117,"width":127,"height":35},{"text":"라우터에서","x":759,"y":2117,"width":152,"height":35},{"text":"각","x":925,"y":2117,"width":31,"height":35},{"text":"인터페이스를","x":967,"y":2116,"width":182,"height":36},{"text":"분리하고","x":1160,"y":2116,"width":124,"height":36},{"text":"고립된","x":1294,"y":2116,"width":92,"height":35},{"text":"네트","x":1400,"y":2116,"width":60,"height":35}]},{"text":"워크를 만든다. 이 고립된 네트워크의 종단점은 인터페이스의 끝이 된다. 이렇게 고립된","words":[{"text":"워크를","x":224,"y":2174,"width":96,"height":35},{"text":"만든다.","x":334,"y":2175,"width":105,"height":34},{"text":"이","x":456,"y":2175,"width":29,"height":35},{"text":"고립된","x":499,"y":2175,"width":99,"height":35},{"text":"네트워크의","x":613,"y":2175,"width":154,"height":35},{"text":"종단점은","x":780,"y":2175,"width":124,"height":36},{"text":"인터페이스의","x":916,"y":2175,"width":181,"height":35},{"text":"끝이","x":1109,"y":2175,"width":60,"height":34},{"text":"된다.","x":1183,"y":2175,"width":67,"height":35},{"text":"이렇게","x":1266,"y":2175,"width":89,"height":35},{"text":"고립된","x":1367,"y":2174,"width":92,"height":35}]},{"text":"네트워크 각각을 서브넷이라고 부른다.","words":[{"text":"네트워크","x":225,"y":2231,"width":128,"height":35},{"text":"각각을","x":365,"y":2232,"width":99,"height":35},{"text":"서브넷이라고","x":476,"y":2232,"width":196,"height":35},{"text":"부른다.","x":683,"y":2233,"width":101,"height":34}]},{"text":"이 과정을 그림 4.20의 연결된 시스템에 적용하면 6개의 고립된 서브넷을 얻는다.","words":[{"text":"이","x":163,"y":2309,"width":25,"height":37},{"text":"과정을","x":203,"y":2310,"width":104,"height":38},{"text":"그림","x":319,"y":2311,"width":66,"height":36},{"text":"4.20의","x":401,"y":2311,"width":105,"height":38},{"text":"연결된","x":526,"y":2311,"width":101,"height":37},{"text":"시스템에","x":641,"y":2311,"width":132,"height":39},{"text":"적용하면","x":790,"y":2312,"width":128,"height":38},{"text":"6개의","x":931,"y":2312,"width":80,"height":38},{"text":"고립된","x":1026,"y":2312,"width":96,"height":37},{"text":"서브넷을","x":1137,"y":2312,"width":131,"height":38},{"text":"얻는다.","x":1282,"y":2312,"width":103,"height":39}]},{"text":"살펴본 바에 의하면, 다수의 이더넷 세그먼트와 종단간의 링크를 가지는 기관은","words":[{"text":"살펴본","x":224,"y":2371,"width":104,"height":38},{"text":"바에","x":345,"y":2372,"width":67,"height":37},{"text":"의하면,","x":434,"y":2372,"width":115,"height":37},{"text":"다수의","x":569,"y":2372,"width":100,"height":38},{"text":"이더넷","x":690,"y":2372,"width":99,"height":38},{"text":"세그먼트와","x":806,"y":2373,"width":165,"height":37},{"text":"종단간의","x":985,"y":2373,"width":127,"height":38},{"text":"링크를","x":1134,"y":2374,"width":97,"height":37},{"text":"가지는","x":1248,"y":2374,"width":98,"height":38},{"text":"기관은","x":1363,"y":2374,"width":99,"height":38}]},{"text":"(회사나 학교) 한 서브넷에서 모든 장비가 같은 서브넷 주소를 갖는 그런 서브넷을 여","words":[{"text":"(회사나","x":162,"y":2432,"width":110,"height":38},{"text":"학교)","x":286,"y":2433,"width":82,"height":39},{"text":"한","x":385,"y":2433,"width":37,"height":36},{"text":"서브넷에서","x":436,"y":2432,"width":174,"height":38},{"text":"모든","x":628,"y":2434,"width":70,"height":35},{"text":"장비가","x":711,"y":2433,"width":101,"height":38},{"text":"같은","x":825,"y":2433,"width":65,"height":36},{"text":"서브넷","x":903,"y":2433,"width":95,"height":37},{"text":"주소를","x":1012,"y":2435,"width":98,"height":36},{"text":"갖는","x":1124,"y":2434,"width":66,"height":37},{"text":"그런","x":1203,"y":2435,"width":64,"height":36},{"text":"서브넷을","x":1282,"y":2435,"width":133,"height":38},{"text":"여","x":1429,"y":2434,"width":28,"height":37}]},{"text":"러 개 가질 수 있음이 분명하다. 원칙대로라면 서로 다른 서브넷은 다른 서브넷 주소를","words":[{"text":"러","x":164,"y":2492,"width":24,"height":38},{"text":"개","x":206,"y":2493,"width":28,"height":37},{"text":"가질","x":250,"y":2493,"width":66,"height":38},{"text":"수","x":331,"y":2494,"width":36,"height":37},{"text":"있음이","x":383,"y":2493,"width":101,"height":38},{"text":"분명하다.","x":501,"y":2492,"width":149,"height":38},{"text":"원칙대로라면","x":666,"y":2493,"width":198,"height":38},{"text":"서로","x":878,"y":2493,"width":63,"height":37},{"text":"다른","x":954,"y":2494,"width":64,"height":37},{"text":"서브넷은","x":1030,"y":2494,"width":130,"height":38},{"text":"다른","x":1173,"y":2495,"width":65,"height":37},{"text":"서브넷","x":1250,"y":2496,"width":97,"height":37},{"text":"주소를","x":1361,"y":2497,"width":100,"height":36}]},{"text":"가져야 하지만, 실제로 서브넷 주소는 종종 같은 부분이 많다. 그 이유를 이해하기 위","words":[{"text":"가져야","x":163,"y":2553,"width":96,"height":39},{"text":"하지만,","x":274,"y":2554,"width":114,"height":38},{"text":"실제로","x":407,"y":2554,"width":106,"height":37},{"text":"서브넷","x":529,"y":2553,"width":103,"height":38},{"text":"주소는","x":648,"y":2555,"width":103,"height":36},{"text":"종종","x":764,"y":2555,"width":67,"height":37},{"text":"같은","x":845,"y":2553,"width":64,"height":38},{"text":"부분이","x":922,"y":2554,"width":94,"height":38},{"text":"많다.","x":1034,"y":2554,"width":71,"height":38},{"text":"그","x":1120,"y":2560,"width":34,"height":25},{"text":"이유를","x":1169,"y":2555,"width":98,"height":37},{"text":"이해하기","x":1282,"y":2556,"width":127,"height":37},{"text":"위","x":1429,"y":2555,"width":28,"height":38}]},{"text":"해 글로벌 인터넷에서 어떻게 주소체계가 처리되는지 알아보자.","words":[{"text":"해","x":162,"y":2615,"width":28,"height":38},{"text":"글로벌","x":204,"y":2615,"width":100,"height":37},{"text":"인터넷에서","x":321,"y":2615,"width":172,"height":38},{"text":"어떻게","x":512,"y":2614,"width":102,"height":38},{"text":"주소체계가","x":629,"y":2614,"width":170,"height":37},{"text":"처리되는지","x":812,"y":2614,"width":156,"height":37},{"text":"알아보자.","x":984,"y":2614,"width":136,"height":38}]}]}