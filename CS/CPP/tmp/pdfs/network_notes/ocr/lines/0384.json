,"height":32},{"text":"네트워크","x":957,"y":816,"width":111,"height":32},{"text":"중심","x":1077,"y":816,"width":54,"height":33},{"text":"부분의","x":1143,"y":816,"width":84,"height":32},{"text":"라우터까지","x":1240,"y":817,"width":140,"height":33},{"text":"모든","x":1391,"y":819,"width":60,"height":30},{"text":"장치들을","x":1463,"y":818,"width":118,"height":32},{"text":"제어한다;","x":1591,"y":818,"width":131,"height":32},{"text":"(li)","x":1739,"y":818,"width":35,"height":33},{"text":"대역","x":1787,"y":820,"width":49,"height":32}]},{"text":"폭을 많이 사용하는 대부분의 응용들은 사이트 간에 대량의 데이터를 복사하는데 이는 자원의 혼","words":[{"text":"폭을","x":580,"y":868,"width":57,"height":32},{"text":"많이","x":650,"y":868,"width":55,"height":33},{"text":"사용하는","x":717,"y":869,"width":115,"height":33},{"text":"대부분의","x":844,"y":868,"width":110,"height":32},{"text":"응용들은","x":966,"y":868,"width":113,"height":33},{"text":"사이트","x":1089,"y":869,"width":85,"height":32},{"text":"간에","x":1186,"y":869,"width":55,"height":32},{"text":"대량의","x":1256,"y":870,"width":83,"height":32},{"text":"데이터를","x":1354,"y":870,"width":114,"height":32},{"text":"복사하는데","x":1480,"y":871,"width":149,"height":33},{"text":"이는","x":1645,"y":871,"width":59,"height":32},{"text":"자원의","x":1716,"y":871,"width":84,"height":33},{"text":"혼","x":1812,"y":872,"width":26,"height":32}]},{"text":"잡 상황에서 높은 우선순위의 대화형 응용에 지연을 일으킨다; (iii) 수십 개의 데이터 센터만 연결","words":[{"text":"잡","x":581,"y":921,"width":30,"height":32},{"text":"상황에서","x":620,"y":921,"width":112,"height":32},{"text":"높은","x":743,"y":921,"width":57,"height":31},{"text":"우선순위의","x":810,"y":920,"width":140,"height":32},{"text":"대화형","x":964,"y":921,"width":80,"height":33},{"text":"응용에","x":1056,"y":921,"width":82,"height":33},{"text":"지연을","x":1151,"y":921,"width":84,"height":33},{"text":"일으킨다;","x":1246,"y":921,"width":125,"height":33},{"text":"(iii)","x":1387,"y":922,"width":45,"height":33},{"text":"수십","x":1443,"y":923,"width":58,"height":32},{"text":"개의","x":1515,"y":923,"width":58,"height":33},{"text":"데이터"