{"page":230,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"3.5 • 연결지향형 트랜스포트• TCP","words":[{"text":"3.5","x":984,"y":153,"width":42,"height":25},{"text":"•","x":1060,"y":157,"width":13,"height":14},{"text":"연결지향형","x":1106,"y":151,"width":133,"height":30},{"text":"트랜스포트•","x":1251,"y":151,"width":144,"height":29},{"text":"TCP","x":1411,"y":153,"width":63,"height":27}]},{"text":"실전원리","words":[{"text":"실전원리","x":1085,"y":296,"width":173,"height":50}]},{"text":"TCP는 3.4절에서 공부한 것과 같은 방법으로 금정 확인응답과 타이머를 사용함으로써 신뢰적인","words":[{"text":"TCP는","x":210,"y":401,"width":97,"height":32},{"text":"3.4절에서","x":319,"y":401,"width":137,"height":33},{"text":"공부한","x":468,"y":402,"width":86,"height":32},{"text":"것과","x":565,"y":402,"width":55,"height":33},{"text":"같은","x":632,"y":403,"width":55,"height":32},{"text":"방법으로","x":699,"y":404,"width":111,"height":33},{"text":"금정","x":821,"y":406,"width":55,"height":33},{"text":"확인응답과","x":888,"y":406,"width":142,"height":33},{"text":"타이머를","x":1042,"y":406,"width":113,"height":32},{"text":"사용함으로써","x":1166,"y":406,"width":171,"height":33},{"text":"신뢰적인","x":1349,"y":406,"width":113,"height":33}]},{"text":"데이터 전송을 제공한다. TCP는 정확하게 수신한 데이터에 대한 확인응답을 하며, 세그먼트 또","words":[{"text":"데이터","x":212,"y":454,"width":83,"height":31},{"text":"전송을","x":310,"y":453,"width":85,"height":33},{"text":"제공한다.","x":408,"y":453,"width":123,"height":33},{"text":"TCP는","x":548,"y":455,"width":94,"height":31},{"text":"정확하게","x":654,"y":455,"width":110,"height":33},{"text":"수신한","x":777,"y":457,"width":85,"height":32},{"text":"데이터에","x":875,"y":457,"width":110,"height":32},{"text":"대한","x":1000,"y":457,"width":58,"height":32},{"text":"확인응답을","x":1069,"y":457,"width":143,"height":33},{"text":"하며,","x":1224,"y":457,"width":68,"height":36},{"text":"세그먼트","x":1308,"y":457,"width":114,"height":32},{"text":"또","x":1434,"y":461,"width":29,"height":26}]},{"text":"는 이에 해당하는 긍정 확인응답이 손실되었거나 손상되었다고 생각될 때, 세그먼트를 재전송한","words":[{"text":"는","x":211,"y":507,"width":29,"height":31},{"text":"이에","x":254,"y":506,"width":55,"height":31},{"text":"해당하는","x":324,"y":506,"width":115,"height":32},{"text":"긍정","x":451,"y":506,"width":56,"height":32},{"text":"확인응답이","x":521,"y":506,"width":138,"height":33},{"text":"손실되었거나","x":672,"y":507,"width":169,"height":33},{"text":"손상되었다고","x":853,"y":509,"width":172,"height":32},{"text":"생각될","x":1038,"y":509,"width":85,"height":33},{"text":"때,","x":1139,"y":509,"width":38,"height":36},{"text":"세그먼트를","x":1194,"y":509,"width":143,"height":32},{"text":"재전송한","x":1350,"y":509,"width":114,"height":33}]},{"text":"다. 또한 TCP의 특정 버전은 TCP의 빠른 재전송 메커니즘과 함께 NAK 메커니즘을 갖고 있다.","words":[{"text":"다.","x":212,"y":559,"width":38,"height":31},{"text":"또한","x":265,"y":558,"width":59,"height":31},{"text":"TCP의","x":334,"y":558,"width":95,"height":32},{"text":"특정","x":440,"y":558,"width":56,"height":32},{"text":"버전은","x":509,"y":558,"width":83,"height":31},{"text":"TCP의","x":602,"y":559,"width":92,"height":32},{"text":"빠른","x":707,"y":560,"width":55,"height":31},{"text":"재전송","x":773,"y":560,"width":84,"height":32},{"text":"메커니즘과","x":868,"y":560,"width":143,"height":32},{"text":"함께","x":1021,"y":560,"width":57,"height":33},{"text":"NAK","x":1091,"y":563,"width":69,"height":27},{"text":"메커니즘을","x":1173,"y":561,"width":141,"height":32},{"text":"갖고","x":1325,"y":561,"width":57,"height":31},{"text":"있다.","x":1392,"y":560,"width":66,"height":33}]},{"text":"주어진 세그먼트에 대한 세 번의 중복된 ACK를 수신하는 것은 그 다음 세그먼트에 대한 욱시적인","words":[{"text":"주어진","x":211,"y":610,"width":85,"height":32},{"text":"세그먼트에","x":307,"y":610,"width":142,"height":31},{"text":"대한","x":462,"y":609,"width":56,"height":31},{"text":"세","x":527,"y":610,"width":27,"height":31},{"text":"번의","x":566,"y":609,"width":53,"height":32},{"text":"중복된","x":630,"y":610,"width":83,"height":32},{"text":"ACK를","x":724,"y":611,"width":99,"height":31},{"text":"수신하는","x":831,"y":611,"width":115,"height":31},{"text":"것은","x":957,"y":611,"width":57,"height":32},{"text":"그","x":1022,"y":615,"width":31,"height":24},{"text":"다음","x":1064,"y":612,"width":57,"height":32},{"text":"세그먼트에","x":1131,"y":612,"width":141,"height":32},{"text":"대한","x":1285,"y":612,"width":57,"height":32},{"text":"욱시적인","x":1350,"y":612,"width":112,"height":32}]},{"text":"NAK로 인식하고, 타임아웃되기 전에 해당 세그먼트의 재전송을 시도한다. TCP는 수신자가 손","words":[{"text":"NAK로","x":213,"y":664,"width":99,"height":27},{"text":"인식하고,","x":325,"y":662,"width":123,"height":35},{"text":"타임아웃되기","x":466,"y":661,"width":165,"height":32},{"text":"전에","x":645,"y":662,"width":54,"height":32},{"text":"해당","x":713,"y":662,"width":56,"height":33},{"text":"세그먼트의","x":780,"y":662,"width":140,"height":32},{"text":"재전송을","x":933,"y":663,"width":116,"height":33},{"text":"시도한다.","x":1061,"y":664,"width":126,"height":32},{"text":"TCP는","x":1203,"y":664,"width":95,"height":32},{"text":"수신자가","x":1309,"y":664,"width":115,"height":32},{"text":"손","x":1434,"y":665,"width":30,"height":30}]},{"text":"실되거나 중복된 세그먼트를 식별할 수 있도록 하기 위해서 순서번호를 사용한다. 여기서의 신뢰","words":[{"text":"실되거나","x":211,"y":713,"width":115,"height":32},{"text":"중복된","x":338,"y":713,"width":85,"height":33},{"text":"세그먼트를","x":435,"y":713,"width":141,"height":32},{"text":"식별할","x":589,"y":713,"width":84,"height":32},{"text":"수","x":683,"y":714,"width":28,"height":31},{"text":"있도록","x":724,"y":714,"width":84,"height":31},{"text":"하기","x":819,"y":714,"width":55,"height":32},{"text":"위해서","x":888,"y":714,"width":83,"height":32},{"text":"순서번호를","x":984,"y":715,"width":145,"height":32},{"text":"사용한다.","x":1141,"y":715,"width":125,"height":33},{"text":"여기서의","x":1283,"y":715,"width":111,"height":32},{"text":"신뢰","x":1408,"y":715,"width":54,"height":32}]},{"text":"적인 데이터 전송 프로토콜(rdt3.0) 의 경우, TCP는 어떤 세그먼트 또는 그에 해당하는 확인웅","words":[{"text":"적인","x":212,"y":765,"width":55,"height":32},{"text":"데이터","x":280,"y":765,"width":83,"height":32},{"text":"전송","x":376,"y":766,"width":56,"height":32},{"text":"프로토콜(rdt3.0)","x":442,"y":765,"width":252,"height":32},{"text":"의","x":704,"y":765,"width":26,"height":33},{"text":"경우,","x":742,"y":766,"width":66,"height":36},{"text":"TCP는","x":822,"y":766,"width":96,"height":32},{"text":"어떤","x":928,"y":766,"width":56,"height":32},{"text":"세그먼트","x":995,"y":767,"width":117,"height":32},{"text":"또는","x":1121,"y":768,"width":58,"height":31},{"text":"그에","x":1188,"y":767,"width":57,"height":32},{"text":"해당하는","x":1257,"y":767,"width":113,"height":33},{"text":"확인웅","x":1380,"y":767,"width":84,"height":33}]},{"text":"답이 손실되거나, 손상되거나 또는 지연되는지를 확실하게 구별해 낼 수 없다. 송신 측에서의","words":[{"text":"답이","x":212,"y":817,"width":55,"height":32},{"text":"손실되거나,","x":283,"y":817,"width":156,"height":36},{"text":"손상되거나","x":458,"y":817,"width":143,"height":32},{"text":"또는","x":615,"y":817,"width":57,"height":31},{"text":"지연되는지를","x":686,"y":817,"width":170,"height":33},{"text":"확실하게","x":871,"y":818,"width":114,"height":32},{"text":"구별해","x":1000,"y":819,"width":88,"height":32},{"text":"낼","x":1105,"y":820,"width":26,"height":31},{"text":"수","x":1147,"y":819,"width":30,"height":32},{"text":"없다.","x":1192,"y":818,"width":68,"height":33},{"text":"송신","x":1278,"y":817,"width":57,"height":34},{"text":"측에서의","x":1350,"y":818,"width":113,"height":33}]},{"text":"TCP 응답은 같을 것이다(즉, 문제의 세그먼트를 재전송하는 것이다).","words":[{"text":"TCP","x":211,"y":870,"width":67,"height":29},{"text":"응답은","x":287,"y":869,"width":88,"height":32},{"text":"같을","x":386,"y":869,"width":56,"height":31},{"text":"것이다(즉,","x":453,"y":868,"width":132,"height":36},{"text":"문제의","x":599,"y":869,"width":83,"height":31},{"text":"세그먼트를","x":693,"y":869,"width":141,"height":32},{"text":"재전송하는","x":844,"y":870,"width":144,"height":32},{"text":"것이다).","x":997,"y":869,"width":107,"height":34}]},{"text":"또한, TCP는 파이프라이닝을 사용한다. 즉, 어떤 시간에 송신자는 전송했지만 아직 확인용답","words":[{"text":"또한,","x":255,"y":921,"width":68,"height":35},{"text":"TCP는","x":339,"y":921,"width":97,"height":31},{"text":"파이프라이닝을","x":445,"y":920,"width":197,"height":33},{"text":"사용한다.","x":652,"y":920,"width":122,"height":33},{"text":"즉,","x":788,"y":922,"width":40,"height":35},{"text":"어떤","x":843,"y":921,"width":55,"height":32},{"text":"시간에","x":909,"y":922,"width":85,"height":32},{"text":"송신자는","x":1005,"y":922,"width":117,"height":32},{"text":"전송했지만","x":1132,"y":922,"width":143,"height":33},{"text":"아직","x":1285,"y":922,"width":56,"height":33},{"text":"확인용답","x":1352,"y":922,"width":113,"height":33}]},{"text":"하지 않은 다수의 세그먼트를 갖도록 해 준다. 파이프라인은 왕복 지연 시간에 대한 세그먼트 길이","words":[{"text":"하지","x":211,"y":972,"width":55,"height":32},{"text":"않은","x":279,"y":972,"width":57,"height":32},{"text":"다수의","x":347,"y":972,"width":84,"height":32},{"text":"세그먼트를","x":442,"y":972,"width":141,"height":32},{"text":"갖도록","x":594,"y":972,"width":83,"height":32},{"text":"해","x":687,"y":973,"width":26,"height":31},{"text":"준다.","x":724,"y":973,"width":67,"height":31},{"text":"파이프라인은","x":805,"y":973,"width":172,"height":32},{"text":"왕복","x":985,"y":974,"width":59,"height":32},{"text":"지연","x":1054,"y":974,"width":57,"height":31},{"text":"시간에","x":1122,"y":973,"width":85,"height":33},{"text":"대한","x":1220,"y":974,"width":57,"height":32},{"text":"세그먼트","x":1285,"y":975,"width":115,"height":31},{"text":"길이","x":1410,"y":974,"width":53,"height":32}]},{"text":"의 비가 작을 때, 그 세션의 처리율이 크게 향상할수 있음을 이미 배웠다. 송신자가 가질 수 있는","words":[{"text":"의","x":212,"y":1024,"width":26,"height":32},{"text":"비가","x":252,"y":1024,"width":56,"height":32},{"text":"작을","x":319,"y":1024,"width":57,"height":32},{"text":"때,","x":388,"y":1024,"width":38,"height":36},{"text":"그","x":440,"y":1028,"width":30,"height":23},{"text":"세션의","x":480,"y":1024,"width":85,"height":32},{"text":"처리율이","x":577,"y":1024,"width":110,"height":32},{"text":"크게","x":698,"y":1024,"width":55,"height":32},{"text":"향상할수","x":765,"y":1024,"width":124,"height":33},{"text":"있음을","x":900,"y":1025,"width":86,"height":32},{"text":"이미","x":998,"y":1025,"width":53,"height":32},{"text":"배웠다.","x":1066,"y":1025,"width":96,"height":32},{"text":"송신자가","x":1176,"y":1026,"width":117