},{"text":"주소의","x":254,"y":2343,"width":100,"height":39},{"text":"일부)를","x":374,"y":2344,"width":113,"height":39},{"text":"라우터의","x":502,"y":2344,"width":131,"height":39},{"text":"출력","x":650,"y":2343,"width":64,"height":38},{"text":"링크로","x":735,"y":2343,"width":100,"height":38},{"text":"맵핑하는","x":849,"y":2343,"width":135,"height":38},{"text":"전달","x":998,"y":2343,"width":68,"height":38},{"text":"테이*(forwarding","x":1079,"y":2344,"width":301,"height":40},{"text":"table)","x":1391,"y":2347,"width":92,"height":34}]},{"text":"을 갖고 있다. 패킷이 라우터에 도착하면, 라우터는 올바른 출력 링크를 찾기 위해 주","words":[{"text":"을","x":173,"y":2406,"width":34,"height":36},{"text":"갖고","x":222,"y":2406,"width":68,"height":37},{"text":"있다.","x":307,"y":2405,"width":73,"height":39},{"text":"패킷이","x":398,"y":2406,"width":97,"height":38},{"text":"라우터에","x":515,"y":2406,"width":131,"height":39},{"text":"도착하면,","x":665,"y":2405,"width":143,"height":38},{"text":"라우터는","x":825,"y":2405,"width":135,"height":38},{"text":"올바른","x":973,"y":2405,"width":103,"height":37},{"text":"출력","x":1089,"y":2404,"width":64,"height":38},{"text":"링크를","x":1175,"y":2405,"width":99,"height":37},{"text":"찾기","x":1288,"y":2404,"width":62,"height":37},{"text":"위해","x":1371,"y":2404,"width":63,"height":37},{"text":"주","x":1450,"y":2406,"width":35,"height":35}]},{"text":"소를 조사하고 이 목적지 주소를 이용하여 전달 테이블을 검색한다. 그런 후에 라우터","words":[{"text":"소를","x":174,"y":2469,"width":67,"height":36},{"text":"조사하고","x":255,"y":2467,"width":137,"height":41},{"text":"이","x":407,"y":2467,"width":28,"height":39},{"text":"목적지","x":453,"y":2467,"width":98,"height":39},{"text":"주소를","x":568,"y":2468,"width":104,"height":37},{"text":"이용하여","x":686,"y":2466,"width":130,"height":38},{"text":"전달","x":835,"y":2466,"width":67,"height":37},{"text":"테이블을","x":915,"y":2465,"width":135,"height":38},{"text":"검색한다.","x":1065,"y":2465,"width":142,"height":39},{"text":"그런","x":1222,"y":2465,"width":66,"height":36},{"text":"후에","x":1303,"y":2465,"width":65,"height":37},{"text":"라우터","x":1386,"y":2465,"width":94,"height":38}]},{"text":"는 그 패킷을 출력 링크로 보낸다.","words":[{"text":"는","x":173,"y":2532,"width":35,"height":35},{"text":"그","x":220,"y":2535,"width":34,"height":26},{"text":"패킷을","x":268,"y":2529,"width":101,"height":39},{"text":"출력","x":381,"y":2529,"width":64,"height":38},{"text":"링크로","x":464,"y":2529,"width":100,"height":38},{"text":"보낸다.","x":576,"y":2528,"width":109,"height":38}]},{"text":"종단간의 라우팅 과정은 지도를 이용하는 대신에 방향을 물어보는 것을 좋아하는","words":[{"text":"종단간의","x":240,"y":2591,"width":135,"height":39},{"text":"라우팅","x":394,"y":2591,"width":96,"height":38},{"text":"과정은","x":508,"y":2590,"width":103,"height":38},{"text":"지도를","x":626,"y":2589,"width":100,"height":38},{"text":"이용하는","x":741,"y":2587,"width":135,"height":39},{"text":"대신에","x":890,"y":2586,"width":96,"height":39},{"text":"방향을","x":1004,"y":2586,"width":102,"height":37},{"text":"물어보는","x":1119,"y":2585,"width":137,"height":37},{"text":"것을","x":1271,"y":2585,"width":67,"height":36},{"text":"좋아하는","x":1351,"y":2585,"width":135,"height":37}]}]}