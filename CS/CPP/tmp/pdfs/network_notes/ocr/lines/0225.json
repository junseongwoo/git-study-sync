ext":"데이터","x":1160,"y":641,"width":81,"height":31}]},{"text":"TCP는 데이터를 구조화되어 있지 않고, 단지 순서대로 정릴된 바이트 스트립으로","words":[{"text":"TCP는","x":634,"y":808,"width":104,"height":35},{"text":"데이터를","x":751,"y":805,"width":132,"height":38},{"text":"구조화되어","x":895,"y":805,"width":163,"height":38},{"text":"있지","x":1077,"y":806,"width":61,"height":36},{"text":"않고,","x":1156,"y":806,"width":74,"height":37},{"text":"단지","x":1245,"y":805,"width":64,"height":38},{"text":"순서대로","x":1325,"y":806,"width":138,"height":38},{"text":"정릴된","x":1478,"y":808,"width":101,"height":36},{"text":"바이트","x":1596,"y":808,"width":105,"height":38},{"text":"스트립으로","x":1715,"y":808,"width":159,"height":39}]},{"text":"본다. TCP의 순서번호 시용은 이러한 관점을 반영하여, 순서번호는 일련의 전송된 세","words":[{"text":"본다.","x":569,"y":867,"width":73,"height":37},{"text":"TCP의","x":657,"y":866,"width":101,"height":38},{"text":"순서번호","x":774,"y":866,"width":133,"height":37},{"text":"시용은","x":921,"y":865,"width":100,"height":38},{"text":"이러한","x":1036,"y":865,"width":101,"height":38},{"text":"관점을","x":1149,"y":866,"width":102,"height":37},{"text":"반영하여,","x":1265,"y":866,"width":144,"height":38},{"text":"순서번호는","x":1425,"y":867,"width":176,"height":38},{"text":"일련의","x":1618,"y":869,"width":99,"height":36},{"text":"전송된","x":1738,"y":868,"width":95,"height":38},{"text":"세","x":1847,"y":876,"width":25,"height":36}]},{"text":"그먼트에 대해서가 아니라, 전송된 바이트의 스트림에 대한 것이다. 세그먼트에 대한","words":[{"text":"그먼트에","x":568,"y":927,"width":130,"height":38},{"text":"대해서가","x":718,"y":927,"width":133,"height":38},{"text":"아니라,","x":866,"y":928,"width":100,"height":36},{"text":"전송된","x":986,"y":926,"width":98,"height":38},{"text":"바이트의","x":1102,"y":927,"width":131,"height":38},{"text":"스트림에","x":1253,"y":928,"width":134,"height":38},{"text":"대한","x":1408,"y":928,"width":69,"height":37},{"text":"것이다.","x":1495,"y":929,"width":110,"height":38},{"text":"세그먼트에","x":1625,"y":928,"width":172,"height":39},{"text":"대한","x":1816,"y":931,"width":59,"height":41}]},{"text":"순서번호는 세그먼트에 있는 첫 번째 바이트의 바이트-스트림 번호이다. 이제 예제를","words":[{"text":"순서번호는","x":567,"y":989,"width":168,"height":37},{"text":"세그먼트에","x":748,"y":988,"width":163,"height":37},{"text":"있는","x":930,"y":987,"width":64,"height":39},{"text":"첫","x":1009,"y":987,"width":30,"height":38},{"text":"번째","x":1056,"y":987,"width":62,"height":38},{"text":"바이트의","x":1135,"y":988,"width":132,"height":38},{"text":"바이트-스트림","x":1285,"y":989,"width":229,"height":37},{"text":"번호이다.","x":1534,"y":990,"width":148,"height":38},{"text":"이제","x":1701,"y":990,"width":65,"height":37},{"text":"예제를","x":1784,"y":991,"width":90,"height":43}]},{"text":"살펴보자. 호스트 A에서의 프로세스는 TCP 연결 상에서 호스트 B의 프로세스로 데이","words":[{"text":"살펴보자.","x":567,"y":1050,"width":140,"height":37},{"text":"호스트","x":722,"y":1051,"width":100,"height":31},{"text":"A에서의","x":834,"y":1049,"width":124,"height":39},{"text":"프로세스는","x":974,"y":1049,"width":169,"height":38},{"text":"TCP","x":1154,"y":1053,"width":71,"height":29},{"text":"연결","x":1241,"y":1050,"width":63,"height":37},{"text":"상에서","x":1319,"y":1050,"width":98,"height":38},{"text":"호스트","x":1434,"y":1052,"width":104,"height":31},{"text":"B의","x":1552,"y":1052,"width":59,"height":37},{"text":"프로세스로","x":1628,"y":1051,"width":175,"height":38},{"text":"데이","x":1817,"y":1054,"width":54,"height":41}]},{"text":"터 스트림의 전송을 원한다고 가정하고, 데이터 스트림은 500,(脚바이트로 구성된 파","words":[{"text":"터","x":568,"y":1111,"width":27,"height":37},{"text":"스트림의","x":613,"y":1111,"width":131,"height":38},{"text":"전송을","x":762,"y":1111,"width":98,"height":38},{"text":"원한다고","x":875,"y":1110,"width":131,"height":38},{"text":"가정하고,","x":1022,"y":1110,"width":141,"height":39},{"text":"데이터","x":1180,"y":1110,"width":95,"height":38},{"text":"스트림은","x":1294,"y":1112,"width":138,"height":37},{"text":"500,(脚바이트로","x":1445,"y":1113,"width":273,"height":37},{"text":"구성된","x":1733,"y":1112,"width":98,"height":38},{"text":"파","x":1845,"y":1118,"width":29,"height":37}]},{"text":"일이라 가정하자. 또한, MSS는 1 000바이트이고 데이터 스트림의 첫 번째 바이트는 0","words":[{"text":"일이라","x":568,"y":1172,"width":99,"height":38},{"text":"가정하자.","x":679,"y":1172,"width":140,"height":39},{"text":"또한,","x":833,"y":1173,"width":74,"height":37},{"text":"MSS는","x":920,"y":1174,"width":111,"height":35},{"text":"1","x":1048,"y":1177,"width":9,"height":28},{"text":"000바이트이고","x":1072,"y":1172,"width":228,"height":38},{"text":"데이터","x":1315,"y":1173,"width":96,"height":38},{"text":"스트림의","x":1429,"y":1173,"width":136,"height":38},{"text":"첫","x":1584,"y":1174,"width":32,"height":38},{"text":"번째","x":1633,"y":1174,"width":66,"height":37},{"text":"바이트는","x":1717,"y":1173,"width":131,"height":38},{"text":"0","x":1858,"y":1183,"width":16,"height":29}]},{"text":"으로 설정하다고 가정하자. 그림 3.30처럼 TCP는 데이터 스트림으로부터 500개의 세","words":[{"text":"으로","x":565,"y":1236,"width":67,"height":30},{"text":"설정하다고","x":647,"y":1234,"width":165,"height":38},{"text":"가정하자.","x":827,"y":1234,"width":138,"height":38},{"text":"그림","x":982,"y":1233,"width":62,"height":38},{"text":"3.30처럼","x":1062,"y":1234,"width":130,"height":38},{"text":"TCP는","x":1209,"y":1236,"width":107,"height":35},{"text":"데이터","x":1330,"y":1234,"width":97,"height":38},{"text":"스트림으로부터","x":1446,"y":1235,"width":243,"height":38},{"text":"500개의","x":1708,"y":1235,"width":122,"height":38},{"text":"세","x":1846,"y":1240,"width":25,"height":37}]},{"text":"그먼트들을 구성한다. 첫 번째 세그먼트는 순서번호 0, 두 번째 세그먼트는 순서번호","words":[{"text":"그먼트들을","x":565,"y":1295,"width":168,"height":38},{"text":"구성한다.","x":748,"y":1296,"width":140,"height":39},{"text":"첫","x":907,"y":1296,"width":30,"height":38},{"text":"번째","x":955,"y":1295,"width":62,"height":39},{"text":"세그먼트는","x":1035,"y":1295,"width":169,"height":37},{"text":"순서번호","x":1218,"y":1295,"width":137,"height":38},{"text":"0,","x":1370,"y":1300,"width":28,"height":33},{"text":"두","x":1415,"y":1297,"width":36,"height":35},{"text":"번째","x":1469,"y":1296,"width":64,"height":37},{"text":"세그먼트는","x":1553,"y":1297,"width":178,"height":37},{"text":"순서번호","x":1746,"y":1296,"width":128,"height":37}]},{"text":"1,刪, 세 번째 세그먼트는 순서번호 2,0(刈과 같은 식으로 할당된다. 각 각의 순서번","words":[{"text":"1,刪,","x":569,"y":1360,"width":90,"height":35},{"text":"세","x":676,"y":1358,"width":30,"height":37},{"text":"번째","x":727,"y":1358,"width":61,"height":37},{"text":"세그먼트는","x":806,"y":1358,"width":166,"height":38},{"text":"순서번호","x":987,"y":1357,"width":133,"height":38},{"text":"2,0(刈과","x":1135,"y":1356,"width":122,"height":39},{"text":"같은","x":1272,"y":1356,"width":69,"height":37},{"text":"식으로","x":1357,"y":1357,"width":102,"height":36},{"text":"할당된다.","x":1476,"y":1357,"width":148,"height":38},{"text":"각","x":1644,"y":1358,"width":36,"height":37},{"text":"각의","x":1696,"y":1357,"width":66,"height":38},{"text":"순서번","x":1781,"y":1358,"width":92,"height":39}]},{"text":"호는 적절한 TCP 세그먼트의 헤더 내부의 순서번호 필드에 삼입된다.","words":[{"text":"호는","x":565,"y":1419,"width":68,"height":36},{"text":"적절한","x":646,"y":1418,"width":99,"height":38},{"text":"TCP","x":755,"y":1424,"width":70,"height":29},{"text":"세그먼트의","x":837,"y":1419,"width":163,"height":38},{"text":"헤더","x":1017,"y":1418,"width":61,"height":38},{"text":"내부의","x":1096,"y":1418,"width":95,"height":38},{"text":"순서번호","x":1206,"y":1417,"width":138,"height":38},{"text":"필드에","x":1357,"y":1418,"width":101,"height":38},{"text":"삼입된다.","x":1473,"y":1418,"width":150,"height":39}]},{"text":"이제 확인응답 번호를 생각해 보자. 이것은 순서번호보다 약간 까다롭다. TCP는","words":[{"text":"이제","x":632,"y":1480,"width":62,"height":37},{"text":"확인응답","x":712,"y":1480,"width":134,"height":39},{"text":"번호를","x":862,"y":1481,"width":97,"height":37},{"text":"생각해","x":975,"y":1480,"width":96,"height":38},{"text":"보자.","x":1089,"y":1479,"width":73,"height":38},{"text":"이것은","x":1182,"y":1478,"width":100,"height":39},{"text":"순서번호보다","x":1297,"y":1479,"width":211,"height":39},{"text":"약간","x":1524,"y":1480,"width":70,"height":38},{"text":"까다롭다.","x":1610,"y":1480,"width":150,"height":38},{"text":"TCP는","x":1778,"y":1483,"width":98,"height":36}]},{"text":"호스트 A가 호스트 B로 데이터를 송신하는 동안에 호스트 B로부터 데이터를 수신하","words":[{"text":"호스트","x":565,"y":1542,"width":100,"height":31},{"text":"A가","x":679,"y":1542,"width":62,"height":37},{"text":"호스트","x":755,"y":1544,"width":99,"height":31},{"text":"B로","x":868,"y":1546,"width":59,"height":30},{"text":"데이터를","x":942,"y":1542,"width":132,"height":38},{"text":"송신하는","x":1088,"y":1541,"width":135,"height":38},{"text":"동안에","x":1237,"y":1540,"width":100,"height":38},{"text":"호스트","x":1355,"y":1542,"width":105,"height":31},{"text":"B로부터","x":1475,"y":1542,"width":129,"height":38},{"text":"데이터를","x":1626,"y":1542,"width":142,"height":38},{"text":"수신하","x":1781,"y":1541,"width":96,"height":40}]},{"text":"게 해 주는(같은 TCP 연결의 부뿌처럼) 전이중 방식임을 상기하자. 호스트 B로부터","words":[{"text":"게","x":567,"y":1602,"width":28,"height":38},{"text":"해","x":615,"y":1603,"width":30,"height":37},{"text":"주는(같은","x":662,"y":1603,"width":148,"height":39},{"text":"TCP","x":823,"y":1608,"width":70,"height":29},{"text":"연결의","x":912,"y":1603,"width":94,"height":38},{"text":"부뿌처럼)","x":1025,"y":1602,"width":145,"height":39},{"text":"전이중","x":1189,"y":1602,"width":101,"height":38},{"text":"방식임을","x":1306,"y":1602,"width":140,"height":38},{"text":"상기하자.","x":1461,"y":1603,"width":150,"height":38},{"text":"호스트","x":1631,"y":1606,"width":108,"height":30},{"text":"B로부터","x":1755,"y":1603,"width":118,"height":39}]},{"text":"도착한 각 세그먼트는 B로부터 A로 들어온 데이터에 대한 순서번호를 갖는다. 호스트","words":[{"text":"도착한","x":565,"y":1664,"width":101,"height":37},{"text":"각","x":679,"y":1664,"width":34,"height":38},{"text":"세그먼트는","x":725,"y":1664,"width":166,"height":38},{"text":"B로부터","x":903,"y":1665,"width":121,"height":37},{"text":"A로","x":1041,"y":1668,"width":62,"height":30},{"text":"들어온","x":1116,"y":1663,"width":102,"height":39},{"text":"데이터에","x":1232,"y":1663,"width":132,"height":38},{"text":"대한","x":1383,"y":1663,"width":70,"height":38},{"text":"순서번호를","x":1465,"y":1664,"width":179,"height":38},{"text":"갖는다.","x":1659,"y":1664,"width":114,"height":38},{"text":"호스트","x":1788,"y":1666,"width":89,"height":31}]},{"text":"A가 자신의 세그먼트에 삽입하는 확인응답 번호는 호스트 A가 호스트 B로부터 기대하는 다","words":[{"text":"A가","x":562,"y":1728,"width":59,"height":34},{"text":"자신의","x":632,"y":1728,"width":91,"height":34},{"text":"세그먼트에","x":736,"y":1728,"width":152,"height":34},{"text":"삽입하는","x":901,"y":1728,"width":125,"height":34},{"text":"확인응답","x":1038,"y":1727,"width":125,"height":35},{"text":"번호는","x":1176,"y":1727,"width":93,"height":34},{"text":"호스트","x":1280,"y":1728,"width":98,"height":30},{"text":"A가","x":1387,"y":1727,"width":61,"height":34},{"text":"호스트","x":1459,"y":1728,"width":100,"height":30},{"text":"B로부터","x":1570,"y":1728,"width":125,"height":33},{"text":"기대하는","x":1712,"y":1726,"width":126,"height":34},{"text":"다","x":1850,"y":1728,"width":27,"height":34}]},{"text":"음 바이트의 순서번호이다. 이것이 어떤 의미인지 이해하기 위해서 몇 가지 예를 살펴보","words":[{"text":"음","x":565,"y":1789,"width":31,"height":34},{"text":"바이트의","x":609,"y":1789,"width":121,"height":35},{"text":"순서번호이다.","x":742,"y":1788,"width":192,"height":36},{"text":"이것이","x":951,"y":1787,"width":95,"height":38},{"text":"어떤","x":1064,"y":1787,"width":63,"height":38},{"text":"의미인지","x":1143,"y":1786,"width":130,"height":38},{"text":"이해하기","x":1291,"y":1785,"width":133,"height":38},{"text":"위해서","x":1444,"y":1786,"width":99,"height":37},{"text":"몇","x":1563,"y":1786,"width":31,"height":37},{"text":"가지","x":1611,"y":1786,"width":67,"height":37},{"text":"예를","x":1698,"y":1786,"width":70,"height":37},{"text":"살펴보","x":1781,"y":1785,"width":95,"height":37}]},{"text":"겠다. 호스트 A가 B로부터 0에서 535까지 번호가 붙은 모든 바이트를 수신했다고 가","words":[{"text":"겠다.","x":567,"y":1849,"width":71,"height":38},{"text":"호스트","x":655,"y":1851,"width":98,"height":30},{"text":"A가","x":766,"y":1848,"width":61,"height":38},{"text":"B로부터","x":840,"y":1848,"width":120,"height":38},{"text":"0에서","x":977,"y":1848,"width":83,"height":38},{"text":"535까지","x":1077,"y":1848,"width":121,"height":38},{"text":"번호가","x":1218,"y":1847,"width":101,"height":37},{"text":"붙은","x":1332,"y":1847,"width":70,"height":36},{"text":"모든","x":1416,"y":1849,"width":71,"height":34},{"text":"바이트를","x":1501,"y":1846,"width":143,"height":38},{"text":"수신했다고","x":1658,"y":1845,"width":175,"height":38},{"text":"가","x":1848,"y":1847,"width":29,"height":37}]},{"text":"정하자. 그리고 호스트 B로 세그먼트를 송신하려 한다고 가정하자. 호스트 A는 호스","words":[{"text":"정하자.","x":567,"y":1910,"width":104,"height":38},{"text":"그리고","x":688,"y":1910,"width":99,"height":37},{"text":"호스트","x":802,"y":1912,"width":98,"height":30},{"text":"B로","x":914,"y":1913,"width":60,"height":29},{"text":"세그먼트를","x":989,"y":1909,"width":167,"height":38},{"text":"송신하려","x":1170,"y":1908,"width":133,"height":38},{"text":"한다고","x":1322,"y":1908,"width":104,"height":37},{"text":"가정하자.","x":1443,"y":1908,"width":147,"height":38},{"text":"호스트","x":1610,"y":1910,"width":108,"height":30},{"text":"A는","x":1735,"y":1909,"width":65,"height":35},{"text":"호스","x":1814,"y":1909,"width":61,"height":30}]},{"text":"트 B의 데이터 스트림에서 536번째 바이트와 그다음에 오는 모든 바이트를 기다리고","words":[{"text":"트","x":566,"y":1975,"width":32,"height":28},{"text":"B의","x":612,"y":1971,"width":54,"height":38},{"text":"데이터","x":685,"y":1971,"width":93,"height":38},{"text":"스트림에서","x":796,"y":1970,"width":160,"height":38},{"text":"536번째","x":974,"y":1971,"width":121,"height":37},{"text":"바이트와","x":1113,"y":1970,"width":135,"height":38},{"text":"그다음에","x":1261,"y":1969,"width":134,"height":38},{"text":"오는","x":1413,"y":1971,"width":71,"height":35},{"text":"모든","x":1499,"y":1971,"width":71,"height":35},{"text":"바이트를","x":1584,"y":1969,"width":146,"height":38},{"text":"기다리고","x":1747,"y":1968,"width":129,"height":39}]},{"text":"있다. 그래서 호스트 A는 세그먼트의 확인응답 번호 필드에 536을 삽입하고 그것을 B","words":[{"text":"있다.","x":569,"y":2033,"width":70,"height":38},{"text":"그래서","x":654,"y":2032,"width":94,"height":37},{"text":"호스트","x":765,"y":2034,"width":96,"height":30},{"text":"A는","x":873,"y":2033,"width":61,"height":35},{"text":"세그먼트의","x":946,"y":2031,"width":163,"height":39},{"text":"확인응답","x":1125,"y":2031,"width":135,"height":39},{"text":"번호","x":1274,"y":2031,"width":67,"height":37},{"text":"필드에","x":1356,"y":2031,"width":99,"height":39},{"text":"536을","x":1472,"y":2031,"width":97,"height":38},{"text":"삽입하고","x":1581,"y":2031,"width":146,"height":38},{"text":"그것을","x":1740,"y":2030,"width":103,"height":38},{"text":"B","x":1854,"y":2034,"width":20,"height":28}]},{"text":"에 송신한다.","words":[{"text":"에","x":569,"y":2095,"width":28,"height":37},{"text":"송신한다.","x":612,"y":2093,"width":137,"height":39}]},{"text":"다른 예로, 호스트 A가 호스트 B로부터 0~535의 바이트를 포함하는 어떤 세그","words":[{"text":"다른","x":633,"y":2156,"width":65,"height":38},{"text":"예로,","x":713,"y":2156,"width":72,"height":38},{"text":"호스트","x":801,"y":2158,"width":96,"height":31},{"text":"A가","x":912,"y":2155,"width":61,"height":39},{"text":"호스트","x":987,"y":2157,"width":100,"height":31},{"text":"B로부터","x":1102,"y":2156,"width":121,"height":39},{"text":"0~535의","x":1243,"y":2156,"width":144,"height":38},{"text":"바이트를","x":1407,"y":2156,"width":142,"height":38},{"text":"포함하는","x":1565,"y":2156,"width":145,"height":38},{"text":"어떤","x":1729,"y":2155,"width":68,"height":39},{"text":"세그","x":1814,"y":2154,"width":62,"height":38}]},{"text":"먼트와 900 ~1,0側의 바이트를 포함하는 또 다른 세그먼트를 수신했다고 가정하자.","words":[{"text":"먼트와","x":571,"y":2218,"width":97,"height":38},{"text":"900","x":681,"y":2222,"width":56,"height":30},{"text":"~1,0側의","x":756,"y":2217,"width":140,"height":39},{"text":"바이트를","x":915,"y":2217,"width":132,"height":38},{"text":"포함하는","x":1062,"y":2218,"width":133,"height":38},{"text":"또","x":1210,"y":2223,"width":33,"height":28},{"text":"다른","x":1260,"y":2218,"width":67,"height":38},{"text":"세그먼트를","x":1343,"y":2218,"width":176,"height":38},{"text":"수신했다고","x":1534,"y":2218,"width":182,"height":38},{"text":"가정하자.","x":1735,"y":2216,"width":140,"height":40}]},{"text":"어떤 이유 때문인지 호스트 A는 536~899의 바이트를 아직 수신하지 않았다. 이 예에","words":[{"text":"어떤","x":571,"y":2280,"width":62,"height":39},{"text":"이유","x":649,"y":2281,"width":63,"height":38},{"text":"때문인지","x":726,"y":2280,"width":124,"height":38},{"text":"호스트","x":866,"y":2281,"width":97,"height":31},{"text":"A는","x":975,"y":2281,"width":61,"height":36},{"text":"536~899의","x":1048,"y":2281,"width":176,"height":38},{"text":"바이트를","x":1241,"y":2280,"width":137,"height":39},{"text":"아직","x":1391,"y":2280,"width":65,"height":38},{"text":"수신하지","x":1474,"y":2280,"width":138,"height":39},{"text":"않았다.","x":1632,"y":2280,"width":116,"height":40},{"text":"이","x":1766,"y":2280,"width":30,"height":39},{"text":"예에","x":1814,"y":2278,"width":59,"height":39}]},{"text":"서 호스트 A는 B의 데이터 스트림을 재생성하기 위해서 536번째 바이트를 아직 기다","words":[{"text":"서","x":571,"y":2343,"width":27,"height":38},{"text":"호스트","x":616,"y":2345,"width":98,"height":30},{"text":"A는","x":726,"y":2344,"width":60,"height":35},{"text":"B의","x":799,"y":2342,"width":53,"height":38},{"text":"데이터","x":869,"y":2342,"width":92,"height":38},{"text":"스트림을","x":978,"y":2342,"width":132,"height":38},{"text":"재생성하기","x":1124,"y":2342,"width":161,"height":39},{"text":"위해서","x":1304,"y":2343,"width":98,"height":38},{"text":"536번째","x":1419,"y":2343,"width":130,"height":38},{"text":"바이트를","x":1567,"y":2343,"width":145,"height":38},{"text":"아직","x":1727,"y":2343,"width":67,"height":38},{"text":"기다","x":1814,"y":2341,"width":61,"height":38}]},{"text":"리고 있다. 그러므로 B에 대한 A의 다음 세그먼트는 확인응답 번호 필드에 536을 가","words":[{"text":"리고","x":573,"y":2404,"width":62,"height":38},{"text":"있다.","x":652,"y":2404,"width":70,"height":39},{"text":"그러므로","x":739,"y":2404,"width":129,"height":38},{"text":"B에","x":881,"y":2403,"width":55,"height":39},{"text":"대한","x":953,"y":2403,"width":65,"height":38},{"text":"A의","x":1032,"y":2404,"width":55,"height":38},{"text":"다음","x":1105,"y":2404,"width":66,"height":38},{"text":"세그먼트는","x":1185,"y":2405,"width":168,"height":37},{"text":"확인응답","x":1367,"y":2404,"width":141,"height":39},{"text":"번호","x":1525,"y":2405,"width":69,"height":37},{"text":"필드에","x":1612,"y":2404,"width":104,"height":39},{"text":"536을","x":1735,"y":2405,"width":97,"height":37},{"text":"가","x":1845,"y":2403,"width":31,"height":38}]},{"text":"질 것이다. TCP는 스트림에서 첫 번째 잃어버린 바이트까지의 바이트들까지만 확인","words":[{"text":"질","x":572,"y":2466,"width":29,"height":37},{"text":"것이다.","x":621,"y":2466,"width":103,"height":39},{"text":"TCP는","x":741,"y":2468,"width":102,"height":35},{"text":"스트림에서","x":858,"y":2465,"width":159,"height":39},{"text":"첫","x":1038,"y":2466,"width":29,"height":38},{"text":"번째","x":1085,"y":2466,"width":61,"height":38},{"text":"잃어버린","x":1166,"y":2466,"width":129,"height":39},{"text":"바이트까지의","x":1313,"y":2466,"width":206,"height":40},{"text":"바이트들까지만","x":1540,"y":2467,"width":255,"height":40},{"text":"확인","x":1810,"y":2465,"width":64,"height":39}]},{"text":"응답하기 때문에, TCP는 누적 확인응답(cumulative acknouledgment)을 제공한다","words":[{"text":"응답하기","x":570,"y":2527,"width":128,"height":39},{"text":"때문에,","x":720,"y":2528,"width":104,"height":39},{"text":"TCP는","x":841,"y":2530,"width":102,"height":35},{"text":"누적","x":958,"y":2528,"width":61,"height":39},{"text":"확인응답(cumulative","x":1039,"y":2528,"width":322,"height":39},{"text":"acknouledgment)을","x":1375,"y":2530,"width":347,"height":42},{"text":"제공한다","x":1740,"y":2527,"width":135,"height":42}]},{"text":"고 한다.","words":[{"text":"고","x":571,"y":2593,"width":32,"height":26},{"text":"한다.","x":616,"y":2589,"width":72,"height":38}]}]}