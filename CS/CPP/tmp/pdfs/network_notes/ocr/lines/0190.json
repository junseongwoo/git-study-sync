":"•","x":299,"y":1316,"width":16,"height":14},{"text":"같은","x":331,"y":1309,"width":58,"height":30},{"text":"웹","x":401,"y":1309,"width":28,"height":31},{"text":"서버애플리케이션과","x":442,"y":1308,"width":257,"height":31},{"text":"통신하기","x":709,"y":1308,"width":109,"height":31},{"text":"위해","x":832,"y":1308,"width":52,"height":30},{"text":"같은","x":898,"y":1308,"width":54,"height":30},{"text":"목적지","x":962,"y":1308,"width":83,"height":31},{"text":"포트","x":1057,"y":1311,"width":56,"height":24},{"text":"번호(80)를","x":1126,"y":1308,"width":140,"height":31},{"text":"이용하는","x":1279,"y":1307,"width":112,"height":32},{"text":"두","x":1402,"y":1309,"width":29,"height":29},{"text":"클","x":1442,"y":1309,"width":28,"height":30}]},{"text":"라이언트","words":[{"text":"라이언트","x":167,"y":1350,"width":109,"height":31}]},{"text":"그림 3.5는 웹 서버가 각각의 연결에 따라서 새로운 프로세스를 만드는 것을 보여","words":[{"text":"그림","x":231,"y":1498,"width":62,"height":37},{"text":"3.5는","x":312,"y":1501,"width":87,"height":35},{"text":"웹","x":413,"y":1499,"width":30,"height":37},{"text":"서버가","x":461,"y":1498,"width":105,"height":39},{"text":"각각의","x":578,"y":1497,"width":98,"height":39},{"text":"연결에","x":695,"y":1497,"width":94,"height":38},{"text":"따라서","x":804,"y":1496,"width":94,"height":39},{"text":"새로운","x":915,"y":1497,"width":100,"height":38},{"text":"프로세스를","x":1028,"y":1496,"width":168,"height":38},{"text":"만드는","x":1209,"y":1498,"width":102,"height":37},{"text":"것을","x":1326,"y":1498,"width":67,"height":38},{"text":"보여","x":1405,"y":1499,"width":63,"height":38}]},{"text":"준다. 그림 3.5처럼 이들 프로세스는 각자 연결 소켓을 가지며, 이 연결 소켓을 통해서","words":[{"text":"준다.","x":168,"y":1558,"width":71,"height":39},{"text":"그림","x":256,"y":1560,"width":64,"height":38},{"text":"3.5처럼","x":338,"y":1561,"width":116,"height":38},{"text":"이들","x":474,"y":1560,"width":68,"height":38},{"text":"프로세스는","x":555,"y":1560,"width":170,"height":38},{"text":"각자","x":738,"y":1559,"width":66,"height":38},{"text":"연결","x":819,"y":1558,"width":60,"height":38},{"text":"소켓을","x":894,"y":1558,"width":99,"height":38},{"text":"가지며,","x":1006,"y":1558,"width":108,"height":38},{"text":"이","x":1130,"y":1558,"width":28,"height":38},{"text":"연결","x":1178,"y":1559,"width":63,"height":38},{"text":"소켓을","x":1256,"y":1560,"width":103,"height":38},{"text":"통해서","x":1371,"y":1560,"width":98,"height":39}]},{"text":"HITP 요청을 수신하고, HTTP 응답을 전송한다. 그러나 연결 소켓과 프로세스 사이","words":[{"text":"HITP","x":168,"y":1626,"width":93,"height":28},{"text":"요청을","x":276,"y":1622,"width":107,"height":37},{"text":"수신하고,","x":398,"y":1622,"width":147,"height":37},{"text":"HTTP","x":562,"y":1626,"width":97,"height":29},{"text":"응답을","x":674,"y":1620,"width":101,"height":38},{"text":"전송한다.","x":791,"y":1619,"width":135,"height":38},{"text":"그러나","x":942,"y":1619,"width":102,"height":38},{"text":"연결","x":1059,"y":1619,"width":63,"height":37},{"text":"소켓과","x":1139,"y":1621,"width":101,"height":37},{"text":"프로세스","x":1254,"y":1622,"width":137,"height":37},{"text":"사이","x":1405,"y":1622,"width":65,"height":39}]},{"text":"에 항상 일대일 대응이 이루어지는 것은 아니다. 실제로, 오늘날의 많은 고성능 웹 서","words":[{"text":"에","x":168,"y":1682,"width":28,"height":37},{"text":"항상","x":213,"y":1682,"width":69,"height":38},{"text":"일대일","x":298,"y":1683,"width":101,"height":37},{"text":"대응이","x":417,"y":1684,"width":100,"height":37},{"text":"이루어지는","x":538,"y":1683,"width":169,"height":37},{"text":"것은","x":722,"y":1682,"width":66,"height":37},{"text":"아니다.","x":801,"y":1680,"width":104,"height":39},{"text":"실제로,","x":923,"y":1681,"width":105,"height":38},{"text":"오늘날의","x":1044,"y":1681,"width":131,"height":39},{"text":"많은","x":1193,"y":1682,"width":69,"height":39},{"text":"고성능","x":1275,"y":1683,"width":103,"height":39},{"text":"웹","x":1393,"y":1685,"width":30,"height":37},{"text":"서","x":1441,"y":1685,"width":29,"height":38}]},{"text":"버들은 하나의 프로세스만 사용 한다. 그러면서, 각각의 새로운 클라이언트 연결을 위","words":[{"text":"버들은","x":169,"y":1742,"width":98,"height":37},{"text":"하나의","x":280,"y":1744,"width":102,"height":37},{"text":"프로세스만","x":400,"y":1744,"width":176,"height":38},{"text":"사용","x":589,"y":1744,"width":69,"height":37},{"text":"한다.","x":671,"y":1743,"width":74,"height":38},{"text":"그러면서,","x":761,"y":1742,"width":138,"height":38},{"text":"각각의","x":914,"y":1742,"width":96,"height":38},{"text":"새로운","x":1027,"y":1743,"width":101,"height":38},{"text":"클라이언트","x":1141,"y":1743,"width":170,"height":39},{"text":"연결을","x":1326,"y":1745,"width":102,"height":38},{"text":"위","x":1441,"y":1747,"width":30,"height":38}]},{"text":"해 새로운 연결 소켓과 함께 새로운 스레드(가벼운 서브프로세스)를 생성한다. 만약 2","words":[{"text":"해","x":168,"y":1803,"width":28,"height":37},{"text":"새로운","x":213,"y":1803,"width":102,"height":37},{"text":"연결","x":332,"y":1804,"width":66,"height":37},{"text":"소켓과","x":414,"y":1805,"width":107,"height":37},{"text":"함께","x":534,"y":1805,"width":66,"height":37},{"text":"새로운","x":617,"y":1805,"width":102,"height":37},{"text":"스레드(가벼운","x":732,"y":1802,"width":210,"height":40},{"text":"서브프로세스)를","x":956,"y":1803,"width":245,"height":40},{"text":"생성한다.","x":1215,"y":1805,"width":142,"height":39},{"text":"만약","x":1374,"y":1807,"width":69,"height":38},{"text":"2","x":1456,"y":1813,"width":18,"height":28}]},{"text":"장의 첫 번째 프로그래밍 과제를 한다면, 이처럼 동작하는 웹 서버를 만들었을 것이다.","words":[{"text":"장의","x":168,"y":1864,"width":61,"height":37},{"text":"첫","x":247,"y":1864,"width":31,"height":38},{"text":"번째","x":294,"y":1865,"width":65,"height":38},{"text":"프로그래밍","x":376,"y":1865,"width":171,"height":38},{"text":"과제를","x":564,"y":1865,"width":103,"height":38},{"text":"한다면,","x":679,"y":1865,"width":109,"height":38},{"text":"이처럼","x":803,"y":1864,"width":92,"height":38},{"text":"동작하는","x":910,"y":1865,"width":133,"height":38},{"text":"웹","x":1056,"y":1865,"width":30,"height":38},{"text":"서버를","x":1102,"y":1866,"width":100,"height":37},{"text":"만들었을","x":1215,"y":1866,"width":136,"height":38},{"text":"것이다.","x":1365,"y":1869,"width":107,"height":39}]},{"text":"그런 웹 서버에서는 하나의 동일한 프로세스에 첨부된 많은 연결 소켓들(다른 식별자","words":[{"text":"그