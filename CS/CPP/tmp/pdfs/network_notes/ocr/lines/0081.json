height":35},{"text":"존재하며","x":1318,"y":1858,"width":122,"height":33},{"text":"어","x":1459,"y":1858,"width":26,"height":34}]},{"text":"떤 회로를 사용하는지 감지하기 위해서 광전자(photoelectnc) 장비두을 사용했다. 왜냐하면 쌍","words":[{"text":"떤","x":138,"y":1911,"width":26,"height":33},{"text":"회로를","x":182,"y":1912,"width":91,"height":34},{"text":"사용하는지","x":286,"y":1912,"width":151,"height":34},{"text":"감지하기","x":456,"y":1911,"width":118,"height":34},{"text":"위해서","x":595,"y":1910,"width":88,"height":34},{"text":"광전자(photoelectnc)","x":701,"y":1910,"width":308,"height":37},{"text":"장비두을","x":1027,"y":1911,"width":127,"height":34},{"text":"사용했다.","x":1169,"y":1912,"width":134,"height":34},{"text":"왜냐하면","x":1320,"y":1913,"width":124,"height":33},{"text":"쌍","x":1460,"y":1916,"width":30,"height":31}]},{"text":"안정 멀티바이브레이터(bistable multivibrator)가 감지 분야에서 디지털 처리를 하는 데 필요한","words":[{"text":"안정","x":136,"y":1969,"width":55,"height":31},{"text":"멀티바이브레이터(bistable","x":208,"y":1969,"width":351,"height":33},{"text":"multivibrator)가","x":572,"y":1965,"width":237,"height":35},{"text":"감지","x":825,"y":1965,"width":58,"height":34},{"text":"분야에서","x":902,"y":1966,"width":124,"height":34},{"text":"디지털","x":1048,"y":1967,"width":92,"height":33},{"text":"처리를","x":1160,"y":1968,"width":94,"height":33},{"text":"하는","x":1269,"y":1968,"width":64,"height":34},{"text":"데","x":1349,"y":1968,"width":26,"height":34},{"text":"필요한","x":1396,"y":1969,"width":93,"height":34}]},{"text":"기술의 한 종류였기 때문이다. 요즘 말로 플립플롭(尸ip-尹()p미나 스위치로 알려진 이 회로는 김","words":[{"text":"기술의","x":138,"y":2023,"width":87,"height":34},{"text":"한","x":243,"y":2024,"width":31,"height":32},{"text":"종류였기","x":287,"y":2024,"width":120,"height":35},{"text":"때문이다.","x":426,"y":2023,"width":130,"height":35},{"text":"요즘","x":572,"y":2024,"width":63,"height":32},{"text":"말로","x":650,"y":2023,"width":62,"height":33},{"text":"플립플롭(尸ip-尹()p미나","x":726,"y":2023,"width":320,"height":37},{"text":"스위치로","x":1059,"y":2025,"width":121,"height":31},{"text":"알려진","x":1195,"y":2024,"width":93,"height":34},{"text":"이","x":1305,"y":2025,"width":26,"height":34},{"text":"회로는","x":1351,"y":2025,"width":92,"height":34},{"text":"김","x":1460,"y":2026,"width":24,"height":33}]},{"text":"퓨터 구성 소재이기도 하다.","words":[{"text":"퓨터","x":137,"y":2079,"width":57,"height":34},{"text":"구성","x":209,"y":2080,"width":58,"height":34},{"text":"소재이기도","x":284,"y":2081,"width":155,"height":34},{"text":"하다.","x":450,"y":2081,"width":68,"height":33}]},{"text":"처음으로 호스트 사이에서 메시지를 보낼 때 무슨 생각을 했는가?(UCLA에서 스탠퍼드연구소까지)","words":[{"text":"처음으로","x":138,"y":2205,"width":118,"height":33},{"text":"호스트","x":266,"y":2207,"width":89,"height":29},{"text":"사이에서","x":364,"y":2206,"width":119,"height":33},{"text":"메시지를","x":496,"y":2206,"width":118,"height":33},{"text":"보낼","x":624,"y":2206,"width":59,"height":32},{"text":"때","x":695,"y":2206,"width":27,"height":32},{"text":"무슨","x":734,"y":2205,"width":60,"height":33},{"text":"생각을","x":805,"y":2206,"width":90,"height":32},{"text":"했는가?(UCLA에서","x":905,"y":2206,"width":282,"height":33},{"text":"스탠퍼드연구소까지)","x":1198,"y":2207,"width":281,"height":33}]},{"text":"호스트에서 호스트까지의 최초 메시지는 최대 사건이 아니었다. 사실 이 사건의 중요성을 알지","words":[{"text":"호스트에서","x":138,"y":2268,"width":151,"height":34},{"text":"호스트까지의","x":307,"y":2268,"width":184,"height":35},{"text":"최초","x":510,"y":2269,"width":59,"height":33},{"text":"메시지는","x":584,"y":2268,"width":126,"height":34},{"text":"최대","x":724,"y":2268,"width":58,"height":34},{"text":"사건이","x":799,"y":2268,"width":90,"height":34},{"text":"아니었다.","x":907,"y":2268,"width":132,"height":34},{"text":"사실","x":1056,"y":2269,"width":60,"height":34},{"text":"이","x":1133,"y":2269,"width":27,"height":34},{"text":"사건의","x":1178,"y":2269,"width":90,"height":34},{"text":"중요성을","x":1286,"y":2269,"width":125,"height":35},{"text":"알지","x":1426,"y":2269,"width":57,"height":34}]},{"text":"못했다. 과거 많은 발명가들이 그랬던 것처럼(새뮤엘 모스, “신은 무엇을 하였나” 혹은 알렉산더","words":[{"text":"못했다.","x":138,"y":2324,"width":99,"height":34},{"text":"과거","x":252,"y":2325,"width":58,"height":34},{"text":"많은","x":327,"y":2325,"width":62,"height":34},{"text":"발명가들이","x":402,"y":2324,"width":151,"height":35},{"text":"그랬던","x":570,"y":2324,"width":92,"height":34},{"text":"것처럼(새뮤엘","x":678,"y":2324,"width":196,"height":35},{"text":"모스,","x":888,"y":2327,"width":69,"height":30},{"text":"“신은","x":972,"y":2325,"width":75,"height":32},{"text":"무엇을","x":1059,"y":2325,"width":96,"height":34},{"text":"하였나”","x":1167,"y":2325,"width":106,"height":34},{"text":"혹은","x":1286,"y":2326,"width":63,"height":33},{"text":"알렉산더","x":1362,"y":2325,"width":121,"height":34}]},{"text":"그래함 벨, “와슨, 이리 와 보게! 당신이 필요해” 혹은 닐 암스트롱, “한 사람을 위한 작은 걸음이","words":[{"text":"그래함","x":138,"y":2380,"width":93,"height":34},{"text":"벨,","x":244,"y":2380,"width":37,"height":34},{"text":"“와슨,","x":295,"y":2380,"width":82,"height":35},{"text":"이리","x":392,"y":2381,"width":57,"height":34},{"text":"와","x":464,"y":2380,"width":33,"height":33},{"text":"보게!","x":508,"y":2379,"width":70,"height":34},{"text":"당신이","x":594,"y":2379,"width":90,"height":34},{"text":"필요해”","x":702,"y":2380,"width":103,"height":33},{"text":"혹은","x":817,"y":2380,"width":64,"height":33},{"text":"닐","x":894,"y":2379,"width":26,"height":33},{"text":"암스트롱,","x":935,"y":2380,"width":132,"height":33},{"text":"“한","x":1080,"y":2381,"width":45,"height":32},{"text":"사람을","x":1136,"y":2381,"width":95,"height":33},{"text":"위한","x":1244,"y":2380,"width":63,"height":34},{"text":"작은","x":1318,"y":2381,"width":63,"height":33},{"text":"걸음이","x":1394,"y":2380,"width":89,"height":34}]},{"text":"지만 인류를 위해서는 커다란 도약이다”), 역사적으로 중요한 특별 메시지를 준비하지 않0갔다.","words":[{"text":"지만","x":140,"y":2435,"width":61,"height":34},{"text":"인류를","x":217,"y":2435,"width":92,"height":34},{"text":"위해서는","x":324,"y":2436,"width":125,"height":34},{"text":"커다란","x":465,"y":2435,"width":93,"height":34},{"text":"도약이다”),","x":572,"y":2435,"width":157,"height":35},{"text":"역사적으로","x":748,"y":2435,"width":154,"height":34},{"text":"중요한","x":917,"y":2435,"width":94,"height":33},{"text":"특별","x":1024,"y":2435,"width":61,"height":33},{"text":"메시지를","x":1103,"y":2435,"width":125,"height":33},{"text":"준비하지","x":1243,"y":2435,"width":123,"height":34},{"text":"않0갔다.","x":1385,"y":2436,"width":100,"height":33}]},{"text":"그들은 현명했다! 그들은 미디어와 홍보에 대해 이해했다. 우리가 원한 것은 SRI 컴퓨터에 로그","words":[{"text":"그들은","x":139,"y":2491,"width":93,"height":32},{"text":"현명했다!","x":245,"y":2492,"width":123,"height":32},{"text":"그들은","x":386,"y":2492,"width":93,"height":32},{"text":"미디어와","x":493,"y":2490,"width":125,"height":34},{"text":"홍보에","x":630,"y":2491,"width":91,"height":34},{"text":"대해","x":738,"y":2491,"width":58,"height":33},{"text":"이해했다.","x":813,"y":2490,"width":129,"height":34},{"text":"우리가","x":957,"y":2490,"width":94,"height":33},{"text":"원한","x":1066,"y":2490,"width":62,"height":32},{"text":"것은","x":1142,"y":2490,"width":60,"height":33},{"text":"SRI","x":1216,"y":2494,"width":53,"height":26},{"text":"컴퓨터에","x":1286,"y":2490,"width":122,"height":33},{"text":"로그","x":1424,"y":2494,"width":62,"height":25}]},{"text":"인하는 것이었다. 그래서 “L”을 입력하고 올바로 수신되어 “0”을 입력하고 다음에 “g”를 입력했","words":[{"text":"인하는","x":141,"y":2546,"width":91,"height":34},{"text":"것이었다.","x":246,"y":2546,"width":130,"height":34},{"text":"그래서","x":392,"y":2546,"width":89,"height":33},{"text":"“L”을","x":497,"y":2545,"width":79,"height":34},{"text":"입력하고","x":591,"y":2545,"width":124,"height":35},{"text":"올바로","x":727,"y":2546,"width":94,"height":33},{"text":"수신되어","x":833,"y":2544,"width":121,"height":34},{"text":"“0”을","x":971,"y":2544,"width":75,"height":33},{"text":"입력하고","x":1060,"y":2544,"width":124,"height":34},{"text":"다음에","x":1197,"y":2544,"width":91,"height":33},{"text":"“g”를","x":1304,"y":2544,"width":75,"height":37},{"text":"입력했","x":1393,"y":2544,"width":92,"height":34}]},{"text":"는데 SRI 컴퓨터가 다운되었다. 그래서 우리의 메시지는 짧은 것이었고 가상 예언적인 메시지","words":[{"text":"는데","x":138,"y":2602,"width":59,"height":34},{"text":"SRI","x":215,"y":2605,"width":53,"height":26},{"text":"컴퓨터가","x":286,"y":2602,"width":124,"height":33},{"text":"다운되었다.","x":424,"y":2601,"width":162,"height":34},{"text":"그래서","x":603,"y":2601,"width":90,"height":34},{"text":"우리의","x":711,"y":2601,"width":90,"height":33},{"text":"메시지는","x":819,"y":2600,"width":124,"height":33},{"text":"짧은","x":958,"y":2599,"width":62,"height":33},{"text":"것이었고","x":1037,"y":2599,"width":123,"height":33},{"text":"가상","x":1175,"y":2599,"width":62,"height":33},{"text":"예언적인","x":1252,"y":2599,"width":124,"height":32},{"text":"메시지","x":1392,"y":2599,"width":90,"height":33}]},{"text":"73","words":[{"text":"73","x":1819,"y":2708,"width":54,"height":36}]}]}