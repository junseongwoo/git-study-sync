596,"y":2365,"width":109,"height":38},{"text":"프레임을","x":722,"y":2366,"width":135,"height":39},{"text":"최대","x":872,"y":2365,"width":61,"height":39},{"text":"개수까지","x":952,"y":2365,"width":126,"height":38},{"text":"전송한","x":1098,"y":2365,"width":97,"height":38},{"text":"뒤","x":1209,"y":2364,"width":28,"height":38},{"text":"토큰을","x":1255,"y":2364,"width":101,"height":37},{"text":"다음","x":1372,"y":2363,"width":68,"height":39},{"text":"노드로","x":1455,"y":2367,"width":109,"height":30},{"text":"전달한다.","x":1582,"y":2363,"width":152,"height":39},{"text":"토큰","x":1752,"y":2367,"width":67,"height":34},{"text":"전","x":1834,"y":2364,"width":26,"height":37}]},{"text":"달은 분산 방식이며 효율이 매우 높다. 그러나 이 방식에도 문제가 있다. 예를 들어, 노","words":[{"text":"달은","x":544,"y":2426,"width":69,"height":37},{"text":"분산","x":625,"y":2427,"width":71,"height":37},{"text":"방식이며","x":709,"y":2427,"width":130,"height":39},{"text":"효율이","x":856,"y":2427,"width":94,"height":38},{"text":"매우","x":968,"y":2427,"width":65,"height":38},{"text":"높다.","x":1045,"y":2427,"width":72,"height":38},{"text":"그러나","x":1132,"y":2426,"width":98,"height":39},{"text":"이","x":1243,"y":2426,"width":28,"height":38},{"text":"방식에도","x":1288,"y":2425,"width":136,"height":39},{"text":"문제가","x":1437,"y":2426,"width":110,"height":39},{"text":"있다.","x":1562,"y":2426,"width":78,"height":39},{"text":"예를","x":1658,"y":2426,"width":72,"height":38},{"text":"들어,","x":1742,"y":2425,"width":76,"height":38},{"text":"노","x":1832,"y":2430,"width":29,"height":26}]},{"text":"드 하나가 실패하면 전체 채널이 동작하지 않는다. 또는 노드가 잘못해서 토큰을 놓아","words":[{"text":"드","x":543,"y":2493,"width":34,"height":27},{"text":"하나가","x":593,"y":2488,"width":103,"height":40},{"text":"실패하면","x":711,"y":2489,"width":133,"height":39},{"text":"전체","x":861,"y":2490,"width":60,"height":37},{"text":"채널이","x":938,"y":2489,"width":94,"height":38},{"text":"동작하지","x":1049,"y":2488,"width":127,"height":38},{"text":"않는다.","x":1194,"y":2488,"width":105,"height":38},{"text":"또는","x":1315,"y":2490,"width":68,"height":36},{"text":"노드가","x":1398,"y":2489,"width":106,"height":38},{"text":"잘못해서","x":1519,"y":2489,"width":141,"height":39},{"text":"토큰을","x":1681,"y":2488,"width":106,"height":37},{"text":"놓아","x":1799,"y":2487,"width":63,"height":38}]},{"text":"주지 않으면, 토큰이 다시 돌 수 있도록 하는 회복 절차가 실행되어야만 한다. 수년에","words":[{"text":"주지","x":542,"y":2551,"width":66,"height":37},{"text":"않으면,","x":628,"y":2551,"width":110,"height":39},{"text":"토큰이","x":755,"y":2551,"width":98,"height":38},{"text":"다시","x":872,"y":2551,"width":60,"height":38},{"text":"돌","x":950,"y":2552,"width":34,"height":36},{"text":"수","x":996,"y":2550,"width":34,"height":38},{"text":"있도록","x":1047,"y":2550,"width":95,"height":37},{"text":"하는","x":1157,"y":2550,"width":65,"height":37},{"text":"회복","x":1237,"y":2550,"width":65,"height":38},{"text":"절차가","x":1319,"y":2551,"width":102,"height":39},{"text":"실행되어야만","x":1436,"y":2552,"width":218,"height":39},{"text":"한다.","x":1669,"y":2551,"width":79,"height":39},{"text":"수년에","x":1765,"y":2549,"width":93,"height":39}]}]}