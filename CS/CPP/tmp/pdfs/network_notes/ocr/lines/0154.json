dth":104,"height":37},{"text":"살펴","x":1824,"y":869,"width":62,"height":41}]},{"text":"보자. 송신 프로세스가 데이터의 패킷을 소켓 문밖으로 밀어내기 전에, UDP를 사용할","words":[{"text":"보자.","x":507,"y":924,"width":79,"height":37},{"text":"송신","x":602,"y":923,"width":70,"height":38},{"text":"프로세스가","x":686,"y":923,"width":181,"height":37},{"text":"데이터의","x":881,"y":923,"width":137,"height":37},{"text":"패킷을","x":1037,"y":923,"width":106,"height":38},{"text":"소켓","x":1157,"y":925,"width":69,"height":37},{"text":"문밖으로","x":1242,"y":925,"width":143,"height":37},{"text":"밀어내기","x":1402,"y":926,"width":137,"height":38},{"text":"전에,","x":1560,"y":927,"width":77,"height":36},{"text":"UDP를","x":1654,"y":928,"width":120,"height":35},{"text":"사용할","x":1789,"y":927,"width":101,"height":43}]},{"text":"때 먼저 패킷에 목적지 주소를 붙여 넣어야 한다. 이 패킷이 송신자의 소켓을 통과한","words":[{"text":"때","x":509,"y":984,"width":30,"height":37},{"text":"먼저","x":560,"y":983,"width":65,"height":38},{"text":"패킷에","x":646,"y":983,"width":104,"height":38},{"text":"목적지","x":768,"y":983,"width":103,"height":38},{"text":"주소를","x":891,"y":984,"width":107,"height":36},{"text":"붙여","x":1014,"y":983,"width":68,"height":38},{"text":"넣어야","x":1104,"y":984,"width":106,"height":38},{"text":"한다.","x":1226,"y":985,"width":79,"height":36},{"text":"이","x":1326,"y":985,"width":29,"height":36},{"text":"패킷이","x":1377,"y":985,"width":103,"height":38},{"text":"송신자의","x":1500,"y":986,"width":141,"height":38},{"text":"소켓을","x":1662,"y":987,"width":110,"height":37},{"text":"통과한","x":1788,"y":989,"width":103,"height":40}]},{"text":"후 인터넷은 이 목적지 주소를 이용하여 그 고취것을 인터넷을 통해 수신 프로세스에 있","words":[{"text":"후","x":505,"y":1046,"width":37,"height":36},{"text":"인터넷은","x":557,"y":1044,"width":140,"height":37},{"text":"이","x":713,"y":1044,"width":30,"height":37},{"text":"목적지","x":760,"y":1043,"width":104,"height":38},{"text":"주소를","x":881,"y":1044,"width":108,"height":36},{"text":"이용하여","x":1005,"y":1044,"width":137,"height":38},{"text":"그","x":1161,"y":1050,"width":34,"height":25},{"text":"고취것을","x":1212,"y":1045,"width":106,"height":36},{"text":"인터넷을","x":1334,"y":1045,"width":142,"height":37},{"text":"통해","x":1490,"y":1046,"width":69,"height":37},{"text":"수신","x":1576,"y":1047,"width":72,"height":37},{"text":"프로세스에","x":1664,"y":1047,"width":177,"height":37},{"text":"있","x":1861,"y":1053,"width":28,"height":37}]},{"text":"는 소켓으로 라우트할 것이다. 패킷이 수신 소켓에 도착하면 수신 프로세스는 소켓을","words":[{"text":"는","x":505,"y":1108,"width":36,"height":34},{"text":"소켓으로","x":555,"y":1105,"width":142,"height":37},{"text":"라우트할","x":715,"y":1104,"width":142,"height":37},{"text":"것이다.","x":875,"y":1103,"width":111,"height":38},{"text":"패킷이","x":1007,"y":1104,"width":102,"height":38},{"text":"수신","x":1128,"y":1105,"width":70,"height":37},{"text":"소켓에","x":1216,"y":1105,"width":105,"height":37},{"text":"도착하면","x":1339,"y":1105,"width":143,"height":37},{"text":"수신","x":1499,"y":1106,"width":71,"height":36},{"text":"프로세스는","x":1587,"y":1107,"width":185,"height":37},{"text":"소켓을","x":1789,"y":1109,"width":101,"height":40}]},{"text":"통해 그 패킷을 추출하고 다음에 패킷의 콘텐츠를 조사하고 적절한 동작을 취한다.","words":[{"text":"통해","x":504,"y":1166,"width":68,"height":38},{"text":"그","x":588,"y":1170,"width":35,"height":26},{"text":"패킷을","x":637,"y":1164,"width":107,"height":38},{"text":"추출하고","x":755,"y":1164,"width":143,"height":37},{"text":"다음에","x":912,"y":1164,"width":104,"height":38},{"text":"패킷의","x":1033,"y":1165,"width":102,"height":37},{"text":"콘텐츠를","x":1152,"y":1165,"width":144,"height":36},{"text":"조사하고","x":1309,"y":1165,"width":144,"height":37},{"text":"적절한","x":1469,"y":1166,"width":106,"height":36},{"text":"동작을","x":1587,"y":1167,"width":111,"height":36},{"text":"취한다.","x":1713,"y":1167,"width":115,"height":36}]},{"text":"이제 패킷에 붙여지는 목적지 주소에 무엇이 들어가는지 궁금할 것이다. 짐작하는","words":[{"text":"이제","x":574,"y":1225,"width":66,"height":38},{"text":"패킷에","x":658,"y":1224,"width":102,"height":38},{"text":"붙여지는","x":777,"y":1224,"width":144,"height":37},{"text":"목적지","x":933,"y":1225,"width":104,"height":37},{"t