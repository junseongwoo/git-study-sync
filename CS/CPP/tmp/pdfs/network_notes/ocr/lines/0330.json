804,"y":325,"width":53,"height":39}]},{"text":"한 변화가 애플리케이션 계층보니는 월쎰1 느린 속도로 일어날 것이다.","words":[{"text":"한","x":559,"y":380,"width":34,"height":36},{"text":"변화가","x":606,"y":381,"width":98,"height":36},{"text":"애플리케이션","x":715,"y":380,"width":195,"height":37},{"text":"계층보니는","x":927,"y":378,"width":162,"height":38},{"text":"월쎰1","x":1103,"y":379,"width":62,"height":36},{"text":"느린","x":1181,"y":382,"width":65,"height":35},{"text":"속도로","x":1261,"y":382,"width":102,"height":35},{"text":"일어날","x":1379,"y":382,"width":103,"height":36},{"text":"것이다.","x":1498,"y":383,"width":112,"height":37}]},{"text":"일반적인 포워딩 및 소프트웨어 기반 네트워크","words":[{"text":"일반적인","x":710,"y":557,"width":208,"height":55},{"text":"포워딩","x":941,"y":555,"width":153,"height":56},{"text":"및","x":1127,"y":557,"width":47,"height":54},{"text":"소프트웨어","x":1200,"y":560,"width":276,"height":54},{"text":"기반","x":1510,"y":561,"width":114,"height":55},{"text":"네트워크","x":1648,"y":561,"width":210,"height":54}]},{"text":"(SDN)","words":[{"text":"(SDN)","x":704,"y":625,"width":148,"height":50}]},{"text":"42.1 절에서 인터넷 라우터의 포워딩 결정이 패킷의 목적지 주소만을 기반으로 한다는","words":[{"text":"42.1","x":548,"y":745,"width":72,"height":29},{"text":"절에서","x":629,"y":742,"width":93,"height":37},{"text":"인터넷","x":739,"y":742,"width":96,"height":38},{"text":"라우터의","x":851,"y":742,"width":129,"height":38},{"text":"포워딩","x":996,"y":741,"width":93,"height":38},{"text":"결정이","x":1109,"y":741,"width":96,"height":38},{"text":"패킷의","x":1223,"y":743,"width":98,"height":38},{"text":"목적지","x":1338,"y":744,"width":100,"height":37},{"text":"주소만을","x":1456,"y":745,"width":144,"height":37},{"text":"기반으로","x":1616,"y":745,"width":138,"height":37},{"text":"한다는","x":1767,"y":745,"width":90,"height":39}]},{"text":"것을 알았다. 그러나 이전 섹션에서는 많은 3계층 기능을 수행하는 중간 상자의 확산","words":[{"text":"것을","x":551,"y":800,"width":64,"height":38},{"text":"알았다.","x":630,"y":802,"width":106,"height":38},{"text":"그러나","x":753,"y":803,"width":100,"height":37},{"text":"이전","x":869,"y":803,"wi