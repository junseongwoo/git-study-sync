":"애플리케이션","x":472,"y":1301,"width":202,"height":38},{"text":"프로세스에게","x":691,"y":1301,"width":198,"height":37},{"text":"직접","x":910,"y":1301,"width":61,"height":37},{"text":"통신","x":990,"y":1302,"width":66,"height":37},{"text":"서비스를","x":1075,"y":1302,"width":134,"height":37},{"text":"제공하는","x":1225,"y":1301,"width":135,"height":37},{"text":"중요한","x":1375,"y":1301,"width":104,"height":37}]},{"text":"기능을 갖는다. 이 장에서 택한 학습법은 트랜스포트 계층 원리와 이들 원리가 기존 프","words":[{"text":"기능을","x":166,"y":1360,"width":98,"height":38},{"text":"갖는다.","x":277,"y":1362,"width":110,"height":37},{"text":"이","x":405,"y":1363,"width":29,"height":37},{"text":"장에서","x":451,"y":1364,"width":99,"height":37},{"text":"택한","x":569,"y":1363,"width":68,"height":37},{"text":"학습법은","x":648,"y":1362,"width":136,"height":37},{"text":"트랜스포트","x":795,"y":1362,"width":168,"height":37},{"text":"계층","x":977,"y":1363,"width":66,"height":39},{"text":"원리와","x":1057,"y":1364,"width":101,"height":37},{"text":"이들","x":1171,"y":1364,"width":66,"height":36},{"text":"원리가","x":1250,"y":1363,"width":102,"height":37},{"text":"기존","x":1366,"y":1362,"width":66,"height":38},{"text":"프","x":1444,"y":1366,"width":34,"height":28}]},{"text":"로토골에서 어떻게 구현되어 있는지를 번갈아 살펴보는 것이다. 특히 인터넷 프로토콜","words":[{"text":"로토골에서","x":165,"y":1424,"width":162,"height":37},{"text":"어떻게","x":347,"y":1424,"width":100,"height":39},{"text":"구현되어","x":462,"y":1425,"width":135,"height":38},{"text":"있는지를","x":617,"y":1424,"width":133,"height":39},{"text":"번갈아","x":765,"y":1424,"width":99,"height":38},{"text":"살펴보는","x":876,"y":1425,"width":135,"height":37},{"text":"것이다.","x":1024,"y":1426,"width":107,"height":37},{"text":"특히","x":1146,"y":1425,"width":64,"height":38},{"text":"인터넷","x":1229,"y":1425,"width":98,"height":37},{"text":"프로토콜","x":1342,"y":1427,"width":137,"height":35}]},{"text":"중에서 TCP와 UDP 트랜스포트 계층 프로토콜에 중점을 둘 것이다.","words":[{"text":"중에서","x":164,"y":1485,"width":95,"height":38},{"text":"TCP와","x":274,"y":1486,"width":110,"height":38},{"text":"UDP","x":396,"y":1491,"width":79,"height":29},{"text":"트랜스포트","x":488,"y":1487,"width":172,"height":37},{"text":"계층","x":674,"y":1487,"width":66,"height":37},{"text":"프로토콜에","x":752,"y":1487,"width":165,"height":38},{"text":"중점을","x":932,"y":1487,"width":101,"height":38},{"text":"둘","x":1045,"y":1489,"width":34,"height":36},{"text":"것이다.","x":1093,"y":1488,"width":107,"height":38}]},{"text":"먼저 트랜스포트 계층과 네트워크 계층 간의 관계를 논의하는 것부터 시작하겠","words":[{"text":"먼저","x":245,"y":1548,"width":62,"height":38},{"text":"트랜스포트","x":328,"y":1549,"width":174,"height":36},{"text":"계층과","x":521,"y":1549,"width":102,"height":38},{"text":"네트워크","x":640,"y":1548,"width":133,"height":38},{"text":"계층","x":792,"y":1549,"width":66,"height":37},{"text":"간의","x":873,"y":1549,"width":63,"height":37},{"text":"관계를","x":956,"y":1549,"width":101,"height":38},{"text":"논의하는","x":1072,"y":1550,"width":136,"height":37},{"text":"것부터","x":1226,"y":1549,"width":95,"height":38},{"text":"시작하겠","x":1343,"y":1549,"width":136,"height":38}]},{"text":"다. 이것은 트랜스포트 계층의 첫 번째 중요한 기능을 살펴보기 위한 단계이다. 즉, 양","words":[{"text":"다.","x":166,"y":1609,"width":37,"height":39},{"text":"이것은","x":220,"y":1610,"width":102,"height":39},{"text":"트랜스포트","x":335,"y":1610,"width":174,"height":37},{"text":"계층의","x":525,"y":1611,"width":98,"height":38},{"text":"첫","x":643,"y":1610,"width":30,"height":38},{"text":"번째","x":690,"y":1610,"width":63,"height":38},{"text":"중요한","x":769,"y":1610,"width":102,"height":38},{"text":"기능을","x":885,"y":1611,"width":100,"height":38},{"text":"살펴보기","x":998,"y":1612,"width":130,"height":37},{"text":"위한","x":1147,"y":1611,"width":67,"height":38},{"text":"단계이다.","x":1228,"y":1612,"width":143,"height":37},{"text":"즉,","x":1387,"y":1614,"width":44,"height":35},{"text":"양","x":1448,"y":1612,"width":33,"height":38}]},{"text":"쪽 종단 시스템 간의 네트워크 계층 전달 서비스를 종단 시스템에서 동작하는 2개의","words":[{"text":"쪽","x":164,"y":1674,"width":32,"height":36},{"text":"종단","x":211,"y":1673,"width":68,"height":37},{"text":"시스템","x":296,"y":1673,"width":99,"height":38},{"text":"간의","x":416,"y":1673,"width":65,"height":37},{"text":"네트워크","x":504,"y":1672,"width":135,"height":38},{"text":"계층","x":657,"y":1672,"width":67,"height":38},{"text":"전달","x":741,"y":1672,"width":66,"height":37},{"text":"서비스를","x":823,"y":1672,"width":133,"height":38},{"text":"종단","x":971,"y":1673,"width":68,"height":37},{"text":"시스템에서","x":1055,"y":1673,"width":163,"height":39},{"text":"동작하는","x":1238,"y":1674,"width":138,"height":38},{"text":"2개의","x":1392,"y":1674,"width":85,"height":38}]},{"text":"애플리게이션 계층 프로세스들 사이의 전달 서비스로 확장한다. 이 장에서는 인터넷의","words":[{"text":"애플리게이션","x":165,"y":1734,"width":200,"height":39},{"text":"계층","x":382,"y":1735,"width":69,"height":38},{"text":"프로세스들","x":464,"y":1735,"width":173,"height":37},{"text":"사이의","x":650,"y":1734,"width":98,"height":38},{"text":"전달","x":766,"y":1734,"width":65,"height":37},{"text":"서비스로","x":845,"y":1734,"width":133,"height":38},{"text":"확장한다.","x":990,"y":1735,"width":142,"height":38},{"text":"이","x":1149,"y":1736,"width":27,"height":37},{"text":"장에서는","x":1193,"y":1736,"width":137,"height":38},{"text":"인터넷의","x":1345,"y":1736,"width":133,"height":38}]},{"text":"비연결형 트랜스포트 프로토콜인 UDP의 적용 범위에서 이 기능을 설명하겠다.","words":[{"text":"비연결형","x":166,"y":1796,"width":126,"height":39},{"text":"트랜스포트","x":309,"y":1797,"width":176,"height":36},{"text":"프로토콜인","x":498,"y":1797,"width":172,"height":36},{"text":"UDP의","x":683,"y":1796,"width":108,"height":38},{"text":"적용","x":808,"y":1796,"width":66,"height":37},{"text":"범위에서","x":887,"y":1797,"width":128,"height":38},{"text":"이","x":1033,"y":1797,"width":27,"height":38},{"text":"기능을","x":1079,"y":1798,"width":99,"height":38},{"text":"설명하겠다.","x":1190,"y":1798,"width":177,"height":38}]},{"text":"그 다음은 다시 원리로 돌아가서 컴퓨터 네트워킹에서의 가장 기본 문제를 다룬","words":[{"text":"그","x":242,"y":1864,"width":33,"height":25},{"text":"다음은","x":291,"y":1859,"width":104,"height":38},{"text":"다시","x":410,"y":1859,"width":65,"height":38},{"text":"원리로","x":497,"y":1858,"width":102,"height":38},{"text":"돌아가서","x":614,"y":1859,"width":133,"height":37},{"text":"컴퓨터","x":768,"y":1857,"width":93,"height":38},{"text":"네트워킹에서의","x":882,"y":1858,"width":229,"height":39},{"text":"가장","x":1130,"y":1860,"width":68,"height":38},{"text":"기본","x":1213,"y":1860,"width":66,"height":37},{"text":"문제를","x":1293,"y":1860,"width":105,"height":37},{"text":"다룬","x":1415,"y":1860,"width":67,"height":38}]},{"text":"다. 즉, 데이터 손실이나 손상이 일어날 수 있는 매체에서 어떻게 두 개체가 신뢰적으","words":[{"text":"다.","x":164,"y":1920,"width":38,"height":37},{"text":"즉,","x":218,"y":1922,"width":41,"height":36},{"text":"데이터","x":278,"y":1921,"width":98,"height":38},{"text":"손실이나","x":396,"y":1920,"width":141,"height":39},{"text":"손상이","x":552,"y":1920,"width":100,"height":39},{"text":"일어날","x":673,"y":1920,"width":100,"height":38},{"text":"수","x":786,"y":1920,"width":34,"height":38},{"text":"있는","x":836,"y":1919,"width":65,"height":38},{"text":"매체에서","x":916,"y":1920,"width":128,"height":39},{"text":"어떻게","x":1065,"y":1921,"width":95,"height":39},{"text":"두","x":1177,"y":1924,"width":33,"height":35},{"text":"개체가","x":1227,"y":1922,"width":101,"height":37},{"text":"신뢰적으","x":1344,"y":1921,"width":137,"height":39}]},{"text":"로 통신할 수 있는지 에 대한 문제를 다룬다. 점점 복잡하고 현실적인 시나리오들을 통","words":[{"text":"로","x":163,"y":1986,"width":31,"height":28},{"text":"통신할","x":207,"y":1983,"width":102,"height":38},{"text":"수","x":321,"y":1984,"width":36,"height":37},{"text":"있는지","x":372,"y":1983,"width":99,"height":38},{"text":"에","x":490,"y":1983,"width":31,"height":38},{"text":"대한","x":538,"y":1983,"width":69,"height":38},{"text":"문제를","x":619,"y":1983,"width":103,"height":38},{"text":"다룬다.","x":736,"y":1982,"width":105,"height":39},{"text":"점점","x":858,"y":1982,"width":62,"height":38},{"text":"복잡하고","x":936,"y":1983,"width":133,"height":38},{"text":"현실적인","x":1082,"y":1984,"width":132,"height":37},{"text":"시나리오들을","x":1229,"y":1984,"width":206,"height":38},{"text":"통","x":1447,"y":1987,"width":34,"height":36}]},{"text":"해서, 트랜스포트 프로토콜이 이러한 문제를 해결하기 위해서 久卜\u0026하는 기술을 확립해","words":[{"text":"해서,","x":164,"y":2045,"width":71,"height":39},{"text":"트랜스포트","x":250,"y":2046,"width":175,"height":37},{"text":"프로토콜이","x":440,"y":2045,"width":170,"height":39},{"text":"이러한","x":630,"y":2046,"width":101,"height":38},{"text":"문제를","x":743,"y":2045,"width":100,"height":38},{"text":"해결하기","x":857,"y":2045,"width":129,"height":40},{"text":"위해서","x":1004,"y":2046,"width":93,"height":39},{"text":"久卜\u0026하는","x":1115,"y":2046,"width":134,"height":39},{"text":"기술을","x":1264,"y":2046,"width":101,"height":39},{"text":"확립해","x":1377,"y":2047,"width":101,"height":39}]},{"text":"나갈 것이다. 그리고 이들 원리가 인터넷의 연결지향형 트랜스포트 프로토콜인 TCP에","words":[{"text":"나갈","x":163,"y":2108,"width":66,"height":39},{"text":"것이다.","x":242,"y":2109,"width":109,"height":39},{"text":"그리고","x":368,"y":2109,"width":106,"height":39},{"text":"이들","x":488,"y":2109,"width":69,"height":39},{"text":"원리가","x":571,"y":2109,"width":104,"height":39},{"text":"인터넷의","x":689,"y":2108,"width":129,"height":40},{"text":"연결지향형","x":836,"y":2108,"width":160,"height":40},{"text":"트랜스포트","x":1013,"y":2110,"width":166,"height":37},{"text":"프로토콜인","x":1192,"y":2109,"width":167,"height":37},{"text":"TCP에","x":1373,"y":2110,"width":105,"height":38}]},{"text":"서 어떻게 구현되어 있는지를 살펴본다.","words":[{"text":"서","x":163,"y":2172,"width":27,"height":39},{"text":"어떻게","x":208,"y":2173,"width":97,"height":39},{"text":"구현되어","x":322,"y":2173,"width":137,"height":38},{"text":"있는지를","x":480,"y":2172,"width":138,"height":39},{"text":"살펴본다.","x":630,"y":2172,"width":145,"height":39}]},{"text":"그 다음에는 네트워킹 내부의 두 번째 중요한 기본 문제, 즉 네트워크 내부의 혼","words":[{"text":"그","x":241,"y":2242,"width":33,"height":26},{"text":"다음에는","x":290,"y":2237,"width":141,"height":38},{"text":"네트워킹","x":448,"y":2235,"width":135,"height":39},{"text":"내부의","x":604,"y":2235,"width":99,"height":39},{"text":"두","x":721,"y":2238,"width":34,"height":36},{"text":"번째","x":771,"y":2234,"width":62,"height":39},{"text":"중요한","x":850,"y":2235,"width":100,"height":38},{"text":"기본","x":965,"y":2236,"width":65,"height":38},{"text":"문제,","x":1044,"y":2236,"width":73,"height":37},{"text":"즉","x":1132,"y":2237,"width":34,"height":36},{"text":"네트워크","x":1182,"y":2235,"width":133,"height":38},{"text":"내부의","x":1331,"y":2234,"width":98,"height":39},{"text":"혼","x":1447,"y":2236,"width":34,"height":36}]},{"text":"잡을 피하거나 복구하기 위해서 트랜스포트 계층 개체들의 전송률을 제어하는 문제로","words":[{"text":"잡을","x":163,"y":2299,"width":66,"height":40},{"text":"피하거나","x":244,"y":2300,"width":139,"height":40},{"text":"복구하기","x":397,"y":2299,"width":138,"height":39},{"text":"위해서","x":556,"y":2298,"width":99,"height":39},{"text":"트랜스포트","x":674,"y":2299,"width":169,"height":37},{"text":"계층","x":858,"y":2297,"width":64,"height":39},{"text":"개체들의","x":938,"y":2298,"width":126,"height":39},{"text":"전송률을","x":1082,"y":2298,"width":133,"height":38},{"text":"제어하는","x":1229,"y":2297,"width":136,"height":39},{"text":"문제로","x":1378,"y":2297,"width":103,"height":38}]},{"text":"옮겨 갈 것이다. 우리는 일반적으로 사용되는 혼잡제어 기술뿐만 아니라, 혼잡 원인과","words":[{"text":"옮겨","x":162,"y":2363,"width":62,"height":40},{"text":"갈","x":243,"y":2364,"width":35,"height":39},{"text":"것이다.","x":293,"y":2364,"width":112,"height":39},{"text":"우리는","x":423,"y":2363,"width":107,"height":39},{"text":"일반적으로","x":547,"y":2361,"width":173,"height":39},{"text":"사용되는","x":733,"y":2361,"width":135,"height":39},{"text":"혼잡제어","x":880,"y":2360,"width":128,"height":39},{"text":"기술뿐만","x":1027,"y":2360,"width":131,"height":38},{"text":"아니라,","x":1172,"y":2360,"width":109,"height":38},{"text":"혼잡","x":1297,"y":2359,"width":68,"height":38},{"text":"원인과","x":1380,"y":2359,"width":102,"height":38}]},{"text":"영향까지 고려할 것이다. 혼잡제어 이면의 문제들에 대해서 충분히 이해한 후에는","words":[{"text":"영향까지","x":165,"y":2427,"width":132,"height":40},{"text":"고려할","x":320,"y":2427,"width":110,"height":40},{"text":"것이다.","x":450,"y":2425,"width":115,"height":41},{"text":"혼잡제어","x":585,"y":2424,"width":139,"height":39},{"text"