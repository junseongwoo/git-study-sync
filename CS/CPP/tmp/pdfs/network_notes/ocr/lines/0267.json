text":"신뢰적인","x":1591,"y":992,"width":137,"height":38},{"text":"전달,","x":1745,"y":992,"width":69,"height":39},{"text":"지","x":1830,"y":997,"width":23,"height":38}]},{"text":"연 보장, 대역폭 보장과 같은 다양한 보장을 애플리케이션에게 제공할 수 있다. 그럼에","words":[{"text":"연","x":547,"y":1051,"width":29,"height":37},{"text":"보장,","x":590,"y":1051,"width":76,"height":38},{"text":"대역폭","x":682,"y":1051,"width":100,"height":38},{"text":"보장과","x":794,"y":1051,"width":103,"height":38},{"text":"같은","x":909,"y":1051,"width":67,"height":37},{"text":"다양한","x":989,"y":1051,"width":101,"height":37},{"text":"보장을","x":1102,"y":1051,"width":103,"height":37},{"text":"애플리케이션에게","x":1219,"y":1052,"width":273,"height":38},{"text":"제공할","x":1510,"y":1052,"width":104,"height":38},{"text":"수","x":1626,"y":1054,"width":36,"height":37},{"text":"있다.","x":1678,"y":1053,"width":73,"height":38},{"text":"그럼에","x":1766,"y":1055,"width":89,"height":41}]},{"text":"도 뚜구하고 트랜스포트 프로토콜이 제공할 수 있는 서비스는 하위의 네트워크 계층","words":[{"text":"도","x":543,"y":1117,"width":34,"height":27},{"text":"뚜구하고","x":592,"y":1112,"width":137,"height":38},{"text":"트랜스포트","x":744,"y":1112,"width":169,"height":37},{"text":"프로토콜이","x":929,"y":1111,"width":165,"height":38},{"text":"제공할","x":1115,"y":1111,"width":102,"height":39},{"text":"수","x":1232,"y":1112,"width":35,"height":37},{"text":"있는","x":1285,"y":1112,"width":67,"height":38},{"text":"서비스는","x":1369,"y":1113,"width":139,"height":38},{"text":"하위의","x":1525,"y":1113,"width":101,"height":38},{"text":"네트워크","x":1648,"y":1114,"width":135,"height":38},{"text":"계층","x":1800,"y":1116,"width":57,"height":40}]},{"text":"프로토콜의 서비스 모델에 의해 제한된다. 만약 네트워크 계층 프로토콜이 트랜스포트","words":[{"text":"프로토콜의","x":543,"y":1174,"width":166,"height":37},{"text":"서비스","x":726,"y":1174,"width":100,"height":37},{"text":"모델에","x":839,"y":1174,"width":98,"height":37},{"text":"의해","x":954,"y":1173,"width":64,"height":38},{"text":"제한된다.","x":1033,"y":1173,"width":143,"height":37},{"text":"만약","x":1192,"y":1173,"width":69,"height":37},{"text