34,"height":36},{"text":"있다.","x":488,"y":1067,"width":71,"height":36},{"text":"다음","x":577,"y":1068,"width":68,"height":36},{"text":"두","x":658,"y":1070,"width":33,"height":35},{"text":"번의","x":707,"y":1069,"width":63,"height":37},{"text":"실험값은","x":788,"y":1068,"width":136,"height":37},{"text":"0.48","x":937,"y":1071,"width":68,"height":29},{"text":"msec와","x":1021,"y":1066,"width":117,"height":36},{"text":"0.45","x":1150,"y":1070,"width":67,"height":29},{"text":"msec이다","x":1233,"y":1066,"width":154,"height":37},{"text":"이들","x":1404,"y":1065,"width":67,"height":37}]},{"text":"왕복 지연은 전송 지연, 전파 지연, 라우터 처리 지연, 큐잉 지연 등-을 포함해서 앞서","words":[{"text":"왕복","x":150,"y":1125,"width":67,"height":36},{"text":"지연은","x":235,"y":1125,"width":99,"height":36},{"text":"전송","x":351,"y":1126,"width":65,"height":36},{"text":"지연,","x":434,"y":1126,"width":72,"height":37},{"text":"전파","x":526,"y":1127,"width":67,"height":36},{"text":"지연,","x":610,"y":1127,"width":74,"height":37},{"text":"라우터","x":703,"y":1128,"width":96,"height":36},{"text":"처리","x":822,"y":1127,"width":62,"height":37},{"text":"지연,","x":906,"y":1126,"width":74,"height":37},{"text":"큐잉","x":998,"y":1125,"width":65,"height":37},{"text":"지연","x":1085,"y":1125,"width":66,"height":37},{"text":"등-을","x":1168,"y":1126,"width":69,"height":36},{"text":"포함해서","x":1252,"y":1125,"width":132,"height":37},{"text":"앞서","x":1403,"y":1125,"width":62,"height":36}]},{"text":"논의한 모든 지연을 포함한다. 큐잉 지연은 시간에 따라 변하므로, n번 라우터로 보내","words":[{"text":"논의한","x":149,"y":1184,"width":102,"height":37},{"text":"모든","x":265,"y":1187,"width":67,"height":33},{"text":"지연을","x":348,"y":1185,"width":99,"height":37},{"text":"포함한다.","x":461,"y":1186,"width":143,"height":37},{"text":"큐잉","x":621,"y":1187,"width":64,"height":37},{"text":"지연은","x":706,"y":1187,"width":101,"height":36},{"text":"시간에","x":822,"y":1186,"width":99,"height":37},{"text":"따라","x":939,"y":1185,"width":70,"height":38},{"text":"변하므로,","x":1024,"y":1185,"width":145,"height":37},{"text":"n번","