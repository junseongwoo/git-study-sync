26,"y":2121,"width":95,"height":38},{"text":"저장한다.","x":340,"y":2121,"width":143,"height":38},{"text":"해당","x":501,"y":2121,"width":68,"height":38},{"text":"애플리케이션","x":585,"y":2120,"width":199,"height":39},{"text":"프로세스는","x":800,"y":2121,"width":166,"height":38},{"text":"버퍼에서","x":982,"y":2121,"width":129,"height":39},{"text":"데이터를","x":1131,"y":2122,"width":136,"height":39},{"text":"읽지만,","x":1284,"y":2122,"width":108,"height":38},{"text":"데이","x":1409,"y":2122,"width":63,"height":39}]},{"text":"터가 도달한 시점에서 읽어야 할 필요는 없다. 사실 수신하는 애플리케이션은 다른 작","words":[{"text":"터가","x":179,"y":2183,"width":64,"height":38},{"text":"도달한","x":256,"y":2183,"width":101,"height":37},{"text":"시점에서","x":371,"y":2183,"width":131,"height":38},{"text":"읽어야","x":522,"y":2182,"width":100,"height":39},{"text":"할","x":635,"y":2182,"width":35,"height":38},{"text":"필요는","x":683,"y":2183,"width":100,"height":37},{"text":"없다.","x":797,"y":2183,"width":71,"height":38},{"text":"사실","x":883,"y":2182,"width":65,"height":39},{"text":"수신하는","x":961,"y":2183,"width":136,"height":38},{"text":"애플리케이션은","x":1111,"y":2184,"width":238,"height":38},{"text":"다른","x":1362,"y":2183,"width":68,"height":38},{"text":"작","x":1443,"y":2184,"width":35,"height":38}]},{"text":"업으로 바쁠 것이고, 오랜 시간 동안 데이터를 읽지 않을 것이다. 애플리케이션이 데이","words":[{"text":"업으로","x":180,"y":2245,"width":95,"height":37},{"text":"바쁠","x":288,"y":2245,"width":67,"height":37},{"text":"것이고,","x":370,"y":2244,"width":109,"height":39},{"text":"오랜","x":493,"y":2244,"width":68,"height":38},{"text":"시간","x":574,"y":2244,"width":68,"height":39},{"text":"동안","x":652,"y":2244,"width":70,"height":39},{"text":"데이터를","x":734,"y":2244,"width":132,"height":40},{"text":"읽지","x":880,"y":2244,"width":60,"height":38},{"text":"않을","x":956,"y":2244,"width":67,"height":39},{"text":"것이다.","x":1036,"y":2245,"width":107,"height":39},{"text":"애플리케이션이","x":1159,"y":2245,"width":233,"height":38},{"text":"데이","x":1410,"y":2245,"width":63,"height":38}]},{"text":"터를 읽는 속도가 비교적 느리다면, 송신자가 점점 더 많은 데이터를 빠르게 전송함으","words":[{"text":"터를","x":179,"y":2307,"width":63,"height":38},{"text":"읽는","x":257,"y":2306,"width":65,"height":38},{"text":"속도가","x":335,"y":2306,"width":104,"height":39},{"text":"비교적","x":453,"y":2306,"width":97,"height":39},{"text":"느리다면,","x":567,"y":2306,"width":144,"height":40},{"text":"송신자가","x":725,"y":2306,"width":134,"height":39},{"text":"점점","x":872,"y":2306,"width":61,"height":38},{"text":"더","x":951,"y":2305,"width":27,"height":39},{"text":"많은","x":996,"y":2306,"width":68,"height":39},{"text":"데이터를","x":1077,"y":2307,"width":135,"height":38},{"text":"빠르게","x":1225,"y":2306,"width":99,"height":39},{"text":"전송함으","x":1342,"y":2306,"width":136,"height":39}]},{"text":"로써 연결의 수신 버퍼에 아주 쉽게 오버플로를 발생시킨다.","words":[{"text":"로써","x":177,"y":2368,"width":61,"height":38},{"text":"연결의","x":256,"y":2368,"width":96,"height":38},{"text":"수신","x":366,"y":2368,"width":69,"height":38},{"text":"버퍼에","x":450,"y":2368,"width":98,"height":38},{"text":"아주","x":563,"y":2369,"width":69,"height":38},{"text":"쉽게","x":643,"y":2369,"width":64,"height":38},{"text":"오버플로를","x":721,"y":2368,"width":166,"height":38},{"text":"발생시킨다.","x":898,"y":2367,"width":174,"height":39}]},{"text":"이처럼 TCP는 송신자가 수신자의 버퍼를 오버플로 시기는 것을 방지하기 위해서","words":[{"text":"이처럼","x":242,"y":2429,"width":94,"height":39},{"text":"TCP는","x":353,"y":2432,"width":109,"height":35},{"text":"송신자가","x":474,"y":2430,"width":139,"height":39},{"text":"수신자의","x":624,"y":2429,"width":131,"height":40},{"text":"버퍼를","x":774,"y":2429,"width":97,"height":38},{"text":"오버플로","x":883,"y":2429,"width":133,"height":38},{"text":"시기는","x":1030,"y":2430,"width":101,"height":38},{"text":"것을","x":1145,"y":2430,"width":67,"height":39},{"text":"방지하기","x":1226,"y":2430,"width":131,"height":38},{"text":"위해서","x":1377,"y":2429,"width":97,"height":39}]},{"text":"애플리케이션에게 호름제어 서비스(flow-control service)를 제공한다. 이같이 호름제","words":[{"text":"애플리케이션에게","x":178,"y":2491,"width":265,"height":39},{"text":"호름제어","x":459,"y":2492,"width":134,"height":38},{"text":"서비스(flow-control","x":610,"y":2492,"width":305,"height":38},{"text":"service)를","x":927,"y":2493,"width":161,"height":37},{"text":"제공한다.","x":1101,"y":2492,"width":142,"height":38},{"text":"이같이","x":1261,"y":2490,"width":97,"height":39},{"text":"호름제","x":1376,"y":2491,"width":99,"height":37}]},{"text":"어는 속도를 일치시기는 서비스이다. 수신하는 애플리케이션이 읽는 속도와 송신자가","words":[{"text":"어는","x":178,"y":2553,"width":64,"height":37},{"text":"속도를","x":255,"y":2553,"width":102,"height":36},{"text":"일치시기는","x":373,"y":2552,"width":171,"height":39},{"text":"서비스이다.","x":558,"y":2552,"width":176,"height":39},{"text":"수신하는","x":749,"y":2552,"width":133,"height":38},{"text":"애플리케이션이","x":895,"y":2552,"width":229,"height":39},{"text":"읽는","x":1145,"y":2553,"width":66,"height":37},{"text":"속도와","x":1224,"y":2552,"width":104,"height":37},{"text":"송신자가","x":1341,"y":2550,"width":138,"height":39}]},{"text":"전송하는 속도를 같게 한다. 앞에서 언급했듯이 TCP 송신자는 IP 네트워크에서 혼잡","words":[{"text":"전송하는","x":179,"y":2613,"width":130,"height":37},{"text":"속도를","x":322,"y":2614,"width":105,"height":36},{"text":"같게","x":441,"y":2614,"width":65,"height":37},{"text":"한다.","x":522,"y":2614,"width":77,"height":37},{"text":"앞에서","x":617,"y":2613,"width":98,"height":39},{"text":"언급했듯이","x":733,"y":2612,"width":160,"height":39},{"text":"TCP","x":907,"y":2616,"width":72,"height":30},{"text":"송신자는","x":992,"y":2613,"width":136,"height":38},{"text":"IP","x":1141,"y":2618,"width":35,"height":28},{"text":"네트워크에서","x":1192,"y":2612,"width":200,"height":39},{"text":"혼잡","x":1408,"y":2612,"width":70,"height":36}]},{"text":"231","words":[{"text":"231","x":1747,"y":142,"width":67,"height":36}]}]}