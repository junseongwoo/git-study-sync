27}]},{"text":"이면 ACK는 이전에 확인응답 안 된 하나 이상의 세그먼트들을 확인해 준다. 따라서","words":[{"text":"이면","x":185,"y":2561,"width":61,"height":36},{"text":"ACK는","x":262,"y":2562,"width":112,"height":33},{"text":"이전에","x":390,"y":2560,"width":98,"height":37},{"text":"확인응답","x":506,"y":2560,"width":137,"height":36},{"text":"안","x":658,"y":2560,"width":33,"height":36},{"text":"된","x":705,"y":2562,"width":32,"height":35},{"text":"하나","x":753,"y":2562,"width":68,"height":38},{"text":"이상의","x":835,"y":2562,"width":93,"height":38},{"text":"세그먼트들을","x":945,"y":2563,"width":201,"height":37},{"text":"확인해","x":1160,"y":2565,"width":100,"height":37},{"text":"준다.","x":1277,"y":2564,"width":76,"height":37},{"text":"따라서","x":1371,"y":2565,"width":96,"height":37}]},{"text":"225","words":[{"text":"225","x":1749,"y":141,"width":75,"height":38}]}]}