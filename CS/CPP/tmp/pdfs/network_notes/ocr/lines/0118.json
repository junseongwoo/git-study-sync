12,"y":2183,"width":74,"height":36},{"text":"앨리스의","x":702,"y":2181,"width":127,"height":37},{"text":"반송주소,","x":845,"y":2182,"width":138,"height":37},{"text":"날짜","x":998,"y":2182,"width":67,"height":37},{"text":"등의","x":1076,"y":2183,"width":63,"height":37},{"text":"여러","x":1157,"y":2183,"width":60,"height":37},{"text":"가지","x":1235,"y":2183,"width":61,"height":38},{"text":"주변","x":1312,"y":2183,"width":65,"height":37},{"text":"정보가","x":1393,"y":2184,"width":100,"height":37},{"text":"적힌다.","x":1506,"y":2183,"width":105,"height":38},{"text":"마찬가지로,","x":1627,"y":2184,"width":174,"height":38},{"text":"전","x":1817,"y":2186,"width":28,"height":35}]},{"text":"자메일을 보낼 때도 주변 정보가 포함된 헤더가 메시지 몸체 앞에 오게 된다. 이 주변","words":[{"text":"자메일을","x":567,"y":2241,"width":132,"height":39},{"text":"보낼","x":713,"y":2241,"width":64,"height":36},{"text":"때도","x":794,"y":2241,"width":64,"height":37},{"text":"주변","x":871,"y":2242,"width":64,"height":37},{"text":"정보가","x":952,"y":2242,"width":98,"height":37},{"text":"포함된","x":1063,"y":2242,"width":98,"height":38},{"text":"헤더가","x":1177,"y":2243,"width":99,"height":37},{"text":"메시지","x":1290,"y":2243,"width":95,"height":37},{"text":"몸체","x":1403,"y":2243,"width":64,"height":38},{"text":"앞에","x":1485,"y":2243,"width":62,"height":38},{"text":"오게","x":1564,"y":2243,"width":63,"height":37},{"text":"된다.","x":1645,"y":2244,"width":72,"height":37},{"text":"이","x":1736,"y":2244,"width":27,"height":37},{"text":"주변","x":1782,"y":2245,"width":63,"height":37}]},{"text":"정보는 일련의 헤더 라인에 포함되는데 RFC 5322에 정의되어 있다. 헤더 라인과 메시","words":[{"text":"정보는","x":568,"y":2302,"width":98,"height":37},{"text":"일련의","x":680,"y":2301,"width":94,"height":37},{"text":"헤더","x":790,"y":2302,"width":60,"height":37},{"text":"라인에","x":868,"y":2301,"width":93,"height":38},{"text":"포함되는데","x":976,"y":2301,"width":161,"height":39},{"text":"RFC","x":1152,"y":2307,"width":70,"height":29},{"text":"5322에","x":1235,"y":2303,"width":107,"height":38},{"text":"정의되어","x":1358,"y":2304,"width":129,"height":37},{"text":"있다.","x":1505,"y":2304,"width":70,"height":38},{"text":"헤더","x":1591,"y":2304,"width":61,"height":37},{"text":"라인과","x":1670,"y":2305,"width":100,"height":36},{"text":"메시","x":1783,"y":2305,"width":59,"height":37}]},{"text":"지 몸체는 빈 줄(CRLF)로 분리된다. RFC 5322는 메일 헤더 라인에 대한 정확한 포맷","words":[{"text":"지","x":567,"y":2362,"width":27,"height":37},{"text":"몸체는","x":611,"y":2361,"width":101,"height":37},{"text":"빈","x":726,"y":2361,"width":29,"height":36},{"text":"줄(CRLF)로","x":769,"y":2363,"width":180,"height":37},{"text":"분리된다.","x":961,"y":2361,"width":138,"height":38},{"text":"RFC","x":1114,"y":2367,"width":70,"height":28},{"text":"5322는","x":1197,"y":2365,"width":109,"height":34},{"text":"메일","x":1319,"y":2363,"width":63,"height":37},{"text":"헤더","x":1398,"y":2364,"width":62,"height":37},{"text":"라인에","x":1479,"y":2364,"width":95,"height":37},{"text":"대한","x":1591,"y":2364,"width":65,"height":37},{"text":"정확한","x":1669,"y":2364,"width":100,"height":37},{"text":"포맷","x":1782,"y":2365,"width":62,"height":36}]},{"text":"과 그들의 의미에 대한 해석을 기술하고 있다. HTTP에서처럼 각 헤더 라인은 기워드,","words":[{"text":"과","x":565,"y":2422,"width":34,"height":38},{"text":"그들의","x":612,"y":2421,"width":97,"height":38},{"text":"의미에","x":727,"y":2422,"width":95,"height":37},{"text":"대한","x":839,"y":2422,"width":64,"height":37},{"text":"해석을","x":917,"y":2421,"width":96,"height":38},{"text":"기술하고","x":1028,"y":2422,"width":128,"height":37},{"text":"있다.","x":1171,"y":2422,"width":70,"height":37},{"text":"HTTP에서처럼","x":1257,"y":2423,"width":225,"height":37},{"text":"각","x":1500,"y":2423,"width":33,"height":37},{"text":"헤더","x":1546,"y":2424,"width":61,"height":37},{"text":"라인은","x":1626,"y":2424,"width":99,"height":37},{"text":"기워드,","x":1740,"y":2424,"width":105,"height":37}]},{"text":"콜론, 값의 순서로 구성되고 읽을 수 있는 텍스트를 포함한다. 기우니드 중 반드시 필요","words":[{"text":"콜론,","x":564,"y":2483,"width":75,"height":37},{"text":"값의","x":656,"y":2481,"width":64,"height":39},{"text":"순서로","x":737,"y":2483,"width"