6},{"text":"꼭","x":739,"y":501,"width":32,"height":33},{"text":"필요하다고","x":785,"y":498,"width":162,"height":36},{"text":"확신해야","x":960,"y":496,"width":132,"height":37},{"text":"한다.","x":1105,"y":496,"width":73,"height":36},{"text":"예를","x":1195,"y":497,"width":66,"height":36},{"text":"들이,","x":1273,"y":497,"width":77,"height":36},{"text":"그림","x":1365,"y":497,"width":63,"height":36},{"text":"3.23에서","x":1445,"y":495,"width":133,"height":37},{"text":"송신자와","x":1595,"y":495,"width":141,"height":37},{"text":"수신자","x":1748,"y":496,"width":96,"height":40}]},{"text":"의 순서번호 공간이 주어지면, 수신자가 송신자에게 전파하는 send_base 패것에 대","words":[{"text":"의","x":549,"y":558,"width":29,"height":35},{"text":"순서번호","x":592,"y":558,"width":131,"height":35},{"text":"공간이","x":735,"y":556,"width":95,"height":38},{"text":"주어지면,","x":845,"y":556,"width":139,"height":37},{"text":"수신자가","x":998,"y":554,"width":134,"height":37},{"text":"송신자에게","x":1143,"y":555,"width":167,"height":37},{"text":"전파하는","x":1328,"y":555,"width":134,"height":37},{"text":"send_base","x":1476,"y":560,"width":210,"height":36},{"text":"패것에","x":1703,"y":553,"width":97,"height":37},{"text":"대","x":1816,"y":559,"width":24,"height":34}]},{"text":"한 ACK가 없다면, 수신자가 그 패킷을 이미 수신했음이(송신자가 아닌 여러분에거l)","words":[{"text":"한","x":546,"y":616,"width":34,"height":36},{"text":"ACK가","x":594,"y":616,"width":112,"height":36},{"text":"없다면,","x":723,"y":616,"width":103,"height":36},{"text":"수신자가","x":843,"y":615,"width":134,"height":37},{"text":"그","x":992,"y":619,"width":32,"height":25},{"text":"패킷을","x":1041,"y":613,"width":99,"height":37},{"text":"이미","x":1158,"y":614,"width":62,"height":36},{"text":"수신했음이(송신자가","x":1240,"y":613,"width":323,"height":39},{"text":"아닌","x":1580,"y":613,"width":66,"height":37},{"text":"여러분에거l)","x":1667,"y":612,"width":175,"height":41}]},{"text":"분명하더라도 결국 송신자는 send—base 패킷을 재전송할 것이다. 만약 수신자가 이","words":[{"text":"분명하더라도","x":543,"y":674,"width":198,"height":38},{"text":"결국","x":756,"y":675,"width":62,"height":36},{"text":"송신자는","x":830,"y":674,"width":133,"height":38},{"text":"send—base","x":975,"y":679,"width":202,"height":35},{"text":"패킷을","x":1194,"y":672,"width":102,"height":37},{"text":"재전송할","x":1309,"y":673,"width":137,"height":36},{"text":"것이다.","x":1461,"y":673,"width":107,"height":36},{"text":"만약","x":1584,"y":672,"width":69,"height":37},{"text":"수신자가","x":1666,"y":671,"width":137,"height":36},{"text":"이","x":1815,"y":675,"width":25,"height":36}]},{"text":"패킷에 대한 확인응답을 하지 않는다면, 송신자의 원도유는 결코 앞으로 이동하지 않","words":[{"text":"패킷에","x":544,"y":734,"width":95,"height":37},{"text":"대한","x":658,"y":734,"width":65,"height":37},{"text":"확인응답을","x":735,"y":734,"width":166,"height":38},{"text":"하지","x":915,"y":733,"width":62,"height":38},{"text":"않는다면,","x":996,"y":732,"width":141,"height":37},{"text":"송신자의","x":1153,"y":732,"width":133,"height":37},{"text":"원도유는","x":1306,"y":732,"width":138,"height":36},{"text":"결코","x":1461,"y":732,"width":66,"height":35},{"text":"앞으로","x":1544,"y":732,"width":103,"height":36},{"text":"이동하지","x":1665,"y":729,"width":131,"height":38},{"text":"않","x":1815,"y":733,"width":29,"height":36}]},{"text":"을 것이다. 이러한 예는 SR 프로토콜(또한 다른 많은 프로토골)의 중대한 면을 알려","words":[{"text":"을","x":540,"y":793,"width":35,"height":37},{"text":"것이다.","x":592,"y":794,"width":103,"height":38},{"text":"이러한","x":715,"y":794,"width":98,"height":38},{"text":"예는","x":828,"y":795,"width":66,"height":37},{"text":"SR","x":909,"y":798,"width":45,"height":29},{"text":"프로토콜(또한","x":971,"y":792,"width":215,"height":38},{"text":"다른","x":1203,"y":791,"width":67,"height":37},{"text":"많은","x":1287,"y":791,"width":68,"height":37},{"text":"프로토골)의","x":1371,"y":791,"width":183,"height":38},{"text":"중대한","x":1574,"y":789,"width":107,"height":37},{"text":"면을","x":1699,"y":788,"width":67,"height":35},{"text":"알려","x":1783,"y":789,"width":56,"height":38}]},{"text":"주고 있다. 송신자와 수신지는 올바른 수신과 그렇지 않은 수신에 대해 항상 같은 관점","words":[{"text":"주고","x":539,"y":855,"width":67,"height":35},{"text":"있다.","x":620,"y":854,