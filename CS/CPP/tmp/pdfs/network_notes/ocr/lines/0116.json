,"height":39},{"text":"큐에","x":839,"y":452,"width":66,"height":36},{"text":"놓인다.","x":920,"y":450,"width":110,"height":39}]},{"text":"3. 앨리스의 메일 서버에서 동작하는 SMTP의 클라이언트 측은 메시지 큐에 있는 메","words":[{"text":"3.","x":563,"y":515,"width":29,"height":29},{"text":"앨리스의","x":610,"y":512,"width":133,"height":38},{"text":"메일","x":760,"y":512,"width":65,"height":37},{"text":"서버에서","x":842,"y":511,"width":131,"height":38},{"text":"동작하는","x":990,"y":511,"width":137,"height":38},{"text":"SMTP의","x":1140,"y":512,"width":134,"height":37},{"text":"클라이언트","x":1292,"y":513,"width":174,"height":37},{"text":"측은","x":1479,"y":514,"width":70,"height":36},{"text":"메시지","x":1562,"y":513,"width":99,"height":37},{"text":"큐에","x":1678,"y":513,"width":67,"height":37},{"text":"있는","x":1763,"y":512,"width":67,"height":37},{"text":"메","x":1844,"y":515,"width":29,"height":37}]},{"text":"시지를 본다. 밥의 메일 서버에서 수행되고 있는 SMTP 서버에게 TCP 연결을 설","words":[{"text":"시지를","x":610,"y":571,"width":102,"height":38},{"text":"본다.","x":725,"y":572,"width":75,"height":37},{"text":"밥의","x":817,"y":572,"width":65,"height":37},{"text":"메일","x":899,"y":571,"width":66,"height":37},{"text":"서버에서","x":982,"y":571,"width":132,"height":39},{"text":"수행되고","x":1131,"y":571,"width":139,"height":38},{"text":"있는","x":1287,"y":573,"width":67,"height":36},{"text":"SMTP","x":1368,"y":578,"width":103,"height":28},{"text":"서버에게","x":1487,"y":573,"width":134,"height":37},{"text":"TCP","x":1637,"y":577,"width":74,"height":29},{"text":"연결을","x":1728,"y":572,"width":102,"height":37},{"text":"설","x":1844,"y":575,"width":30,"height":37}]},{"text":"정한다.","words":[{"text":"정한다.","x":610,"y":632,"width":108,"height":38}]},{"text":"4. 초기 SMTP 핸드셰이킹 이후에 SMTP 클라이언트는 앨리스의 메시지를 TCP 연","words":[{"text":"4.","x":562,"y":695,"width":29,"height":29},{"text":"초기","x":608,"y":692,"width":63,"height":37},{"text":"SMTP","x":689,"y":697,"width":103,"height":28},{"text":"핸드셰이킹","x":807,"y":692,"width":167,"height":39},{"text":"이후에","x":994,"y":693,"width":98,"height"