":136,"height":37},{"text":"읽기","x":1082,"y":934,"width":61,"height":37},{"text":"위해","x":1162,"y":934,"width":65,"height":37},{"text":"사용자","x":1242,"y":933,"width":106,"height":38},{"text":"에이전트를","x":1361,"y":933,"width":174,"height":37},{"text":"시동한다.","x":1548,"y":933,"width":145,"height":38}]},{"text":"이 시나리오는 그림 2.15에 요약되어 있다.","words":[{"text":"이","x":538,"y":1038,"width":29,"height":38},{"text":"시나리오는","x":584,"y":1038,"width":172,"height":39},{"text":"그림","x":767,"y":1038,"width":65,"height":37},{"text":"2.15에","x":848,"y":1038,"width":101,"height":37},{"text":"요약되어","x":964,"y":1037,"width":133,"height":37},{"text":"있다.","x":1117,"y":1038,"width":74,"height":37}]},{"text":"SMTP가 메일을 보내는 데 두 메일 서버가 먼 거리에 떨어져 있더라도 중간 메일","words":[{"text":"SMTP가","x":603,"y":1099,"width":138,"height":37},{"text":"메일을","x":754,"y":1098,"width":103,"height":38},{"text":"보내는","x":870,"y":1098,"width":104,"height":37},{"text":"데","x":989,"y":1098,"width":29,"height":37},{"text":"두","x":1034,"y":1100,"width":35,"height":35},{"text":"메일","x":1083,"y":1098,"width":67,"height":37},{"text":"서버가","x":1167,"y":1099,"width":104,"height":37},{"text":"먼","x":1287,"y":1099,"width":31,"height":36},{"text":"거리에","x":1336,"y":1098,"width":99,"height":38},{"text":"떨어져","x":1454,"y":1099,"width":99,"height":38},{"text":"있더라도","x":1574,"y":1100,"width":137,"height":38},{"text":"중간","x":1724,"y":1098,"width":70,"height":38},{"text":"메일","x":1809,"y":1099,"width":64,"height":39}]},{"text":"서버를 A卜우하지 않음을 이해하는 것이 중요하다. 앨리스의 서버가 홍콩에 있고, 밥의","words":[{"text":"서버를","x":536,"y":1160,"width":102,"height":37},{"text":"A卜우하지","x":651,"y":1158,"width":134,"height":39},{"text":"않음을","x":804,"y":1158,"width":103,"height":37},{"text":"이해하는","x":922,"y":1157,"width":137,"height":38},{"text":"것이","x":1075,"y":1158,"width":64,"height":39},{"text":"중요하다.","x":1157,"y":1159,"width":147,"height":38},{"text":"앨리스의","x":1323,"y":1159,"width":135,"height":39},{"text":"서버가","x":1477,"y":1160,"width":105,"height":39},{"text":"홍콩에","x":1595,"y":1161,"width":102,"height":38},{"text":"있고,","x":1717,"y":1160,"width":74,"height":38},{"text":"밥의","x":1809,"y":1160,"width":63,"height":40}]},{"text":"서버가 세인트루이스에 있다면, TCP 연결은 홍콩과 세인트루이스 서버 사이의 직접","words":[{"text":"서버가","x":535,"y":1220,"width":102,"height":37},{"text":"세인트루이스에","x":652,"y":1218,"width":238,"height":38},{"text":"있다면,","x":913,"y":1218,"width":109,"height":39},{"text":"TCP","x":1040,"y":1224,"width":73,"height":29},{"text":"연결은","x":1133,"y":1220,"width":103,"height":37},{"text":"홍콩과","x":1251,"y":1220,"width":107,"height":39},{"text":"세인트루이스","x":1374,"y":1221,"width":211,"height":39},{"text":"서버","x":1603,"y":1222,"width":64,"height":38},{"text":"사이의","x":1688,"y":1220,"width":100,"height":39},{"text":"직접","x":1810,"y":1222,"width":62,"height":39}]},{"text":"연결이다. 특히, 밥의 메일 서버가 죽어 있다면, 메시지는 어느 중간 메일 서버에 저장","words":[{"text":"연결이다.","x":535,"y":1280,"width":141,"height":38},{"text":"특히,","x":692,"y":1280,"width":78,"height":38},{"text":"밥의","x":787,"y":1280,"width":65,"height":38},{"text":"메일","x":870,"y":1280,"width":66,"height":38},{"text":"서버가","x":954,"y":1280,"width":103,"height":39},{"text":"죽어","x":1070,"y":1282,"width":66,"height":37},{"text":"있다면,","x":1158,"y":1282,"width":109,"height":38},{"text":"메시지는","x":1283,"y":1282,"width":141,"height":38},{"text":"어느","x":1440,"y":1284,"width":68,"height":37},{"text":"중간","x":1522,"y":1284,"width":71,"height":38},{"text":"메일","x":1607,"y":1284,"width":67,"height":38},{"text":"서버에","x":1692,"y":1282,"width":100,"height":38},{"text":"저장","x":1810,"y":1283,"width":67,"height":40}]},{"text":"되는 것이 아니라. 앨리스의 메일 서버에 남아 새로운 시도를 위해 기다린다.","words":[{"text":"되는","x":533,"y":1342,"width":68,"height":37},{"text":"것이","x":614,"y":1341,"width":63,"height":39},{"text":"아니라.","x":695,"y":1341,"width":110,"height":38},{"text":"앨리스의","x":822,"y":1342,"width":133,"height":38},{"text":"메일","x":973,"y":1342,"width":65,"height":38},{"text":"서버에","x":1054,"y":1343,"width":101,"height":39},{"text