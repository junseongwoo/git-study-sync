,"x":609,"y":971,"width":28,"height":27},{"text":"2개의","x":652,"y":970,"width":72,"height":31},{"text":"호스트(재전송을","x":733,"y":971,"width":206,"height":32},{"text":"갖는)와","x":950,"y":972,"width":94,"height":31},{"text":"유한","x":1053,"y":972,"width":58,"height":31},{"text":"버퍼를","x":1121,"y":972,"width":83,"height":30},{"text":"갖는","x":1215,"y":972,"width":57,"height":30},{"text":"하나의","x":1282,"y":972,"width":85,"height":31},{"text":"라우터","x":1380,"y":972,"width":83,"height":31}]},{"text":"시나리오 2: 2개의 송신자, 유한 버퍼를 가진 하나의 라우터","words":[{"text":"시나리오","x":524,"y":1113,"width":141,"height":36},{"text":"2:","x":672,"y":1118,"width":35,"height":32},{"text":"2개의","x":720,"y":1115,"width":92,"height":35},{"text":"송신자,","x":823,"y":1115,"width":113,"height":42},{"text":"유한","x":947,"y":1114,"width":74,"height":42},{"text":"버퍼를","x":1031,"y":1115,"width":106,"height":40},{"text":"가진","x":1145,"y":1115,"width":69,"height":40},{"text":"하나의","x":1226,"y":1115,"width":106,"height":35},{"text":"라우터","x":1345,"y":1115,"width":105,"height":36}]},{"text":"다음 두 가지 방식으로 시나리오 1을 약간 변경하자(그림 3.45 참조). 첫째, 라우터 비","words":[{"text":"다음","x":522,"y":1184,"width":67,"height":38},{"text":"두","x":602,"y":1187,"width":34,"height":36},{"text":"가지","x":650,"y":1186,"width":62,"height":38},{"text":"방식으로","x":731,"y":1187,"width":132,"height":37},{"text":"시나리오","x":877,"y":1186,"width":135,"height":38},{"text":"1을","x":1029,"y":1187,"width":51,"height":36},{"text":"약간","x":1095,"y":1186,"width":67,"height":37},{"text":"변경하자(그림","x":1177,"y":1186,"width":216,"height":39},{"text":"3.45","x":1412,"y":1190,"width":67,"height":29},{"text":"참조).","x":1496,"y":1185,"width":93,"height":39},{"text":"첫째,","x":1608,"y":1185,"width":79,"height":38},{"text":"라우터","x":1705,"y":1184,"width":97,"height":39},{"text":"비","x":1820,"y":1190,"width":24,"height":38}]},{"text":"피의 양이 유한하다고 가정한다. 이 현실적인 가정의 결과는 이미 버퍼가 가득 찼을 때","words":[{"text":"피의","x":522,"y":1246,"width":62,"height":38},{"text":"양이","x":601,"y":1247,"width":62,"height":38},{"text":"유한하다고","x":679,"y":1248,"width":168,"height":37},{"text":"가정한다.","x":860,"y":1247,"width":141,"height":37},{"text":"이","x":1019,"y":1247,"width":28,"height":38},{"text":"현실적인","x":1064,"y":1247,"width":135,"height":37},{"text":"가정의","x":1215,"y":1247,"width":99,"height":38},{"text":"결과는","x":1333,"y":1247,"width":104,"height":36},{"text":"이미","x":1451,"y":1246,"width":65,"height":38},{"text":"버퍼가","x":1536,"y":1246,"width":106,"height":38},{"text":"가득","x":1655,"y":1246,"width":72,"height":37},{"text":"찼을","x":1739,"y":1245,"width":68,"height":37},{"text":"때","x":1819,"y":1250,"width":26,"height":37}]},{"text":"도착하는 패것들이 버려진다는 것을 의미한다. 둘째, 각 연결은 신뢰적이라고 가정한","words":[{"text":"도착하는","x":520,"y":1308,"width":135,"height":38},{"text":"패것들이","x":670,"y":1309,"width":129,"height":37},{"text":"버려진다는","x":820,"y":1308,"width":167,"height":38},{"text":"것을","x":1005,"y":1308,"width":67,"height":37},{"text":"의미한다.","x":1088,"y":1308,"width":143,"height":38},{"text":"둘째,","x":1250,"y":1308,"width":78,"height":38},{"text":"각","x":1346,"y":1307,"width":36,"height":38},{"text":"연결은","x":1399,"y":1307,"width":105,"height":37},{"text":"신뢰적이라고","x":1521,"y":1306,"width":215,"height":39},{"text":"가정한","x":1752,"y":1306,"width":97,"height":40}]},{"text":"다. 트랜스포트 계층 세그먼트를 포함하는 패킷이 라우터에서 버려지면, 결국 송신자","words":[{"text":"다.","x":519,"y":1369,"width":40,"height":37},{"text":"트랜스포트","x":577,"y":1370,"width":168,"height":37},{"text":"계층","x":761,"y":1370,"width":66,"height":38},{"text":"세그먼트를","x":841,"y":1369,"width":171,"height":38},{"text":"포함하는","x":1027,"y":1369,"width":138,"height":37},{"text":"패킷이","x":1182,"y":1369,"width":98,"height":37},{"text":"라우터에서","x":1302,"y":1368,"width":170,"height":38},{"text":"버려지면,","x":1495,"y":1368,"width":151,"height":38},{"text":"결국","x":1666,"y":1368,"width":70,"height":37},{"text":"송신자","x":1752,"y":1367,"width":96,"height":40}]},{"text":"에 의해 재전송될 것이다.","words":[{"text":"에","x":518,"y":1431,"width":30,"height":38},{"text":"의해","x":564,"y":1431,"width":63,"height":39},{"text":"재전송될","x":642,"y":1432,"width":132,"height":38},{"text":"것이다.","x":790,"y":1431,"width":106,"height":39}]},{"text":"패킷이 재전송될 수 있으므로, 이제는 송신율(sending rate)이라는 용어 사우에 좀","words":[{"text":"패킷이","x":582,"y":1494,"width":96,"height":38},{"text":"재전송될","x":696,"y":1494,"width":131,"height":38},{"text":"수","x":843,"y":1495,"width":34,"height":38},{"text":"있으므로,","x":893,"y":1494,"width":141,"height":38},{"text":"이제는","x":1052,"y":1494,"width":102,"height":38},{"text":"송신율(sending","x":1167,"y":1495,"width":235,"height":39},{"text":"rate)이라는","x":1415,"y":1492,"width":188,"height":41},{"text":"용어","x":1616,"y":1492,"width":68,"height":39},{"text":"사우에","x":1703,"y":1491,"width":100,"height":39},{"text":"좀","x":1818,"y":1495,"width":30,"height":34}]},{"text":"더 주의해야 한다. 특히, 애플리케이션이 원래의 데이터를 소켓으로 보내는 송신율을","words":[{"text":"더","x":516,"y":1555,"width":28,"height":37},{"text":"주의해야","x":563,"y":1555,"width":136,"height":39},{"text":"한다.","x":714,"y":1556,"width":73,"height":39},{"text":"특히,","x":805,"y":1557,"width":75,"height":38},{"text":"애플리케이션이","x":899,"y":1556,"width":235,"height":39},{"text":"원래의","x":1155,"y":1555,"width":100,"height":39},{"text":"데이터를","x":1276,"y":1555,"width":140,"height":39},{"text":"소켓으로","x":1431,"y":1556,"width":145,"height":38},{"text":"보내는","x":1592,"y":1555,"width":109,"height":39},{"text":"송신율을","x":1717,"y":1553,"width":131,"height":40}]},{"text":"바이트」초로 표기하자. 네트워크 안으로 세그먼트(원래 데이터와 재전송 데이터를","words":[{"text":"바이트」초로","x":571,"y":1618,"width":179,"height":40},{"text":"표기하자.","x":764,"y":1620,"width":141,"height":38},{"text":"네트워크","x":925,"y":1619,"width":134,"height":38},{"text":"안으로","x":1076,"y":1619,"width":102,"height":37},{"text":"세그먼트(원래","x":1193,"y":1619,"width":222,"height":39},{"text":"데이터와","x":1435,"y":1619,"width":144,"height":39},{"text":"재전송","x":1594,"y":1618,"width":108,"height":39},{"text":"데이터를","x":1719,"y":1616,"width":129,"height":39}]},{"text":"포함)를 송신하는 트랜스포트 계층에서의 송신율은 Al\u0027n 바이트/초로 표시하고, n;n은","words":[{"text":"포함)를","x":513,"y":1681,"width":115,"height":41},{"text":"송신하는","x":644,"y":1682,"width":136,"height":39},{"text":"트랜스포트","x":795,"y":1682,"width":170,"height":38},{"text":"계층에서의","x":984,"y":1681,"width":168,"height":40},{"text":"송신율은","x":1173,"y":1681,"width":141,"height":39},{"text":"Al\u0027n","x":1331,"y":1686,"width":45,"height":38},{"text":"바이트/초로","x":1395,"y":1682,"width":191,"height":39},{"text":"표시하고,","x":1605,"y":1681,"width":151,"height":40},{"text":"n;n은","x":1775,"y":1680,"width":73,"height":41}]},{"text":"때때로 네트워크에 제공된 부\u0026l-(offered load)라고 부른다.","words":[{"text":"때때로","x":514,"y":1745,"width":100,"height":38},{"text":"네트워크에","x":628,"y":1745,"width":163,"height":39},{"text":"제공된","x":806,"y":1745,"width":99,"height":39},{"text":"부\u0026l-(offered","x":919,"y":1745,"width":200,"height":40},{"text":"load)라고","x":1130,"y":1745,"width":158,"height":40},{"text":"부른다.","x":1301,"y":1746,"width":113,"height":39}]},{"text":"시나리오 2에서의 성능은 재전송이 어떻게 수행되는지에 띠를 것이다. 첫째로, 호","words":[{"text":"시나리오","x":581,"y":1808,"width":132,"height":39},{"text":"2에서의","x":727,"y":1809,"width":115,"height":38},{"text":"성능은","x":860,"y":1808,"width":101,"height":39},{"text":"재전송이","x":975,"y":1808,"width":133,"height":39},{"text":"어떻게","x":1128,"y":1808,"width":99,"height":39},{"text":"수행되는지에","x":1244,"y":1809,"width":211,"height":40},{"text":"띠를","x":1473,"y":1809,"width":71,"height":40},{"text":"것이다.","x":1560,"y":1809,"width":115,"height":40},{"text":"첫째로,","x":1694,"y":1807,"width":110,"height":41},{"text":"호","x":1819,"y":1809,"width":30,"height":32}]},{"text":"스트 A가 어떻게 해서든(신기하게!) 라우터에 있는 버퍼가 비어 있는지 그렇지 않은지","words":[{"text":"스트","x":514,"y":1874,"width":67,"height":30},{"text":"A가","x":593,"y":1872,"width":62,"height":39},{"text":"어떻게","x":668,"y":1872,"width":96,"height":40},{"text":"해서든(신기하게!)","x":781,"y":1871,"width":272,"height":41},{"text":"라우터에","x":1069,"y":1872,"width":135,"height":39},{"text":"있는","x