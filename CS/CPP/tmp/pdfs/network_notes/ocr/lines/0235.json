27,"height":31},{"text":"세그먼트","x":954,"y":1364,"width":115,"height":31},{"text":"재전송을","x":1079,"y":1364,"width":114,"height":32},{"text":"방지","x":1204,"y":1363,"width":54,"height":32}]},{"text":"타임아웃 주기를 이전 값의 두 배로 설정한다. 예를 들어, 타이머가 먼저 만료되었을","words":[{"text":"타임아웃","x":520,"y":1494,"width":138,"height":40},{"text":"주기를","x":672,"y":1497,"width":104,"height":39},{"text":"이전","x":793,"y":1497,"width":64,"height":38},{"text":"값의","x":876,"y":1497,"width":65,"height":39},{"text":"두","x":960,"y":1501,"width":35,"height":36},{"text":"배로","x":1012,"y":1499,"width":67,"height":37},{"text":"설정한다.","x":1097,"y":1498,"width":143,"height":38},{"text":"예를","x":1261,"y":1497,"width":68,"height":38},{"text":"들어,","x":1344,"y":1497,"width":78,"height":38},{"text":"타이머가","x":1441,"y":1498,"width":141,"height":38},{"text":"먼저","x":1599,"y":1498,"width":65,"height":38},{"text":"만료되었을","x":1685,"y":1499,"width":164,"height":39}]},{"text":"때 가장 이전의 확인응답이 안 된 세그먼트와 연관된 Timeout1nterva1이 0.75초","words":[{"text":"때","x":519,"y":1556,"width":30,"height":39},{"text":"가장","x":566,"y":1557,"width":69,"height":39},{"text":"이전의","x":648,"y":1559,"width":99,"height":38},{"text":"확인응답이","x":762,"y":1559,"width":168,"height":39},{"text":"안","x":948,"y":1560,"width":34,"height":37},{"text":"된","x":994,"y":1560,"width":32,"height":38},{"text":"세그먼트와","x":1041,"y":1560,"width":174,"height":38},{"text":"연관된","x":1229,"y":1559,"width":99,"height":38},{"text":"Timeout1nterva1이","x":1343,"y":1561,"width":393,"height":38},{"text":"0.75초","x":1752,"y":1564,"width":96,"height":31}]},{"text":"라고 가정하자. TCP는 이 세그먼트를 재전송하고, 새로운 종료 시간을 1.5초로 한다.","words":[{"text":"라고","x":520,"y":1618,"width":67,"height":40},{"text":"가정하자.","x":603,"y":1620,"width":143,"height":40},{"text":"TCP는","x":762,"y":1624,"width":107,"height":34},{"text":"이","x":885,"y":1621,"width":28,"height":39},{"text":"세그먼트를","x":933,"y":1622,"width":172,"height":38},{"text":"재전송하고,","x":1120,"y":1622,"width":180,"height":38},{"text":"새로운","x":1317,"y":1621,"width":105,"height":38},{"text":"종료","x":1435,"y":1623,"width":71,"height":36},{"text":"시간을","x":1521,"y":1622,"width":106,"height":39},{"text":"1.5초로","x":1646,"y":1626,"width":116,"height":31},{"text":"한다.","x":1777,"y":1624,"width":69,"height":39}]},{"text":"만약 타이머가 다시 1.5초가 경과한 후에 만료되면, TCP는 다시 그 세그먼트를 재전","words":[{"text":"만약","x":518,"y":1681,"width":69,"height":40},{"text":"타이머가","x":602,"y":1683,"width":138,"height":40},{"text":"다시","x":754,"y":1684,"width":63,"height":39},{"text":"1.5초가","x":840,"y":1684,"width":115,"height":39},{"text":"경과한","x":971,"y":1685,"width":103,"height":38},{"text":"후에","x":1087,"y":1684,"width":66,"height":38},{"text":"만료되면,","x":1172,"y":1684,"width":146,"height":38},{"text":"TCP는","x":1334,"y":1686,"width":109,"height":35},{"text":"다시","x":1459,"y":1684,"width":64,"height":39},{"text":"그","x":1543,"y":1690,"width":34,"height":26},{"text":"세그먼트를","x":1593,"y":1685,"width":177,"height":38},{"text":"재전","x":1784,"y":1686,"width":61,"height":38}]},{"text":"송할 것이고 다음에는 종료 시간을 3.0초로 한다. 따라서 이 주기는 각 재전송 후에 지","words":[{"text":"송할","x":517,"y":1744,"width":71,"height":39},{"text":"것이고","x":601,"y":1746,"width":101,"height":39},{"text":"다음에는","x":716,"y":1747,"width":135,"height":38},{"text":"종료","x":863,"y":1748,"width":69,"height":37},{"text":"시간을","x":946,"y":1747,"width":102,"height":38},{"text":"3.0초로","x":1061,"y":1748,"width":118,"height":32},{"text":"한다.","x":1193,"y":1746,"width":76,"height":38},{"text":"따라서","x":1286,"y":1746,"width":99,"height":38},{"text":"이","x":1403,"y":1746,"width":29,"height":38},{"text":"주기는","x":1449,"y":1747,"width":106,"height":37},{"text":"각","x":1568,"y":1747,"width":36,"height":37},{"text":"재전송","x":1617,"y":1747,"width":106,"height":38},{"text":"후에","x":1735,"y":1748,"width":65,"height":37},{"text":"지","x":1817,"y":1748,"width":25,"height":37}]},{"text":"수적으로 증가한다. 그러나 두 가지 다른 사건들(즉, 상위의 애플리케이션으로부터 데","words":[{"text":"수적으로","x":518,"y":1807,"width":137,"height":39},{"text":"증가한다.","x"