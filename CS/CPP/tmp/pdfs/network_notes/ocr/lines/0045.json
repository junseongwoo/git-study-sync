37}]},{"text":"때문에 아주 적은 트래픽만 증가하여도 여러분이 겪는 지연은 아주 글 수 있다.","words":[{"text":"때문에","x":148,"y":1082,"width":96,"height":37},{"text":"아주","x":259,"y":1082,"width":66,"height":37},{"text":"적은","x":339,"y":1082,"width":65,"height":36},{"text":"트래픽만","x":416,"y":1081,"width":134,"height":38},{"text":"증가하여도","x":561,"y":1081,"width":171,"height":38},{"text":"여러분이","x":746,"y":1082,"width":134,"height":38},{"text":"겪는","x":900,"y":1082,"width":68,"height":37},{"text":"지연은","x":982,"y":1082,"width":105,"height":38},{"text":"아주","x":1099,"y":1083,"width":71,"height":37},{"text":"글","x":1182,"y":1085,"width":34,"height":35},{"text":"수","x":1229,"y":1084,"width":34,"height":36},{"text":"있다.","x":1277,"y":1083,"width":72,"height":37}]},{"text":"큐잉 지연이 어떤 것인가에 대한 느낌을 실제로 얻기 위해, 큐에 대한 대화식 자바","words":[{"text":"큐잉","x":212,"y":1142,"width":62,"height":38},{"text":"지연이","x":293,"y":1142,"width":93,"height":37},{"text":"어떤","x":404,"y":1142,"width":63,"height":37},{"text":"것인가에","x":484,"y":1142,"width":129,"height":38},{"text":"대한","x":631,"y":1142,"width":68,"height":37},{"text":"느낌을","x":710,"y":1143,"width":105,"height":37},{"text":"실제로","x":829,"y":1143,"width":103,"height":37},{"text":"얻기","x":948,"y":1143,"width":63,"height":38},{"text":"위해,","x":1031,"y":1144,"width":77,"height":37},{"text":"큐에","x":1124,"y":1144,"width":66,"height":38},{"text":"대한","x":1207,"y":1144,"width":68,"height":37},{"text":"대화식","x":1289,"y":1143,"width":95,"height":36},{"text":"자바","x":1401,"y":1143,"width":68,"height":38}]},{"text":"애플릿을 제공하는 교재 웹 사이트를 방문해 보기 바란다. 트래픽 강도가 1이 넘도록","words":[{"text":"애플릿을","x":148,"y":1203,"width":132,"height":38},{"text":"제공하는","x":296,"y":1203,"width":132,"height":38},{"text":"교재","x":443,"y":1203,"width":63,"height":37},{"text":"웹","x":526,"y":1203,"width":28,"height":37},{"text":"사이트를","x":573,"y":1203,"width":136,"height":37},{"text":"방문해","x":725,"y":1203,"width":101,"height":38},{"text":"보기","x":844,"y":1204,"width":65,"height":37},{"text":"바란다.","x":929,"y":1204,"width":113,"height":38},{"text":"트래픽","x":1060,"y":1204,"width":101,"height":38},{"text":"강도가","x":1182,"y":1204,"width":103,"height":39},{"text":"1이","x":1302,"y":1203,"width":45,"height":38},{"text":"넘도록","x":1368,"y":1204,"width":100,"height":38}]},{"text":"패것 도착률-을 높게 설정하면 시간이 지남에 따라 큐가 천천히 쌓이는 것을 보게 될 것","words":[{"text":"패것","x":148,"y":1265,"width":63,"height":37},{"text":"도착률-을","x":226,"y":1264,"width":132,"height":38},{"text":"높게","x":370,"y":1265,"width":64,"height":37},{"text":"설정하면","x":451,"y":1264,"width":131,"height":38},{"text":"시간이","x":597,"y":1264,"width":97,"height":39},{"text":"지남에","x":713,"y":1265,"width":99,"height":38},{"text":"따라","x":829,"y":1265,"width":70,"height":38},{"text":"큐가","x":910,"y":1265,"width":71,"height":38},{"text":"천천히","x":996,"y":1266,"width":98,"height":37},{"text":"쌓이는","x":1112,"y":1266,"width":104,"height":38},{"text":"것을","x":1230,"y":1265,"width":66,"height":38},{"text":"보게","x":1309,"y":1265,"width":64,"height":37},{"text":"될","x":1390,"y":1266,"width":29,"height":37},{"text":"것","x":1436,"y":1266,"width":29,"height":38}]},{"text":"이다.","words":[{"text":"이다.","x":149,"y":1325,"width":72,"height":37}]},{"text":"패킷 손실","words":[{"text":"패킷","x":148,"y":1431,"width":68,"height":42},{"text":"손실","x":227,"y":1432,"width":68,"height":40}]},{"text":"앞 내용에서 큐가 무한대 패킷을 가질 수 있다고 가정했다. 현실에서 큐의 용량은 스위","words":[{"text":"앞","x":148,"y":1503,"width":33,"height":37},{"text":"내용에서","x":194,"y":1503,"width":128,"height":38},{"text":"큐가","x":338,"y":1504,"width":67,"height":37},{"text":"무한대","x":417,"y":1504,"width":97,"height":37},{"text":"패킷을","x":531,"y":1504,"width":101,"height":37},{"text":"가질","x":645,"y":1504,"width":65,"height":37},{"text":"수","x":725,"y":1505,"width":35,"height":36},{"text":"있다고","x":775,"y":1504,"width":101,"height":38},{"text":"가정했다.","x":891,"y":1505,"width":146,"height":38},{"text":"현실에서","x":1054,"y":1505,"width":135,"height":38},{"text":"큐의","x":1205,"y":1506,"width":65,"height":37},{"text":"용량은","x":1286,"y":1506,"width":102,"height":38},{"text":"스위","x":1401,"y":1506,"width":64,"height":38}]},{"text":"치 설계와 비용에 크게 의존하며, 일반적으로 유한 용량을 가진다. 큐 용량이 유한하므","words":[{"text":"치","x":149,"y":1564,"width":27,"height":38},{"text":"설계와","x":194,"y":1565,"width":100,"height":37},{"text":"비용에","x":307,"y":1564,"width":95,"height":38},{"text":"크게","x":418,"y":1565,"width":63,"height":37},{"text":"의존하며,","x":498,"y":1565,"width":142,"height":37},{"text":"일반적으로","x":658,"y":1564,"width":169,"height":37},{"text":"유한","x":840,"y":1565,"width":71,"height":37},{"text":"용량을","x":922,"y":1565,"width":107,"height":38},{"text":"가진다.","x":1043,"y":1566,"width":112,"height":38},{"text":"큐","x":1170,"y":1569,"width":36,"height":35},{"text":"용량이","x":1217,"y":1567,"width":98,"height":38},{"text":"유한하므","x":1332,"y":1566,"width":136,"height":39}]},{"text":"로 트래픽 강도가 1에 접근함에 따라 패것 지연이 실제로 무한대가 되진 않는다. 대신","words":[{"text":"로","x":147,"y":1629,"width":33,"height":27},{"text":"트래픽","x":194,"y":1625,"width":96,"height":38},{"text":"강도가","x":308,"y":1625,"width":100,"height":38},{"text":"1에","x":424,"y":1626,"width":47,"height":37},{"text":"접근함에","x":489,"y":1625,"width":130,"height":37},{"text":"따라","x":637,"y":1625,"width":68,"height":38},{"text":"패것","x":720,"y":1625,"width":66,"height":38},{"text":"지연이","x":802,"y":1626,"width":98,"height":37},{"text":"실제로","x":920,"y":1626,"width":104,"height":37},{"text":"무한대가","x":1038,"y":1628,"width":142,"height":36},{"text":"되진","x":1194,"y":1628,"width":66,"height":37},{"text":"않는다.","x":1276,"y":1628,"width":109,"height":37},{"text":"대신","x":1403,"y":1629,"width":65,"height":36}]},{"text":"에 패킷이 도착해서 큐가 꽉 찬 것을 발견하게 된다. 이렇게 패킷을 저장할 수 없는 경","words":[{"text":"에","x":148,"y":1686,"width":29,"height":36},{"text":"패킷이","x":194,"y":1686,"width":95,"height":37},{"text":"도착해서","x":307,"y":1686,"width":129,"height":38},{"text":"큐가","x":452,"y":1686,"width":68,"height":37},{"text":"꽉","x":532,"y":1686,"width":36,"height":37},{"text":"찬","x":580,"y":1686,"width":34,"height":35},{"text":"것을","x":629,"y":1686,"width":67,"height":37},{"text":"발견하게","x":709,"y":1686,"width":134,"height":38},{"text":"된다.","x":861,"y":1686,"width":76,"height":38},{"text":"이렇게","x":954,"y":1687,"width":101,"height":38},{"text":"패킷을","x":1073,"y":1688,"width":105,"height":37},{"text":"저장할","x":1193,"y":1688,"width":102,"height":38},{"text":"수","x":1307,"y":1689,"width":36,"height":36},{"text":"없는","x":1357,"y":1688,"width":66,"height":37},{"text":"경","x":1438,"y":1689,"width":27,"height":38}]},{"text":"우에 라우터는 그 패킷을 버린다(drop). 즉, 그 패킷을 잃어버리게 된다(lost). 큐에서","words":[{"text":"우에","x":146,"y":1746,"width":65,"height":38},{"text":"라우터는","x":230,"y":1747,"width":132,"height":37},{"text":"그","x":375,"y":1752,"width":35,"height":26},{"text":"패킷을","x":424,"y":1747,"width":101,"height":38},{"text":"버린다(drop).","x":539,"y":1746,"width":216,"height":41},{"text":"즉,","x":772,"y":1749,"width":42,"height":36},{"text":"그","x":831,"y":1752,"width":34,"height":26},{"text":"패킷을","x":881,"y":1747,"width":103,"height":38},{"text":"잃어버리게","x":1001,"y":1748,"width":171,"height":39},{"text":"된다(lost).","x":1190,"y":1749,"width":161,"height":39},{"text":"큐에서","x":1368,"y":1750,"width":98,"height":37}]},{"text":"의 이 오버플로우(overflow)는 트래픽 강도가 1보다 클 때 큐에 대한 자바 애플릿에서","words":[{"text":"의","x":148,"y":1806,"width":28,"height":37},{"text":"이","x":194,"y":1807,"width":29,"height":37},{"text":"오버플로우(overflow)는","x":240,"y":1807,"width":364,"height":40},{"text":"트래픽","x":617,"y":1807,"width":98,"height":38},{"text":"강도가","x":733,"y":1807,"width":105,"height":39},{"text":"1보다","x":854,"y":1808,"width":86,"height":38},{"text":"클","x":953,"y":1810,"width":35,"height":35},{"text":"때","x":1003,"y":1808,"width":30,"height":38},{"text":"큐에","x":1049,"y":1809,"width":69,"height":38},{"text":"대한","x":1136,"y":1809,"width":69,"height":38},{"text":"자바","x":1218,"y":1809,"width":69,"height":39},{"text":"애플릿에서","x":1301,"y":1810,"width":166,"height":38}]},{"text":"볼수 있다.","words":[{"text":"볼수","x":146,"y":1867,"width":81,"height":38},{"text":"있다.","x":241,"y":1868,"width":72,"height":38}]},{"text":"종단 시스템 입장에서, 패것 손실은 패킷이 네트워크 코어로 전송되었으나 네트워","words":[{"text":"종단","x":213,"y":1930,"width":68,"height":37},{"text":"시스템","x":295,"y":1930,"width":96,"height":38},{"text":"입장에서,","x":410,"y":1930,"width":141,"height":39},{"text":"패것","x":566,"y":1930,"width":66,"height":38},{"text":"손실은","x":646,"y":1930,"width":105,"height":37},{"text":"패킷이","x":764,"y":1930,"width":98,"height":38},{"text":"네트워크","x":880,"y":1930,"width":139,"height":38},{"text":"코어로","x":1032,"y":1931,"width":105,"height":38},{"text":"전송되었으나","x":1153,"y":1931,"width":205,"height":38},{"text":"네트워","x":1372,"y":1932,"width":98,"height":38}]},{"text":"그로부터 목적지에 나타나지 않는 것으로 보일 것이다. 손실 패킷의 비율은 트래픽 강","words":[{"text":"그로부터","x":147,"y":1991,"width":131,"height":37},{"text":"목적지에","x":297,"y":1991,"width":132,"height":38},{"text":"나타나지","x":446,"y":1991,"width":131,"height":39},{"text":"않는","x":596,"y":1991,"width":68,"height":38},{"text":"것으로","x":678,"y":1991,"width":102,"height":37},{"text":"보일","x":794,"y":1991,"width":67,"height":37},{"text":"것이다.","x":879,"y":1991,"width":110,"height":38},{"text":"손실","x":1004,"y":1991,"width":68,"height":38},{"text":"패킷의","x":1089,"y":1992,"width":101,"height":38},{"text":"비율은","x":1208,"y":1992,"width":103,"height":38},{"text":"트래픽","x":1324,"y":1993,"width":98,"height":38},{"text":"강","x":1440,"y":1994,"width":34,"height":37}]},{"text":"도가 클수록 증가한다. 그러므로 노드에서의 성능은 흔히 지연뿐 아니라 패킷 손실 확","words":[{"text":"도가","x":147,"y":2051,"width":69,"height":38},{"text":"클수록","x":228,"y":2052,"width":104,"height":38},{"text":"증가한다.","x":344,"y":2053,"width":143,"height":38},{"text":"그러므로","x":503,"y":2053,"width":137,"height":38},{"text":"노드에서의","x":653,"y":2052,"width":169,"height":38},{"text":"성능은","x":840,"y":2052,"width":104,"height":38},{"text":"흔히","x":956,"y":2053,"width":66,"height":37},{"text":"지연뿐","x":1042,"y":2053,"width":103,"height":38},{"text":"아니