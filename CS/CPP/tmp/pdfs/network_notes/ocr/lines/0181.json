{"page":181,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"174","words":[{"text":"174","x":207,"y":138,"width":74,"height":35}]},{"text":"CHAPTER 03 • 트랜스포트 계층","words":[{"text":"CHAPTER","x":589,"y":145,"width":123,"height":24},{"text":"03","x":723,"y":145,"width":32,"height":24},{"text":"•","x":789,"y":151,"width":12,"height":12},{"text":"트랜스포트","x":834,"y":146,"width":132,"height":28},{"text":"계층","x":978,"y":145,"width":51,"height":29}]},{"text":"서부 집안에 도착했을 때, 맨은 또한 그 우편물을 나누니 주는 일을 한다. 또한 동부 집안","words":[{"text":"서부","x":566,"y":272,"width":66,"height":37},{"text":"집안에","x":647,"y":272,"width":95,"height":37},{"text":"도착했을","x":758,"y":271,"width":133,"height":36},{"text":"때,","x":905,"y":271,"width":40,"height":36},{"text":"맨은","x":960,"y":271,"width":67,"height":35},{"text":"또한","x":1039,"y":270,"width":68,"height":36},{"text":"그","x":1120,"y":275,"width":33,"height":25},{"text":"우편물을","x":1166,"y":270,"width":137,"height":36},{"text":"나누니","x":1318,"y":269,"width":63,"height":37},{"text":"주는","x":1398,"y":271,"width":69,"height":35},{"text":"일을","x":1483,"y":269,"width":67,"height":36},{"text":"한다.","x":1564,"y":270,"width":76,"height":37},{"text":"또한","x":1657,"y":271,"width":70,"height":35},{"text":"동부","x":1739,"y":272,"width":68,"height":36},{"text":"집안","x":1822,"y":274,"width":58,"height":42}]},{"text":"의 밀도 엔과 같은 일을 한다.","words":[{"text":"의","x":566,"y":331,"width":28,"height":36},{"text":"밀도","x":612,"y":332,"width":64,"height":36},{"text":"엔과","x":690,"y":331,"width":66,"height":37},{"text":"같은","x":769,"y":330,"width":66,"height":37},{"text":"일을","x":849,"y":329,"width":65,"height":37},{"text":"한다.","x":927,"y":329,"width":73,"height":37}]},{"text":"이 예처럼, 우편 서비스는 두 집 건에 논리 통신을 제공한t:l(우편 서비스는 우편물","words":[{"text":"이","x":630,"y":391,"width":28,"height":37},{"text":"예처럼,","x":675,"y":390,"width":107,"height":37},{"text":"우편","x":797,"y":389,"width":64,"height":37},{"text":"서비스는","x":877,"y":388,"width":134,"height":39},{"text":"두","x"