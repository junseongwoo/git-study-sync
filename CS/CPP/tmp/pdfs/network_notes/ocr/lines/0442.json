{"page":442,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"436","words":[{"text":"436","x":201,"y":140,"width":76,"height":37}]},{"text":"CHAPTER06 • 링크 계층: 링크. 접속망, 랜","words":[{"text":"CHAPTER06","x":581,"y":143,"width":164,"height":28},{"text":"•","x":778,"y":153,"width":12,"height":13},{"text":"링크","x":824,"y":148,"width":50,"height":29},{"text":"계층:","x":885,"y":147,"width":60,"height":30},{"text":"링크.","x":960,"y":147,"width":59,"height":32},{"text":"접속망,","x":1034,"y":147,"width":86,"height":32},{"text":"랜","x":1135,"y":147,"width":24,"height":29}]},{"text":"64.2 이더넷","words":[{"text":"64.2","x":557,"y":278,"width":107,"height":41},{"text":"이더넷","x":721,"y":277,"width":119,"height":46}]},{"text":"이더넷은 유선 랜 시장을 상당히 많이 점유하고 있다. 1980년대와 1990년대 초반만","words":[{"text":"이더넷은","x":555,"y":374,"width":131,"height":38},{"text":"유선","x":702,"y":375,"width":65,"height":37},{"text":"랜","x":786,"y":376,"width":30,"height":35},{"text":"시장을","x":835,"y":375,"width":97,"height":38},{"text":"상당히","x":947,"y":375,"width":96,"height":37},{"text":"많이","x":1063,"y":375,"width":63,"height":38},{"text":"점유하고","x":1148,"y":375,"width":131,"height":37},{"text":"있다.","x":1298,"y":374,"width":73,"height":37},{"text":"1980년대와","x":1394,"y":374,"width":185,"height":37},{"text":"1990년대","x":1600,"y":374,"width":145,"height":36},{"text":"초반만","x":1765,"y":375,"width":93,"height":40}]},{"text":"해도 이더넷은 토큰 링, FDDI, ATM과 같은 다른 랜 기술과 경생했다. 이들 기술 중","words":[{"text":"해도","x":554,"y":434,"width":64,"height":37},{"text":"이더넷은","x":634,"y":434,"width":132,"height":38},{"text":"토큰","x":780,"y":437,"width":66,"height":34},{"text":"링,","x":864,"y":434,"width":38,"height":38},{"text":"FDDI,","x":918,"y":438,"width":95,"height":33},{"text":"ATM과","x":1030,"y":434,"width":115,"height":37},{"text":"같은","x":1160,"y":434,"width":66,"height":37},{"text":"다른","x":1241,"y":434,"width":68,"height":37},{"text":"랜","x":1325,"y":434,"width":31,"height":37},{"text":"기술과","x":1375,"y":434,"width":104,"height":37},{"text":"경생했다.","x":1496,"y":434,"width":149,"height":38},{"text":"이들","x":1666,"y":434,"width":69,"height":37},{"text":"기술","x":1752,"y":434,"width":64,"height":37},{"text":"중","x":1829,"y":440,"width":28,"height":35}]},{"text":"일부는 몇 년간 시장의 일부를 점유하는 데 성공했다. 그러나 1970년대 중반에 개발된","words":[{"text":"일부는","x":553,"y":494,"width":97,"height":37},{"text":"몇","x":664,"y":494,"width":30,"height":37},{"text":"년간","x":709,"y":494,"width":66,"height":36},{"text":"시장의","x":788,"y":493,"width":95,"height":39},{"text":"일부를","x":900,"y":493,"width":98,"height":37},{"text":"점유하는","x":1012,"y":494,"width":131,"height":37},{"text":"데","x":1157,"y":494,"width":29,"height":37},{"text":"성공했다.","x":1203,"y":494,"width":141,"height":38},{"text":"그러나","x":1361,"y":494,"width":104,"height":37},{"text":"1970년대","x":1483,"y":494,"width":145,"height":36},{"text":"중반에","x":1646,"y":494,"width":103,"height":37},{"text":"개발된","x":1767,"y":495,"width":89,"height":40}]},{"text":"후로 이더넷은 계속 발전하고 성장했으며 우위를 지켜왔다. 오늘날 이더넷은 가장 우","words":[{"text":"후로","x":550,"y":554,"width":65,"height":37},{"text":"이더넷은","x":631,"y":553,"width":132,"height":38},{"text":"계속","x":778,"y":554,"width":66,"height":37},{"text":"발전하고","x":858,"y":553,"width":133,"height":38},{"text":"성장했으며","x":1008,"y":554,"width":161,"height":37},{"text":"우위를","x":1187,"y":554,"width":102,"height":37},{"text":"지켜왔다.","x":1306,"y":554,"width":144,"height":38},{"text":"오늘날","x":1469,"y":554,"width":107,"height":37},{"text":"이더넷은","x":1593,"y":554,"width":142,"height":37},{"text":"가장","x":1751,"y":554,"width":65,"height":38},{"text":"우","x":1829,"y":558,"width":28,"height":35}]},{"text":"세한 랜 기술이며, 가까운 장래에도 계속 그럴 것으로 예상된다. 인터넷이 글로벌 네트","words":[{"text":"세한","x":549,"y":614,"width":66,"height":37},{"text":"랜","x":628,"y":614,"width":31,"height":37},{"text":"기술이며,","x":674,"y":614,"width":139,"height":38},{"text":"가까운","x":829,"y":614,"width":98,"height":38},{"text":"장래에도","x":939,"y":613,"width":134,"height":39},{"text":"계속","x":1087,"y":615,"width":65,"height":37},{"text":"그럴","x":1165,"y":615,"width":64,"height":37},{"text":"것으로","x":1247,"y":615,"width":100,"height":38},{"text":"예상된다.","x":1361,"y":615,"width":147,"height":38},{"text":"인터넷이","x":1527,"y":615,"width":137,"height":37},{"text":"글로벌","x":1682,"y":615,"width":101,"height":36},{"text":"네트","x":1799,"y":616,"width":57,"height":36}]},{"text":"위경에 대한 것이라면, 이더넷은 근거리 네트워킹에 대한 것이다.","words":[{"text":"위경에","x":548,"y":675,"width":96,"height":38},{"text":"대한","x":659,"y":675,"width":67,"height":37},{"text":"것이라면,","x":739,"y":674,"width":138,"height":38},{"text":"이더넷은","x":893,"y":673,"width":133,"height":38},{"text":"근거리","x":1037,"y":675,"width":96,"height":38},{"text":"네트워킹에","x":1151,"y":675,"width":166,"height":39},{"text":"대한","x":1334,"y":677,"width":68,"height":37},{"text":"것이다.","x":1417,"y":676,"width":111,"height":38}]},{"text":"이더넷이 성공한 데는 많은 이유가 있다. 첫째, 이더넷이 처음으로 널리 A卜통된 고","words":[{"text":"이더넷이","x":613,"y":735,"width":127,"height":38},{"text":"성공한","x":758,"y":735,"width":100,"height":38},{"text":"데는","x":870,"y":734,"width":66,"height":37},{"text":"많은","x":948,"y":734,"width":67,"height":38},{"text":"이유가","x":1029,"y":735,"width":100,"height":38},{"text":"있다.","x":1143,"y":735,"width":73,"height":38},{"text":"첫째,","x":1233,"y":736,"width":74,"height":38},{"text":"이더넷이","x":1324,"y":737,"width":134,"height":38},{"text":"처음으로","x":1478,"y":737,"width":141,"height":37},{"text":"널리","x":1635,"y":736,"width":65,"height":37},{"text":"A卜통된","x":1719,"y":736,"width":97,"height":37},{"text":"고","x":1829,"y":743,"width":28,"height":27}]},{"text":"속 랜이었다는 것이다. 이더넷은 일찌감치 시용되었으므로 네트워크 관리자가 이더넷","words":[{"text":"속","x":545,"y":796,"width":34,"height":37},{"text":"랜이었다는","x":594,"y":796,"width":165,"height":37},{"text":"것이다.","x":775,"y":795,"width":104,"height":38},{"text":"이더넷은","x":897,"y":795,"width":134,"height":37},{"text":"일찌감치","x":1047,"y":796,"width":127,"height":38},{"text":"시용되었으므로","x":1193,"y":797,"width":243,"height":38},{"text":"네트워크","x":1453,"y":798,"width":140,"height":37},{"text":"관리자가","x":1609,"y":798,"width":143,"height":37},{"text":"이더넷","x":1767,"y":797,"width":88,"height":40}]},{"text":"에 친숙해졌으며(이더넷의 장점과 특성) 다른 랜 기술로 바꾸기를 끼리게 되었다. 둘","words":[{"text":"에","x":546,"y":856,"width":29,"height":38},{"text":"친숙해졌으며(이더넷의","x":595,"y":856,"width":341,"height":39},{"text":"장점과","x":955,"y":856,"width":102,"height":39},{"text":"특성)","x":1071,"y":857,"width":79,"height":39},{"text":"다른","x":1168,"y":858,"width":68,"height":37},{"text":"랜","x":1253,"y":858,"width":31,"height":37},{"text":"기술로","x":1303,"y":859,"width":103,"height":37},{"text":"바꾸기를","x":1422,"y":859,"width":143,"height":37},{"text":"끼리게","x":1583,"y":859,"width":102,"height":38},{"text":"되었다.","x":1707,"y":858,"width":105,"height":38},{"text":"둘","x":1829,"y":861,"width":28,"height":36}]},{"text":"째, 토큰 링과 FDDI, ATM이 이더넷보다 복잡하고 비싸다는 것이며, 이것 때문에 네","words":[{"text":"째,","x":545,"y":917,"width":40,"height":37},{"text":"토큰","x":600,"y":919,"width":69,"height":34},{"text":"링과","x":685,"y":916,"width":65,"height":38},{"text":"FDDI,","x":762,"y":921,"width":97,"height":33},{"text":"ATM이","x":875,"y":917,"width":111,"height":38},{"text":"이더넷보다","x":1006,"y":918,"width":168,"height":38},{"text":"복잡하고","x":1187,"y":919,"width":139,"height":36},{"text":"비싸다는","x":1343,"y":919,"width":139,"height":38},{"text":"것이며,","x":1499,"y":920,"width":113,"height":37},{"text":"이것","x":1632,"y":920,"width":66,"height":37},{"text":"때문에","x":1718,"y":920,"width":95,"height":36},{"text":"네","x":1830,"y":922,"width":24,"height":37}]},{"text":"트워크 관리자는 다른 네트워크로 바꾸기를 더 꺼리게 되었다. 셋째, 일반적으로","words":[{"text":"트워크","x":543,"y":978,"width":104,"height":37},{"text":"관리자는","x":664,"y":977,"width":139,"height":38},{"text":"다른","x":822,"y":977,"width":68,"height":38},{"text":"네트워크로","x":910,"y":978,"width":172,"height":38},{"text":"바꾸기를","x":1102,"y":979,"width":140,"height":38},{"text":"더","x":1263,"y":979,"width":28,"height":38},{"text":"꺼리게","x":1317,"y":980,"width":103,"height":38},{"text":"되었다.","x":1444,"y":980,"width":118,"height":38},{"text":"셋째,","x":1586,"y":981,"width":81,"height":37},{"text":"일반적으로","x":1693,"y":981,"width":163,"height":36}]},{"text":"(FDDI나 ATM과 같은) 다른 랜 기술로 바꾸는 가장 중요한 이유가 새 기술의 높은 데","words":[{"text":"(FDDI나","x":544,"y":1039,"width":136,"height":38},{"text":"ATM과","x":691,"y":1038,"width":115,"height":38},{"text":"같은)","x":818,"y":1038,"width":77,"height":39},{"text":"다른","x":910,"y":1039,"width":67,"height":37},{"text":"랜","x":991,"y":1039,"width":31,"height":37},{"text":"기술로","x":1037,"y":1040,"width":99,"height":37},{"text":"바꾸는","x":1149,"y":1040,"width":102,"height":37},{"text":"가장","x":1264,"y":1040,"width":69,"height":37},{"text":"중요한","x":1345,"y":1041,"width":107,"height":37},{"text":"이유가","x":1466,"y":1041,"width":106,"height":38},{"text":"새","x":1585,"y":1042,"width":32,"height":36},{"text":"기술의","x":1636,"y":1042,"width":100,"height":38},{"text":"높은","x":1752,"y":1042,"width":65,"height":36},{"text":"데","x":1829,"y":1044,"width":24,"height":35}]},{"text":"이터율 때문인데, 이더넷이 그때마다 같거나 그 이상의 데이터율로 동작하는 버전을","words":[{"text":"이터율","x":546,"y":1100,"width":99,"height":38},{"text":"때문인데,","x":662,"y":1099,"width":139,"height":39},{"text":"이더넷이","x":820,"y":1099,"width":129,"height":38},{"text":"그때마다","x":969,"y":1100,"width":134,"height":38},{"text":"같거나","x":1120,"y":1100,"width":102,"height":37},{"text":"그","x":1238,"y":1105,"width":33,"height":26},{"text":"이상의","x":1291,"y":1100,"width":99,"height":38},{"text":"데이터율로","x":1412,"y":1102,"width":177,"height":37},{"text":"동작하는","x":1607,"y":1103,"width":141,"height":37},{"text":"버전을","x":1767,"y":1102,"width":89,"height":39}]},{"text":"만들어서 경쟁했다. 또한 스위치 이더넷(Switched Ethernet)이 1990년대 초반에 소개","words":[{"text":"만들어서","x":545,"y":1161,"width":129,"height":39},{"text":"경쟁했다.","x":693,"y":1160,"width":138,"height":39},{"text":"또한","x":847,"y":1161,"width":67,"height":36},{"text":"스위치","x":926,"y":1160,"width":97,"height":39},{"text":"이더넷(Switched","x":1042,"y":1161,"width":256,"height":38},{"text":"Ethernet)이","x":1313,"y":1162,"width":182,"height":39},{"text":"1990년대","x":1518,"y":1163,"width":146,"height":37},{"text":"초반에","x":1682,"y":1163,"width":99,"height":37},{"text":"소개","x":1797,"y":1165,"width":56,"height":37}]},{"text":"되면서 데이터율을 더 증가시켰다. 끝으로, 이더넷은 아주 인기가 좋았으므로 이더넷","words":[{"text":"되면서","x":545,"y":1223,"width":96,"height":38},{"text":"데이터율을","x":661,"y":1222,"width":166,"height":39},{"text":"더","x":843,"y":1222,"width":27,"height":38},{"text":"증가시켰다.","x":889,"y":1222,"width":175,"height":37},{"text":"끝으로,","x":1081,"y":1223,"width":109,"height":36},{"text":"이더넷은","x":1209,"y":1221,"width":138,"height":38},{"text":"아주","x":1363,"y":1223,"width":70,"height":37},{"text":"인기가","x":1451,"y":1223,"width":105,"height":39},{"text":"좋았으므로","x":1571,"y":1224,"width":177,"height":38},{"text":"이더넷","x":1766,"y":1224,"width":88,"height":39}]},{"text":"하드웨어(어댑터, 스위치 누는 필수-용-품처럼 되었고 따라서 상당히 저렴하다.","words":[{"text":"하드웨어(어댑터,","x":545,"y":1283,"width":254,"height":40},{"text":"스위치","x":812,"y":1282,"width":96,"height":38},{"text":"누는","x":924,"y":1284,"width":80,"height":37},{"text":"필수-용-품처럼","x":1017,"y":1282,"width":196,"height":38},{"text":"되었고","x":1231,"y":1281,"width":102,"height":39},{"text":"따라서","x":1347,"y":1284,"width":100,"height":37},{"text":"상당히","x":1464,"y":1284,"width":103,"height":38},{"text":"저렴하다.","x":1587,"y":1285,"width":147,"height":37}]},{"text":"최초의 이더넷 랜은 봅 멧칼프(Bob Metcalfe)와 데이비드 보그스(Daⅷ Boggs)","words":[{"text":"최초의","x":612,"y":1345,"width":95,"height":38},{"text":"이더넷","x":727,"y":1343,"width":96,"height":39},{"text":"랜은","x":840,"y":1343,"width":66,"height":37},{"text":"봅","x":919,"y":1343,"width":34,"height":37},{"text":"멧칼프(Bob","x":968,"y":1343,"width":175,"height":39},{"text":"Metcalfe)와","x":1159,"y":1344,"width":190,"height":38},{"text":"데이비드","x":1364,"y":1344,"width":140,"height":38},{"text":"보그스(Daⅷ","x":1520,"y":1348,"width":218,"height":36},{"text":"Bogg