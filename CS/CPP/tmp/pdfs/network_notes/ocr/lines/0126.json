102,"height":37},{"text":"포함하는","x":1180,"y":2358,"width":138,"height":38},{"text":"하나의","x":1333,"y":2358,"width":102,"height":37},{"text":"인터뗏","x":1456,"y":2358,"width":102,"height":39},{"text":"네임","x":1577,"y":2358,"width":65,"height":38},{"text":"서버를","x":1663,"y":2359,"width":107,"height":37},{"text":"생각할","x":1786,"y":2358,"width":102,"height":37}]},{"text":"수 있다. 이러한 중앙 집중 방식에서, 클라이언트는 모든 질의를 단일 네임 서버로 보","words":[{"text":"수","x":555,"y":2422,"width":35,"height":36},{"text":"있다.","x":606,"y":2421,"width":74,"height":37},{"text":"이러한","x":698,"y":2420,"width":101,"height":38},{"text":"중앙","x":812,"y":2420,"width":69,"height":37},{"text":"집중","x":897,"y":2419,"width":65,"height":38},{"text":"방식에서,","x":976,"y":2419,"width":142,"height":38},{"text":"클라이언트는","x":1135,"y":2419,"width":207,"height":39},{"text":"모든","x":1355,"y":2420,"width":71,"height":35},{"text":"질의를","x":1442,"y":2418,"width":105,"height":38},{"text":"단일","x":1561,"y":2418,"width":68,"height":38},{"text":"네임","x":1648,"y":2419,"width":66,"height":37},{"text":"서버로","x":1735,"y":2418,"width":105,"height":38},{"text":"보","x":1854,"y":2421,"width":32,"height":28}]},{"text":"내고, DNS 서버는 질의 클라이언트에게 직접 응답한다. 이 방식은 간단하므로 매력이","words":[{"text":"내고,","x":557,"y":2482,"width":75,"height":37},{"text":"DNS","x":646,"y":2485,"width":77,"height":29},{"text":"서버는","x":739,"y":2481,"width":100,"height":37},{"text":"질의","x":854,"y":2480,"width":62,"height":37},{"text":"클라이언트에게","x":932,"y":2480,"width":233,"height":38},{"text":"직접","x":1183,"y":2480,"width":63,"height":38},{"text":"응답한다.","x":1262,"y":2479,"width":146,"height":39},{"text":"이","x":1426,"y":2479,"width":29,"height":37},{"text":"방식은","x":1473,"y":2479,"width":106,"height":38},{"text":"간단하므로","x":1592,"y":2480,"width":178,"height":37},{"text":"매력이","x":1786,"y":2478,"width":97,"height":39}]},{"text":"있지만, 수많은 호스트를 가진 오늘날의 인터넷에는 적합하지 않다. 이 방식의 문제점","words":[{"text":"있지만,","x":558,"y":2542,"width":108,"height":38},{"text":"수많은","x":682,"y":2541,"widt