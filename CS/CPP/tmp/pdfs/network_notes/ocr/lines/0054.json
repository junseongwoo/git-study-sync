9,"y":1423,"width":136,"height":38},{"text":"전달한다.","x":1359,"y":1423,"width":143,"height":37},{"text":"TCP는","x":1517,"y":1424,"width":110,"height":35},{"text":"애플리케이션에","x":1641,"y":1422,"width":225,"height":43}]},{"text":"게 연결지향형 서비스를 제공한다. 이 서비스는 목적지로의 애플리케이션 계층 메시지","words":[{"text":"게","x":559,"y":1486,"width":29,"height":37},{"text":"연결지향형","x":606,"y":1486,"width":164,"height":37},{"text":"서비스를","x":788,"y":1486,"width":135,"height":37},{"text":"제공한다.","x":936,"y":1485,"width":143,"height":38},{"text":"이","x":1096,"y":1486,"width":28,"height":37},{"text":"서비스는","x":1141,"y":1485,"width":135,"height":38},{"text":"목적지로의","x":1288,"y":1484,"width":169,"height":38},{"text":"애플리케이션","x":1475,"y":1483,"width":206,"height":39},{"text":"계층","x":1697,"y":1484,"width":68,"height":37},{"text":"메시지","x":1778,"y":1484,"width":87,"height":40}]},{"text":"전달 보장과 흐름제어(송신자/수신자의 속도 일지를 포함한다. 또한 TCP는 긴 메시","words":[{"text":"전달","x":558,"y":1546,"width":67,"height":37},{"text":"보장과","x":640,"y":1547,"width":104,"height":37},{"text":"흐름제어(송신자/수신자의","x":759,"y":1546,"width":394,"height":39},{"text":"속도","x":1171,"y":1546,"width":68,"height":36},{"text":"일지를","x":1258,"y":1545,"width":113,"height":39},{"text":"포함한다.","x":1386,"y":1545,"width":146,"height":37},{"text":"또한","x":1551,"y":1545,"width":71,"height":36},{"text":"TCP는","x":1636,"y":1547,"width":109,"height":34},{"text":"긴","x":1763,"y":1544,"width":28,"height":36},{"text":"메시","x":1810,"y":1545,"width":54,"height":40}]},{"text":"지를 짧은 메시지로 나누고 혼잡제어 기능을 제공하여, 네트워크가 혼잡할 때 출발지","words":[{"text":"지를","x":558,"y":1608,"width":67,"height":38},{"text":"짧은","x":639,"y":1608,"width":69,"height":37},{"text":"메시지로","x":722,"y":1608,"width":136,"height":38},{"text":"나누고","x":873,"y":1607,"width":101,"height":39},{"text":"혼잡제어","x":989,"y":1607,"width":132,"height":38},{"text":"기능을","x":1141,"y":1606,"width":100,"height":38},{"text":"제공하여,","x":1257,"y":1605,"width":143,"height":39},{"text":"네트워크가","x":1419,"y":1605,"width":174,"height":38},{"text":"혼잡할","x":1606,"y":1606,"width":107,"height":37},{"text":"때","x":1728,"y":1606,"width":29,"height":36},{"text":"출발지","x":1775,"y":1605,"width":89,"height":41}]},{"text":"의 전송속도를 줄이도록 한다. UDP 프로토콜은 애플리케이션에 비연결형 서비스를","words":[{"text":"의","x":558,"y":1669,"width":28,"height":38},{"text":"전송속도를","x":608,"y":1669,"width":171,"height":37},{"text":"줄이도록","x":794,"y":1668,"width":136,"height":38},{"text":"한다.","x":947,"y":1668,"width":75,"height":38},{"text":"UDP","x":1041,"y":1673,"width":78,"height":29},{"text":"프로토콜은","x":1135,"y":1667,"width":171,"height":37},{"text":"애플리케이션에","x":1324,"y":1666,"width":239,"height":38},{"text":"비연결형","x":1585,"y":1666,"width":134,"height":38},{"text":"서비스를","x":1742,"y":1666,"width":125,"height":40}]},{"text":"제공한다. 이 서비스는 신뢰성, 흐름제어, 혼잡제어를 제공하지 않는 아주 간단한 서비","words":[{"text":"제공한다.","x":559,"y":1730,"width":140,"height":38},{"text":"이","x":716,"y":1730,"width":29,"height":38},{"text":"서비스는","x":763,"y":1730,"width":134,"height":38},{"text":"신뢰성,","x":911,"y":1729,"width":107,"height":38},{"text":"흐름제어,","x":1033,"y":1728,"width":143,"height":39},{"text":"혼잡제어를","x":1192,"y":1728,"width":170,"height":38},{"text":"제공하지","x":1375,"y":1727,"width":134,"height":38},{"text":"않는","x":1528,"y":1728,"width":69,"height":37},{"text":"아주","x":1611,"y":1728,"width":70,"height":37},{"text":"간단한","x":1694,"y":1728,"width":102,"height":36},{"text":"서비","x":1808,"y":1728,"width":56,"height":40}]},{"text":"스다. 이 책에서는 트랜스포트 계층 패킷을 세그먼트(segment)라고 한다.","words":[{"text":"스다.","x":558,"y":1792,"width":75,"height":37},{"text":"이","x":648,"y":1792,"width":29,"height":38},{"text":"책에서는","x":693,"y":1791,"width":134,"height":38},{"text":"트랜스포트","x":838,"y":1790,"width":169,"height":36},{"text":"계층","x":1021,"y":1790,"width":67,"height":36},{"text":"패킷을","x":1101,"y":1790,"width":101,"height":36},{"text":"세그먼트(segment)라고","x":1213,"y":1788,"width":373,"height":40},{"text":"한다.","x":1598,"y":1788,"width":77,"height":37}]},{"text":"네트위크 계층","words":[{"text":"네트위크","x":562,"y":1898,"width":138,"height":35},{"text":"계층","x":709,"y":1896,"width":72,"height":43}]},{"text":"인터넷의 네트워크 계층은 한 호스트에서 다른 호入E 로 데이터그qdatagram)을 라","words":[{"text":"인터넷의","x":562,"y":1969,"width":128,"height":38},{"text":"네트워크","x":708,"y":1968,"width":131,"height":38},{"text":"계층은","x":854,"y":1968,"width":99,"height":37},{"text":"한","x":966,"y":1967,"width":35,"height":37},{"text":"호스트에서","x":1013,"y":1967,"width":165,"height":37},{"text":"다른","x":1196,"y":1967,"width":67,"height":37},{"text":"호入E","x":1280,"y":1969,"width":92,"height":30},{"text":"로","x":1383,"y":1970,"width":24,"height":28},{"text":"데이터그qdatagram)을","x":1427,"y":1965,"width":400,"height":41},{"text":"라","x":1840,"y":1967,"width":27,"height":37}]},{"text":"우팅하는 책임을 진다. 메일 서비스를 이용하기 위해 목적지 주소가 적힌 편지를 전달","words":[{"text":"우팅하는","x":560,"y":2030,"width":134,"height":37},{"text":"책임을","x":708,"y":2029,"width":99,"height":37},{"text":"진다.","x":822,"y":2029,"width":71,"height":37},{"text":"메일","x":910,"y":2028,"width":63,"height":38},{"text":"서비스를","x":990,"y":2028,"width":134,"height":38},{"text":"이용하기","x":1139,"y":2028,"width":129,"height":38},{"text":"위해","x":1288,"y":2028,"width":65,"height":37},{"text":"목적지","x":1368,"y":2026,"width":100,"height":38},{"text":"주소가","x":1485,"y":2027,"width":107,"height":38},{"text":"적힌","x":1608,"y":2027,"width":66,"height":38},{"text":"편지를","x":1692,"y":2026,"width":102,"height":38},{"text":"전달","x":1809,"y":2027,"width":58,"height":38}]},{"text":"하는 것처럼, 출발지 호스트에서 인터넷 트랜스포트 계층 프로토콜(TCP 또는 UDP)은","words":[{"text":"하는","x":560,"y":2089,"width":67,"height":37},{"text":"것처럼,","x":641,"y":2090,"width":106,"height":38},{"text":"출발지","x":760,"y":2090,"width":96,"height":38},{"text":"호스트에서","x":872,"y":2090,"width":163,"height":38},{"text":"인터넷","x":1053,"y":2089,"width":96,"height":38},{"text":"트랜스포트","x":1163,"y":2089,"width":171,"height":36},{"text":"계층","x":1348,"y":2088,"width":66,"height":38},{"text":"프로토콜(TCP","x":1426,"y":2090,"width":229,"height":37},{"text":"또는","x":1667,"y":2089,"width":71,"height":35},{"text":"UDP)은","x":1750,"y":2090,"width":117,"height":36}]},{"text":"트랜스포트 계층 세그먼트와 목적지 주소를 네트워크 계층으로 전달한다. 그 다음에","words":[{"text":"트랜스포트","x":560,"y":2151,"width":168,"height":36},{"text":"계층","x":746,"y":2151,"width":65,"height":38},{"text":"세그먼트와","x":826,"y":2151,"width":167,"height":38},{"text":"목적지","x":1008,"y":2151,"width":96,"height":38},{"text":"주소를","x":1124,"y":2151,"width":102,"height":37},{"text":"네트워크","x":1243,"y":2150,"width":136,"height":37},{"text":"계층으로","x":1396,"y":2149,"width":138,"height":38},{"text":"전달한다.","x":1553,"y":2149,"width":148,"height":38},{"text":"그","x":1721,"y":2154,"width":35,"height":26},{"text":"다음에","x":1774,"y":2149,"width":90,"height":40}]},{"text":"네트워크 계층은 목적지 호스트의 트랜스포트 계층으로 세그먼트를 운반하는 서비스","words":[{"text":"네트워크","x":561,"y":2211,"width":134,"height":38},{"text":"계층은","x":712,"y":2212,"width":99,"height":38},{"text":"목적지","x":825,"y":2213,"width":95,"height":38},{"text":"호스트의","x":939,"y":2212,"width":129,"height":38},{"text":"트랜스포트","x":1086,"y":2212,"width":168,"height":36},{"text":"계층으로","x":1271,"y":2211,"width":135,"height":38},{"text":"세그먼트를","x":1423,"y":2210,"width":176,"height":38},{"text":"운반하는","x":1614,"y":2210,"width":143,"height":38},{"text":"서비스","x":1773,"y":2210,"width":93,"height":37}]},{"text":"를 제공한다.","words":[{"text":"를","x":558,"y":2273,"width":36,"height":35},{"text":"제공한다.","x":606,"y":2273,"width":142,"height":38}]},{"text":"인터넷의 네트워크 계층은 두 가지 주요 요소를 갖는다. 이 계층은 IP 데이터그램","words":[{"text":"인터넷의","x":628,"y":2334,"width":129,"height":38},{"text":"네트워크","x":775,"y":2335,"width":131,"height":38},{"text":"계층은","x":921,"y":2335,"width":98,"height":38},{"text":"두","x":1031,"y":2337,"width":33,"height":35},{"text":"가지","x":1078,"y":2334,"width":61,"height":39},{"text":"주요","x":1156,"y":2336,"width":67,"height":35},{"text":"요소를","x":1237,"y":2336,"width":102,"height":35},{"text":"갖는다.","x":1353,"y":2333,"width":110,"height":38},{"text":"이","x":1482,"y":2333,"width":29,"height":37},{"text":"계층은","x":1531,"y":2333,"width":106,"height":37},{"text":"IP","x":1650,"y":2337,"width":36,"height":28},{"text":"데이터그램","x":1703,"y":2333,"width":160,"height":37}]},{"text":"의 필드를 정의하며 종단 시스템과 라우터가 이 필드에 어떻게 동작하는지를 정의하는 :","words":[{"text":"의","x":558,"y":2393,"width":30,"height":37},{"text":"필드를","x":606,"y":2394,"width":101,"height":37},{"text":"정의하며","x":721,"y":2395,"width":127,"height":38},{"text":"종단","x":864,"y":2396,"width":67,"height":38},{"text":"시스템과","x":944,"y":2395,"width":131,"height":38},{"text":"라우터가","x":1087,"y":2395,"width":133,"height":37},{"text":"이","x":1233,"y":2395,"width":28,"height":37},{"text":"필드에","x":1279,"y":2395,"width":97,"height":37},{"text":"어떻게","x":1393,"y":2394,"width":100,"height":38},{"text":"동작하는지를","x":1509,"y":2393,"width":214,"height":38},{"text":"정의하는","x":1736,"y":2393,"width":130,"height":38},{"text":":","x":1885,"y":2405,"width":5,"height":32}]},{"text":"프로토콜을 갖고 있다. 이 프로토콜이 그 유명한 IP 프로토콜이다. 오직 하나의 IP 프","words":[{"text":"프로토콜을","x":557,"y":2455,"width":171,"height":37},{"text":"갖고","x":743,"y":2456,"width":66,"height":37},{"text":"있다.","x":826,"y":2457,"width":69,"height":37},{"text":"이","x":914,"y":2456,"width":28,"height":38},{"text":"프로토콜이","x":959,"y":2456,"width":161,"height":38},{"text":"그","x":1138,"y":2461,"width":33,"height":26},{"text":"유명한","x":1184,"y":2456,"width":102,"height":37},{"text":"IP","x":1299,"y":2461,"width":34,"height":27},{"text":"프로토콜이다.","x":1348,"y":2454,"width":216,"height":38},{"text":"오직","x":1582,"y":2454,"width":67,"height":37},{"text":"하나의","x":1670,"y":2454,"width":101,"height":38},{"text":"IP","x":1789,"y":2459,"width":33,"height":28},{"text":"프","x":1835,"y":2458,"width":29,"height":27}]},{"text":"로토콜이 있고, 네트워크 계층을 가진 모든 인터넷 요소는 IP 프로토콜을 수행해야만","words":[{"text":"로토콜이","x":556,"y":2516,"width":133,"height":37},{"text":"있고,","x":711,"y":2516,"width":72,"height":37},{"text":"네트워크","x":801,"y":2516,"width":131,"height":38},{"text":"계층을","x":948,"y":2517,"width":98,"height":36},{"text":"가진","x":1061,"y":2516,"width":63,"height":37},{"text":"모든","x":1139,"y":2518,"width":67,"height":34},{"text":"인터넷","x":1223,"y":2516,"width":96,"height":37},{"text":"요소는","x":1336,"y":2518,"width":103,"height":34},{"text":"IP","x":1455,"y":2521,"width":34,"height":27},{"text":"프로토콜을","x":1506,"y":2516,"width":178,"height":37},{"text":"수행해야만","x":1698,"y":2514,"width":168,"height":39}]},{"text":"한다. 또한 인터넷 네트워크 계층은 출발지와 목적지 사이에서 데이터그램이 이동하는","words":[{"text":"한다.","x":555,"y":2575,"width":77,"height":38},{"text":"또한","x":647,"y":2576,"width":69,"height":36},{"text":"인터넷","x":731,"y":2576,"width":94,"height":37},{"text":"네트워크","x":841,"y":2576,"width":132,"height":38},{"text":"계층은","x":987,"y":2576,"width":98,"height":37},{"text":"출발지와","x":1096,"y":2576,"width":134,"height":37},{"text":"목적지","x":1241,"y":2576,"width":97,"height":38},{"text":"사이에서","x":1355,"y":2576,"width":134,"height":38},{"text":"데이터그램이","x":1509,"y":2576,"width":208,"height":39},{"text":"이동하는","x":1736,"y":2575,"width":128,"height":39}]}]}