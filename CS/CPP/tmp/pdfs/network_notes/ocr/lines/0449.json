h":131,"height":37},{"text":"도착한","x":696,"y":1562,"width":102,"height":37},{"text":"인터페이스,","x":812,"y":1562,"width":174,"height":37},{"text":"(3)","x":1000,"y":1568,"width":44,"height":34},{"text":"현재","x":1060,"y":1563,"width":63,"height":38},{"text":"시간을","x":1140,"y":1564,"width":101,"height":37},{"text":"테이블에","x":1254,"y":1563,"width":130,"height":38},{"text":"저장","x":1401,"y":1563,"width":66,"height":37}]},{"text":"한다. 이런 식으로 스위치는 테이블에 송신 노드가 상주하는 랜 세그먼트를 기록","words":[{"text":"한다.","x":224,"y":1621,"width":73,"height":38},{"text":"이런","x":317,"y":1623,"width":65,"height":37},{"text":"식으로","x":400,"y":1624,"width":101,"height":36},{"text":"스위치는","x":515,"y":1623,"width":136,"height":38},{"text":"테이블에","x":667,"y":1623,"width":131,"height":37},{"text":"송신","x":814,"y":1622,"width":67,"height":38},{"text":"노드가","x":897,"y":1623,"width":104,"height":37},{"text":"상주하는","x":1014,"y":1624,"width":139,"height":38},{"text":"랜","x":1169,"y":1625,"width":31,"height":36},{"text":"세그먼트를","x":1216,"y":1624,"width":169,"height":37},{"text":"기록","x":1401,"y":1624,"width":66,"height":37}]},{"text":"한다. 랜에 있는 모든 흐八E가 프레임을 송신하면, 결국 모든 호스트에 대한 정보","words":[{"text":"한다.","x":223,"y":1682,"width":74,"height":38},{"text":"랜에","x":315,"y":1684,"width":64,"height":38},{"text":"있는","x":397,"y":1684,"width":67,"height":38},{"text":"모든","x":475,"y":1686,"width":69,"height":34},{"text":"흐八E가","x":560,"y":1683,"width":132,"height":38},{"text":"프레임을","x":703,"y":1683,"width":135,"height":37},{"text":"송신하면,","x":849,"y":1683,"width":145,"height":38},{"text":"결국","x":1010,"y":1684,"width":68,"height":37},{"text":"모든","x":1090,"y":1687,"width":69,"height":35},{"text":"호스트에","x":1171,"y":1686,"width":133,"height":36},{"text":"대한","x":1321,"y":1685,"width":66,"height":37},{"text":"정보","x":1400,"y":1685,"width":66,"height":38}]},{"text":"가 테이블에 기록되게 된다.","words":[{"text":"가","x":224,"y":1743,"width":33,"height":37},{"text":"테이블에","x":270,"y":1744,"width":133,"height":38},{"text":"기록되게","x":420,