96,"y":1427,"width":114,"height":35},{"text":"트랜스포트","x":1125,"y":1425,"width":173,"height":37},{"text":"계층","x":1316,"y":1426,"width":67,"height":38},{"text":"프로토콜이","x":1398,"y":1426,"width":170,"height":38},{"text":"할","x":1588,"y":1426,"width":36,"height":37},{"text":"수","x":1637,"y":1427,"width":35,"height":37},{"text":"있는","x":1690,"y":1426,"width":67,"height":37},{"text":"최소","x":1774,"y":1425,"width":64,"height":38},{"text":"기","x":1853,"y":1430,"width":23,"height":38}]},{"text":"능으로 동작 한다. UDP는 다중화/역다중화 기능과 간단한 오류 검사 기능을 제외하면","words":[{"text":"능으로","x":554,"y":1485,"width":104,"height":37},{"text":"동작","x":669,"y":1487,"width":71,"height":38},{"text":"한다.","x":752,"y":1487,"width":75,"height":38},{"text":"UDP는","x":842,"y":1490,"width":114,"height":34},{"text":"다중화/역다중화","x":969,"y":1486,"width":253,"height":39},{"text":"기능과","x":1235,"y":1487,"width":104,"height":38},{"text":"간단한","x":1352,"y":1488,"width":104,"height":37},{"text":"오류","x":1468,"y":1490,"width":70,"height":36},{"text":"검사","x":1553,"y":1488,"width":69,"height":38},{"text":"기능을","x":1636,"y":1488,"width":103,"height":38},{"text":"제외하면","x":1753,"y":1487,"width":127,"height":42}]},{"text":"IP에 아무것도 추가하지 않는다. 사실 애플리케이션 개발자가 TCP 대신에 UDP를 선","words":[{"text":"IP에","x":555,"y":1547,"width":66,"height":39},{"text":"아무것도","x":638,"y":1548,"width":137,"height":39},{"text":"추가하지","x":788,"y":1549,"width":132,"height":38},{"text":"않는다.","x":939,"y":1548,"width":109,"height":39},{"text":"사실","x":1065,"y":1547,"width":67,"height":39},{"text":"애플리케이션","x":1149,"y":1548,"width":204,"height":40},{"text":"개발자가","x":1370,"y":1549,"width":139,"height":39},{"text":"TCP","x":1521,"y":1554,"width":74,"height":29},{"text":"대신에","x":1610,"y":1549,"width":102,"height":39},{"text":"UDP를","x":1728,"y":1551,"width":111,"height":36},{"text":"선","x":1851,"y":1553,"width":28,"height":37}]},{"text":"택한다면 애플리케이션은 거의 IP와 직접 통신하는 셈이다. UDP는 애플리게이션 프","words":[{"text":"택한다면","x":558,"y":1609,"width":134,"height":39},{"text":"애플리케이션은","x":709,"y":1611,"width":238,"height":38},{"text":"거의","x":963,"y":1611,"width":64,"height":38},{"text":"IP와","x":1046,"y":1610,"width":71,"height":38},{"text":"직접","x":1133,"y":1610,"width":63,"height":38},{"text":"통신하는","x":1215,"y":1610,"width":139,"height":39},{"text":"셈이다.","x":1369,"y":1611,"width":112,"height":38},{"text":"UDP는","x":1500,"y":1614,"width":116,"height":35},{"text":"애플리게이션","x":1632,"y":1611,"width":204,"height":38},{"text":"프","x":1851,"y":1618,"width":29,"height":28}]},{"text":"로세스로부터 메시지를 가져와서 다중화/역다중화 서비스에 대한 출발지 포트 번호 필","words":[{"text":"로세스로부터","x":557,"y":1672,"width":199,"height":38},{"text":"메시지를","x":774,"y":1673,"width":135,"height":37},{"text":"가져와서","x":923,"y":1671,"width":132,"height":39},{"text":"다중화/역다중화","x":1073,"y":1672,"width":253,"height":38},{"text":"서비스에","x":1338,"y":1672,"width":136,"height":39},{"text":"대한","x":1492,"y":1673,"width":69,"height":38},{"text":"출발지","x":1573,"y":1674,"width":101,"height":38},{"text":"포트","x":1692,"y":1677,"width":69,"height":28},{"text":"번호","x":1776,"y":1673,"width":64,"height":37},{"text":"필","x":1853,"y":1677,"width":25,"height":37}]},{"text":"드와 목적지 포트 번호 필드를 첨부하고 다른 두 필드들을 추가한 후에 최종 세그먼트","words":[{"text":"드와","x":558,"y":1734,"width":69,"height":38},{"text":"목적지","x":638,"y":1734,"width":98,"height":38},{"text":"포트","x":753,"y":1738,"width":67,"height":28},{"text":"번호","x":836,"y":1734,"width":65,"height":37},{"text":"필드를","x":916,"y":1734,"width":102,"height":37},{"text":"첨부하고","x":1032,"y":1734,"width":137,"height":38},{"text":"다른","x":1183,"y":1734,"width":68,"height":38},{"text":"두","x":1263,"y":1735,"width":36,"height":35},{"text":"필드들을","x":1313,"y":1734,"width":139,"height":37},{"text":"추가한","x":1464,"y":1735,"width":107,"height":38},{"text":"후에","x":1583,"y":1736,"width":68,"height":38},{"text":"최종","x":1669,"y":1736,"width":70,"height":37},{"text":"세그먼트","x":1752,"y":1735,"width":129,"height":37}]},{"text":"를 네트워크 계층으로 넘겨준다. 네트워크 계층은 트랜스포트 계층 세그먼트를 IP 데","words":[{"text":"를","x":558,"y":1797,"width":34,"height":35},{"text":"네트워크","x":607,"y":1796,"width":134,"height":37},{"text":"계층으로","x":757,"y":1797,"width":134,"height":36},{"text":"넘겨준다.","x":907,"y":1796,"width":143,"height":37},{"text":"네트워크","x":1070,"y":1795,"width":135,"height":38},{"text":"계층은","x":1221,"y":1795,"width":103,"height":38},{"text":"트랜스포트","x":1338,"y":1796,"width":175,"height":36},{"text":"계층","x":1530,"y":1797,"width":69,"height":38},{"text":"세그먼트를","x":1614,"y":1798,"width":177,"height":37},{"text":"IP","x":1805,"y":1802,"width":33,"height":28},{"text":"데","x":1853,"y":1800,"width":25,"height":37}]},{"text":"이터그램으로 캡슐화하고, 세그먼트를 수신 호스트에게 “최선형” 전달 서비스로 전달","words":[{"text":"이터그램으로","x":560,"y":1857,"width":200,"height":38},{"text":"캡슐화하고,","x":777,"y":1857,"width":175,"height":38},{"text":"세그먼트를","x":969,"y":1857,"width":173,"height":38},{"text":"수신","x":1156,"y":1857,"width":67,"height":38},{"text":"호스트에게","x":1239,"y":1857,"width":171,"height":38},{"text":"“최선형”","x":1429,"y":1857,"width":133,"height":38},{"text":"전달","x":1579,"y":1859,"width":71,"height":37},{"text":"서비스로","x":1666,"y":1859,"width":139,"height":38},{"text":"전달","x":1821,"y":1859,"width":61,"height":39}]},{"text":"한다. 만약 세그먼트가 수신 호스트에 도착한다면, UDP는 세그먼트의 데이터를 해당","words":[{"text":"한다.","x":559,"y":1918,"width":74,"height":38},{"text":"만약","x":650,"y":1918,"width":68,"height":37},{"text":"세그먼트가","x":730,"y":1918,"width":170,"height":39},{"text":"수신","x":913,"y":1918,"width":67,"height":38},{"text":"호스트에","x":996,"y":1918,"width":134,"height":36},{"text":"도착한다면,","x":1147,"y":1917,"width":179,"height":39},{"text":"UDP는","x":1343,"y":1920,"width":115,"height":35},{"text":"세그먼트의","x":1472,"y":1919,"width":174,"height":39},{"text":"데이터를","x":1666,"y":1920,"width":139,"height":38},{"text":"해당","x":1820,"y":1920,"width":62,"height":39}]},{"text":"하는 애플리케이션 프로세스로 전달하기 위해서 목적지 포트 번호를 사용한다. UDP","words":[{"text":"하는","x":559,"y":1979,"width":67,"height":39},{"text":"애플리케이션","x":642,"y":1979,"width":201,"height":39},{"text":"프로세스로","x":859,"y":1979,"width":169,"height":38},{"text":"전달하기","x":1045,"y":1978,"width":131,"height":39},{"text":"위해서","x":1197,"y":1978,"width":97,"height":39},{"text":"목적지","x":1314,"y":1979,"width":100,"height":38},{"text":"포트","x":1434,"y":1983,"width":70,"height":28},{"text":"번호를","x":1522,"y":1980,"width":105,"height":38},{"text":"사용한다.","x":1643,"y":1981,"width":148,"height":38},{"text":"UDP","x":1809,"y":1986,"width":72,"height":30}]},{"text":"는 세그먼트를 송신하기 전에 송신 트랜스포트 계층 개체들과 수신 트랜스포트 계층","words":[{"text":"는","x":558,"y":2043,"width":34,"height":35},{"text":"세그먼트를","x":608,"y":2040,"width":170,"height":39},{"text":"송신하기","x":792,"y":2041,"width":130,"height":39},{"text":"전에","x":944,"y":2041,"width":63,"height":37},{"text":"송신","x":1025,"y":2040,"width":68,"height":38},{"text":"트랜스포트","x":1109,"y":2041,"width":171,"height":36},{"text":"계층","x":1297,"y":2040,"width":69,"height":38},{"text":"개체들과","x":1383,"y":2040,"width":139,"height":38},{"text":"수신","x":1536,"y":2042,"width":71,"height":37},{"text":"트랜스포트","x":1624,"y":2042,"width":178,"height":37},{"text":"계층","x":1819,"y":2042,"width":60,"height":39}]},{"text":"개체들 사이에 핸드세이크를 사용하지 않는다는 점에 주의하자. 이런 이유로 UDP를","words":[{"text":"개체들","x":561,"y":2103,"width":99,"height":38},{"text":"사이에","x":675,"y":2103,"width":99,"height":39},{"text":"핸드세이크를","x":793,"y":2103,"width":201,"height":39},{"text":"사용하지","x":1010,"y":2102,"width":130,"height":38},{"text":"않는다는","x":1162,"y":2101,"width":135,"height":38},{"text":"점에","x":1314,"y":2102,"width":64,"height":38},{"text":"주의하자.","x":1396,"y":2102,"width":147,"height":38},{"text":"이런","x":1564,"y":2103,"width":68,"height":38},{"text":"이유로","x":1651,"y":2103,"width":105,"height":38},{"text":"UDP를","x":1773,"y":2105,"width":106,"height":36}]},{"text":"비연결형이라고 한다.","words":[{"text":"비연결형이라고","x":561,"y":2164,"width":226,"height":38},{"text":"한다.","x":798,"y":2165,"width":75,"height":38}]},{"text":"DNS는 일반적으로 UDP를 사용하는 애플리케이션 계층 프로토콜의 예이다. 호스","words":[{"text":"DNS는","x":624,"y":2227,"width":113,"height":35},{"text":"일반적으로","x":751,"y":2226,"width":165,"height":38},{"text":"UDP를","x":928,"y":2227,"width":111,"height":35},{"text":"사용하는","x":1051,"y":2225,"width":135,"height":39},{"text":"애플리케이션","x":1199,"y":2225,"width":203,"height":39},{"text":"계층","x":1418,"y":2226,"width":68,"height":38},{"text":"프로토콜의","x":1498,"y":2227,"width":173,"height":37},{"text":"예이다.","x":1690,"y":2225,"width":111,"height":39},{"text":"호스","x":1816,"y":2228,"width":62,"height":30}]},{"text":"트에서 DNS 애플리게이션이 질의를 생성할 때, DNS 질의 메시지를 작성하고 UDP","words":[{"text":"트에서","x":559,"y":2286,"width":96,"height":38},{"text":"DNS","x":675,"y":2291,"width":76,"height":29},{"text":"애플리게이션이","x":770,"y":2287,"width":230,"height":39},{"text":"질의를","x":1022,"y":2287,"width":99,"height":38},{"text":"생성할","x":1136,"y":2287,"width":102,"height":39},{"text":"때,","x":1254,"y":2287,"width":40,"height":39},{"text":"DNS","x":1311,"y":2292,"width":77,"height":30},{"text":"질의","x":1408,"y":2287,"width":64,"height":39},{"text":"메시지를","x":1492,"y":2287,"width":141,"height":39},{"text":"작성하고","x":1649,"y":2288,"width":143,"height":38},{"text":"UDP","x":1807,"y":2293,"width":71,"height":28}]},{"text":"에게 메시지를 넘겨준다. 목적지 종단 시스템 상에서 동작하는 UDP 개체와 호스트 측","words":[{"text":"에게","x":560,"y":2346,"width":62,"height":39},{"text":"메시지를","x":639,"y":2347,"width":135,"height":39},{"text":"넘겨준다.","x":788,"y":2348,"width":141,"height":39},{"text":"목적지","x":944,"y":2349,"width":98,"height":38},{"text":"종단","x":1058,"y":2349,"width":68,"height":38},{"text":"시스템","x":1139,"y":2349,"width":96,"height":38},{"text":"상에서","x":1250,"y":2350,"width":99,"height":38},{"text":"동작하는","x":1366,"y":2349,"width":140,"height":39},{"text":"UDP","x":1518,"y":2354,"width":81,"height":29},{"text":"개체와","x":1614,"y":2350,"width":108,"height":38},{"text":"호스트","x":1734,"y":2351,"width":103,"height":31},{"text":"측","x":1848,"y":2349,"width":30,"height":38}]},{"text":"UDP는 어떠한 핸드세이크도 수행하지 않고 메시지에 헤더 필드를 추가한 후에 최종","words":[{"text":"UDP는","x":559,"y":2410,"width":110,"height":35},{"text":"어떠한","x":686,"y":2408,"width":101,"height":40},{"text":"핸드세이크도","x":801,"y":2409,"width":203,"height":39},{"text":"수행하지","x":1018,"y":2410,"width":131,"height":38},{"text":"않고","x":1169,"y":2410,"width":66,"height":39},{"text":"메시지에","x":1250,"y":2411,"width":133,"height":38},{"text":"헤더","x":1402,"y":2410,"width":64,"height":38},{"text":"필드를","x":1489,"y":2411,"width":104,"height":37},{"text":"추가한","x":1607,"y":2411,"width":109,"height":39},{"text":"후에","x":1731,"y":2411,"width":67,"height":38},{"text":"최종","x":1817,"y":2410,"width":63,"height":38}]},{"text":"세그먼트를 네트워크 계층에 넘겨준다. 네트워크 계층은 UDP 세그먼트를 데이터그램","words":[{"text":"세그먼트를","x":559,"y":2469,"width":168,"height":38},{"text":"네트워크","x":741,"y":2471,"width":134,"height":38},{"text":"계층에","x":890,"y":2470,"width":97,"height":38},{"text":"넘겨준다.","x":1006,"y":2471,"width":139,"height":39},{"text":"네트워크","x":1162,"y":2472,"width":134,"height":38},{"text":"계층은","x":1310,"y":2473,"width":102,"height":37},{"text":"UDP","x":1425,"y":2477,"width":79,"height":29},{"text":"세그먼트를","x":1518,"y":2472,"width":179,"height":39},{"text":"데이터그램","x":1712,"y":2472,"width":165,"height":39}]},{"text":"으로 캡슐화하고 네임(name) 서버에 데이터그램을 송신한다. 이때, 질의 호스트에서","words":[{"text":"으로","x":559,"y":2533,"width":65,"height":29},{"text":"캡슐화하고","x":643,"y":2530,"width":167,"height":39},{"text":"네임(name)","x":828,"y":2532,"width":175,"height":39},{"text":"서버에","x":1023,"y":2532,"width":96,"height":39},{"text":"데이터그램을","x":1140,"y":2533,"width":202,"height":38},{"text":"송신한다.","x":1357,"y":2533,"width":147,"height":38},{"text":"이때,","x":1525,"y":2534,"width":78,"height":38},{"text":"질의","x":1624,"y":2535,"width":65,"height":38},{"text":"호스트에서","x":1711,"y":2533,"width":165,"height":37}]},{"text":"의 DNS 애플리케이션은 질의에 대한 응답을 기다린다. 만약 질의 호스트가 응답을 수","words":[{"text":"의","x":561,"y":2591,"width":28,"height":37},{"text":"DNS","x":604,"y":2596,"width":74,"height":29},{"text":"애플리케이션은","x":694,"y":2592,"width":237,"height":39},{"text":"질의에","x":945,"y":2593,"width":98,"height":38},{"text":"대한","x":1060,"y":2594,"width":67,"height":37},{"text":"응답을","x":1138,"y":2594,"width":102,"height":37},{"text":"기다린다.","x":1253,"y":2594,"width":142,"height":38},{"text":"만약","x":1410,"y":2594,"width":71,"height":37},{"text":"질의","x":1495,"y":2595,"width":65,"height":37},{"text":"호스트가","x":1576,"y":2596,"width":145,"height":37},{"text":"응답을","x":1732,"y":2596,"width":107,"height":37},{"text":"수","x":1849,"y":2595,"width":31,"height":36}]}]}