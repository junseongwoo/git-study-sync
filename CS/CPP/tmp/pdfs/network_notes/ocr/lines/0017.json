{"page":17,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"1.2 • 네트위크의 가장자리","words":[{"text":"1.2","x":1076,"y":143,"width":41,"height":25},{"text":"•","x":1152,"y":149,"width":13,"height":13},{"text":"네트위크의","x":1200,"y":142,"width":134,"height":30},{"text":"가장자리","x":1347,"y":142,"width":107,"height":32}]},{"text":"사용하는 친숙한 요소. 즉 매일 A卜%하는 컴퓨터, 스마트폰과 다른 장치에 대해 다문","words":[{"text":"사용하는","x":139,"y":267,"width":138,"height":40},{"text":"친숙한","x":295,"y":267,"width":101,"height":39},{"text":"요소.","x":411,"y":270,"width":78,"height":37},{"text":"즉","x":506,"y":272,"width":35,"height":37},{"text":"매일","x":558,"y":270,"width":65,"height":39},{"text":"A卜%하는","x":641,"y":271,"width":138,"height":40},{"text":"컴퓨터,","x":798,"y":271,"width":108,"height":40},{"text":"스마트폰과","x":925,"y":273,"width":176,"height":39},{"text":"다른","x":1118,"y":273,"width":70,"height":40},{"text":"장치에","x":1203,"y":273,"width":102,"height":40},{"text":"대해","x":1327,"y":273,"width":64,"height":39},{"text":"다문","x":1411,"y":273,"width":68,"height":40}]},{"text":"다. 다음 절에서는 네트위그의 가장자리(edge)에서 네트워크 중심(core)으로 이동하","words":[{"text":"다.","x":139,"y":327,"width":40,"height":38},{"text":"다음","x":200,"y":328,"width":69,"height":38},{"text":"절에서는","x":288,"y":328,"width":137,"height":39},{"text":"네트위그의","x":443,"y":328,"width":170,"height":42},{"text":"가장자리(edge)에서","x":634,"y":332,"width":306,"height":43},{"text":"네트워크","x":963,"y":333,"width":140,"height":39},{"text":"중심(core)으로","x":1121,"y":335,"width":237,"height":39},{"text":"이동하","x":1377,"y":335,"width":104,"height":39}]},{"text":"고, 컴퓨터 네트워크에서의 스위칭(교환)과 라우팅(경로설정)에 대해 살펴볼 것이다.","words":[{"text":"고,","x":136,"y":392,"width":43,"height":34},{"text":"컴퓨터","x":196,"y":389,"width":97,"height":38},{"text":"네트워크에서의","x":312,"y":389,"width":238,"height":42},{"text":"스위칭(교환)과","x":566,"y":393,"width":233,"height":40},{"text":"라우팅(경로설정)에","x":814,"y":393,"width":302,"height":41},{"text":"대해","x":1135,"y":395,"width":65,"height":39},{"text":"살펴볼"