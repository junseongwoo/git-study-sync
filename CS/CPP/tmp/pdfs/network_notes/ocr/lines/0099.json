{"page":99,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"2.2 • 탭과 HTTP","words":[{"text":"2.2","x":1172,"y":157,"width":41,"height":25},{"text":"•","x":1247,"y":163,"width":12,"height":13},{"text":"탭과","x":1293,"y":157,"width":51,"height":30},{"text":"HTTP","x":1355,"y":159,"width":79,"height":26}]},{"text":"부터 HTTP 응답 메시지를 받는다. 마찬가지로 HTrP 서버는 소길! 인터페이스로부터","words":[{"text":"부터","x":166,"y":284,"width":61,"height":36},{"text":"HTTP","x":245,"y":288,"width":93,"height":29},{"text":"응답","x":353,"y":283,"width":65,"height":38},{"text":"메시지를","x":433,"y":283,"width":131,"height":37},{"text":"받는다.","x":578,"y":283,"width":107,"height":37},{"text":"마찬가지로","x":702,"y":283,"width":166,"height":38},{"text":"HTrP","x":883,"y":288,"width":96,"height":30},{"text":"서버는","x":995,"y":285,"width":100,"height":37},{"text":"소길!","x":1109,"y":285,"width":65,"height":37},{"text":"인터페이스로부터","x":1192,"y":285,"width":260,"height":39}]},{"text":"요청 에시지를 받고 응답 에시지를 소켓 인터페이스로 보낸다. 일단 클라이언트가 메","words":[{"text":"요청","x":165,"y":343,"width":62,"height":38},{"text":"에시지를","x":247,"y":343,"width":130,"height":38},{"text":"받고","x":393,"y":343,"width":65,"height":37},{"text":"응답","x":472,"y":343,"width":67,"height":38},{"text":"에시지를","x":555,"y":343,"width":132,"height":37},{"text":"소켓","x":702,"y":343,"width":64,"height":38},{"text":"인터페이스로","x":786,"y":344,"width":200,"height":39},{"text":"보낸다.","x":1002,"y":344,"width":109,"height":38},{"text":"일단","x":1130,"y":345,"width":66,"height":37},{"text":"클라이언트가","x":1211,"y":345,"width":199,"height":38},{"text":"메","x":1425,"y":346,"width":29,"height":38}]},{"text":"시지를 소켓 인터페이스로 보내면. 에시지는 “글라이인트의 손을 떠난“ 것이고 \"TCP","words":[{"text":"시지를","x":166,"y":403,"width":98,"height":37},{"text":"소켓","x":279,"y":403,"width":64,"height":38},{"text":"인터페이스로","x":362,"y":403,"width":197,"height":37},{"text":"보내면.","x":575,"y":403,"width":107,"height":38},{"text":"에시지는","x":701,"y":403,"width":132,"height":39},{"text":"“글라이인트의","x":848,"y":405,"width":