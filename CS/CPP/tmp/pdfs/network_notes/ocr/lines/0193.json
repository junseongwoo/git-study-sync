text":"UDP","x":1596,"y":836,"width":68,"height":29}]},{"text":"일반적으로 UDP","words":[{"text":"일반적으로","x":1441,"y":904,"width":144,"height":30},{"text":"UDP","x":1596,"y":904,"width":68,"height":28}]},{"text":"그림 3.6 • 인기 있는 인터넷 애플리케이션과 그 하위 트랜스포트 프로토콜","words":[{"text":"그림","x":535,"y":988,"width":55,"height":30},{"text":"3.6","x":602,"y":989,"width":51,"height":29},{"text":"•","x":668,"y":996,"width":16,"height":14},{"text":"인기","x":699,"y":989,"width":54,"height":31},{"text":"있는","x":765,"y":989,"width":57,"height":31},{"text":"인터넷","x":832,"y":989,"width":83,"height":31},{"text":"애플리케이션과","x":928,"y":989,"width":200,"height":31},{"text":"그","x":1136,"y":993,"width":30,"height":23},{"text":"하위","x":1177,"y":989,"width":55,"height":32},{"text":"트랜스포트","x":1243,"y":990,"width":145,"height":30},{"text":"프로토콜","x":1397,"y":991,"width":117,"height":30}]},{"text":"그림 3.6은 인기 있는 인터넷 애플리게이션과 인터넷 애플리케이션이 사용하는 트","words":[{"text":"그림","x":600,"y":1133,"width":64,"height":37},{"text":"3.6은","x":680,"y":1134,"width":84,"height":36},{"text":"인기","x":778,"y":1132,"width":61,"height":38},{"text":"있는","x":859,"y":1133,"width":67,"height":37},{"text":"인터넷","x":941,"y":1133,"width":98,"height":38},{"text":"애플리게이션과","x":1055,"y":1133,"width":242,"height":38},{"text":"인터넷","x":1311,"y":1133,"width":100,"height":38},{"text":"애플리케이션이","x":1427,"y":1132,"width":240,"height":39},{"text":"사용하는","x":1684,"y":1131,"width":138,"height":38},{"text":"트","x":1834,"y":1139,"width":30,"height":29}]},{"text":"랜스포트 프로토콜의 목록을 나타낸다. 전자메일, 원격 터미널 접속, 웹, TCP상의 파","words":[{"text":"랜스포트","x":535,"y":1194,"width":135,"height":36},{"text":"프로토콜의","x":684,"y":1193,"width":168,"height":38},{"text":"목록을","x":870,"y":1194,"width":104,"height":37},{"text":"나타낸다.","x":990,"y":1193,"width":144,"height":39},{"text":"전자메일,","x":1154,"y":1193,"width":145,"height":39},{"text":"원격","x":1317,"y":1194,"width":64,"height":38},{"text":"터미널","x":1403,"y":1194,"width":100,"height":38},{"text":"접속,","x":1523,"y":1194,"width":76,"height":38},{"text":"웹,","x":1618,"y":1194,"width":43,"height":37},{"text":"TCP상의","x":1677,"y":1193,"width":139,"height":38},{"text":"파","x":1834,"y":1197,"width":31,"height":38}]},{"text":"일 전송 등은 TCP에서 동작한다. 이러한 모든 애플리케이션은 TCP의 신뢰적인 데이","words":[{"text":"일","x":535,"y":1254,"width":29,"height":37},{"text":"전송","x":582,"y":1255,"width":67,"height":37},{"text":"등은","x":662,"y":1256,"width":70,"height":36},{"text":"TCP에서","x":744,"y":1254,"width":138,"height":38},{"text":"동작한다.","x":899,"y":1254,"width":146,"height":38},{"text":"이러한","x":1064,"y":1254,"width":103,"height":37},{"text":"모든","x":1180,"y":1257,"width":70,"height":34},{"text":"애플리케이션은","x":1265,"y":1255,"width":244,"height":38},{"text":"TCP의","x":1522,"y":1254,"width":106,"height":38},{"text":"신뢰적인","x":1648,"y":1254,"width":138,"height":37},{"text":"데이","x":1803,"y":1256,"width":58,"height":41}]},{"text":"터 전송 서비스를 필요로 한다. 그렇지만 많은 중요한 애플리케이션은 TCP보다 UDP","words":[{"text":"터","x":534,"y":1315,"width":28,"height":38},{"text":"전송","x":581,"y":1315,"width":68,"height":38},{"text":"서비스를","x":662,"y":1316,"width":137,"height":37},{"text":"필요로","x":814,"y":1315,"width":101,"height":37},{"text":"한다.","x":928,"y":1315,"width":76,"height":38},{"text":"그렇지만","x":1021,"y":1314,"width":139,"height":38},{"text":"많은","x":1173,"y":1316,"width":70,"height":37},{"text":"중요한","x":1256,"y":1316,"width":106,"height":37},{"text":"애플리케이션은","x":1376,"y":1315,"width":244,"height":38},{"text":"TCP보다","x":1633,"y":1315,"width":146,"height":38},{"text":"UDP","x":1792,"y":1320,"width":73,"height":33}]},{"text":"에서 동작한다. 예를 들자면 UDP는 네트워크 관리(SNMP 관련 5.7절 참조) 데이터를","words":[{"text":"에서","x":533,"y":1376,"width":63,"height":37},{"text":"동작한다.","x":612,"y":1376,"width":145,"height":38},{"text":"예를","x":773,"y":1376,"width":67,"height":37},{"text":"들자면","x":852,"y":1376,"width":102,"height":37},{"text":"UDP는","x":968,"y":1377,"width":115,"height":34},{"text":"네트워크","x":1096,"y":1375,"width":138,"height":38},{"text":"관리(SNMP","x":1247,"y":1376,"width":192,"height":39},{"text":"관련","x":1451,"y":1376,"width":69,"height":36},{"text":"5.7절","x":1534,"y":1376,"width":85,"height":37},{"text":"참조)","x":1634,"y":1376,"width":82,"height":39},{"text":"데이터를","x":1733,"y":1376,"width":131,"height":41}]},{"text":"전달하는데 시용된다. 네트워크 관리 애플리케이션은 네트워크가 혼잡한 상태에 있을","words":[{"text":"전달하는데","x":533,"y":1436,"width":166,"height":39},{"text":"시용된다.","x":716,"y":1436,"width":144,"height":39},{"text":"네트워크","x":878,"y":1437,"width":136,"height":37},{"text":"관리","x":1028,"y":1435,"width":65,"height":38},{"text":"애플리케이션은","x":1113,"y":1435,"width":244,"height":40},{"text":"네트워크가","x":1372,"y":1437,"width":174,"height":37},{"text":"혼잡한","x":1559,"y":1437,"width":108,"height":37},{"text":"상태에","x":1680,"y":1438,"width":104,"height":38},{"text":"있을","x":1803,"y":1440,"width":62,"height":39}]},{"text":"때 자주 동작해야 하므로 이러한 경우에는 UDP가 TCP보다 더 좋다(과도한 상태에서,","words":[{"text":"때","x":532,"y":1498,"width":29,"height":37},{"text":"자주","x":577,"y":1497,"width":68,"height":38},{"text":"동작해야","x":657,"y":1497,"width":138,"height":39},{"text":"하므로","x":806,"y":1498,"width":103,"height":37},{"text":"이러한","x":923,"y":1496,"width":102,"height":39},{"text":"경우에는","x":1039,"y":1496,"width":137,"height":39},{"text":"UDP가","x":1187,"y":1498,"width":117,"height":38},{"text":"TCP보다","x":1314,"y":1498,"width":144,"height":37},{"text":"더","x":1472,"y":1497,"width":29,"height":39},{"text":"좋다(과도한","x":1518,"y":1498,"width":192,"height":39},{"text":"상태에서,","x":1722,"y":1500,"width":141,"height":42}]},{"text":"신뢰적이거나 혼잡제어 된 데이터 전송은 수행하기가 어렵다). 또한 앞에서 이야기 하","words":[{"text":"신뢰적이거나","x":531,"y":1558,"width":204,"height":39},{"text":"혼잡제어","x":747,"y":1558,"width":134,"height":39},{"text":"된","x":899,"y":1558,"width":32,"height":37},{"text":"데이터","x":947,"y":1557,"width":97,"height":40},{"text":"전송은","x":1064,"y":1557,"width":104,"height":39},{"text":"수행하기가","x":1180,"y":1559,"width":177,"height":38},{"text":"어렵다).","x":1371,"y":1558,"width":124,"height":40},{"text":"또한","x":1511,"y":1559,"width":72,"height":37},{"text":"앞에서","x":1597,"y":1560,"width":101,"height":38},{"text":"이야기","x":1719,"y":1561,"width":97,"height":39},{"text":"하","x":1834,"y":1564,"width":31,"height":38}]},{"text":"였지만, DNS는 TCP의 연결 설정 지연을 피하기 위해서 UDP에서 동작한다.","words":[{"text":"였지만,","x":532,"y":1619,"width":107,"height":39},{"text":"DNS는","x":653,"y":1622,"width":113,"height":35},{"text":"TCP의","x":777,"y":1621,"width":103,"height":38},{"text":"연결","x":898,"y":1620,"width":63,"height":37},{"text":"설정","x":977,"y":1619,"width":64,"height":39},{"text":"지연을","x":1059,"y":1619,"width":103,"height":37},{"text":"피하기","x":1176,"y":1620,"width":98,"height":38},{"text":"위해서","x":1293,"y":1620,"width":99,"height":39},{"text":"UDP에서","x":1408,"y":1621,"width":147,"height":38},{"text":"동작한다.","x":1571,"y":1622,"width":150,"height":38}]},{"text":"그림 3.6에서 보는 것과 같이, UDP와 TCP가 인터넷 전화, 실시간 비디오 회의,","words":[{"text":"그림","x":595,"y":1681,"width":64,"height":38},{"text":"3.6에서","x":679,"y":1682,"width":113,"height":39},{"text":"보는","x":812,"y":1683,"width":68,"height":36},{"text":"것과","x":897,"y":1681,"width":68,"height":39},{"text":"같이,","x":980,"y":1681,"width":76,"height":39},{"text":"UDP와","x":1073,"y":1681,"width":117,"height":38},{"text":"TCP가","x":1204,"y":1682,"width":110,"height":38},{"text":"인터넷","x":1332,"y":1682,"width":100,"height":39},{"text":"전화,","x":1452,"y":1682,"width":76,"height":40},{"text":"실시간","x":1547,"y":1683,"width":107,"height":39},{"text":"비디오","x":1672,"y":1684,"width":104,"height":38},{"text":"회의,","x":1794,"y":1686,"width":69,"height":39}]},{"text":"저장된 오디오와 비디오의 스트리밍 같은 멀티미디어 애플리게이션에 종종 모두 사용","words":[{"text":"저장된","x":531,"y":1743,"width":98,"height":38},{"text":"오디오와","x":645,"y":1744,"width":137,"height":38},{"text":"비디오의","x":797,"y":1743,"width":131,"height":40},{"text":"스트리밍","x":945,"y":1743,"width":133,"height":38},{"text":"같은","x":1097,"y":1742,"width":70,"height":38},{"text":"멀티미디어","x":1182,"y":1744,"width":169,"height":39},{"text":"애플리게이션에","x":1371,"y":1744,"width":242,"height":40},{"text":"종종","x":1630,"y":1748,"width":71,"height":37},{"text":"모두","x":1715,"y":1749,"width":71,"height":35},{"text":"사용","x":1800,"y":1748,"width":64,"height":39}]},{"text":"된다. 9장에서 이러한 애플리케이션을 더 자세히 살펴볼 것이다. 이러한 모든 애플리","words":[{"text":"된다.","x":531,"y":1805,"width":74,"height":38},{"text":"9장에서","x":622,"y":1806,"width":117,"height":38},{"text":"이러한","x":761,"y":1806,"width":101,"height":38},{"text":"애플리케이션을","x":877,"y":1805,"width":240,"height":39},{"text":"더","x":1134,"y":1805,"width":28,"height":38},{"text":"자세히","x":1182,"y":1806,"width":101,"height":39},{"text":"살펴볼","x":1302,"y":1806,"width":106,"height":39},{"text":"것이다.","x":1425,"y":1807,"width":112,"height":39},{"text":"이러한","x":1557,"y":1808,"width":106,"height":39},{"text":"모든","x":1678,"y":1810,"width":72,"height":36},{"text":"애플리","x":1767,"y":1809,"width":93,"height":39}]},{"text":"케이션에서 적은 양의 패킷 손실은 허용할 수 있다. 그래서 신뢰적인 데이터 전송이 애","words":[{"text":"케이션에서","x":532,"y":1867,"width":163,"height":39},{"text":"적은","x":714,"y":1868,"width":66,"height":38},{"text":"양의","x":793,"y":1868,"width":62,"height":38},{"text":"패킷","x":873,"y":1868,"width":64,"height":38},{"text":"손실은","x":952,"y":1867,"width":104,"height":38},{"text":"허용할","x":1069,"y":1867,"width":103,"height":39},{"text":"수","x":1183,"y":1868,"width":36,"height":38},{"text":"있다.","x":1234,"y":1868,"width":74,"height":39},{"text":"그래서","x":1324,"y":1869,"width":101,"height":38},{"text":"신뢰적인","x":1443,"y":1869,"width":140,"height":38},{"text":"데이터","x":1598,"y":1870,"width":101,"height":39},{"text":"전송이","x":1719,"y":1871,"width":98,"height":37},{"text":"애","x":1834,"y":1872,"width":27,"height":37}]},{"text":"플리게이션의 성능에 절대적으로 중요한 것만은 아니다. 게다가 인터넷 전화와 화상","words":[{"text":"플리게이션의","x":530,"y":1929,"width":200,"height":39},{"text":"성능에","x":751,"y":1930,"width":97,"height":39},{"text":"절대적으로","x":869,"y":1929,"width":169,"height":39},{"text":"중요한","x":1055,"y":1930,"width":105,"height":38},{"text":"것만은","x":1178,"y":1930,"width":102,"height":38},{"text":"아니다.","x":1297,"y":1930,"width":112,"height":39},{"text":"게다가","x":1430,"y":1931,"width":106,"height":39},{"text":"인터넷","x":1555,"y":1932,"width":102,"height":39},{"text":"전화와","x":1678,"y":1932,"width":106,"height":38},{"text":"화상","x":1800,"y":1933,"width":65,"height":38}]},{"text":"회의 같은 실시간 애플리케이션은 TCP 혼잡제어가 나쁜 영향을 미친다. 그래서 멀티","words":[{"text":"회의","x":532,"y":1991,"width":62,"height":39},{"text":"같은","x":613,"y":1992,"width":67,"height":37},{"text":"실시간","x":696,"y":1992,"width":101,"height":38},{"text":"애플리케이션은","x":812,"y":1992,"width":237,"height":38},{"text":"TCP","x":1062,"y":1996,"width":73,"height":30},{"text":"혼잡제어가","x":1150,"y":1992,"width":174,"height":38},{"text":"나쁜","x":1339,"y":1992,"width":70,"height":38},{"text":"영향을","x":1426,"y":1992,"width":105,"height":39},{"text":"미친다.","x":1547,"y":1994,"width":113,"height":38},{"text":"그래서","x":1678,"y":1994,"width":102,"height":38},{"text":"멀티","x":1801,"y":1994,"width":58,"height":38}]},{"text":"미디어 애플리케이션 개발자는 그들의 애플리게이션을 TCP 대신에 UDP에서 동작하","words":[{"text":"미디어","x":532,"y":2053,"width":95,"height":39},{"text":"애플리케이션","x":647,"y":2054,"width":200,"height":39},{"text":"개발자는","x":864,"y":2054,"width":134,"height":39},{"text":"그들의","x":1012,"y":2054,"width":99,"height":38},{"text":"애플리게이션을","x":1130,"y":2054,"width":242,"height":38},{"text":"TCP","x":1385,"y":2059,"width":74,"height":29},{"text":"대신에","x":1476,"y":2055,"width":102,"height":39},{"text":"UDP에서","x":1595,"y":2056,"width":151,"height":38},{"text":"동작하","x":1764,"y":2056,"width":100,"height":39}]},{"text":"도록 구현한다. 패킷 손실률이 낮고, 보안적인 이유로 UDP 트래픽을 막는(8장을 참","words":[{"text":"도록","x":529,"y":2117,"width":69,"height":36},{"text":"구현한다.","x":614,"y":2115,"width":142,"height":38},{"text":"패킷","x":777,"y":2116,"width":64,"height":38},{"text":"손실률이","x":859,"y":2115,"width":131,"height":39},{"text":"낮고,","x":1012,"y":2116,"width":75,"height":38},{"text":"보안적인","x":1106,"y":2116,"width":135,"height":37},{"text":"이유로","x":1262,"y":2116,"width":102,"height":38},{"text":"UDP","x":1382,"y":2121,"width":80,"height":28},{"text":"트래픽을","x":1479,"y":2118,"width":145,"height":38},{"text":"막는(8장을","x":1641,"y":2118,"width":176,"height":40},{"text":"참","x":1833,"y":2118,"width":31,"height":37}]},{"text":"조) 일부 조직에서 TCP는 점점 더 스트리밍 매체 전송에 매력적인 프로토콜이 되고","words":[{"text":"조)","x":529,"y":2182,"width":45,"height":34},{"text":"일부","x":594,"y":2177,"width":66,"height":38},{"text":"조직에서","x":676,"y":2177,"width":131,"height":38},{"text":"TCP는","x":826,"y":2179,"width":106,"height":35},{"text":"점점","x":950,"y":2177,"width":61,"height":37},{"text":"더","x":1033,"y":2177,"width":28,"height":38},{"text":"스트리밍","x":1082,"y":2177,"width":132,"height":39},{"text":"매체","x":1235,"y":2178,"width":66,"height":38},{"text":"전송에","x":1322,"y":2178,"width":101,"height":38},{"text":"매력적인","x":1443,"y":2178,"width":140,"height":39},{"text":"프로토콜이","x":1603,"y":2180,"width":175,"height":37},{"text":"되고","x":1800,"y":2179,"width":63,"height":38}]},{"text":"있다.","words":[{"text":"있다.","x":532,"y":2239,"width":72,"height":37}]},{"text":"비록 오늘날 멀티미디어 애플리케이션을 UDP 위에서 동작시카는 방법이 일반적","words":[{"text":"비록","x":597,"y":2301,"width":66,"height":38},{"text":"오늘날","x":677,"y":2300,"width":103,"height":37},{"text":"멀티미디어","x":796,"y":2300,"width":163,"height":38},{"text":"애플리케이션을","x":979,"y":2301,"width":237,"height":38},{"text":"UDP","x":1230,"y":2306,"width":78,"height":28},{"text":"위에서","x":1325,"y":2302,"width":99,"height":38},{"text":"동작시카는","x":1443,"y":2303,"width":180,"height":39},{"text":"방법이","x":1640,"y":2304,"width":103,"height":39},{"text":"일반적","x":1765,"y":2303,"width":95,"height":38}]},{"text":"0 로 사\u0026되지만 아직 논의의 여지가 있다. 앞에서 언급한 것처럼 UDP는 혼잡제어를","words":[{"text":"0","x":536,"y":2364,"width":19,"height":19},{"text":"로","x":568,"y":2366,"width":23,"height":28},{"text":"사\u0026되지만","x":611,"y":2361,"width":170,"height":39},{"text":"아직","x":795,"y":2361,"width":62,"height":39},{"text":"논의의","x":876,"y":2361,"width":98,"height":39},{"text":"여지가","x":994,"y":2362,"width":101,"height":38},{"text":"있다.","x":1110,"y":2363,"width":72,"height":38},{"text":"앞에서","x":1199,"y":2362,"width":97,"height":38},{"text":"언급한","x":1317,"y":2363,"width":103,"height":38},{"text":"것처럼","x":1436,"y":2364,"width":101,"height":38},{"text":"UDP는","x":1556,"y":2368,"width":119,"height":35},{"text":"혼잡제어를","x":1690,"y":2365,"width":174,"height":39}]},{"text":"하지 않는다. 그러나 혼잡제어는 네트워크가 폭주 상대에 빠지는 것을 막기 위해 필요","words":[{"text":"하지","x":530,"y":2423,"width":63,"height":38},{"text":"않는다.","x":611,"y":2423,"width":108,"height":39},{"text":"그러나","x":736,"y":2423,"width":101,"height":39},{"text":"혼잡제어는","x":851,"y":2423,"width":170,"height":39},{"text":"네트워크가","x":1037,"y":2424,"width":167,"height":39},{"text":"폭주","x":1216,"y":2426,"width":69,"height":36},{"text":"상대에","x":1298,"y":2424,"width":101,"height":39},{"text":"빠지는","x":1417,"y":2425,"width":107,"height":39},{"text":"것을","x":1541,"y":2427,"width":70,"height":38},{"text":"막기","x":1625,"y":2428,"width":67,"height":38},{"text":"위해","x":1714,"y":2427,"width":67,"height":39},{"text":"필요","x":1800,"y":2427,"width":64,"height":37}]},{"text":"하다. 만약 모두가 혼잡제어를 시용하지 않고 높은 비트의 비디오 스트리밍을 시작한","words":[{"text":"하다.","x":532,"y":2485,"width":73,"height":38},{"text":"만약","x":623,"y":2485,"width":67,"height":38},{"text":"모두가","x":705,"y":2485,"width":102,"height":38},{"text":"혼잡제어를","x":821,"y":2485,"width":170,"height":38},{"text":"시용하지","x":1008,"y":2486,"width":129,"height":38},{"text":"않고","x":1157,"y":2486,"width":66,"height":38},{"text":"높은","x":1237,"y":2487,"width":70,"height":36},{"text":"비트의","x":1324,"y":2487,"width":98,"height":38},{"text":"비디오","x":1444,"y":2488,"width":105,"height":38},{"text":"스트리밍을","x":1565,"y":2490,"width":182,"height":38},{"text":"시작한","x":1763,"y":2488,"width":102,"height":40}]},{"text":"다면, 라우터에서 많은 패것 오버플로가 발생할 것이고, 이는 소수의 UDP 패킷만이","words":[{"text":"다면,","x":533,"y":2546,"width":74,"height":38},{"text":"라우터에서","x":626,"y":2546,"width":163,"height":39},{"text":"많은","x":811,"y":2547,"width":68,"height":38},{"text":"패것","x":896,"y":2547,"width":64,"height":38},{"text":"오버플로가","x":979,"y":2547,"width":169,"height":39},{"text":"발생할","x":1164,"y":2548,"width":101,"height":38},{"text":"것이고,","x":1284,"y":2548,"width":108,"height":39},{"text":"이는","x":1413,"y":2549,"width":71,"height":38},{"text":"소수의","x":1501,"y":2552,"width":102,"height":38},{"text":"UDP","x":1624,"y":2557,"width":83,"height":28},{"text":"패킷만이","x":1728,"y":2549,"width":132,"height":41}]}]}