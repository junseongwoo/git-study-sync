"y":1921,"width":69,"height":37},{"text":"원도","x":1280,"y":1922,"width":66,"height":36},{"text":"안에","x":1361,"y":1921,"width":65,"height":38},{"text":"있","x":1445,"y":1922,"width":31,"height":37}]},{"text":"는 모든 세그먼트들은 송신된다.","words":[{"text":"는","x":182,"y":1983,"width":32,"height":34},{"text":"모든","x":225,"y":1982,"width":67,"height":34},{"text":"세그먼트들은","x":305,"y":1980,"width":204,"height":37},{"text":"송신된다.","x":521,"y":1980,"width":142,"height":37}]},{"text":"앞의 제약은 송신자의 확인응답이 안 된 데이터 크기를 제한하고 그에 따라 송신","words":[{"text":"앞의","x":246,"y":2040,"width":62,"height":38},{"text":"제약은","x":327,"y":2041,"width":103,"height":37},{"text":"송신자의","x":443,"y":2041,"width":133,"height":38},{"text":"확인응답이","x":593,"y":2040,"width":164,"height":39},{"text":"안","x":776,"y":2041,"width":33,"height":36},{"text":"된","x":823,"y":2041,"width":31,"height":36},{"text":"데이터","x":871,"y":2041,"width":93,"height":38},{"text":"크기를","x":982,"y":2042,"width":100,"height":38},{"text":"제한하고","x":1096,"y":2042,"width":134,"height":38},{"text":"그에","x":1245,"y":2043,"width":65,"height":37},{"text":"따라","x":1327,"y":2043,"width":68,"height":38},{"text":"송신","x":1408,"y":2044,"width":67,"height":37}]},{"text":"자의 송신율 을 간접 제한한다. 이를 이해하기 위해 손실과 패것 전송 지연이 무시될","words":[{"text":"자의","x":181,"y":2102,"width":61,"height":37},{"text":"송신율","x":260,"y":2101,"width":103,"height":38},{"text":"을","x":378,"y":2103,"width":34,"height":36},{"text":"간접","x":428,"y":2102,"width":63,"height":36},{"text":"제한한다.","x":511,"y":2102,"width":143,"height":37},{"text":"이를","x":673,"y":2101,"width":65,"height":38},{"text":"이해하기","x":754,"y":2101,"width":126,"height":39},{"text":"위해","x":901,"y":2103,"width":61,"height":38},{"text":"손실과","x":979,"y":2103,"width":100,"height":38},{"text":"패것","x":1094,"y":2103,"width":64,"height":37},{"text":"전송","x":1176,"y":2103,"width":67,"height":38},{"text":"지연이","x":1259,"y":2104,"width":96,"height":38},{"text":"무시될","x":1374,"y":2104,"width":100,"height":38}]},{"text":"수 있는 연결을 고려하