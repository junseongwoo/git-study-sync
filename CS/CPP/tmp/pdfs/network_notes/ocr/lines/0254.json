{"page":254,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"3.7 • TCP 혼잡제어","words":[{"text":"3.7","x":1153,"y":150,"width":41,"height":24},{"text":"•","x":1226,"y":155,"width":12,"height":13},{"text":"TCP","x":1270,"y":151,"width":60,"height":26},{"text":"혼잡제어","x":1341,"y":146,"width":102,"height":31}]},{"text":"TCP 혼잡제어","words":[{"text":"TCP","x":338,"y":280,"width":107,"height":43},{"text":"혼잡제어","x":460,"y":277,"width":198,"height":56}]},{"text":"앞 3.5절에서 배운 것처럼 TCP는 다른 호스트에서 동작하는 두 프로세스 사이의 신뢰","words":[{"text":"앞","x":185,"y":400,"width":31,"height":37},{"text":"3.5절에서","x":229,"y":399,"width":148,"height":38},{"text":"배운","x":394,"y":401,"width":66,"height":36},{"text":"것처럼","x":475,"y":402,"width":92,"height":36},{"text":"TCP는","x":583,"y":404,"width":102,"height":34},{"text":"다른","x":699,"y":402,"width":63,"height":37},{"text":"호스트에서","x":775,"y":403,"width":160,"height":37},{"text":"동작하는","x":950,"y":402,"width":134,"height":38},{"text":"두","x":1097,"y":404,"width":33,"height":35},{"text":"프로세스","x":1144,"y":401,"width":134,"height":37},{"text":"사이의","x":1291,"y":401,"width":96,"height":37},{"text":"신뢰","x":1406,"y":400,"width":61,"height":37}]},{"text":"적인 전송 서비스를 제공한다. TCP의 다른 매우 중요한 요소는 TCP의 혼잡제어 메기","words":[{"text":"적인","x":185,"y":458,"width":62,"height":38},{"text":"전송","x":264,"y":459,"width":67,"height":38},{"text":"서비스를","x":345,"y":461,"width":133,"height":36},{"text":"제공한다.","x":493,"y":461,"width":136,"height":37},{"text":"TCP의","x":643,"y":462,"width":99,"height":36},{"text":"다른","x":759,"y":462,"width":64,"height":37},{"text":"매우","x":837,"y":462,"width":63,"height":36},{"text":"중요한","x":913,"y":462,"width":99,"height":37},{"text":"요소는","x":1025,"y":463,"width":102,"height":34},{"text":"TCP의","x":1139,"y":461,"width":101,"height":36},{"text":"혼잡제어","x":1257,"y":461,"width":130,"height":36},{"text":"메기","x":1406,"y":460,"width":61,"height":37}]},{"text":"니즘이다. 이전 절에서 지적한 것처럼 IP 계층이 네트위그 혼잡에 관해서 종단 시스템","words":[{"text":"니즘이다.","x":185,"y":519,"width":140,"height":38},{"text":"이전","x":343,"y":520,"width":64,"height":37},{"text":"절에서","x":424,"y":520,"width":94,"height":36},{"text":"지적한","x":536,"y":520,"width":97,"height":36},{"text":"것처럼","x":648,"y":520,"width":91,"height":37},{"text":"IP","x":757,"y":526,"width":32,"height":27},{"text":"계층이","x":805,"y":521,"width":91,"height":36},{"text":"네트위그","x":915,"y":520,"width":131,"height":37},{"text":"혼잡에","x":1060,"y":519,"width":100,"height":37},{"text":"관해서","x":1176,"y":519,"width":97,"height":37},{"text":"종단","x":1290,"y":520,"width":68,"height":37},{"text":"시스템","x":1373,"y":519,"width":95,"height":37}]},{"text":"에게 어떠한 직접적인 피드백도 제공하지 않으므로, TCP는 네트워그 지원 혼잡제어보","words":[{"text":"에게","x":184,"y":579,"width":61,"height":36},{"text":"어떠한","x":262,"y":579,"width":103,"height":37},{"text":"직접적인","x":378,"y":579,"width":129,"height":37},{"text":"피드백도","x":523,"y":579,"width":128,"height":37},{"text":"제공하지","x":665,"y":579,"width":125,"height":37},{"text":"않으므로,","x":807,"y":579,"width":137,"height":37},{"text":"TCP는","x":958,"y":580,"width":105,"height":34},{"text":"네트워그","x":1077,"y":578,"width":134,"height":38},{"text":"지원","x":1225,"y":579,"width":65,"height":37},{"text":"혼잡제어보","x":1304,"y":579,"width":168,"height":36}]},{"text":"다는 종단간의 혼잡제어를 사용해야 한다.","words":[{"text":"다는","x":183,"y":639,"width":65,"height":36},{"text":"종단간의","x":259,"y":639,"width":134,"height":36},{"text":"혼잡제어를","x":408,"y":639,"width":166,"height":37},{"text":"사용해야","x":586,"y":639,"width":131,"height":36},{"text":"한다.","x":728,"y":639,"width":71,"height":36}]},{"text":"TCP가 취한 접근방법은 네트워크 혼잡에 따라 연결에 트래피을 보내는 전송률을","words":[{"text":"TCP가","x":245,"y":699,"width":107,"height":37},{"text":"취한","x":368,"y":699,"width":65,"height":36},{"text":"접근방법은","x":447,"y":698,"width":164,"height":37},{"text":"네트워크","x":625,"y":698,"width":128,"height":37},{"text":"혼잡에","x":766,"y":698,"width":95,"height":37},{"text":"따라","x":879,"y":698,"width":66,"height":37},{"text":"연결에","x":960,"y":697,"width":96,"height":37},{"text":"트래피을","x":1072,"y":699,"width":137,"height":36},{"text":"보내는","x":1223,"y":699,"width":102,"height":37},{"text":"전송률을","x":1341,"y":699,"width":132,"height":37}]},{"text":"각 송신자가 제한하도록 하는 것이다. 만약 TCP 송신자가 자신과 목적지 간의 경로에","words":[{"text":"각","x":182,"y":759,"width":31,"height":36},{"text":"송신자가","x":227,"y":759,"width":135,"height":36},{"text":"제한하도록","x":377,"y":759,"width":165,"height":36},{"text":"하는","x":555,"y":758,"width":65,"height":36},{"text":"것이다.","x":635,"y":758,"width":101,"height":36},{"text":"만약","x":752,"y":758,"width":65,"height":36},{"text":"TCP","x":829,"y":761,"width":69,"height":29},{"text":"송신자가","x":912,"y":757,"width":136,"height":37},{"text":"자신과","x":1061,"y":758,"width":103,"height":38},{"text":"목적지","x":1176,"y":759,"width":98,"height":37},{"text":"간의","x":1293,"y":759,"width":63,"height":36},{"text":"경로에","x":1376,"y":759,"width":94,"height":37}]},{"text":"서 혼잡이 없음을 감지하면 송신자는 송신율을 높인다. 반면 송신자가 경로 사이에 혼","words":[{"text":"서","x":182,"y":820,"width":26,"height":36},{"text":"혼잡이","x":226,"y":818,"width":97,"height":38},{"text":"없음을","x":344,"y":819,"width":99,"height":36},{"text":"감지하면","x":456,"y":817,"width":130,"height":38},{"text":"송신자는","x":600,"y":817,"width":131,"height":38},{"text":"송신율을","x":743,"y":816,"width":132,"height":38},{"text":"높인다.","x":888,"y":817,"width":108,"height":38},{"text":"반면","x":1013,"y":817,"width":66,"height":37},{"text":"송신자가","x":1094,"y":818,"width":138,"height":39},{"text":"경로","x":1247,"y":820,"width":65,"height":37},{"text":"사이에","x":1326,"y":819,"width":98,"height":37},{"text":"혼","x":1441,"y":820,"width":33,"height":36}]},{"text":"잡을 감지하면 송신자는 송신율을 줄인다. 그러나 이것은 세 가지 의문을 제기한다. 첫","words":[{"text":"잡을","x":182,"y":879,"width":64,"height":36},{"text":"감지하면","x":260,"y":879,"width":133,"height":36},{"text":"송신자는","x":407,"y":878,"width":133,"height":37},{"text":"송신율을","x":551,"y":877,"width":132,"height":37},{"text":"줄인다.","x":695,"y":877,"width":104,"height":37},{"text":"그러나","x":814,"y":876,"width":100,"height":37},{"text":"이것은","x":928,"y":878,"width":100,"height":37},{"text":"세","x":1040,"y":878,"width":31,"height":37},{"text":"가지","x":1088,"y":878,"width":63,"height":38},{"text":"의문을","x":1169,"y":879,"width":102,"height":38},{"text":"제기한다.","x":1285,"y":880,"width":140,"height":37},{"text":"첫","x":1442,"y":880,"width":31,"height":36}]},{"text":"째, TCP 송신자는 자신의 연결에 송신자 전송 트래픽 전수를을 어떻게 제한하는가?","words":[{"text":"째,","x":182,"y":939,"width":38,"height":36},{"text":"TCP","x":238,"y":943,"width":70,"height":28},{"text":"송신자는","x":325,"y":938,"width":135,"height":38},{"text":"자신의","x":476,"y":937,"width":95,"height":38},{"text":"연결에","x":593,"y":937,"width":92,"height":37},{"text":"송신자","x":703,"y":936,"width":99,"height":38},{"text":"전송","x":819,"y":936,"width":64,"height":38},{"text":"트래픽","x":900,"y":937,"width":96,"height":38},{"text":"전수를을","x":1020,"y":938,"width":134,"height":38},{"text":"어떻게","x":1172,"y":940,"width":98,"height":37},{"text":"제한하는가?","x":1291,"y":939,"width":183,"height":38}]},{"text":"둘째, TCP 송신자는 자신과 목적지 사이 경로의 혼잡을 어떻게 감지하는가? 셋째, 송","words":[{"text":"둘째,","x":181,"y":999,"width":72,"height":37},{"text":"TCP","x":268,"y":1003,"width":71,"height":29},{"text":"송신자는","x":353,"y":999,"width":135,"height":37},{"text":"자신과","x":502,"y":997,"width":99,"height":38},{"text":"목적지","x":613,"y":997,"width":94,"height":37},{"text":"사이","x":725,"y":997,"width":61,"height":37},{"text":"경로의","x":806,"y":997,"width":93,"height":37},{"text":"혼잡을","x":917,"y":998,"width":101,"height":37},{"text":"어떻게","x":1034,"y":998,"width":97,"height":38},{"text":"감지하는가?","x":1149,"y":1000,"width":187,"height":38},{"text":"셋째,","x":1351,"y":1001,"width":75,"height":36},{"text":"송","x":1442,"y":1001,"width":33,"height":36}]},{"text":"신자는 종단간의 혼잡을 감지함에 따라 송신율을 변화시기기 위해서 어떤 알고리즘을","words":[{"text":"신자는","x":182,"y":1059,"width":97,"height":37},{"text":"종단간의","x":292,"y":1059,"width":132,"height":37},{"text":"혼잡을","x":441,"y":1058,"width":101,"height":38},{"text":"감지함에","x":556,"y":1057,"width":127,"height":38},{"text":"따라","x":699,"y":1057,"width":66,"height":38},{"text":"송신율을","x":777,"y":1057,"width":133,"height":38},{"text":"변화시기기","x":927,"y":1058,"width":162,"height":38},{"text":"위해서","x":1109,"y":1060,"width":97,"height":38},{"text":"어떤","x":1226,"y":1061,"width":64,"height":37},{"text":"알고리즘을","x":1307,"y":1061,"width":169,"height":38}]},{"text":"시용해야 하는가?","words":[{"text":"시용해야","x":181,"y":1119,"width":132,"height":38},{"text":"하는가?","x":325,"y":1119,"width":117,"height":38}]},{"text":"먼저 TCP 송신자가 연결로 트래픽을 보내는 전송률을 어떻게 제한하는지 살펴보","words":[{"text":"먼저","x":246,"y":1180,"width":61,"height":37},{"text":"TCP","x":323,"y":1185,"width":71,"height":28},{"text":"송신자가","x":408,"y":1180,"width":135,"height":38},{"text":"연결로","x":558,"y":1179,"width":96,"height":37},{"text":"트래픽을","x":668,"y":1179,"width":131,"height":38},{"text":"보내는","x":812,"y":1179,"width":101,"height":38},{"text":"전송률을","x":928,"y":1180,"width":133,"height":38},{"text":"어떻게","x":1076,"y":1181,"width":98,"height":38},{"text":"제한하는지","x":1191,"y":1183,"width":167,"height":38},{"text":"살펴보","x":1375,"y":1183,"width":102,"height":37}]},{"text":"자. 3.5절에서 TCP 연결의 양 끝 각 호스트들은 수신 버퍼, 송신 버퍼 그리고 몇 가지","words":[{"text":"자.","x":181,"y":1241,"width":39,"height":37},{"text":"3.5절에서","x":236,"y":1241,"width":143,"height":37},{"text":"TCP","x":396,"y":1246,"width":71,"height":29},{"text":"연결의","x":484,"y":1240,"width":94,"height":38},{"text":"양","x":596,"y":1241,"width":32,"height":37},{"text":"끝","x":641,"y":1242,"width":33,"height":35},{"text":"각","x":686,"y":1240,"width":34,"height":38},{"text":"호스트들은","x":733,"y":1241,"width":165,"height":36},{"text":"수신","x":911,"y":1242,"width":66,"height":37},{"text":"버퍼,","x":993,"y":1242,"width":73,"height":37},{"text":"송신","x":1081,"y":1242,"width":68,"height":37},{"text":"버퍼","x":1165,"y":1243,"width":62,"height":38},{"text":"그리고","x":1245,"y":1244,"width":103,"height":38},{"text":"몇","x":1364,"y":1244,"width":30,"height":37},{"text":"가지","x":1411,"y":1244,"width":62,"height":37}]},{"text":"의 변수(LastByteRead, rwnd 등)로 구성되는 것을 보았다. 송신 측에서 동작하는","words":[{"text":"의","x":182,"y":1302,"width":28,"height":37},{"text":"변수(LastByteRead,","x":227,"y":1302,"width":363,"height":41},{"text":"rwnd","x":605,"y":1308,"width":89,"height":27},{"text":"등)로","x":706,"y":1303,"width":79,"height":38},{"text":"구성되는","x":796,"y":1301,"width":134,"height":38},{"text":"것을","x":944,"y":1303,"width":66,"height":37},{"text":"보았다.","x":1022,"y":1303,"width":108,"height":37},{"text":"송신","x":1144,"y":1304,"width":68,"height":37},{"text":"측에서","x":1225,"y":1305,"width":100,"height":37},{"text":"동작하는","x":1341,"y":1305,"width":137,"height":37}]},{"text":"TCP 혼잡제어 메커니즘은 추가적인 변수인 혼잡 윈도우(congestion window)를 기록","words":[{"text":"TCP","x":180,"y":1367,"width":68,"height":29},{"text":"혼잡제어","x":260,"y":1362,"width":132,"height":39},{"text":"메커니즘은","x":409,"y":1364,"width":169,"height":38},{"text":"추가적인","x":588,"y":1363,"width":131,"height":38},{"text":"변수인","x":734,"y":1363,"width":96,"height":37},{"text":"혼잡","x":842,"y":1363,"width":68,"height":37},{"text":"윈도우(congestion","x":922,"y":1364,"width":286,"height":40},{"text":"window)를","x":1219,"y":1367,"width":179,"height":37},{"text":"기록","x":1412,"y":1366,"width":67,"height":38}]},{"text":"한다. cwnd로 표시되는 혼잡 원도우는 TCP 송신자가 네트워크로 트래픽을 전송할 수","words":[{"text":"한다.","x":181,"y":1424,"width":71,"height":38},{"text":"cwnd로","x":267,"y":1428,"width":118,"height":29},{"text":"표시되는","x":398,"y":1425,"width":136,"height":38},{"text":"혼잡","x":546,"y":1424,"width":67,"height":37},{"text":"원도우는","x":626,"y":1424,"width":132,"height":37},{"text":"TCP","x":769,"y":1429,"width":69,"height":28},{"text":"송신자가","x":851,"y":1424,"width":135,"height":38},{"text":"네트워크로","x":998,"y":1425,"width":168,"height":37},{"text":"트래픽을","x":1179,"y":1426,"width":137,"height":38},{"text":"전송할","x":1330,"y":1427,"width":102,"height":38},{"text":"수","x":1443,"y":1429,"width":35,"height":37}]},{"text":"있는 비율을 제한하도록 한다. 특히 송신하는 쪽에서 확인응답이 안 된 데이터의 양은","words":[{"text":"있는","x":184,"y":1485,"width":62,"height":38},{"text":"비율을","x":261,"y":1485,"width":99,"height":37},{"text":"제한하도록","x":374,"y":1486,"width":169,"height":37},{"text":"한다.","x":556,"y":1485,"width":73,"height":37},{"text":"특히","x":644,"y":1485,"width":63,"height":37},{"text":"송신하는","x":723,"y":1485,"width":133,"height":37},{"text":"쪽에서","x":869,"y":1485,"width":96,"height":38},{"text":"확인응답이","x":983,"y":1486,"width":164,"height":39},{"text":"안","x":1165,"y":1487,"width":35,"height":37},{"text":"된","x":1213,"y":1487,"width":32,"height":37},{"text":"데이터의","x":1261,"y":1488,"width":132,"height":38},{"text":"양은","x":1411,"y":1489,"width":67,"height":38}]},{"text":"cwnd와 rwnd의 최솟값을 초과하지 않는다.","words":[{"text":"cwnd와","x":181,"y":1546,"width":116,"height":38},{"text":"rwnd의","x":307,"y":1547,"width":111,"height":37},{"text":"최솟값을","x":436,"y":1546,"width":133,"height":38},{"text":"초과하지","x":581,"y":1546,"width":128,"height":38},{"text":"않는다.","x":726,"y":1545,"width":104,"height":38}]},{"text":"LastByteSent-LastByteAckedsmin{cwnd, rwnd}","words":[{"text":"LastByteSent-LastByteAckedsmin{cwnd,","x":183,"y":1642,"width":815,"height":40},{"text":"rwnd}","x":1032,"y":1644,"width":108,"height":40}]},{"text":"아래에서는 (흐름제어와는 대조적으로) 혼잡제어에 집중하기 위해서, 수신 원도우의","words":[{"text":"아래에서는","x":183,"y":1737,"width":167,"height":37},{"text":"(흐름제어와는","x":366,"y":1736,"width":217,"height":39},{"text":"대조적으로)","x":601,"y":1736,"width":175,"height":38},{"text":"혼잡제어에","x":794,"y":1735,"width":164,"height":39},{"text":"집중하기","x":979,"y":1737,"width":128,"height":38},{"text":"위해서,","x":1130,"y":1738,"width":108,"height":38},{"text":"수신","x":1256,"y":1738,"width":67,"height":38},{"text":"원도우의","x":1342,"y":1739,"width":131,"height":38}]},{"text":"제약 조건을 무시할 수 있을 정도로 TCP 수신 버퍼가 매우 크다고 하자. 그러므로 송","words":[{"text":"제약","x":184,"y":1798,"width":64,"height":36},{"text":"조건을","x":261,"y":1797,"width":102,"heigh