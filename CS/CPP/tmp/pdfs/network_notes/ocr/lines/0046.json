eight":39},{"text":"N","x":1459,"y":1264,"width":31,"height":28},{"text":"-","x":1505,"y":1278,"width":25,"height":4},{"text":"1개의","x":1553,"y":1260,"width":84,"height":37},{"text":"라우터가","x":1656,"y":1259,"width":139,"height":38},{"text":"있다고","x":1811,"y":1258,"width":96,"height":38}]},{"text":"가정하자. 그 다음 출발지가 네트워크로 N개의 특별 패킷을 보내는데, 각각은 최종 목","words":[{"text":"가정하자.","x":573,"y":1317,"width":142,"height":37},{"text":"그","x":730,"y":1322,"width":35,"height":25},{"text":"다음","x":778,"y":1317,"width":68,"height":37},{"text":"출발지가","x":859,"y":1317,"width":140,"height":38},{"text":"네트워크로","x":1013,"y":1318,"width":170,"height":38},{"text":"N개의","x":1196,"y":1320,"width":94,"height":37},{"text":"특별","x":1307,"y":1320,"width":67,"height":36},{"text":"패킷을","x":1392,"y":1319,"width":105,"height":37},{"text":"보내는데,","x":1510,"y":1320,"width":150,"height":37},{"text":"각각은","x":1676,"y":1320,"width":106,"height":36},{"text":"최종","x":1797,"y":1319,"width":66,"height":38},{"text":"목","x":1875,"y":1322,"width":32,"height":38}]},{"text":"적지의 주소를 갖고 있다. 이들 N개의 특별 패킷은 1부터 N까지 표시되어 있다. n 번","words":[{"text":"적지의","x":573,"y":1377,"width":96,"height":38},{"text":"주소를","x":686,"y":1379,"width":103,"height":35},{"text":"갖고","x":804,"y":1378,"width":67,"height":36},{"text":"있다.","x":889,"y":1378,"width":73,"height":38},{"text":"이들","x":981,"y":1378,"width":67,"height":38},{"text":"N개의","x":1060,"y":1379,"width":94,"height":37},{"text":"특별","x":1172,"y":1380,"width":67,"height":36},{"text":"패킷은","x":1257,"y":1380,"width":104,"height":37},{"text":"1부터","x":1379,"y":1380,"width":82,"height":36},{"text":"N까지","x":1478,"y":1380,"width":95,"height":38},{"text":"표시되어","x":1592,"y":1381,"width":138,"height":37},{"text":"있다.","x":1752,"y":1380,"width":73,"height":37},{"text":"n","x":1842,"y":1394,"width":17,"height":19},{"text":"번","x":1878,"y":1384,"width":27,"height":37}]},{"text":"째 라우터가 n으로 표시된 n 번째 패킷을 받으면, 라우터는 그 패킷을 목적지까지 전","words":[{"text":"째","x":571,"y":1438,"width":31,"height":36},