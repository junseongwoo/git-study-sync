45,"y":2297,"width":66,"height":37},{"text":"손실로","x":725,"y":2298,"width":104,"height":37},{"text":"인해","x":844,"y":2299,"width":63,"height":38},{"text":"어떤","x":923,"y":2300,"width":65,"height":38},{"text":"주어진","x":1001,"y":2299,"width":99,"height":39},{"text":"라우터로부터","x":1116,"y":2298,"width":200,"height":39},{"text":"3개보다","x":1333,"y":2299,"width":125,"height":37},{"text":"적은","x":1472,"y":2298,"width":68,"height":38},{"text":"메시지를","x":1553,"y":2299,"width":142,"height":38},{"text":"받으면,","x":1708,"y":2300,"width":113,"height":37},{"text":"Tra-","x":1835,"y":2304,"width":61,"height":28}]},{"text":"ceroute는 라우터 번호 뒤에 별표로 표시하여 그 라우터에 대해서는 왕복 시간이 세","words":[{"text":"ceroute는","x":559,"y":2360,"width":154,"height":34},{"text":"라우터","x":731,"y":2359,"width":98,"height":38},{"text":"번호","x":852,"y":2360,"width":66,"height":37},{"text":"뒤에","x":936,"y":2361,"width":63,"height":38},{"text":"별표로","x":1021,"y":2361,"width":98,"height":37},{"text":"표시하여","x":1136,"y":2360,"width":132,"height":38},{"text":"그","x":1289,"y":2366,"width":35,"height":25},{"text":"라우터에","x":1342,"y":2360,"width":135,"height":38},{"text":"대해서는","x":1498,"y":2360,"width":140,"height":38},{"text":"왕복","x":1655,"y":2361,"width":71,"height":38},{"text":"시간이","x":1745,"y":2359,"width":100,"height":39},{"text":"세","x":1865,"y":2361,"width":28,"height":38}]},{"text":"번보다 적음을 알린다.","words":[{"text":"번보다","x":561,"y":2418,"width":103,"height":38},{"text":"적음을","x":678,"y":2418,"width":103,"height":38},{"text":"알린다.","x":795,"y":2420,"width":109,"height":38}]}]}