03,"height":37},{"text":"사용된다는","x":1680,"y":1613,"width":165,"height":37}]},{"text":"것이다. 2장 애플리케이션 계층에서 보았듯이 서버 프로세스는 잘 알려진 포트 번호에","words":[{"text":"것이다.","x":547,"y":1673,"width":106,"height":38},{"text":"2장","x":667,"y":1672,"width":54,"height":38},{"text":"애플리케이션","x":734,"y":1672,"width":196,"height":38},{"text":"계층에서","x":945,"y":1672,"width":127,"height":39},{"text":"보았듯이","x":1088,"y":1673,"width":128,"height":37},{"text":"서버","x":1232,"y":1672,"width":63,"height":38},{"text":"프로세스는","x":1312,"y":1672,"width":172,"height":37},{"text":"잘","x":1497,"y":1673,"width":36,"height":36},{"text":"알려진","x":1547,"y":1673,"width":104,"height":37},{"text":"포트","x":1667,"y":1677,"width":70,"height":28},{"text":"번호에","x":1752,"y":1674,"width":90,"height":38}]},{"text":"서 요청이 올 때까지 기다리고 P2P 프로토콜의 피어는 서버로서의 역할을 할 때 들어","words":[{"text":"서","x":546,"y":1734,"width":29,"height":37},{"text":"요청이","x":592,"y":1733,"width":96,"height":38},{"text":"올","x":705,"y":1734,"width":34,"height":35},{"text":"때까지","x":754,"y":1734,"width":93,"height":37},{"text":"기다리고","x":866,"y":1733,"width":130,"height":38},{"text":"P2P","x":1008,"y":1739,"width":62,"height":28},{"text":"프로토콜의","x":1084,"y":1733,"width":160,"height":37},{"text":"피어는","x":1262,"y":1733,"width":101,"height":38},{"text":"서버로서의","x":1377,"y":1733,"width":170,"height":38},{"text":"역할을","x":1568,"y":1734,"width":105,"height":37},{"text":"할","x":1687,"y":1734,"width":36,"height":37},{"text":"때","x":1738,"y":1735,"width":28,"height":37},{"text":"들어","x":1783,"y":1737,"width":58,"height":36}]},{"text":"오는 연결을 수락해야 하기 때문에 홈 네트워크에서 실행되는 서버에 문제가 발생할","words":[{"text":"오는","x":545,"y":1797,"width":67,"height":34},{"text":"연결을","x":629,"y":1793,"width":99,"height":38},{"text":"수락해야","x":742,"y":1794,"width":134,"height":39},{"text":"하기","x":891,"y":1794,"width":61,"height":38},{"text":"때문에","x":973,"y":1794,"width":94,"height":38},{"text":"홈","x":1085,"y":1795,"width":33,"height":37},{"text":"네트워크에서","x":1134,"y":1794,"width":194,"