{"page":233,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"226","words":[{"text":"226","x":218,"y":149,"width":73,"height":36}]},{"text":"CHAPTER 03 • 트랜스포트 계층","words":[{"text":"CHAPTER","x":595,"y":149,"width":118,"height":25},{"text":"03","x":723,"y":150,"width":31,"height":24},{"text":"•","x":785,"y":154,"width":12,"height":12},{"text":"트랜스포트","x":827,"y":149,"width":127,"height":27},{"text":"계층","x":966,"y":148,"width":50,"height":29}]},{"text":"굴 AE B","words":[{"text":"굴","x":1501,"y":256,"width":23,"height":19},{"text":"AE","x":1528,"y":256,"width":50,"height":16},{"text":"B","x":1592,"y":254,"width":16,"height":22}]},{"text":"타임아웃","words":[{"text":"타임아웃","x":778,"y":657,"width":102,"height":30}]},{"text":"시간","words":[{"text":"시간","x":912,"y":1211,"width":53,"height":30}]},{"text":"Seq=92, 8 bytes data","words":[{"text":"Seq=92,","x":1050,"y":476,"width":117,"height":38},{"text":"8","x":1196,"y":493,"width":14,"height":22},{"text":"bytes","x":1229,"y":496,"width":89,"height":30},{"text":"data","x":1339,"y":510,"width":70,"height":28}]},{"text":"NJ貳=100","words":[{"text":"NJ貳=100","x":1247,"y":647,"width":125,"height":53}]},{"text":"(손실)","words":[{"text":"(손실)","x":1068,"y":777,"width":70,"height":32}]},{"text":"8","words":[{"text":"8","x":1191,"y":856,"width":15,"height":21}]},{"text":"시간","words":[{"text":"시간","x":1539,"y":1209,"width":56,"height":30}]},{"text":"그림 3.34 • 손실된 확인응답에 기인하는 재전송","words":[{"text":"그림","x":537,"y":1280,"width":55,"height":31},{"text":"3.34","x":605,"y":1280,"width":70,"height":30},{"text":"•","x":690,"y":1287,"width":15,"height":14},{"text":"손실된","x":719,"y":1279,"width":84,"height":32},{"text":"확인응답에","x":814,"y":1279,"width":138,"height":33},{"text":"기인하는","x":965,"y":1281,"width":111,"height":32},{"text":"재전송","x":1086,"y":1280,"width":85,"height":32}]},{"text":"송신자는 자신의 sendBase 변수를 갱신한다. 또한 아직 확인응답 안된 세그먼트들","words":[{"text":"송신자는","x":537,"y":1430,"width":138,"height":39},{"text":"자신의","x":689,"y":1429,"width":99,"height":39},{"text":"sendBase","x":808,"y":1435,"width":182,"height":28},{"text":"변수를","x":1009,"y":1429,"width":99,"height":39},{"text":"갱신한다.","x":1124,"y":1430,"width":142,"height":39},{"text":"또한","x":1284,"y":1430,"width":69,"height":38},{"text":"아직","x":1368,"y":1431,"width":65,"height":38},{"text":"확인응답","x":1451,"y":1431,"width":143,"height":38},{"text":"안된","x":1610,"y":1431,"width":69,"height":38},{"text":"세그먼트들","x":1696,"y":1431,"width":162,"height":42}]},{"text":"이 존재한다면 타이머를 다시 시작한다.","words":[{"text":"이","x":539,"y":1493,"width":28,"height":38},{"text":"존재한다면","x":583,"y":1492,"width":172,"height":38},{"text":"타이머를","x":769,"y":1491,"width":135,"height":39},{"text":"다시","x":916,"y":1491,"width":63,"height":38},{"text":"시작한다.","x":996,"y":1491,"width":140,"height":39}]},{"text":"몇 가지 응미로운 시나리오","words":[{"text":"몇","x":540,"y":1602,"width":33,"height":42},{"text":"가지","x":584,"y":1602,"width":69,"height":35},{"text":"응미로운","x":664,"y":1600,"width":146,"height":44},{"text":"시나리오","x":818,"y":1600,"width":141,"height":36}]},{"text":"매우 간단한 형태를 이용하여 TCP가 신뢰적인 데이터 전송을 제공하는 방법에 대해","words":[{"text":"매우","x":538,"y":1675,"width":68,"height":38},{"text":"간단한","x":623,"y":1673,"width":104,"height":38},{"text":"형태를","x":743,"y":1674,"width":101,"height":38},{"text":"이용하여","x":860,"y":1672,"width":128,"height":39},{"text":"TCP가","x":1007,"y":1672,"width":104,"height":37},{"text":"신뢰적인","x":1126,"y":1671,"width":133,"height":38},{"text":"데이터","x":1278,"y":1672,"width":98,"height":38},{"text":"전송을","x":1398,"y":1672,"width":105,"height":38},{"text":"제공하는","x":1520,"y":1672,"width":142,"height":39},{"text":"방법에","x":1679,"y":1673,"width":100,"height":38},{"text":"대해","x":1798,"y":1676,"width":57,"height":39}]},{"text":"살펴보았다. 그러나 이 간단한 형태(비록 단순화되었지만)에는 많은 미묘한 부분이 있","words":[{"text":"살펴보았다.","x":538,"y":1736,"width":180,"height":38},{"text":"그러나","x":734,"y":1735,"width":103,"height":38},{"text":"이","x":851,"y":1735,"width":28,"height":37},{"text":"간단한","x":897,"y":1734,"width":100,"height":37},{"text":"형태(비록","x":1011,"y":1733,"width":144,"height":40},{"text":"단순화되었지만)에는","x":1169,"y":1733,"width":325,"height":40},{"text":"많은","x":1508,"y":1734,"width":71,"height":38},{"text":"미묘한","x":1595,"y":1735,"width":106,"height":37},{"text":"부분이","x":1715,"y":1736,"width":96,"height":38},{"text":"있","x":1829,"y":1739,"width":27,"height":37}]},{"text":"다. 이 프로토콜이 어떻게 작동하는지 몇 가지 간단한 시나리오를 통해서 알아보자. 그","words":[{"text":"다.","x":538,"y":1798,"width":41,"height":38},{"text":"이","x":596,"y":1799,"width":29,"height":37},{"text":"프로토콜이","x":641,"y":1797,"width":168,"height":38},{"text":"어떻게","x":827,"y":1797,"width":96,"height":39},{"text":"작동하는지","x":939,"y":1795,"width":161,"height":39},{"text":"몇","x":1119,"y":1794,"width":29,"height":38},{"text":"가지","x":1164,"y":1795,"width":62,"height":38},{"text":"간단한","x":1244,"y":1795,"width":103,"height":37},{"text":"시나리오를","x":1360,"y":1795,"width":175,"height":38},{"text":"통해서","x":1547,"y":1797,"width":104,"height":38},{"text":"알아보자.","x":1671,"y":1798,"width":142,"height":37},{"text":"그","x":1827,"y":1805,"width":29,"height":25}]},{"text":"림 3.34는 호스트 A가 호스트 B에게 하나의 세그먼트를 보내는 시나리오를 나타낸 것","words":[{"text":"림","x":541,"y":1859,"width":27,"height":38},{"text":"3.34는","x":586,"y":1861,"width":103,"height":36},{"text":"호스트","x":701,"y":1861,"width":102,"height":32},{"text":"A가","x":815,"y":1859,"width":63,"height":39},{"text":"호스트","x":890,"y":1861,"width":99,"height":31},{"text":"B에게","x":1001,"y":1857,"width":89,"height":39},{"text":"하나의","x":1106,"y":1857,"width":96,"height":39},{"text":"세그먼트를","x":1219,"y":1857,"width":172,"height":38},{"text":"보내는","x":1403,"y":1857,"width":106,"height":37},{"text":"시나리오를","x":1523,"y":1857,"width":179,"height":39},{"text":"나타낸","x":1716,"y":1859,"width":98,"height":38},{"text":"것","x":1829,"y":1861,"width":25,"height":37}]},{"text":"이다. 이 세그먼트가 순서번호 92와 8바이트의 데이터를 포함한다고 가정하자. 호스트","words":[{"text":"이다.","x":540,"y":1921,"width":73,"height":38},{"text":"이","x":631,"y":1921,"width":29,"height":38},{"text":"세그먼트가","x":677,"y":1921,"width":171,"height":38},{"text":"순서번호","x":859,"y":1920,"width":133,"height":39},{"text":"92와","x":1005,"y":1920,"width":72,"height":37},{"text":"8바이트의","x":1089,"y":1919,"width":149,"height":38},{"text":"데이터를","x":1256,"y":1918,"width":136,"height":39},{"text":"포함한다고","x":1405,"y":1918,"width":177,"height":38},{"text":"가정하자.","x":1598,"y":1920,"width":147,"height":37},{"text":"호스트","x":1762,"y":1922,"width":93,"height":29}]},{"text":"A가 이 세그먼트를 전송한 후에 호스트 A는 호스트 B로부터 긍정 확인응답 번호 1%","words":[{"text":"A가","x":538,"y":1983,"width":63,"height":37},{"text":"이","x":615,"y":1983,"width":29,"height":38},{"text":"세그먼트를","x":662,"y":1983,"width":171,"height":37},{"text":"전송한","x":847,"y":1983,"width":98,"height":37},{"text":"후에","x":957,"y":1982,"width":64,"height":38},{"text":"호스트","x":1036,"y":1984,"width":99,"height":31},{"text":"A는","x":1148,"y":1983,"width":62,"height":34},{"text":"호스트","x":1222,"y":1983,"width":102,"height":30},{"text":"B로부터","x":1338,"y":1979,"width":126,"height":39},{"text":"긍정","x":1483,"y":1980,"width":66,"height":37},{"text":"확인응답","x":1567,"y":1981,"width":144,"height":37},{"text":"번호","x":1727,"y":1980,"width":65,"height":36},{"text":"1%","x":1807,"y":1984,"width":48,"height":30}]},{"text":"을 가진 세그먼트를 기다린다. A로부터의 세그먼트가 B 측에서 수신되었음에도 불구","words":[{"text":"을","x":538,"y":2044,"width":35,"height":37},{"text":"가진","x":588,"y":2044,"width":66,"height":38},{"text":"세그먼트를","x":670,"y":2044,"width":170,"height":37},{"text":"기다린다.","x":856,"y":2043,"width":137,"height":38},{"text":"A로부터의","x":1010,"y":2042,"width":157,"height":39},{"text":"세그먼트가","x":1185,"y":2041,"width":171,"height":39},{"text":"B","x":1369,"y":2046,"width":23,"height":27},{"text":"측에서","x":1410,"y":2041,"width":102,"height":37},{"text":"수신되었음에도","x":1531,"y":2041,"width":249,"height":38},{"text":"불구","x":1793,"y":2041,"width":62,"height":37}]},{"text":"하고 B로부터 A로의 긍정 확인응답이 손실된다면, 이런 경우에 타임이웃이 일어나고,","words":[{"text":"하고","x":539,"y":2105,"width":67,"height":38},{"text":"B로부터","x":620,"y":2105,"width":125,"height":38},{"text":"A로의","x":762,"y":2105,"width":92,"height":36},{"text":"긍정","x":870,"y":2104,"width":63,"height":38},{"text":"확인응답이","x":949,"y":2104,"width":162,"height":38},{"text":"손실된다면,","x":1127,"y":2103,"width":176,"height":38},{"text":"이런","x":1321,"y":2102,"width":65,"height":37},{"text":"경우에","x":1404,"y":2102,"width":101,"height":38},{"text":"타임이웃이","x":1523,"y":2103,"width":175,"height":38},{"text":"일어나고,","x":1719,"y":2101,"width":135,"height":39}]},{"text":"호스트 A는 동일한 세그먼트를 B에게 재전송한다. 물론, 호스트 B가 재전송 세그먼트","words":[{"text":"호스트","x":538,"y":2168,"width":102,"height":30},{"text":"A는","x":654,"y":2169,"width":62,"height":33},{"text":"동일한","x":728,"y":2165,"width":103,"height":37},{"text":"세그먼트를","x":842,"y":2165,"width":166,"height":37},{"text":"B에게","x":1021,"y":2166,"width":87,"height":37},{"text":"재전송한다.","x":1125,"y":2165,"width":173,"height":37},{"text":"물론,","x":1314,"y":2165,"width":77,"height":36},{"text":"호스트","x":1406,"y":2166,"width":106,"height":29},{"text":"B가","x":1526,"y":2165,"width":65,"height":37},{"text":"재전송","x":1605,"y":2165,"width":106,"height":37},{"text":"세그먼트","x":1725,"y":2163,"width":129,"height":38}]},{"text":"를 수신했을 때, 호스트 B는 세그먼트가 포함하고 있는 순서번호로부터 이미 수신된","words":[{"text":"를","x":538,"y":2228,"width":34,"height":35},{"text":"수신했을","x":587,"y":2227,"width":138,"height":37},{"text":"때,","x":741,"y":2225,"width":40,"height":37},{"text":"호스트","x":798,"y":2227,"width":100,"height":30},{"text":"B는","x":914,"y":2227,"width":58,"height":35},{"text":"세그먼트가","x":988,"y":2226,"width":166,"height":37},{"text":"포함하고","x":1168,"y":2226,"width":133,"height":37},{"text":"있는","x":1321,"y":2224,"width":66,"height":37},{"text":"순서번호로부터","x":1402,"y":2224,"width":248,"height":39},{"text":"이미","x":1673,"y":2225,"width":65,"height":38},{"text":"수신된","x":1758,"y":2224,"width":94,"height":39}]},{"text":"데이터라는 것을 알 수 있다. 이같이 호스트 B의 TCP는 재송신된 세그먼트의 바이트","words":[{"text":"데이터라는","x":541,"y":2288,"width":168,"height":38},{"text":"것을","x":726,"y":2286,"width":64,"height":38},{"text":"알","x":804,"y":2285,"width":33,"height":37},{"text":"수","x":850,"y":2286,"width":33,"height":37},{"text":"있다.","x":899,"y":2286,"width":71,"height":38},{"text":"이같이","x":988,"y":2287,"width":93,"height":38},{"text":"호스트","x":1099,"y":2289,"width":99,"height":31},{"text":"B의","x":1212,"y":2287,"width":55,"height":38},{"text":"TCP는","x":1284,"y":2288,"width":107,"height":34},{"text":"재송신된","x":1407,"y":2285,"width":139,"height":39},{"text":"세그먼트의","x":1564,"y":2287,"width":176,"height":38},{"text":"바이트","x":1759,"y":2286,"width":94,"height":40}]},{"text":"를 버릴 것이다.","words":[{"text":"를","x":538,"y":2351,"width":34,"height":35},{"text":"버릴","x":587,"y":2349,"width":62,"height":38},{"text":"것이다.","x":667,"y":2347,"width":106,"height":40}]},{"text":"두 번째 시나리오의 그림 3.35를 보면 호스트 A가 연속해서 두 세그먼트를 전송","words":[{"text":"두","x":605,"y":2412,"width":34,"height":37},{"text":"번째","x":656,"y":2410,"width":62,"height":38},{"text":"시나리오의","x":737,"y":2409,"width":163,"height":40},{"text":"그림","x":918,"y":2411,"width":62,"height":38},{"text":"3.35를","x":999,"y":2413,"width":100,"height":36},{"text":"보면","x":1114,"y":2411,"width":64,"height":37},{"text":"호스트","x":1194,"y":2414,"width":101,"height":30},{"text":"A가","x":1309,"y":2410,"width":63,"height":39},{"text":"연속해서","x":1389,"y":2410,"width":135,"height":39},{"text":"두","x":1544,"y":2413,"width":37,"height":36},{"text":"세그먼트를","x":1597,"y":2411,"width":178,"height":38},{"text":"전송","x":1791,"y":2410,"width":61,"height":37}]},{"text":"한다. 첫 번째 세그먼트는 순서번호 92와 8바이트의 데이터를 가지고 있고, 두 번째 세","words":[{"text":"한다.","x":539,"y":2472,"width":75,"height":39},{"text":"첫","x":632,"y":2473,"width":29,"height":39},{"text":"번째","x":677,"y":2472,"width":62,"height":39},{"text":"세그먼트는","x":755,"y":2472,"width":166,"height":38},{"text":"순서번호","x":932,"y":2473,"width":134,"height":39},{"text":"92와","x":1078,"y":2473,"wi