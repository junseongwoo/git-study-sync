{"page":135,"width":2000,"height":2831,"text_angle":0,"lines":[{"text":"2.4 • DNS-인터넷의 디래터리 서비스","words":[{"text":"2.4","x":913,"y":159,"width":42,"height":24},{"text":"•","x":990,"y":163,"width":13,"height":14},{"text":"DNS-인터넷의","x":1038,"y":157,"width":206,"height":30},{"text":"디래터리","x":1257,"y":158,"width":108,"height":30},{"text":"서비스","x":1377,"y":158,"width":83,"height":29}]},{"text":"(networkutopia.com/ dngl.networkutopia. com, NS)","words":[{"text":"(networkutopia.com/","x":162,"y":290,"width":425,"height":37},{"text":"dngl.networkutopia.","x":619,"y":291,"width":435,"height":36},{"text":"com,","x":1065,"y":298,"width":86,"height":26},{"text":"NS)","x":1185,"y":293,"width":63,"height":30}]},{"text":"(dnsl.networkutopia.com/ 212,212,212.1, A)","words":[{"text":"(dnsl.networkutopia.com/","x":163,"y":351,"width":538,"height":37},{"text":"212,212,212.1,","x":736,"y":352,"width":317,"height":34},{"text":"A)","x":1087,"y":353,"width":39,"height":29}]},{"text":"보안초점","words":[{"text":"보안초점","x":1061,"y":529,"width":178,"height":50}]},{"text":"DNS 취약점","words":[{"text":"DNS","x":195,"y":641,"width":73,"height":30},{"text":"취약점","x":280,"y":639,"width":89,"height":33}]},{"text":"우리는 인터넷 기반구조에서 DNS가 없다면 웹과 전자에일을 포함하는 많은 중요한 서비스들이","words":[{"text":"우리는","x":193,"y":701,"width":87,"height":31},{"text":"인터넷","x":293,"y":701,"width":84,"height":31},{"text":"기반구조에서","x":393,"y":700,"width":164,"height":32},{"text":"DNS가","x":573,"y":701,"width":94,"height":31},{"text":"없다면","x":680,"y":700,"width":81,"height":32},{"text":"웹과","x":776,"y":700,"width":56,"height":31},{"text":"전자에일을","x":845,"y":699,"width":142,"height":32},{"text":"포함하는","x":1000,"y":699,"width":116,"height":32},{"text":"많은","x":1130,"y":699,"width":58,"height":32},{"text":"중요한","x":1201,"y":699,"width":88,"height":32},{"text":"서비스들이","x":1302,"y":699,"width":144,"height":32}]},{"text":"그 기능을 할 수 없는 매우 중요한 요소라는 것을 보았다. 따라서 우리는 “자연스럽게 어떻게","words":[{"text":"그","x":193,"y":756,"width":29,"height":23},{"text":"기능을","x":238,"y":752,"width":86,"height":31},{"text":"할","x":340,"y":752,"width":28,"height":30},{"text":"수","x":381,"y":752,"width":29,"height":30},{"text":"없는","x":425,"y":751,"width":56,"height":31},{"text":"매우","x":497,"y":751,"width":55,"height":31},{"text":"중요한","x":566,"y":751,"width":85,"height":32},{"text":"요소라는","x":663,"y":751,"width":114,"height":32},{"text":"것을","x":792,"y":750,"width":56,"height":32},{"text":"보았다.","x":862,"y":751,"width":97,"height":31},{"text":"따라서","x":979,"y":749,"width":86,"height":33},{"text":"우리는","x":1080,"y":750,"width":90,"height":31},{"text":"“자연스럽게","x":1185,"y":749,"width":159,"height":32},{"text":"어떻게","x":1360,"y":750,"width":87,"height":32}]},{"text":"DNS를 공격할 수 있는가?” “대부분의 인터넷 애플리케이션들이 DNS와 연계되어 있는데 서비","words":[{"text":"DNS를","x":195,"y":803,"width":97,"height":30},{"text":"공격할","x":304,"y":802,"width":86,"height":32},{"text":"수","x":400,"y":802,"width":30,"height":30},{"text":"있는가?”","x":442,"y":801,"width":112,"height":32},{"text":"“대부분의","x":582,"y":801,"width":120,"height":32},{"text":"인터넷","x":716,"y":801,"width":81,"height":32},{"text":"애플리케이션들이","x":811,"y":801,"width":225,"height":31},{"text":"DNS와","x":1052,"y":800,"width":99,"height":31},{"text":"연계되어","x":1163,"y":800,"width":114,"height":31},{"text":"있는데","x":1291,"y":799,"width":86,"height":32},{"text":"서비","x":1390,"y":800,"width":57,"height":30}]},{"text":"스되지 않도록 공격을 받아야 하는 것인가?”라는 질문을 하게 된다.","words":[{"text":"스되지","x":192,"y":853,"width":86,"height":31},{"text":"않도록","x":289,"y":853,"width":85,"height":31},{"text":"공격을","x":384,"y":852,"width":84,"height":32},{"text":"받아야","x":479,"y":852,"width":84,"height":31},{"text":"하는","x":572,"y":853,"width":55,"height":30},{"text":"것인가?”라는","x":638,"y":851,"width":169,"height":32},{"text":"질문을","x":818,"y":851,"width":83,"height":32},{"text":"하게","x":911,"y":851,"width":56,"height":32},{"text":"된다.","x":979,"y":850,"width":67,"height":32}]},{"text":"떠오르는 공격의 첫 번째 유형은 DNS 서버에 대한 DDoS 대역폭 플러8(fIooding) 공격","words":[{"text":"떠오르는","x":239,"y":904,"width":114,"height":30},{"text":"공격의","x":366,"y":902,"width":85,"height":32},{"text":"첫","x":466,"y":903,"width":27,"height":31},{"text":"번째","x":509,"y":903,"width":54,"height":30},{"text":"유형은","x":577,"y":902,"width":84,"height":32},{"text":"DNS","x":677,"y":904,"width":66,"height":28},{"text":"서버에","x":757,"y":902,"width":83,"height":31},{"text":"대한","x":857,"y":902,"width":56,"height":31},{"text":"DDoS","x":928,"y":903,"width":89,"height":28},{"text":"대역폭","x":1033,"y":901,"width":86,"height":32},{"text":"플러8(fIooding)","x":1133,"y":900,"width":243,"height":35},{"text":"공격","x":1391,"y":899,"width":58,"height":32}]},{"text":"(1.6절 참조)이다. 예를 들어, 공격자는 다량의 패킷을 각 DNS 루트 서버로 보내려는 시도를 하","words":[{"text":"(1.6절","x":193,"y":954,"width":91,"height":32},{"text":"참조)이다.","x":297,"y":953,"width":132,"height":31},{"text":"예를","x":446,"y":954,"width":55,"height":30},{"text":"들어,","x":512,"y":953,"width":66,"height":34},{"text":"공격자는","x":592,"y":953,"width":113,"height":31},{"text":"다량의","x":716,"y":952,"width":82,"height":32},{"text":"패킷을","x":810,"y":952,"width":85,"height":31},{"text":"각","x":906,"y":952,"width":29,"height":32},{"text":"DNS","x":947,"y":953,"width":69,"height":28},{"text":"루트","x":1026,"y":952,"width":59,"height":31},{"text":"서버로","x":1095,"y":951,"width":89,"height":32},{"text":"보내려는","x":1194,"y":950,"width":119,"height":32},{"text":"시도를","x":1323,"y":950,"width":87,"height":31},{"text":"하","x":1422,"y":950,"width":29,"height":30}]},{"text":"여, 정상적인 많은 DNS 질의들이 응답을 받을 수 없게 된다. 그러한 DNS 루트 서버에 대한 대","words":[{"text":"여,","x":194,"y":1006,"width":38,"height":33},{"text":"정상적인","x":248,"y":1004,"width":113,"height":32},{"text":"많은","x":374,"y":1004,"width":56,"height":31},{"text":"DNS","x":443,"y":1005,"width":66,"height":28},{"text":"질의들이","x":522,"y":1003,"width":109,"height":31},{"text":"응답을","x":644,"y":1002,"width":84,"height":32},{"text":"받을","x":740,"y":1002,"width":55,"height":31},{"text":"수","x":805,"y":1003,"width":31,"height":30},{"text":"없게","x":847,"y":1002,"width":55,"height":32},{"text":"된다.","x":915,"y":1003,"width":67,"height":31},{"text":"그러한","x":998,"y":1002,"width":88,"height":31},{"text":"DNS","x":1099,"y":1003,"width":71,"height":29},{"text":"루트","x":1181,"y":1002,"width":61,"height":31},{"text":"서버에","x":1253,"y":1000,"width":87,"height":32},{"text":"대한","x":1354,"y":999,"width":58,"height":32},{"text":"대","x":1424,"y":999,"width":25,"height":32}]},{"text":"규모의 DDoS 공격이 실제로 2002년 10월 기일에 발생했다. 이 공격에서, 공격자들은 가공의","words":[{"text":"규모의","x":192,"y":1056,"width":85,"height":31},{"text":"DDoS","x":292,"y":1057,"width":87,"height":27},{"text":"공격이","x":390,"y":1054,"width":83,"height":32},{"text":"실제로","x":486,"y":1054,"width":85,"height":31},{"text":"2002년","x":583,"y":1053,"width":101,"height":31},{"text":"10월","x":699,"y":1053,"width":61,"height":30},{"text":"기일에","x":775,"y":1053,"width":91,"height":30},{"text":"발생했다.","x":880,"y":1053,"width":124,"height":32},{"text":"이","x":1022,"y":1052,"width":26,"height":32},{"text":"공격에서,","x":1061,"y":1052,"width":131,"height":35},{"text":"공격자들은","x":1206,"y":1050,"width":148,"height":34},{"text":"가공의","x":1366,"y":1050,"width":84,"height":32}]},{"text":"네트워크(botnet)를 이용하여 13개의 DNS 루트 서버 각각으로 많은 양의 ICMP E(ping) 메시","words":[{"text":"네트워크(botnet)를","x":194,"y":1105,"width":261,"height":32},{"text":"이용하여","x":467,"y":1104,"width":109,"height":32},{"text":"13개의","x":591,"y":1104,"width":88,"height":31},{"text":"DNS","x":693,"y":1105,"width":65,"height":28},{"text":"루트","x":769,"y":1104,"width":57,"height":31},{"text":"서버","x":836,"y":1103,"width":54,"height":32},{"text":"각각으로","x":904,"y":1103,"width":114,"height":32},{"text":"많은","x":1028,"y":1103,"width":58,"height":32},{"text":"양의","x":1096,"y":1103,"width":58,"height":32},{"text":"ICMP","x":1167,"y":1105,"width":84,"height":28},{"text":"E(ping)","x":1263,"y":1101,"width":121,"height":36},{"text":"메시","x":1396,"y":1101,"width":55,"height":31}]},{"text":"지를 전송하였다. (ICMP 에시지는 4장에서 논의한다. 지금은 다만 ICMP 패킷은 IP 데이터그램","words":[{"text":"지를","x":193,"y":1158,"width":57,"height":31},{"text":"전송하였다.","x":261,"y":1156,"width":151,"height":33},{"text":"(ICMP","x":428,"y":1156,"width":91,"height":32},{"text":"에시지는","x":531,"y":1155,"width":111,"height":32},{"text":"4장에서","x":653,"y":1154,"width":101,"height":33},{"text":"논의한다.","x":766,"y":1154,"width":122,"height":32},{"text":"지금은","x":905,"y":1154,"width":86,"height":32},{"text":"다만","x":1002,"y":1155,"width":58,"height":31},{"text":"ICMP","x":1072,"y":1156,"width":84,"height":28},{"text":"패킷은","x":1167,"y":1153,"width":89,"height":32},{"text":"IP","x":1269,"y":1155,"width":28,"height":28},{"text":"데이터그램","x":1310,"y":1152,"width":142,"height":32}]},{"text":"의 특별한 유형이라는 것만 알면 된다.) 다행히도, 이 대규모 공격은 최소한의 피해만을 야기했으","words":[{"text":"의","x":193,"y":1208,"width":27,"height":31},{"text":"특별한","x":232,"y":1208,"width":87,"height":31},{"text":"유형이라는","x":329,"y":1208,"width":141,"height":32},{"text":"것만","x":482,"y":1207,"width":56,"height":31},{"text":"알면","x":549,"y":1207,"width":54,"height":31},{"text":"된다.)","x":616,"y":1206,"width":79,"height":32},{"text":"다행히도,","x":708,"y":1205,"width":121,"height":35},{"text":"이","x":846,"y":1205,"width":26,"height":32},{"text":"대규모","x":886,"y":1206,"width":86,"height":31},{"text":"공격은","x":981,"y":1205,"width":89,"height":32},{"text":"최소한의","x":1081,"y":1205,"width":117,"height":31},{"text":"피해만을","x":1211,"y":1204,"width":118,"height":33},{"text":"야기했으","x":1339,"y":1203,"width":115,"height":32}]},{"text":"며, 사용자들은 전혀 또는 약간의 영향만 받았다 공격자들은 루트 서버로 많은 양의 패킷을 보내","words":[{"text":"며,","x":194,"y":1259,"width":38,"height":35},{"text":"사용자들은","x":247,"y":1259,"width":144,"height":32},{"text":"전혀","x":401,"y":1259,"width":54,"height":31},{"text":"또는","x":467,"y":1259,"width":58,"height":30},{"text":"약간의","x":535,"y":1258,"width":83,"height":31},{"text":"영향만","x":631,"y":1258,"width":83,"height":31},{"text":"받았다","x":726,"y":1256,"width":83,"height":32},{"te