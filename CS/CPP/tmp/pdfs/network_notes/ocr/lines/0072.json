":1595,"y":1993,"width":71,"height":36},{"text":"없는","x":1686,"y":1991,"width":68,"height":37},{"text":"간단한","x":1771,"y":1990,"width":106,"height":39}]},{"text":"인출에 대하여 프로토콜 동작을 그려 보라. 하위 종단간의 전송 서비스에 대하여","words":[{"text":"인출에","x":623,"y":2052,"width":96,"height":38},{"text":"대하여","x":736,"y":2052,"width":98,"height":38},{"text":"프로토콜","x":850,"y":2054,"width":138,"height":35},{"text":"동작을","x":1001,"y":2052,"width":105,"height":38},{"text":"그려","x":1119,"y":2053,"width":66,"height":37},{"text":"보라.","x":1202,"y":2053,"width":77,"height":37},{"text":"하위","x":1296,"y":2053,"width":66,"height":37},{"text":"종단간의","x":1377,"y":2052,"width":137,"height":38},{"text":"전송","x":1533,"y":2052,"width":69,"height":38},{"text":"서비스에","x":1616,"y":2052,"width":137,"height":38},{"text":"대하여","x":1771,"y":2051,"width":100,"height":41}]},{"text":"지금 설계한 프로토콜이 어떠한 가정을 하는지 구체적으로 기술하라.","words":[{"text":"지금","x":622,"y":2114,"width":66,"height":38},{"text":"설계한","x":701,"y":2113,"width":102,"height":38},{"text":"프로토콜이","x":814,"y":2114,"width":168,"height":38},{"text":"어떠한","x":1000,"y":2113,"width":104,"height":39},{"text":"가정을","x":1116,"y":2113,"width":104,"height":38},{"text":"하는지","x":1233,"y":2114,"width":100,"height":37},{"text":"구체적으로","x":1350,"y":2113,"width":174,"height":38},{"text":"기술하라.","x":1539,"y":2113,"width":147,"height":38}]},{"text":"P2. 식 (1.1)는 전송속도가 R인 N개의 링크를 거쳐 길이가 L인 하나의 패킷을 전송","words":[{"text":"P2.","x":560,"y":2193,"width":46,"height":29},{"text":"식","x":622,"y":2187,"width":28,"height":38},{"text":"(1.1)는","x":669,"y":2188,"width":108,"height":37},{"text":"전송속도가","x":793,"y":2186,"width":169,"height":39},{"text":"R인","x":975,"y":2187,"width":58,"height":36},{"text":"N개의","x":1048,"y":2186,"width":94,"height":38},{"text":"링크를","x":1163,"y":2186,"width":103,"height":38},{"text":"거쳐","x":1282,"y":2186,"width":64,"height":38},{"text":"길이가","x":1367,"y":2185,"width":105,"height":38},{"text":"L인","x":1485,"y":2186,"width":58,"height":36},{"text":"하나의","x":1560,"y":2186,"width":102,"height":38},{"text":"패킷을","x":1682,"y":2185,"width":107,"height":38},{"text":"전송","x":1805,"y":2186,"width":68,"height":38}]},{"text":"하는데 걸리는 종단간 지연에 대한 수식이다. 그러한 패킷 P개를 연속해서 N개","words":[{"text":"하는데","x":622,"y":2247,"width":97,"height":39},{"text":"걸리는","x":739,"y":2248,"width":99,"height":37},{"text":"종단간","x":852,"y":2248,"width":103,"height":38},{"text":"지연에","x":970,"y":2247,"width":98,"height":38},{"text":"대한","x":1088,"y":2247,"width":68,"height":38},{"text":"수식이다.","x":1170,"y":2247,"width":147,"height":38},{"text":"그러한","x":1334,"y":2247,"width":107,"height":38},{"text":"패킷","x":1457,"y":2247,"width":67,"height":37},{"text":"P개를","x":1541,"y":2248,"width":97,"height":36},{"text":"연속해서","x":1656,"y":2247,"width":135,"height":37},{"text":"N개","x":1808,"y":2249,"width":61,"height":37}]},{"text":"의 링크상으로 전송할 때의 이 수식을 일반화하라.","words":[{"text":"의","x":624,"y":2309,"width":28,"height":37},{"text":"링크상으로","x":670,"y":2308,"width":165,"height":39},{"text":"전송할","x":849,"y":2309,"width":100,"height":38},{"text":"때의","x":962,"y":2309,"width":63,"height":38},{"text":"이","x":1042,"y":2309,"width":29,"height":37},{"text":"수식을","x":1087,"y":2308,"width":105,"height":38},{"text":"일반화하라.","x":1206,"y":2308,"width":178,"height":38}]},{"text":"P3. 일정한 속도로 데이터를 전송하는 응용을 생각해보자(예, 송신자가 매 k 시간 단","words":[{"text":"P3.","x":563,"y":2387,"width":45,"height":29},{"text":"일정한","x":626,"y":2381,"width":99,"height":37},{"text":"속도로","x":736,"y":2382,"width":101,"height":36},{"text":"데이터를","x":851,"y":2381,"width":133,"height":38},{"text":"전송하는","x":999,"y":2380,"width":135,"height":39},{"text":"응용을","x":1147,"y":2381,"width":104,"height":38},{"text":"생각해보자(예,","x":1264,"y":2381,"width":233,"height":39},{"text":"송신자가","x":1512,"y":2382,"width":144,"height":38},{"text":"매","x":1670,"y":2382,"width":31,"height":36},{"text":"k","x":1718,"y":2386,"width":18,"height":28},{"text":"시간","x":1752,"y":2381,"width":70,"height":38},{"text":"단","x":1836,"y":2383,"width":34,"height":36}]},{"text":"위마다 N-비트 단위의 데이터를 생성한다. k는 작고 고정된 값이다.) 또한, 그러","words":[{"text":"위마다","x":626,"y":2442,"width":99,"height":38},{"text":"N-비트","x":737,"y":2442,"width":108,"height":38},{"text":"단위의","x":858,"y":2442,"width":97,"height":38},{"text":"데이터를","x":974,"y":2442,"width":134,"height":38},{"text":"생성한다.","x":1123,"y":2442,"width":143,"height":38},{"text":"k는","x":1283,"y":2445,"width":54,"height":35},{"text":"작고","x":1350,"y":2443,"width":71,"height":38},{"text":"고정된","x":1436,"y":2443,"width":105,"height":38},{"text":"값이다.)","x":1558,"y":2443,"width":128,"height":39},{"text":"또한,","x":1703,"y":2443,"width":79,"height":37},{"text":"그러","x":1799,"y":2444,"width":66,"height":38}]},{"text":"한 -용공이 시작되면 상당히 긴 시간 동안 계속해서 수행된다. 다음 질문들에 답","words":[{"text":"한","x":624,"y":2504,"width":34,"height":36},{"text":"-용공이","x":671,"y":2504,"width":97,"height":37},{"text":"시작되면","x":789,"y":2503,"width":130,"height":38},{"text":"상당히","x":935,"y":2503,"width":96,"height":38},{"text":"긴","x":1052,"y":2503,"width":29,"height":36},{"text":"시간","x":1099,"y":2502,"width":68,"height":38},{"text":"동안","x":1181,"y":2505,"width":70,"height":37},{"text":"계속해서","x":1267,"y":2505,"width":134,"height":38},{"text":"수행된다.","x":1420,"y":2505,"width":149,"height":38},{"text":"다음","x":1589,"y":2505,"width":71,"height":39},{"text":"질문들에","x":1677,"y":2504,"width":138,"height":38},{"text":"답","x":1834,"y":2505,"width":33,"height":38}]},{"text":"하고 간략히 답에 대한 당위성을 설명하라.","words":[{"text":"하고","x":626,"y":2565,"width":66,"height":37},{"text":"간략히","x":705,"y":2564,"width":95,"height":38},{"text":"답에","x":816,"y":2565,"width":63,"height":37},{"text":"대한","x":895,"y":2564,"width":67,"height":38},{"text":"당위성을","x":973,"y":2563,"width":135,"height":39},{"text":"설명하라.","x":1121,"y":2564,"width":142,"height":39}]}]}