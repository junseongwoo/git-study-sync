626,"width":101,"height":38},{"text":"중앙컴퓨터","x":1040,"y":1626,"width":169,"height":38},{"text":"사이에","x":1229,"y":1626,"width":101,"height":38},{"text":"시용되는","x":1347,"y":1626,"width":140,"height":38},{"text":"애플리케이션","x":1503,"y":1627,"width":207,"height":38},{"text":"계층","x":1728,"y":1626,"width":68,"height":38},{"text":"프로","x":1811,"y":1629,"width":66,"height":31}]},{"text":"토콜을 설계하고 기술하라. 이 프로토콜은 사용자의 카드와 비밀번호를 확인해","words":[{"text":"토콜을","x":629,"y":1687,"width":103,"height":36},{"text":"설계하고","x":750,"y":1686,"width":137,"height":39},{"text":"기술하라.","x":904,"y":1687,"width":143,"height":38},{"text":"이","x":1069,"y":1687,"width":29,"height":37},{"text":"프로토콜은","x":1118,"y":1687,"width":174,"height":37},{"text":"사용자의","x":1308,"y":1687,"width":136,"height":38},{"text":"카드와","x":1464,"y":1687,"width":105,"height":38},{"text":"비밀번호를","x":1586,"y":1688,"width":173,"height":37},{"text":"확인해","x":1775,"y":1686,"width":99,"height":40}]},{"text":"야 하고, (중앙컴퓨터에 유지되는) 계정의 잔액 확인이 기능해야 하며, 계정에서","words":[{"text":"야","x":628,"y":1747,"width":34,"height":38},{"text":"하고,","x":675,"y":1747,"width":77,"height":38},{"text":"(중앙컴퓨터에","x":768,"y":1747,"width":218,"height":40},{"text":"유지되는)","x":1003,"y":1748,"width":150,"height":39},{"text":"계정의","x":1171,"y":1747,"width":99,"height":39},{"text":"잔액","x":1288,"y":1748,"width":67,"height":37},{"text":"확인이","x":1372,"y":1748,"width":101,"height":37},{"text":"기능해야","x":1491,"y":1748,"width":141,"height":38},{"text":"하며,","x":1646,"y":1748,"width":76,"height":38},{"text":"계정에서","x":1740,"y":1747,"width":132,"height":39}]},{"text":"인출이 가능해야 한다. 프로토콜 개체는 계정에 인출할 만큼의 돈이 없는 경우","words":[{"text":"인출이","x":627,"y":1808,"width":97,"height":36},{"text":"가능해야","x":745,"y":1808,"width":139,"height":38},{"text":"한다.","x":900,"y":1809,"width":75,"height":37},{"text":"프로토콜","x":994,"y":1810,"width":140,"height":36},{"text":"개체는","x":1152,"y":1808,"width":104,"height":38},{"text":"계정에","x":1273,"y":1808,"width":100,"height":38},{"text":"인출할","