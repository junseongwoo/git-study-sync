.","x":521,"y":1901,"width":170,"height":36},{"text":"페이지가","x":706,"y":1903,"width":123,"height":36},{"text":"적재되고","x":841,"y":1903,"width":118,"height":36},{"text":"나면","x":970,"y":1904,"width":58,"height":35},{"text":"프로세스는","x":1040,"y":1904,"width":151,"height":36},{"text":"수행을","x":1200,"y":1904,"width":94,"height":36},{"text":"계속하는데","x":1305,"y":1904,"width":155,"height":36},{"text":"프로","x":1475,"y":1909,"width":67,"height":26}]},{"text":"세스가 시용하는 모든 페이지가 메모리에 올라올 때까지 필요할 때마다 페이지 폴트가","words":[{"text":"세스가","x":292,"y":1960,"width":105,"height":37},{"text":"시용하는","x":412,"y":1961,"width":135,"height":36},{"text":"모든","x":561,"y":1963,"width":67,"height":32},{"text":"페이지가","x":642,"y":1961,"width":126,"height":37},{"text":"메모리에","x":783,"y":1963,"width":116,"height":35},{"text":"올라올","x":914,"y":1963,"width":91,"height":35},{"text":"때까지","x":1019,"y":1964,"width":85,"height":35},{"text":"필요할","x":1122,"y":1964,"width":91,"height":34},{"text":"때마다","x":1227,"y":1964,"width":92,"height":36},{"text":"페이지","x":1334,"y":1964,"width":91,"height":36},{"text":"폴트가","x":1442,"y":1965,"width":101,"height":35}]},{"text":"발생한다. 일단 필요한 모든 페이지가 적재되고 나면 더 폴트가 발생하지는 않는다. 이것","words":[{"text":"발생한다.","x":293,"y":2020,"width":145,"height":36},{"text":"일단","x":456,"y":2021,"width":65,"height":34},{"text":"필요한","x":534,"y":2020,"width":98,"height":35},{"text":"모든","x":642,"y":2023,"width":65,"height":32},{"text":"페이지가","x":718,"y":2022,"width":123,"height":35},{"text":"적재되고","x":851,"y":2022,"width":118,"height":35},{"text":"나면","x":980,"y":2022,"width":58,"height":35},{"text":"더","x":1051,"y":2023,"width":26,"height":35},{"text":"폴트가","x":1090,"y":2023,"width":92,"height":35},{"text":"발생하지는","x":1192,"y":2024,"width":156,"height":35},{"text":"않는다.","x":1359,"y":2024,"width":102,"height":34},{"text":"이것","x":1477,"y":2024,"width":62,"height":34}]},{"text":"이 순수 요구 페이å(pure demand paging)이다. 즉, 어떤 페이지가 필요해지기 전에","words":[{"text":"이","x":296,"y":2081,"width":28,"height":36},{"te