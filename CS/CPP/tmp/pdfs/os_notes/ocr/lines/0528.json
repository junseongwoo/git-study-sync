{"page":528,"width":1663,"height":2525,"text_angle":0,"lines":[{"text":"590","words":[{"text":"590","x":181,"y":141,"width":56,"height":28}]},{"text":"Chapter 13 파일 시스템 인터페이스","words":[{"text":"Chapter","x":306,"y":145,"width":113,"height":28},{"text":"13","x":432,"y":147,"width":34,"height":21},{"text":"파일","x":494,"y":149,"width":40,"height":24},{"text":"시스템","x":544,"y":149,"width":60,"height":24},{"text":"인터페이스","x":614,"y":149,"width":103,"height":25}]},{"text":"시작","words":[{"text":"시작","x":472,"y":270,"width":45,"height":26}]},{"text":"현재 위치","words":[{"text":"현재","x":837,"y":272,"width":43,"height":25},{"text":"위치","x":890,"y":272,"width":42,"height":25}]},{"text":"- 되감기","words":[{"text":"-","x":491,"y":441,"width":151,"height":25},{"text":"되감기","x":656,"y":441,"width":64,"height":26}]},{"text":"읽기 또는 쓰기 -","words":[{"text":"읽기","x":952,"y":465,"width":43,"height":25},{"text":"또는","x":1004,"y":465,"width":47,"height":25},{"text":"쓰기","x":1059,"y":464,"width":47,"height":26},{"text":"-","x":1120,"y":465,"width":58,"height":25}]},{"text":"그림 13.4 순차 접근 파일","words":[{"text":"그림","x":738,"y":531,"width":45,"height":27},{"text":"13.4","x":794,"y":532,"width":52,"height":23},{"text":"순차","x":874,"y":530,"width":48,"height":27},{"text":"접근","x":931,"y":531,"width":48,"height":26},{"text":"파일","x":988,"y":530,"width":47,"height":27}]},{"text":"13.2 접근 방법 Access Methods","words":[{"text":"13.2","x":175,"y":660,"width":111,"height":36},{"text":"접근","x":320,"y":657,"width":70,"height":39},{"text":"방법","x":402,"y":658,"width":66,"height":41},{"text":"Access","x":496,"y":669,"width":121,"height":24},{"text":"Methods","x":629,"y":667,"width":141,"height":26}]},{"text":"파일은 정보를 저장한다 파일이 시용될 때는 이 정보가 반드시 접근되어 컴퓨터 메모리","words":[{"text":"파일은","x":298,"y":748,"width":91,"height":34},{"text":"정보를","x":402,"y":748,"width":87,"height":35},{"text":"저장한다","x":502,"y":748,"width":121,"height":35},{"text":"파일이","x":636,"y":747,"width":84,"height":35},{"text":"시용될","x":735,"y":745,"width":85,"height":36},{"text":"때는","x":835,"y":745,"width":60,"height":34},{"text":"이","x":907,"y":745,"width":25,"height":35},{"text":"정보가","x":949,"y":745,"width":92,"height":36},{"text":"반드시","x":1054,"y":746,"width":91,"height":34},{"text":"접근되어","x":1164,"y":745,"width":127,"height":35},{"text":"컴퓨터","x":1311,"y":745,"width":93,"height":34},{"text":"메모리","x":1422,"y":745,"width":90,"height":36}]},{"text":"로 읽혀야 한다. 일부 시스템은 파일에 대해 단 하나의 접근 방법만 제공한다. 다른 운영","words":[{"text":"로","x":296,"y":809,"width":30,"height":25},{"text":"읽혀야","x":340,"y":805,"width":89,"height":35},{"text":"한다.","x":440,"y":806,"width":64,"height":33},{"text":"일부","x":520,"y":805,"width":56,"height":35},{"text":"시스템은","x":588,"y":805,"width":115,"height":34},{"text":"파일에","x":714,"y":803,"width":85,"height":34},{"text":"대해","x":814,"y":803,"width":57,"height":34},{"text":"단","x":885,"y":803,"width":30,"height":33},{"text":"하나의","x":927,"y":803,"width":89,"height":35},{"text":"접근","x":1032,"y":804,"width":63,"height":34},{"text":"방법만","x":1108,"y":803,"width":98,"height":35},{"text":"제공한다.","x":1219,"y":803,"width":140,"height":35},{"text":"다른","x":1376,"y":802,"width":65,"height":35},{"text":"운영","x":1453,"y":804,"width":58,"height":35}]},{"text":"체제면, 메인 프레임 운영체제)는 많은 접근 방법을 지원하며 특정 응용 프로그램에 적","words":[{"text":"체제면,","x":296,"y":862,"width":108,"height":38},{"text":"메인","x":418,"y":863,"width":57,"height":34},{"text":"프레임","x":488,"y":862,"width":85,"height":34},{"text":"운영체제)는","x":587,"y":861,"width":157,"height":37},{"text":"많은","x":756,"y":860,"width":60,"height":35},{"text":"접근","x":829,"y":860,"width":59,"height":34},{"text":"방법을","x":900,"y":861,"width":92,"height":34},{"text":"지원하며","x":1007,"y":861,"width":122,"height":35},{"text":"특정","x":1145,"y":861,"width":63,"height":34},{"text":"응용","x":1224,"y":861,"width":69,"height":34},{"text":"프로그램에","x":1306,"y":861,"width":163,"height":35},{"text":"적","x":1486,"y":863,"width":25,"height":33}]},{"text":"합한 것을 선택하는 것이 주요 설계 문제이다.","words":[{"text":"합한","x":294,"y":920,"width":61,"height":34},{"text":"것을","x":367,"y":921,"width":58,"height":34},{"text":"선택하는","x":437,"y":920,"width":115,"height":35},{"text":"것이","x":565,"y":920,"width":52,"height":34},{"text":"주요","x":630,"y":921,"width":58,"height":32},{"text":"설계","x":700,"y":918,"width":55,"height":34},{"text":"문제이다.","x":768,"y":918,"width":126,"height":34}]},{"text":"13.2.1 순차 접근 sequential Access","words":[{"text":"13.2.1","x":293,"y":1029,"width":122,"height":29},{"text":"순차","x":454,"y":1029,"width":57,"height":31},{"text":"접근","x":520,"y":1029,"width":54,"height":31},{"text":"sequential","x":595,"y":1034,"width":143,"height":26},{"text":"Access","x":744,"y":1034,"width":103,"height":21}]},{"text":"가장 간단한 접근 방법은 순차 접근이다. 이것은 디스크에 있는 파일을 마치 오디오의","words":[{"text":"가장","x":294,"y":1099,"width":60,"height":35},{"text":"간단한","x":368,"y":1099,"width":90,"height":35},{"text":"접근","x":472,"y":1100,"width":56,"height":34},{"text":"방법은","x":542,"y":1099,"width":87,"height":36},{"text":"순차","x":641,"y":1098,"width":60,"height":35},{"text":"접근이다.","x":715,"y":1097,"width":124,"height":35},{"text":"이것은","x":857,"y":1097,"width":91,"height":35},{"text":"디스크에","x":963,"y":1098,"width":123,"height":35},{"text":"있는","x":1107,"y":1098,"width":63,"height":34},{"text":"파일을","x":1185,"y":1098,"width":102,"height":34},{"text":"마치","x":1302,"y":1098,"width":63,"height":34},{"text":"오디오의","x":1385,"y":1097,"width":125,"height":35}]},{"text":"카세트테이프를 재생하는 방식처럼 접근한다. 즉, 여기에서 접근 방법은 저장되어 있는","words":[{"text":"카세트테이프를","x":293,"y":1157,"width":208,"height":35},{"text":"재생하는","x":514,"y":1158,"width":115,"height":34},{"text":"방식처럼","x":642,"y":1156,"width":113,"height":35},{"text":"접근한다.","x":772,"y":1155,"width":125,"height":35},{"text":"즉,","x":912,"y":1158,"width":39,"height":33},{"text":"여기에서","x":968,"y":1156,"width":121,"height":35},{"text":"접근","x":1109,"y":1156,"width":64,"height":34},{"text":"방법은","x":1188,"y":1156,"width":101,"height":34},{"text":"저장되어","x":1305,"y":1154,"width":127,"height":36},{"text":"있는","x":1453,"y":1155,"width":60,"height":33}]},{"text":"레코드 순서로 접근한다. 이 접근 모드는 가장 일반적이며 예를 들면, 편집기나 컴파일러","words":[{"text":"레코드","x":294,"y":1215,"width":88,"height":34},{"text":"순서로","x":392,"y":1216,"width":88,"height":34},{"text":"접근한다.","x":493,"y":1216,"width":119,"height":34},{"text":"이","x":627,"y":1215,"width":24,"height":34},{"text":"접근","x":666,"y":1214,"width":57,"height":34},{"text":"모드는","x":733,"y":1216,"width":90,"height":31},{"text":"가장","x":834,"y":1214,"width":61,"height":34},{"text":"일반적이며","x":907,"y":1214,"width":150,"height":34},{"text":"예를","x":1073,"y":1214,"width":65,"height":34},{"text":"들면,","x":1149,"y":1213,"width":75,"height":35},{"text":"편집기나","x":1239,"y":1213,"width":134,"height":35},{"text":"컴파일러","x":1386,"y":1212,"width":122,"height":35}]},{"text":"는 보통 이러한 형식으로 파일에 접근한다.","words":[{"text":"는","x":291,"y":1275,"width":32,"height":31},{"text":"보통","x":332,"y":1275,"width":60,"height":33},{"text":"이러한","x":403,"y":1274,"width":88,"height":35},{"text":"형식으로","x":501,"y":1274,"width":115,"height":34},{"text":"파일에","x":625,"y":1273,"width":86,"height":36},{"text":"접근한다.","x":725,"y":1272,"width":124,"height":36}]},{"text":"파일에 대한 대부분의 연산은 읽기(read)와 쓰기(write)이다. 읽기는 파일의 다","words":[{"text":"파일에","x":347,"y":1331,"width":88,"height":35},{"text":"대한","x":454,"y":1331,"width":58,"height":35},{"text":"대부분의","x":527,"y":1332,"width":114,"height":34},{"text":"연산은","x":662,"y":1331,"width":87,"height":34},{"text":"읽기(read)와","x":767,"y":1331,"width":186,"height":37},{"text":"쓰기(write)이다.","x":968,"y":1330,"width":256,"height":38},{"text":"읽기는","x":1248,"y":1330,"width":101,"height":35},{"text":"파일의","x":1366,"y":1328,"width":96,"height":36},{"text":"다","x":1482,"y":1329,"width":30,"height":35}]},{"text":"터 차례로 읽어 나간다. 읽으면 지동으로 현재 위치를 추적하는 파일 포인터","words":[{"text":"터","x":425,"y":1390,"width":24,"height":34},{"text":"차례로","x":467,"y":1390,"width":86,"height":34},{"text":"읽어","x":569,"y":1390,"width":52,"height":35},{"text":"나간다.","x":639,"y":1390,"width":94,"height":36},{"text":"읽으면","x":752,"y":1390,"width":85,"height":34},{"text":"지동으로","x":853,"y":1389,"width":123,"height":35},{"text":"현재","x":992,"y":1389,"width":59,"height":35},{"text":"위치를","x":1071,"y":1389,"width":97,"height":35},{"text":"추적하는","x":1184,"y":1388,"width":136,"height":35},{"text":"파일","x":1335,"y":1387,"width":64,"height":35},{"text":"포인터","x":1417,"y":1387,"width":91,"height":35}]},{"text":"(offset)가 지동으로 증가한다. 마찬가지로 쓰기 작업은 파일의 끝에 추가하며 새로운 파","words":[{"text":"(offset)가","x":293,"y":1449,"width":135,"height":37},{"text":"지동으로","x":437,"y":1449,"width":115,"height":35},{"text":"증가한다.","x":562,"y":1449,"width":123,"height":35},{"text":"마찬가지로","x":698,"y":1448,"width":149,"height":35},{"text":"쓰기","x":858,"y":1448,"width":57,"height":35},{"text":"작업은","x":931,"y":1448,"width":93,"height":35},{"text":"파일의","x":1036,"y":1447,"width":93,"height":35},{"text":"끝에","x":1145,"y":1447,"width":64,"height":34},{"text":"추가하며","x":1224,"y":1446,"width":132,"height":36},{"text":"새로운","x":1372,"y":1445,"width":99,"height":35},{"text":"파","x":1482,"y":1446,"width":31,"height":34}]},{"text":"일의 끝으로 파일 포인터가 이동한다. 오프셋을 맨 앞이나 맨 뒤로 옮길 수도 있고, 정수","words":[{"text":"일의","x":294,"y":1506,"width":54,"height":36},{"text":"끝으로","x":362,"y":1509,"width":88,"height":32},{"text":"파일","x":460,"y":1507,"width":56,"height":36},{"text":"포인터가","x":528,"y":1507,"width":117,"height":35},{"text":"이동한다.","x":657,"y":1506,"width":122,"height":36},{"text":"오프셋을","x":793,"y":1506,"width":122,"height":35},{"text":"맨","x":927,"y":1506,"width":30,"height":34},{"text":"앞이나","x":970,"y":1506,"width":95,"height":35},{"text":"맨","x":1077,"y":1506,"width":31,"height":33},{"text":"뒤로","x":1122,"y":1505,"width":66,"height":35},{"text":"옮길","x":1200,"y":1505,"width":66,"height":34},{"text":"수도","x":1280,"y":1505,"width":69,"height":35},{"text":"있고,","x":1364,"y":1504,"width":71,"height":34},{"text":"정수","x":1452,"y":1503,"width":60,"height":35}]},{"text":"71(아마도 ,i=1일 수 있다)개의 레코드만큼 앞뒤로 건너뛸 수도 있다. 순자 접근은 그림","words":[{"text":"71(아마도","x":292,"y":1565,"width":119,"height":37},{"text":",i=1일","x":423,"y":1566,"width":81,"height":34},{"text":"수","x":518,"y":1566,"width":30,"height":34},{"text":"있다)개의","x":563,"y":1565,"width":122,"height":38},{"text":"레코드만큼","x":702,"y":1565,"width":148,"height":34},{"text":"앞뒤로","x":865,"y":1564,"width":91,"height":35},{"text":"건너뛸","x":971,"y":1564,"width":92,"height":35},{"text":"수도","x":1078,"y":1564,"width":66,"height":34},{"text":"있다.","x":1162,"y":1563,"width":72,"height":35},{"text":"순자","x":1251,"y":1563,"width":69,"height":35},{"text":"접근은","x":1337,"y":1562,"width":99,"height":35},{"text":"그림","x":1449,"y":1562,"width":59,"height":34}]},{"text":"13.4에서 예시한다. 순차 접근은 테이프 모델에 기반하며 임의 접근 장치는 물론 순자","words":[{"text":"13.4에서","x":293,"y":1625,"width":113,"height":34},{"text":"예시한다.","x":424,"y":1624,"width":119,"height":35},{"text":"순차","x":558,"y":1624,"width":60,"height":34},{"text":"접근은","x":632,"y":1623,"width":87,"height":34},{"text":"테이프","x":733,"y":1622,"width":88,"height":35},{"text":"모델에","x":835,"y":1622,"width":90,"height":35},{"text":"기반하며","x":944,"y":1622,"width":121,"height":36},{"text":"임의","x":1087,"y":1622,"width":59,"height":35},{"text":"접근","x":1168,"y":1622,"width":65,"height":34},{"text":"장치는","x":1249,"y":1622,"width":103,"height":35},{"text":"물론","x":1366,"y":1621,"width":68,"height":34},{"text":"순자","x":1449,"y":1621,"width":63,"height":35}]},{"text":"접근 장치에서도 久卜우할 수 있다.","words":[{"text":"접근","x":294,"y":1683,"width":58,"height":35},{"text":"장치에서도","x":361,"y":1683,"width":144,"height":36},{"text":"久卜우할","x":515,"y":1682,"width":87,"height":35},{"text":"수","x":611,"y":1682,"width":29,"height":34},{"text":"있다.","x":652,"y":1681,"width":63,"height":35}]},{"text":"13.2.2 직접 접근 DirectAccess","words":[{"text":"13.2.2","x":293,"y":1794,"width":130,"height":29},{"text":"직접","x":460,"y":1792,"width":51,"height":33},{"text":"접근","x":521,"y":1791,"