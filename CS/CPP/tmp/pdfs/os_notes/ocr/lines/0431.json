ht":35},{"text":"변경을","x":453,"y":1817,"width":86,"height":36},{"text":"시작한다.","x":552,"y":1818,"width":122,"height":36},{"text":"일반","x":692,"y":1818,"width":58,"height":35},{"text":"디스크","x":763,"y":1817,"width":89,"height":36},{"text":"드라이브의","x":865,"y":1817,"width":151,"height":36},{"text":"저장","x":1034,"y":1816,"width":63,"height":36},{"text":"용량은","x":1110,"y":1816,"width":100,"height":35},{"text":"기가바이트","x":1225,"y":1815,"width":169,"height":36},{"text":"및","x":1410,"y":1817,"width":30,"height":35},{"text":"테라","x":1457,"y":1817,"width":65,"height":35}]},{"text":"바이트로 측정된다. 덮개가 제거된 디스크 드라이브가 그림 11.2에 나와 있다.","words":[{"text":"바이트로","x":290,"y":1875,"width":120,"height":36},{"text":"측정된다.","x":421,"y":1877,"width":123,"height":35},{"text":"덮개가","x":558,"y":1878,"width":88,"height":36},{"text":"제거된","x":656,"y":1878,"width":87,"height":36},{"text":"디스크","x":756,"y":1877,"width":89,"height":36},{"text":"드라이브가","x":856,"y":1877,"width":155,"height":36},{"text":"그림","x":1021,"y":1877,"width":59,"height":35},{"text":"11.2에","x":1097,"y":1877,"width":93,"height":35},{"text":"나와","x":1205,"y":1875,"width":67,"height":37},{"text":"있다.","x":1286,"y":1875,"width":73,"height":37}]},{"text":"디스크 드라이브 모터는 고속으로 회전한다. 대부분의 드라이브는 분당 회전수","words":[{"text":"디스크","x":348,"y":1936,"width":90,"height":35},{"text":"드라이브","x":455,"y":1937,"width":120,"height":36},{"text":"모터는","x":592,"y":1939,"width":90,"height":35},{"text":"고속으로","x":698,"y":1938,"width":122,"height":35},{"text":"회전한다.","x":839,"y":1938,"width":131,"height":35},{"text":"대부분의","x":992,"y":1937,"width":126,"height":36},{"text":"드라이브는","x":1139,"y":1936,"width":174,"height":37},{"text":"분당","x":1331,"y":1936,"width":71,"height":37},{"text":"회전수","x":1422,"y":1936,"width":100,"height":36}]},{"text":"(RPM) 단위로 표현되며 초당 60~250회 회전한다. 일반 드라이브는 5,400, 7,200,","words":[{"text":"(RPM)","x":291,"y":1999,"width":103,"height":36},{"text":"단위로","x":413,"y":1996,"width":89,"height":35},{"text":"표현되며","x":518,"y":1998,"width":115,"height":36},{"text":"초당","x":653,"y":1998,"width":59,"height":36},{"text":"60~250회","x":726,"y":1998,"width":138,"height":35},{"text":"회전한다.","x":885,"y":1997,"width":131,"height":36},{"text":"일반","x":1038,"y":1997,"width":63,"height":35},{"text":"드라이브는","x":1117,"y":1997,"width":170,"height":36},{"text":"5,400,","x":1303,"y":2000,"width":102,"height":34},{"text":"7,200,","x":1424,"y":2000,"width":97,"height":34}]},{"text":"10,000 및 15,000 RPM에서 회전한다. 일부 드라이브는 사용하지 않을 때 전원이 끼지","words":[{"text":"10,000","x":291,"y":2060,"width":92,"height":31},{"text":"및","x":399,"y":2056,"width":25,"height":35},{"text":"15,000","x":439,"y":2060,"width":91,"height":32},{"text":"RPM에서","x":543,"y":2058,"width":130,"height":35},{"text":"회전한다.","x":690,"y":2057,"width":122,"height":36},{"text":"일부","x":830,"y":2057,"width":58,"height":36},{"text":"드라이브는","x":900,"y":2057,"width":156,"height":37},{"text":"사용하지","x":1068,"y":2057,"width":127,"height":37},{"text":"않을","x":1214,"y":2058,"width":66,"height":36},{"text":"때","x":1294,"y":2058,"width":29,"height":36},{"text":"전원이","x":1343,"y":2057,"width":96,"height":36},{"text":"끼지","x":1458,"y":2056,"width":59,"height":36}]},{"text":"고 I/O 요청을 받으면 회전한다. 회전 속도는 전송 속도와 관련이 있다. 전송 속도는 드","words":[{"text":"고","x":290,"y":2120,"width":29,"height":24},{"text":"I/O","x":330,"y":2118,"width":59,"height":32},{"text":"요청을","x":402,"y":2115,"width":89,"height":35},{"text":"받으면","x":503,"y":2116,"width":86,"height":34},{"text":"회전한다.","x":604,"y":2117,"width":122,"height":35},{"text":"회전","x":740,"y":2117,"width":57,"height":35},{"text":"속도는","x":809,"y":2117,"width":92,"height":34},{"text":"전송","x":913,"y":2118,"width":61,"height":34},{"text":"속도와","x":985,"y":2118,"width":96,"height":35},{"text":"관련이","x":1092,"y":2118,"width":95,"height":36},{"text":"있다.","x":1207,"y":2118,"width":71,"height":36},{"text":"전송","x":1296,"y":2118,"width":67,"height":35},{"text":"속도는","x":1375,"y":2118,"width":103,"height":34},{"text":"드","x":1490,"y":2120,"width":32,"height":26}]},{"text":"라이브와 컴퓨터 간의 데이터 흐름의 속도이다. 또 다른 성능 측면인 위치 지정 시간 또","words":[{"text":"라이브와","x":291,"y":2174,"width":119,"height":36},{"text":"컴퓨터","x":422,"y":2174,"width":84,"height":35},{"text":"간의","x":523,"y":2176,"width":55,"height":34},{"text":"데이터","x":594,"y":2176,"width":83,"height":35},{"text":"흐름의","x":693,"y":2176,"width":85,"height":35},{"text":"속도이다.","x":793,"y":2176,"width":127,"height":35},{"text":"또","x":936,"y":2180,"width":29,"height":26},{"text":"다른","x":979,"y":2177,"width":62,"height":35},{"text":"성능","x":1054,"y":2177,"width":64,"height":35},{"text":"측면인","x":1130,"y":2178,"width":99,"height":35},{"text":"위치","x":1245,"y":2177,"width":63,"height":36},{"text":"지정","x":1328,"y":2177,"width":63,"height":36},{"text":"시간","x":1410,"y":2176,"width":68,"height":35},{"text":"또","x":1490,"y":2179,"width":32,"height":25}]},{"text":"는 임의 액세스 시간은 두 부분으로 구성된다. 디스크 암을 원하는 실린더로 이동하는","words":[{"text":"는","x":288,"y":2235,"width":29,"height":31},{"text":"임의","x":333,"y":2233,"width":54,"height":34},{"text":"액세스","x":406,"y":2232,"width":89,"height":35},{"text":"시간은","x":510,"y":2233,"width":89,"height":34},{"text":"두","x":613,"y":2236,"width":29,"height":33},{"text":"부분으로","x":656,"y":2235,"width":117,"height":34},{"text":"구성된다.","x":787,"y":2235,"width":128,"height":35},{"text":"디스크","x":933,"y":2235,"width":91,"height":36},{"text":"암을","x":1040,"y":2236,"width":63,"height":34},{"text":"원하는","x":1120,"y":2237,"width":98,"height":34},{"text":"실린더로","x":1235,"y":2236,"width":136,"height":36},{"text":"이동하는","x":1390,"y":2234,"width":131,"height":38}]},{"text":"데 필요한 시간(탐색 시간)과 원하는 섹터가 디스크 헤드 위지까지 회전하는 데 걸리는","words":[{"text":"데","x":288,"y":2291,"width":25,"height":34},{"text":"필요한","x":330,"y":2291,"width":89,"height":34},{"text":"시간(탐색","x":432,"y":2291,"width":128,"height":37},{"text":"시간)과","x":576,"y":2292,"width":100,"height":37},{"text":"원하는","x":689,"y":2293,"width":88,"height":35},{"text":"섹터가","x":790,"y":2293,"width":91,"height":35},{"text":