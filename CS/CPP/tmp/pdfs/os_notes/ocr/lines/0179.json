"x":623,"y":1228,"width":52,"height":29},{"text":"5.6","x":687,"y":1230,"width":42,"height":25},{"text":"총처리","x":761,"y":1229,"width":81,"height":30},{"text":"시간이","x":854,"y":1228,"width":79,"height":31},{"text":"시간","x":944,"y":1228,"width":56,"height":31},{"text":"할당량에","x":1009,"y":1228,"width":108,"height":31},{"text":"따라","x":1129,"y":1229,"width":55,"height":30},{"text":"변하는","x":1195,"y":1229,"width":80,"height":30},{"text":"모습","x":1283,"y":1229,"width":56,"height":30}]},{"text":"처리 시간은 29이다. 시간 할당량이 10이라면, 평균 총처리 시간은 20으로 떨어진다. 문","words":[{"text":"처리","x":318,"y":1368,"width":60,"height":39},{"text":"시간은","x":396,"y":1367,"width":99,"height":39},{"text":"29이다.","x":506,"y":1368,"width":112,"height":39},{"text":"시간","x":635,"y":1368,"width":67,"height":39},{"text":"할당량이","x":714,"y":1369,"width":131,"height":38},{"text":"10이라면,","x":863,"y":1369,"width":150,"height":39},{"text":"평균","x":1029,"y":1369,"width":67,"height":38},{"text":"총처리","x":1109,"y":1370,"width":101,"height":38},{"text":"시간은","x":1227,"y":1370,"width":102,"height":38},{"text":"20으로","x":1340,"y":1372,"width":108,"height":32},{"text":"떨어진다.","x":1464,"y":1369,"width":141,"height":39},{"text":"문","x":1619,"y":1372,"width":36,"height":35}]},{"text":"맥 교환 시간이 추가된다면 더 많은 문맥 교환이 요구되기 때문에, 더 작은 시간 할당량","words":[{"text":"맥","x":318,"y":1433,"width":29,"height":38},{"text":"교환","x":364,"y":1432,"width":66,"height":37},{"text":"시간이","x":443,"y":1431,"width":94,"height":39},{"text":"추가된다면","x":554,"y":1433,"width":166,"height":38},{"text":"더","x":737,"y":1433,"width":27,"height":38},{"text":"많은","x":783,"y":1433,"width":68,"height":38},{"text":"문맥","x":864,"y":1433,"width":65,"height":37},{"text":"교환이","x":946,"y":1433,"width":100,"height":38},{"text":"요구되기","x":1063,"y":1434,"width":134,"height":38},{"text":"때문에,","x":1216,"y":1434,"width":109,"height":39},{"text":"더","x":1342,"y":1435,"width":28,"height":38},{"text":"작은","x":1388,"y":1435,"width":68,"height":38},{"text":"시간","x":1470,"y":1434,"width":69,"height":39},{"text":"할당량","x":1552,"y":1434,"width":102,"height":39}]},{"text":"에 대해서는 평균 총처리 시간이 증가한다.","words":[{"text":"에","x":319,"y":1497,"width":28,"height":38},{"text":"대해서는","x":364,"y":1496,"width":130,"height":39},{"text":"평균","x":507,"y":1496,"width":65,"height":38},{"text":"총처리","x":584,"y":1496,"width":96,"height":39},{"text":"시간이","x":697,"y":1496,"width":95,"height":39},{"text":"증가한다.","x":808,"y":1496,"width":144,"height":39}]},{"text":"시간 할당량이 문맥 교환 시간에 비해 커야 하지만 너무 커서는 안 된다. 앞서 지적","words":[{"text":"시간","x":379,"y":1560,"width":67,"height":39},{"text":"할당량이","x":458,"y":1560,"width":129,"height":39},{"text":"문맥","x":605,"y":1561,"width":64,"height":38},{"text":"교환","x":686,"y":1561,"width":67,"height":37},{"text":"시간에","x":767,"y":1561,"width":98,"height":38},{"text":"비해","x":883,"y":1561,"width":64,"height":38},{"text":"커야","x":966,"y":1561,"width":68,"height":38},{"text":"하지만","x":1047,"y":1561,"width":105,"height":38},{"text":"너무","x":1166,"y":1562,"width":68,"height":38},{"text":"커서는","x":1249,"y":1563,"width":101,"height":37},{"text":"안","x":1365,"y":1563,"width":35,"height":37},{"text":"된다.","x":1413,"y":1563,"width":75,"height":38},{"text":"앞서","x":1505,"y":1562,"width":63,"height":38},{"text":"지적","x":1589,"y":1562,"width":63,"height":38}]},{"text":"한 것처럼 시간 할당량이 너무 크다면 RR 스케줄링은 선입 선처리 정책으로 퇴보한다.","words":[{"text":"한","x":318,"y":1626,"width":34,"height":37},{"text":"것처럼","x":367,"y":1625,"width":93,"height":38},{"text":"시간","x":480,"y":1625,"width":66,"height":38},{"text":"할당량이","x":558,"y":1625,"width":130,"height":39},{"text":"너무","x":709,"y":1624,"width":64,"height":39},{"text":"크다면","x":788,"y":1624,"width":100,"height":39},{"text":"RR","x":903,"y":1628,"width":54,"height":29},{"text":"스케줄링은","x":972,"y":1625,"width":172,"height":37},{"text":"선입","x":1159,"y":1626,"width":63,"height":36},{"text":"선처리","x":1242,"y":1627,"width":98,"height":37},{"text":"정책으로","x":1361,"y":1627,"width":136,"height":38},{"text":"퇴보한다.","x":1512,"y":1626,"width":144,"height":38}]},{"text":"경험으로 CPU 버스트의 80%는 시간 할당량보다 짧아야 한다.","words":[{"text":"경험으로","x":321,"y":1689,"width":130,"height":39},{"text":"CPU","x":462,"y":1693,"width":79,"height":31},{"text":"버스트의","x":556,"y":1689,"width":128,"height":39},{"text":"80%는","x":700,"y":1690,"width":104,"height":35},{"text":"시간","x":817,"y":1689,"width":67,"height":38},{"text":"할당량보다","x":895,"y":1688,"width":172,"height":38},{"text":"짧아야","x":1080,"y":1688,"width":104,"height":39},{"text":"한다.","x":1195,"y":1690,"width":76,"height":38}]},{"text":"5.3.4 우선순위 스케줄링","words":[{"text":"5.3.4","x":321,"y":1810,"width":125,"height":32},{"text":"우선순위","x":486,"y":1810,"width":124,"height":35},{"text":"스케줄링","x":622,"y":1810,"width":123,"height":35}]},{"text":"SJF 알고리즘은 일반적인 우선순위 스케줄링 알고리즘의 특별한 경우이다. 우선순위가","words":[{"text":"SJF","x":320,"y":1891,"width":53,"height":37},{"text":"알고리즘은","x":390,"y":1888,"width":166,"height":38},{"text":"일반적인","x":572,"y":1888,"width":131,"height":38},{"text":"우선순위","x":718,"y":1887,"width":132,"height":39},{"text":"스케줄링","x":867,"y":1886,"width":134,"height":39},{"text":"알고리즘의","x":1022,"y":1886,"width":166,"height":39},{"text":"특별한","x":1206,"y":1887,"width":105,"height":38},{"text":"경우이다.","x":1326,"y":1888,"width":143,"height":39},{"text":"우선순위가","x":1486,"y":1888,"width":172,"height":39}]},{"text":"각 프로세스들에 연관되어 있으며, CPU는 가장 높은 우선순위를 가진 프로세스에 할당","words":[{"text":"각","x":322,"y":1952,"width":33,"height":37},{"text":"프로세스들에","x":367,"y":1951,"width":195,"height":38},{"text":"연관되어","x":581,"y":1952,"width":127,"height":38},{"text":"있으며,","x":727,"y":1951,"width":107,"height":39},{"text":"CPU는","x":848,"y":1953,"width":118,"height":34},{"text":"가장","x":979,"y":1951,"width":68,"height":38},{"text":"높은","x":1058,"y":1951,"width":70,"height":36},{"text":"우선순위를","x":1140,"y":1950,"width":171,"height":39},{"text":"가진","x":1324,"y":1952,"width":66,"height":38},{"text":"프로세스에","x":1405,"y":1952,"width":168,"height":38},{"text":"할당","x":1588,"y":1953,"width":70,"height":38}]},{"text":"된다. 우선순위가 같은 프로세스들은 선입 선처리(FCFS) 순서로 스케줄 된다. SJF 알고","words":[{"text":"된다.","x":323,"y":2015,"width":71,"height":38},{"text":"우선순위가","x":409,"y":2014,"width":167,"height":39},{"text":"같은","x":588,"y":2015,"width":67,"height":36},{"text":"프로세스들은","x":667,"y":2016,"width":205,"height":36},{"text":"선입","x":885,"y":2015,"width":63,"height":37},{"text":"선처리(FCFS)","x":966,"y":2015,"width":216,"height":41},{"text":"순서로","x":1197,"y":2015,"width":103,"height":37},{"text":"스케줄","x":1313,"y":2017,"width":103,"height":37},{"text":"된다.","x":1430,"y":2016,"width":74,"height":38},{"text":"SJF","x":1519,"y":2020,"width":55,"height":36},{"text":"알고","x":1589,"y":2017,"width":68,"height":37}]},{"text":"리즘은 우선순위(p)가(예상되는) 다음 CPU 버스트의 역인 단순한 우선순위 알고리즘이","words":[{"text":"리즘은","x":325,"y":2080,"width":96,"height":37},{"text":"우선순위(p)가(예상되는)","x":432,"y":2078,"width":370,"height":42},{"text":"다음","x":818,"y":2079,"width":68,"height":37},{"text":"CPU","x":898,"y":2082,"width":81,"height":31},{"text":"버스트의","x":995,"y":2078,"width":130,"height":38},{"text":"역인","x":1143,"y":2078,"width":63,"height":37},{"text":"단순한","x":1220,"y":2078,"width":104,"height":38},{"text":"우선순위","x":1335,"y":2080,"width":134,"height":39},{"text":"알고리즘이","x":1487,"y":2080,"width":167,"height":40}]},{"text":"다. CPU 버스트가 클수록 우선순위가 낮으며, 그 역도 성립한다.","words":[{"text":"다.","x":323,"y":2143,"width":39,"height":38},{"text":"CPU","x":375,"y":2145,"width":78,"height":30},{"text":"버스트가","x":468,"y":2141,"width":133,"height":38},{"text":"클수록","x":612,"y":2142,"width":101,"height":37},{"text":"우선순위가","x":724,"y":2142,"width":171,"height":38},{"text":"낮으며,","x":907,"y":2142,"width":109,"height":39},{"text":"그","x":1029,"y":2147,"width":35,"height":26},{"text":"역도","x":1078,"y":2142,"width":65,"height":37},{"text":"성립한다.","x":1156,"y":2141,"width":142,"height":38}]},{"text":"우리가 높은 우선순위와 낮은 우선순위에 의해 스케줄링을 논의하고 있음에 유의하","words":[{"text":"우리가","x":383,"y":2204,"width":100,"height":38},{"text":"높은","x":496,"y":2205,"width":66,"height":35},{"text":"우선순위와","x":576,"y":2204,"width":170,"height":39},{"text":"낮은","x":759,"y":2206,"width":67,"height":37},{"text":"우선순위에","x":839,"y":2206,"width":167,"height":37},{"text":"의해","x":1023,"y":2205,"width":64,"height":38},{"text":"스케줄링을","x":1104,"y":2205,"width":169,"height":39},{"text":"논의하고","x":1286,"y":2206,"width":138,"height":38},{"text":"있음에","x":1440,"y":2208,"width":97,"height":38},{"text":"유의하","x":1553,"y":2208,"width":106,"height":38}]},{"text":"라. 우선순위는 일반적으로 0에서 7 또는 0에서 4,095까지 같은 일정 범위의 수가 사우","words":[{"text":"라.","x":324,"y":2270,"width":38,"height":37},{"text":"우선순위는","x":378,"y":2267,"width":166,"height":38},{"text":"일반적으로","x":560,"y":2267,"width":166,"height":37},{"text":"0에서","x":739,"y":2268,"width":83,"height":38},{"text":"7","x":840,"y":2273,"width":19,"height":29},{"text":"또는","x":873,"y":2272,"width":69,"height":34},{"text":"0에서","x":955,"y":2270,"width":82,"height":38},{"text":"4,095까지","x":1054,"y":2270,"width":153,"height":38},{"text":"같은","x":1225,"y":2269,"width":68,"height":37},{"text":"일정","x":1309,"y":2270,"width":62,"height":37},{"text":"범위의","x":1390,"y":2271,"width":97,"height":38},{"text":"수가","x":1505,"y":2272,"width":70,"height":37},{"text":"사우","x":1588,"y":2272,"width":70,"height":37}]},{"text":"된다. 그러나 0이 최상위 또는 최하위 우선순위인가에 대해서 일반적인 합의는 없다. 어","words":[{"text":"된다.","x":324,"y":2331,"width":71,"height":38},{"text":"그러나","x":412,"y":2329,"width":99,"height":39},{"text":"0이","x":523,"y":2330,"width":48,"height":38},{"text":"최상위","x":590,"y":2330,"width":97,"height":38},{"text":"또는","x":703,"y":2334,"width":69,"height":35},{"text":"최하위","x":785,"y":2332,"width":97,"height":39},{"text":"우선순위인가에","x":898,"y":2333,"width":235,"height":39},{"text":"대해서","x":1150,"y":2332,"width":96,"height":40},{"text":"일반적인","x":1266,"y":2333,"width":133,"height":38},{"text":"합의는","x":1414,"y":2334,"width":103,"height":38},{"text":"없다.","x":1533,"y":2334,"width":74,"height":38},{"text":"어","x":1625,"y":2334,"width":29,"height":38}]},{"text":"떤 시스템에서는 낮은 값이 낮은 우선순위를 나타내고, 다른 시스템에서는 높은 우선순","words":[{"text":"떤","x":325,"y":2395,"width":30,"height":37},{"text":"시스템에서는","x":370,"y":2393,"width":198,"height":39},{"text":"낮은","x":582,"y":2393,"width":68,"height":38},{"text":"값이","x":664,"y":2395,"width":63,"height":38},{"text":"낮은","x":746,"y":2396,"width":68,"height":38},{"text":"우선순위를","x":827,"y":2397,"width":170,"height":39},{"text":"나타내고,","x":1012,"y":2397,"width":142,"height":40},{"text":"다른","x":1170,"y":2398,"width":67,"height":38},{"text":"시스템에서는","x":1252,"y":2396,"width":206,"height":40},{"text":"높은","x":1470,"y":2398,"width":70,"height":36},{"text":"우선순","x":1553,"y":2398,"width":106,"height":38}]},{"text":"위를 나타낸다. 이러한 차이는 혼란을 야기할 수 있다. 여기서는, 낮은 수가 높은 우선순","words":[{"text":"위를","x":325,"y":2458,"width":64,"height":37},{"text":"나타낸다.","x":403,"y":2456,"width":138,"height":37},{"text":"이러한","x":559,"y":2457,"width":99,"height":37},{"text":"차이는","x":670,"y":2458,"width":102,"height":39},{"text":"혼란을","x":784,"y":2461,"width":103,"height":37},{"text":"야기할","x":901,"y":2461,"width":102,"height":39},{"text":"수","x":1014,"y":2462,"width":34,"height":39},{"text":"있다.","x":1064,"y":2463,"width":71,"height":38},{"text":"여기서는,","x":1153,"y":2461,"width":142,"height":40},{"text":"낮은","x":1309,"y":2460,"width":70,"height":38},{"text":"수가","x":1391,"y":2461,"width":69,"height":38},{"text":"높은","x":1472,"y":2462,"width":70,"height":36},{"text":"우선순","x":1554,"y":2462,"width":104,"height":38}]},{"text":"위를 나타낸다고 가정한다.","words":[{"text":"위를","x":325,"y":2521,"width":65,"height":37},{"text":"나타낸다고","x":402,"y":2518,"width":164,"height":39},{"text":"가정한다.","x":580,"y":2520,"width":139,"height":39}]}]}