width":36,"height":37},{"text":"시스템은","x":464,"y":1169,"width":133,"height":38},{"text":"전통적인","x":612,"y":1169,"width":132,"height":39},{"text":"클라이언트","x":760,"y":1170,"width":170,"height":38},{"text":"서버에","x":947,"y":1170,"width":98,"height":38},{"text":"비해","x":1065,"y":1170,"width":64,"height":39},{"text":"장점을","x":1146,"y":1170,"width":106,"height":39},{"text":"제공한다.","x":1267,"y":1170,"width":148,"height":39},{"text":"클라이언트","x":1432,"y":1170,"width":181,"height":40},{"text":"서버","x":1628,"y":1170,"width":61,"height":41}]},{"text":"시스템에서는 서버가 병목으로 작용한다. 그러나 피어 간 시스템에서는 서비스가 네트워","words":[{"text":"시스템에서는","x":331,"y":1232,"width":204,"height":39},{"text":"서버가","x":547,"y":1233,"width":101,"height":39},{"text":"병목으로","x":660,"y":1234,"width":134,"height":38},{"text":"작용한다.","x":806,"y":1234,"width":145,"height":40},{"text":"그러나","x":966,"y":1235,"width":104,"height":38},{"text":"피어","x":1082,"y":1235,"width":64,"height":39},{"text":"간","x":1163,"y":1235,"width":36,"height":38},{"text":"시스템에서는","x":1211,"y":1235,"width":212,"height":40},{"text":"서비스가","x":1436,"y":1236,"width":145,"height":38},{"text":"네트워","x":1594,"y":1235,"width":96,"height":40}]},{"text":"크에 분한된 여러 노드에 의해 제공될 수 있다.","words":[{"text":"크에","x":329,"y":1297,"width":65,"height":37},{"text":"분한된","x":408,"y":1297,"width":102,"height":37},{"text":"여러","x":524,"y":1297,"width":62,"height":39},{"text":"노드에","x":601,"y":1299,"width":99,"height":38},{"text":"의해","x":717,"y":1299,"width":64,"height":38},{"text":"제공될","x":796,"y":1299,"width":99,"height":39},{"text":"수","x":910,"y":1300,"width":35,"height":38},{"text":"있다.","x":960,"y":1299,"width":72,"height":39}]},{"text":"피어 간 시스템에 참여하기 위해서는 노드는 먼저 피어 간 네트워크에 참가해야 한","words":[{"text":"피어","x":392,"y":1361,"width":64,"height":39},{"text":"간","x":475,"y":1362,"width":35,"height":37},{"text":"시스템에","x":523,"y":1362,"width":131,"height":39},{"text":"참여하기","x":672,"y":1363,"width":131,"height":39},{"text":"위해서는","x":824,"y":1364,"width":136,"height":38},