":34}]},{"text":"한다.","words":[{"text":"한다.","x":354,"y":1889,"width":65,"height":34}]},{"text":"• 디렉터리 관리 루틴은 효율성, 성능 및 안정성을 고려해야 한다. 해시 테이블은 빠르","words":[{"text":"•","x":317,"y":1964,"width":13,"height":13},{"text":"디렉터리","x":356,"y":1956,"width":111,"height":34},{"text":"관리","x":481,"y":1956,"width":54,"height":34},{"text":"루틴은","x":549,"y":1956,"width":87,"height":35},{"text":"효율성,","x":646,"y":1956,"width":94,"height":35},{"text":"성능","x":753,"y":1956,"width":59,"height":34},{"text":"및","x":824,"y":1956,"width":26,"height":34},{"text":"안정성을","x":864,"y":1955,"width":122,"height":34},{"text":"고려해야","x":997,"y":1955,"width":129,"height":35},{"text":"한다.","x":1137,"y":1954,"width":72,"height":33},{"text":"해시","x":1225,"y":1953,"width":62,"height":34},{"text":"테이블은","x":1305,"y":1953,"width":132,"height":34},{"text":"빠르","x":1448,"y":1955,"width":60,"height":33}]},{"text":"고 효율적이므로 일반적으로 시용되는 방법이다. 불행히도, 테이블이 손상되거나 시","words":[{"text":"고","x":352,"y":2017,"width":30,"height":23},{"text":"효율적이므로","x":393,"y":2014,"width":174,"height":33},{"text":"일반적으로","x":580,"y":2013,"width":143,"height":34},{"text":"시용되는","x":733,"y":2013,"width":120,"height":35},{"text":"방법이다.","x":865,"y":2012,"width":128,"height":35},{"text":"불행히도,","x":1007,"y":2012,"width":135,"height":34},{"text":"테이블이","x":1158,"y":2010,"width":128,"height":35},{"text":"손상되거나","x":1302,"y":2010,"width":165,"height":36},{"text":"시","x":1479,"y":2012,"width":25,"height":34}]},{"text":"스템이 크래시 하면 디렉터리 정보와 디스크 내용이 일치하지 않을수 있다.","words":[{"text":"스템이","x":351,"y":2070,"width":85,"height":34},{"text":"크래시","x":450,"y":2070,"width":83,"height":33},{"text":"하면","x":547,"y":2070,"width":56,"height":34},{"text":"디렉터리","x":617,"y":2070,"width":110,"height":34},{"text":"정보와","x":743,"y":2070,"width":89,"height":34},{"text":"디스크","x":843,"y":2070,"width":89,"height":33},{"text":"내용이","x":944,"y":2068,"width":88,"height":34},{"text":"일치하지","x":1049,"y":2068,"width":123,"height":33},{"text":"않을수","x":1189,"y":2067,"widt