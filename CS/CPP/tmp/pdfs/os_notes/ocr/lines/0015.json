{"page":15,"width":1904,"height":2832,"text_angle":0,"lines":[{"text":"1.2 김퓨터 시스템의 구성","words":[{"text":"1.2","x":1275,"y":178,"width":52,"height":24},{"text":"김퓨터","x":1345,"y":178,"width":73,"height":28},{"text":"시스템의","x":1430,"y":177,"width":100,"height":29},{"text":"구성","x":1540,"y":178,"width":50,"height":28}]},{"text":"인터럽트는 장치 컨트롤러가 서비스를 요청하기 위해 A방된다.","words":[{"text":"인터럽트는","x":334,"y":320,"width":170,"height":39},{"text":"장치","x":518,"y":320,"width":63,"height":39},{"text":"컨트롤러가","x":600,"y":320,"width":170,"height":39},{"text":"서비스를","x":784,"y":320,"width":137,"height":40},{"text":"요청하기","x":934,"y":317,"width":135,"height":41},{"text":"위해","x":1088,"y":316,"width":66,"height":40},{"text":"A방된다.","x":1169,"y":316,"width":146,"height":39}]},{"text":"11","words":[{"text":"11","x":1671,"y":172,"width":33,"height":30}]},{"text":"벡터 방식 인터럽트 기법의 목적은 서비스가 필요한 장치를 결정하기 위해 하나의","words":[{"text":"벡터","x":398,"y":384,"width":63,"height":39},{"text":"방식","x":483,"y":384,"width":63,"height":40},{"text":"인터럽트","x":569,"y":385,"width":133,"height":38},{"text":"기법의","x":721,"y":384,"width":98,"height":40},{"text":"목적은","x":839,"y":385,"width":105,"height":38},{"text":"서비스가","x":961,"y":382,"width":140,"height":40},{"text":"필요한","x":1120,"y":382,"width":103,"height":39},{"text":"장치를","x":1238,"y":382,"width":105,"height":38},{"text":"결정하기","x":1361,"y":381,"width":136,"height":40},{"text":"위해","x":1519,"y":382,"width":66,"height":39},{"text":"하나의","x":1605,"y":382,"width":102,"height":39}]},{"text":"인터럽트 핸들러가 가능한 모든 인터럽트 소스를 검색할 필요를 줄이기 위한 것이라는","words":[{"text":"인터럽트","x":334,"y":449,"width":136,"height":39},{"text":"핸들러가","x":488,"y":449,"width":135,"height":39},{"text":"가능한","x":640,"y":449,"width":102,"height":39},{"text":"모든","x":757,"y":451,"width":69,"height":36},{"text":"인터럽트","x":844,"y":449,"width":137,"height":39},{"text":"소스를","x":997,"y":449,"width":106,"height":36},{"text":"검색할","x":1121,"y":447,"width":102,"height":39},{"text":"필요를","x":1240,"y":446,"w