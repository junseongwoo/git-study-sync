ight":35},{"text":"상태","x":444,"y":1024,"width":63,"height":36},{"text":"회피는","x":525,"y":1024,"width":96,"height":37},{"text":"반면에,","x":634,"y":1025,"width":102,"height":37},{"text":"스레드가","x":750,"y":1025,"width":126,"height":37},{"text":"평생","x":889,"y":1026,"width":58,"height":36},{"text":"요구하고","x":963,"y":1026,"width":124,"height":36},{"text":"사용할","x":1100,"y":1026,"width":94,"height":36},{"text":"자원에","x":1205,"y":1026,"width":92,"height":36},{"text":"대한","x":1314,"y":1026,"width":65,"height":37},{"text":"부가적인","x":1390,"y":1024,"width":133,"height":38},{"text":"정","x":1538,"y":1025,"width":29,"height":36}]},{"text":"보를 미리 제공할 것을 요구한다. 이러한 추가적인 지식을 가지고, 운영체제는 각 요청","words":[{"text":"보를","x":302,"y":1087,"width":67,"height":34},{"text":"미리","x":385,"y":1085,"width":61,"height":37},{"text":"제공할","x":467,"y":1086,"width":98,"height":36},{"text":"것을","x":581,"y":1086,"width":62,"height":36},{"text":"요구한다.","x":657,"y":1086,"width":134,"height":36},{"text":"이러한","x":808,"y":1086,"width":94,"height":36},{"text":"추가적인","x":914,"y":1087,"width":124,"height":36},{"text":"지식을","x":1055,"y":1086,"width":92,"height":37},{"text":"가지고,","x":1161,"y":1087,"width":101,"height":36},{"text":"운영체제는","x":1277,"y":1087,"width":165,"height":36},{"text":"각","x":1456,"y":1085,"width":34,"height":36},{"text":"요청","x":1504,"y":1086,"width":63,"height":36}]},{"text":"을 위해 그 스레드가 기다려야 할지 않을지를 결정할 수 있다. 각 요구는 시스템이 현재","words":[{"text":"을","x":301,"y":1147,"width":34,"height":35},{"text":"위해","x":350,"y":1147,"width":63,"height":37},{"text":"그","x":429,"y":1152,"width":33,"height":24},{"text":"스레드가","x":476,"y":1147,"width":131,"height":36},{"text":"기다려야","x":621,"y":1147,"width":126,"height":36},{"text":"할지","x":759,"y":1147,"width":59,"height":36},{"text":"않을지를","x":836,"y":1147,"width":124,"height":37},{"text":"결정할","x":974,"y":1148,"width":93,"height":36},{"text":"수","x":1078,"y":1149,"width":32,"height":34},{"text":"있다.","x":1124,"y":1148,"width":67,"height":36},{"text":"각","x":120