width":28,"height":37},{"text":"자원","x":349,"y":594,"width":64,"height":36},{"text":"클래스","x":426,"y":593,"width":98,"height":37},{"text":"각각에","x":537,"y":594,"width":92,"height":38},{"text":"최적인","x":646,"y":595,"width":91,"height":36},{"text":"해결책을","x":751,"y":595,"width":122,"height":37},{"text":"선택하는","x":886,"y":595,"width":123,"height":37},{"text":"데","x":1022,"y":595,"width":26,"height":37},{"text":"이","x":1065,"y":595,"width":26,"height":37},{"text":"기본적인","x":1108,"y":596,"width":126,"height":37},{"text":"방법들을","x":1248,"y":597,"width":131,"height":36},{"text":"조합하여","x":1391,"y":597,"width":128,"height":37},{"text":"쓸","x":1535,"y":598,"width":34,"height":35}]},{"text":"수 있다.","words":[{"text":"수","x":303,"y":656,"width":33,"height":37},{"text":"있다.","x":350,"y":656,"width":70,"height":36}]},{"text":"교착 상태가 발생하지 않도록 하기 위해 시스템은 교착 상태 예방(prevenhon), 혹","words":[{"text":"교착","x":366,"y":717,"width":66,"height":36},{"text":"상태가","x":445,"y":716,"width":98,"height":37},{"text":"발생하지","x":556,"y":718,"width":123,"height":36},{"text":"않도록","x":697,"y":718,"width":93,"height":37},{"text":"하기","x":802,"y":718,"width":57,"height":38},{"text":"위해","x":877,"y":719,"width":58,"height":37},{"text":"시스템은","x":951,"y":720,"width":124,"height":36},{"text":"교착","x":1088,"y":720,"width":63,"height":36},{"text":"상태","x":1163,"y":720,"width":60,"height":37},{"text":"예방(prevenhon),","x":1241,"y":720,"width":279,"height":43},{"text":"혹","x":1534,"y":720,"width":34,"height":37}]},{"text":"은 회피(avoidence) 기법의 하나를 사용할 수 있다. 교착 상태 예방은 8.3.1절에서 언급","words":[{"text":"은","x":303,"y":779,"width":33,"height":35},{"text":"회피(avoidence)","x":350,"y":779,"width":256,"height":39},{"text":"기법의","x":622,"y":779,"width":90,"height":37},{"text":"하나를","x":728,"y":780,"width":92,"height":36},{"text":"사용할","x":832,"y":780,"width":93,"height":37},{"text":"수","x":934,"y":781,"width":32,"height":37},{"text":"있다.","x":979,"y":781,"width":67,"height":37},{"text":"교착","x":1059,"y":781,"width":63,"heigh