},{"text":"#pragma omp parallel","words":[{"text":"#pragma","x":368,"y":1505,"width":155,"height":38},{"text":"omp","x":546,"y":1516,"width":63,"height":28},{"text":"parallel","x":632,"y":1509,"width":175,"height":36}]},{"text":"시스템의 코어 개수만큼 스레드를 생성한다. 따라서 듀얼 코어 시스템에서는 2개, 쿼드","words":[{"text":"시스템의","x":306,"y":1602,"width":135,"height":38},{"text":"코어","x":460,"y":1605,"width":66,"height":38},{"text":"개수만큼","x":546,"y":1604,"width":138,"height":38},{"text":"스레드를","x":698,"y":1605,"width":141,"height":38},{"text":"생성한다.","x":854,"y":1604,"width":146,"height":38},{"text":"따라서","x":1020,"y":1604,"width":102,"height":39},{"text":"듀얼","x":1141,"y":1604,"width":71,"height":37},{"text":"코어","x":1231,"y":1603,"width":72,"height":37},{"text":"시스템에서는","x":1325,"y":1599,"width":237,"height":41},{"text":"2개,","x":1577,"y":1602,"width":70,"height":38},{"text":"쿼드","x":1665,"y":1603,"width":61,"height":37}]},{"text":"코어 시스템에서는 4개 등 이런 식으로 스레드가 생성된다. 모든 스레드는 동시에 병렬","words":[{"text":"코어","x":306,"y":1666,"width":65,"height":38},{"text":"시스템에서는","x":392,"y":1666,"width":207,"height":40},{"text":"4개","x":611,"y":1668,"width":53,"height":38},{"text":"등","x":681,"y":1670,"width":36,"height":35},{"text":"이런","x":733,"y":1669,"width":65,"height":37},{"text":"식으로","x":816,"y":1668,"width":103,"height":36},{"text":"스레드가","x":934,"y":1667,"width":142,"height":37},{"text":"생성된다.","x":1090,"y":1666,"width":154,"height":38},{"text":"모든","x":1264,"y":1667,"width":77,"height":34},{"text":"스레드는","x":1356,"y":1664,"width":160,"height":38},{"text":"동시에","x":1531,"y":1665,"width":114,"height":38},{"text":"병렬","x":1665,"y":1666,"width":58,"height":39}]},{"text":"영역을 실행하게 된다. 각 스레드가 병렬 영역을 빠져나가면 스레드는 종료된다.","words":[{"text":"영역을","x":309,"y":1729,"width":102,"height":37},{"text":"실행하게","x":424,"y":1730,"width":133,"height":38},{"text":"된다.","x":573,"y":1731,"width":75,"height":37},{"text":"각","x":664,"y":1731,"width":35,"height":37},{"text":"스레드가","x":710,"y":1731,"width":140,"height":38},{"text":"