ght":35},{"text":"제공된다.","x":982,"y":1498,"width":136,"height":36},{"text":"만일","x":1137,"y":1499,"width":65,"height":34},{"text":"파일","x":1220,"y":1500,"width":65,"height":34},{"text":"시스템이","x":1305,"y":1499,"width":129,"height":35},{"text":"모든","x":1453,"y":1501,"width":62,"height":32}]},{"text":"파일 이름에 대해 소유와 접근 제어를 제공하면, 장지도 소유와 접근 제어를 갖게 된다.","words":[{"text":"파일","x":287,"y":1558,"width":57,"height":34},{"text":"이름에","x":360,"y":1557,"width":83,"height":35},{"text":"대해","x":458,"y":1557,"width":55,"height":34},{"text":"소유와","x":528,"y":1558,"width":89,"height":35},{"text":"접근","x":630,"y":1558,"width":57,"height":34},{"text":"제어를","x":700,"y":1558,"width":89,"height":34},{"text":"제공하면,","x":802,"y":1557,"width":129,"height":35},{"text":"장지도","x":945,"y":1556,"width":97,"height":35},{"text":"소유와","x":1056,"y":1557,"width":99,"height":34},{"text":"접근","x":1169,"y":1557,"width":66,"height":34},{"text":"제어를","x":1250,"y":1557,"width":101,"height":35},{"text":"갖게","x":1365,"y":1557,"width":63,"height":34},{"text":"된다.","x":1446,"y":1557,"width":67,"height":35}]},{"text":"파일이 장치에 저장되므로 이러한 인터페이스는 입출력 시스템에 대한 접근을 두 수준","words":[{"text":"파일이","x":288,"y":1616,"width":84,"height":34},{"text":"장치에","x":389,"y":1616,"width":84,"height":34},{"text":"저장되므로","x":490,"y":1616,"width":145,"height":35},{"text":"이러한","x":650,"y":1616,"width":88,"height":35},{"text":"인터페이스는","x":753,"y":1615,"width":181,"height":36},{"text":"입출력","x":951,"y":1614,"width":88,"height":34},{"text":"시스템에","x":1059,"y":1614,"width":128,"height":35},{"text":"대한","x":1207,"y":1615,"width":67,"height":34},{"text":"접근을","x":1290,"y":1615,"width":101,"height":34},{"text":"두","x":1405,"y":1616,"width":33,"height":32},{"text":"수준","x":1452,"y":1614,"width":62,"height":34}]},{"text":"에서 제공한다. 이름은 장치 자체에 접근하거나 또는 그 장치에 저장된 파일에 접근하기","words":[{"text":"에서","x":288,"y":1674,"width":55,"height":34},{"text":"제공한다.","x":358,"y":1674,"width":122,"height":34},{"text":"이름은","x":494,"y":1675,"width":87,"height":33},{"text":"장치","x":592,"y":1675,"width":55,"height":34},{"text":"자체에","x":662,"y":1674,"width":86,"height":35},{"text":"접근하거나","x":764,"y":1673,"width":151,"height":35},{"text":"또는","x":926,"y":1674,"width":64,"height":32},{"text":"그","x":1001,"y":1677,"width":32,"height":23},{"text":"장치에","x":1046,"y":1673,"width":95,"height":34},{"text":"저장된","x":1158,"y":1673,"width":98,"height":34},{"text":"파일에","x":1271,"y":1673,"width":99,"height":34},{"text":"접근하기","x":1387,"y":1672,"width":122,"height":35}]},{"text":"위해 사용될 수 있다.","words":[{"text":"위해","x":289,"y":1732,"width":55,"height":34},{"text":"사용될","x":357,"y":1732,"width":85,"height":34},{"text":"수","x":454,"y":1732,"width":29,"height":35},{"text":"있다.","x":495,"y":1732,"width":62,"height":34}]},{"text":"UNIX는 장치 이름을 보통의 파일 이름처럼 표시한다. MS-DOS 파일명과 달리","words":[{"text":"UNIX는","x":342,"y":1792,"width":119,"height":32},{"text":"장치","x":475,"y":1790,"width":54,"height":35},{"text":"이름을","x":549,"y":1790,"width":88,"height":34},{"text":"보통의","x":651,"y":1791,"width":86,"height":34},{"text":"파일","x":755,"y":1790,"width":59,"height":34},{"text":"이름처럼","x":833,"y":1789,"width":119,"height":35},{"text":"표시한다.","x":971,"y":1790,"width":138,"height":34},{"text":"MS-DOS","x":1128,"y":1792,"width":152,"height":28},{"text":"파일명과","x":1298,"y":1788,"width":136,"height":35},{"text":"달리","x":1450,"y":1788,"width":59,"height":36}]},{"text":"UNIX 경로명은 경로상의 어떤 부분도 장치 이름을 표면적으로 구별하여 나타내지 않","words":[{"text":"UNIX","x":288,"y":1851,"width":87,"height":27},{"text":"경로명은","x":391,"y":1848,"width":114,"height":34},{"text":"경로상의","x":519,"y":1848,"width":111,"height":35},{"text":"어떤","x":649,"y":1848,"width":55,"height":35},{"text":"부분도","x":719,"y":1848,"width":90,"height":34},{"text":"장치","x":822,"y":1848,"width":58,"height":34},{"text":"이름을","x":899,"y":1847,"width":93,"height":35},{"text":"표면적으로","x":1005,"y":1848,"width":163,"height":34},{"text":"구별하여","x":1184,"y":1847,"width":131,"height":34},{"text":"나타내지","x":1336,"y":1846,"width":128,"height":34},{"text":"않","x":1484,"y":1847,"width":29,"height":35}]},{"text":"는다. 실제로는 경로 이름의 어느 부분도 장치의 이름을 나타내지는 않는다. UNIX는 경","words":[{"text":"는다.","x":287,"y":1906,"width":65,"height":34},{"text":"실제로는","x":366,"y":1905,"width":115,"height":34},{"text":"경로","x":493,"y":1906,"width":56,"height":35},{"text":"이름의","x":560,"y":1906,"width":83,"height":34},{"text":"어느","x":658,"y":1906,"width":57,"height":35},{"text":"부분도","x":725,"y":1906,"width":90,"height":35},{"text":"장치의","x":827,"y":1906,"width":88,"height":35},{"text":"이름을","x":931,"y":1905,"width":93,"height":35},{"text":"나타내지는","x":1037,"y":1905,"width":163,"height":35},{"text":"않는다.","x":1214,"y":1905,"width":107,"height":35},{"text":"UNIX는","x":1336,"y":1906,"width":135,"height":32},{"text":"경","x":1484,"y":1905,"width":24,"height":35}]},{"text":"로 이름의 접두어를 특정 장치 이름과 연관시기는 마운트 테이부을 갖고 있다. 경로 이","words":[{"text":"로","x":287,"y":1967,"width":29,"height":26},{"text":"이름의","x":330,"y":1963,"width":84,"height":35},{"text":"접두어를","x":430,"y":1964,"width":114,"height":34},{"text":"특정","x":557,"y":1964,"width":54,"height":34},{"text":"장치","x":628,"y":1964,"width":54,"height":34},{"text":"이름과","x":700,"y":1964,"width":89,"height":34},{"text":"연관시기는","x":803,"y":1964,"width":152,"height":34},{"text":"마운트","x":968,"y":1964,"width":96,"height":34},{"text":"테이부을","x":1079,"y":1962,"width":132,"height":36},{"text":"갖고","x":1227,"y":1963,"width":67,"height":34},{"text":"있다.","x":1312,"y":1963,"width":72,"height":35},{"text":"경로","x":1403,"y":1962,"width":65,"height":35},{"text":"이","x":1483,"y":1964,"width":26,"height":35}]},{"text":"름을 해결하기 위해 UNIX는 마운트 테이블의 이름 중 접두어 부분이 경로명과 일치","words":[{"text":"름을","x":286,"y":2022,"width":60,"height":34},{"text":"해결하기","x":360,"y":2021,"width":112,"height":35},{"text":"위해","x":491,"y":2021,"width":55,"height":35},{"text":"UNIX는","x":562,"y":2024,"width":117,"height":32},{"text":"마운트","x":692,"y":2021,"width":90,"height":35},{"text":"테이블의","x":797,"y":2021,"width":119,"height":35},{"