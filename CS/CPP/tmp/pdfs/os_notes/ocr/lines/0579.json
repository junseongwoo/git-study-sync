{"page":579,"width":1664,"height":2535,"text_angle":0,"lines":[{"text":"642","words":[{"text":"642","x":165,"y":154,"width":57,"height":29}]},{"text":"Chapter 14 파일 시스템 구현","words":[{"text":"Chapter","x":291,"y":156,"width":115,"height":27},{"text":"14","x":418,"y":157,"width":36,"height":20},{"text":"파일","x":482,"y":156,"width":41,"height":25},{"text":"시스템","x":532,"y":157,"width":62,"height":25},{"text":"구현","x":603,"y":158,"width":41,"height":25}]},{"text":"한다. 적은 양의 데이터가 파일에 쓰일 때, 페이지는 개시에 버퍼 되고, 디스크 드라이버","words":[{"text":"한다.","x":292,"y":277,"width":67,"height":35},{"text":"적은","x":376,"y":278,"width":59,"height":35},{"text":"양의","x":447,"y":278,"width":56,"height":36},{"text":"데이터가","x":519,"y":279,"width":118,"height":36},{"text":"파일에","x":648,"y":280,"width":86,"height":35},{"text":"쓰일","x":748,"y":280,"width":57,"height":35},{"text":"때,","x":819,"y":281,"width":35,"height":36},{"text":"페이지는","x":869,"y":281,"width":120,"height":36},{"text":"개시에","x":1003,"y":282,"width":89,"height":36},{"text":"버퍼","x":1109,"y":281,"width":57,"height":37},{"text":"되고,","x":1185,"y":281,"width":71,"height":36},{"text":"디스크","x":1273,"y":280,"width":97,"height":36},{"text":"드라이버","x":1384,"y":280,"width":124,"height":37}]},{"text":"는 자신의 출력 큐를 장치 주소에 따라 소트한니1 이러한 두 가지 행-동은 디스크 드리心1","words":[{"text":"는","x":291,"y":338,"width":31,"height":32},{"text":"자신의","x":336,"y":336,"width":87,"height":34},{"text":"출력","x":438,"y":336,"width":56,"height":35},{"text":"큐를","x":510,"y":339,"width":61,"height":33},{"text":"장치","x":583,"y":338,"width":54,"height":36},{"text":"주소에","x":653,"y":338,"width":86,"height":35},{"text":"따라","x":754,"y":339,"width":59,"height":36},{"text":"소트한니1","x":824,"y":340,"width":127,"height":35},{"text":"이러한","x":967,"y":340,"width":92,"height":36},{"text":"두","x":1071,"y":342,"width":32,"height":34},{"text":"가지","x":1117,"y":341,"width":58,"height":35},{"text":"행-동은","x":1193,"y":340,"width":98,"height":36},{"text":"디스크","x":1306,"y":339,"width":98,"height":35},{"text":"드리心1","x":1418,"y":339,"width":90,"height":37}]},{"text":"버가 디스크 헤드 탐색을 최소회할 수 있게 한다. 동기식 쓰기가 필요하지 않다면, 디스","words":[{"text":"버가","x":292,"y":393,"width":60,"height":36},{"text":"디스크","x":366,"y":394,"width":90,"height":35},{"text":"헤드","x":469,"y":395,"width":60,"height":34},{"text":"탐색을","x":541,"y":396,"width":89,"height":35},{"text":"최소회할","x":644,"y":397,"width":117,"height":35},{"text":"수","x":772,"y":397,"width":30,"height":35},{"text":"있게","x":816,"y":398,"width":55,"height":35},{"text":"한다.","x":886,"y":399,"width":66,"height":35},{"text":"동기식","x":968,"y":399,"width":89,"height":36},{"text":"쓰기가","x":1074,"y":399,"width":96,"height":36},{"text":"필요하지","x":1185,"y":398,"width":125,"height":36},{"text":"않다면,","x":1329,"y":398,"width":106,"height":37},{"text":"디스","x":1453,"y":398,"width":59,"height":36}]},{"text":"그에 쓰기를 하는 프로세스는 단순히 개시에 쓰고, 시스템은 편리할 때, 비동기식으로 디","words":[{"text":"그에","x":291,"y":453,"width":58,"height":35},{"text":"쓰기를","x":363,"y":453,"width":92,"height":35},{"text":"하는","x":466,"y":453,"width":60,"height":35},{"text":"프로세스는","x":536,"y":455,"width":148,"height":35},{"text":"단순히","x":694,"y":455,"width":86,"height":36},{"text":"개시에","x":796,"y":456,"width":85,"height":36},{"text":"쓰고,","x":895,"y":459,"width":67,"height":34},{"text":"시스템은","x":977,"y":457,"width":123,"height":37},{"text":"편리할","x":1113,"y":457,"width":95,"height":36},{"text":"때,","x":1220,"y":457,"width":40,"height":37},{"text":"비동기식으로","x":1276,"y":457,"width":195,"height":36},{"text":"디","x":1484,"y":459,"width":24,"height":36}]},{"text":"스크에 데이터를 쓸 수 있다. 시용자 프로세스는 매우 빠르게 쓰기 작업을 할 수 있다.","words":[{"text":"스크에","x":291,"y":512,"width":89,"height":35},{"text":"데이터를","x":398,"y":512,"width":121,"height":36},{"text":"쓸","x":532,"y":512,"width":30,"height":35},{"text":"수","x":576,"y":513,"width":29,"height":35},{"text":"있다.","x":621,"y":513,"width":62,"height":35},{"text":"시용자","x":699,"y":514,"width":90,"height":36},{"text":"프로세스는","x":802,"y":515,"width":150,"height":35},{"text":"매우","x":967,"y":516,"width":60,"height":36},{"text":"빠르게","x":1042,"y":517,"width":92,"height":35},{"text":"쓰기","x":1152,"y":516,"width":61,"height":36},{"text":"작업을","x":1233,"y":517,"width":99,"height":34},{"text":"할","x":1348,"y":517,"width":34,"height":35},{"text":"수","x":1396,"y":518,"width":33,"height":34},{"text":"있다.","x":1445,"y":517,"width":66,"height":37}]},{"text":"디스크 파일로부터 데이터가 읽혀질 때, 블록 입출력 시스템은 약간의 미리 읽기 작업을","words":[{"text":"디스크","x":292,"y":571,"width":91,"height":34},{"text":"파일로부터","x":395,"y":571,"width":147,"height":36},{"text":"데이터가","x":559,"y":571,"width":117,"height":37},{"text":"읽혀질","x":689,"y":572,"width":85,"height":36},{"text":"때,","x":788,"y":574,"width":36,"height":36},{"text":"블록","x":837,"y":574,"width":59,"height":34},{"text":"입출력","x":910,"y":574,"width":85,"height":36},{"text":"시스템은","x":1013,"y":576,"width":125,"height":35},{"text":"약간의","x":1151,"y":575,"width":94,"height":36},{"text":"미리","x":1264,"y":576,"width":59,"height":35},{"text":"읽기","x":1343,"y":576,"width":59,"height":36},{"text":"작업을","x":1419,"y":576,"width":93,"height":36}]},{"text":"수행한다. 따라서 쓰기 작업은 읽기 작업보다 훨씬 비동기식에 적합한 작업이다. 따라서","words":[{"text":"수행한다.","x":289,"y":630,"width":131,"height":35},{"text":"따라서","x":436,"y":630,"width":86,"height":36},{"text":"쓰기","x":538,"y":631,"width":54,"height":36},{"text":"작업은","x":609,"y":631,"width":87,"height":36},{"text":"읽기","x":710,"y":631,"width":53,"height":36},{"text":"작업보다","x":779,"y":632,"width":119,"height":36},{"text":"훨씬","x":911,"y":633,"width":59,"height":35},{"text":"비동기식에","x":985,"y":633,"width":152,"height":37},{"text":"적합한","x":1155,"y":634,"width":97,"height":35},{"text":"작업이다.","x":1264,"y":634,"width":140,"height":36},{"text":"따라서","x":1420,"y":635,"width":89,"height":36}]},{"text":"대규모 전송의 경우 파일 시스템을 통한 디스크 출력이 직관과 달리 종종 입력 보다 더","words":[{"text":"대규모","x":290,"y":688,"width":92,"height":35},{"text":"전송의","x":397,"y":689,"width":88,"height":36},{"text":"경우","x":503,"y":690,"width":58,"height":36},{"text":"파일","x":573,"y":690,"width":57,"height":36},{"text":"시스템을","x":646,"y":690,"width":117,"height":35},{"text":"통한","x":775,"y":691,"width":60,"height":35},{"text":"디스크","x":849,"y":691,"width":89,"height":36},{"text":"출력이","x":950,"y":692,"width":89,"height":36},{"text":"직관과","x":1058,"y":693,"width":94,"height":35},{"text":"달리","x":1166,"y":693,"width":61,"height":35},{"text":"종종","x":1245,"y":695,"width":67,"height":33},{"text":"입력","x":1328,"y":694,"width":59,"height":34},{"text":"보다","x":1406,"y":694,"width":64,"height":34},{"text":"더","x":1484,"y":695,"width":24,"height":35}]},{"text":"빠르다. 사용 기능한 버퍼링 및 개성 용량과 관계없이, 대규모 연속 I/O는 용량을 초과","words":[{"text":"빠르다.","x":289,"y":747,"width":99,"height":35},{"text":"사용","x":404,"y":748,"width":62,"height":35},{"text":"기능한","x":479,"y":749,"width":91,"height":35},{"text":"버퍼링","x":582,"y":749,"width":83,"height":36},{"text":"및","x":682,"y":749,"width":26,"height":35},{"text":"개성","x":724,"y":749,"width":54,"height":36},{"text":"용량과","x":794,"y":749,"width":90,"height":37},{"text":"관계없이,","x":896,"y":751,"width":129,"height":36},{"text":"대규모","x":1041,"y":752,"width":94,"height":34},{"text":"연속","x":1151,"y":752,"width":63,"height":35},{"text":"I/O는","x":1227,"y":754,"width":100,"height":33},{"text":"용량을","x":1339,"y":752,"width":100,"height":35},{"text":"초과","x":1451,"y":754,"width":62,"height":35}]},{"text":"하여 장치 성능에 병목 현상을 일으킬 수 있다. 큰 동영상 파일을 HDD에 쓰는 것을 고","words":[{"text":"하여","x":289,"y":806,"width":58,"height":35},{"text":"장치","x":363,"y":806,"width":58,"height":35},{"text":"성능에","x":438,"y":807,"width":88,"height":35},{"text":"병목","x":541,"y":808,"width":59,"height":35},{"text":"현상을","x":612,"y":808,"width":88,"height":35},{"text":"일으킬","x":713,"y":808,"width":84,"height":35},{"text":"수","x":811,"y":808,"width":30,"height":35},{"text":"있다.","x":855,"y":809,"width":64,"height":35},{"text":"큰","x":933,"y":812,"width":31,"height":31},{"text":"동영상","x":976,"y":810,"width":95,"height":35},{"text":"파일을","x":1083,"y":810,"width":96,"height":35},{"text":"HDD에","x":1191,"y":811,"width":121,"height":35},{"text":"쓰는","x":1329,"y":813,"width":66,"height":32},{"text":"것을","x":1409,"y":811,"width":62,"height":35},{"text":"고","x":1483,"y":817,"width":29,"height":25}]},{"text":"려하자. 파일이 페이지 개시(또는 프로세스가 시용 기능한 페이지 개시의 일부)보다 큰","words":[{"text":"려하자.","x":290,"y":864,"width":98,"height":36},{"text":"파일이","x":404,"y":865,"width":88,"height":35},{"text":"페이지","x":510,"y":866,"width":86,"height":36},{"text":"개시(또는","x":614,"y":867,"width":128,"height":37},{"text":"프로세스가","x":755,"y":867,"width":150,"height":35},{"text":"시용","x":918,"y":868,"width":61,"height":36},{"text":"기능한","x":994,"y":869,"width":94,"height":35},{"text":"페이지","x":1102,"y":869,"width":92,"height":35},{"text":"개시의","x":1215,"y":869,"width":94,"height":35},{"text":"일부)보다","x":1329,"y":870,"width":140,"height":37},{"text":"큰","x":1482,"y":874,"width":30,"height":31}]},{"text":"경우 페이지 개시가 채워지고 모든 I/O가 드라이브 속도로 발생한다. 현재 HDD는 쓰","words":[{"text":"경우","x":291,"y":924,"width":60,"height":35},{"text":"페이지","x":364,"y":924,"width":87,"height":35},{"text":"개시가","x":469,"y":925,"width":90,"height":35},{"text":"채워지고","x":572,"y":925,"width":116,"height":35},{"text":"모든","x":700,"y":927,"width":60,"height":31},{"text":"I/O가","x":771,"y":926,"width":91,"height":34},{"text":"드라이브","x":873,"y":927,"width":123,"height":35},{"text":"속도로","x":1008,"y":928,"width":95,"height":34},{"text":"발생한다.","x":1117,"y":928,"width":137,"height":34},{"text":"현재","x":1272,"y":928,"width":61,"height":35},{"text":"HDD는","x":1349,"y":931,"width":122,"height":31},{"text":"쓰","x":1482,"y":933,"width":30,"height":25}]},{"text":"기보다 빠르게 읽으므로 이 경우 성능은 작은 I/O 경우의 성능과 반대가 된다.","words":[{"text":"기보다","x":290,"y":982,"width":92,"height":35},{"text":"빠르게","x":393,"y":983,"width":88,"height":34},{"text":"읽으므로","x":497,"y":983,"width":118,"height":35},{"text":"이","x":626,"y":983,"width":25,"height":35},{"text":"경우","x":666,"y":984,"width":57,"heigh