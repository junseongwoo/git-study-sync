740,"width":105,"height":32},{"text":"가리키지","x":1393,"y":1740,"width":118,"height":35}]},{"text":"않을수 있다. 어떤 변경은 직접 디스크에 반영되지만, 다른 변경은 개시 될 수 있다. 만","words":[{"text":"않을수","x":290,"y":1797,"width":104,"height":35},{"text":"있다.","x":408,"y":1797,"width":63,"height":35},{"text":"어떤","x":487,"y":1798,"width":56,"height":34},{"text":"변경은","x":558,"y":1798,"width":88,"height":35},{"text":"직접","x":659,"y":1797,"width":55,"height":35},{"text":"디스크에","x":731,"y":1798,"width":118,"height":35},{"text":"반영되지만,","x":865,"y":1798,"width":163,"height":35},{"text":"다른","x":1043,"y":1798,"width":64,"height":34},{"text":"변경은","x":1122,"y":1797,"width":97,"height":35},{"text":"개시","x":1233,"y":1797,"width":60,"height":35},{"text":"될","x":1311,"y":1797,"width":30,"height":34},{"text":"수","x":1356,"y":1798,"width":33,"height":34},{"text":"있다.","x":1405,"y":1798,"width":67,"height":34},{"text":"만","x":1487,"y":1798,"width":29,"height":34}]},{"text":"일 개시된 변경이 디스크에 반영되기 전에 크래시가 발생하면 더 심각한 오염 상대가 될","words":[{"text":"일","x":292,"y":1856,"width":26,"height":34},{"text":"개시된","x":333,"y":1856,"width":89,"height":35},{"text":"변경이","x":436,"y":1857,"width":83,"height":34},{"text":"디스크에","x":535,"y":1856,"width":115,"height":36},{"text":"반영되기","x":664,"y":1856,"width":116,"height":35},{"text":"전에","x":798,"y":1857,"width":56,"height":34},{"text":"크래시가","x":869,"y":1856,"width":125,"height":35},{"text":"발생하면","x":1006,"y":1856,"width":125,"height":35},{"text":"더","x":1147,"y":1856,"width":26,"height":35},{"text":"심각한","x":1191,"y":1856,"width":99,"height":34},{"text":"오염","x":1301,"y":1856,"width":62,"height":33},{"text":"상대가","x":1379,"y":1856,"width":97,"height":35},{"text":"될","x":1487,"y":1857,"width":26,"height":33}]},{"text":"수 있다.","words":[{"text":"수","x":289,"y":1915,"width":32,"height":35},{"text":"있다.","x":333,"y":1915,"width":65,"height":35}]},{"text":"크래시뿐만 아니라 파일 시스템 구현의 버그, 디스크 컨트롤러, 및 사용자 우우 또한","words":[{"text":"크래시뿐만","x":347,"y":1974,"width":151,"height":34},{"text":"아니라","x"