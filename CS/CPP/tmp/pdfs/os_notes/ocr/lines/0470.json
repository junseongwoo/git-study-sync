":982,"width":33,"height":34}]},{"text":"구할 수 있다.","words":[{"text":"구할","x":348,"y":1040,"width":66,"height":36},{"text":"수","x":424,"y":1040,"width":33,"height":35},{"text":"있다.","x":471,"y":1040,"width":68,"height":35}]},{"text":"• 저장장치는 하나 이상의 공간으로 파티션된다. 각 파티션은 볼류을 보유하거나 다중","words":[{"text":"•","x":308,"y":1121,"width":14,"height":14},{"text":"저장장치는","x":349,"y":1110,"width":161,"height":36},{"text":"하나","x":522,"y":1110,"width":64,"height":36},{"text":"이상의","x":598,"y":1111,"width":88,"height":36},{"text":"공간으로","x":700,"y":1111,"width":124,"height":35},{"text":"파티션된다.","x":835,"y":1111,"width":160,"height":36},{"text":"각","x":1010,"y":1112,"width":31,"height":34},{"text":"파티션은","x":1051,"y":1112,"width":124,"height":35},{"text":"볼류을","x":1184,"y":1112,"width":96,"height":35},{"text":"보유하거나","x":1291,"y":1111,"width":163,"height":36},{"text":"다중","x":1466,"y":1110,"width":64,"height":35}]},{"text":"장치 볼륨의 일부일 수 있다. 파일 시스템은 볼륨 안에 생성된다.","words":[{"text":"장치","x":348,"y":1170,"width":60,"height":35},{"text":"볼륨의","x":424,"y":1170,"width":93,"height":35},{"text":"일부일","x":534,"y":1170,"width":90,"height":35},{"text":"수","x":637,"y":1171,"width":31,"height":35},{"text":"있다.","x":681,"y":1171,"width":66,"height":35},{"text":"파일","x":760,"y":1171,"width":60,"height":35},{"text":"시스템은","x":833,"y":1171,"width":124,"height":35},{"text":"볼륨","x":966,"y":1171,"width":63,"height":34},{"text":"안에","x":1040,"y":1171,"width":58,"height":36},{"text":"생성된다.","x":1112,"y":1171,"width":130,"height":36}]},{"text":"• 운영체제는 저장장치의 블록을 관리한다. 새로운 장치는 일반적으로 사전 포맷되어","words":[{"text":"•","x":307,"y":1250,"width":14,"height":15},{"text":"운영체제는","x":346,"y":1239,"width":163,"height":36},{"text":"저장장치의","x":523,"y":1239,"width":153,"height":36},{"text":"블록을","x":691,"y":1240,"width":94,"height":35},{"text":"관리한다.","x":797,"y":1240,"width":130,"height":36},{"text":"새로운","x":942,"y":1240,"width":93,"height":36},{"text":"장치는","x":1048,"y":1241,"width":92,"height":35},{"text":"일반적으로","x":115