ext":"read-ahead","x":1362,"y":2219,"width":175,"height":33}]},{"text":"가 필요한데, 이는 트랙 개시에서 메인 메모리까지 소용량 전송을 많이 할 경우의 높은","words":[{"text":"가","x":315,"y":2280,"width":32,"height":36},{"text":"필요한데,","x":361,"y":2278,"width":133,"height":36},{"text":"이는","x":511,"y":2279,"width":61,"height":35},{"text":"트랙","x":586,"y":2278,"width":58,"height":35},{"text":"개시에서","x":661,"y":2277,"width":117,"height":37},{"text":"메인","x":795,"y":2278,"width":58,"height":37},{"text":"메모리까지","x":869,"y":2279,"width":148,"height":37},{"text":"소용량","x":1033,"y":2280,"width":95,"height":36},{"text":"전송을","x":1143,"y":2280,"width":94,"height":36},{"text":"많이","x":1250,"y":2281,"width":59,"height":35},{"text":"할","x":1326,"y":2281,"width":32,"height":35},{"text":"경우의","x":1373,"y":2278,"width":87,"height":38},{"text":"높은","x":1477,"y":2277,"width":61,"height":36}]},{"text":"지연율과 오버헤드 때문이다.","words":[{"text":"지연율과","x":315,"y":2337,"width":127,"height":39},{"text":"오버헤드","x":452,"y":2338,"width":127,"height":36},{"text":"때문이다.","x":590,"y":2338,"width":128,"height":37}]},{"text":"페이지 개시, 파일 시스템 그리고 장치 드라이버는 몇 가지 흥미 있는 상호 작용을","words":[{"text":"페이지","x":374,"y":2399,"width":90,"height":36},{"text":"개시,","x":483,"y":2398,"width":69,"height":37},{"text":"파일","x":568,"y":2399,"width":59,"height":35},{"text":"시스템","x":644,"y":2399,"width":88,"height":35},{"text":"그리고","x":748,"y":2399,"width":90,"height":35},{"text":"장치","x":851,"y":2400,"width":57,"height":35},{"text":"드라이버는","x":925,"y":2401,"width":155,"height":36},{"text":"몇","x":1094,"y":2401,"width":29,"height":36},{"text":"가지","x":1138,"y":2401,"width":60,"height":36},{"text":"흥미","x":1214,"y":2401,"width":61,"height":36},{"text":"있는","x":1295,"y":2401,"width":62,"height":36},{"text":"상호","x":1369,"y":2401,"width":63,"height":36},{"text":"작용을","x":1446,"y":2397,"width":93,"height":38}]}]}