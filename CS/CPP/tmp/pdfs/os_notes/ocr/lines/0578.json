:358,"y":1919,"width":89,"height":36},{"text":"때문이다.","x":464,"y":1919,"width":130,"height":36},{"text":"대신에","x":608,"y":1918,"width":88,"height":36},{"text":"순자","x":710,"y":1918,"width":62,"height":35},{"text":"접근은","x":784,"y":1918,"width":91,"height":35},{"text":"free-behind","x":885,"y":1922,"width":181,"height":29},{"text":"그리고","x":1078,"y":1920,"width":94,"height":36},{"text":"read-ahead로","x":1182,"y":1923,"width":212,"height":29},{"text":"알려진","x":1406,"y":1919,"width":91,"height":36},{"text":"기","x":1511,"y":1920,"width":26,"height":35}]},{"text":"술로 최적화된다. Free-behind는 다음 페이지가 요청되자마자 버퍼에서 페이지를 제거","words":[{"text":"술로","x":313,"y":1981,"width":64,"height":34},{"text":"최적화된다.","x":389,"y":1979,"width":163,"height":36},{"text":"Free-behind는","x":565,"y":1980,"width":227,"height":32},{"text":"다음","x":803,"y":1978,"width":61,"height":36},{"text":"페이지가","x":875,"y":1979,"width":123,"height":37},{"text":"요청되자마자","x":1008,"y":1980,"width":188,"height":36},{"text":"버퍼에서","x":1208,"y":1980,"width":120,"height":36},{"text":"페이지를","x":1344,"y":1980,"width":124,"height":36},{"text":"제거","x":1479,"y":1979,"width":57,"height":36}]},{"text":"하는 것을 말하며, read-ahead는 요구된 페이지와 몇 개의 뒤이은 페이지를 읽어 개성","words":[{"text":"하는","x":314,"y":2040,"width":64,"height":36},{"text":"것을","x":392,"y":2039,"width":62,"height":36},{"text":"말하며,","x":466,"y":2039,"width":101,"height":36},{"text":"read-ahead는","x":580,"y":2040,"width":210,"height":32},{"text":"요구된","x":801,"y":2039,"width":91,"height":36},{"text":"페이지와","x":907,"y":2040,"width":123,"height":36},{"text":"몇","x":1042,"y":2040,"width":29,"height":35},{"text":"개의","x":1085,"y":2040,"width":59,"height":36},{"text":"뒤이은","x":1160,"y":2040,"width":94,"height":36},{"text":"페이지를","x":1267,"y":2040,"width":125,"height":36},{"text":"읽어","x":1406,"y":2040,"width":56,"height":35},{"text":"개성","x":1479,"y":2039,"width":57,"height":35}]},{"text":"하는 것을 의미한다. 이러한 페이지들은 현재 페이지가 수행된 후에 요청될 기능성이 크","words":[{"text":"하는","x":314,"y":2100,"width"