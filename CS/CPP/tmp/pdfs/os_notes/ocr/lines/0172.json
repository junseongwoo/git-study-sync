{"page":172,"width":1811,"height":2839,"text_angle":0,"lines":[{"text":"226","words":[{"text":"226","x":187,"y":157,"width":65,"height":31}]},{"text":"5.3","words":[{"text":"5.3","x":191,"y":1308,"width":99,"height":39}]},{"text":"Chapter 5 CPCJ 스케줍렁|","words":[{"text":"Chapter","x":334,"y":159,"width":134,"height":31},{"text":"5","x":484,"y":160,"width":24,"height":24},{"text":"CPCJ","x":542,"y":161,"width":59,"height":25},{"text":"스케줍렁|","x":611,"y":161,"width":98,"height":28}]},{"text":"경우에는 평균보다는 최솟값 또는 최댓값을 최적회히는 것이 바람직할 수도 있다. 예를","words":[{"text":"경우에는","x":337,"y":297,"width":143,"height":40},{"text":"평균보다는","x":496,"y":298,"width":175,"height":40},{"text":"최솟값","x":686,"y":298,"width":105,"height":40},{"text":"또는","x":805,"y":300,"width":69,"height":37},{"text":"최댓값을","x":890,"y":299,"width":140,"height":39},{"text":"최적회히는","x":1046,"y":300,"width":176,"height":40},{"text":"것이","x":1240,"y":301,"width":65,"height":39},{"text":"바람직할","x":1326,"y":301,"width":145,"height":39},{"text":"수도","x":1486,"y":301,"width":74,"height":39},{"text":"있다.","x":1577,"y":301,"width":76,"height":38},{"text":"예를","x":1671,"y":305,"width":60,"height":41}]},{"text":"들어, 모든 사용자가 좋은 서비스를 얻도록 보정하기 위해, 우리는 최대 응답 시긴을 최","words":[{"text":"들어,","x":335,"y":363,"width":81,"height":40},{"text":"모든","x":432,"y":365,"width":72,"height":36},{"text":"사용자가","x":519,"y":363,"width":141,"height":41},{"text":"좋은","x":673,"y":365,"width":71,"height":39},{"text":"서비스를","x":759,"y":364,"width":139,"height":40},{"text":"얻도록","x":914,"y":364,"width":102,"height":40},{"text":"보정하기","x":1032,"y":364,"width":135,"height":41},{"text":"위해,","x":1188,"y":365,"width":78,"height":40},{"text":"우리는","x":1283,"y":365,"width":111,"height":40},{"text":"최대","x":1410,"y":365,"width":67,"height":39},{"text":"응답","x":1496,"y":364,"width":74,"height":40},{"text":"시긴을","x":1587,"y":364,"width":101,"height":40},{"text":"최","x":1702,"y":371,"width":25,"height":39}]},{"text":"소화하려고 할 수도 있다.","words":[{"text":"소화하려고","x":336,"y":429,"width":179,"height":39},{"text":"할","x":528,"y":429,"width":36,"height":39},{"text":"수도","x":575,"y":430,"width":70,"height":39},{"text":"있다.","x":660,"y":430,"width":74,"height":39}]},{"text":"연구자들은 대화식 시스템(PC 데스크톱 혹은 랩톱 시스템 같은)의 경우에는 평균","words":[{"text":"연구자들은","x":406,"y":494,"width":177,"height":40},{"text":"대화식","x":600,"y":495,"width":98,"height":40},{"text":"시스템(PC","x":721,"y":496,"width":167,"height":42},{"text":"데스크톱","x":908,"y":496,"width":139,"height":40},{"text":"혹은","x":1064,"y":496,"width":70,"height":39},{"text":"랩톱","x":1153,"y":495,"width":68,"height":38},{"text":"시스템","x":1240,"y":494,"width":105,"height":39},{"text":"같은)의","x":1368,"y":494,"width":118,"height":42},{"text":"경우에는","x":1510,"y":494,"width":141,"height":40},{"text":"평균","x":1670,"y":495,"width":60,"height":42}]},{"text":"응답 시간을 최소화하기보디는 응답 시간의 편치(variance)를 최소화하는 것이 중요하","words":[{"text":"응답","x":336,"y":558,"width":72,"height":39},{"text":"시간을","x":424,"y":559,"width":107,"height":40},{"text":"최소화하기보디는","x":547,"y":560,"width":278,"height":40},{"text":"응답","x":839,"y":561,"width":70,"height":40},{"text":"시간의","x":925,"y":561,"width":99,"height":41},{"text":"편치(variance)를","x":1045,"y":560,"width":287,"height":43},{"text":"최소화하는","x":1350,"y":559,"width":181,"height":40},{"text":"것이","x":1548,"y":559,"width":66,"height":40},{"text":"중요하","x":1633,"y":561,"width":97,"height":43}]},{"text":"다고 제시하고 있다. 합리적이고 예측 기능한 응답 시간을 가진 시스템이 평균 속도는","words":[{"text":"다고","x":337,"y":624,"width":71,"height":39},{"text":"제시하고","x":427,"y":625,"width":140,"height":39},{"text":"있다.","x":587,"y":626,"width":74,"height":39},{"text":"합리적이고","x":680,"y":626,"width":173,"height":40},{"text":"예측","x":872,"y":627,"width":68,"height":40},{"text":"기능한","x":957,"y":627,"width":105,"height":40},{"text":"응답","x":1077,"y":625,"width":71,"height":41},{"text":"시간을","x":1165,"y":624,"width":107,"height":41},{"text":"가진","x":1290,"y":624,"width":70,"height":40},{"text":"시스템이","x":1381,"y":624,"width":141,"height":40},{"text":"평균","x":1547,"y":625,"width":69,"height":39},{"text":"속도는","x":1633,"y":625,"width":97,"height":44}]},{"text":"빠르지만 편차가 큰 시스템보다 더 비람직한 것으로 생각될 수 있다. 그러나 편차를 최","words":[{"text":"빠르지만","x":337,"y":689,"width":144,"height":41},{"text":"편차가","x":497,"y":691,"width":105,"height":40},{"text":"큰","x":616,"y":695,"width":35,"height":34},{"text":"시스템보다","x":666,"y":692,"width":173,"height":40},{"text":"더","x":856,"y":692,"width":28,"height":39},{"text":"비람직한","x":904,"y":692,"width":140,"height":40},{"text":"것으로","x":1060,"y":691,"width":103,"height":40},{"text":"생각될","x":1180,"y":690,"width":105,"height":40},{"text":"수","x":1302,"y":691,"width":39,"height":39},{"text":"있다.","x":1359,"y":691,"width":78,"height":39},{"text":"그러나","x":1456,"y":691,"width":111,"height":39},{"text":"편차를","x":1584,"y":690,"width":101,"height":39},{"text":"최","x":1700,"y":696,"width":26,"height":40}]},{"text":"소화하는 CPU 스게줄링 알고리즘에 대한 연구는 거의 없다.","words":[{"text":"소화하는","x":336,"y":755,"width":144,"height":40},{"text":"CPU","x":492,"y":760,"width":83,"height":31},{"text":"스게줄링","x":589,"y":757,"width":134,"height":40},{"text":"알고리즘에","x":741,"y":757,"width":169,"height":40},{"text":"대한","x":927,"y":758,"width":69,"height":38},{"text":"연구는","x":1010,"y":757,"width":103,"height":40},{"text":"거의","x":1127,"y":757,"width":65,"height":39},{"text":"없다.","x":1211,"y":756,"width":77,"height":39}]},{"text":"우리는 다양한 CPU 스케줄링 알고리즘을 이후의 절에서 논의하면서, 이들의 작동","words":[{"text":"우리는","x":403,"y":822,"width":108,"height":39},{"text":"다양한","x":526,"y":822,"width":105,"height":40},{"text":"CPU","x":644,"y":826,"width":82,"height":32},{"text":"스케줄링","x":743,"y":822,"width":133,"height":40},{"text":"알고리즘을","x":897,"y":822,"width":175,"height":39},{"text":"이후의","x":1088,"y":822,"width":101,"height":40},{"text":"절에서","x":1211,"y":822,"width":102,"height":40},{"text":"논의하면서,","x":1333,"y":823,"width":193,"height":40},{"text":"이들의","x":1546,"y":823,"width":102,"height":40},{"text":"작동","x":1666,"y":824,"width":62,"height":41}]},{"text":"을 예를 들어 설명하고자 한다 정확하게 설명하려면, 수백 개의 CPU 버스트와 I/O 비","words":[{"text":"을","x":336,"y":886,"width":36,"height":38},{"text":"예를","x":387,"y":887,"width":70,"height":39},{"text":"들어","x":470,"y":888,"width":66,"height":39},{"text":"설명하고자","x":555,"y":888,"width":171,"height":39},{"text":"한다","x":739,"y":888,"width":76,"height":38},{"text":"정확하게","x":832,"y":887,"width":135,"height":39},{"text":"설명하려면,","x":984,"y":888,"width":184,"height":40},{"text":"수백","x":1184,"y":888,"width":68,"height":39},{"text":"개의","x":1271,"y":888,"width":67,"height":39},{"text":"CPU","x":1356,"y":892,"width":88,"height":31},{"text":"버스트와","x":1461,"y":888,"width":146,"height":40},{"text":"I/O","x":1619,"y":891,"width":66,"height":36},{"text":"비","x":1700,"y":893,"width":25,"height":39}]},{"text":"스트들의 열을 갖는 많은 수의 프로세스들을 포함해야 한다. 그렇지만 설명을 간단하게","words":[{"text":"스트들의","x":336,"y":952,"width":139,"height":40},{"text":"열을","x":496,"y":953,"width":68,"height":38},{"text":"갖는","x":578,"y":953,"width":69,"height":39},{"text":"많은","x":661,"y":953,"width":68,"height":39},{"text":"수의","x":742,"y":952,"width":66,"height":39},{"text":"프로세스들을","x":827,"y":952,"width":210,"height":40},{"text":"포함해야","x":1051,"y":953,"width":144,"height":40},{"text":"한다.","x":1209,"y":954,"width":80,"height":38},{"text":"그렇지만","x":1308,"y":954,"width":147,"height":39},{"text":"설명을","x":1472,"y":955,"width":110,"height":39},{"text":"간단하게","x":1597,"y":954,"width":128,"height":43}]},{"text":"하기 위해, 우리의 예에서는 프로세스당 단지 하나의 CPU 버스트(밀리초 단위로)만을","words":[{"text":"하기","x":336,"y":1017,"width":66,"height":41},{"text":"위해,","x":424,"y":1018,"width":76,"height":40},{"text":"우리의","x":518,"y":1018,"width":100,"height":39},{"text":"예에서는","x":638,"y":1017,"width":137,"height":40},{"text":"프로세스당","x":790,"y":1017,"width":175,"height":40},{"text":"단지","x":980,"y":1018,"width":66,"height":40},{"text":"하나의","x":1067,"y":1019,"width":103,"height":40},{"text":"CPU","x":1190,"y":1023,"width":86,"height":32},{"text":"버스트(밀리초","x":1296,"y":1020,"width":232,"height":42},{"text":"단위로)만을","x":1546,"y":1020,"width":182,"height":42}]},{"text":"고려하기로 한다. 여기서 비교하려는 기준은 평균대기 시간이다. 더 자세한 평가 기법은","words":[{"text":"고려하기로","x":336,"y":1084,"width":175,"height":40},{"text":"한다.","x":524,"y":1084,"width":76,"height":39},{"text":"여기서","x":619,"y":1084,"width":97,"height":39},{"text":"비교하려는","x":736,"y":1083,"width":172,"height":40},{"text":"기준은","x":923,"y":1084,"width":105,"height":40},{"text":"평균대기","x":1043,"y":1085,"width":136,"height":40},{"text":"시간이다.","x":1200,"y":1086,"width":151,"height":40},{"text":"더","x":1370,"y":1086,"width":30,"height":40},{"text":"자세한","x":1420,"y":1086,"width":112,"height":41},{"text":"평가","x":1547,"y":1088,"width":71,"height":39},{"text":"기법은","x":1633,"y":1086,"width":94,"height":40}]},{"text":"5.8절에서 논의한다.","words":[{"text":"5.8절에서","x":334,"y":1150,"width":152,"height":41},{"text":"논의한다.","x":502,"y":1150,"width":146,"height":40}]},{"text":"스케줄링 알고리즘 scheduling Algorithms","words":[{"text":"스케줄링","x":335,"y":1308,"width":160,"height":47},{"text":"알고리즘","x":513,"y":1309,"width":162,"height":45},{"text":"scheduling","x":705,"y":1320,"width":213,"height":34},{"text":"Algorithms","x":929,"y":1320,"width":213,"height":35}]},{"text":"CPU 스케줄링은 준비 큐에 있는 어느 프로세스에 CPU 코어를 할당할 것인지를 결정","words":[{"text":"CPU","x":335,"y":1415,"width":85,"height":33},{"text":"스케줄링은","x":435,"y":1414,"width":176,"height":39},{"text":"준비","x":624,"y":1414,"width":65,"height":39},{"text":"큐에","x":707,"y":1413,"width":66,"height":40},{"text":"있는","x":794,"y":1413,"width":68,"height":40},{"text":"어느","x":878,"y":1412,"width":68,"height":40},{"text":"프로세스에","x":961,"y":1413,"width":175,"height":39},{"text":"CPU","x":1154,"y":1416,"width":86,"height":32},{"text":"코어를","x":1257,"y":1413,"width":110,"height":40},{"text":"할당할","x":1382,"y":1414,"width":111,"height":40},{"text":"것인지를","x":1510,"y":1414,"width":142,"height":40},{"text":"결정","x":1668,"y":1413,"width":57,"height":41}]},{"text