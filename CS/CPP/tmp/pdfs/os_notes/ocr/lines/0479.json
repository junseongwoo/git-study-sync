비지 비트를 소거한다.","words":[{"text":"기","x":375,"y":852,"width":24,"height":36},{"text":"위해","x":414,"y":853,"width":57,"height":35},{"text":"비지","x":485,"y":853,"width":53,"height":35},{"text":"비트를","x":553,"y":854,"width":87,"height":35},{"text":"소거한다.","x":649,"y":853,"width":124,"height":36}]},{"text":"이 루프는 바이트마다 반복된다.","words":[{"text":"이","x":299,"y":972,"width":26,"height":35},{"text":"루프는","x":338,"y":973,"width":91,"height":33},{"text":"바이트마다","x":439,"y":971,"width":147,"height":36},{"text":"반복된다.","x":596,"y":971,"width":123,"height":35}]},{"text":"위의 단계 1에서 호스트는 바쁜 대기(busy-waitmg), 즉 폴링(p이lⅲg)을 하게 된","words":[{"text":"위의","x":355,"y":1030,"width":55,"height":34},{"text":"단계","x":426,"y":1030,"width":57,"height":36},{"text":"1에서","x":499,"y":1031,"width":70,"height":35},{"text":"호스트는","x":585,"y":1032,"width":117,"height":32},{"text":"바쁜","x":715,"y":1030,"width":59,"height":35},{"text":"대기(busy-waitmg),","x":788,"y":1030,"width":297,"height":40},{"text":"즉","x":1098,"y":1031,"width":34,"height":33},{"text":"폴링(p이lⅲg)을","x":1145,"y":1028,"width":246,"height":42},{"text":"하게","x":1405,"y":1028,"width":61,"height":35},{"text":"된","x":1483,"y":1030,"width":28,"height":34}]},{"text":"다. 호스트는 이 루프를 계속 돌면서 비지 비트가 소거될 때까지 검사를 반복한다. 이 기","words":[{"text":"다.","x":298,"y":1089,"width":36,"height":36},{"text":"호스트는","x":347,"y":1090,"width":120,"height":33},{"text":"이","x":479,"y":1089,"width":24,"height":35},{"text":"루프를","x":517,"y":1091,"width":88,"height":34},{"text":"계속","x":617,"y":1089,"width":58,"height":34},{"text":"돌면서","x":685,"y":1089,"width":85,"height":35},{"text":"비지","x":787,"y":1089,"width":54,"height":35},{"text":"비트가","x":858,"y":1088,"width":90,"height":35},{"text":"소거될","x":958,"y":1088,"width":92,"height":34},{"text":"때까지","x":1065,"y":1088,"width":91,"height":35},{"text":"검사를","x":1174,"y":1088,"width":99,"height":35},{"text":"반복한다.","x":1286,"y":1086,"width":137,"height":35},{"text":"이","x":1440,"y":1087,"width":26,"height":35},{"text":"기","x":1