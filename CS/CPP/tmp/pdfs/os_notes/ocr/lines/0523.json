:35}]},{"text":"가 system•log 파일에 대한 배타적 락을 획득했다고 가정해보자. 만약 다른 프로세스","words":[{"text":"가","x":289,"y":1699,"width":32,"height":36},{"text":"system•log","x":335,"y":1706,"width":195,"height":32},{"text":"파일에","x":545,"y":1701,"width":93,"height":35},{"text":"대한","x":655,"y":1701,"width":63,"height":35},{"text":"배타적","x":731,"y":1701,"width":88,"height":35},{"text":"락을","x":835,"y":1700,"width":62,"height":35},{"text":"획득했다고","x":910,"y":1699,"width":156,"height":37},{"text":"가정해보자.","x":1079,"y":1700,"width":165,"height":36},{"text":"만약","x":1259,"y":1701,"width":66,"height":35},{"text":"다른","x":1337,"y":1701,"width":64,"height":35},{"text":"프로세스","x":1413,"y":1701,"width":129,"height":35}]},{"text":"-예를 들어 ⅵ 같은 텍스트 에디터-가 system•log을 열려고 한다면, 운영체제는 배","words":[{"text":"-예를","x":288,"y":1758,"width":99,"height":36},{"text":"들어","x":400,"y":1759,"width":61,"height":35},{"text":"ⅵ","x":477,"y":1763,"width":33,"height":27},{"text":"같은","x":525,"y":1759,"width":64,"height":35},{"text":"텍스트","x":603,"y":1760,"width":93,"height":34},{"text":"에디터-가","x":711,"y":1759,"width":154,"height":37},{"text":"system•log을","x":878,"y":1759,"width":220,"height":38},{"text":"열려고","x":1112,"y":1760,"width":93,"height":34},{"text":"한다면,","x":1218,"y":1760,"width":104,"height":35},{"text":"운영체제는","x":1336,"y":1760,"width":162,"height":35},{"text":"배","x":1512,"y":1761,"width":28,"height":35}]},{"text":"타적 락이 해제될 때가지 접근을 막을 것이다. 상대적으로 락이 권고적(advisory)이라","words":[{"text":"타적","x":289,"y":1818,"width":61,"height":36},{"text":"락이","x":369,"y":1817,"width":61,"height":36},{"text":"해제될","x":449,"y":1818,"width":94,"height":35},{"text":"때가지","x":560,"y":1818,"width":91,"height":37},{"text":"접근을","x":670,"y":1819,"width":93,"height":35},{"text":"막을","x":776,"y":1818,"width":62,"height":36},{"text":"것이다.","x":852,"y":1817,"width":99,"height":37},{"text":"상대적으로","x":965,"y":1818,"width":158,"height":36},{"text":"락이","x":1137,"y":1819,"width":60,"height":35},{"text":"권고적(advisory)이라","x":1216,"y":1818,"width":328,"height":42}]},{"text":"면, 운영체제는 텍스트 에디터가 system•log에 접근하는 것을 막지 않을 것이다. 대신","words":[{"text":"면,","x":289,"y":1877,"width":39,"height":35},{"text":"운영체제는","x":343,"y":1877,"width":165,"height":35},{"text":"텍스트","x":521,"y":1878,"width":95,"height":34},{"text":"에디터가","x":630,"y":1878,"width":125,"height":35},{"text":"system•log에","x":766,"y":1878,"width":212,"height":38},{"text":"접근하는","x":994,"y":1878,"width":125,"height":35},{"text":"것을","x":1132,"y":1878,"width":63,"height":35},{"text":"막지","x":1207,"y":1877,"width":60,"height":35},{"text":"않을","x":1284,"y":1877,"width":63,"height":35},{"text":"것이다.","x":1361,"y":1878,"width":101,"height":35},{"text":"대신","x":1478,"y":1879,"width":64,"height":35}]},{"text":"텍스트 에디터는 파일에 접근하기 전에 락을 획득할 수 있도록 쓰여야 한다. 다시 말해","words":[{"text":"텍스트","x":289,"y":1936,"width":98,"height":35},{"text":"에디터는","x":402,"y":1936,"width":130,"height":35},{"text":"파일에","x":545,"y":1937,"width":93,"height":36},{"text":"접근하기","x":656,"y":1937,"width":119,"height":36},{"text":"전에","x":794,"y":1937,"width":58,"height":35},{"text":"락을","x":869,"y":1937,"width":61,"height":35},{"text":"획득할","x":944,"y":1937,"width":93,"height":35},{"text":"수","x":1049,"y":1937,"width":32,"height":35},{"text":"있도록","x":1096,"y":1937,"width":93,"height":35},{"text":"쓰여야","x":1202,"y":1936,"width":97,"height":35},{"text":"한다.","x":1312,"y":1936,"width":71,"height":35},{"text":"다시","x":1400,"y":1937,"width":60,"height":35},{"text":"말해","x":1478,"y":1938,"width":63,"height":36}]},{"text":"서, 만약 파일 락 체계가 강제적이라면, 운영체제는 락 무결성(locking integnty)를 안","words":[{"text":"서,","x":288,"y":1995,"width":40,"height":37},{"text":"만약","x":343,"y":1996,"width":67,"height":35},{"text":"파일","x":423,"y":1995,"width":63,"height":36},{"text":"락","x":502,"y":1996,"width":32,"height":36},{"text":"체계가","x":547,"y":1996,"width":96,"height":36},{"text":"강제적이라면,","x":655,"y":1996,"width":193,"height":36},{"text":"운영체제는","x":861,"y":1996,"width":157,"height":36},{"text":"락","x":1029,"y":1996,"width":32,"height":35},{"text":"무결성(locking","x":1072,"y":1996,"width":226,"height":40},{"text":"integnty)를","x":1311,"y":1998,"width":187,"height":39},{"text":"안","x":1512,"y":1997,"width":33,"height":34}]},{"text":"전하게 보장해준다. 권고적 락일 경유는, 락이 적절히 획득되고 해제되는 것에 대한 보","words":[{"text":"전하게","x":288,"y":2054,"width":95,"height":37},{"text":"보장해준다.","x":401,"y":2055,"width":170,"height":36},{"text":"권고적","x":589,"y":2056,"width":90,"height":36},{"text":"락일","x":697,"y":2056,"width":60,"height":36},{"text":"경유는,","x":774,"y":2056,"width":98,"height":36},{"text":"락이","x":888,"y":2056,"width":57,"height":35},{"text":"적절히","x":964,"y":2056,"width":88,"height":35},{"text":"획득되고","x":1070,"y":2055,"width":126,"height":36},{"text":"해제되는","x":1210,"y":2054,"width":129,"height":36},{"text":"것에","x":1354,"y":2055,"width":60,"height":35},{"text":"대한","x":1433,"y":2056,"width":65,"height":35},{"text":"보","x":1512,"y":2060,"width":33,"height":26}]},{"text":"장은 소프트웨어 개발자의 몫이다. 일반적인 규칙으로서, Windows 운영체제는 강제적","words":[{"text":"장은","x":285,"y":2114,"width":69,"height":35},{"text":"소프트웨어","x":365,"y":2115,"width":161,"height":36},{"text":"개발자의","x":544,"y":2115,"width":123,"height":36},{"text":"몫이다.","x":681,"y":2116,"width":101,"height":35},{"text":"일반적인","x":798,"y":2115,"width":119,"height":35},{"text":"규칙으로서,","x":929,"y":2115,"width":163,"height":36},{"text":"Windows","x":1104,"y":2117,"width":155,"height":29},{"text":"운영체제는","x":1271,"y":2114,"width":163,"height":35},{"text":"강제적","x":1446,"y":2115,"width":96,"height":36}]},{"text":"락을, UNIX 운영체제는 권고적 락을 채택하고 있다.","words":[{"text":"락을,","x":286,"y":2173,"width":74,"height":37},{"text":"UNIX","x":374,"y":2178,"width":99,"height":28},{"text":"운영체제는","x":484,"y":2174,"width":163,"height":36},{"text":"권고적","x":658,"y":2175,"width":89,"height":34},{"text":"락을","x":763,"y":2174,"width":60,"height":35},{"text":"채택하고","x":834,"y":2174,"width":122,"height":36},{"text":"있다.","x":970,"y":2175,"width":66,"height":35}]},{"text":"파일 락의 사용-은 프로세스 동기화처럼 특별한 주의가 필요하다. 예를 들어, 강제적","words":[{"text":"파일","x":347,"y":2234,"width":66,"height":35},{"text":"락의","x":430,"y":2234,"width":60,"height":36},{"text":"사용-은","x":507,"y":2234,"width":98,"height":35},{"text":"프로세스","x":617,"y":2234,"width":126,"height":35},{"text":"동기화처럼","x":754,"y":2233,"width":150,"height":36},{"text":"특별한","x":919,"y":2234,"width":95,"height":35},{"text":"주의가","x":1024,"y":2233,"width":96,"height":36},{"text":"필요하다.","x":1133,"y":2233,"width":132,"height":36},{"text":"예를","x":1282,"y":2233,"width":63,"height":35},{"text":"들어,","x":1358,"y":2233,"width":73,"height":35},{"text":"강제적","x":1446,"y":2233,"width":96,"height":35}]},{"text":"락을 시용하는 시스템에서 개발하고 있는 프로그래머는 파일에 접근할 때만 배타적 락","words":[{"text":"락을","x":285,"y":2293,"width":67,"height":35},{"text":"시용하는","x":367,"y":2293,"width":134,"height":36},{"text":"시스템에서","x":515,"y":2293,"width":155,"height":35},{"text":"개발하고","x":690,"y":2293,"width":122,"height":35},{"text":"있는","x":827,"y":2293,"width":59,"height":34},{"text":"프로그래머는","x":899,"y":2293,"width":187,"height":36},{"text":"파일에","x":1100,"y":2293,"width":91,"height":35},{"text":"접근할","x":1209,"y":2292,"width":97,"height":35},{"text":"때만","x":1320,"y":2292,"width":64,"height":35},{"text":"배타적","x":1400,"y":2292,"width":93,"height":36},{"text":"락","x":1513,"y":2293,"width":33,"height":35}]},{"text":"을 가지도록 해야만 한다. 그렇지 않다면, 다른 프로세스가 그 파일에 접근하는 것이 허","words":[{"text":"을","x":282,"y":2352,"width":36,"height":35},{"text":"가지도록","x":332,"y":2353,"width":134,"height":36},{"text":"해야만","x":480,"y":2353,"width":97,"height":36},{"text":"한다.","x":589,"y":2352,"width":70,"height":36},{"text":"그렇지","x":674,"y":2352,"width":90,"height":36},{"text":"않다면,","x":781,"y":2352,"width":97,"height":35},{"text":"다른","x":893,"y":2352,"width":61,"height":34},{"text":"프로세스가","x":966,"y":2352,"width":157,"height":36},{"text":"그","x":1136,"y":2357,"width":31,"height":24},{"text":"파일에","x":1180,"y":2352,"width":93,"height":35},{"text":"접근하는","x":1291,"y":2352,"width":129,"height":36},{"text":"것이","x":1434,"y":2353,"width":60,"height":36},{"text":"허","x":1513,"y":2353,"width":28,"height":36}]}]}