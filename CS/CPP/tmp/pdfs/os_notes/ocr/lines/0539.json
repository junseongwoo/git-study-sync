{"page":539,"width":1736,"height":2660,"text_angle":0,"lines":[{"text":"13.3 디렉터리 구조","words":[{"text":"13.3","x":1169,"y":163,"width":70,"height":23},{"text":"디렉터리","x":1257,"y":162,"width":91,"height":28},{"text":"구조","x":1358,"y":164,"width":47,"height":26}]},{"text":"601","words":[{"text":"601","x":1475,"y":160,"width":53,"height":29}]},{"text":"기는 파일이 존재하지 않는 것을 알아내고 그 링크를 해석하는 것은 잘못된 파일을 접근","words":[{"text":"기는","x":289,"y":293,"width":64,"height":37},{"text":"파일이","x":366,"y":294,"width":95,"height":37},{"text":"존재하지","x":477,"y":294,"width":122,"height":37},{"text":"않는","x":616,"y":295,"width":59,"height":36},{"text":"것을","x":688,"y":294,"width":57,"height":37},{"text":"알아내고","x":757,"y":294,"width":118,"height":37},{"text":"그","x":888,"y":298,"width":30,"height":26},{"text":"링크를","x":932,"y":293,"width":91,"height":37},{"text":"해석하는","x":1035,"y":293,"width":125,"height":37},{"text":"것은","x":1174,"y":293,"width":63,"height":37},{"text":"잘못된","x":1249,"y":293,"width":96,"height":37},{"text":"파일을","x":1359,"y":294,"width":97,"height":37},{"text":"접근","x":1470,"y":295,"width":64,"height":37}]},{"text":"하는 것처럼 실패하게 된다(이 경우, 시스템 설계자 파일이 삭제되고 동일한 이름의 다","words":[{"text":"하는","x":288,"y":355,"width":66,"height":36},{"text":"것처럼","x":371,"y":355,"width":92,"height":37},{"text":"실패하게","x":482,"y":355,"width":122,"height":37},{"text":"된다(이","x":622,"y":355,"width":96,"height":40},{"text":"경우,","x":737,"y":356,"width":65,"height":36},{"text":"시스템","x":817,"y":354,"width":86,"height":38},{"text":"설계자","x":922,"y":354,"width":92,"height":38},{"text":"파일이","x":1027,"y":355,"width":90,"height":37},{"text":"삭제되고","x":1134,"y":354,"width":128,"height":38},{"text":"동일한","x":1276,"y":355,"width":99,"height":37},{"text":"이름의","x":1390,"y":355,"width":93,"height":37},{"text":"다","x":1502,"y":357,"width":32,"height":37}]},{"text":"른 파일이 생성될 때, 그 이름에 대한 심볼링 링그를 어떻게 처리할 것인지에 대해서 신","words":[{"text":"른","x":288,"y":418,"width":32,"height":34},{"text":"파일이","x":334,"y":416,"width":95,"height":38},{"text":"생성될","x":448,"y":416,"width":92,"height":38},{"text":"때,","x":557,"y":417,"width":37,"height":37},{"text":"그","x":609,"y":422,"width":29,"height":25},{"text":"이름에","x":652,"y":416,"width":85,"height":38},{"text":"대한","x":754,"y":416,"width":58,"height":38},{"text":"심볼링","x":825,"y":416,"width":85,"height":37},{"text":"링그를","x":929,"y":416,"width":90,"height":38},{"text":"어떻게","x":1033,"y":417,"width":89,"height":38},{"text":"처리할","x":1139,"y":416,"width":95,"height":38},{"text":"것인지에","x":1248,"y":417,"width":126,"height":37},{"text":"대해서","x":1391,"y":417,"width":92,"height":37},{"text":"신","x":1501,"y":418,"width":31,"height":36}]},{"text":"중히 고려해야 한다). UNIX의 경우 파일이 삭제될 때, 심볼링 링크는 그대로 내버려둔","words":[{"text":"중히","x":288,"y":478,"width":62,"height":36},{"text":"고려해야","x":368,"y":478,"width":131,"height":37},{"text":"한다).","x":512,"y":478,"width":82,"height":39},{"text":"UNIX의","x":609,"y":478,"width":117,"height":37},{"text":"경우","x":744,"y":478,"width":58,"height":37},{"text":"파일이","x":814,"y":478,"width":86,"height":37},{"text":"삭제될","x":917,"y":478,"width":90,"height":37},{"text":"때,","x":1024,"y":478,"width":36,"height":38},{"text":"심볼링","x":1076,"y":478,"width":88,"height":37},{"text":"링크는","x":1184,"y":478,"width":94,"height":37},{"text":"그대로","x":1291,"y":478,"width":97,"height":37},{"text":"내버려둔","x":1403,"y":478,"width":131,"height":37}]},{"text":"다. 따라서 원래 파일이 삭제되기나 다른 파일로 바뀐! 경우에 대한 책임은 사용자가 져","words":[{"text":"다.","x":289,"y":539,"width":39,"height":37},{"text":"따라서","x":346,"y":539,"width":94,"height":37},{"text":"원래","x":460,"y":539,"width":59,"height":36},{"text":"파일이","x":537,"y":539,"width":90,"height":37},{"text":"삭제되기나","x":644,"y":539,"width":150,"height":37},{"text":"다른","x":809,"y":540,"width":58,"height":36},{"text":"파일로","x":880,"y":540,"width":91,"height":36},{"text":"바뀐!","x":985,"y":540,"width":60,"height":37},{"text":"경우에","x":1062,"y":540,"width":88,"height":37},{"text":"대한","x":1168,"y":540,"width":63,"height":36},{"text":"책임은","x":1246,"y":539,"width":96,"height":37},{"text":"사용자가","x":1354,"y":539,"width":133,"height":38},{"text":"져","x":1502,"y":540,"width":28,"height":37}]},{"text":"야 한다. Microsoft의 Windows도 같은 방법을 사용한다.","words":[{"text":"야","x":289,"y":601,"width":33,"height":38},{"text":"한다.","x":334,"y":601,"width":73,"height":38},{"text":"Microsoft의","x":421,"y":601,"width":185,"height":37},{"text":"Windows도","x":620,"y":603,"width":177,"height":32},{"text":"같은","x":810,"y":602,"width":58,"height":37},{"text":"방법을","x":880,"y":602,"width":91,"height":37},{"text":"사용한다.","x":981,"y":602,"width":129,"height":38}]},{"text":"삭제에 관한 또 다른 방법은 모든 참조가 지위질 때까지 원본 파일을 보존하는 것","words":[{"text":"삭제에","x":351,"y":664,"width":96,"height":37},{"text":"관한","x":465,"y":662,"width":66,"height":37},{"text":"또","x":545,"y":667,"width":31,"height":27},{"text":"다른","x":593,"y":664,"width":61,"height":37},{"text":"방법은","x":669,"y":664,"width":90,"height":37},{"text":"모든","x":773,"y":666,"width":60,"height":35},{"text":"참조가","x":848,"y":665,"width":90,"height":37},{"text":"지위질","x":953,"y":665,"width":88,"height":38},{"text":"때까지","x":1059,"y":664,"width":87,"height":38},{"text":"원본","x":1166,"y":664,"width":62,"height":37},{"text":"파일을","x":1243,"y":664,"width":96,"height":37},{"text":"보존하는","x":1354,"y":664,"width":131,"height":37},{"text":"것","x":1502,"y":664,"width":29,"height":38}]},{"text":"이다. 이 방법을 구현하기 위해서 파일에 대한 마지막 참조가 삭제되었지 판단할 수 있","words":[{"text":"이다.","x":291,"y":726,"width":71,"height":37},{"text":"이","x":382,"y":726,"width":26,"height":37},{"text":"방법을","x":428,"y":725,"width":97,"height":37},{"text":"구현하기","x":538,"y":726,"width":122,"height":37},{"text":"위해서","x":679,"y":726,"width":86,"height":37},{"text":"파일에","x":782,"y":727,"width":87,"height":37},{"text":"대한","x":886,"y":727,"width":60,"height":36},{"text":"마지막","x":959,"y":727,"width":92,"height":37},{"text":"참조가","x":1064,"y":727,"width":92,"height":36},{"text":"삭제되었지","x":1168,"y":726,"width":155,"height":37},{"text":"판단할","x":1342,"y":726,"width":97,"height":37},{"text":"수","x":1452,"y":727,"width":34,"height":36},{"text":"있","x":1502,"y":728,"width":30,"height":36}]},{"text":"는 방법이 필요하다. 파일(디렉터리 항목 또는 심볼리 링크)에 대한 모든 참조의 리스트","words":[{"text":"는","x":289,"y":790,"width":34,"height":34},{"text":"방법이","x":336,"y":788,"width":95,"height":37},{"text":"필요하다.","x":450,"y":787,"width":134,"height":37},{"text":"파일(디렉터리","x":601,"y":788,"width":191,"height":41},{"text":"항목","x":808,"y":789,"width":61,"height":37},{"text":"또는","x":881,"y":791,"width":61,"height":34},{"text":"심볼리","x":955,"y":789,"width":85,"height":37},{"text":"링크)에","x":1059,"y":789,"width":98,"height":39},{"text":"대한","x":1173,"y":788,"width":62,"height":37},{"text":"모든","x":1248,"y":790,"width":64,"height":34},{"text":"참조의","x":1324,"y":788,"width":94,"height":36},{"text":"리스트","x":1437,"y":789,"width":95,"height":36}]},{"text":"(file-reference list)를 저장할 수 있다. 디렉터리 항목의 링크나 복사가 형성된다면, 새","words":[{"text":"(file-reference","x":290,"y":852,"width":229,"height":38},{"text":"list)를","x":533,"y":852,"width":93,"height":38},{"text":"저장할","x":640,"y":851,"width":92,"height":37},{"text":"수","x":744,"y":851,"width":30,"height":37},{"text":"있다.","x":788,"y":851,"width":65,"height":37},{"text":"디렉터리","x":869,"y":851,"width":115,"height":37},{"text":"항목의","x":1000,"y":851,"width":87,"height":37},{"text":"링크나","x":1106,"y":850,"width":90,"height":38},{"text":"복사가","x":1208,"y":850,"width":95,"height":37},{"text":"형성된다면,","x":1316,"y":849,"width":169,"height":39},{"text":"새","x":1500,"y":851,"width":29,"height":37}]},{"text":"로운 항목이 파일 참조 리스트에 추가된다. 파일 참조가 비어있는 경우 원본 파일은 삭","words":[{"text":"로운","x":289,"y":913,"width":67,"height":35},{"text":"항목이","x":370,"y":911,"width":96,"height":38},{"text":"파일","x":484,"y":912,"width":63,"height":36},{"text":"참조","x":563,"y":913,"width":63,"height":36},{"text":"리스트에","x":642,"y":913,"width":118,"height":37},{"text":"추가된다.","x":776,"y":913,"width":128,"height":37},{"text":"파일","x":920,"y":913,"width":58,"height":37},{"text":"참조가","x":993,"y":913,"width":91,"height":36},{"text":"비어있는","x":1098,"y":912,"width":121,"height":37},{"text":"경우","x":1234,"y":912,"width":62,"height":37},{"text":"원본","x":1311,"y":912,"width":64,"height":35},{"text":"파일은","x":1388,"y":912,"width":99,"height":36},{"text":"삭","x":1499,"y":913,"width":34,"height":36}]},{"text":"제된다.","words":[{"text":"제된다.","x":290,"y":974,"width":106,"height":36}]},{"text":"이 문제의 단점은 파일 참조 리스트의 사이즈가 가변적이고 매우 커질 수 있다는 것","words":[{"text":"이","x":353,"y":1035,"width":28,"height":37},{"text":"문제의","x":398,"y":1035,"width":95,"height":37},{"text":"단점은","x":510,"y":1036,"width":97,"height":36},{"text":"파일","x":618,"y":1037,"width":61,"height":36},{"text":"참조","x":693,"y":1037,"width":61,"height":36},{"text":"리스트의","x":768,"y":1037,"width":117,"height":37},{"text":"사이즈가","x":899,"y":1037,"width":122,"height":36},{"text":"가변적이고","x":1032,"y":1037,"width":152,"height":36},{"text":"매우","x":1197,"y":1036,"width":61,"height":36},{"text":"커질","x":1272,"y":1035,"width":59,"height":37},{"text":"수","x":1346,"y":1035,"width":33,"height":36},{"text":"있다는","x":1393,"y":1034,"width":96,"height":36},{"text":"것","x":1503,"y":1034,"width":29,"height":36}]},{"text":"이다. 그러나 참조한 숫자를 가리기는 계수(count)만 유지하면 되므로, 참조 리스트 전","words":[{"text":"이다.","x":291,"y":1097,"width":72,"height":37},{"text":"그러나","x":380,"y":1097,"width":100,"height":37},{"text":"참조한","x":494,"y":1097,"width":97,"height":36},{"text":"숫자를","x":603,"y":1098,"width":95,"height":37},{"text":"가리기는","x":712,"y":1099,"width":123,"height":37},{"text":"계수(count)만","x":849,"y":1099,"width":201,"height":39},{"text":"유지하면","x":1061,"y":1098,"width":121,"height":37},{"text":"되므로,","x":1197,"y":1098,"width":100,"height":36},{"text":"참조","x":1313,"y":1096,"width":65,"height":36},{"text":"리스트","x":1393,"y":1095,"width":95,"height":36},{"text":"전","x":1503,"y":1095,"width":30,"height":36}]},{"text":"체를 저장할 필요는 없다. 새로운 링크나 디렉터리 항목을 추가할 때 참조 계수를 증가","words":[{"text":"