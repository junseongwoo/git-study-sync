idth":217,"height":36},{"text":"네트워크","x":1279,"y":1085,"width":131,"height":36},{"text":"입출력이","x":1428,"y":1085,"width":128,"height":36}]},{"text":"그 좋은 예이다. 디폴트로 응용이 네트워크 송신 요청 또는 보조저장장치 쓰기 요청을","words":[{"text":"그","x":308,"y":1150,"width":33,"height":24},{"text":"좋은","x":357,"y":1146,"width":66,"height":35},{"text":"예이다.","x":440,"y":1145,"width":102,"height":35},{"text":"디폴트로","x":561,"y":1145,"width":123,"height":35},{"text":"응용이","x":699,"y":1145,"width":90,"height":36},{"text":"네트워크","x":808,"y":1145,"width":120,"height":36},{"text":"송신","x":942,"y":1145,"width":61,"height":36},{"text":"요청","x":1018,"y":1145,"width":56,"height":35},{"text":"또는","x":1093,"y":1146,"width":62,"height":33},{"text":"보조저장장치","x":1169,"y":1145,"width":189,"height":36},{"text":"쓰기","x":1377,"y":1144,"width":63,"height":36},{"text":"요청을","x":1461,"y":1145,"width":101,"height":36}]},{"text":"한 경우, 운영체제는 요청을 주목하면 입출력 요청을 버퍼에 넣고 응용으로 되돌아간다.","words":[{"text":"한","x":308,"y":1204,"width":34,"height":34},{"text":"경우,","x":356,"y":1204,"width":72,"height":36},{"text":"운영체제는","x":442,"y":1204,"width":162,"height":35},{"text":"요청을","x":616,"y":1205,"width":94,"height":34},{"text":"주목하면","x":721,"y":1205,"width":122,"height":35},{"text":"입출력","x":859,"y":1205,"width":84,"height":35},{"text":"요청을","x":960,"y":1205,"width":92,"height":35},{"text":"버퍼에","x":1065,"y":1205,"width":87,"height":35},{"text":"넣고","x":1169,"y":1205,"width":61,"height":35},{"text":"응용으로","x":1242,"y":1205,"width":131,"height":35},{"text":"되돌아간다.","x":1387,"y":1204,"width":175,"height":38}]},{"text":"전체적인 시스템 성능을 최적화하기 위해 운영체제는 여력이 생길 때 요청을 완료한다.","words":[{"text":"전체적인","x":310,"y":1264,"width":129,"height":34},{"text":"시스템","x":456,"y":1263,"width":91,"height":35},{"text":"성능을","x":565,"y":1264,"width":95,"height":35},{"text":"최적화하기","x":674,"y":1264,"width":149,"height":36},{"text":"위해","x":841,"y":1265,"width":57,"height":35},{"text":"운영체제는","x":913,"y":1264,"width":154,"height":36},{"text":"여력이","x":1080,"y":1264,"width":88,"height":35},{"text":"생길","x":1185,"y":1265,"width":62,"height":34},{"text":"때","x":1263,"y":1265,"width":27,"height":35},{"text":"요청을","x":1307,"y":1264,"width":100,"height":36},{"text":"완료한다.","x":1420,"y":1265,"width":142,"height":38}]},{"text":"도중에 시스템 고장이 발생하면 현재 진행 중인 응용의 요청을 잃어버리게 된다. 따라서","words":[{"text":"도중에","x":308,"y":1323,"width":97,"height":35},{"text":"시스템","x":422,"y":1323,"width":92,"height":35},{"text":"고장이","x":530,"y":1323,"width":92,"height":35},{"text":"발생하면","x":638,"y":1323,"width":123,"height":36},{"text":"현재","x":774,"y":1324,"width":58,"height":36},{"text":"진행","x":849,"y":1324,"width":55,"height":35},{"text":"중인","x":918,"y":1324,"width":61,"height":35},{"text":"응용의","x":991,"y":1324,"width":90,"height":35},{"text":"요청을","x":1096,"y":1324,"width":93,"height":35},{"text":"잃어버리게","x":1203,"y":1324,"width":156,"height":36},{"text":"된다.","x":1375,"y":1325,"width":72,"height":35},{"text":"따라서","x":1463,"y":1326,"width":96,"height":37}]},{"text":"운영체제는 요청을 버퍼링하는 데 시간제한을 둔다. 예를 들어 일부 UNIX 버전은 30초","words":[{"text":"운영체제는","x":308,"y":1382,"width":167,"height":36},{"text":"요청을","x":486,"y":1382,"width":97,"height":35},{"text":"버퍼링하는","x":595,"y":1383,"width":155,"height":35},{"text":"데","x":763,"y":1384,"width":25,"height":35},{"text":"시간제한을","x":803,"y":1383,"width":153,"height":36},{"text":"둔다.","x":966,"y":1384,"width":69,"height":34},{"text":"예를","x":1050,"y":1383,"width":60,"height":35},{"text":"들어","x":1120,"y":1384,"width":59,"height":34},{"text":"일부","x":1197,"y":1384,"width":62,"height":35},{"text":"UNIX","x":1270,"y":1388,"width":97,"height":28},{"text":"버전은","x":1382,"y":1385,"width":97,"height":35},{"text":"30초","x":1490,"y":1389,"width":73,"height":28}]},{"text":"마다 보조저장장치 버퍼를 디스크에 기록하거나 각 요청은 요청 시작부터 30초 안에 플","words":[{"text":"마다","x":310,"y":1441,"width":66,"height":36},{"text":"보조저장장치","x":390,"y":1441,"width":189,"height":36},{"text":"버퍼를","x":598,"y":1442,"width":92,"height":35},{"text":"디스크에","x":703,"y":1443,"width":120,"height":35},{"text":"기록하거나","x":839,"y":1443,"width":151,"height":36},{"text":"각","x":1002,"y":1443,"width":32,"height":35},{"text":"요청은","x":1044,"y":1443,"width":94,"height":35},{"text":"요청","x":1149,"y":1443,"width":59,"height":36},{"text":"시작부터","x":1226,"y":1443,"width":123,"height":37},{"text":"30초","x":1366,"y":1447,"width":71,"height":29},{"text":"안에","x":1451,"y":1445,"width":63,"height":36},{"text":"플","x":1529,"y":1448,"width":34,"height":33}]},{"text":"러시 된다. 시스템은 -응용이 일부 버퍼(보조저장장지 버퍼와 같은)의 플러시를 요청하도","words":[{"text":"러시","x":313,"y":1500,"width":60,"height":35},{"text":"된다.","x":390,"y":1501,"width":72,"height":35},{"text":"시스템은","x":478,"y":1501,"width":126,"height":35},{"text":"-응용이","x":615,"y":1502,"width":90,"height":35},{"text":"일부","x":723,"y":1503,"width":60,"height":35},{"text":"버퍼(보조저장장지","x":796,"y":1502,"width":252,"height":38},{"text":"버퍼와","x":1065,"y":1502,"width":93,"height":36},{"text":"같은)의","x":1169,"y":1503,"width":103,"height":38},{"text":"플러시를","x":1287,"y":1504,"width":131,"height":35},{"text":"요청하도","x":1429,"y":1505,"width":134,"height":36}]},{"text":"록 하여 버퍼 플러시 간격을 기다리지 않고 보조저장장치로 데이터를 강제 전송할 수 있","words":[{"text":"록","x":311,"y":1561,"width":34,"height":33},{"text":"하여","x":357,"y":1560,"width":62,"height":36},{"text":"버퍼","x":437,"y":1560,"width":59,"height":36},{"text":"플러시","x":512,"y":1561,"width":90,"height":36},{"text":"간격을","x":619,"y":1561,"width":93,"height":35},{"text":"기다리지","x":724,"y":1562,"width":118,"height":35},{"text":"않고","x":859,"y":1561,"width":60,"height":35},{"text":"보조저장장치로","x":930,"y":1562,"width":216,"height":36},{"text":"데이터를","x":1159,"y":1563,"width":127,"height":35},{"text":"강제","x":1297,"y":1564,"width":62,"height":35},{"text":"전송할","x":1376,"y":1564,"width":97,"height":35},{"text":"수","x":1483,"y":1565,"width":35,"height":35},{"text":"있","x":1532,"y":1566,"width":31,"height":34}]},{"text":"는 방법을 제공한다. 응용에서의 데이터 일관성은 커널에 의해 유지되며 아직 기록되지","words":[{"text":"는","x":312,"y":1621,"width":34,"height":31},{"text":"방법을","x":360,"y":1620,"width":98,"height":34},{"text":"제공한다.","x":472,"y":1620,"width":133,"height":35},{"text":"응용에서의","x":620,"y":1620,"width":152,"height":36},{"text":"데이터","x":789,"y":1621,"width":87,"height":35},{"text":"일관성은","x":895,"y":1621,"width":121,"height":35},{"text":"커널에","x":1030,"y":1621,"width":88,"height":35},{"text":"의해","x":1135,"y":1622,"width":59,"height":35},{"text":"유지되며","x":1209,"y":1623,"width":126,"height":35},{"text":"아직","x":1353,"y":1624,"width":60,"height":35},{"text":"기록되지","x":1432,"y":1624,"width":127,"height":37}]},{"text":"않은 데이터가 읽기 요청을 한 펑용에 전달되는 것을 보장하도록 커널은 입출력 명령을","words":[{"text":"않은","x":313,"y":1678,"width":66,"height":35},{"text":"데이터가","x":394,"y":1679,"width":129,"height":36},{"text":"읽기","x":538,"y":1680,"width":55,"height":35},{"text":"요청을","x":610,"y":1680,"width":94,"height":34},{"text":"한","x":717,"y":1680,"width":31,"height":34},{"text":"펑용에","x":759,"y":1680,"width":90,"height":35},{"text":"전달되는","x":865,"y":1680,"width":123,"height":35},{"text":"것을","x":1001,"y":1681,"width":60,"height":35},{"text":"보장하도록","x":1072,"y":1682,"width":159,"height":35},{"text":"커널은","x":1245,"y":1682,"width":96,"height":36},{"text":"입출력","x":1356,"y":1683,"width":90,"height":36},{"text":"명령을","x":1466,"y":1684,"width":98,"height":35}]},{"text":"장치에 내리기 전에 버퍼로부터 데이터를 읽는다. 커널이 입출력을 구현한 방법에 따라","words":[{"text":"장치에","x":313,"y":1737,"width":96,"height":36},{"text":"내리기","x":427,"y":1738,"width":92,"height":36},{"text":"전에","x":538,"y":1739,"width":58,"height":35},{"text":"버퍼로부터","x":614,"y":1739,"width":149,"height":36},{"text":"데이터를","x":781,"y":1739,"width":121,"height":36},{"text":"읽는다.","x":917,"y":1740,"width":96,"height":35},{"text":"커널이","x":1030,"y":1740,"width":88,"height":36},{"text":"입출력을","x":1136,"y":1741,"width":127,"height":35},{"text":"구현한","x":1275,"y":1743,"width":98,"height":34},{"text":"방법에","x":1386,"y":1743,"width":94,"height":36},{"text":"따라","x":1497,"y":1744,"width":69,"height":35}]},{"