y":1884,"width":133,"height":39},{"text":"것을","x":470,"y":1884,"width":68,"height":37},{"text":"인식하는","x":552,"y":1884,"width":135,"height":38},{"text":"것이","x":701,"y":1883,"width":63,"height":39},{"text":"중요하다.","x":779,"y":1885,"width":149,"height":38},{"text":"그렇지만,","x":943,"y":1884,"width":146,"height":39},{"text":"많은","x":1103,"y":1883,"width":70,"height":39},{"text":"프로세스가","x":1184,"y":1883,"width":174,"height":38},{"text":"준비완료","x":1368,"y":1883,"width":138,"height":38},{"text":"및","x":1522,"y":1884,"width":31,"height":37},{"text":"대기","x":1570,"y":1884,"width":66,"height":38},{"text":"상","x":1649,"y":1885,"width":36,"height":38}]},{"text":"태에 있을 수 있다. 그림 3.2는 이들 상태에 해당하는 상대 다이어그램(state diagram)","words":[{"text":"태에","x":324,"y":1949,"width":63,"height":38},{"text":"있을","x":406,"y":1948,"width":66,"height":38},{"text":"수","x":484,"y":1948,"width":35,"height":38},{"text":"있다.","x":535,"y":1948,"width":72,"height":38},{"text":"그림","x":624,"y":1948,"width":64,"height":37},{"text":"3.2는","x":705,"y":1950,"width":87,"height":35},{"text":"이들","x":807,"y":1949,"width":68,"height":38},{"text":"상태에","x":888,"y":1949,"width":101,"height":39},{"text":"해당하는","x":1007,"y":1949,"width":136,"height":39},{"text":"상대","x":1155,"y":1947,"width":67,"height":39},{"text":"다이어그램(state","x":1240,"y":1947,"width":267,"height":43},{"text":"diagram)","x":1522,"y":1951,"width":160,"height":42}]},{"text":"이다.","words":[{"text":"이다.","x":326,"y":2013,"width":72,"height":39}]},{"text":"3.1.3 프로세스 제어 블록 Process Contr01 B10ck","words":[{"text":"3.1.3","x":325,"y":2132,"width":116,"height":33},{"text":"프로세스","x":484,"y":2132,"width":128,"height":34},{"text":"제어","x":623,"y":2133,"width":62,"height":34},{"text":"블록","x":699,"y":2133,"width":64,"height":35},{"text":"Process","x":790,"y":2144,"width":133,"height":23},{"text":"Contr01","x":934,"y":2144,"width":116,"height":23},{"text":"B10ck","x":1060,"y":2143,"width":88,"height":23}]},{"text":"각 프로세스는 운영체제에서 프로세스 제어 블록(process control bloc