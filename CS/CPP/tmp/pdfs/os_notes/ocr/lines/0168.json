날 것이다. 6.2절에서 논의될 것처럼 운영체제 커널은 선점 또","words":[{"text":"까?","x":349,"y":2567,"width":47,"height":39},{"text":"혼란이","x":411,"y":2566,"width":94,"height":40},{"text":"계속해서","x":524,"y":2566,"width":125,"height":40},{"text":"일어날","x":668,"y":2565,"width":97,"height":39},{"text":"것이다.","x":778,"y":2562,"width":103,"height":41},{"text":"6.2절에서","x":896,"y":2560,"width":142,"height":39},{"text":"논의될","x":1055,"y":2561,"width":99,"height":39},{"text":"것처럼","x":1171,"y":2560,"width":101,"height":39},{"text":"운영체제","x":1290,"y":2560,"width":148,"height":40},{"text":"커널은","x":1459,"y":2562,"width":113,"height":39},{"text":"선점","x":1587,"y":2563,"width":64,"height":39},{"text":"또","x":1667,"y":2566,"width":29,"height":29}]}]}