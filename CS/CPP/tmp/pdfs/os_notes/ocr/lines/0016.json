,"x":1171,"y":1416,"width":145,"height":40},{"text":"전기적으로","x":1333,"y":1417,"width":187,"height":39},{"text":"소거","x":1536,"y":1417,"width":69,"height":39},{"text":"가능","x":1627,"y":1417,"width":71,"height":41}]},{"text":"한 프로그램 기능 읽기 전용 메모리(EEPROM) 및 기타 형태의 펌웨어(쓰기 작업이 자","words":[{"text":"한","x":283,"y":1483,"width":37,"height":39},{"text":"프로그램","x":332,"y":1485,"width":137,"height":38},{"text":"기능","x":487,"y":1485,"width":70,"height":40},{"text":"읽기","x":572,"y":1484,"width":62,"height":39},{"text":"전용","x":655,"y":1483,"width":69,"height":39},{"text":"메모리(EEPROM)","x":738,"y":1482,"width":300,"height":44},{"text":"및","x":1057,"y":1483,"width":31,"height":39},{"text":"기타","x":1107,"y":1482,"width":70,"height":40},{"text":"형태의","x":1192,"y":1482,"width":105,"height":40},{"text":"펌웨어(쓰기","x":1318,"y":1483,"width":197,"height":43},{"text":"작업이","x":1536,"y":1483,"width":107,"height":40},{"text":"자","x":1663,"y":1485,"width":36,"height":40}]},{"text":"주 발생하지 않고 비휘발성인 저장장지)를 시용한다. EEPROM은 변경할 수는 있지만","words":[{"text":"주","x":283,"y":1552,"width":36,"height":38},{"text":"발생하지","x":334,"y":1550,"width":136,"height":40},{"text":"않고","x":490,"y":1551,"width":69,"height":40},{"text":"비휘발성인","x":575,"y":1550,"width":172,"height":40},{"text":"저장장지)를","x":765,"y":1549,"width":187,"height":43},{"text":"시용한다.","x":966,"y":1549,"width":149,"height":40},{"text":"EEPROM은","x":1134,"y":1550,"width":216,"height":37},{"text":"변경할","x":1368,"y":1550,"width":112,"height":39},{"text":"수는","x":1496,"y":1550,"width":76,"height":39},{"text":"있지만","x":1592,"y":1550,"width":107,"height":41}]},{"text":"지주 변경할 수는 없다. 또한 속도가 느리므로 주로 사용되지 않는 정적 프로그램과 데","words":[{"text":"지주","x":283,"y":1616,"width":71,"height":40},{"text":"변경할","x":370,"y":1616,"width":104,"height":40},{"text":"수는","x":487,"y":1618,"width":72,"height":39},{"text":"없다.","x":575,"y":1617,"width":75,"height":40},{"text":"또한","x":667,"y":1617,"width":72,"height":38},{"text":"속도가","x":752,"y":1617,"width":106,"height":39},{"text":"느리므로","x":872,"y":1616,"width":141,"height":40},{"text":"주로","x":1027,"y":1618,"width":72,"height":38},{"text":"사용되지","x":1114,"y":1616,"width":140,"height":40},{"text":"않는","x":1276,"y":1616,"width":74,"height":39},{"text":"정적","x":1368,"y":1617,"width":69,"height":39},{"text":"프로그램과","x":1459,"y":1617,"width":189,"height":40},{"text":"데","x":1664,"y":1619,"width":31,"height":40}]},{"text":"이터가 포함되어 있다. 예를 들어, iPhone은 EEPROM을 시용하여 장치의 일련 번호","words":[{"text":"이터가","x":284,"y":1682,"width":104,"height":41},{"text":"포함되어","x":402,"y":1684,"width":136,"height":41},{"text":"있다.","x":560,"y":1684,"width":76,"height":40},{"text":"예를","x":655,"y":1685,"width":70,"height":38},{"text":"들어,","x":739,"y":1684,"width":79,"height":41},{"text":"iPhone은","x":835,"y":1684,"width":160,"height":38},{"text":"EEPROM을","x":1011,"y":1683,"width":210,"height":39},{"text":"시용하여","x":1236,"y":1682,"width":145,"height":41},{"text":"장치의","x":1403,"y":1684,"width":109,"height":40},{"text":"일련","x":1537,"y":1683,"width":70,"height":39},{"text":"번호","x":1628,"y":1685,"width":70,"height":38}]},{"text":"및 하드웨어 정보를 저장한다.","words":[{"text":"및","x":284,"y":1750,"width":30,"height":40},{"text":"하드웨어","x":329,"y":1750,"width":136,"height":40},{"text":"정보를","x":482,"y":1752,"width":105,"height":39},{"text":"저장한다.","x":599,"y":1751,"width":147,"height":40}]},{"text":"모든 형태의 메모리는 바이트의 배열을 제공한다. 각 바이트는 자신의 주소를 가지","words":[{"text":"모든","x":345,"y":1819,"width":71,"height":37},{"text":"형태의","x":432,"y":1818,"width":101,"height":40},{"text":"메모리는","x":552,"y":1818,"width":140,"height":40},{"text":"바이트의","x":707,"y":1818,"width":136,"height":40},{"text":"배열을","x":864,"y":1818,"width":104,"height":40},{"text":"제공한다.","x":984,"y":1818,"width":148,"height":40},{"text":"각","x":1151,"y":1818,"width":36,"height":39},{"text":"바이트는","x":1202,"y":1817,"width":148,"height":41},{"text":"자신의","x":1366,"y":1818,"width":110,"height":40},{"text":"주소를","x":1496,"y":1819,"width":114,"height":39},{"text":"가지","x":1627,"y":1818,"width":67,"height":40}]},{"text":"고 있다. 상호 작용은 특정 메모리 주소들에 대한 일련의 적재(load), 또는 저장(store)","words":[{"text":"고","x":280,"y":1891,"width":35,"height":29},{"text":"있다.","x":333,"y":1885,"width":74,"height":41},{"text":"상호","x":424,"y":1885,"width":71,"height":40},{"text":"작용은","x":510,"y":1886,"width":105,"height":40},{"text":"특정","x":629,"y":1886,"width":66,"height":39},{"text":"메모리","x":715,"y":1885,"width":100,"height":41},{"text":"주소들에","x":833,"y":1885,"width":139,"height":40},{"text":"대한","x":992,"y":1885,"width":70,"height":40},{"text":"일련의","x":1079,"y":1885,"width":100,"height":40},{"text":"적재(load),","x":1201,"y":1885,"width":194,"height":42},{"text":"또는","x":1413,"y":1888,"width":76,"height":36},{"text":"저장(store)","x":1507,"y":1885,"width":191,"height":43}]},{"text":"명령을 통하여 이루어진다. 적재 명령은 메인 메모리로부터 CPU 내부의 레지스터로 한","words":[{"text":"명령을","x":282,"y":1953,"width":104,"height":42},{"text":"통하여","x":398,"y":1953,"width":101,"height":41},{"text":"이루어진다.","x":518,"y":1953,"width":179,"height":41},{"text":"적재","x":714,"y":1952,"width":66,"height":40},{"text":"명령은","x":799,"y":1952,"width":104,"height":40},{"text":"메인","x":916,"y":1952,"width":68,"height":40},{"text":"메모리로부터","x":1000,"y":1952,"width":210,"height":40},{"text":"CPU","x":1228,"y":1955,"width":88,"height":32},{"text":"내부의","x":1334,"y":1952,"width":108,"height":39},{"text":"레지스터로","x":1462,"y":1952,"width":188,"height":40},{"text":"한","x":1664,"y":1953,"width":37,"height":38}]},{"text":"바이트 또는 한 워드를 옮기는 것이다. 반대로 저장 명령은 레지스터의 내펑-을 메인 메","words":[{"text":"바이트","x":280,"y":2021,"width":104,"height":41},{"text":"또는","x":399,"y":2024,"width":71,"height":36},{"text":"한","x":485,"y":2022,"width":37,"height":39},{"text":"워드를","x":536,"y":2022,"width":103,"height":40},{"text":"옮기는","x":653,"y":2020,"width":105,"height":40},{"text":"것이다.","x":775,"y":2019,"width":109,"height":40},{"text":"반대로","x":904,"y":2019,"width":104,"height":40},{"text":"저장","x":1025,"y":2019,"width":71,"height":39},{"text":"명령은","x":1114,"y":2018,"width":107,"height":40},{"text":"레지스터의","x":1238,"y":2018,"width":183,"height":40},{"text":"내펑-을","x":1443,"y":2019,"width":114,"height":39},{"text":"메인","x":1574,"y":2018,"width":72,"height":40},{"text":"메","x":1665,"y":2020,"width":31,"height":39}]},{"text":"모리로 옮긴다. 명시적인 적재, 저장 명령 외에, CPU는 프로그램 카운터에 저장된 위치","words":[{"text":"모리로","x":279,"y":2089,"width":105,"height":39},{"text":"옮긴다.","x":397,"y":2088,"width":113,"height":40},{"text":"명시적인","x":528,"y":2087,"width":135,"height":41},{"text":"적재,","x":678,"y":2087,"width":76,"height":40},{"text":"저장","x":771,"y":2087,"width":69,"height":40},{"text":"명령","x":854,"y":2087,"width":64,"height":39},{"text":"외에,","x":937,"y":2085,"width":77,"height":41},{"text":"CPU는","x":1029,"y":2087,"width":125,"height":36},{"text":"프로그램","x":1166,"y":2085,"width":146,"height":39},{"text":"카운터에","x":1331,"y":2085,"width":148,"height":40},{"text":"저장된","x":1500,"y":2085,"width":111,"height":40},{"text":"위치","x":1628,"y":2086,"width":67,"height":39}]},{"text":"부터 실행하기 위해 메인 메모리에서 명령을 지동으로 적재한다.","words":[{"text":"부터","x":280,"y":2156,"width":64,"height":40},{"text":"실행하기","x":362,"y":2154,"width":134,"height":41},{"text":"위해","x":515,"y":2155,"width":65,"height":40},{"text":"메인","x":596,"y":2154,"width":66,"height":40},{"text":"메모리에서","x":677,"y":2153,"width":167,"height":41},{"text":"명령을","x":864,"y":2153,"width":102,"height":40},{"text":"지동으로","x":978,"y":2152,"width":144,"height":39},{"text":"적재한다.","x":1136,"y":2152,"width":154,"height":40}]},{"text":"폰 노이만 구조 시스템에서 실행되는 전형적인 명령-실행 사이클은 먼저 메모리로","words":[{"text":"폰","x":345,"y":2223,"width":35,"height":36},{"text":"노이만","x":393,"y":2221,"width":106,"height":39},{"text":"구조","x":512,"y":2224,"width":70,"height":37},{"text":"시스템에서","x":596,"y":2221,"width":167,"height":40},{"text":"실행되는","x":782,"y":2220,"width":138,"height":40},{"text":"전형적인","x":936,"y":2218,"width":137,"height":40},{"text":"명령-실행","x":1092,"y":2218,"width":178,"height":40},{"text":"사이클은","x":1289,"y":2218,"width":153,"height":40},{"text":"먼저","x":1460,"y":2219,"width":69,"height":40},{"text":"메모리로","x":1551,"y":2219,"width":149,"height":40}]},{"text":"부터 명령을 인출에 그 명령을 명령 레지스터(instruction register)에 저장한다. 이어","words":[{"text":"부터","x":282,"y":2288,"width":64,"height":40},{"text":"명령을","x":367,"y":2287,"width":103,"height":39},{"text":"인출에","x":487,"y":2287,"width":109,"height":41},{"text":"그","x":613,"y":2293,"width":34,"height":26},{"text":"명령을","x":663,"y":2286,"width":102,"height":40},{"text":"명령","x":780,"y":2286,"width":63,"height":40},{"text":"레지스터(instruction","x":864,"y":2285,"width":350,"height":43},{"text":"register)에","x":1230,"y":2285,"width":194,"height":46},{"text":"저장한다.","x":1446,"y":2286,"width":160,"height":41},{"text":"이어","x":1628,"y":2286,"width":68,"height":40}]},{"text":"서 명령을 해독하고, 이는 메모리로부터 피연산지를 인출하여 내부 레지스터에 저장하도","words":[{"text":"서","x":286,"y":2353,"width":28,"height":39},{"text":"명령을","x":332,"y":2353,"width":102,"height":38},{"text":"해독하고,","x":447,"y":2352,"width":145,"height":41},{"text":"이는","x":608,"y":2353,"width":68,"height":39},{"text":"메모리로부터","x":688,"y":2352,"width":200,"height":40},{"text":"피연산지를","x":908,"y":2352,"width":174,"height":40},{"text":"인출하여","x":1097,"y":2353,"width":139,"height":39},{"text":"내부","x":1255,"y":2352,"width":74,"height":40},{"text":"레지스터에","x":1344,"y":2352,"width":187,"height":42},{"text":"저장하도","x":1550,"y":2353,"width":151,"height":40}]},{"text":"록 유발할 수 있다. 피연산자에 대해 명령을 실행한 후에 결과가 메모리에 다시 저장될","words":[{"text":"록","x":286,"y":2419,"width":35,"height":36},{"text":"유발할","x":336,"y":2417,"width":103,"height":38},{"text":"수","x":453,"y":2419,"width":35,"height":38},{"text":"있다.","x":505,"y":2418,"width":73,"height":40},{"text":"피연산자에","x":598,"y":2418,"width":167,"height":39},{"text":"대해","x":784,"y":2418,"width":65,"height":39},{"text":"명령을","x":868,"y":2418,"width":103,"height":39},{"text":"실행한","x":986,"y":2418,"width":105,"height":39},{"text":"후에","x":1105,"y":2419,"width":70,"height":40},{"text":"결과가","x":1197,"y":2419,"width":110,"height":40},{"text":"메모리에","x":1322,"y":2419,"width":150,"height":42},{"text":"다시","x":1494,"y":2420,"width":71,"height":41},{"text":"저장될","x":1589,"y":2419,"width":110,"height":40}]},{"text":"수 있다. 메모리 장치는 단지 일련의 메모리 주소만을 인식한다는 사실에 유의하라. 메모","words":[{"text":"수","x":289,"y":2483,"width":35,"height":37},{"text":"있다.","x":337,"y":2482,"width":73,"height":39},{"text":"메모리","x":425,"y":2483,"width":99,"height":40},{"text":"장치는","x":540,"y":2483,"width":103,"height":40},{"text":"단지","x":655,"y":2483,"width":64,"height":39},{"text":"일련의","x":738,"y":2483,"width":97,"height":39},{"text":"메모리","x":852,"y":2483,"width":98,"height":40},{"text":"주소만을","x":966,"y":2484,"width":142,"height":39},{"text":"인식한다는","x":1122,"y":2485,"width":181,"height":40},{"text":"사실에","x":1316,"y":2486,"width":111,"height":39},{"text":"유의하라.","x":1444,"y":2487,"width":164,"height":41},{"text":"메모","x":1625,"y":2486,"width":75,"height":40}]},{"text":"리는 이들 주소[명령 카운터(instruction counter), 색인(indexing), 간접 주소(indi-","words":[{"text":"리는","x":294,"y":2546,"width":66,"height":39},{"text":"이들","x":377,"y":2547,"width":67,"height":40},{"text":"주소[명령","x":459,"y":2548,"width":146,"height":42},{"text":"카운터(instruction","x":626,"y":2549,"width":305,"height":42},{"text":"counter),","x":946,"y":2553,"width":158,"height":39},{"text":"색인(indexing),","x":1124,"y":2551,"width":276,"height":47},{"text":"간접","x":1421,"y":2553,"width":72,"height":40},{"text":"주소(indi-","x":1515,"y":2556,"width":185,"height":40}]},{"text":"rection), 리터럴 주소(literal addresses) 뉘가 어떻게 생성되었는지 알지 못하며, 그","words":[{"text":"rection),","x":294,"y":2616,"width":140,"height":38},{"text":"리터럴","x":453,"y":2614,"width":98,"height":39},{"text":"주소(literal","x":567,"y":2616,"width":181,"height":40},{"text":"addresses)","x":764,"y":2617,"width":182,"height":39},{"text":"뉘가","x":963,"y":2615,"width":84,"height":41},{"text":"어떻게","x":1063,"y":2616,"width":101,"height":40},{"text":"생성되었는지","x":1184,"y":2