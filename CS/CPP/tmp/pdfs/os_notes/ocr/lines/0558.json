테이블 안에 저장되며, 파일마다 한 행을 가진 관계 데이터베이스 구조를 시용한다.","words":[{"text":"테이블","x":372,"y":1042,"width":96,"height":37},{"text":"안에","x":480,"y":1043,"width":60,"height":37},{"text":"저장되며,","x":556,"y":1043,"width":131,"height":38},{"text":"파일마다","x":699,"y":1045,"width":124,"height":36},{"text":"한","x":832,"y":1046,"width":32,"height":35},{"text":"행을","x":875,"y":1046,"width":60,"height":36},{"text":"가진","x":946,"y":1047,"width":59,"height":35},{"text":"관계","x":1016,"y":1047,"width":59,"height":36},{"text":"데이터베이스","x":1090,"y":1048,"width":186,"height":37},{"text":"구조를","x":1288,"y":1051,"width":96,"height":35},{"text":"시용한다.","x":1395,"y":1047,"width":136,"height":36}]},{"text":"메모리 내의 정보는 파일 시스템 관리와 개성을 통한 성능 향상을 위해 사용된다. 이","words":[{"text":"메모리","x":372,"y":1166,"width":92,"height":36},{"text":"내의","x":481,"y":1166,"width":60,"height":36},{"text":"정보는","x":558,"y":1167,"width":93,"height":36},{"text":"파일","x":661,"y":1167,"width":61,"height":36},{"text":"시스템","x":735,"y":1168,"width":88,"height":36},{"text":"관리와","x":837,"y":1168,"width":93,"height":36},{"text":"개성을","x":942,"y":1168,"width":90,"height":37},{"text":"통한","x":1042,"y":1170,"width":63,"height":36},{"text":"성능","x":1115,"y":1170,"width":61,"height":36},{"text":"향상을","x":1186,"y":1171,"width":96,"height":36},{"text":"위해","x":1294,"y":1170,"width":61,"height":37},{"text":"사용된다.","x":1369,"y":1168,"width":136,"height":37},{"text":"이","x":1521,"y":1168,"width":26,"height":36}]},{"text":"정보들은 마운트 시점에 적재되고, 파일 시스템 동작 중에 갱신되며, 마운트 해제 시에","words":[{"text":"정보들은","x":313,"y":1227,"width":129,"height":36},{"text":"마운트","x":456,"y":1227,"width":96,"height":36},{"text":"시점에","x":568,"y":1228,"width":89,"height":36},{"text":"적재되고,","x":675,"y":1228,"width":130,"height":37},{"text":"파일","x":820,"y":1228,"width":59,"height":36},{"text":"시스템","x":895,"y":1229,"width":88,"height":36},{"text":"동작","x":1000,"y":1230,"width":62,"height":35},{"text":"중에","x":1073,"y":1231,"width":59,"height":35},{"text":"갱신되며,","x":1151,"y":12