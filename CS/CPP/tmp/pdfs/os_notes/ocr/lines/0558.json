{"page":558,"width":1746,"height":2621,"text_angle":0,"lines":[{"text":"14.2 파일 시스템구현 621","words":[{"text":"14.2","x":1150,"y":164,"width":71,"height":22},{"text":"파일","x":1237,"y":163,"width":45,"height":26},{"text":"시스템구현","x":1292,"y":163,"width":124,"height":26},{"text":"621","x":1489,"y":161,"width":53,"height":30}]},{"text":"• 부트 제어 블록은 시스템이 그 파티션으로부터 운영체제를 부트시기는 데 필요한 정","words":[{"text":"•","x":330,"y":296,"width":14,"height":15},{"text":"부트","x":370,"y":288,"width":65,"height":37},{"text":"제어","x":448,"y":289,"width":58,"height":37},{"text":"블록은","x":526,"y":289,"width":83,"height":37},{"text":"시스템이","x":625,"y":289,"width":113,"height":37},{"text":"그","x":753,"y":295,"width":28,"height":25},{"text":"파티션으로부터","x":792,"y":290,"width":209,"height":38},{"text":"운영체제를","x":1017,"y":291,"width":159,"height":37},{"text":"부트시기는","x":1186,"y":291,"width":163,"height":37},{"text":"데","x":1362,"y":291,"width":28,"height":37},{"text":"필요한","x":1406,"y":291,"width":98,"height":37},{"text":"정","x":1517,"y":294,"width":27,"height":37}]},{"text":"보를 가지고 있다. 디스크가 운영체제를 가지고 있지 않다면 부트 제어 블록은 비어","words":[{"text":"보를","x":371,"y":351,"width":65,"height":34},{"text":"가지고","x":450,"y":350,"width":93,"height":37},{"text":"있다.","x":557,"y":350,"width":65,"height":36},{"text":"디스크가","x":638,"y":350,"width":116,"height":36},{"text":"운영체제를","x":765,"y":351,"width":150,"height":36},{"text":"가지고","x":929,"y":352,"width":91,"height":36},{"text":"있지","x":1035,"y":352,"width":56,"height":35},{"text":"않다면","x":1109,"y":352,"width":93,"height":36},{"text":"부트","x":1216,"y":352,"width":64,"height":36},{"text":"제어","x":1294,"y":352,"width":61,"height":36},{"text":"블록은","x":1371,"y":352,"width":98,"height":35},{"text":"비어","x":1484,"y":354,"width":60,"height":37}]},{"text":"있을 것이다. 부트 제어 블록은 일반적으로 한 파티션의 첫 번째 블록이다. UFS에서","words":[{"text":"있을","x":373,"y":410,"width":64,"height":36},{"text":"것이다.","x":450,"y":410,"width":98,"height":37},{"text":"부트","x":562,"y":410,"width":61,"height":36},{"text":"제어","x":634,"y":411,"width":55,"height":36},{"text":"블록은","x":703,"y":411,"width":89,"height":35},{"text":"일반적으로","x":804,"y":411,"width":148,"height":37},{"text":"한","x":964,"y":412,"width":31,"height":35},{"text":"파티션의","x":1006,"y":412,"width":121,"height":36},{"text":"첫","x":1144,"y":412,"width":29,"height":36},{"text":"번째","x":1187,"y":412,"width":59,"height":36},{"text":"블록이다.","x":1261,"y":412,"width":137,"height":36},{"text":"UFS에서","x":1411,"y":414,"width":133,"height":36}]},{"text":"는 부트 블록, NTFS에서는 파티션 부트 섹터라 불린다.","words":[{"text":"는","x":370,"y":471,"width":34,"height":34},{"text":"부트","x":416,"y":471,"width":63,"height":35},{"text":"블록,","x":490,"y":471,"width":70,"height":36},{"text":"NTFS에서는","x":572,"y":471,"width":177,"height":36},{"text":"파티션","x":760,"y":471,"width":87,"height":36},{"text":"부트","x":859,"y":472,"width":61,"height":35},{"text":"섹터라","x":931,"y":472,"width":92,"height":36},{"text":"불린다.","x":1034,"y":472,"width":101,"height":36}]},{"text":"• 볼륨 제어 블록은 볼륨의 블록의 수, 블록의 크기, 가용 블록의 수와 포인터, 그리고","words":[{"text":"•","x":331,"y":548,"width":14,"height":15},{"text":"볼륨","x":370,"y":540,"width":66,"height":36},{"text":"제어","x":450,"y":540,"width":59,"height":36},{"text":"블록은","x":524,"y":540,"width":93,"height":35},{"text":"볼륨의","x":629,"y":540,"width":86,"height":36},{"text":"블록의","x":730,"y":541,"width":86,"height":35},{"text":"수,","x":830,"y":542,"width":38,"height":36},{"text":"블록의","x":881,"y":541,"width":88,"height":36},{"text":"크기,","x":985,"y":542,"width":69,"height":37},{"text":"가용","x":1070,"y":543,"width":61,"height":36},{"text":"블록의","x":1143,"y":543,"width":93,"height":36},{"text":"수와","x":1252,"y":543,"width":66,"height":36},{"text":"포인터,","x":1330,"y":543,"width":105,"height":37},{"text":"그리고","x":1450,"y":543,"width":99,"height":36}]},{"text":"가용 FCB 수와 포인터 같은 볼륨 정보를 포함한다. UFS에서는 슈퍼블록, NTFS에","words":[{"text":"가용","x":372,"y":600,"width":64,"height":36},{"text":"FCB","x":448,"y":603,"width":67,"height":29},{"text":"수와","x":528,"y":600,"width":63,"height":36},{"text":"포인터","x":603,"y":600,"width":85,"height":36},{"text":"같은","x":705,"y":600,"width":58,"height":36},{"text":"볼륨","x":774,"y":601,"width":60,"height":35},{"text":"정보를","x":848,"y":601,"width":89,"height":35},{"text":"포함한다.","x":949,"y":602,"width":129,"height":37},{"text":"UFS에서는","x":1092,"y":603,"width":164,"height":37},{"text":"슈퍼블록,","x":1269,"y":603,"width":137,"height":38},{"text":"NTFS에","x":1419,"y":605,"width":127,"height":36}]},{"text":"서는 마스터 파일 테이%(master file table)이라 불린다.","words":[{"text":"서는","x":372,"y":660,"width":64,"height":36},{"text":"마스터","x":448,"y":659,"width":90,"height":36},{"text":"파일","x":553,"y":659,"width":60,"height":36},{"text":"테이%(master","x":627,"y":660,"width":202,"height":39},{"text":"file","x":841,"y":663,"width":47,"height":31},{"text":"table)이라","x":901,"y":663,"width":148,"height":38},{"text":"불린다.","x":1059,"y":664,"width":101,"height":36}]},{"text":"• 디렉터리 구조는 파일을 조직화하는 데 시용된다. UFS에서는, 디렉터리 구조에 파","words":[{"text":"•","x":331,"y":740,"width":14,"height":14},{"text":"디렉터리","x":373,"y":730,"width":123,"height":37},{"text":"구조는","x":513,"y":732,"width":94,"height":34},{"text":"파일을","x":621,"y":731,"width":91,"height":36},{"text":"조직화하는","x":725,"y":733,"width":150,"height":36},{"text":"데","x":889,"y":733,"width":26,"height":35},{"text":"시용된다.","x":932,"y":733,"width":128,"height":38},{"text":"UFS에서는,","x":1074,"y":736,"width":171,"height":38},{"text":"디렉터리","x":1262,"y":736,"width":124,"height":38},{"text":"구조에","x":1404,"y":737,"width":94,"height":36},{"text":"파","x":1515,"y":738,"width":33,"height":36}]},{"text":"일 이름 및 해당 inode 번호가 저장된다. NTFS에서는, 마스터 파일 테이블에 이러","words":[{"text":"일","x":373,"y":791,"width":27,"height":35},{"text":"이름","x":417,"y":790,"width":63,"height":37},{"text":"및","x":495,"y":790,"width":27,"height":36},{"text":"해당","x":537,"y":790,"width":62,"height":37},{"text":"inode","x":610,"y":794,"width":88,"height":30},{"text":"번호가","x":713,"y":792,"width":89,"hei