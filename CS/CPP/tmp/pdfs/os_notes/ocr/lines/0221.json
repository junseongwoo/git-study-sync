"width":66,"height":34},{"text":"RR","x":1532,"y":667,"width":52,"height":29}]},{"text":"스케줄링을 A卜\u0026하여 스케줄 할 수 있다.","words":[{"text":"스케줄링을","x":364,"y":723,"width":171,"height":36},{"text":"A卜\u0026하여","x":547,"y":724,"width":126,"height":36},{"text":"스케줄","x":688,"y":723,"width":95,"height":37},{"text":"할","x":794,"y":725,"width":32,"height":36},{"text":"수","x":836,"y":726,"width":31,"height":35},{"text":"있다.","x":880,"y":726,"width":67,"height":36}]},{"text":"• 다단계 큐 스게줄링은 프로세스를 우선순위에 따라 여러 개의 큐로 분할하고 스게줄","words":[{"text":"•","x":323,"y":806,"width":15,"height":15},{"text":"다단계","x":365,"y":793,"width":99,"height":38},{"text":"큐","x":478,"y":796,"width":34,"height":34},{"text":"스게줄링은","x":525,"y":794,"width":164,"height":37},{"text":"프로세스를","x":701,"y":797,"width":158,"height":36},{"text":"우선순위에","x":869,"y":797,"width":155,"height":38},{"text":"따라","x":1040,"y":799,"width":62,"height":36},{"text":"여러","x":1115,"y":799,"width":57,"height":37},{"text":"개의","x":1190,"y":799,"width":59,"height":37},{"text":"큐로","x":1264,"y":801,"width":65,"height":34},{"text":"분할하고","x":1340,"y":799,"width":132,"height":36},{"text":"스게줄","x":1484,"y":798,"width":100,"height":36}]},{"text":"러는 우선순위가 가장 높은 큐에서 프로세스를 실행한다. 큐마다 다른 스케줄링 알","words":[{"text":"러는","x":366,"y":855,"width":65,"height":36},{"text":"우선순위가","x":446,"y":854,"width":169,"height":38},{"text":"가장","x":629,"y":856,"width":65,"height":37},{"text":"높은","x":707,"y":857,"width":65,"height":35},{"text":"큐에서","x":785,"y":858,"width":90,"height":37},{"text":"프로세스를","x":893,"y":859,"width":158,"height":37},{"text":"실행한다.","x":1065,"y":860,"width":132,"height":36},{"text":"큐마다","x":1213,"y":860,"width":98,"height":36},{"text":"다른","x":1325,"y":860,"width":66,"height":36},{"text":"스케줄링","x":1404,"y":859,"width":128,"height":37},{"text":"알","x":1552,"y":859,"width":33,"height":36}]},{"text":"고리즘이 사용될 수 있다.","words":[{"text":"고리즘이","x":362,"y":915,"width":133,"height":37},{"text":"사용될","x":511,"y":916,"width":98,"height":36}