width":96,"height":35},{"text":"방법","x":1492,"y":1704,"width":61,"height":35}]},{"text":"이다. 사용자가 그들의 프로세스가 페이징 시스템에서 실행되고 있음-을 알게 해서는 안","words":[{"text":"이다.","x":298,"y":1756,"width":73,"height":35},{"text":"사용자가","x":388,"y":1757,"width":138,"height":35},{"text":"그들의","x":539,"y":1758,"width":96,"height":35},{"text":"프로세스가","x":653,"y":1760,"width":161,"height":35},{"text":"페이징","x":827,"y":1761,"width":89,"height":35},{"text":"시스템에서","x":934,"y":1761,"width":146,"height":36},{"text":"실행되고","x":1098,"y":1761,"width":120,"height":36},{"text":"있음-을","x":1233,"y":1762,"width":92,"height":35},{"text":"알게","x":1338,"y":1763,"width":59,"height":35},{"text":"해서는","x":1414,"y":1763,"width":97,"height":35},{"text":"안","x":1525,"y":1764,"width":32,"height":34}]},{"text":"된다. 페이징은 논리적으로 사용자에게는 투명해야 한다. 따라서 이 선택은 가장 좋은 선","words":[{"text":"된다.","x":298,"y":1816,"width":74,"height":35},{"text":"페이징은","x":388,"y":1816,"width":137,"height":36},{"text":"논리적으로","x":536,"y":1818,"width":165,"height":35},{"text":"사용자에게는","x":712,"y":1819,"width":191,"height":36},{"text":"투명해야","x":913,"y":1821,"width":123,"height":35},{"text":"한다.","x":1045,"y":1821,"width":67,"height":35},{"text":"따라서","x":1125,"y":1821,"width":88,"height":35},{"text":"이","x":1228,"y":1821,"width":26,"height":35},{"text":"선택은","x":1270,"y":1822,"width":93,"height":34},{"text":"가장","x":1374,"y":1822,"width":63,"height":35},{"text":"좋은","x":1448,"y":1823,"width":65,"height":35},{"text":"선","x":1525,"y":1823,"width":30,"height":33}]},{"text":"택은 아니다.","words":[{"text":"택은","x":300,"y":1876,"width":67,"height":35},{"text":"아니다.","x":379,"y":1876,"width":109,"height":36}]},{"text":"대신 운영체제는 표준 스와핑을 시용하여 프로세스를 스왑아웃 하여 모든 프레임을","words":[{"text":"대신","x":363,"y":1936,"width":67,"height":35},{"text":"운영체제는","x":445,"y":1937,"width":170,"height":36},{"text":"표준","x":628,"y":1941,"width":66,"height":32},{"text":"스와핑을","x":707,"y":1939,"width":126,"height":36},{"text":"시용하여","x":846,"y":1940,"width":119,"height":36},{"text":