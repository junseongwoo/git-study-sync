2,"y":1449,"width":99,"height":37},{"text":"사용하면","x":424,"y":1449,"width":132,"height":37},{"text":"데이터에","x":573,"y":1448,"width":125,"height":37},{"text":"액세스하려면","x":716,"y":1449,"width":189,"height":36},{"text":"두","x":918,"y":1452,"width":33,"height":34},{"text":"번의","x":966,"y":1449,"width":56,"height":37},{"text":"메모리","x":1039,"y":1449,"width":89,"height":36},{"text":"액세스가","x":1145,"y":1449,"width":126,"height":37},{"text":"필요하다(한","x":1284,"y":1450,"width":174,"height":39},{"text":"번은","x":1472,"y":1450,"width":66,"height":35}]},{"text":"페이지 테이블 항목과 한 번은 실제 데이터). 따라서 메모리 접근 시간은 2배로 느려지고","words":[{"text":"페이지","x":265,"y":1511,"width":94,"height":36},{"text":"테이블","x":376,"y":1511,"width":100,"height":36},{"text":"항목과","x":488,"y":1511,"width":99,"height":36},{"text":"한","x":597,"y":1511,"width":35,"height":35},{"text":"번은","x":645,"y":1511,"width":63,"height":35},{"text":"실제","x":720,"y":1510,"width":59,"height":36},{"text":"데이터).","x":795,"y":1511,"width":113,"height":39},{"text":"따라서","x":922,"y":1510,"width":89,"height":37},{"text":"메모리","x":1027,"y":1510,"width":89,"height":37},{"text":"접근","x":1132,"y":1510,"width":60,"height":36},{"text":"시간은","x":1203,"y":1511,"width":95,"height":36},{"text":"2배로","x":1308,"y":1512,"width":83,"height":36},{"text":"느려지고","x":1403,"y":1512,"width":133,"height":36}]},{"text":"이는 대부콮의 상황에서 허용할 수 없는 지연 시간이다.","words":[{"text":"이는","x":266,"y":1573,"width":64,"height":35},{"text":"대부콮의","x":343,"y":1572,"width":128,"height":36},{"text":"상황에서","x":486,"y":1573,"width":129,"height":36},{"text":"허용할","x":632,"y":1571,"width":96,"height":37},{"text":"수","x":739,"y":1572,"width":33,"height":36},{"text":"없는","x":785,"y":1572,"width":62,"height":36},{"text":"지연","x":859,"y":1571,"width":61,"height":37},{"text":"시간이다.","x":933,"y":1571,"width":130,"height":37}]},{"text":"이 문제에 대한 해결에는 TLB (translation look-aside buffers)라고 불리는","words":[{"text":"이","x":327,"y":1633,"width":27,"height":36},{"text":"문제에","x":375,"y":1634,"width":99,"height":36},{"text":"대한","x":496,"y":1634,"width":66,"height":36},{"text":"해결에는","x":580,"y":1634,"width":131,"height":37},{"text":"TLB","x":727,"y":1637,"width":71,"height":28},{"text":"(translation","x":815,"y":1637,"width":195,"height":32},{"text":"look-aside","x":1024,"y":1636,"width":175,"height":30},{"text":"buffers)라고","x":1214,"y":1635,"width":204,"height":36},{"text":"불리는","x":1434,"y":1635,"width":104,"height":36}]},{"text":"특수한 소형 하드웨어 개시가 사용된다. TLB는 매우 빠른 연관 메모리(associative","words":[{"text":"특수한","x":264,"y":1694,"width":101,"height":37},{"text":"소형","x":381,"y":1694,"width":63,"height":36},{"text":"하드웨어","x":466,"y":1696,"width":130,"height":36},{"text":"개시가","x":619,"y":1695,"width":99,"height":38},{"text":"사용된다.","x":733,"y":1695,"width":136,"height":37},{"text":"TLB는","x":887,"y":1698,"width":101,"height":33},{"text":"매우","x":1004,"y":1696,"width":62,"height":36},{"text":"빠른","x":1082,"y":1696,"width":63,"height":36},{"text":"연관","x":1162,"y":1696,"width":62,"height":36},{"text":"메모리(associative","x":1240,"y":1697,"width":298,"height":40}]},{"text":"memory)로 구성된다. TLB 내의 각 항목은 카(key)와 값(value)의 두 부분으로 구성","words":[{"text":"memory)로","x":264,"y":1759,"width":190,"height":39},{"text":"구성된다.","x":467,"y":1757,"width":140,"height":37},{"text":"TLB","x":622,"y":1761,"width":69,"height":29},{"text":"내의","x":707,"y":1758,"width":59,"height":36},{"text":"각","x":784,"y":1757,"width":32,"height":37},{"text":"항목은","x":828,"y":1758,"width":95,"height":36},{"text":"카(key)와","x":937,"y":1758,"width":143,"height":42},{"text":"값(value)의","x":1093,"y":1758,"width":170,"height":40},{"text":"두","x":1280,"y":1761,"width":32,"height":35},{"text":"부분으로","x":1325,"y":1760,"width":131,"height":36},{"text":"구성","x":1469,"y":1760,"width":65,"height":36}]},{"text":"된다. TLB에 페이지를 찾아달라고 요청이 들어오면 이 찾고자 하는 페이지를 동시에 여","words":[{"text":"된다.","x":266,"y":1818,"width":71,"height":36},{"text":"TLB에","x":351,"y":1818,"width":101,"height":36},{"text":"페이지를","x":470,"y":1818,"width":132,"height":38},{"text":"찾아달라고","x":614,"y":1819,"width":161,"height":37},{"text":"요청이","x":786,"y":1819,"width":92,"height":37},{"text":"들어오면","x":892,"y":1819,"width":124,"height":37},{"text":"이","x":1031,"y":1820,"width":27,"height":36},{"text":"찾고자","x":1072,"y":1819,"width":93,"height":37},{"text":"하는","x":1177,"y":1820,"width":63,"height":36},{"text":"페이지를","x":1252,"y":1821,"width":128,"height":36},{"text":"동시에","x":1391,"y":1821,"width":97,"height":35},{"text":"여","x":1505,"y":1821,"width":29,"height":36}]},{"text":"러 개의 내부 기(페이지 번호)와 비교한다. 페이지 번호가 같은 것이 발견되면 그에 대","words":[{"text":"러","x":267,"y":1880,"width":27,"height":36},{"text":"개의","x":314,"y":1879,"width":61,"height":36},{"text":"내부","x":395,"y":1879,"width":65,"height":36},{"text":"기(페이지","x":478,"y":1880,"width":138,"height":39},{"text":"번호)와","x":638,"y":1881,"width":108,"height":39},{"text":"비교한다.","x":761,"y":1881,"width":131,"height":37},{"text":"페이지","x":909,"y":1881,"width":90,"height":37},{"text":"번호가","x":1018,"y":1881,"width":92,"height":36},{"text":"같은","x":1123,"y":1881,"width":63,"height":36},{"text":"것이","x":1201,"y":1881,"width":58,"height":37},{"text":"발견되면","x":1278,"y":1882,"width":128,"height":36},{"text":"그에","x":1422,"y":1882,"width":64,"height":36},{"text":"대","x":1504,"y":1882,"width":30,"height":36}]},{"text":"응하는 프레임 번호를 알려준다. 검색의 속도는 빠르고 현대 하드웨어에서의 TLB 검색","words":[{"text":"응하는","x":265,"y":1940,"width":100,"height":37},{"text":"프레임","x":378,"y":1940,"width":95,"height":36},{"text":"번호를","x":493,"y":1941,"width":98,"height":35},{"text":"알려준다.","x":605,"y":1942,"width":135,"height":36},{"text":"검색의","x":757,"y":1942,"width":90,"height":37},{"text":"속도는","x":862,"y":1943,"width":95,"height":35},{"text":"빠르고","x":969,"y":1943,"width":93,"height":36},{"text":"현대","x":1075,"y":1942,"width":59,"height":36},{"text":"하드웨어에서의","x":1150,"y":1943,"width":220,"height":37},{"text":"TLB","x":1385,"y":1947,"width":70,"height":28},{"text":"검색","x":1472,"y":1943,"width":62,"height":37}]},{"text":"은 명령어 파이프라인의 일부로 동작하며 성능에 추가적인 손해를 끼치지 않는다. 그러","words":[{"text":"은","x":265,"y":2003,"width":33,"height":34},{"text":"명령어","x":313,"y":2001,"width":94,"height":37},{"text":"파이프라인의","x":425,"y":2001,"width":195,"height":38},{"text":"일부로","x":640,"y":2003,"width":94,"height":36},{"text":"동작하며","x":746,"y":2004,"width":124,"height":36},{"text":"성능에","x":888,"y":2004,"width":89,"height":36},{"text":"추가적인","x":992,"y":2004,"width":123,"height":36},{"text":"손해를","x":1129,"y":2004,"width":95,"height":36},{"text":"끼치지","x":1238,"y":2004,"width":93,"height":38},{"text":"않는다.","x":1349,"y":2005,"width":105,"height":36},{"text":"그러","x":1470,"y":2005,"width":64,"height":35}]},{"text":"나 파이프라인 단계 동안 검색을 하기 위해서는 TLB의 크기는 작게 유지할 수밖에 없으","words":[{"text":"나","x":266,"y":2063,"width":33,"height":37},{"text":"파이프라인","x":310,"y":2062,"width":165,"height":37},{"text":"단계","x":488,"y":2062,"width":63,"height":37},{"text":"동안","x":566,"y":2064,"width":66,"height":35},{"text":"검색을","x":645,"y":2064,"width":95,"height":36},{"text":"하기","x":752,"y":2065,"width":58,"height":37},{"text":"위해서는","x":827,"y":2065,"width":124,"height":37},{"text":"TLB의","x":961,"y":2065,"width":94,"height":37},{"text":"크기는","x":1069,"y":2065,"width":95,"height":36},{"text":"작게","x":1175,"y":2065,"width":60,"height":37},{"text":"유지할","x":1250,"y":2066,"width":99,"height":37},{"text":"수밖에","x":1358,"y":2065,"width":97,"height":37},{"text":"없으","x":1473,"y":2065,"width":65,"height":36}]},{"text":"며 통상 32개에서 1,024개의 항목을 유지한다. 몇몇 CPU는 명령어와 데이터의 주소를","words":[{"text":"며","x":267,"y":2125,"width":26,"height":36},{"text":"통상","x":311,"y":2124,"width":67,"height":36},{"text":"32개에서","x":390,"y":2124,"width":134,"height":36},{"text":"1,024개의","x":543,"y":2125,"width":145,"height":35},{"text":"항목을","x":705,"y":2126,"width":95,"height":36},{"text":"유지한다.","x":812,"y":2126,"width":131,"height":37},{"text":"몇몇","x":960,"y":2126,"width":58,"height":37},{"text":"CPU는","x":1032,"y":2128,"width":107,"height":34},{"text":"명령어와","x":1154,"y":2126,"width":127,"height":38},{"text":"데이터의","x":1294,"y":2127,"width":126,"height":37},{"text":"주소를","x":1436,"y":2127,"width":102,"height":36}]},{"text":"저장하기 위한 개별적인 TLB를 구현하기도 한다. 이렇게 하면 파이프라인의 다른 단계","words":[{"text":"저장하기","x":266,"y":2185,"width":126,"height":37},{"text":"위한","x":412,"y":2185,"width":66,"height":36},{"text":"개별적인","x":492,"y":2185,"width":129,"height":36},{"text":"TLB를","x":635,"y":2187,"width":101,"height":34},{"text":"구현하기도","x":748,"y":2187,"width":157,"height":37},{"text":"한다.","x":917,"y":2187,"width":69,"height":36},{"text":"이렇게","x":1002,"y":2187,"width":89,"height":37},{"text":"하면","x":1107,"y":2187,"width":62,"height":37},{"text":"파이프라인의","x":1183,"y":2188,"width":191,"height":36},{"text":"다른","x":1392,"y":2188,"width":66,"height":36},{"text":"단계","x":1470,"y":2187,"width":65,"height":36}]},{"text":"에서 TLB를 접근하게 되므로 TLB 항목의 개수를 두 배로 늘릴 수 있다. 이러한 발전을","words":[{"text":"에서","x":266,"y":2247,"width":60,"height":36},{"text":"TLB를","x":342,"y":2248,"width":105,"height":34},{"text":"접근하게","x":461,"y":2246,"width":127,"height":36},{"text":"되므로","x":605,"y":2247,"width":96,"height":35},{"text":"TLB","x":712,"y":2250,"width":67,"height":28},{"text":"항목의","x":792,"y":2248,"width":90,"height":36},{"text":"개수를","x":898,"y":2248,"width":92,"height":36},{"text":"두","x":1001,"y":2250,"width":31,"height":34},{"text":"배로","x":1045,"y":2248,"width":62,"height":35},{"text":"늘릴","x":1119,"y":2249,"width":62,"height":35},{"text":"수","x":1195,"y":2250,"width":32,"height":35},{"text":"있다.","x":1242,"y":2249,"width":69,"height":36},{"text":"이러한","x":1328,"y":2249,"width":98,"height":36},{"text":"발전을","x":1438,"y":2247,"width":101,"height":36}]},{"text":"살펴보면 CPU 기술 발달의 예를 볼 수 있다. TLB가 없는 시스템에서 여러 층의 개시를","words":[{"text":"살펴보면","x":263,"y":2307,"width":132,"height":37},{"text":"CPU","x":408,"y":2310,"width":79,"height":29},{"text":"기술","x":502,"y":2306,"width":65,"height":38},{"text":"발달의","x":579,"y":2307,"width":93,"height":36},{"text":"예를","x":689,"y":2307,"width":62,"height":36},{"text":"볼","x":762,"y":2307,"width":32,"height":36},{"text":"수","x":804,"y":2309,"width":32,"height":35},{"text":"있다.","x":849,"y":2308,"width":66,"height":36},{"text":"TLB가","x":928,"y":2308,"width":98,"height":36},{"text":"없는","x":1038,"y":2308,"width":61,"height":36},{"text":"시스템에서","x":1111,"y":2309,"width":156,"height":37},{"text":"여러","x":1285,"y":2310,"width":59,"height":36},{"text":"층의","x":1360,"y":2310,"width":62,"height":36},{"text":"개시를","x":1438,"y":2309,"width":100,"height":36}]},{"text":"가지고 있는 것처럼 여러 층의 TLB를 가진 시스템으로 발전한 것을 알 수 있다.","words":[{"text":"가지고","x":264,"y":2368,"width":98,"height":37},{"text":"있는","x":377,"y":2368,"width":65,"height":35},{"text":"것처럼","x":455,"y":2367,"width":93,"height":36},{"text":"여러","x":566,"y":2367,"width":59,"height":36},{"text":"층의","x":641,"y":2368,"width":60,"height":35},{"text":"TLB를","x":715,"y":2370,"width":99,"height":33},{"text":"가진","x":825,"y":2368,"width":59,"height":36},{"text":"시스템으로","x":897,"y":2368,"width":155,"height":36},{"text":"발전한","x":1064,"y":2369,"width":96,"height":35},{"text":"것을","x":1172,"y":2370,"width":63,"height":36},{"text":"알","x":1247,"y":2371,"width":32,"height":35},{"text":"수","x":1289,"y":2371,"width":34,"height":36},{"text":"있다.","x":1336,"y":2371,"width":70,"height":35}]},{"text":"페이지 테이블과 함께 다음과 같이 A卜우된다. TLB는 페이지 테이블의 일부분만을","words":[{"text":"페이지","x":326,"y":2428,"width":94,"height":36},{"text":"테이블과","x":441,"y":2427,"width":132,"height":36},{"text":"함께","x":587,"y":2427,"width":63,"height":36},{"text":"다음과","x":668,"y":2427,"width":95,"height":36},{"text":"같이","x":777,"y":2428,"width":58,"height":36},{"text":"A卜우된다.","x":853,"y":2428,"width":131,"height":37},{"text":"TLB는","x":1000,"y":2432,"width":100,"height":33},{"text":"페이지","x":1115,"y":2430,"width":91,"height":37},{"text":"테이블의","x":1226,"y":2432,"width":126,"height":36},{"text":"일부분만을","x":1373,"y":2431,"width":165,"height":36}]}]}