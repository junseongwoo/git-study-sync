{"page":232,"width":1656,"height":2507,"text_angle":0,"lines":[{"text":"288","words":[{"text":"288","x":166,"y":136,"width":57,"height":27}]},{"text":"6.3","words":[{"text":"6.3","x":173,"y":1900,"width":86,"height":36}]},{"text":"Chapter 6 동기화 도구들","words":[{"text":"Chapter","x":293,"y":137,"width":117,"height":28},{"text":"6","x":423,"y":139,"width":21,"height":21},{"text":"동기화","x":472,"y":140,"width":62,"height":25},{"text":"도구들","x":543,"y":141,"width":62,"height":24}]},{"text":"이다.","words":[{"text":"이다.","x":296,"y":258,"width":68,"height":34}]},{"text":"단일 코어 환경에서는 공유 변수를 수정히는 동안 인터럽트가 발생히는 것을 막을","words":[{"text":"단일","x":353,"y":315,"width":58,"height":35},{"text":"코어","x":428,"y":317,"width":57,"height":33},{"text":"환경에서는","x":502,"y":316,"width":148,"height":35},{"text":"공유","x":663,"y":316,"width":59,"height":34},{"text":"변수를","x":736,"y":316,"width":86,"height":33},{"text":"수정히는","x":835,"y":315,"width":119,"height":35},{"text":"동안","x":967,"y":316,"width":60,"height":35},{"text":"인터럽트가","x":1042,"y":316,"width":154,"height":35},{"text":"발생히는","x":1211,"y":315,"width":127,"height":35},{"text":"것을","x":1356,"y":313,"width":62,"height":35},{"text":"막을","x":1433,"y":313,"width":62,"height":35}]},{"text":"수 있다면 임계구역 문제는 간단히 해결될 수 있다. 이렇게 하면 현재 실행 중인 명령어","words":[{"text":"수","x":293,"y":373,"width":31,"height":33},{"text":"있다면","x":339,"y":371,"width":89,"height":35},{"text":"임계구역","x":444,"y":373,"width":113,"height":35},{"text":"문제는","x":572,"y":373,"width":89,"height":34},{"text":"간단히","x":674,"y":372,"width":83,"height":34},{"text":"해결될","x":772,"y":372,"width":84,"height":35},{"text":"수","x":870,"y":372,"width":30,"height":35},{"text":"있다.","x":913,"y":371,"width":63,"height":36},{"text":"이렇게","x":992,"y":373,"width":87,"height":34},{"text":"하면","x":1095,"y":373,"width":59,"height":34},{"text":"현재","x":1170,"y":373,"width":59,"height":34},{"text":"실행","x":1246,"y":372,"width":60,"height":34},{"text":"중인","x":1322,"y":370,"width":63,"height":36},{"text":"명령어","x":1402,"y":370,"width":89,"height":36}]},{"text":"들을 선점 없이 순서대로 실행될 수 있다는 것을 확신할 수 있다. 다른 명령어는 실행되","words":[{"text":"들을","x":292,"y":429,"width":63,"height":34},{"text":"선점","x":368,"y":430,"width":57,"height":33},{"text":"없이","x":443,"y":430,"width":55,"height":34},{"text":"순서대로","x":512,"y":430,"width":119,"height":34},{"text":"실행될","x":644,"y":429,"width":84,"height":35},{"text":"수","x":742,"y":430,"width":29,"height":34},{"text":"있다는","x":784,"y":429,"width":86,"height":35},{"text":"것을","x":884,"y":429,"width":56,"height":35},{"text":"확신할","x":952,"y":429,"width":90,"height":34},{"text":"수","x":1053,"y":429,"width":31,"height":34},{"text":"있다.","x":1099,"y":429,"width":66,"height":35},{"text":"다른","x":1181,"y":430,"width":63,"height":34},{"text":"명령어는","x":1259,"y":428,"width":127,"height":36},{"text":"실행되","x":1401,"y":428,"width":90,"height":36}]},{"text":"지 않으므로 공유 변수를 예기치 않게 수정되지 않는다.","words":[{"text":"지","x":294,"y":486,"width":25,"height":34},{"text":"않으므로","x":334,"y":486,"width":122,"height":35},{"text":"공유","x":467,"y":488,"width":60,"height":33},{"text":"변수를","x":539,"y":487,"width":87,"height":34},{"text":"예기치","x":637,"y":486,"width":83,"height":34},{"text":"않게","x":735,"y":486,"width":55,"height":35},{"text":"수정되지","x":802,"y":486,"width":114,"height":35},{"text":"않는다.","x":930,"y":486,"width":94,"height":35}]},{"text":"불행히도 이 해결책은 다중 처리기 환경에서 실현할 수 있지 않다. 메시지가 모든 프","words":[{"text":"불행히도","x":350,"y":543,"width":121,"height":35},{"text":"이","x":483,"y":544,"width":26,"height":34},{"text":"해결책은","x":523,"y":544,"width":118,"height":34},{"text":"다중","x":652,"y":544,"width":58,"height":34},{"text":"처리기","x":722,"y":544,"width":81,"height":35},{"text":"환경에서","x":818,"y":544,"width":113,"height":35},{"text":"실현할","x":947,"y":543,"width":88,"height":34},{"text":"수","x":1045,"y":543,"width":31,"height":34},{"text":"있지","x":1089,"y":544,"width":56,"height":34},{"text":"않다.","x":1162,"y":544,"width":68,"height":35},{"text":"메시지가","x":1245,"y":542,"width":131,"height":36},{"text":"모든","x":1386,"y":545,"width":65,"height":32},{"text":"프","x":1462,"y":548,"width":31,"height":26}]},{"text":"로세서에 전달되므로 다중 처리기에서 인터럽트를 비활성화하면 시간이 많이 걸릴 수","words":[{"text":"로세서에","x":291,"y":601,"width":121,"height":34},{"text":"전달되므로","x":432,"y":601,"width":147,"height":34},{"text":"다중","x":593,"y":601,"width":59,"height":35},{"text":"처리기에서","x":668,"y":601,"width":140,"height":36},{"text":"인터럽트를","x":828,"y":601,"width":146,"height":35},{"text":"비활성화하면","x":989,"y":600,"width":182,"height":35},{"text":"시간이","x":1189,"y":601,"width":91,"height":34},{"text":"많이","x":1301,"y":600,"width":61,"height":35},{"text":"걸릴","x":1384,"y":601,"width":60,"height":34},{"text":"수","x":1461,"y":602,"width":32,"height":35}]},{"text":"있다. 이 메시지 전달은 각 임계구역으로의 진입을 지연시기고 시스템 효율성을 떨어뜨","words":[{"text":"있다.","x":293,"y":658,"width":66,"height":35},{"text":"이","x":376,"y":658,"width":26,"height":35},{"text":"메시지","x":417,"y":659,"width":87,"height":34},{"text":"전달은","x":522,"y":659,"width":87,"height":35},{"text":"각","x":621,"y":658,"width":30,"height":36},{"text":"임계구역으로의","x":664,"y":658,"width":199,"height":36},{"text":"진입을","x":880,"y":659,"width":87,"height":34},{"text":"지연시기고","x":981,"y":658,"width":150,"height":35},{"text":"시스템","x":1145,"y":659,"width":91,"height":34},{"text":"효율성을","x":1253,"y":658,"width":131,"height":35},{"text":"떨어뜨","x":1398,"y":659,"width":94,"height":35}]},{"text":"린다. 또한 클록이 인터럽트로 업데이트되는 경우 시스템 클록에 미치는 영향도 고려해","words":[{"text":"린다.","x":294,"y":716,"width":66,"height":34},{"text":"또한","x":374,"y":717,"width":62,"height":33},{"text":"클록이","x":448,"y":717,"width":85,"height":34},{"text":"인터럽트로","x":550,"y":717,"width":145,"height":34},{"text":"업데이트되는","x":710,"y":717,"width":174,"height":35},{"text":"경우","x":897,"y":717,"width":57,"height":35},{"text":"시스템","x":968,"y":716,"width":85,"height":35},{"text":"클록에","x":1069,"y":717,"width":90,"height":34},{"text":"미치는","x":1177,"y":717,"width":95,"height":35},{"text":"영향도","x":1287,"y":716,"width":96,"height":35},{"text":"고려해","x":1397,"y":717,"width":93,"height":36}]},{"text":"야 한다.","words":[{"text":"야","x":291,"y":774,"width":32,"height":34},{"text":"한다.","x":333,"y":774,"width":67,"height":34}]},{"text":"운영체제 내에서 임계구역을 다루기 위해서 선점형 커널과 비선점형 커널의 두 가","words":[{"text":"운영체제","x":348,"y":832,"width":118,"height":35},{"text":"내에서","x":483,"y":832,"width":85,"height":35},{"text":"임계구역을","x":586,"y":832,"width":145,"height":35},{"text":"다루기","x":745,"y":833,"width":83,"height":35},{"text":"위해서","x":847,"y":833,"width":83,"height":35},{"text":"선점형","x":948,"y":832,"width":85,"height":35},{"text":"커널과","x":1052,"y":833,"width":92,"height":34},{"text":"비선점형","x":1159,"y":833,"width":123,"height":35},{"text":"커널의","x":1302,"y":833,"width":94,"height":36},{"text":"두","x":1414,"y":836,"width":33,"height":33},{"text":"가","x":1462,"y":835,"width":31,"height":36}]},{"text":"지 일반적인 접근법이 A卜\u0026된다. 선점형 커널은 프로세스가 커널 모드에서 수행되는 동","words":[{"text":"지","x":293,"y":890,"width":25,"height":35},{"text":"일반적인","x":336,"y":890,"width":119,"height":35},{"text":"접근법이","x":470,"y":889,"width":112,"height":36},{"text":"A卜\u0026된다.","x":597,"y":890,"width":124,"height":35},{"text":"선점형","x":737,"y":891,"width":82,"height":35},{"text":"커널은","x":837,"y":891,"width":87,"height":35},{"text":"프로세스가","x":936,"y":891,"width":151,"height":35},{"text":"커널","x":1101,"y":891,"width":58,"height":35},{"text":"모드에서","x":1174,"y":891,"width":125,"height":35},{"text":"수행되는","x":1317,"y":892,"width":131,"height":36},{"text":"동","x":1461,"y":895,"width":32,"height":33}]},{"text":"안 선점되는 것을 허용한대 비선점형 커널은 커널 모드에서 수행되는 프로세스의 선점","words":[{"text":"안","x":291,"y":947,"width":32,"height":35},{"text":"선점되는","x":336,"y":948,"width":120,"height":35},{"text":"것을","x":469,"y":948,"width":58,"height":35},{"text":"허용한대","x":540,"y":948,"width":122,"height":36},{"text":"비선점형","x":678,"y":948,"width":112,"height":36},{"text":"커널은","x":808,"y":949,"width":87,"height":35},{"text":"커널","x":908,"y":950,"width":55,"height":35},{"text":"모드에서","x":978,"y":949,"width":117,"height":35},{"text":"수행되는","x":1112,"y":950,"width":127,"height":35},{"text":"프로세스의","x":1252,"y":950,"width":160,"height":36},{"text":"선점","x":1430,"y":951,"width":58,"height":35}]},{"text":"을 허용하지 않고 커널 모드 프로세스는 커널을 빠져나갈 때까지 또는 봉쇄될 때까지 또","words":[{"text":"을","x":290,"y":1006,"width":32,"height":34},{"text":"허용하지","x":334,"y":1006,"width":116,"height":36},{"text":"않고","x":466,"y":1007,"width":58,"height":35},{"text":"커널","x":536,"y":1007,"width":55,"height":35},{"text":"모드","x":604,"y":1010,"width":59,"height":26},{"text":"프로세스는","x":674,"y":1007,"width":147,"height":35},{"text":"커널을","x":833,"y":1008,"width":87,"height":35},{"text":"빠져나갈","x":931,"y":1008,"width":120,"height":35},{"text":"때까지","x":1063,"y":1008,"width":88,"height":35},{"text":"또는","x":1166,"y":1010,"width":65,"height":32},{"text":"봉쇄될","x":1241,"y":1008,"width":97,"height":35},{"text":"때까지","x":1353,"y":1009,"width":92,"height":36},{"text":"또","x":1461,"y":1014,"width":31,"height":25}]},{"text":"는 자발적으로 CPU의 제어를 양보할 때까지 계속 수행된다.","words":[{"text":"는","x":290,"y":1066,"width":33,"height":32},{"text":"자발적으로","x":333,"y":1064,"width":150,"height":35},{"text":"CPU의","x":492,"y":1065,"width":98,"height":35},{"text":"제어를","x":605,"y":1065,"width":87,"height":35},{"text":"양보할","x":702,"y":1065,"width":88,"height":35},{"text":"때까지","x":801,"y":1066,"width":83,"height":35},{"text":"계속","x":899,"y":1067,"width":59,"height":34},{"text":"수행된다.","x":968,"y":1066,"width":128,"height":35}]},{"text":"분명히 비선점형 커널은 한순간에 커널 안에서 실행 중인 프로세스는 하나밖에 없","words":[{"text":"분명히","x":348,"y":1123,"width":87,"height":35},{"text":"비선점형","x":454,"y":1123,"width":113,"height":36},{"text":"커널은","x":584,"y":1124,"width":88,"height":34},{"text":"한순간에","x":684,"y":1123,"width":116,"height":36},{"text":"커널","x":817,"y":1124,"width":55,"height":34},{"text":"안에서","x":889,"y":1125,"width":84,"height":34},{"text":"실행","x":992,"y":1124,"width":56,"height":35},{"tex