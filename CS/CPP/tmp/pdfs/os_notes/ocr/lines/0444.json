}]},{"text":"있는 유효한 데이터를 과잉 공급 공간에 기록하고, 유효하지 않은 데이터만 기록된 블록","words":[{"text":"있는","x":289,"y":587,"width":65,"height":35},{"text":"유효한","x":367,"y":587,"width":99,"height":35},{"text":"데이터를","x":479,"y":587,"width":124,"height":35},{"text":"과잉","x":616,"y":587,"width":56,"height":35},{"text":"공급","x":688,"y":588,"width":59,"height":34},{"text":"공간에","x":759,"y":587,"width":87,"height":36},{"text":"기록하고,","x":862,"y":587,"width":127,"height":37},{"text":"유효하지","x":1001,"y":588,"width":119,"height":36},{"text":"않은","x":1137,"y":588,"width":63,"height":36},{"text":"데이터만","x":1213,"y":589,"width":130,"height":36},{"text":"기록된","x":1356,"y":590,"width":94,"height":36},{"text":"블록","x":1464,"y":590,"width":66,"height":35}]},{"text":"을 지우고, 해당 블록을 과잉 공급 공간에 배文1할 수도 있다는 것을 의미한다. 요약하면,","words":[{"text":"을","x":287,"y":647,"width":34,"height":34},{"text":"지우고,","x":336,"y":647,"width":104,"height":35},{"text":"해당","x":456,"y":646,"width":64,"height":36},{"text":"블록을","x":531,"y":647,"width":95,"height":35},{"text":"과잉","x":637,"y":646,"width":57,"height":36},{"text":"공급","x":709,"y":648,"width":61,"height":34},{"text":"공간에","x":781,"y":647,"width":87,"height":35},{"text":"배文1할","x":884,"y":647,"width":89,"height":35},{"text":"수도","x":984,"y":648,"width":62,"height":35},{"text":"있다는","x":1060,"y":648,"width":91,"height":36},{"text":"것을","x":1165,"y":648,"width":62,"height":36},{"text":"의미한다.","x":1241,"y":649,"width":134,"height":36},{"text":"요약하면,","x":1391,"y":650,"width":138,"height":37}]},{"text":"하나의 쓰기 요청으로 인해 결국 페이지 쓰기(데이터), 하나 이상의 페이지 읽기(가비지","words":[{"text":"하나의","x":288,"y":706,"width":96,"height":36},{"text":"쓰기","x":402,"y":706,"width":60,"height":36},{"text":"요청으로","x":480,"y":706,"width":126,"height":36},{"text":"인해","x":621,"y":706,"width":57,"height":36},{"text":"결국","x":694,"y":706,"width":58,"height":36},{"text":"페이지","x":766,"y":707,"width":85,"height":36},{"text":"쓰기(데이터),","x":867,"y":707,"width":181,"height":39},{"text":"하나","x":1062,"y":709,"width":6