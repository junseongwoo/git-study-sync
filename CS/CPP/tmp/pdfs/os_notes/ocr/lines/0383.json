{"page":383,"width":1745,"height":2638,"text_angle":0,"lines":[{"text":"10.4 메이지가 443","words":[{"text":"10.4","x":1208,"y":156,"width":72,"height":22},{"text":"메이지가","x":1296,"y":155,"width":122,"height":28},{"text":"443","x":1489,"y":152,"width":60,"height":29}]},{"text":"감소시길 수 있다. 각 페이지나 프레임은 그것과 관련된 변경 비트를 하드웨어에 가지","words":[{"text":"감소시길","x":296,"y":276,"width":130,"height":38},{"text":"수","x":445,"y":279,"width":32,"height":36},{"text":"있다.","x":495,"y":280,"width":69,"height":35},{"text":"각","x":584,"y":281,"width":30,"height":35},{"text":"페이지나","x":630,"y":280,"width":121,"height":37},{"text":"프레임은","x":766,"y":281,"width":121,"height":36},{"text":"그것과","x":902,"y":281,"width":93,"height":36},{"text":"관련된","x":1009,"y":281,"width":92,"height":36},{"text":"변경","x":1119,"y":281,"width":57,"height":37},{"text":"비트를","x":1198,"y":282,"width":94,"height":36},{"text":"하드웨어에","x":1307,"y":282,"width":159,"height":38},{"text":"가지","x":1485,"y":284,"width":61,"height":37}]},{"text":"게 된다. 변경 비트는 CPU가 페이지 내의 어떤 바이트라도 쓰게 되면 페이지가 변경되","words":[{"text":"게","x":297,"y":336,"width":28,"height":37},{"text":"된다.","x":343,"y":338,"width":72,"height":35},{"text":"변경","x":435,"y":339,"width":59,"height":35},{"text":"비트는","x":513,"y":339,"width":94,"height":36},{"text":"CPU가","x":619,"y":341,"width":107,"height":35},{"text":"페이지","x":739,"y":341,"width":85,"height":36},{"text":"내의","x":842,"y":341,"width":56,"height":37},{"text":"어떤","x":915,"y":341,"width":60,"height":36},{"text":"바이트라도","x":989,"y":341,"width":155,"height":37},{"text":"쓰게","x":1157,"y":342,"width":60,"height":35},{"text":"되면","x":1234,"y":343,"width":61,"height":35},{"text":"페이지가","x":1312,"y":343,"width":128,"height":37},{"text":"변경되","x":1454,"y":344,"width":92,"height":37}]},{"text":"있음을 나타내기 위해 설정된다. 희생시길 페이지가 선정되면 변경 비트를 확인한다. 변","words":[{"text":"있음을","x":297,"y":396,"width":99,"height":36},{"text":"나타내기","x":411,"y":398,"width":125,"height":36},{"text":"위해","x":555,"y":399,"width":60,"height":36},{"text":"설정된다.","x":630,"y":400,"width":130,"height":36},{"text":"희생시길","x":776,"y":401,"width":117,"height":36},{"text":"페이지가","x":909,"y":400,"width":123,"height":37},{"text":"선정되면","x":1045,"y":401,"width":122,"height":37},{"text":"변경","x":1182,"y":401,"width":57,"height":37},{"text":"비트를","x":1258,"y":402,"width":95,"height":36},{"text":"확인한다.","x":1366,"y":403,"width":136,"height":36},{"text":"변","x":1520,"y":404,"width":28,"height":35}]},{"text":"경 비트(modify bit)가 설정되이 있으면 페이지 내용이 원래 보조저장장치상의 그 페이","words":[{"text":"경","x":297,"y":456,"width":28,"height":36},{"text":"비트(modify","x":344,"y":457,"width":198,"height":42},{"text":"bit)가","x":554,"y":459,"width":88,"height":37},{"text":"설정되이","x":656,"y":460,"width":118,"height":36},{"text":"있으면","x":791,"y":460,"width":87,"height":36},{"text":"페이지","x":892,"y":460,"width":87,"height":37},{"text":"내용이","x":995,"y":461,"width":88,"height":36},{"text":"원래","x":1099,"y":461,"width":57,"height":36},{"text":"보조저장장치상의","x":1171,"y":462,"width":254,"height":36},{"text":"그","x":1440,"y":467,"width":32,"height":25},{"text":"페이","x":1485,"y":463,"width":61,"height":37}]},{"text":"지 내용과 달라졌다는 것을 알 수 있다. 이 경우 현재 내용을 보조저장장치에 기록해야","words":[{"text":"지","x":297,"y":517,"width":28,"height":35},{"text":"내용과","x":345,"y":517,"width":100,"height":35},{"text":"달라졌다는","x":459,"y":517,"width":162,"height":37},{"text":"것을","x":637,"y":519,"width":61,"height":35},{"text":"알","x":712,"y":520,"width":30,"height":35},{"text":"수","x":755,"y":521,"width":30,"height":35},{"text":"있다.","x":801,"y":520,"width":64,"height":36},{"text":"이","x":882,"y":520,"width":25,"height":36},{"text":"경우","x":927,"y":521,"width":60,"height":36},{"text":"현재","x":1001,"y":521,"width":57,"height":36},{"text":"내용을","x":1076,"y":521,"width":91,"height":36},{"text":"보조저장장치에","x":1181,"y":521,"width":221,"height":37},{"text":"기록해야","x":1420,"y":522,"width":130,"height":37}]},{"text":"한다. 그러나 변경 비트가 설정되어 있지 않다면 메모리로 읽혀 들어온 후 변경되지 않","words":[{"text":"한다.","x":296,"y":576,"width":73,"height":36},{"text":"그러나","x":388,"y":577,"width":100,"height":36},{"text":"변경","x":504,"y":577,"width":58,"height":37},{"text":"비트가","x":582,"y":578,"width":95,"height":37},{"text":"설정되어","x":690,"y":579,"width":119,"height":37},{"text":"있지","x":828,"y":580,"width":54,"height":36},{"text":"않다면","x":900,"y":581,"width":91,"height":35},{"text":"메모리로","x":1006,"y":581,"width":122,"height":35},{"text":"읽혀","x":1143,"y":581,"width":56,"height":35},{"text":"들어온","x":1216,"y":581,"width":97,"height":35},{"text":"후","x":1326,"y":582,"width":33,"height":34},{"text":"변경되지","x":1374,"y":582,"width":124,"height":35},{"text":"않","x":1518,"y":583,"width":34,"height":36}]},{"text":"았음을 알 수 있다. 따라서, 보조저장장文1상의 복사본이 변경되지만 않았다면(예를 들어","words":[{"text":"았음을","x":294,"y":637,"width":103,"height":35},{"text":"알","x":411,"y":637,"width":33,"height":36},{"text":"수","x":457,"y":638,"width":33,"height":35},{"text":"있다.","x":505,"y":638,"width":69,"height":36},{"text":"따라서,","x":590,"y":639,"width":102,"height":36},{"text":"보조저장장文1상의","x":706,"y":640,"width":242,"height":36},{"text":"복사본이","x":963,"y":641,"width":118,"height":36},{"text":"변경되지만","x":1099,"y":640,"width":154,"height":37},{"text":"않았다면(예를","x":1266,"y":641,"width":205,"height":39},{"text":"들어","x":1483,"y":643,"width":62,"height":36}]},{"text":"다른 페이지에 의해) 메모리 페이지를 보조저장장치에 기록할 필요가 없다. 이미 거기에","words":[{"text":"다른","x":296,"y":698,"width":67,"height":35},{"text":"페이지에","x":377,"y":698,"width":130,"height":36},{"text":"의해)","x":524,"y":699,"width":73,"height":39},{"text":"메모리","x":613,"y":699,"width":90,"height":36},{"text":"페이지를","x":720,"y":699,"width":122,"height":37},{"text":"보조저장장치에","x":854,"y":701,"width":210,"height":36},{"text":"기록할","x":1080,"y":701,"width":92,"height":36},{"text":"필요가","x":1184,"y":701,"width":93,"height":35},{"text":"없다.","x":1290,"y":701,"width":68,"height":36},{"text":"이미","x":1375,"y":701,"width":59,"height":37},{"text":"거기에","x":1452,"y":702,"width":94,"height":37}]},{"text":"있기 때문이다. 이 기법은 읽기 전용 페이지들에도 적용된다(예를 들면 이진 코드 페이","words":[{"text":"있기","x":297,"y":758,"width":60,"height":36},{"text":"때문이다.","x":379,"y":759,"width":139,"height":36},{"text":"이","x":537,"y":759,"width":27,"height":36},{"text":"기법은","x":584,"y":760,"width":95,"height":35},{"text":"읽기","x":694,"y":760,"width":56,"height":36},{"text":"전용","x":769,"y":760,"width":61,"height":37},{"text":"페이지들에도","x":845,"y":760,"width":181,"height":37},{"text":"적용된다(예를","x":1041,"y":761,"width":194,"height":39},{"text":"들면","x":1248,"y":761,"width":62,"height":35},{"text":"이진","x":1327,"y":761,"width":61,"height":36},{"text":"코드","x":1404,"y":766,"width":65,"height":26},{"text":"페이","x":1484,"y":763,"width":61,"height":37}]},{"text":"지들). 이러한 페이지들은 변경될 수 없으므로 필요할 때 언제든 제거될 수 있다. 이러한","words":[{"text":"지들).","x":296,"y":818,"width":85,"height":38},{"text":"이러한","x":399,"y":819,"width":101,"height":36},{"text":"페이지들은","x":513,"y":820,"width":160,"height":36},{"text":"변경될","x":687,"y":820,"width":90,"height":36},{"text":"수","x":790,"y":821,"width":32,"height":35},{"text":"없으므로","x":835,"y":821,"width":120,"height":35},{"text":"필요할","x":969,"y":821,"width":90,"height":35},{"text":"때","x":1070,"y":822,"width":26,"height":35},{"text":"언제든","x":1113,"y":822,"width":90,"height":34},{"text":"제거될","x":1215,"y":822,"width":91,"height":36},{"text":"수","x":1320,"y":823,"width":32,"height":35},{"text":"있다.","x":1367,"y":822,"width":69,"height":36},{"text":"이러한","x":1452,"y":823,"width":99,"height":36}]},{"text":"방법은 페이지가 변경되지 않으면 I/O 시간을 반으로 줄일 수 있으므로 페이지 폴트 처","words":[{"text":"방법은","x":294,"y":879,"width":102,"height":36},{"text":"페이지가","x":410,"y":880,"width":133,"height":36},{"text":"변경되지","x":557,"y":881,"width":122,"height":36},{"text":"않으면","x":696,"y":881,"width":92,"height":36},{"text":"I/O","x":800,"y":884,"width":61,"height":33},{"text":"시간을","x":875,"y":881,"width":91,"height":36},{"text":"반으로","x":977,"y":881,"width":91,"height":35},{"text":"줄일","x":1078,"y":882,"width":59,"height":35},{"text":"수","x":1150,"y":883,"width":31,"height":34},{"text":"있으므로","x":1195,"y":882,"width":123,"height":36},{"text":"페이지","x":1331,"y":882,"width":91,"height":37},{"text":"폴트","x":1438,"y":884,"width":66,"height":34},{"text":"처","x":1518,"y":884,"width":28,"height":36}]},{"text":"리 시간을 많이 줄일 수 있다.","words":[{"text":"리","x":296,"y":940,"width":26,"height":36},{"text":"시간을","x":340,"y":940,"width":102,"height":36},{"text":"많이","x":454,"y":941,"width":62,"height":36},{"text":"줄일","x":531,"y":941,"width":63,"height":35},{"text":"수","x":608,"y":941,"width":32,"height":36},{"text":"있다.","x":654,"y":941,"width":68,"height":36}]},{"text":"페이지 교체는 요구 페이징의 기본이다. 이를 통해 논리적 메모리와 물리 메모리 간","words":[{"text":"페이지","x":357,"y":1001,"width":97,"height":36},{"text":"교체는","x":472,"y":1002,"width":99,"height":36},{"text":"요구","x":584,"y":1004,"width":64,"height":34},{"text":"페이징의","x":662,"y":1002,"width":122,"height":37},{"text":"기본이다.","x":801,"y":1003,"width":129,"height":37},{"text":"이를","x":946,"y":1003,"width":59,"height":36},{"text":"통해","x":1017,"y":1003,"width":58,"height":36},{"text":"논리적","x":1089,"y":1003,"width":87,"height":37},{"text":"메모리와","x":1193,"y":1003,"width":125,"height":37},{"text":"물리","x":1329,"y":1004,"width":60,"height":35},{"text":"메모리","x":1406,"y":1003,"width":94,"height":36},{"text":"간","x":1518,"y":1004,"width":33,"height":34}]},{"text":"의 분리가 완성된다. 이 기법을 통해 매우 작은 물리 메모리로도 프로그래머에게 광대한","words":[{"text":"의","x":294,"y":1062,"width":28,"height":36},{"text":"분리가","x":339,"y":1062,"width":103,"height":36},{"text":"완성된다.","x":454,"y":1062,"width":139,"height":37},{"text":"이","x":610,"y":1063,"width":27,"height":36},{"text":"기법을","x":655,"y":1063,"width":94,"height":37},{"text":"통해","x":760,"y":1065,"width":61,"height":35},{"text":"매우","x":836,"y":1064,"width":62,"height":36},{"text":"작은","x":909,"y":1064,"width":61,"height":36},{"text":"물리","x":981,"y":1064,"width":58,"height":36},{"text":"메모리로도","x":1055,"y":1064,"width":151,"height":36},{"text":"프로그래머에게","x":1217