text":"상황을","x":482,"y":381,"width":87,"height":34},{"text":"위해","x":582,"y":381,"width":54,"height":35},{"text":"수작업","x":651,"y":381,"width":82,"height":35},{"text":"복구","x":749,"y":382,"width":57,"height":34},{"text":"방법을","x":818,"y":382,"width":88,"height":34},{"text":"반드시","x":918,"y":382,"width":85,"height":36},{"text":"가지고","x":1021,"y":382,"width":90,"height":35},{"text":"있어야","x":1128,"y":384,"width":93,"height":35},{"text":"하며,","x":1236,"y":385,"width":72,"height":34},{"text":"단순히","x":1324,"y":384,"width":94,"height":34},{"text":"동일","x":1435,"y":383,"width":59,"height":34}]},{"text":"한 방법을 교착 상대 회복을 위해서 시용할 수도 있다.","words":[{"text":"한","x":306,"y":437,"width":32,"height":34},{"text":"방법을","x":348,"y":437,"width":89,"height":35},{"text":"교착","x":448,"y":437,"width":58,"height":35},{"text":"상대","x":516,"y":438,"width":55,"height":34},{"text":"회복을","x":585,"y":438,"width":85,"height":34},{"text":"위해서","x":681,"y":439,"width":81,"height":35},{"text":"시용할","x":777,"y":439,"width":85,"height":35},{"text":"수도","x":872,"y":440,"width":58,"height":34},{"text":"있다.","x":943,"y":440,"width":63,"height":34}]},{"text":"교착 상대 예방 Deadlock Prevention","words":[{"text":"교착","x":305,"y":572,"width":73,"height":42},{"text":"상대","x":389,"y":574,"width":67,"height":41},{"text":"예방","x":469,"y":575,"width":69,"height":41},{"text":"Deadlock","x":563,"y":585,"width":150,"height":24},{"text":"Prevention","x":723,"y":585,"width":172,"height":25}]},{"text":"우리가 8.3.1절에서 기술한 것처럼, 교착 상태가 발생하려면 네 가지의 필요조건 각각이","words":[{"text":"우리가","x":305,"y":664,"width":92,"height":36},{"text":"8.3.1절에서","x":407,"y":665,"width":152,"height":36},{"text":"기술한","x":576,"y":666,"width":85,"height":34},{"text":"것처럼,","x":673,"y":665,"width":90,"height":36},{"text":"교착","x":776,"y":665,"width":59,"height":36},{"text":"상태가","x":845,"y":666,"width":88,"height":36},{"text":"발생하려면","x":944,"y":667,"width":150,"height":35},{"text":"네","x":1109,"y":667,"width":26,"height":35},{"text":"가지의","x":1153,"y":668,