822,"width":94,"height":35},{"text":"반면에","x":773,"y":1823,"width":86,"height":34},{"text":"지역","x":873,"y":1823,"width":56,"height":34},{"text":"교체","x":945,"y":1822,"width":58,"height":35},{"text":"방법에서는","x":1019,"y":1821,"width":159,"height":35},{"text":"프로세스에","x":1189,"y":1822,"width":165,"height":34},{"text":"할당된","x":1370,"y":1822,"width":98,"height":34},{"text":"프","x":1481,"y":1826,"width":32,"height":25}]},{"text":"레임의 수는 변하지 않는다. 전역 교체하에서는 한 프로세스에 할당된 프레임의 수는 바","words":[{"text":"레임의","x":298,"y":1879,"width":86,"height":35},{"text":"수는","x":398,"y":1880,"width":61,"height":34},{"text":"변하지","x":472,"y":1880,"width":81,"height":35},{"text":"않는다.","x":568,"y":1880,"width":93,"height":35},{"text":"전역","x":675,"y":1881,"width":53,"height":34},{"text":"교체하에서는","x":743,"y":1881,"width":179,"height":35},{"text":"한","x":933,"y":1881,"width":31,"height":33},{"text":"프로세스에","x":975,"y":1880,"width":154,"height":35},{"text":"할당된","x":1144,"y":1880,"width":97,"height":34},{"text":"프레임의","x":1256,"y":1881,"width":131,"height":35},{"text":"수는","x":1403,"y":1881,"width":66,"height":34},{"text":"바","x":1481,"y":1881,"width":32,"height":35}]},{"text":"뀔 수 있다. 전역 교체 방법에서는 프로세스가 매번 다른 프로세스의 프레임을 할당받게","words":[{"text":"뀔","x":297,"y":1938,"width":29,"height":33},{"text":"수","x":338,"y":1938,"width":31,"height":34},{"text":"있다.","x":382,"y":1938,"width":64,"height":35},{"text":"전역","x":462,"y":1938,"width":53,"height":35},{"text":"교체","x":529,"y":1939,"width":56,"height":34},{"text":"방법에서는","x":598,"y":1939,"width":146,"height":35},{"text":"프로세스가","x":754,"y":1939,"width":149,"height":36},{"text":"매번","x":913,"y":1939,"width":60,"height":34},{"text":"다른","x":986,"y":1939,"width":62,"height":35},{"text":"프로세스의","x":1059,"y":1938,"width":159,"height":35},{"text":"프레임을","x":1234,"y":1938,"width":135,"height":35},{"text":"할당받게","x":1382,"y":1939,"width":127,"height":34}]},{"text":"되면 그 프로세스에 할당된 페이지 수가 증가하게 된다(다른 프로세스들이 그 프로세스","words":[{"text":"되면","x":298,"y":1995,"width":59,"height":35},{"text":"그","x":371,"y":2001,"width":29,"height":23},{"text":"프로세스에","x":412,"y":1997,"width":145,"height":35},{"text":"할당된","x":571,"y":1997,"width":85,"height":34},{"text":"페이지","x":672,"y":1997,"width":81,"height":35},{"text":"수가","x":768,"y":1998,"width":59,"height":34},{"text":"증가하게","x":838,"y":1997,"width":117,"height":35},{"text":"된다(다른","x":972,"y":1997,"width":136,"height":38},{"text":"프로세스들이","x":1121,"y":1997,"width":195,"height":34},{"text":"그","x":1333,"y":2002,"width":34,"height":23},{"text":"프로세스","x":1381,"y":1997,"width":131,"height":34}]},{"text":"의 프레임을 교체하지 않는다는 전제하에).","words":[{"text":"의","x":298,"y":2053,"width":26,"height":35},{"text":"프레임을","x":339,"y":2054,"width":120,"height":34},{"text":"교체하지","x":470,"y":2055,"width":112,"height":35},{"text":"않는다는","x":597,"y":2055,"width":115,"height":34},{"text":"전제하에).","x":723,"y":2055,"width":131,"height":37}]},{"text":"전역 교체 알고리즘의 한 가지 문제점은 프로세스의 메모리에 있는 페이지 집합이","words":[{"text":"전역","x":355,"y":2111,"width":56,"height":34},{"text":"교체","x":429,"y":2113,"width":56,"height":34},{"text":"알고리즘의","x":502,"y":2112,"width":141,"height":35},{"text":"한","x":660,"y":2113,"width":29,"height":33},{"text":"가지","x":702,"y":2113,"width":53,"height":34},{"text":"문제점은","x":772,"y":2112,"width":117,"height":35},{"text":"프로세스의","x":902,"y":2113,"width":149,"height":35},{"text":"메모리에","x":1070,"y":2113,"width":125,"height":35},{"text":"있는","x":1216,"y":2113,"width":65,"height":34},{"text":"페이지","x":1297,"y":2113,"width":97,"height":36},{"text":"집합이","x":1416,"y":2113,"width":92,"height":36}]},{"text":"해당 프로세스의 페이징 동작뿐만 아니라 다른 프로세스의 페이징 동작에도 영향을 받","words":[{"text":"해당","x":298,"y":2168,"width":61,"height":34},{"text":"프로세스의","x":372,"y":2170,"width":146,"height":34},{"text":"페이징","x":535,"y":2170,"width":82,"height":34},{"text":"동작뿐만","x":633,"y":2170,"width":117,"height":34},{"text":"아니라","x":762,"y":2170,"width":87,"height":35},{"text":"다른","x":861,"y":2170,"width":59,"height":35},{"text":"프로세스의","x