,"height":37},{"text":"네트워크","x":633,"y":753,"width":121,"height":37},{"text":"층에서","x":768,"y":754,"width":87,"height":37},{"text":"네트워크","x":874,"y":754,"width":121,"height":37},{"text":"패킷으로","x":1010,"y":755,"width":121,"height":37},{"text":"만들어져","x":1146,"y":756,"width":120,"height":36},{"text":"네트워크","x":1286,"y":756,"width":127,"height":36},{"text":"장치","x":1427,"y":756,"width":61,"height":36},{"text":"드","x":1507,"y":762,"width":32,"height":25}]},{"text":"라이버로 간다. 네트워크 장지 드라이버는 패킷을 네트워크 컨트롤러로 전달하고, 네트","words":[{"text":"라이버로","x":301,"y":814,"width":129,"height":36},{"text":"간다.","x":445,"y":814,"width":70,"height":35},{"text":"네트워크","x":533,"y":814,"width":123,"height":36},{"text":"장지","x":671,"y":814,"width":57,"height":36},{"text":"드라이버는","x":745,"y":814,"width":153,"height":37},{"text":"패킷을","x":912,"y":815,"width":91,"height":36},{"text":"네트워크","x":1017,"y":816,"width":121,"height":36},{"text":"컨트롤러로","x":1153,"y":816,"width":155,"height":36},{"text":"전달하고,","x":1323,"y":816,"width":135,"height":37},{"text":"네트","x":1475,"y":817,"width":64,"height":36}]},{"text":"워크 컨트롤러는 문자를 보내고 인터럽트를 발생시킨다. 인터럽트는 커널을 통해 거꾸로","words":[{"text":"워크","x":301,"y":875,"width":64,"height":35},{"text":"컨트롤러는","x":379,"y":874,"width":160,"height":37},{"text":"문자를","x":549,"y":874,"width":94,"height":36},{"text":"보내고","x":654,"y":874,"width":93,"height":36},{"text":"인터럽트를","x":760,"y":874,"width":150,"height":37},{"text":"발생시킨다.","x":922,"y":876,"width":158,"height":36},{"text":"인터럽트는","x":1096,"y":876,"width":152,"height":36},{"text":"커널을","x":1260,"y":877,"width":94,"height":35},{"text":"통해","x":1366,"y":877,"width":62,"height":36},{"text":"거꾸로","x":1443,"y":877,"width":97,"height":37}]},{"text":"전달되어 네트워크 입출력 시스템 콜을 끝나게 한다.","words":[{"text":"전달되어","x":302,"y":934,"width":124,"height":36},{"text":"네트워크","x":443,"y":934,"width":126,"height":37},{"text":"입출력","x":583,"y":935,"width":87,"height":36},{"text":"시스템","x":686,"y":935,"width":89,"height":36},{"text":"콜을","x":788,"y"