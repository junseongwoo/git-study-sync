{"page":609,"width":1723,"height":2651,"text_angle":0,"lines":[{"text":"15.8 NFS","words":[{"text":"15.8","x":1234,"y":155,"width":71,"height":24},{"text":"NFS","x":1323,"y":156,"width":53,"height":24}]},{"text":"• 링크와 디렉터리들의 조작","words":[{"text":"•","x":301,"y":297,"width":14,"height":16},{"text":"링크와","x":343,"y":288,"width":93,"height":37},{"text":"디렉터리들의","x":448,"y":290,"width":178,"height":37},{"text":"조작","x":641,"y":291,"width":58,"height":36}]},{"text":"• 파일 속성의 접근","words":[{"text":"•","x":301,"y":368,"width":14,"height":16},{"text":"파일","x":340,"y":359,"width":60,"height":36},{"text":"속성의","x":414,"y":360,"width":91,"height":36},{"text":"접근","x":522,"y":361,"width":58,"height":35}]},{"text":"• 파일 읽기와 쓰기","words":[{"text":"•","x":301,"y":440,"width":14,"height":14},{"text":"파일","x":339,"y":430,"width":61,"height":35},{"text":"읽기와","x":416,"y":430,"width":93,"height":36},{"text":"쓰기","x":520,"y":432,"width":56,"height":36}]},{"text":"673","words":[{"text":"673","x":1448,"y":151,"width":59,"height":29}]},{"text":"이러한 프로시저는 원격으로 마운트된 디렉터리에 대한 파일 핸들이 구축되어야만 호출","words":[{"text":"이러한","x":280,"y":551,"width":96,"height":37},{"text":"프로시저는","x":388,"y":551,"width":157,"height":36},{"text":"원격으로","x":558,"y":553,"width":120,"height":36},{"text":"마운트된","x":690,"y":554,"width":117,"height":37},{"text":"디렉터리에","x":821,"y":553,"width":146,"height":38},{"text":"대한","x":984,"y":553,"width":60,"height":36},{"text":"파일","x":1056,"y":553,"width":59,"height":37},{"text":"핸들이","x":1130,"y":552,"width":91,"height":37},{"text":"구축되어야만","x":1238,"y":551,"width":196,"height":38},{"text":"호출","x":1446,"y":549,"width":67,"height":36}]},{"text":"할수 있다.","words":[{"text":"할수","x":279,"y":613,"width":75,"height":35},{"text":"있다.","x":368,"y":611,"width":68,"height":37}]},{"text":"열기(뼾en)와 닫기(close) 연산은 의도적으로 생략되었다. NFS 서비스의 주요 특","words":[{"text":"열기(뼾en)와","x":342,"y":672,"width":198,"height":42},{"text":"닫기(close)","x":553,"y":674,"width":158,"height":39},{"text":"연산은","x":728,"y":675,"width":87,"height":35},{"text":"의도적으로","x":829,"y":675,"width":150,"height":36},{"text":"생략되었다.","x":993,"y":675,"width":160,"height":37},{"text":"NFS","x":1169,"y":678,"width":71,"height":30},{"text":"서비스의","x":1256,"y":674,"width":125,"height":38},{"text":"주요","x":1399,"y":674,"width":65,"height":36},{"text":"특","x":1478,"y":673,"width":34,"height":35}]},{"text":"징은 무상태성이다. 서버는 하나의 접근과 다른 접근 사이에 클라이언트에 대한 정보를","words":[{"text":"징은","x":280,"y":735,"width":63,"height":36},{"text":"무상태성이다.","x":356,"y":733,"width":197,"height":38},{"text":"서버는","x":570,"y":735,"width":91,"height":36},{"text":"하나의","x":673,"y":735,"width":86,"height":36},{"text":"접근과","x":776,"y":735,"width":89,"height":36},{"text":"다른","x":877,"y":736,"width":61,"height":35},{"text":"접근","x":952,"y":736,"width":58,"height":35},{"text":"사이에","x":1024,"y":736,"width":89,"height":36},{"text":"클라이언트에","x":1128,"y":736,"width":190,"height":36},{"text":"대한","x":1336,"y":735,"width":64,"height":36},{"text":"정보를","x":1415,"y":734,"width":97,"height":36}]},{"text":"유지하지 않는다. 서버에 UNIX의 오픈 파일 테이블 또는 파일 구조와 비슷한 구조가","words":[{"text":"유지하지","x":278,"y":794,"width":125,"height":38},{"text":"않는다.","x":423,"y":794,"width":101,"height":38},{"text":"서버에","x":542,"y":796,"width":89,"height":36},{"text":"UNIX의","x":648,"y":795,"width":116,"height":37},{"text":"오픈","x":782,"y":797,"width":60,"height":34},{"text":"파일","x":856,"y":796,"width":58,"height":36},{"text":"테이블","x":931,"y":795,"width":90,"height":37},{"text":"또는","x":1035,"y":798,"width":62,"height":34},{"text":"파일","x":1112,"y":796,"width":59,"height":36},{"text":"구조와","x":1188,"y":797,"width":98,"height":35},{"text":"비슷한","x":1302,"y":795,"width":96,"height":37},{"text":"구조가","x":1413,"y":793,"width":99,"height":37}]},{"text":"존재하지 않는다. 결론적으로 각각의 요구들은 적절한 동작을 위해서는 유일한 파일 식","words":[{"text":"존재하지","x":277,"y":856,"width":126,"height":36},{"text":"않는다.","x":421,"y":856,"width":101,"height":37},{"text":"결론적으로","x":540,"y":857,"width":151,"height":36},{"text":"각각의","x":704,"y":856,"width":86,"height":36},{"text":"요구들은","x":805,"y":856,"width":122,"height":36},{"text":"적절한","x":940,"y":856,"width":90,"height":36},{"text":"동작을","x":1042,"y":856,"width":92,"height":37},{"text":"위해서는","x":1149,"y":857,"width":126,"height":36},{"text":"유일한","x":1288,"y":856,"width":98,"height":36},{"text":"파일","x":1398,"y":854,"width":64,"height":37},{"text":"식","x":1479,"y":853,"width":28,"height":36}]},{"text":"별자와 파일 내부의 절대적인 변위(offset)와 같은 매개변수들의 완전한 집합을 제공해","words":[{"text":"별자와","x":279,"y":917,"width":96,"height":36},{"text":"파일","x":388,"y":917,"width":62,"height":36},{"text":"내부의","x":467,"y":917,"width":91,"height":37},{"text":"절대적인","x":576,"y":917,"width":119,"height":37},{"text":"변위(offset)와","x":712,"y":917,"width":196,"height":38},{"text":"같은","x":920,"y":917,"width":61,"height":35},{"text":"매개변수들의","x":994,"y":917,"width":180,"height":36},{"text":"완전한","x":1190,"y":917,"width":97,"height":35},{"text":"집합을","x":1302,"y":915,"width":97,"height":37},{"text":"제공해","x":1414,"y":913,"width":94,"height":36}]},{"text":"야 한다. 이러한 설계 방식은 견고성을 증진할 수 있다. 왜냐하면 시스템 크래시 후 서버","words":[{"text":"야","x":277,"y":978,"width":32,"height":36},{"text":"한다.","x":321,"y":978,"width":71,"height":36},{"text":"이러한","x":409,"y":978,"width":95,"height":36},{"text":"설계","x":516,"y":978,"width":59,"height":37},{"text":"방식은","x":590,"y":979,"width":92,"height":36},{"text":"견고성을","x":694,"y":977,"width":119,"height":36},{"text":"증진할","x":823,"y":977,"width":92,"height":36},{"text":"수","x":926,"y":978,"width":31,"height":35},{"text":"있다.","x":969,"y":978,"width":66,"height":35},{"text":"왜냐하면","x":1048,"y":977,"width":122,"height":36},{"text":"시스템","x":1183,"y":977,"width":91,"height":36},{"text":"크래시","x":1290,"y":976,"width":94,"height":35},{"text":"후","x":1400,"y":975,"width":34,"height":34},{"text":"서버","x":1446,"y":973,"width":61,"height":35}]},{"text":"를 복원하기 위해 특별한 대책이 필요 없기 때문이다. 이 목적을 위하여 파일 연산은 역","words":[{"text":"를","x":275,"y":1040,"width":33,"height":34},{"text":"복원하기","x":321,"y":1038,"width":125,"height":37},{"text":"위해","x":464,"y":1039,"width":61,"height":37},{"text":"특별한","x":539,"y":1040,"width":95,"height":35},{"text":"대책이","x":646,"y":1038,"width":86,"height":37},{"text":"필요","x":749,"y":1038,"width":58,"height":36},{"text":"없기","x":822,"y":1038,"width":54,"height":36},{"text":"때문이다.","x":894,"y":1038,"width":125,"height":36},{"text":"이","x":1036,"y":1038,"width":25,"height":36},{"text":"목적을","x":1076,"y":1037,"width":93,"height":36},{"text":"위하여","x":1182,"y":1037,"width":90,"height":37},{"text":"파일","x":1289,"y":1036,"width":63,"height":36},{"text":"연산은","x":1370,"y":1034,"width":97,"height":36},{"text":"역","x":1481,"y":1032,"width":27,"height":36}]},{"text":"등성을 가져야 할 필요가 있다. 즉 같은 연산을 여러 번 적용하더라도 오직 한 번만 적용","words":[{"text":"등성을","x":274,"y":1099,"width":99,"height":36},{"text":"가져야","x":386,"y":1099,"width":96,"height":37},{"text":"할","x":493,"y":1100,"width":32,"height":35},{"text":"필요가","x":538,"y":1100,"width":92,"height":36},{"text":"있다.","x":643,"y":1099,"width":65,"height":37},{"text":"즉","x":721,"y":1101,"width":31,"height":34},{"text":"같은","x":763,"y":1099,"width":61,"height":35},{"text":"연산을","x":837,"y":1098,"width":89,"height":36},{"text":"여러","x":938,"y":1099,"width":55,"height":36},{"text":"번","x":1011,"y":1099,"width":27,"height":35},{"text":"적용하더라도","x":1052,"y":1098,"width":183,"height":37},{"text":"오직","x":1247,"y":1098,"width":61,"height":35},{"text":"한","x":1324,"y":1096,"width":34,"height":35},{"text":"번만","x":1371,"y":1094,"width":64,"height":36},{"text":"적용","x":1448,"y":1093,"width":66,"height":36}]},{"text":"한 결과와 같아야 한다. 이러한 멱등성을 얻기 위해서 각 NFS 요청은 일련번호를 가지","words":[{"text":"한","x":274,"y":1160,"width":34,"height":35},{"text":"결과와","x":322,"y":1160,"width":97,"height":37},{"text":"같아야","x":432,"y":1161,"width":95,"height":36},{"text":"한다.","x":539,"y":1160,"width":69,"height":36},{"text":"이러한","x":625,"y":1160,"width":91,"height":37},{"text":"멱등성을","x":730,"y":1160,"width":120,"height":36},{"text":"얻기","x":864,"y":1160,"width":55,"height":36},{"text":"위해서","x":937,"y":1160,"width":85,"height":36},{"text":"각","x":1040,"y":1160,"width":30,"height":35},{"text":"NFS","x":1081,"y":1162,"width":68,"height":29},{"text":"요청은","x":1162,"y":1160,"width":95,"height":35},{"text":"일련번호를","x":1272,"y":1156,"width":163,"height":38},{"text":"가지","x":1449,"y":1154,"width":60,"height":36}]},{"text":"고 있어 서버가 요청이 중복되었는지 또는 빠졌는지를 결정할 수 있게 한다.","words":[{"text":"고","x":274,"y":1225,"width":33,"height":26},{"text":"있어","x":320,"y":1220,"width":59,"height":37},{"text":"서버가","x":395,"y":1221,"width":97,"height":36},{"text":"요청이","x":501,"y":1221,"width":90,"height":36},{"text":"중복되었는지","x":606,"y":1221,"width":180,"height":36},{"text":"또는","x":800,"y":1223,"width":62,"height":33},{"text":"빠졌는지를","x":873,"y":1221,"width":151,"height":36},{"text":"결정할","x":1037,"y":1221,"width":90,"height":36},{"text":"수","x":1137,"y":1221,"width":31,"height":35},{"text":"있게","x":1181,"y":1220,"width":58,"height":36},{"text":"한다.","x":1253,"y":1219,"width":72,"height":36}]},{"text":"마운트 프로토콜에서 설명된 클라이언트의 리스트를 유지하는 것은 서버의 무상대","words":[{"text":"마운트","x":334,"y":1282,"width":98,"height":35},{"text":"프로토콜에서","x":446,"y":1282,"width":184,"height":36},{"text":"설명된","x":649,"y":1282,"width":89,"height":36},{"text":"클라이언트의","x":753,"y":1282,"width":180,"height":36},{"text":"리스트를","x":952,"y":1282,"width":120,"height":35},{"text":"유지하는","x":1086,"y":1281,"width":124,"height":36},{"text":"것은","x":1225,"y":1281,"width":63,"height":36},{"text":"서버의","x":1303,"y":1278,"width":94,"height":38},{"text":"무상대","x":1415,"y":1277,"width":95,"height":38}]},{"text":"원칙을 위반한 것처럼 보인다. 그러나 이 리스트는 클라이언트나 서버의 정확한 동작을","words":[{"text":"원칙을","x":274,"y":1342,"width":97,"height":35},{"text":"위반한","x":385,"y":1343,"width":95,"height":36},{"text":"것처럼","x":495,"y":1342,"width":88,"height":36},{"text":"보인다.","x":600,"y":1342,"width":99,"height":36},{"text":"그러나","x":714,"y":1342,"width":93,"height":37