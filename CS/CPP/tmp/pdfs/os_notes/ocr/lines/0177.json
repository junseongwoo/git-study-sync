{"page":177,"width":1875,"height":2770,"text_angle":0,"lines":[{"text":"5.3 스게줍랑 알고리좀","words":[{"text":"5.3","x":1255,"y":168,"width":58,"height":24},{"text":"스게줍랑","x":1329,"y":166,"width":98,"height":29},{"text":"알고리좀","x":1438,"y":167,"width":100,"height":27}]},{"text":"231","words":[{"text":"231","x":1615,"y":162,"width":59,"height":30}]},{"text":"당량은 일반적으로 10에서 100밀리초 동안이다. 준비 큐는 원형 큐(circular queue)로","words":[{"text":"당량은","x":337,"y":309,"width":98,"height":37},{"text":"일반적으로","x":451,"y":308,"width":163,"height":38},{"text":"10에서","x":629,"y":308,"width":99,"height":39},{"text":"100밀리초","x":748,"y":308,"width":157,"height":39},{"text":"동안이다.","x":919,"y":306,"width":142,"height":40},{"text":"준비","x":1077,"y":306,"width":65,"height":39},{"text":"큐는","x":1160,"y":307,"width":68,"height":37},{"text":"원형","x":1243,"y":304,"width":63,"height":39},{"text":"큐(circular","x":1324,"y":304,"width":182,"height":40},{"text":"queue)로","x":1520,"y":305,"width":159,"height":42}]},{"text":"동작한다. CPU 스기|출러는 준비 큐를 돌면서 한 번에 한 프로세스에 한 번의 시간 할당","words":[{"text":"동작한다.","x":336,"y":371,"width":139,"height":38},{"text":"CPU","x":490,"y":375,"width":80,"height":30},{"text":"스기|출러는","x":584,"y":371,"width":166,"height":39},{"text":"준비","x":763,"y":372,"width":63,"height":38},{"text":"큐를","x":843,"y":372,"width":66,"height":38},{"text":"돌면서","x":922,"y":371,"width":97,"height":38},{"text":"한","x":1036,"y":370,"width":34,"height":38},{"text":"번에","x":1085,"y":370,"width":62,"height":38},{"text":"한","x":1164,"y":370,"width":34,"height":37},{"text":"프로세스에","x":1211,"y":368,"width":169,"height":40},{"text":"한","x":1396,"y":366,"width":36,"height":39},{"text":"번의","x":1446,"y":366,"width":64,"height":39},{"text":"시간","x":1528,"y":367,"width":68,"height":39},{"text":"할당","x":1608,"y":368,"width":72,"height":38}]},{"text":"량 동안 CPU를 할당한다.","words":[{"text":"량","x":337,"y":435,"width":31,"height":37},{"text":"동안","x":381,"y":434,"width":66,"height":38},{"text":"CPU를","x":458,"y":436,"width