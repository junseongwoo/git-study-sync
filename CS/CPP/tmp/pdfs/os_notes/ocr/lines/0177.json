프로세스","x":1032,"y":817,"width":135,"height":38},{"text":"자신이","x":1181,"y":818,"width":97,"height":38},{"text":"CPU를","x":1295,"y":819,"width":117,"height":36},{"text":"자발적으로","x":1426,"y":818,"width":170,"height":38},{"text":"방출","x":1610,"y":819,"width":69,"height":37}]},{"text":"할 것이다. 스게줄러는 그 후 준비 큐에 있는 다음 프로세스로 진행할 것이다. 두 번째는","words":[{"text":"할","x":334,"y":879,"width":35,"height":37},{"text":"것이다.","x":383,"y":879,"width":104,"height":39},{"text":"스게줄러는","x":504,"y":879,"width":170,"height":39},{"text":"그","x":687,"y":884,"width":33,"height":27},{"text":"후","x":734,"y":880,"width":34,"height":37},{"text":"준비","x":781,"y":880,"width":65,"height":38},{"text":"큐에","x":863,"y":880,"width":65,"height":38},{"text":"있는","x":948,"y":881,"width":66,"height":37},{"text":"다음","x":1028,"y":881,"width":67,"height":38},{"text":"프로세스로","x":1108,"y":881,"width":169,"height":38},{"text":"진행할","x":1291,"y":881,"width":102,"height":38},{"text":"것이다.","x":1407,"y":881,"width":107,"height":38},{"text":"두","x":1529,"y":883,"width":34,"height":36},{"text":"번째는","x":1578,"y":882,"width":102,"height":36}]},{"text":"현재 실행 중인 프로세스의 CPU 버스트가 한 번의 시간 할당량보다 긴 경우로, 타이머","words":[{"text":"현재","x":336,"y":943,"width":62,"height":37},{"text":"실행","x":415,"y":943,"width":63,"height":38},{"text":"중인","x":494,"y":944,"width":66,"height":37},{"text":"프로세스의","x":576,"y":943,"width":167,"height":39},{"text":"CPU","x":760,"y":946,"width":83,"height":31},{"text":"버스트가","x":860,"y":943,"width":137,"height":40},{"text":"한","x":1010,"y":944,"width":35,"height":37},{"text":"번의","x":1060,"y":944,"width":62,"height":38},{"text":"시간","x":1140,"y":944,"width":68,"height":38},{"text":"할당량보다","x":1221,"y":944,"width":170,"height":38},{"text":"긴","x":1406,"y":944,"width":30,"height":37},{"text":"경우로,","x":1454,"y":944,"width":108,"height":38},{"text":"타이머","x":1577,"y":944,"width":98,"height":38}]},{"text":"가 끝나고 운영체제에 인터럽트를 발생할 것이다. 문맥 교환이 일어나고 실행하던 프로","words":[{"text":"가","x":335,"y":1006,"width":33,"height":38},{"text":"끝나고","x":381,"y":1006,"width":100,"height":38},{"text":"운영체제에","x":495,"y":1007,"width":168,"height":39},{"text":"인터럽트를","x":683,"y":1007,"width":170,"height":39},{"text":"발생할","x":868,"y":1008,"width":105,"height":37},{"text":"것이다.","x":988,"y":1008,"width":108,"height":38},{"text":"문맥","x":1113,"y":1008,"width":64,"height":38},{"text":"교환이","x":1195,"y":1008,"width":98,"height":38},{"text":"일어나고","x":1314,"y":1008,"width":134,"height":38},{"text":"실행하던","x":1462,"y":1006,"width":133,"height":39},{"text":"프로","x":1612,"y":1010,"width":68,"height":28}]},{"text":"세스는 준비 큐의 꼬리에 넣어진다. 그 후 CPU 스케줄러는 준비 큐의 다음 프로세스를","words":[{"text":"세스는","x":334,"y":1070,"width":101,"height":37},{"text":"준비","x":447,"y":1071,"width":64,"height":38},{"text":"큐의","x":528,"y":1071,"width":64,"height":38},{"text":"꼬리에","x":610,"y":1071,"width":99,"height":38},{"text":"넣어진다.","x":728,"y":1072,"width":144,"height":38},{"text":"그","x":888,"y":1077,"width":35,"height":26},{"text":"후","x":936,"y":1072,"width":36,"height":38},{"text":"CPU","x":984,"y":1075,"width":83,"height":30},{"text":"스케줄러는","x":1082,"y":1072,"width":170,"height":38},{"text":"준비","x":1264,"y":1072,"width":65,"height":37},{"text":"큐의","x":1347,"y":1072,"width":65,"height":37},{"text":"다음","x":1430,"y":1071,"width":67,"height":38},{"text":"프로세스를","x":1510,"y":1070,"width":171,"height":37}]},{"text":"선택할 것이다.","words":[{"text":"선택할","x":336,"y":1134,"width":100,"height":38},{"text":"것이다.","x":448,"y":1135,"width":107,"height":39}]},{"text":"종종 RR 정책하에서 평균대기 시간은 길다. 시간 0에 도작하는 아래 프로세스들의","words":[{"text":"종종","x":396,"y":1200,"width":68,"height":37},{"text":"RR","x":478,"y":1203,"width":51,"height":30},{"text":"정책하에서","x":545,"y":1199,"width":165,"height":39},{"text":"평균대기","x":730,"y":1199,"width":132,"height":39},{"text":"시간은","x":883,"y":1199,"width":103,"height":38},{"text":"길다.","x":1002,"y":1199,"width":74,"height":38},{"text":"시간","x":1094,"y":1200,"width":68,"height":38},{"text":"0에","x":1175,"y":1200,"widt