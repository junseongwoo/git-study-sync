{"page":410,"width":1678,"height":2484,"text_angle":0,"lines":[{"text":"470","words":[{"text":"470","x":155,"y":139,"width":58,"height":29}]},{"text":"Chapter 10 가상 메모리","words":[{"text":"Chapter","x":286,"y":143,"width":117,"height":28},{"text":"10","x":416,"y":145,"width":36,"height":22},{"text":"가상","x":481,"y":146,"width":41,"height":25},{"text":"메모리","x":531,"y":147,"width":61,"height":24}]},{"text":"간단한 예를 살펴보자. 메츠心리 세그먼트의 크기는 초기에 256 KB라고 가정하고 커","words":[{"text":"간단한","x":349,"y":266,"width":90,"height":35},{"text":"예를","x":452,"y":267,"width":59,"height":34},{"text":"살펴보자.","x":523,"y":266,"width":123,"height":35},{"text":"메츠心리","x":661,"y":267,"width":84,"height":34},{"text":"세그먼트의","x":762,"y":267,"width":145,"height":35},{"text":"크기는","x":923,"y":268,"width":92,"height":35},{"text":"초기에","x":1028,"y":267,"width":91,"height":35},{"text":"256","x":1134,"y":271,"width":55,"height":27},{"text":"KB라고","x":1205,"y":267,"width":115,"height":35},{"text":"가정하고","x":1336,"y":268,"width":129,"height":34},{"text":"커","x":1481,"y":269,"width":25,"height":34}]},{"text":"널이 21 KB의 메모리를 요구했다고 해보자. 세그먼트는 시, 사로 표시히는 128 KB 그","words":[{"text":"널이","x":291,"y":323,"width":56,"height":35},{"text":"21","x":362,"y":327,"width":32,"height":27},{"text":"KB의","x":408,"y":324,"width":73,"height":34},{"text":"메모리를","x":496,"y":324,"width":117,"height":35},{"text":"요구했다고","x":624,"y":324,"width":146,"height":34},{"text":"해보자.","x":782,"y":324,"width":94,"height":34},{"text":"세그먼트는","x":891,"y":324,"width":153,"height":34},{"text":"시,","x":1054,"y":328,"width":49,"height":34},{"text":"사로","x":1115,"y":328,"width":77,"height":34},{"text":"표시히는","x":1205,"y":324,"width":131,"height":35},{"text":"128","x":1350,"y":328,"width":54,"height":27},{"text":"KB","x":1418,"y":328,"width":48,"height":26},{"text":"그","x":1480,"y":329,"width":30,"height":23}]},{"text":"기의 두 개의 버tl(buddies)로 나누어진다. 그중 하니는 다시 두 개의 64 KB 그기의 버","words":[{"text":"기의","x":291,"y":381,"width":57,"height":35},{"text":"두","x":362,"y":383,"width":30,"height":32},{"text":"개의","x":406,"y":382,"width":54,"height":34},{"text":"버tl(buddies)로","x":476,"y":381,"width":228,"height":37},{"text":"나누어진다.","x":717,"y":381,"width":153,"height":34},{"text":"그중","x":884,"y":383,"width":61,"height":33},{"text":"하니는","x":956,"y":381,"width":93,"height":35},{"text":"다시","x":1061,"y":382,"width":59,"height":34},{"text":"두","x":1136,"y":384,"width":31,"height":32},{"text":"개의","x":1181,"y":381,"width":59,"height":35},{"text":"64","x":1256,"y":385,"width":37,"height":27},{"text":"KB","x":1306,"y":385,"width":49,"height":26},{"text":"그기의","x":1370,"y":381,"width":94,"height":34},{"text":"버","x":1481,"y":381,"width":26,"height":34}]},{"text":"CI(BL, BR)로 나누어진다. 그러나 21 KB의 기장 가끼운 2의 거듭제곱은 32 KB이므로","words":[{"text":"CI(BL,","x":290,"y":439,"width":83,"height":38},{"text":"BR)로","x":389,"y":441,"width":78,"height":35},{"text":"나누어진다.","x":482,"y":438,"width":151,"height":34},{"text":"그러나","x":649,"y":438,"width":88,"height":34},{"text":"21","x":749,"y":441,"width":30,"height":27},{"text":"KB의","x":796,"y":438,"width":73,"height":34},{"text":"기장","x":887,"y":438,"width":60,"height":35},{"text":"가끼운","x":961,"y":439,"width":92,"height":34},{"text":"2의","x":1066,"y":440,"width":48,"height":33},{"text":"거듭제곱은","x":1133,"y":439,"width":162,"height":34},{"text":"32","x":1309,"y":442,"width":37,"height":27},{"text":"KB이므로","x":1362,"y":438,"width":148,"height":34}]},{"text":"하 또는 BR은 다시 두 개의 32 KB 버디(CL, CR)들로 나뉜다. 이 중 하나의 버디가 21","words":[{"text":"하","x":290,"y":501,"width":33,"height":34},{"text":"또는","x":338,"y":498,"width":61,"height":32},{"text":"BR은","x":412,"y":497,"width":67,"height":37},{"text":"다시","x":491,"y":496,"width":55,"height":34},{"text":"두","x":562,"y":498,"width":30,"height":32},{"text":"개의","x":606,"y":496,"width":53,"height":34},{"text":"32","x":673,"y":499,"width":34,"height":28},{"text":"KB","x":721,"y":498,"width":44,"height":28},{"text":"버디(CL,","x":780,"y":495,"width":113,"height":37},{"text":"CR)들로","x":908,"y":497,"width":113,"height":36},{"text":"나뉜다.","x":1036,"y":496,"width":102,"height":34},{"text":"이","x":1156,"y":496,"width":27,"height":35},{"text":"중","x":1201,"y":498,"width":33,"height":33},{"text":"하나의","x":1249,"y":496,"width":95,"height":35},{"text":"버디가","x":1364,"y":495,"width":97,"height":35},{"text":"21","x":1475,"y":499,"width":32,"height":28}]},{"text":"KB 요구를 처리하기 위해 시용된다. 이 과정은 그림 10.26에 나타나 있다. 다이 21 KB","words":[{"text":"KB","x":289,"y":558,"width":45,"height":27},{"text":"요구를","x":347,"y":555,"width":91,"height":33},{"text":"처리하기","x":452,"y":554,"width":111,"height":34},{"text":"위해","x":579,"y":554,"width":55,"height":34},{"text":"시용된다.","x":648,"y":552,"width":122,"height":35},{"text":"이","x":785,"y":552,"width":25,"height":35},{"text":"과정은","x":825,"y":552,"width":90,"height":35},{"text":"그림","x":927,"y":553,"width":58,"height":34},{"text":"10.26에","x":1002,"y":553,"width":109,"height":35},{"text":"나타나","x":1128,"y":554,"width":97,"height":35},{"text":"있다.","x":1240,"y":554,"width":70,"height":34},{"text":"다이","x":1326,"y":553,"width":70,"height":38},{"text":"21","x":1411,"y":556,"width":35,"height":27},{"text":"KB","x":1462,"y":556,"width":47,"height":28}]},{"text":"요청을 위해 할당되었다,","words":[{"text":"요청을","x":289,"y":612,"width":91,"height":35},{"text":"위해","x":392,"y":611,"width":56,"height":34},{"text":"할당되었다,","x":461,"y":611,"width":152,"height":35}]},{"text":"버디 시스템의 이점 중 하나는 합병(coalescing)이라고 부르는 과정을 통해 서로 인","words":[{"text":"버디","x":347,"y":669,"width":54,"height":35},{"text":"시스템의","x":418,"y":669,"width":113,"height":35},{"text":"이점","x":547,"y":669,"width":53,"height":35},{"text":"중","x":614,"y":671,"width":29,"height":33},{"text":"하나는","x":654,"y":668,"width":87,"height":35},{"text":"합병(coalescing)이라고","x":752,"y":668,"width":336,"height":41},{"text":"부르는","x":1100,"y":671,"width":98,"height":33},{"text":"과정을","x":1210,"y":669,"width":100,"height":35},{"text":"통해","x":1322,"y":669,"width":64,"height":35},{"text":"서로","x":1402,"y":669,"width":64,"height":34},{"text":"인","x":1480,"y":670,"width":28,"height":34}]},{"text":"접한 버디들이 손쉽게 하나의 큰 세그먼트로 합쳐질 수 있다는 점이다. 그림 10.26에서","words":[{"text":"접한","x":291,"y":728,"width":59,"height":34},{"text":"버디들이","x":363,"y":727,"width":115,"height":35},{"text":"손쉽게","x":493,"y":728,"width":85,"height":34},{"text":"하나의","x":594,"y":726,"width":83,"height":36},{"text":"큰","x":692,"y":728,"width":29,"height":32},{"text":"세그먼트로","x":734,"y":726,"width":149,"height":34},{"text":"합쳐질","x":896,"y":727,"width":90,"height":35},{"text":"수","x":1001,"y":727,"width":31,"height":35},{"text":"있다는","x":1048,"y":728,"width":94,"height":34},{"text":"점이다.","x":1158,"y":728,"width":103,"height":35},{"text":"그림","x":1278,"y":728,"width":62,"height":34},{"text":"10.26에서","x":1360,"y":727,"width":146,"height":36}]},{"text":"커널이 CL을 해제하면 시스템은 다과 CR을 하나의 64 KB 세그먼트로 합칠 수 있다. 다","words":[{"text":"커널이","x":290,"y":785,"width":85,"height":36},{"text":"CL을","x":390,"y":785,"width":66,"height":38},{"text":"해제하면","x":468,"y":785,"width":114,"height":35},{"text":"시스템은","x":596,"y":785,"width":115,"height":35},{"text":"다과","x":721,"y":784,"width":66,"height":38},{"text":"CR을","x":798,"y":785,"width":69,"height":37},{"text":"하나의","x":878,"y":785,"width":88,"height":36},{"text":"64","x":981,"y":790,"width":35,"height":26},{"text":"KB","x":1028,"y":789,"width":47,"height":27},{"text":"세그먼트로","x":1089,"y":786,"width":164,"height":34},{"text":"합칠","x":1266,"y":786,"width":64,"height":34},{"text":"수","x":1345,"y":786,"width":33,"height":34},{"text":"있다.","x":1393,"y":785,"width":70,"height":35},{"text":"다","x":1478,"y":786,"width":32,"height":34}]},{"text":"시 이 하 세그먼트는 그의 버디 BR과 합쳐져 128 KB 세그먼트가 될 수 있다. 결국 다시","words":[{"text":"시","x":291,"y":845,"width":24,"height":34},{"text":"이","x":332,"y":844,"width":25,"height":34},{"text":"하","x":371,"y":847,"width":33,"height":34},{"text":"세그먼트는","x":418,"y":843,"width":145,"height":35},{"text":"그의","x":574,"y":843,"width":55,"height":35},{"text":"버디","x":644,"y":842,"width":52,"height":36},{"text":"BR과","x":712,"y":842,"width":66,"height":38},{"text":"합쳐져","x":789,"y":842,"width":86,"height":36},{"text":"128","x":891,"y":847,"width":50,"height":28},{"text":"KB","x":954,"y":847,"width":46,"height":27},{"text":"세그먼트가","x":1014,"y":843,"width":160,"height":36},{"text":"될","x":1187,"y":843,"width":29,"height":35},{"text":"수","x":1230,"y":844,"width":34,"height":35},{"text":"있다.","x":1280,"y":844,"width":71,"height":35},{"text":"결국","x":1368,"y":844,"width":65,"height":34},{"text":"다시","x":1446,"y":843,"width":59,"height":35}]},{"text":"원래의 256 KB 세그먼트로 돌아오게 된다.","words":[{"text":"원래의","x":290,"y":902,"width":85,"height":35},{"text":"256","x":388,"y":905,"width":50,"height":27},{"text":"KB","x":450,"y":904,"width":43,"height":27},{"text":"세그먼트로","x":507,"y":901,"width":144,"height":35},{"text":"돌아오게","x":661,"y":901,"width":115,"height":35},{"text":"된다.","x":790,"y":901,"width":66,"height":35}]},{"text":"버디 시스템의 분명한 단점은 가장 가까운 2의 거듭제곱으로의 올림이 할당된 세그","words":[{"text":"버디","x":346,"y":960,"width":53,"height":34},{"text":"시스템의","x":417,"y":959,"width":113,"height":34},{"text":"분명한","x":544,"y":960,"width":88,"height":34},{"text":"단점은","x":644,"y":959,"width":87,"height":34},{"text":"가장","x":744,"y":959,"width":59,"height":35},{"text":"가까운","x":816,"y":960,"width":90,"height":35},{"text":"2의","x":917,"y":961,"width":45,"height":34},{"text":"거듭제곱으로의","x":980,"y":961,"width":219,"height":35},{"text":"올림이","x":1216,"y":961,"width":97,"height":35},{"text":"할당된","x":1331,"y":960,"width":99,"height":35},{"text":"세그","x":1445,"y":960,"width":64,"height":34}]},{"text":"먼트 내의 단편화를 가져온다는 것이다. 예를 들면, 33 KB 요청은 64 KB 세그먼트에","words":[{"text":"먼트","x":290,"y":1019,"width":58,"height":34},{"text":"내의","x":363,"y":1017,"width":55,"height":35},{"text":"단편화를","x":433,"y":1017,"width":118,"height":34},{"text":"가져온다는","x":566,"y":1017,"width":144,"height":35},{"text":"것이다.","x":726,"y":1017,"width":93,"height":35},{"text":"예를","x":837,"y":1019,"width":59,"height":35},{"text":"들면,","x":910,"y":1019,"width":69,"height":35},{"text":"33","x":995,"y":1023,"width":34,"height":27},{"text":"KB","x":1045,"y":1023,"width":47,"height":26},{"text":"요청은","x":1109,"y":1019,"width":99,"height":34},{"text":"64","x":1223,"y":1023,"width":36,"height":27},{"text":"KB","x":1276,"y":1023,"width":51,"height":26},{"text":"세그먼트에","x":1344,"y":1018,"width":162,"height":36}]},{"text":"의해 만족할 수 있다. 실제로 할당된 세그먼트의 50% 이하의 메모리만이 내부 단편화에","words":[{"text":"의해","x":289,"y":1077,"width":57,"height":35},{"text":"만족할","x":359,"y":1075,"width":89,"height":35},{"text":"수","x":457,"y":1075,"width":31,"height":35},{"text":"있다.","x":500,"y":1075,"width":62,"height":35},{"text":"실제로","x":576,"y":1075,"width":86,"height":35},{"text":"할당된","x":673,"y":1076,"width":87,"height":34},{"text":"세그먼트의","x":773,"y":1077,"width":148,"height":35},{"text":"50%","x":935,"y":1080,"width":64,"height":28},{"text":"이하의","x":1014,"y":1077,"width":90,"height":35},{"text":"메모리만이","x":1120,"y":1077,"width":161,"height":35},{"text":"내부","x":1299,"y":1077,"width":66,"height":35},{"text":"단편화에","x":1378,"y":1076,"width":128,"height":34}]},{"text":"의해 낭비된다는 것도 보장할 수 없다. 다음 절에서 단편화에 의한 메모리 당비가 발생","words":[{"text":"의해","x":290,"y":1135,"width":55,"height":35},{"text":"낭비된다는","x":361,"y":1133,"width":146,"height":36},{"text":"것도","x":521,"y":1134,"width":57,"height":34},{"text":"보장할","x":590,"y":1134,"width":88,"height":34},{"text":"수","x":690,"y":1134,"width":30,"height":34},{"text":"없다.","x":735,"y":1134,"width":63,"height":35},{"text":"다음","x":815,"y":1136,"width":60,"height":34},{"text":"절에서","x":889,"y":1135,"width":86,"height":35},{"text":"단편화에","x":993,"y":1135,"width":124,"height":35},{"text":"의한","x":1135,"y":1135,"width":65,"height":34},{"text":"메모리","x":1215,"y":1135,"width":95,"height":34},{"text":"당비가","x":1330,"y":1134,"width":101,"height":35},{"text":"발생","x":1445,"y":1134,"width":61,"height":34}]},{"text":"하지 않는 할당 방법에 대해 알아본다.","words":[{"text":"하지","x":289,"y":1193,"width":55,"height":35},{"text":"않는","x":359,"y":1193,"width":58,"height":35},{"text":"할당","x":426,"y":1192,"width":60,"height":35},{"text":"방법에","x":496,"y":1192,"width":84,"height":35},{"text":"대해","x":594,"y":1192,"width":55,"height":34},{"text":"알아본다.","x":663,"y":1192,"width":124,"height":36}]},{"text":"10.8.2 술램 할당 S1ab A110cation","words":[{"text":"10.8.2","x":288,"y":1302,"width":132,"height":30},{"text":"술램","x":456,"y":1301,"width":54,"height":32},{"text":"할당","x":521,"y":1301,"width":55,"height":32},{"text":"S1ab","x":597,"y":1310,"width":59,"height":20},{"text":"A110cation","x":664,"y":1310,"width":135,"height":21}]},{"text":"두 번째 커널 메모리 할당 정책은 슬랩 할당이라고 불린다. 슬랩(slab)은 하나 또는 그","words":[{"text":"두","x":289,"y":1376,"width":30,"height":32},{"text":"번째","x":334,"y":1373,"width":55,"height":35},{"text":"커널","x":406,"y":1373,"width":55,"height":35},{"text":"메모리","x":477,"y":1373,"width":83,"height":35},{"text":"할당","x":576,"y":1373,"width":59,"height":35},{"text":"정책은","x":649,"y":1373,"width":88,"height":35},{"text":"슬랩","x":750,"y":1373,"width":57,"height":34},{"text":"할당이라고","x":823,"y":1372,"width":151,"height":35},{"text":"불린다.","x":988,"y":1371,"width":101,"height":35},{"text":"슬랩(slab)은","x":1106,"y":1371,"width":193,"height":37},{"text":"하나","x":1314,"y":1370,"width":68,"height":35},{"text":"또는","x":1396,"y":1371,"width":67,"height":31},{"text":"그","x":1477,"y":1374,"width":32,"height":23}]},{"text":"이상의 연속된 페이지들로 구성된다. 개시(cache)는 하나 혹은 그 이상의 슬랩들로 구","words":[{"text":"이상의","x":291,"y":1432,"width":85,"height":35},{"text":"연속된","x":394,"y":1432,"width":85,"height":34},{"text":"페이지들로","x":494,"y":1432,"width":145,"height":34},{"text":"구성된다.","x":652,"y":1431,"width":124,"height":34},{"text":"개시(cache)는","x":794,"y":1430,"width":199,"height":37},{"text":"하나","x":1008,"y":1429,"width":62,"height":34},{"text":"혹은","x":1084,"y":1430,"width":66,"height":33},{"text":"그","x":1164,"y":1434,"width":33,"height":23},{"text":"이상의","x