,"x":906,"y":602,"width":48,"height":27},{"text":"페이지가공존하는","x":963,"y":600,"width":206,"height":28},{"text":"NAND","x":1179,"y":601,"width":81,"height":22},{"text":"블록","x":1271,"y":599,"width":52,"height":26}]},{"text":"다. 이 경우 쓰기는 지우기가 발생할 때까지 기다린 다음 쓰기가 수행될 수 있다. 그러나","words":[{"text":"다.","x":309,"y":726,"width":36,"height":34},{"text":"이","x":360,"y":727,"width":25,"height":34},{"text":"경우","x":403,"y":727,"width":57,"height":34},{"text":"쓰기는","x":472,"y":727,"width":88,"height":33},{"text":"지우기가","x":572,"y":726,"width":115,"height":35},{"text":"발생할","x":698,"y":726,"width":87,"height":35},{"text":"때까지","x":797,"y":726,"width":83,"height":34},{"text":"기다린","x":897,"y":726,"width":87,"height":34},{"text":"다음","x":998,"y":726,"width":61,"height":34},{"text":"쓰기가","x":1070,"y":725,"width":97,"height":35},{"text":"수행될","x":1177,"y":725,"width":98,"height":35},{"text":"수","x":1290,"y":725,"width":34,"height":35},{"text":"있다.","x":1338,"y":724,"width":70,"height":35},{"text":"그러나","x":1424,"y":723,"width":95,"height":36}]},{"text":"A卜§ 가-능한 블록이 없으면 어떻게 해야 할까? 개별 페이지에 유효하지 않은 데이터가","words":[{"text":"A卜§","x":308,"y":784,"width":61,"height":35},{"text":"가-능한","x":383,"y":784,"width":89,"height":35},{"text":"블록이","x":484,"y":784,"width":85,"height":34},{"text":"없으면","x":587,"y":784,"width":83,"height":34},{"text":"어떻게","x":687,"y":784,"width":84,"height":34},{"text":"해야","x":787,"y":784,"width":59,"height":34},{"text":"할까?","x":858,"y":784,"width":73,"height":35},{"text":"개별","x":948,"y":784,"width":57,"height":34},{"text":"페이지에","x":1022,"y":783,"width":122,"height":35},{"text":"유효하지","x":1161,"y":783,"width":129,"height":34},{"text":"않은","x":1310,"y":783,"width":66,"height":35},{"text":"데이터가","x":1392,"y":781,"width":127,"height":35}]},{"text":"있으면 여전히 시용 가능한 공간이 있을 수 있다. 이 경우 가비지 수집이 발생할 수 있다.","words":[{"text":"있으면","x":309,"y":842,"width":87,"height":34},{"text":"여전히","x":410,"y":841,"width":84,"height":35},{"text":"시용","x":508,"y":842,"width":58,"height":35},{"text":"가능한","x":577,"y":841,"width":87,"height":35},{"text":"공간이","x":673,"y":841,"width":84,"height":35},{"text":"있을","x":773,"y":841,"width":57,"height":35},{"text":"수","x":840,"y":842,"width":30,"height":34},{"text":"있다.","x":883,"y":842,"width":63,"height":34},{"text":"이","x":961,"y":841,"width":25,"height":35},{"text":"경우","x":1002,"y":841,"width":60,"height":35},{"text":"가비지","x":1074,"y":841,"width":91,"height":34},{"text":"수집이","x":1181,"y":841,"width":95,"height":35},{"text":"발생할","x":1293,"y":840,"width":100,"height":35},{"text":"수","x":1403,"y":840,"width":34,"height":34},{"text":"있다.","x":1450,"y":840,"width":67,"height":34}]},{"text":"유효한 데이터를 다른 위치로 복사하여 지울 수 있는 블록-을 비운 다음 쓰기를 받아들일","words":[{"text":"유효한","x":306,"y":899,"width":92,"height":35},{"text":"데이터를","x":409,"y":899,"width":118,"height":35},{"text":"다른","x":537,"y":899,"width":58,"height":35},{"text":"위치로","x":606,"y":898,"width":87,"height":36},{"text":"복사하여","x":704,"y":899,"width":113,"height":35},{"text":"지울","x":833,"y":899,"width":58,"height":35},{"text":"수","x":902,"y":899,"width":31,"height":35},{"text":"있는","x":946,"y":899,"width":58,"height":34},{"text":"블록-을","x":1016,"y":899,"width":94,"height":34},{"text":"비운","x":1124,"y":898,"width":63,"height":35},{"text":"다음","x":1200,"y":899,"width":66,"height":34},{"text":"쓰기를","x":1278,"y":898,"width":100,"height":35},{"text":"받아들일","x":1390,"y":898,"width":126,"height":34}]},{"text":"수 있다. 그러나 가비지 수집은 유효한 데이터를 어디에 저장해야 할까? 이 문제를 해결","words":[{"text":"수","x":305,"y":957,"width":31,"height":35},{"text":"있다.","x":350,"y":957,"width":64,"height":35},{"text":"그러나","x":428,"y":958,"width":89,"height":34},{"text":"가비지","x":528,"y":957,"width":83,"height":35},{"text":"수집은","x":625,"y":957,"width":89,"height":35},{"text":"유효한","x":724,"y":957,"width":89,"height":34},{"text":"데이터를","x":825,"y":958,"width":119,"height":34},{"text":"어디에","x":957,"y":957,"width":88,"height":34},{"text":"저장해야","x":1061,"y":957,"width":128,"height":34},{"text":"할까?","x":1201,"y":957,"width":81,"height":34},{"text":"이","x":1299,"y":957,"width":28,"height":34},{"text":"문제를","x":1344,"y":956,"width":99,"height":34},{"text":"해결","x":1457,"y":956,"width":58,"height":34}]},{"text":"하고 쓰기 성능을 향상하기 위해 NVM 장치는 과잉 공급(over-provisioning)을 사용","words":[{"text":"하고","x":306,"y":1015,"width":59,"height":35},{"text":"쓰기","x":377,"y":1015,"width":56,"height":35},{"text":"성능을","x":450,"y":1016,"width":87,"height":34},{"text":"향상하기","x":549,"y":1015,"width":112,"height":35},{"text":"위해","x":678,"y":1015,"width":55,"height":35},{"text":"NVM","x":747,"y":1018,"width":84,"height":27},{"text":"장치는","x":844,"y":1015,"width":91,"height":35},{"text":"과잉","x":946,"y":1015,"width":58,"height":35},{"text":"공급(over-provisioning)을","x":1020,"y":1015,"width":422,"height":40},{"text":"사용","x":1456,"y":1014,"width":62,"height":35}]},{"text":"한다. 장치는 언제나 쓸 수 있도록 다수의 페이지(종종 전체 용량의 20%)를 따로 준비해","words":[{"text":"한다.","x":304,"y":1073,"width":67,"height":35},{"text":"장치는","x":385,"y":1073,"width":88,"height":36},{"text":"언제나","x":485,"y":1073,"width":87,"height":35},{"text":"쓸","x":581,"y":1074,"width":30,"height":33},{"text":"수","x":620,"y":1073,"width":30,"height":35},{"text":"있도록","x":662,"y":1072,"width":87,"height":36},{"text":"다수의","x":758,"y":1073,"width":86,"height":35},{"text":"페이지(종종","x":859,"y":1073,"width":163,"height":38},{"text":"전체","x":1034,"y":1072,"width":58,"height":35},{"text":"용량의","x":1106,"y":1073,"width":95,"height":34},{"text":"20%)를","x":1216,"y":1074,"width":117,"height":36},{"text":"따로","x":1346,"y":1073,"width":65,"height":34},{"text":"준비해","x":1422,"y":1072,"width":93,"height":35}]},{"text":"놓는다. 가비지 수집 혹은 이전 버전의 데이터를 무효화시기는 쓰기 연산에 의해 무효화","words":[{"text":"놓는다.","x":303,"y":1132,"width":97,"height":35},{"text":"가비지","x":414,"y":1131,"width":85,"height":35},{"text":"수집","x":512,"y":1132,"width":56,"height":34},{"text":"혹은","x":581,"y":1132,"width":59,"height":34},{"text":"이전","x":653,"y":1131,"width":55,"height":35},{"text":"버전의","x":723,"y":1131,"width":83,"height":35},{"text":"데이터를","x":822,"y":1132,"width":120,"height":34},{"text":"무효화시기는","x":952,"y":1131,"width":189,"height":35},{"text":"쓰기","x":1154,"y":1131,"width":60,"height":35},{"text":"연산에","x":1234,"y":1131,"width":94,"height":35},{"text":"의해","x":1345,"y":1131,"width":62,"height":35},{"text":"무효화","x":1422,"y":1131,"width":97,"height":34}]},{"text":"된 블록은 장치가 꽉 찼을 경우에는 삭제되어 과잉 공급 공간에 배치되고 그렇지 않은","words":[{"text":"된","x":304,"y":1190,"width":28,"height":34},{"text":"블록은","x":347,"y":1190,"width":91,"height":34},{"text":"장치가","x":450,"y":1190,"width":89,"height":34},{"text":"꽉","x":549,"y":1190,"width":32,"height":34},{"text":"찼을","x":593,"y":1189,"width":58,"height":35},{"text":"경우에는","x":666,"y":1189,"width":117,"height":35},{"text":"삭제되어","x":795,"y":1189,"width":117,"height":35},{"text":"과잉","x":930,"y":1189,"width":57,"height":35},{"text":"공급","x":1004,"y":1191,"width":63,"height":32},{"text":"공간에","x":1080,"y":1189,"width":96,"height":35},{"text":"배치되고","x":1195,"y":1189,"width":131,"height":35},{"text":"그렇지","x":1342,"y":1189,"width":95,"height":35},{"text":"않은","x":1456,"y":1189,"width":62,"height":34}]},{"text":"경우에는 삭제되어 기용 풀로 되돌아간다.","words":[{"text":"경우에는","x":305,"y":1248,"width":119,"height":35},{"text":"삭제되어","x":433,"y":1248,"width":113,"height":35},{"text":"기용","x":561,"y":1248,"width":58,"height":35},{"text":"풀로","x":627,"y":1249,"width":59,"height":32},{"text":"되돌아간다.","x":697,"y":1247,"width":155,"height":36}]},{"text":"과잉 공급 공간은 마모 평준회(wear levehng)에도 도움이 된다. 다른 블록에 비","words":[{"text":"과잉","x":359,"y":1306,"width":56,"height":36},{"text":"공급","x":433,"y":1309,"width":60,"height":32},{"text":"공간은","x":505,"y":1306,"width":89,"height":35},{"text":"마모","x":607,"y":1306,"width":59,"height":35},{"text":"평준회(wear","x":680,"y":1306,"width":176,"height":37},{"text":"levehng)에도","x":870,"y":1305,"width":201,"height":40},{"text":"도움이","x":1086,"y":1306,"width":93,"height":34},{"text":"된다.","x":1200,"y":1306,"width":72,"height