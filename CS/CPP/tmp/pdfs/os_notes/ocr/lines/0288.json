,"height":37},{"text":"둔","x":899,"y":411,"width":33,"height":33},{"text":"알고리즘을","x":947,"y":408,"width":161,"height":37},{"text":"구현하는","x":1122,"y":409,"width":130,"height":36},{"text":"데","x":1268,"y":409,"width":28,"height":36},{"text":"A卜%된다.","x":1314,"y":409,"width":139,"height":37},{"text":"이러한","x":1472,"y":409,"width":98,"height":37}]},{"text":"언어에서 알고리즘의 흐름은 올바른 동작에 필수적이고 상태는 변수와 다른 자료구조를","words":[{"text":"언어에서","x":279,"y":467,"width":132,"height":37},{"text":"알고리즘의","x":430,"y":467,"width":162,"height":37},{"text":"흐름은","x":609,"y":470,"width":97,"height":34},{"text":"올바른","x":718,"y":469,"width":95,"height":35},{"text":"동작에","x":825,"y":469,"width":92,"height":36},{"text":"필수적이고","x":934,"y":469,"width":159,"height":36},{"text":"상태는","x":1105,"y":469,"width":99,"height":36},{"text":"변수와","x":1218,"y":469,"width":98,"height":37},{"text":"다른","x":1328,"y":470,"width":66,"height":36},{"text":"자료구조를","x":1406,"y":470,"width":163,"height":36}]},{"text":"통해서 표현된다. 물론 변수는 시간이 지남에 따라 다른 값을 배정받을 수 있기 때문에","words":[{"text":"통해서","x":276,"y":527,"width":100,"height":37},{"text":"표현된다.","x":396,"y":527,"width":142,"height":36},{"text":"물론","x":555,"y":530,"width":67,"height":33},{"text":"변수는","x":638,"y":528,"width":94,"height":36},{"text":"시간이","x":747,"y":529,"width":90,"height":37},{"text":"지남에","x":857,"y":529,"width":90,"height":36},{"text":"따라","x":965,"y":529,"width":64,"height":37},{"text":"다른","x":1043,"y":530,"width":64,"height":36},{"text":"값을","x":1122,"y":529,"width":64,"height":36},{"text":"배정받을","x":1201,"y":530,"width":130,"height":36},{"text":"수","x":1345,"y":531,"width":33,"height":36},{"text":"있기","x":1395,"y":531,"width":57,"height":36},{"text":"때문에","x":1472,"y":531,"width":94,"height":37}]},{"text":"프로그램 상대는 변경할 수 있다.","words":[{"text":"프로그램","x":276,"y":587,"width":135,"height":35},{"text":"상대는","x":427,"y":587,"width":102,"height":36},{"text":"변경할","x":544,"y":588,"width":96,"height":36},{"text":"수","x":651,"y":589,"width":33,"height":35},{"text":"있다.","x":697,"y":589,"width":68,"height":35}]},{"text":"다중 고어 시스템에서 병행 및 병렬 프로그래밍이 주목받으면서 함수형 프로그래밍","words":[{"text":"다중","x":342,"y":648,"width":69,"height":35},{"text":"고어","x":425,"y":648,"width":64,"height":35},{"text":"시스템에서","x":508,"y":648,"width":159,"height":36},{"text":"병행","x":687,"y":649,"width":58,"height":36},{"text":"및","x":764,"y":649,"width":27,"height":36},{"text":"병렬","x":809,"y":650,"width":59,"height":35},{"text":"프로그래밍이","x":883,"y":650,"width":188,"height":37},{"text":"주목받으면서","x":1088,"y":650,"width":191,"height":38},{"text":"함수형","x":1296,"y":651,"width":94,"height":37},{"text":"프로그래밍","x":1408,"y":652,"width":157,"height":36}]},{"text":"언어에 대한 관심도 커지고 있다. 함수형 프로그래밍 언어는 명령형 언어가 제공하는 패","words":[{"text":"언어에","x":279,"y":708,"width":98,"height":36},{"text":"대한","x":396,"y":708,"width":67,"height":36},{"text":"관심도","x":476,"y":708,"width":100,"height":36},{"text":"커지고","x":592,"y":709,"width":95,"height":35},{"text":"있다.","x":702,"y":709,"width":68,"height":35},{"text":"함수형","x":786,"y":710,"width":91,"height":36},{"text":"프로그래밍","x":894,"y":711,"width":156,"height":36},{"text":"언어는","x":1069,"y":711,"width":94,"height":36},{"text":"명령형","x":1177,"y":711,"width":91,"height":36},{"text":"언어가","x":1288,"y":712,"width":96,"height":35},{"text":"제공하는","x":1396,"y":712,"width":128,"height":35},{"text":"패","x":1537,"y":713,"width":29,"height":34}]},{"text":"러다임과는 많이 다른 패러다임을 따른다. 근본적인 차이는 함수형 언어는 상태를 유지","words":[{"text":"러다임과는","x":280,"y":769,"width":170,"height":36},{"text":"많이","x":465,"y":769,"width":63,"height":36},{"text":"다른","x":547,"y":769,"width":66,"height":36},{"text":"패러다임을","x":627,"y":769,"width":162,"height":37},{"text":"따른다.","x":802,"y":770,"width":102,"height":36},{"text":"근본적인","x":921,"y":771,"width":127,"height":35},{"text":"차이는","x":1064,"y":771,"width":95,"height":36},{"text":"함수형","x":1172,"y":771,"width":93,"height":36},{"text":"언어는","x":1286,"y":772,"width":95,"height":35},{"text":"상태를","x":1394,"y":771,"width":97,"height":36},{"text":"유지","x":1504,"y":772,"width":61,"height":35}]},{"text":"하지 않는다는 것이다. 즉, 변수가 정의되어 값을 배정받으면 그 값은 변경될 수 없기 때","words":[{"text":"하지","x":277,"y":829,"width":65,"height":36},{"text":"않는다는","x":360,"y":830,"width":137,"height":36},{"text":"것이다.","x":512,"y":829,"width":104,"height":36},{"text":"즉,","x":632,"y":832,"width":40,"height":35},{"text":"변수가","x":689,"y":830,"width":95,"height":36},{"text":"정의되어","x":797,"y":830,"width":123,"height":36},{"text":"값을","x":937,"y":831,"width":64,"height":35},{"text":"배정받으면","x":1014,"y":831,"width":158,"height":36},{"text":"그","x":1185,"y":835,"width":33,"height":24},{"text":"값은","x":1230,"y":831,"width":65,"height":34},{"text":"변경될","x":1309,"y":831,"width":93,"height":35},{"text":"수","x":1416,"y":831,"width":32,"height":34},{"text":"없기","x":1463,"y":831,"width":57,"height":35},{"text":"때","x":1537,"y":831,"width":28,"height":35}]},{"text":"문에 변하지 않는다. 함수형 언어는 변경 가능 상태를 허용하지 않기 때문에 경쟁 조건","words":[{"text":"문에","x":276,"y":890,"width":66,"height":35},{"text":"변하지","x":363,"y":890,"width":97,"height":36},{"text":"않는다.","x":481,"y":890,"width":106,"height":36},{"text":"함수형","x":604,"y":890,"width":94,"height":37},{"text":"언어는","x":719,"y":890,"width":95,"height":36},{"text":"변경","x":830,"y":891,"width":57,"height":35},{"text":"가능","x":907,"y":891,"width":64,"height":35},{"text":"상태를","x":984,"y":891,"width":97,"height":35},{"text":"허용하지","x":1096,"y":890,"width":123,"height":36},{"text":"않기","x":1238,"y":890,"width":59,"height":35},{"text":"때문에","x":1317,"y":890,"width":93,"height":35},{"text":"경쟁","x":1429,"y":889,"width":58,"height":35},{"text":"조건","x":1505,"y":890,"width":63,"height":35}]},{"text":"이나 교착 상태와 같은 쟁점에 대해 신경 쓸 필요가 없다. 근본적으로 본 장에서 논의된","words":[{"text":"이나","x":278,"y":950,"width":68,"height":36},{"text":"교착","x":360,"y":951,"width":69,"height":35},{"text":"상태와","x":442,"y":950,"width":104,"height":36},{"text":"같은","x":558,"y":951,"width":67,"height":34},{"text":"쟁점에","x":639,"y":951,"width":93,"height":36},{"text":"대해","x":749,"y":951,"width":61,"height":35},{"text":"신경","x":827,"y":951,"width":59,"height":35},{"text":"쓸","x":903,"y":951,"width":33,"height":34},{"text":"필요가","x":950,"y":950,"width":96,"height":35},{"text":"없다.","x":1061,"y":950,"width":68,"height":35},{"text":"근본적으로","x":1144,"y":949,"width":162,"height":35},{"text":"본","x":1318,"y":950,"width":34,"height":33},{"text":"장에서","x":1364,"y":948,"width":92,"height":36},{"text":"논의된","x":1472,"y":949,"width":96,"height":35}]},{"text":"대부분의 문제는 함수형 언어에서는 존재하지 않는다.","words":[{"text":"대부분의","x":278,"y":1010,"width":132,"height":36},{"text":"문제는","x":426,"y":1011,"width":104,"height":36},{"text":"함수형","x":541,"y":1011,"width":95,"height":36},{"text":"언어에서는","x":655,"y":1011,"width":161,"height":36},{"text":"존재하지","x":826,"y":1010,"width":126,"height":36},{"text":"않는다.","x":969,"y":1010,"width":103,"height":36}]},{"text":"현재 여러 한수형 언어가 시용되고 있으며 여기서는 그 중 Erlang과 Scala 두 개의","words":[{"text":"현재","x":341,"y":1071,"width":65,"height":36},{"text":"여러","x":425,"y":1072,"width":62,"height":35},{"text":"한수형","x":505,"y":1071,"width":95,"height":35},{"text":"언어가","x":621,"y":1071,"width":97,"height":36},{"text":"시용되고","x":729,"y":1070,"width":131,"height":36},{"text":"있으며","x":875,"y":1070,"width":91,"height":36},{"text":"여기서는","x":984,"y":1069,"width":128,"height":36},{"text":"그","x":1124,"y":1073,"width":32,"height":25},{"text":"중","x":1168,"y":1070,"width":32,"height":33},{"text":"Erlang과","x":1212,"y":1067,"width":142,"height":41},{"text":"Scala","x":1365,"y":1069,"width":82,"height":29},{"text":"두","x":1461,"y":1068,"width":34,"height":34},{"text":"개의","x":1507,"y":1067,"width":60,"height":36}]},{"text":"언어에 대해서만 간단히 언급한다. Erlang 언어는 병행성과 병렬 시스템에서 실행되는","words":[{"text":"언어에","x":279,"y":1131,"width":97,"height":37},{"text":"대해서만","x":395,"y":1131,"width":136,"height":37},{"text":"간단히","x":545,"y":1131,"width":95,"height":36},{"text":"언급한다.","x":662,"y":1130,"width":134,"height":37},{"text":"Erlang","