x":1479,"y":487,"width":30,"height":33}]},{"text":"는다. 연속적이지 않은 소스 및 대상 주소 목록 등 명령 블록은 더 복잡할 수 있다. 이 분","words":[{"text":"는다.","x":301,"y":543,"width":67,"height":33},{"text":"연속적이지","x":384,"y":541,"width":141,"height":35},{"text":"않은","x":540,"y":542,"width":58,"height":34},{"text":"소스","x":609,"y":545,"width":58,"height":26},{"text":"및","x":680,"y":544,"width":24,"height":33},{"text":"대상","x":718,"y":544,"width":58,"height":34},{"text":"주소","x":786,"y":546,"width":59,"height":31},{"text":"목록","x":856,"y":546,"width":59,"height":31},{"text":"등","x":926,"y":545,"width":31,"height":33},{"text":"명령","x":970,"y":544,"width":55,"height":33},{"text":"블록은","x":1040,"y":544,"width":95,"height":32},{"text":"더","x":1149,"y":544,"width":25,"height":34},{"text":"복잡할","x":1191,"y":544,"width":100,"height":33},{"text":"수","x":1302,"y":544,"width":34,"height":33},{"text":"있다.","x":1351,"y":544,"width":71,"height":33},{"text":"이","x":1438,"y":543,"width":26,"height":33},{"text":"분","x":1480,"y":544,"width":31,"height":31}]},{"text":"산-수집(scatter-gather) 방법을 시용하면 하나의 DMA 명령을 통해 여러 개의 전송","words":[{"text":"산-수집(scatter-gather)","x":300,"y":600,"width":356,"height":38},{"text":"방법을","x":669,"y":600,"width":88,"height":33},{"text":"시용하면","x":768,"y":600,"width":116,"height":34},{"text":"하나의","x":897,"y":600,"width":87,"height":34},{"text":"DMA","x":1000,"y":603,"width":87,"height":26},{"text":"명령을","x":1103,"y":600,"width":96,"height":34},{"text":"통해","x":1211,"y":600,"width":64,"height":33},{"text":"여러","x":1292,"y":600,"width":61,"height":34},{"text":"개의","x":1372,"y":600,"width":60,"height":34},{"text":"전송","x":1451,"y":600,"width":60,"height":33}]},{"text":"을 실행할 수 있다. 그리고 CPU는 이 DMA 명령 블록의 주소를 DMA에게 알려주고","words":[{"text":"을","x":299,"y":655,"width":32,"height":33},{"text":"실행할","x":345,"y":655,"width":90,"height":34},{"text":"수","x":446,"y":656,"width":30,"height":33},{"text":"있다.","x":489,"y":654,"width":62,"height":34},{"text":"그리고","x":566,"y":655,"width":87,"height":33},{"text":"CPU는","x":664,"y":657,"width":101,"height":32},{"text":"이","x":778,"y":656,"width":24,"height":34},{"text":"DMA","x":818,"y":659,"width":84,"height":27},{"text":"명령","x":918,"y":656,"width":54,"height":34},{"text":"블록의","x":989,"y":656,"width":90,"height":33},{"text":"주소를","x":1096,"y":658,"width":97,"height":32},{"text":"DMA에게","x":1206,"y":657,"width":160,"height":33},{"text":"알려주고","x":1384,"y":656,"width":127,"height":34}]},{"text":"자신은 다른 일을 한다. 그러면 DMA는 CPU의 도움 없이도 자신이 직접 버스를 통해","words":[{"text":"자신은","x":299,"y":711,"width":93,"height":34},{"text":"다른","x":404,"y":712,"width":59,"height":34},{"text":"일을","x":477,"y":711,"width":56,"height":33},{"text":"한다.","x":544,"y":711,"width":64,"height":34},{"text":"그러면","x":622,"y":712,"width":86,"height":34},{"text":"DMA는","x":721,"y":714,"width":114,"height":31},{"text":"CPU의","x":846,"y":713,"width":99,"height":34},{"text":"도움","x":961,"y":713,"width":62,"height":32},{"text":"없이도","x":1038,"y":713,"width":92,"height":33},{"text":"자신이","x":1144,"y":713,"width":94,"height":33},{"text":"직접","x":1257,"y":713,"width":61,"height":33},{"text":"버스를","x":1338,"y":713,"width":98,"height":34},{"text":"통해","x":1448,"y":713,"width":60,"height":33}]},{"text":"DMA 명령 블록을 액세스하여 입출력을 수행하게 된다. 스마트폰에서부터 메인프레임","words":[{"text":"DMA","x":299,"y":771,"width":87,"height":28},{"text":"명령","x":401,"y":768,"width":54,"height":34},{"text":"블록을","x":470,"y":768,"width":87,"height":33},{"text":"액세스하여","x":570,"y":768,"width":141,"height":35},{"text":"입출력을","x":729,"y":769,"width":115,"height":33},{"text":"수행하게","x":856,"y":769,"width":117,"height":34},{"text":"된다.","x":990,"y":769,"width":67,"height":34},{"text":"스마트폰에서부터","x":1073,"y":769,"width":259,"height":34},{"text":"메인프레임","x":1351,"y":769,"width":156,"height":34}]},{"text":"까지 현대의 모든 컴퓨터는 간단한 DMA 컨트롤러를 표준 구성요소로 가지고 있다.","words":[{"text":"까지","x":300,"y":825,"width":57,"height":35},{"text":"현대의","x":372,"y":824,"width":85,"height":35},{"text":"모든","x":470,"y":826,"width":58,"heig