s":[{"text":"테이블의","x":292,"y":1279,"width":117,"height":34},{"text":"위치를","x":425,"y":1278,"width":87,"height":34},{"text":"저장하는","x":525,"y":1278,"width":117,"height":34},{"text":"데","x":654,"y":1278,"width":26,"height":33},{"text":"사용할","x":696,"y":1279,"width":90,"height":33},{"text":"수","x":798,"y":1279,"width":31,"height":33},{"text":"있다.","x":844,"y":1278,"width":64,"height":34},{"text":"이렇게","x":926,"y":1279,"width":90,"height":34},{"text":"하면","x":1032,"y":1280,"width":63,"height":34},{"text":"필요할","x":1112,"y":1280,"width":98,"height":34},{"text":"때","x":1224,"y":1281,"width":28,"height":34},{"text":"메모리로","x":1271,"y":1281,"width":133,"height":33},{"text":"테이블","x":1419,"y":1280,"width":95,"height":34}]},{"text":"을 가져올 수 있다.","words":[{"text":"을","x":290,"y":1336,"width":32,"height":34},{"text":"가져올","x":333,"y":1336,"width":89,"height":34},{"text":"수","x":431,"y":1336,"width":31,"height":32},{"text":"있다.","x":473,"y":1334,"width":62,"height":34}]},{"text":"소프트웨어 개발지들은 IA-32 구조의 4 GB 메모리 제한이 문제가 된다고 인식하기","words":[{"text":"소프트웨어","x":348,"y":1391,"width":143,"height":33},{"text":"개발지들은","x":506,"y":1391,"width":145,"height":33},{"text":"IA-32","x":660,"y":1394,"width":84,"height":27},{"text":"구조의","x":755,"y":1391,"width":87,"height":33},{"text":"4","x":856,"y":1396,"width":17,"height":25},{"text":"GB","x":885,"y":1394,"width":48,"height":27},{"text":"메모리","x":947,"y":1392,"width":89,"height":35},{"text":"제한이","x":1053,"y":1394,"width":92,"height":34},{"text":"문제가","x":1161,"y":1394,"width":100,"height":34},{"text":"된다고","x":1273,"y":1394,"width":99,"height":33},{"text":"인식하기","x":1387,"y":1393,"width":123,"height":33}]},{"text":"시작했을 때 lntel은 32-비트 처리기가 4 GB 보다 큰 물리 주소 공간에 접근할 수 있게","words":[{"text":"시작했을","x":293,"y":1449,"width":118,"height":34},{"text":"때","x":422,"y":1448,"width":26,"height":34},{"text":"lntel은","x":461,"y":1448,"width":98,"height":32},{"text":"32-비트","x":568,"y":1447,"width":105,"height":34},{"text":"처리기가","x":686,"y":1447,"width":1