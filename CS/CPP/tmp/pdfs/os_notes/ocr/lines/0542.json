:1177,"y":632,"width":101,"height":35},{"text":"일련의","x":1294,"y":632,"width":93,"height":34},{"text":"읽기","x":1406,"y":631,"width":57,"height":34},{"text":"연","x":1482,"y":632,"width":27,"height":34}]},{"text":"산으로 구현될 수 있다. 이 경우 읽기 접근을 가진 사용자는 파일 복사, 프린트 등을 할","words":[{"text":"산으로","x":300,"y":693,"width":89,"height":33},{"text":"구현될","x":402,"y":691,"width":86,"height":35},{"text":"수","x":501,"y":691,"width":30,"height":35},{"text":"있다.","x":544,"y":690,"width":61,"height":35},{"text":"이","x":621,"y":690,"width":24,"height":34},{"text":"경우","x":663,"y":689,"width":56,"height":35},{"text":"읽기","x":733,"y":689,"width":52,"height":35},{"text":"접근을","x":803,"y":688,"width":88,"height":35},{"text":"가진","x":904,"y":689,"width":59,"height":35},{"text":"사용자는","x":978,"y":690,"width":127,"height":35},{"text":"파일","x":1119,"y":690,"width":62,"height":35},{"text":"복사,","x":1197,"y":690,"width":75,"height":35},{"text":"프린트","x":1289,"y":690,"width":100,"height":33},{"text":"등을","x":1402,"y":689,"width":65,"height":34},{"text":"할","x":1480,"y":690,"width":30,"height":34}]},{"text":"수 있다.","words":[{"text":"수","x":299,"y":751,"width":31,"height":33},{"text":"있다.","x":342,"y":749,"width":63,"height":35}]},{"text":"많은 보호 기법이 제안되었다. 각 기법은 장단점이 있으며, 목표하는 공공에 적합해","words":[{"text":"많은","x":355,"y":807,"width":58,"height":35},{"text":"보호","x":424,"y":808,"width":59,"height":28},{"text":"기법이","x":497,"y":805,"width":80,"height":35},{"text":"제안되었다.","x":593,"y":804,"width":149,"height":35},{"text":"각","x":757,"y":804,"width":30,"height":34},{"text":"기법은","x":799,"y":803,"width":88,"height":35},{"text":"장단점이","x":899,"y":805,"width":120,"height":35},{"text":"있으며,","x":1039,"y":806,"width":101,"height":35},{"text":"목표하는","x":1154,"y":805,"width":134,"height":35},{"text":"공공에","x":1302,"y":805,"width":97,"height":35},{"text":"적합해","x":1417,"y":804,"width":90,"height":36}]},{"text":"야 한다. 단지 몇 명의 연구 그룹 멤버가 A卜\u0026히는 소규모 시스템은 연구, 재정 및 인사","words":[{"text":"야","x":298,"y":865,"width":30,"