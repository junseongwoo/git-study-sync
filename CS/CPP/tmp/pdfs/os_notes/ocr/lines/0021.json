idth":137,"height":39},{"text":"있다.","x":599,"y":1187,"width":75,"height":39},{"text":"일반적으로","x":694,"y":1187,"width":174,"height":39},{"text":"이러한","x":886,"y":1188,"width":105,"height":39},{"text":"시스템에는","x":1005,"y":1187,"width":175,"height":40},{"text":"각각","x":1195,"y":1187,"width":71,"height":38},{"text":"단일","x":1280,"y":1186,"width":68,"height":39},{"text":"코어","x":1366,"y":1187,"width":66,"height":39},{"text":"CPU가","x":1450,"y":1185,"width":123,"height":39},{"text":"있는","x":1590,"y":1185,"width":69,"height":38},{"text":"두","x":1673,"y":1185,"width":37,"height":37}]},{"text":"개 이상의 프로세서가 있다. 프로세서는 컴퓨터 버스 및 때때로 클록, 메모리 및 주변 장","words":[{"text":"개","x":328,"y":1253,"width":28,"height":39},{"text":"이상의","x":374,"y":1252,"width":97,"height":39},{"text":"프로세서가","x":488,"y":1253,"width":176,"height":39},{"text":"있다.","x":679,"y":1253,"width":74,"height":39},{"text":"프로세서는","x":770,"y":1254,"width":177,"height":39},{"text":"컴퓨터","x":963,"y":1253,"width":98,"height":39},{"text":"버스","x":1080,"y":1253,"width":69,"height":39},{"text":"및","x":1164,"y":1253,"width":31,"height":39},{"text":"때때로","x":1211,"y":1252,"width":104,"height":39},{"text":"클록,","x":1328,"y":1254,"width":79,"height":39},{"text":"메모리","x":1423,"y":1251,"width":101,"height":40},{"text":"및","x":1544,"y":1250,"width":30,"height":40},{"text":"주변","x":1589,"y":1249,"width":70,"height":40},{"text":"장","x":1673,"y":1249,"width":37,"height":39}]},{"text":"치를 공유한다. 다중 처리기 시스템의 주요 장점은 처리량 증가이다. 즉, 프로세서 수를","words":[{"text":"치를","x":328,"y":1318,"width":66,"height":39},{"text":"공유한다.","x":408,"y":1318,"width":144,"height":39},{"text":"다중","x":571,"y":1319,"width":70,"height":38},{"text":"처리기","x":657,"y":1318,"width":99,"height":40},{"text":"시스템의","x":777,"y":1319,"width":137,"height":39},{"text":"주요","x":933,"y":1321,"width":71,"height":37},{"text":"장점은","x":1018,"y":1319,"width":106,"height":39},{"text":"처리량","x":1140,"y":1318,"width":103,"height":40},{"text":"증가이다.","x":1256,"y":1318,"width":150,"height"