{"page":433,"width":1680,"height":2506,"text_angle":0,"lines":[{"text":"494","words":[{"text":"494","x":168,"y":137,"width":57,"height":28}]},{"text":"Chapter 11 [명랑 저장장치 구조","words":[{"text":"Chapter","x":295,"y":138,"width":116,"height":27},{"text":"11","x":424,"y":140,"width":26,"height":20},{"text":"[명랑","x":480,"y":140,"width":60,"height":25},{"text":"저장장치","x":550,"y":140,"width":81,"height":25},{"text":"구조","x":640,"y":141,"width":40,"height":22}]},{"text":"11.1.2 비위발성 메모리 장치 Devices","words":[{"text":"11.1.2","x":295,"y":260,"width":117,"height":29},{"text":"비위발성","x":451,"y":259,"width":108,"height":32},{"text":"메모리","x":571,"y":259,"width":78,"height":32},{"text":"장치","x":661,"y":258,"width":51,"height":33},{"text":"Devices","x":1016,"y":267,"width":114,"height":22}]},{"text":"비휘발성 메모리(NVM) 장치의 중요성이 주가하고 있다. 간단히 발해 NVM 장치는 기","words":[{"text":"비휘발성","x":298,"y":328,"width":116,"height":35},{"text":"메모리(NVM)","x":429,"y":328,"width":192,"height":37},{"text":"장치의","x":635,"y":327,"width":81,"height":36},{"text":"중요성이","x":729,"y":328,"width":112,"height":34},{"text":"주가하고","x":856,"y":328,"width":117,"height":35},{"text":"있다.","x":986,"y":328,"width":65,"height":35},{"text":"간단히","x":1066,"y":329,"width":90,"height":35},{"text":"발해","x":1173,"y":329,"width":62,"height":35},{"text":"NVM","x":1249,"y":332,"width":93,"height":28},{"text":"장치는","x":1358,"y":328,"width":98,"height":35},{"text":"기","x":1470,"y":329,"width":25,"height":35}]},{"text":"제식이 아니라 전기식이다. 가장 일반적으로, 이러한 정치는 컨트롤러 및 데이터를 저장","words":[{"text":"제식이","x":297,"y":386,"width":87,"height":34},{"text":"아니라","x":399,"y":385,"width":89,"height":35},{"text":"전기식이다.","x":500,"y":385,"width":150,"height":35},{"text":"가장","x":665,"y":385,"width":56,"height":34},{"text":"일반적으로,","x":733,"y":384,"width":150,"height":37},{"text":"이러한","x":897,"y":384,"width":88,"height":35},{"text":"정치는","x":997,"y":385,"width":92,"height":36},{"text":"컨트롤러","x":1104,"y":386,"width":123,"height":35},{"text":"및","x":1246,"y":387,"width":28,"height":35},{"text":"데이터를","x":1291,"y":385,"width":131,"height":37},{"text":"저장","x":1437,"y":385,"width":64,"height":35}]},{"text":"하는 데 A卜\u0026되는 플래시 NAND 다이 반도체 칩으로 구성된다. 배터리 백업 기능이 있","words":[{"text":"하는","x":296,"y":443,"width":61,"height":35},{"text":"데","x":368,"y":443,"width":27,"height":35},{"text":"A卜\u0026되는","x":409,"y":442,"width":118,"height":36},{"text":"플래시","x":537,"y":442,"width":84,"height":35},{"text":"NAND","x":635,"y":445,"width":104,"height":27},{"text":"다이","x":752,"y":441,"width":53,"height":35},{"text":"반도체","x":820,"y":442,"width":85,"height":35},{"text":"칩으로","x":921,"y":442,"width":87,"height":34},{"text":"구성된다.","x":1020,"y":443,"width":131,"height":35},{"text":"배터리","x":1168,"y":443,"width":93,"height":36},{"text":"백업","x":1278,"y":444,"width":61,"height":35},{"text":"기능이","x":1358,"y":443,"width":94,"height":35},{"text":"있","x":1470,"y":443,"width":29,"height":35}]},{"text":"어서 내펑을 잃어버리지 않게 되는 DRAM과 깉은 NVM 기술과 3D XPoint와 같은","words":[{"text":"어서","x":296,"y":501,"width":56,"height":34},{"text":"내펑을","x":370,"y":501,"width":89,"height":35},{"text":"잃어버리지","x":474,"y":499,"width":140,"height":36},{"text":"않게","x":632,"y":499,"width":53,"height":36},{"text":"되는","x":701,"y":498,"width":57,"height":35},{"text":"DRAM과","x":771,"y":499,"width":137,"height":34},{"text":"깉은","x":921,"y":499,"width":58,"height":34},{"text":"NVM","x":992,"y":502,"width":88,"height":28},{"text":"기술과","x":1098,"y":500,"width":95,"height":35},{"text":"3D","x":1206,"y":504,"width":48,"height":27},{"text":"XPoint와","x":1270,"y":501,"width":151,"height":34},{"text":"같은","x":1435,"y":501,"width":65,"height":34}]},{"text":"다른 반도체 기술이 있지만 그다지 일반적이지 않으므로 이 책에서는 다루지 않는다.","words":[{"text":"다른","x":294,"y":558,"width":61,"height":35},{"text":"반도체","x":366,"y":558,"width":86,"height":34},{"text":"기술이","x":468,"y":557,"width":81,"height":35},{"text":"있지만","x":565,"y":557,"width":85,"height":35},{"text":"그다지","x":659,"y":556,"width":82,"height":35},{"text":"일반적이지","x":757,"y":556,"width":140,"height":36},{"text":"않으므로","x":912,"y":557,"width":120,"height":35},{"text":"이","x":1044,"y":557,"width":26,"height":35},{"text":"책에서는","x":1086,"y":557,"width":128,"height":36},{"text":"다루지","x":1226,"y":558,"width":94,"height":37},{"text":"않는다.","x":1337,"y":559,"width":106,"height":36}]},{"text":"11.1.2.1 비휘발성 메모리 장치 개요 Overvtew 하 Nonvolatile Memory Devices","words":[{"text":"11.1.2.1","x":292,"y":670,"width":106,"height":25},{"text":"비휘발성","x":434,"y":664,"width":107,"height":34},{"text":"메모리","x":554,"y":664,"width":79,"height":34},{"text":"장치","x":646,"y":664,"width":51,"height":34},{"text":"개요","x":711,"y":664,"width":54,"height":34},{"text":"Overvtew","x":787,"y":673,"width":129,"height":22},{"text":"하","x":924,"y":674,"width":29,"height":22},{"text":"Nonvolatile","x":960,"y":675,"width":158,"height":22},{"text":"Memory","x":1129,"y":676,"width":126,"height":27},{"text":"Devices","x":1264,"y":678,"width":123,"height":21}]},{"text":"플래시 메모리 기반 NVM은 디스크 드라이브와 유사한 컨테이너에서 자주 사용되며","words":[{"text":"플래시","x":291,"y":736,"width":89,"height":35},{"text":"메모리","x":399,"y":736,"width":85,"height":35},{"text":"기반","x":504,"y":736,"width":56,"height":34},{"text":"NVM은","x":574,"y":737,"width":113,"height":34},{"text":"디스크","x":702,"y":736,"width":86,"height":36},{"text":"드라이브와","x":803,"y":737,"width":149,"height":37},{"text":"유사한","x":966,"y":739,"width":94,"height":35},{"text":"컨테이너에서","x":1076,"y":740,"width":189,"height":36},{"text":"자주","x":1286,"y":742,"width":67,"height":35},{"text":"사용되며","x":1369,"y":741,"width":129,"height":36}]},{"text":"이 경우 SSD (solid-state disk)라고 한다(그림 11.3). 다른 경우에는 USB 드라이브","words":[{"text":"이","x":292,"y":794,"width":26,"height":34},{"text":"경우","x":336,"y":794,"width":59,"height":35},{"text":"SSD","x":409,"y":799,"width":67,"height":26},{"text":"(solid-state","x":489,"y":798,"width":166,"height":29},{"text":"disk)라고","x":668,"y":795,"width":136,"height":36},{"text":"한다(그림","x":817,"y":796,"width":126,"height":39},{"text":"11.3).","x":961,"y":801,"width":76,"height":34},{"text":"다른","x":1054,"y":799,"width":63,"height":33},{"text":"경우에는","x":1133,"y":799,"width":129,"height":35},{"text":"USB","x":1276,"y":804,"width":76,"height":27},{"text":"드라이브","x":1369,"y":800,"width":132,"height":35}]},{"text":"(thumb 드라이브 또는 플래시 드라이브라고도 함) 또는 DRAM 스틱의 형태를 취한","words":[{"text":"(thumb","x":290,"y":854,"width":113,"height":33},{"text":"드라이브","x":418,"y":852,"width":117,"height":34},{"text":"또는","x":549,"y":854,"width":59,"height":32},{"text":"플래시","x":621,"y":853,"width":83,"height":35},{"text":"드라이브라고도","x":722,"y":854,"width":206,"height":36},{"text":"함)","x":942,"y":856,"width":39,"height":37},{"text":"또는","x":998,"y":858,"width":62,"height":32},{"text":"DRAM","x":1074,"y":860,"width":115,"height":27},{"text":"스틱의","x":1206,"y":857,"width":95,"height":36},{"text":"형태를","x":1322,"y":859,"width":100,"height":34},{"text":"취한","x":1438,"y":858,"width":64,"height":34}]},{"text":"다. 또한 스마트 폰과 같은 장치의 기본 저장장치로 마더보드에 표면 실장 된다. 형태와","words":[{"text":"다.","x":288,"y":908,"width":37,"height":34},{"text":"또한","x":339,"y":910,"width":63,"height":33},{"text":"스마트","x":413,"y":910,"width":88,"height":34},{"text":"폰과","x":512,"y":910,"width":60,"height":34},{"text":"같은","x":585,"y":910,"width":57,"height":34},{"text":"장치의","x":654,"y":911,"width":84,"height":35},{"text":"기본","x":754,"y":912,"width":58,"height":34},{"text":"저장장치로","x":825,"y":913,"width":148,"height":35},{"text":"마더보드에","x":985,"y":914,"width":153,"height":35},{"text":"표면","x":1154,"y":914,"width":64,"height":33},{"text":"실장","x":1234,"y":915,"width":65,"height":34},{"text":"된다.","x":1314,"y":916,"width":73,"height":34},{"text":"형태와","x":1404,"y":915,"width":99,"height":35}]},{"text":"상관없이 같은 방식으로 작동하고 취급될 수 있다. NVM 장지에 대한 논의는 이 기술에","words":[{"text":"상관없이","x":286,"y":965,"width":118,"height":36},{"text":"같은","x":420,"y":968,"width":58,"height":32},{"text":"방식으로","x":489,"y":967,"width":115,"height":34},{"text":"작동하고","x":616,"y":968,"width":116,"height":34},{"text":"취급될","x":744,"y":970,"width":85,"height":33},{"text":"수","x":842,"y":971,"width":30,"height":34},{"text":"있다.","x":885,"y":971,"width":63,"height":35},{"text":"NVM","x":961,"y":976,"width":87,"height":26},{"text":"장지에","x":1062,"y":972,"width":91,"height":34},{"text":"대한","x":1169,"y":972,"width":65,"height":34},{"text":"논의는","x":1244,"y":973,"width":101,"height":34},{"text":"이","x":1359,"y":973,"width":27,"height":34},{"text":"기술에","x":1405,"y":973,"width":93,"height":34}]},{"text":"중점을 둔다.","words":[{"text":"중점을","x":284,"y":1023,"width":92,"height":34},{"text":"둔다.","x":386,"y":1024,"width":66,"height":34}]},{"text":"NVM 장치는 움직이는 부품이 없으므로 HDD보다 안정성이 높으며 탐색 시간이","words":[{"text":"NVM","x":340,"y":1084,"width":86,"height":27},{"text":"장치는","x":440,"y":1082,"width":88,"height":34},{"text":"움직이는","x":540,"y":1082,"width":118,"height":35},{"text":"부품이","x":670,"y":1084,"width":86,"height":34},{"text":"없으므로","x":775,"y":1084,"width":117,"height":34},{"text":"HDD보다","x":905,"y":1087,"width":146,"height":34},{"text":"안정성이","x":1065,"y":1087,"width":123,"height":34},{"text":"높으며","x":1206,"y":1088,"width":95,"height":33},{"text":"탐색","x":1320,"y":1088,"width":64,"height":34},{"text":"시간이","x":1404,"y":1088,"width":93,"height":34}]},{"text":"나 회전 지연시간이 없으므로 더 빠를 수 있다. 또한 전력 소비량도 적다. 단점은 기존 하","words":[{"text":"나","x":283,"y":1138,"width":30,"height":34},{"text":"회전","x":324,"y":1138,"width":58,"height":35},{"text":"지연시간이","x":396,"y":1139,"width":142,"height":35},{"text":"없으므로","x":554,"y":1140,"width":115,"height":34},{"text":"더","x":681,"y":1141,"width":25,"height":34},{"text":"빠를","x":721,"y":1141,"width":58,"height":34},{"text":"수","x":789,"y":1142,"width":31,"height":33},{"text":"있다.","x":832,"y":1142,"width":64,"height":34},{"text":"또한","x":909,"y":1144,"width":62,"height":33},{"text":"전력","x":982,"y":1144,"width":56,"height":34},{"text":"소비량도","x":1054,"y":1144,"width":127,"height":34},{"text":"적다.","x":1194,"y":1144,"width":70,"height":34},{"text":"단점은","x":1280,"y":1145,"width":100,"height":34},{"text":"기존","x":1393,"y":1145,"width":65,"height":34},{"text":"하","x":1469,"y":1146,"width":33,"height":34}]},{"text":"드 디스크보다 메가바이트당 가격이 비싸고 더 큰 하드 디스크보다 용량이 적다는 것이","words":[{"text":"드","x":281,"y":1200,"width":31,"height":25},{"text":"디스크보다","x":326,"y":1196,"width":146,"height":35},{"text":"메가바이트당","x":485,"y":1197,"width":175,"height":35},{"text":"가격이","x":673,"y":1199,"width":84,"height":33},{"text":"비싸고","x":775,"y":1199,"width":87,"height":34},{"text":"더","x":877,"y":1200,"width":24,"height":34},{"text":"큰","x":917,"y":1203,"width":32,"height":31},{"text":"하드","x":961,"y":1201,"width":62,"height":34},{"text":"디스크보다","x":1038,"y":1201,"width":156,"height":35},{"text":"용량이","x":1208,"y":1202,"width":94,"height":34},{"text":"적다는","x":1322,"y":1202,"width":99,"height":35},{"text":"것이","x":1437,"y":1202,"width":60,"height":35}]},{"text":"다. 그러나 시간이 지남에 따라 NVM 장치의 용량이 HDD 용량보다 빠르게 증가하고","words":[{"text":"다.","x":282,"y":1254,"width":35,"height":34},{"text":"그러나","x":331,"y":1254,"width":91,"height":36},{"text":"시간이","x":435,"y":1255,"width":84,"height":34},{"text":"지남에","x":536,"y":1256,"width":84,"height":34},{"text":"따라","x":635,"y":1256,"width":60,"height":34},{"text":"NVM","x":705,"y":1260,"width":86,"height":26},{"text":"장치의","x":804,"y":1257,"width":87,"height":35},{"text":"용량이","x":907,"y":1258,"width":88,"height":35},{"text":"HDD","x":1012,"y":1262,"width":85,"height":27},{"text":"용량보다","x":1111,"y":1259,"width":130,"height":34},{"text":"빠르게","x":1255,"y":1260,"width":96,"height":34},{"text":"증가하고","x":1368,"y":1260,"width":132,"height":34}]},{"text":"가격이 더 빠르게 하락하여 사\u0026량이 급격히 증가하고 있다. 실제로 일부 랩톱 컴퓨터에","words":[{"text":"가격이","x":282,"y":1313,"width":84,"height":34},{"text":"더","x":382,"y":1313,"width":25,"height":34},{"text":"빠르게","x":423,"y":1313,"width":84,"height":34},{"text":"하락하여","x":521,"y":1313,"width":113,"height":35},{"text":"사\u0026량이","x":649,"y":1314,"width":114,"height":35},{"text":"급격히","x":778,"y":1314,"width":87,"height":35},{"text":"증가하고","x":880,"y":1316,"width":121,"height":34},{"text":"있다.","x":1016,"y":1317,"width":66,"height":34},{"text":"실제로","x":1099,"y":1317,"width":94,"height":34},{"text":"일부","x":1210,"y":1316,"width":63,"height":34},{"text":"랩톱","x":1289,"y":1317,"width":65,"height":33},{"text":"컴퓨터에","x":1370,"y":1317,"width":127,"height":35}]},{"text":"서는 SSD 및 이와 유사한 장지를 시용하여 더 작고, 빠르고, 에너지 효율적이다.","words":[{"text":"서는","x":282,"y":1372,"width":59,"height":34},{"text":"SSD","x":350,"y":1374,"width":62,"height":28},{"text":"및","x":424,"y":1370,"width":26,"height":35},{"text":"이와","x":464,"y":1370,"width":58,"height":36},{"text":"유사한","x":531,"y":1372,"width":89,"height":34},{"text":"장지를","x":631,"y":1372,"width":88,"height":34},{"text":"시용하여","x":729,"y":1372,"width":117,"height":35},{"text":"더","x":862,"y":1373,"width":24,"height":34},{"text":"작고,","x":901,"y":1373,"width":68,"height":35},{"text":"빠르고,","x":982,"y":1374,"width":100,"height":34},{"text":"에너지","x":1097,"y":1374,"width":90,"height":34},{"text":"효율적이다.","x":1203,"y":1374,"width":173,"height":34}]},{"text":"NVM 장치는 하드 디스크 드라이브꾜다 훨씬 빠를 수 있으쯔로 표준 버스 인터페","words":[{"text":"NVM","x":336,"y":1433,"width":84,"height":27},{"text":"장치는","x":433,"y":1429,"width":89,"height":34},{"text":"하드","x":534,"y":1430,"width":58,"height":34},{"text":"디스크","x":606,"y":1430,"width":87,"height":34},{"text":"드라이브꾜다","x":706,"y":1430,"width":181,"height":34},{"text":"훨씬","x":901,"y":1431,"width":58,"height":33},{"text":"빠를","x":975,"y":1432,"width":62,"height":34},{"text":"수","x":1049,"y":1432,"width":33,"height":33},{"text":"있으쯔로","x":1097,"y":1432,"width":126,"height":33},{"text":"표준","x":1237,"y":1433,"width":67,"height":31},{"text":"버스","x":1321,"y":1431,"width":65,"height":34},{"text":"인터페","x":1403,"y":1432,"width":93,"height":35}]},{"text":"이스가 처리랑을 크게 제한할 수 있다. 일부 NVM 장치는 시스템 버스(예, PC1e)에 직","words":[{"text":"이스가","x":282,"y":1488,"width":88,"height":35},{"text":"처리랑을","x":383,"y":1487,"width":116,"height":36},{"text":"크게","x":510,"y":1489,"width":56,"height":34},{"text":"제한할","x":581,"y":1489,"width":88,"height":34},{"text":"수","x":679,"y":1489,"width":31,"height":34},{"text":"있다.","x":724,"y":1489,"width":62,"height":34},{"text":"일부","x":804,"y":1488,"width":57,"height":34},{"text":"NVM","x":873,"y":1491,"width":87,"height":27},{"text":"장치는","x":974,"y":1489,"width":95,"height":34},{"text":"시스템","x":1081,"y":1489,"width":92,"height":33},{"text":"버스(예,","x":1192,"y":1488,"width":117,"height":37},{"text":"PC1e)에","x":1323,"y":1490,"width":127,"height":37},{"text":"직","x":1469,"y":1491,"width":26,"height":34}]},{"text":"그림 11.3 3.5인치 SSD 기판","words":[{"text":"그림","x":689,"y":2304,"width":44,"height":26},{"text":"11.3","x":744,"y":2306,"width":50,"height":22},{"text":"3.5인치","x":821,"y":2305,"width":85,"height":27},{"text":"SSD","x":916,"y":2306,"width":53,"height":24},{"text":"기판","x":980,"y":2305,"width":47,"height":28}]}]}