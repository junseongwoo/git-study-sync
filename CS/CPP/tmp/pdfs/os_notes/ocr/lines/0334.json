1425,"width":67,"height":34},{"text":"대신","x":1136,"y":1425,"width":63,"height":34},{"text":"필요할","x":1214,"y":1425,"width":101,"height":34},{"text":"때만","x":1328,"y":1426,"width":67,"height":33},{"text":"메모리","x":1408,"y":1426,"width":92,"height":34}]},{"text":"에 적재할 수 있다. 마찬가지로 장치 드라이버가 더 필요하지 않은 경우 장치 드라이버","words":[{"text":"에","x":299,"y":1487,"width":25,"height":34},{"text":"적재할","x":341,"y":1486,"width":86,"height":34},{"text":"수","x":438,"y":1485,"width":30,"height":34},{"text":"있다.","x":481,"y":1484,"width":61,"height":34},{"text":"마찬가지로","x":557,"y":1483,"width":144,"height":36},{"text":"장치","x":714,"y":1484,"width":55,"height":34},{"text":"드라이버가","x":785,"y":1484,"width":150,"height":34},{"text":"더","x":949,"y":1483,"width":25,"height":35},{"text":"필요하지","x":992,"y":1482,"width":120,"height":34},{"text":"않은","x":1131,"y":1482,"width":65,"height":34},{"text":"경우","x":1212,"y":1482,"width":65,"height":35},{"text":"장치","x":1292,"y":1483,"width":63,"height":34},{"text":"드라이버","x":1374,"y":1483,"width":126,"height":34}]},{"text":"를 제거하고 메모리를 다른 요청에 할당할 수 있다.","words":[{"text":"를","x":298,"y":1546,"width":30,"height":32},{"text":"제거하고","x":338,"y":1543,"width":115,"height":35},{"text":"메모리를","x":464,"y":1541,"width":113,"height":35},{"text":"다른","x":587,"y":1541,"width":58,"height":35},{"text":"요청에","x":655,"y":1541,"width":84,"height":35},{"text":"할당할","x":752,"y":1541,"width":89,"height":34},{"text":"수","x":851,"y":1541,"width":30,"height":34},{"text":"있다.","x":894,"y":1541,"width":64,"height":34}]},{"text":"9.2.2 메모리 할당 MemoryA110cation","words":[{"text":"9.2.2","x":299,"y":1651,"width":110,"height":29},{"text":"메모리","x":446,"y":1650,"width":77,"height":31},{"text":"할당","x":534,"y":1650,"width":54,"height":32},{"text":"MemoryA110cation","x":610,"y":1657,"width":251,"height":26}]},{"text":"이제 메모리 할당을 논의할 준비가 되었다. 메모리를 할당하는 가장 간단한 방법 중 하","words":[{"text":"이제","x":300,"y":1721,"width":55,"height":35},{"text":"메모리","x":371,"y":1721,"width":83,"height":34},{"text