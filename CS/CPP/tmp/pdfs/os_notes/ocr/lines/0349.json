ext":"해시","x":774,"y":433,"width":57,"height":36},{"text":"페이지","x":847,"y":433,"width":87,"height":37},{"text":"테이블","x":949,"y":433,"width":91,"height":37},{"text":"및","x":1053,"y":434,"width":28,"height":37},{"text":"역","x":1096,"y":434,"width":26,"height":36},{"text":"페이지","x":1138,"y":433,"width":92,"height":38},{"text":"테이블이","x":1247,"y":434,"width":128,"height":37},{"text":"포함된다.","x":1390,"y":434,"width":141,"height":36}]},{"text":"9.4.1 계층적 페이징 Hierarchica1 Paging","words":[{"text":"9.4.1","x":285,"y":544,"width":115,"height":29},{"text":"계층적","x":447,"y":543,"width":92,"height":33},{"text":"페이징","x":551,"y":545,"width":89,"height":33},{"text":"Hierarchica1","x":665,"y":553,"width":174,"height":23},{"text":"Paging","x":847,"y":554,"width":98,"height":28}]},{"text":"요즈음 많은 현대 컴퓨터는 매우 큰 주소 공간(232에서 264)을 가진다. 이러한 환경에서","words":[{"text":"요즈음","x":285,"y":616,"width":103,"height":34},{"text":"많은","x":403,"y":616,"width":68,"height":35},{"text":"현대","x":486,"y":616,"width":61,"height":36},{"text":"컴퓨터는","x":568,"y":618,"width":126,"height":35},{"text":"매우","x":708,"y":618,"width":60,"height":36},{"text":"큰","x":782,"y":621,"width":31,"height":32},{"text":"주소","x":826,"y":621,"width":61,"height":34},{"text":"공간(232에서","x":900,"y":617,"width":172,"height":41},{"text":"264)을","x":1088,"y":617,"width":88,"height":41},{"text":"가진다.","x":1189,"y":620,"width":103,"height":36},{"text":"이러한","x":1310,"y":619,"width":98,"height":37},{"text":"환경에서","x":1421,"y":619,"width":131,"height":36}]},{"text":"는 페이지 테이블도 상당히 커진다. 예를 들어, 32비트 논리 주소 공간을 가진 시스템을","words":[{"text":"는","x":285,"y":676,"width":35,"height":32},{"text":"페이지","x":334,"y":675,"width":98,"height":35},{"text":"테이블도","x":451,"y":675,"width":132,"height":35},{"text":"상당히","x":597,"y":677,"width":91,"height":35},{"text":"커진다.","x":707,"y":677,"width":97,"height":35},{"text":"예를","x":820,"y":679,"width":60,"height":34},{"text":"들어,","x":892,"y":679,"width":68,"height":35},{"text":"32비트","x":974,"y":680,"width":96,