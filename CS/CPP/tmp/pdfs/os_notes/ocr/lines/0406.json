{"page":406,"width":1670,"height":2484,"text_angle":0,"lines":[{"text":"466","words":[{"text":"466","x":149,"y":135,"width":58,"height":26}]},{"text":"Chapter 10 가통, 메모리","words":[{"text":"Chapter","x":278,"y":138,"width":118,"height":28},{"text":"10","x":408,"y":140,"width":36,"height":21},{"text":"가통,","x":473,"y":140,"width":41,"height":25},{"text":"메모리","x":523,"y":141,"width":61,"height":23}]},{"text":"작업 집합과 페이지 폴트을","words":[{"text":"작업","x":693,"y":301,"width":60,"height":35},{"text":"집합과","x":764,"y":300,"width":90,"height":36},{"text":"페이지","x":862,"y":299,"width":91,"height":37},{"text":"폴트을","x":964,"y":298,"width":94,"height":37}]},{"text":"한 프로세스의 작업 집합과 페이지 폴트율 사이에는 직접적인 연관이 있다. 그림","words":[{"text":"한","x":319,"y":375,"width":33,"height":35},{"text":"프로세스의","x":363,"y":375,"width":149,"height":35},{"text":"작업","x":528,"y":375,"width":57,"height":35},{"text":"집합과","x":604,"y":375,"width":88,"height":37},{"text":"페이지","x":705,"y":376,"width":85,"height":36},{"text":"폴트율","x":807,"y":376,"width":91,"height":35},{"text":"사이에는","x":912,"y":374,"width":123,"height":38},{"text":"직접적인","x":1051,"y":373,"width":125,"height":37},{"text":"연관이","x":1195,"y":373,"width":93,"height":36},{"text":"있다.","x":1310,"y":373,"width":72,"height":35},{"text":"그림","x":1400,"y":372,"width":62,"height":35}]},{"text":"10.22에서처럼, 보통 데이터와 코드에 대한 참조는 시간의 흐름에 따라 한 지역에","words":[{"text":"10.22에서처럼,","x":320,"y":432,"width":206,"height":36},{"text":"보통","x":539,"y":434,"width":60,"height":33},{"text":"데이터와","x":610,"y":432,"width":120,"height":37},{"text":"코드에","x":740,"y":433,"width":86,"height":36},{"text":"대한","x":841,"y":432,"width":62,"height":36},{"text":"참조는","x":913,"y":432,"width":94,"height":35},{"text":"시간의","x":1019,"y":430,"width":90,"height":36},{"text":"흐름에","x":1126,"y":430,"width":96,"height":35},{"text":"따라","x":1239,"y":430,"width":68,"height":36},{"text":"한","x":1318,"y":430,"width":35,"height":34},{"text":"지역에","x":1367,"y":429,"width":96,"height":35}]},{"text":"