{"page":584,"width":1731,"height":2542,"text_angle":0,"lines":[{"text":"14.8 예: WAFL 파일 시스템","words":[{"text":"14.8","x":1075,"y":157,"width":69,"height":23},{"text":"예:","x":1160,"y":156,"width":30,"height":25},{"text":"WAFL","x":1201,"y":157,"width":76,"height":23},{"text":"파일","x":1287,"y":156,"width":44,"height":25},{"text":"시스템","x":1341,"y":156,"width":67,"height":26}]},{"text":"647","words":[{"text":"647","x":1479,"y":154,"width":57,"height":28}]},{"text":"매우 유사하다. 이것은 블록 기반이고 파일을 기술하기 위하여 rnode를 사용한다. 각","words":[{"text":"매우","x":315,"y":283,"width":63,"height":36},{"text":"유사하다.","x":394,"y":283,"width":132,"height":37},{"text":"이것은","x":545,"y":284,"width":89,"height":36},{"text":"블록","x":648,"y":284,"width":60,"height":35},{"text":"기반이고","x":724,"y":285,"width":116,"height":35},{"text":"파일을","x":856,"y":284,"width":91,"height":36},{"text":"기술하기","x":964,"y":282,"width":118,"height":37},{"text":"위하여","x":1103,"y":281,"width":89,"height":36},{"text":"rnode를","x":1213,"y":283,"width":125,"height":34},{"text":"사용한다.","x":1355,"y":281,"width":134,"height":38},{"text":"각","x":1508,"y":284,"width":32,"height":36}]},{"text":"inode는 16개의 포인터를 갖고, 각 포인터는 블록(휴은 간접 블록)을 가리기기 위하여","words":[{"text":"inode는","x":315,"y":345,"width":124,"height":32},{"text":"16개의","x":454,"y":343,"width":93,"height":35},{"text":"포인터를","x":564,"y":343,"width":119,"height":35},{"text":"갖고,","x":696,"y":343,"width":66,"height":36},{"text":"각","x":777,"y":344,"width":29,"height":34},{"text":"포인터는","x":819,"y":343,"width":121,"height":35},{"text":"블록(휴은","x":953,"y":342,"width":137,"height":38},{"text":"간접","x":1104,"y":341,"width":57,"height":35},{"text":"블록)을","x":1179,"y":341,"width":109,"height":38},{"text":"가리기기","x":1304,"y":341,"width":122,"height":37},{"text":"위하여","x":1445,"y":342,"width":91,"height":38}]},{"text":"A卜\u0026된다. 각 파일 시스템은 뿌리(root) inode를 갖고, 모든 메타데이터는 파일에 존재","words":[{"text":"A卜\u0026된다.","x":315,"y":400,"width":134,"height":37},{"text":"각","x":466,"y":402,"width":30,"height":34},{"text":"파일","x":509,"y":401,"width":59,"height":36},{"text":"시스템은","x":584,"y":401,"width":119,"height":35},{"text":"뿌리(root)","x":715,"y":402,"width":140,"height":38},{"text":"inode를","x":871,"y":402,"width":118,"height":34},{"text":"갖고,","x":1002,"y":401,"width":69,"height":36},{"text":"모든","x":1086,"y":403,"width":63,"height":32},{"text":"메타데이터는","x":1163,"y":400,"width":191,"height":36},{"text":"파일에","x":1368,"y":401,"width":92,"height":36},{"text":"존재","x":1476,"y":403,"width":61,"height":35}]},{"text":"한다. 예를 들자면, 모든 inode는 하나의 파일에 존재하고, 가용 블록 법도 역시 또 다른","words":[{"text":"한다.","x":315,"y":460,"width":71,"height":34},{"text":"예를","x":402,"y":460,"width":62,"height":35},{"text":"들자면,","x":475,"y":460,"width":100,"height":36},{"text":"모든","x":588,"y":461,"width":60,"height":33},{"text":"inode는","x":659,"y":462,"width":115,"height":33},{"text":"하나의","x":785,"y":461,"width":86,"height":35},{"text":"파일에","x":885,"y":460,"width":88,"height":36},{"text":"존재하고,","x":988,"y":460,"width":131,"height":36},{"text":"가용","x":1133,"y":460,"width":62,"height":36},{"text":"블록","x":1206,"y":460,"width":65,"height":35},{"text":"법도","x":1283,"y":460,"width":63,"height":35},{"text":"역시","x":1360,"y":461,"width":58,"height":35},{"text":"또","x":1433,"y":464,"width":32,"height":27},{"text":"다른","x":1478,"y":461,"width":63,"height":35}]},{"text":"파일에 존재하며, 가용 inode 맵 역시 파일에 존재한다. 이는 그림 14.12에 자세히 나와","words":[{"text":"파일에","x":315,"y":518,"width":94,"height":36},{"text":"존재하며,","x":423,"y":518,"width":132,"height":36},{"text":"가용","x":569,"y":518,"width":60,"height":36},{"text":"inode","x":641,"y":520,"width":84,"height":30},{"text":"맵","x":739,"y":519,"width":24,"height":34},{"text":"역시","x":780,"y":519,"width":53,"height":35},{"text":"파일에","x":849,"y":519,"width":87,"height":35},{"text":"존재한다.","x":950,"y":519,"width":129,"height":36},{"text":"이는","x":1095,"y":520,"width":61,"height":35},{"text":"그림","x":1168,"y":519,"width":58,"height":34},{"text":"14.12에","x":1243,"y":520,"width":111,"height":35},{"text":"자세히","x":1370,"y":520,"width":91,"height":35},{"text":"나와","x":1478,"y":520,"width":64,"height":35}]},{"text":"있다. 이러한 것들이 일반 파일이기 때문에, 데이터블록은 지역에 구에받지 아니하고 어","words":[{"text":"있다.","x":318,"y":577,"width":68,"height":35},{"text":"이러한","x":403,"y":577,"width":94,"height":35},{"text":"것들이","x":510,"y":577,"width":87,"height":35},{"text":"일반","x":615,"y":577,"width":57,"height":34},{"text":"파일이기","x":685,"y":577,"width":114,"height":36},{"text":"때문에,","x":816,"y":577,"width":97,"height":36},{"text":"데이터블록은","x":928,"y":578,"width":182,"height":36},{"text":"지역에","x":1124,"y":578,"width":89,"height":36},{"text":"구에받지","x":1228,"y":579,"width":124,"height":36},{"text":"아니하고","x":1369,"y":579,"width":127,"height":36},{"text":"어","x":1511,"y":579,"width":26,"height":37}]},{"text":"디에든 존재할 수 있다. 만약, 파일 시스템이 여러 디스크로 확장될 경우, 이러한 메타 데","words":[{"text":"디에든","x":317,"y":635,"width":95,"height":35},{"text":"존재할","x":423,"y":635,"width":95,"height":34},{"text":"수","x":528,"y":636,"width":31,"height":34},{"text":"있다.","x":573,"y":636,"width":64,"height":35},{"text":"만약,","x":651,"y":635,"width":67,"height":36},{"text":"파일","x":731,"y":636,"width":57,"height":35},{"text":"시스템이","x":802,"y":636,"width":115,"height":35},{"text":"여러","x":933,"y":637,"width":56,"height":35},{"text":"디스크로","x":1006,"y":637,"width":120,"height":35},{"text":"확장될","x":1137,"y":637,"width":92,"height":36},{"text":"경우,","x":1245,"y":638,"width":69,"height":36},{"text":"이러한","x":1329,"y":639,"width":95,"height":35},{"text":"메타","x":1435,"y":639,"width":63,"height":35},{"text":"데","x":1510,"y":639,"width":28,"height":35}]},{"text":"이터 파일들은 파일 시스템에 의하여 자동으로 확장될 것이다.","words":[{"text":"이터","x":317,"y":694,"width":58,"height":34},{"text":"파일들은","x":392,"y":694,"width":126,"height":35},{"text":"파일","x":528,"y":694,"width":60,"height":34},{"text":"시스템에","x":602,"y":694,"width":118,"height":35},{"text":"의하여","x":734,"y":695,"width":85,"height":35},{"text":"자동으로","x":833,"y":695,"width":121,"height":35},{"text":"확장될","x":965,"y":696,"width":89,"height":35},{"text":"것이다.","x":1069,"y":696,"width":97,"height":35}]},{"text":"따라서 WAFL 파일 시스템은 뿌리 inode를 기점으로 하는 블록들의 트리로 구성","words":[{"text":"따라서","x":376,"y":753,"width":91,"height":36},{"text":"WAFL","x":485,"y":756,"width":101,"height":27},{"text":"파일","x":602,"y":753,"width":58,"height":35},{"text":"시스템은","x":677,"y":753,"width":119,"height":35},{"text":"뿌리","x":809,"y":754,"width":57,"height":35},{"text":"inode를","x":882,"y":756,"width":118,"height":33},{"text":"기점으로","x":1015,"y":755,"width":121,"height":35},{"text":"하는","x":1151,"y":756,"width":62,"height":35},{"text":"블록들의","x":1226,"y":757,"width":124,"height":35},{"text":"트리로","x":1368,"y":758,"width":95,"height":35},{"text":"구성","x":1477,"y":758,"width":59,"height":36}]},{"text":"된다. 스냅숏을 작성하기 위하여, WAFL은 뿌리 lnode의 복사본을 생성한다. 변경된","words":[{"text":"된다.","x":317,"y":811,"width":70,"height":36},{"text":"스냅숏을","x":405,"y":812,"width":127,"height":35},{"text":"작성하기","x":547,"y":811,"width":119,"height":36},{"text":"위하여,","x":686,"y":812,"width":96,"height":36},{"text":"WAFL은","x":797,"y":813,"width":131,"height":34},{"text":"뿌리","x":943,"y":813,"width":56,"height":35},{"text":"lnode의","x":1017,"y":814,"width":117,"height":34},{"text":"복사본을","x":1152,"y":815,"width":126,"height":34},{"text":"생성한다.","x":1294,"y":816,"width":133,"height":35},{"text":"변경된","x":1447,"y":817,"width":91,"height":35}]},{"text":"모든 파일 및 메타 데이터는 존재하는 블록이 아닌 새로운 공간에 업데이트 된다. 새로","words":[{"text":"모든","x":316,"y":872,"width":64,"height":32},{"text":"파일","x":394,"y":871,"width":62,"height":34},{"text":"및","x":474,"y":870,"width":27,"height":36},{"text":"메타","x":518,"y":870,"width":61,"height":35},{"text":"데이터는","x":594,"y":871,"width":121,"height":35},{"text":"존재하는","x":727,"y":871,"width":121,"height":35},{"text":"블록이","x":861,"y":871,"width":87,"height":35},{"text":"아닌","x":965,"y":872,"width":58,"height":34},{"text":"새로운","x":1038,"y":872,"width":92,"height":34},{"text":"공간에","x":1144,"y":873,"width":90,"height":35},{"text":"업데이트","x":1253,"y":874,"width":125,"height":36},{"text":"된다.","x":1392,"y":875,"width":68,"height":34},{"text":"새로","x":1477,"y":876,"width":62,"height":34}]},{"text":"이 생성된 뿌리 inode는 이러한 업데이트 및 쓰기 연산을 통하여 새로운 버전의 복사본","words":[{"text":"이","x":317,"y":929,"width":27,"height":34},{"text":"생성된","x":361,"y":929,"width":95,"height":36},{"text":"뿌리","x":469,"y":930,"width":59,"height":35},{"text":"inode는","x":544,"y":931,"width":120,"height":33},{"text":"이러한","x":676,"y":930,"width":91,"height":35},{"text":"업데이트","x":779,"y":929,"width":119,"height":36},{"text":"및","x":912,"y":930,"width":26,"height":35},{"text":"쓰기","x":952,"y":930,"width":55,"height":35},{"text":"연산을","x":1025,"y":930,"width":90,"height":35},{"text":"통하여","x":1126,"y":932,"width":89,"height":35},{"text":"새로운","x":1231,"y":932,"width":95,"height":35},{"text":"버전의","x":1340,"y":933,"width":90,"height":35},{"text":"복사본","x":1445,"y":933,"width":96,"height":35}]},{"text":"을 관리할 수 있게 된다. 반면에, 스냅숏(기존의 뿌리 inode)는 업데이트 되지 않았으므","words":[{"text":"을","x":316,"y":988,"width":33,"height":34},{"text":"관리할","x":361,"y":989,"width":97,"height":35},{"text":"수","x":469,"y":989,"width":33,"height":35},{"text":"있게","x":516,"y":989,"width":56,"height":35},{"text":"된다.","x":588,"y":989,"width":67,"height":35},{"text":"반면에,","x":670,"y":989,"width":97,"height":35},{"text":"스냅숏(기존의","x":780,"y":989,"width":190,"height":38},{"text":"뿌리","x":985,"y":989,"width":57,"height":35},{"text":"inode)는","x":1057,"y":992,"width":131,"height":35},{"text":"업데이트","x":1202,"y":991,"width":123,"height":35},{"text":"되지","x":1339,"y":992,"width":58,"height":34},{"text":"않았으므","x":1415,"y":991,"width":126,"height":35}]},{"text":"로, 여전히 기존의 데이터 볼록들~을 가리기고 있을 것이다 그러므로 이러한 기능을 바","words":[{"text":"로,","x":316,"y":1050,"width":40,"height":33},{"text":"여전히","x":374,"y":1047,"width":90,"height":36},{"text":"기존의","x":485,"y":1048,"width":88,"height":35},{"text":"데이터","x":591,"y":1048,"widt