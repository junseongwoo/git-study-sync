"y":738,"width":158,"height":36},{"text":"않을","x":1192,"y":738,"width":64,"height":35},{"text":"것이다(이에","x":1270,"y":736,"width":171,"height":38},{"text":"따라","x":1456,"y":736,"width":62,"height":35}]},{"text":"내부 단편화가 발생). 프로세스 크기와 페이지 크기 사이에 어떤 연관도 존재하지 않을","words":[{"text":"내부","x":305,"y":796,"width":60,"height":34},{"text":"단편화가","x":377,"y":795,"width":121,"height":36},{"text":"발생).","x":510,"y":796,"width":76,"height":38},{"text":"프로세스","x":602,"y":797,"width":117,"height":34},{"text":"크기와","x":732,"y":796,"width":90,"height":35},{"text":"페이지","x":834,"y":797,"width":87,"height":35},{"text":"크기","x":938,"y":797,"width":56,"height":35},{"text":"사이에","x":1012,"y":797,"width":91,"height":35},{"text":"어떤","x":1122,"y":796,"width":60,"height":36},{"text":"연관도","x":1201,"y":796,"width":94,"height":34},{"text":"존재하지","x":1310,"y":794,"width":127,"height":36},{"text":"않을","x":1456,"y":794,"width":62,"height":35}]},{"text":"때, 평균적으로 각 프로세스 주소 공간의 마지막 페이지의 절반가량이 당비된다고 볼 수","words":[{"text":"때,","x":304,"y":854,"width":36,"height":35},{"text":"평균적으로","x":355,"y":854,"width":148,"height":35},{"text":"각","x":516,"y":855,"width":28,"height":35},{"text":"프로세스","x":555,"y":855,"width":117,"height":35},{"text":"주소","x":684,"y":857,"width":58,"height":33},{"text":"공간의","x":754,"y":855,"width":86,"height":35},{"text":"마지막","x":854,"y":856,"width":92,"height":34},{"text":"페이지의","x":958,"y":856,"width":119,"height":35},{"text":"절반가량이","x":1095,"y":855,"width":155,"height":35},{"text":"당비된다고","x":1267,"y":854,"width":163,"height":35},{"text":"볼","x":1442,"y":853,"width":32,"height":34},{"text":"수","x":1486,"y":854,"width":31,"height":34}]},{"text":"있다. 이러한 당비는 페이지 그기가 512바이트인 경유는 256바이트에 그치지만, 8,192","words":[{"text":"있다.","x":305,"y":913,"width":64,"height":34},{"text":"이러한","x":386,"y":913,"width":90,"height":35},{"text":"당비는","x":488,"y":913,"width":88,"height":36},{"text":"페이지","x":590,"y":914,"width":83,"height":35},{"text":"그기가","x":690,"y":913,"width":89,"height":36},{"text