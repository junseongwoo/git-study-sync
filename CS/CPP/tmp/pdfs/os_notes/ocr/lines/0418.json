{"page":418,"width":1680,"height":2510,"text_angle":0,"lines":[{"text":"478","words":[{"text":"478","x":168,"y":136,"width":57,"height":27}]},{"text":"Chapter 10 가통, 에모리","words":[{"text":"Chapter","x":296,"y":140,"width":117,"height":28},{"text":"10","x":426,"y":143,"width":35,"height":22},{"text":"가통,","x":490,"y":144,"width":41,"height":24},{"text":"에모리","x":539,"y":145,"width":61,"height":23}]},{"text":"10.9.6 |/0 \u0026참금(|/0 lnterlock)과페이지 참금(locking)","words":[{"text":"10.9.6","x":297,"y":264,"width":138,"height":29},{"text":"|/0","x":475,"y":265,"width":49,"height":31},{"text":"\u0026참금(|/0","x":536,"y":265,"width":181,"height":32},{"text":"lnterlock)과페이지","x":730,"y":266,"width":282,"height":33},{"text":"참금(locking)","x":1024,"y":264,"width":214,"height":37}]},{"text":"요구 페이징을 A卜\u0026할 때 그 페이지의 일부는 메모리에 붙박이로 고정하는 것이 필요한","words":[{"text":"요구","x":297,"y":334,"width":62,"height":33},{"text":"페이징을","x":373,"y":333,"width":120,"height":35},{"text":"A卜\u0026할","x":505,"y":333,"width":89,"height":35},{"text":"때","x":606,"y":334,"width":25,"height":33},{"text":"그","x":646,"y":340,"width":29,"height":22},{"text":"페이지의","x":688,"y":334,"width":113,"height":34},{"text":"일부는","x":818,"y":334,"width":88,"height":34},{"text":"메모리에","x":918,"y":336,"width":118,"height":34},{"text":"붙박이로","x":1052,"y":335,"width":125,"height":34},{"text":"고정하는","x":1191,"y":334,"width":130,"height":34},{"text":"것이","x":1337,"y":332,"width":59,"height":36},{"text":"필요한","x":1415,"y":330,"width":94,"height":35}]},{"text":"때가 있다. 이런 상황은 1/()가 시용지(기상 1게모리) 공간에서 이루어질 때 발생한다. I/","words":[{"text":"때가","x":298,"y":390,"width":61,"height":34},{"text":"있다.","x":372,"y":390,"width":65,"height":34},{"text":"이런","x":452,"y":390,"width":56,"height":34},{"text":"상황은","x":521,"y":391,"width":88,"height":34},{"text":"1/()가","x":620,"y":391,"width":88,"height":33},{"text":"시용지(기상","x":719,"y":390,"width":159,"height":38},{"text":"1게모리)","x":889,"y":392,"width":100,"height":37},{"text":"공간에서","x":1002,"y":392,"width":120,"height":35},{"text":"이루어질","x":1140,"y":391,"width":124,"height":35},{"text":"때","x":1281,"y":390,"width":28,"height":35},{"text":"발생한다.","x":1325,"y":388,"width":136,"height":37},{"text":"I/","x":1476,"y":392,"width":30,"height":31}]},{"text":"()는 흔히 별도의 I/O 처리기(1/0 channel)에 의해서 실행된다. 예를 들어, USB 저장","words":[{"text":"()는","x":295,"y":448,"width":61,"height":33},{"text":"흔히","x":366,"y":448,"width":58,"height":34},{"text":"별도의","x":440,"y":447,"width":84,"height":34},{"text":"I/O","x":538,"y":449,"width":58,"height":32},{"text":"처리기(1/0","x":609,"y":447,"width":154,"height":37},{"text":"channel)에","x":774,"y":448,"width":159,"height":38},{"text":"의해서","x":948,"y":449,"width":86,"height":36},{"text":"실행된다.","x":1051,"y":449,"width":132,"height":35},{"text":"예를","x":1199,"y":449,"width":64,"height":34},{"text":"들어,","x":1275,"y":448,"width":73,"height":35},{"text":"USB","x":1362,"y":450,"width":70,"height":28},{"text":"저장","x":1448,"y":446,"width":61,"height":36}]},{"text":"장치를 위한 처리기에는 버퍼 주소와 전송할 바이트 수를 준다(그림 10.28). 전송이 완","words":[{"text":"장치를","x":296,"y":504,"width":93,"height":35},{"text":"위한","x":403,"y":505,"width":60,"height":34},{"text":"처리기에는","x":476,"y":504,"width":146,"height":35},{"text":"버퍼","x":636,"y":505,"width":53,"height":34},{"text":"주소와","x":705,"y":505,"width":90,"height":35},{"text":"전송할","x":809,"y":505,"width":88,"height":36},{"text":"바이트","x":910,"y":506,"width":90,"height":36},{"text":"수를","x":1015,"y":507,"width":61,"height":35},{"text":"준다(그림","x":1090,"y":506,"width":136,"height":38},{"text":"10.28).","x":1246,"y":509,"width":103,"height":34},{"text":"전송이","x":1368,"y":504,"width":92,"height":36},{"text":"완","x":1478,"y":505,"width":31,"height":34}]},{"text":"료되었을 때 CPU에 인터럽트로 알려준다.","words":[{"text":"료되었을","x":296,"y":562,"width":122,"height":35},{"text":"때","x":430,"y":563,"width":25,"height":34},{"text":"CPU에","x":468,"y":562,"width":98,"height":35},{"text":"인터럽트로","x":582,"y":562,"width":143,"height":36},{"text":"알려준다.","x":737,"y":562,"width":123,"height":37}]},{"text":"그러나 수음과 같은 이벤트가 일어나서는 안 된다. 어떤 프로세스가 I/O 요구를 하","words":[{"text":"그러나","x":353,"y":620,"width":91,"height":35},{"text":"수음과","x":456,"y":620,"width":88,"height":35},{"text":"같은","x":556,"y":620,"width":59,"height":34},{"text":"이벤트가","x":626,"y":620,"width":117,"height":35},{"text":"일어나서는","x":756,"y":621,"width":148,"height":35},{"text":"안","x":916,"y":623,"width":30,"height":34},{"text":"된다.","x":958,"y":623,"width":67,"height":35},{"text":"어떤","x":1041,"y":624,"width":59,"height":35},{"text":"프로세스가","x":1115,"y":622,"width":162,"height":36},{"text":"I/O","x":1289,"y":624,"width":65,"height":32},{"text":"요구를","x":1368,"y":623,"width":98,"height":33},{"text":"하","x":1479,"y":623,"width":31,"height":34}]},{"text":"면 이 요구는 I/O 장치의 큐(queue)에 들어간다. 그동안 CPU는 다른 프로세스에 할당","words":[{"text":"면","x":296,"y":678,"width":28,"height":34},{"text":"이","x":338,"y":679,"width":25,"height":34},{"text":"요구는","x":378,"y":680,"width":90,"height":33},{"text":"I/O","x":478,"y":681,"width":58,"height":31},{"text":"장치의","x":548,"y":678,"width":84,"height":35},{"text":"큐(queue)에","x":645,"y":679,"width":172,"height":40},{"text":"들어간다.","x":830,"y":680,"width":127,"height":36},{"text":"그동안","x":970,"y":681,"width":93,"height":36},{"text":"CPU는","x":1073,"y":683,"width":109,"height":32},{"text":"다른","x":1195,"y":681,"width":64,"height":35},{"text":"프로세스에","x":1271,"y":680,"width":161,"height":35},{"text":"할당","x":1447,"y":681,"width":64,"height":35}]},{"text":"된다. 그런데 이 프로세스가 페이지 폴트를 일으기고 전역 교체 알고리즘을 시용하여, 마","words":[{"text":"된다.","x":295,"y":737,"width":67,"height":34},{"text":"그런데","x":376,"y":737,"width":87,"height":35},{"text":"이","x":477,"y":736,"width":25,"height":35},{"text":"프로세스가","x":516,"y":736,"width":147,"height":36},{"text":"페이지","x":674,"y":736,"width":83,"height":36},{"text":"폴트를","x":771,"y":739,"width":90,"height":34},{"text":"일으기고","x":874,"y":739,"width":119,"height":36},{"text":"전역","x":1006,"y":740,"width":56,"height":35},{"text":"교체","x":1078,"y":740,"width":59,"height":35},{"text":"알고리즘을","x":1153,"y":740,"width":163,"height":35},{"text":"시용하여,","x":1328,"y":739,"width":139,"height":36},{"text":"마","x":1480,"y":740,"width":31,"height":35}]},{"text":"침 대기 중인 프로세서의 버퍼 메모리를 포함한 페이지를 교체한다. 그 페이지는 페이지","words":[{"text":"침","x":296,"y":794,"width":25,"height":35},{"text":"대기","x":338,"y":794,"width":55,"height":36},{"text":"중인","x":408,"y":794,"width":59,"height":35},{"text":"프로세서의","x":480,"y":795,"width":143,"height":35},{"text":"버퍼","x":640,"y":795,"width":53,"height":36},{"text":"메모리를","x":708,"y":795,"width":118,"height":36},{"text":"포함한","x":838,"y":797,"width":90,"height":35},{"text":"페이지를","x":941,"y":798,"width":122,"height":34},{"text":"교체한다.","x":1075,"y":798,"width":134,"height":35},{"text":"그","x":1224,"y":803,"width":32,"height":23},{"text":"페이지는","x":1271,"y":798,"width":132,"height":34},{"text":"페이지","x":1417,"y":798,"width":90,"height":35}]},{"text":"이웃된다. 시간이 흐른 후 I/O 요청이 큐의 맨 앞으로 이동하고 1/0 작업이 처리된다.","words":[{"text":"이웃된다.","x":293,"y":853,"width":128,"height":35},{"text":"시간이","x":437,"y":853,"width":85,"height":35},{"text":"흐른","x":537,"y":855,"width":60,"height":33},{"text":"후","x":607,"y":854,"width":30,"height":34},{"text":"I/O","x":649,"y":856,"width":58,"height":32},{"text":"요청이","x":720,"y":855,"width":86,"height":35},{"text":"큐의","x":822,"y":856,"width":56,"height":34},{"text":"맨","x":895,"y":856,"width":28,"height":33},{"text":"앞으로","x":938,"y":856,"width":90,"height":34},{"text":"이동하고","x":1043,"y":857,"width":125,"height":34},{"text":"1/0","x":1181,"y":858,"width":64,"height":32},{"text":"작업이","x":1261,"y":856,"width":95,"height":35},{"text":"처리된다.","x":1376,"y":856,"width":134,"height":35}]},{"text":"그러나 원래 버퍼가 있는 프레임은 이미 다른 프로세스에 의해 久卜\u0026되고 있다.","words":[{"text":"그러나","x":292,"y":910,"width":92,"height":36},{"text":"원래","x":396,"y":911,"width":56,"height":35},{"text":"버퍼가","x":466,"y":912,"width":89,"height":35},{"text":"있는","x":566,"y":912,"width":57,"height":35},{"text":"프레임은","x":633,"y":912,"width":119,"height":35},{"text":"이미","x":764,"y":913,"width":54,"height":35},{"text":"다른","x":833,"y":913,"width":60,"height":35},{"text":"프로세스에","x":903,"y":915,"width":150,"height":34},{"text":"의해","x":1069,"y":915,"width":58,"height":34},{"text":"久卜\u0026되고","x":1142,"y":914,"width":130,"height":35},{"text":"있다.","x":1286,"y":914,"width":71,"height":36}]},{"text":"이러한 문제의 해결책은 일반적으로 두 가지 방법이 있다. 한 가지 해결책은 사용자","words":[{"text":"이러한","x":350,"y":969,"width":90,"height":35},{"text":"문제의","x":449,"y":970,"width":88,"height":34},{"text":"해결책은","x":552,"y":970,"width":118,"height":35},{"text":"일반적으로","x":683,"y":970,"width":147,"height":36},{"text":"두","x":841,"y":974,"width":30,"height":32},{"text":"가지","x":884,"y":973,"width":56,"height":34},{"text":"방법이","x":956,"y":973,"width":88,"height":34},{"text":"있다.","x":1063,"y":972,"width":67,"height":35},{"text":"한","x":1145,"y":972,"width":33,"height":33},{"text":"가지","x":1191,"y":972,"width":60,"height":34},{"text":"해결책은","x":1269,"y":973,"width":133,"height":34},{"text":"사용자","x":1415,"y":972,"width":96,"height":35}]},{"text":"공간에는 I/0를 하지 않는 것이다. 실제 I/O는 항상 시스템 공간과 I/O 장치 사이에서","words":[{"text":"공간에는","x":291,"y":1027,"width":122,"height":35},{"text":"I/0를","x":422,"y":1029,"width":90,"height":33},{"text":"하지","x":522,"y":1027,"width":55,"height":35},{"text":"않는","x":592,"y":1028,"width":59,"height":35},{"text":"것이다.","x":662,"y":1028,"width":94,"height":36},{"text":"실제","x":770,"y":1029,"width":56,"height":35},{"text":"I/O는","x":838,"y":1032,"width":91,"height":31},{"text":"항상","x":940,"y":1030,"width":62,"height":34},{"text":"시스템","x":1013,"y":1030,"width":89,"height":34},{"text":"공간과","x":1117,"y":1030,"width":98,"height":34},{"text":"I/O","x":1224,"y":1033,"width":66,"height":31},{"text":"장치","x":1303,"y":1031,"width":62,"height":34},{"text":"사이에서","x":1382,"y":1030,"width":125,"height":36}]},{"text":"만 하고 그 대신에 데이터가 일단 시스템 공간에 들어오면 그 후에 시스템 버퍼와 사용","words":[{"text":"만","x":291,"y":1086,"width":30,"height":34},{"text":"하고","x":334,"y":1085,"width":60,"height":35},{"text":"그","x":406,"y":1090,"width":30,"height":24},{"text":"대신에","x":449,"y":1085,"width":86,"height":35},{"text":"데이터가","x":551,"y":1086,"width":118,"height":34},{"text":"일단","x":683,"y":1087,"width":58,"height":33},{"text":"시스템","x":754,"y":1087,"width":85,"height":35},{"text":"공간에","x":855,"y":1088,"width":88,"height":34},{"text":"들어오면","x":958,"y":1088,"width":124,"height":34},{"text":"그","x":1097,"y":1092,"width":31,"height":24},{"text":"후에","x":1141,"y":1088,"width":62,"height":35},{"text":"시스템","x":1222,"y":1088,"width":95,"height":35},{"text":"버퍼와","x":1336,"y":1088,"width":98,"height":35},{"text":"사용","x":1447,"y":1088,"width":64,"height":35}]},{"text":"자 버퍼 사이에서 데이터를 다시 움직이도록 한다. 따라서 어떤 블록을 쓰고 싶으면 먼","words":[{"text":"자","x":289,"y":1144,"width":32,"height":34},{"text":"버퍼","x":334,"y":1144,"width":55,"height":34},{"text":"사이에서","x":406,"y":1144,"width":115,"height":34},{"text":"데이터를","x":538,"y":1144,"width":118,"height":34},{"text":"다시","x":669,"y":1145,"width":55,"height":35},{"text":"움직이도록","x":740,"y":1145,"width":151,"height":35},{"text":"한다.","x":904,"y":1145,"width":67,"height":34},{"text":"따라서","x":988,"y":1145,"width":89,"height":34},{"text":"어떤","x":1096,"y":1146,"width":61,"height":34},{"text":"블록을","x":1172,"y":1146,"width":99,"height":34},{"text":"쓰고","x":1286,"y":1149,"width":66,"height":25},{"text":"싶으면","x":1368,"y":1146,"width":96,"height":34},{"text":"먼","x":1481,"y":1146,"width":28,"height":34}]},{"text":"저 시스템 메모리로 복사하고 거기서 디스크에 쓰기 작업을 수행해야 한다. 이렇게 하면","words":[{"text":"저","x":290,"y":1202,"width":25,"height":35},{"text":"시스템","x":332,"y":1202,"width":86,"height":35},{"text":"메모리로","x":432,"y":1202,"width":118,"height":35},{"text":"복사하고","x":561,"y":1202,"width":119,"height":35},{"text":"거기서","x":693,"y":1202,"width":84,"height":35},{"text":"디스크에","x":794,"y":1202,"width":116,"height":35},{"text":"쓰기","x":924,"y":1203,"width":57,"height":33},{"text":"작업을","x":998,"y":1203,"width":95,"height":34},{"text":"수행해야","x":1104,"y":1204,"width":130,"height":34},{"text":"한다.","x":1246,"y":1204,"width":73,"height":35},{"text":"이렇게","x":1337,"y":1204,"width":94,"height":34},{"text":"하면","x":1446,"y":1203,"width":62,"height":35}]},{"text":"데이터가 두 번 움직여야 하는 오버헤드를 초래할 수 있다.","words":[{"text":"데이터가","x":289,"y":1260,"width":121,"height":35},{"text":"두","x":418,"y":1262,"width":30,"height":33},{"text":"번","x":461,"y":1260,"width":27,"height":34},{"text":"움직여야","x":498,"y":1261,"width":120,"height":35},{"text":"하는","x":628,"y":1260,"width":60,"height":35},{"text":"오버헤드를","x":697,"y":1261,"width":151,"height":35},{"text":"초래할","x":858,"y":1260,"width":92,"height":34},{"text":"수","x":960,"y":1261,"width":31,"height":33},{"text":"있다.","x":1005,"y":1261,"width":66,"height":34}]},{"text":"또 다른 해결책은 페이지를 메모리에서 잠금(lock)하는 것이다. 잠금 비트(lock-bit)","words":[{"text":"또","x":344,"y":1323,"width":30,"height":25},{"text":"다른","x":385,"y":1319,"width":60,"height":34},{"text":"해결책은","x":455,"y":1318,"width":119,"height":35},{"text":"페이지를","x":584,"y":1319,"width":119,"height":35},{"text":"메모리에서","x":714,"y":1318,"width":145,"height":36},{"text":"잠금(lock)하는","x":874,"y":1318,"width":214,"height":37},{"text":"것이다.","x":1101,"y":1320,"width":102,"height":35},{"text":"잠금","x":1217,"y":1320,"width":66,"height":34},{"text":"비트(lock-bit)","x":1297,"y":1320,"width":211,"height":37}]},{"text":"를 프레임마다 두고 만약 프레임이 잠기면 그것은 교체 고려 대상에서 제외된다. 이러한","words":[{"text":"를","x":286,"y":1380,"width":32,"height":32},{"text":"프레임마다","x":329,"y":1377,"width":150,"height":35},{"text":"두고","x":488,"y":1379,"width":60,"height":33},{"text":"만약","x":560,"y":1377,"width":59,"height":35},{"text":"프레임이","x":630,"y":1377,"width":116,"height":35},{"text":"잠기면","x":761,"y":1376,"width":89,"height":35},{"text":"그것은","x":863,"y":1376,"width":91,"height":34},{"text":"교체","x":966,"y":1376,"width":59,"height":35},{"text":"고려","x":1040,"y":1378,"width":60,"height":34},{"text":"대상에서","x":1118,"y":1378,"width":124,"height":34},{"text":"제외된다.","x":1260,"y":1377,"width":138,"height":36},{"text":"이러한","x":1415,"y":1376,"width":96,"height":35}]},{"text":"버퍼","words":[{"text":"버퍼","x":658,"y":1719,"width":42,"height":25}]},{"text":"디스크 드라이브","words":[{"text":"디스크","x":983,"y":1771,"width":68,"height":26},{"text":"드라이브","x":1058,"y":1770,"width":96,"height":26}]},{"text":"그림 10.28 |/0에 시용되는 프레임이 메모리 내에 존재해야 하는 이유","words":[{"text":"그림","x":492,"y":2272,"width":46,"height":26},{"text":"10.28","x":549,"y":2274,"width":67,"height":22},{"text":"|/0에","x":646,"y":2272,"width":57,"height":27},{"text":"시용되는","x":712,"y":2272,"width":94,"height":27},{"text":"프레임이","x":813,"y":2272,"width":93,"height":27},{"text":"메모리","x":917,"y":2273,"width":67,"height":27},{"text":"내에","x":996,"y":2273,"width":45,"height":27},{"text":"존재해야","x":1051,"y":2273,"width":100,"height":27},{"text":"하는","x":1160,"y":2273,"width":51,"height":27},{"text":"이유","x":1221,"y":2273,"width":52,"height":28}]}]}