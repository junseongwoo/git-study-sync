76,"height":40},{"text":"CPUO은","x":406,"y":614,"width":129,"height":41},{"text":"자체","x":546,"y":613,"width":63,"height":39},{"text":"로컬","x":624,"y":614,"width":63,"height":38},{"text":"메모리에","x":702,"y":615,"width":129,"height":38},{"text":"액세스","x":847,"y":615,"width":97,"height":39},{"text":"할","x":957,"y":615,"width":34,"height":38},{"text":"수","x":1001,"y":614,"width":34,"height":39},{"text":"있는","x":1049,"y":614,"width":66,"height":40},{"text":"만큼","x":1127,"y":615,"width":67,"height":39},{"text":"빠르게","x":1206,"y":615,"width":99,"height":39},{"text":"CPU3의","x":1320,"y":616,"width":130,"height":42},{"text":"로컬","x":1466,"y":616,"width":68,"height":37},{"text":"메모리","x":1549,"y":614,"width":95,"height":42}]},{"text":"에 액세스 할수 없어 성능이 저하된다. 5.5.2절과 10.5.4절에서 논의된 것처럼 운영체제","words":[{"text":"에","x":319,"y":675,"width":29,"height":39},{"text":"액세스","x":365,"y":676,"width":99,"height":38},{"text":"할수","x":477,"y":677,"width":78,"height":38},{"text":"없어","x":569,"y":677,"width":60,"height":39},{"text":"성능이","x":646,"y":678,"width":94,"height":39},{"text":"저하된다.","x":758,"y":678,"width":137,"height":39},{"text":"5.5.2절과","x":909,"y":678,"width":146,"height":39},{"text":"10.5.4절에서","x":1067,"y":679,"width":194,"height":39},{"text":"논의된","x":1278,"y":680,"width":103,"height":38},{"text":"것처럼","x":1397,"y":680,"width":99,"height":39},{"text":"운영체제","x":1513,"y":679,"width":132,"height":41}]},{"text":"는 신중한 CPU 스케줄링 및 메모리 관리를 통해 이 NUMA의 단점을 최소화할 수 있","words":[{"text":"는","x":318,"y":741,"width":34,"height":36},{"text":"신중한","x":366,"y":740,"width":100,"height":39},{"text":"CPU","x":477,"y":744,"width":80,"height":31},{"text":"스케줄링","x":571,"y":741,"width":128,"height":39},{"text":"및","x":718,"y":742,"width":29,"height":38},{"text":"메모리","x":763,"y":742,"width":95,"height":38},{"text":"관리를","x":875,"y":742,"width":101,"height":40},{"text":"통해","x":989,"y":743,"width":64,"height":38},{"text":"이","x":1071,"y":743,"width":28,"height":38},{"text":"NUMA의","x":1116,"y":744,"wi