.","words":[{"text":"및","x":347,"y":1302,"width":31,"height":39},{"text":"사용자로","x":390,"y":1303,"width":142,"height":40},{"text":"구분할","x":542,"y":1304,"width":106,"height":39},{"text":"수","x":658,"y":1304,"width":36,"height":39},{"text":"있다(그림","x":708,"y":1303,"width":146,"height":42},{"text":"1.1).","x":871,"y":1306,"width":69,"height":39}]},{"text":"하드웨어는 중앙 처리 장치(CPU), 메모리 및 입출력(I/O) 장치로 구성되어, 기본","words":[{"text":"하드웨어는","x":409,"y":1369,"width":174,"height":40},{"text":"중앙","x":596,"y":1370,"width":72,"height":39},{"text":"처리","x":684,"y":1369,"width":63,"height":39},{"text":"장치(CPU),","x":767,"y":1369,"width":189,"height":42},{"text":"메모리","x":976,"y":1368,"width":101,"height":39},{"text":"및","x":1099,"y":1368,"width":31,"height":39},{"text":"입출력(I/O)","x":1153,"y":1369,"width":203,"height":43},{"text":"장치로","x":1375,"y":1368,"width":111,"height":39},{"text":"구성되어,","x":1503,"y":1368,"width":158,"height":41},{"text":"기본","x":1681,"y":1369,"width":71,"height":39}]},{"text":"계산용 자원을 제공한다. 응용 프로그램인 워드 프로세서, 스프레드시트, 컴파일러, 그리","words":[{"text":"계산용","x":344,"y":1433,"width":104,"height":41},{"text":"자원을","x":460,"y":1436,"width":104,"height":39},{"text":"제공한다.","x":577,"y":1436,"width":144,"height":39},{"text":"응용","x":736,"y":1436,"width":70,"height":38},{"text":"프로그램인","x":818,"y":1433,"width":174,"height":39},{"text":"워드","x":1009,"y":1434,"width":70,"height":39},{"text":"프로세서,","x":1092,"y":1435,"width":153,"height":40},{"text":"스프레드시트,","x":1260,"y":1434,"width":230,"height":41},{"text":"컴파일러,","x":1509,"y":1435,"width":155,"height":40},{"text":"그리","x":1680,"y":1436,"width":67,"height":39}]},{"text":"고 웹 브라우저 등은 사용자의 계산 문제를 해결하기 위해 이들 자원이 어떻게 시용될지","words":[{"text":"고","x":341,"y":1505,"width":35,"height":27},{"text":"웹","x":390,"y":1501,"width":31,"height":39},{"text":"브라우저","x":436,"y":1502,"width":135,"height":40},{"text":"등은","x":587,"y":1502,"width":71,"height":40},{"text":"사용자의","x":669,"y":1501,"width":135,"height":40},{"text":"계산","x":822,"y":1501,