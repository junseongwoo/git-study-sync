{"page":402,"width":1682,"height":2558,"text_angle":0,"lines":[{"text":"462","words":[{"text":"462","x":180,"y":148,"width":57,"height":28}]},{"text":"Chapter 10 가상 에오리","words":[{"text":"Chapter","x":309,"y":152,"width":117,"height":27},{"text":"10","x":438,"y":154,"width":35,"height":22},{"text":"가상","x":501,"y":155,"width":41,"height":26},{"text":"에오리","x":551,"y":156,"width":62,"height":25}]},{"text":"| thrashing","words":[{"text":"|","x":1037,"y":472,"width":3,"height":18},{"text":"thrashing","x":1065,"y":465,"width":113,"height":28}]},{"text":"degree 0f multiprogramming","words":[{"text":"degree","x":742,"y":776,"width":78,"height":29},{"text":"0f","x":826,"y":775,"width":24,"height":23},{"text":"multiprogramming","x":855,"y":776,"width":218,"height":28}]},{"text":"그림 10.20 스래싱(thrashing)","words":[{"text":"그림","x":725,"y":843,"width":46,"height":28},{"text":"10.20","x":781,"y":845,"width":66,"height":23},{"text":"스래싱(thrashing)","x":875,"y":843,"width":195,"height":30}]},{"text":"이러한 현상은 그림 10.20에 나타나 있다. 이 그림은 다중 프로그래밍 정도에 따른","words":[{"text":"이러한","x":371,"y":972,"width":90,"height":34},{"text":"현상은","x":474,"y":971,"width":88,"height":35},{"text":"그림","x":573,"y":971,"width":55,"height":35},{"text":"10.20에","x":645,"y":971,"width":101,"height":35},{"text":"나타나","x":762,"y":970,"width":86,"height":36},{"text":"있다.","x":863,"y":971,"width":62,"height":34},{"text":"이","x":942,"y":971,"width":25,"height":34},{"text":"그림은","x":984,"y":971,"width":92,"height":34},{"text":"다중","x":1089,"y":971,"width":63,"height":34},{"text":"프로그래밍","x":1165,"y":970,"width":160,"height":34},{"text":"정도에","x":1345,"y":971,"width":93,"height":35},{"text":"따른","x":1456,"y":971,"width":61,"height":35}]},{"text":"CPU 이용률의 그래프를 보여준다. 처음에는 다중 프로그래밍 정도가 높아짐에 따라","words":[{"text":"CPU","x":310,"y":1032,"width":75,"height":29},{"text":"이용률의","x":402,"y":1029,"width":116,"height":35},{"text":"그래프를","x":535,"y":1029,"width":118,"height":35},{"text":"보여준다.","x":667,"y":1029,"width":123,"height":35},{"text":"처음에는","x":809,"y":1029,"width":118,"height":35},{"text":"다중","x":942,"y":1029,"width":60,"height":35},{"text":"프로그래밍","x":1017,"y":1028,"width":154,"height":35},{"text":"정도가","x":1192,"y":1028,"width":98,"height":35},{"text":"높아짐에","x":1305,"y":1029,"width":130,"height":34},{"text":"따라","x":1454,"y":1029,"width":63,"height":35}]},{"text":"CPU의 이용률도 높아진다. 증가 속도가 감소하기는 하지만 최댓값에 도달하기까지 증","words":[{"text":"CPU의","x":310,"y":1089,"width":102,"height":34},{"text":"이용률도","x":429,"y":1088,"width":116,"height":34},{"text":"높아진다.","x":557,"y":1087,"width":122,"height":35},{"text":"증가","x":694,"y":1087,"width":59,"height":35},{"text":"속도가","x":764,"y":1087,"width":89,"height":34},{"text":"감소하기는","x":865,"y":1086,"width":150,"height":36},{"text":"하지만","x":1028,"y":1087,"width":94,"height":35},{"text":"최댓값에","x":1135,"y":1086,"width":124,"height":35},{"text":"도달하기까지","x":1276,"y":1086,"width":192,"height":35},{"text":"증","x":1484,"y":1090,"width":31,"height":32}]},{"text":"가한다. 그러나, 다중 프로그래밍의 정도가 그 이상으로 더 커지면 스래싱이 일어나게 되","words":[{"text":"가한다.","x":312,"y":1145,"width":96,"height":36},{"text":"그러나,","x":421,"y":1146,"width":96,"height":35},{"text":"다중","x":530,"y":1146,"width":58,"height":34},{"text":"프로그래밍의","x":597,"y":1145,"width":171,"height":35},{"text":"정도가","x":784,"y":1145,"width":87,"height":35},{"text":"그","x":880,"y":1150,"width":29,"height":23},{"text":"이상으로","x":922,"y":1145,"width":119,"height":35},{"text":"더","x":1054,"y":1146,"width":25,"height":34},{"text":"커지면","x":1097,"y":1145,"width":91,"height":35},{"text":"스래싱이","x":1201,"y":1144,"width":126,"height":34},{"text":"일어나게","x":1346,"y":1144,"width":124,"height":35},{"text":"되","x":1485,"y":1146,"width":26,"height":34}]},{"text":"고 CPU의 이용률은 급격히 떨어진다. 따라서 이 지점에서는 CPU 이용률을 높이고 스","words":[{"text":"고","x":309,"y":1208,"width":32,"height":24},{"text":"CPU의","x":352,"y":1204,"width":100,"height":34},{"text":"이용률은","x":468,"y":1204,"width":116,"height":34},{"text":"급격히","x":594,"y":1203,"width":84,"height":35},{"text":"떨어진다.","x":696,"y":1203,"width":120,"height":35},{"text":"따라서","x":831,"y":1202,"width":85,"height":36},{"text":"이","x":933,"y":1203,"width":25,"height":35},{"text":"지점에서는","x":975,"y":1204,"width":154,"height":35},{"text":"CPU","x":1141,"y":1206,"width":75,"height":27},{"text":"이용률을","x":1232,"y":1201,"width":130,"height":35},{"text":"높이고","x":1374,"y":1202,"width":97,"height":35},{"text":"스","x":1483,"y":1205,"width":31,"height":26}]},{"text":"래싱을 중지시기기 위해 다중 프로그래밍 정도를 낮춰야만 한다.","words":[{"text":"래싱을","x":310,"y":1261,"width":92,"height":36},{"text":"중지시기기","x":411,"y":1262,"width":143,"height":35},{"text":"위해","x":569,"y":1262,"width":55,"height":34},{"text":"다중","x":638,"y":1261,"width":58,"height":35},{"text":"프로그래밍","x":705,"y":1261,"width":143,"height":35},{"text":"정도를","x":864,"y":1261,"width":88,"height":34},{"text":"낮춰야만","x":963,"y":1261,"width":124,"height":35},{"text":"한다.","x":1099,"y":1261,"width":67,"height":35}]},{"text":"지역 교체 알고리즘(또는 우선순위 교체 알고리즘)을 시용하여 스래싱의 영향을 제","words":[{"text":"지역","x":367,"y":1320,"width":55,"height":35},{"text":"교체","x":438,"y":1320,"width":57,"height":34},{"text":"알고리즘(또는","x":511,"y":1320,"width":185,"height":37},{"text":"우선순위","x":707,"y":1319,"width":115,"height":35},{"text":"교체","x":838,"y":1319,"width":56,"height":35},{"text":"알고리즘)을","x":911,"y":1319,"width":164,"height":37},{"text":"시용하여","x":1088,"y":1318,"width":122,"height":37},{"text":"스래싱의","x":1229,"y":1318,"width":126,"height":34},{"text":"영향을","x":1376,"y":1319,"width":95,"height":35},{"text":"제","x":1485,"y":1320,"width":26,"height":35}]},{"text":"한할 수 있다. 앞에서 언급했듯이 지역 교체 알고리즘에서는 각 프로세스가 지신에게 할","words":[{"text":"한할","x":307,"y":1377,"width":64,"height":34},{"text":"수","x":380,"y":1378,"width":32,"height":34},{"text":"있다.","x":425,"y":1378,"width":63,"height":34},{"text":"앞에서","x":502,"y":1377,"width":83,"height":35},{"text":"언급했듯이","x":602,"y":1377,"width":140,"height":35},{"text":"지역","x":757,"y":1377,"width":54,"height":35},{"text":"교체","x":827,"y":1377,"width":56,"height":34},{"text":"알고리즘에서는","x":898,"y":1377,"width":214,"height":35},{"text":"각","x":1124,"y":1378,"width":32,"height":33},{"text":"프로세스가","x":1168,"y":1376,"width":162,"height":35},{"text":"지신에게","x":1344,"y":1377,"width":125,"height":36},{"text":"할","x":1484,"y":1379,"width":32,"height":34}]},{"text":"당된 프레임 세트에서만 선택해야 한다. 따라서 하나의 프로세스가 스래싱을 시작하면","words":[{"text":"당된","x":306,"y":1435,"width":61,"height":34},{"text":"프레임","x":383,"y":1436,"width":86,"height":34},{"text":"세트에서만","x":486,"y":1435,"width":146,"height":35},{"text":"선택해야","x":646,"y":1435,"width":117,"height":36},{"text":"한다.","x":776,"y":1436,"width":65,"height":34},{"text":"따라서","x":858,"y":1435,"width":84,"height":35},{"text":"하나의","x":961,"y":1435,"width":88,"height":35},{"text":"프로세스가","x":1067,"y":1434,"width":161,"height":36},{"text":"스래싱을","x":1242,"y":1434,"width":131,"height":35},{"text":"시작하면","x":1389,"y":1436,"width":125,"height":36}]},{"text":"다른 프로세스의 프레임을 빼앗아 후자가 스래싱을 유발하도록 할 수 없다. 그러나 문제","words":[{"text":"다른","x":307,"y":1493,"width":62,"height":35},{"text":"프로세스의","x":379,"y":1494,"width":146,"height":34},{"text":"프레임을","x":539,"y":1493,"width":117,"height":35},{"text":"빼앗아","x":667,"y":1493,"width":89,"height":35},{"text":"후자가","x":765,"y":1493,"width":90,"height":35},{"text":"스래싱을","x":866,"y":1493,"width":120,"height":35},{"text":"유발하도록","x":997,"y":1493,"width":157,"height":35},{"text":"할","x":1166,"y":1493,"width":33,"height":34},{"text":"수","x":1209,"y":1493,"width":34,"height":34},{"text":"없다.","x":1257,"y":1492,"width":69,"height":35},{"text":"그러나","x":1342,"y":1494,"width":99,"height":34},{"text":"문제","x":1452,"y":1496,"width":60,"height":34}]},{"text":"가 완전히 해결되지는 않는다. 프로세스가 스래싱하는 경우 대부끈 페이징 장치의 큐에","words":[{"text":"가","x":307,"y":1551,"width":31,"height":34},{"text":"완전히","x":350,"y":1552,"width":88,"height":35},{"text":"해결되지는","x":454,"y":1552,"width":146,"height":35},{"text":"않는다.","x":612,"y":1552,"width":93,"height":35},{"text":"프로세스가","x":720,"y":1552,"width":148,"height":34},{"text":"스래싱하는","x":880,"y":1551,"width":151,"height":35},{"text":"경우","x":1045,"y":1552,"width":62,"height":34},{"text":"대부끈","x":1121,"y":1552,"width":95,"height":34},{"text":"페이징","x":1230,"y":1551,"width":92,"height":34},{"text":"장치의","x":1340,"y":1552,"width":96,"height":36},{"text":"큐에","x":1453,"y":1554,"width":59,"height":35}]},{"text":"서 기다리게 된다. 페이징 장치의 평균 대기열이 길어지기 때문에 페이지 폴트의 평균","words":[{"text":"서","x":306,"y":1610,"width":27,"height":34},{"text":"기다리게","x":353,"y":1610,"width":117,"height":36},{"text":"된다.","x":487,"y":1610,"width":63,"height":35},{"text":"페이징","x":567,"y":1610,"width":83,"height":35},{"text":"장치의","x":668,"y":1610,"width":84,"height":35},{"text":"평균","x":770,"y":1610,"width":58,"height":34},{"text":"대기열이","x":843,"y":1609,"width":115,"height":35},{"text":"길어지기","x":977,"y":1609,"width":118,"height":35},{"text":"때문에","x":1116,"y":1610,"width":91,"height":35},{"text":"페이지","x":1227,"y":1609,"width":92,"height":35},{"text":"폴트의","x":1338,"y":1611,"width":96,"height":34},{"text":"평균","x":1454,"y":1612,"width":61,"height":34}]},{"text":"서비스 시간이 늘어난다. 따라서 스래싱되지 않은 프로세스에서도 실질 접근 시간이 증","words":[{"text":"서비스","x":306,"y":1669,"width":93,"height":35},{"text":"시간이","x":412,"y":1669,"width":85,"height":35},{"text":"늘어난다.","x":512,"y":1669,"width":123,"height":35},{"text":"따라서","x":649,"y":1669,"width":84,"height":35},{"text":"스래싱되지","x":749,"y":1668,"width":144,"height":36},{"text":"않은","x":910,"y":1666,"width":60,"height":37},{"text":"프로세스에서도","x":982,"y":1668,"width":220,"height":36},{"text":"실질","x":1216,"y":1668,"width":62,"height":34},{"text":"접근","x":1295,"y":1668,"width":65,"height":34},{"text":"시간이","x":1374,"y":1668,"width":93,"height":36},{"text":"증","x":1484,"y":1672,"width":32,"height":33}]},{"text":"가한다.","words":[{"text":"가한다.","x":306,"y":1728,"width":100,"height":36}]},{"text":"스래싱 현상을 방지하기 위해서는 각 프로세스가 필요로 하는 최소한의 프레임 개수","words":[{"text":"스래싱","x":365,"y":1788,"width":88,"height":36},{"text":"현상을","x":468,"y":1788,"width":86,"height":36},{"text":"방지하기","x":565,"y":1788,"width":112,"height":36},{"text":"위해서는","x":692,"y":1787,"width":116,"height":36},{"text":"각","x":819,"y":1787,"width":30,"height":35},{"text":"프로세스가","x":859,"y":1786,"width":151,"height":35},{"text":"필요로","x":1022,"y":1786,"width":92,"height":34},{"text":"하는","x":1126,"y":1786,"width":63,"height":35},{"text":"최소한의","x":1202,"y":1785,"width":125,"height":36},{"text":"프레임","x":1342,"y":1785,"width":95,"height":35},{"text":"개수","x":1454,"y":1786,"width":61,"height":36}]},{"text":"를 보장해야 한다. 그러나 어떻게 각 프로세스가 “필요로 하는” 최소한의 프레임 수를 알","words":[{"text":"를","x":306,"y":1847,"width":33,"height":33},{"text":"보장해야","x":350,"y":1848,"width":122,"height":35},{"text":"한다.","x":482,"y":1848,"width":64,"height":34},{"text":"그러나","x":560,"y":1848,"width":87,"height":35},{"text":"어떻게","x":658,"y":1847,"width":83,"height":36},{"text":"각","x":755,"y":1847,"width":29,"height":34},{"text":"프로세스가","x":795,"y":1845,"width":149,"height":36},{"text":"“필요로","x":954,"y":1845,"width":104,"height":35},{"text":"하는”","x":1069,"y":1845,"width":75,"height":35},{"text":"최소한의","x":1158,"y":1844,"width":123,"height":36},{"text":"프레임","x":1297,"y":1844,"width":95,"height":35},{"text":"수를","x":1408,"y":1844,"width":65,"height":35},{"text":"알","x":1486,"y":1845,"width":30,"height":34}]},{"text":"수가 있겠는가? 한 가지 전략은 프로세스가 실제로 시용하고 있는 프레임의 수가 몇 개","words":[{"text":"수가","x":307,"y":1905,"width":64,"height":36},{"text":"있겠는가?","x":385,"y":1907,"width":131,"height":35},{"text":"한","x":529,"y":1907,"width":30,"height":34},{"text":"가지","x":571,"y":1906,"width":54,"height":36},{"text":"전략은","x":641,"y":1906,"width":87,"height":35},{"text":"프로세스가","x":740,"y":1905,"width":147,"height":35},{"text":"실제로","x":900,"y":1905,"width":89,"height":35},{"text":"시용하고","x":1002,"y":1904,"width":123,"height":36},{"text":"있는","x":1141,"y":1904,"width":62,"height":35},{"text":"프레임의","x":1216,"y":1902,"width":126,"height":36},{"text":"수가","