":"위해","x":1490,"y":658,"width":67,"height":40},{"text":"사용될","x":1574,"y":657,"width":104,"height":41}]},{"text":"수 있다. 아주 초보적인 수준에서 컴퓨터는 통신할 때마다 네트워크를 사용하거나 생성","words":[{"text":"수","x":303,"y":725,"width":34,"height":38},{"text":"있다.","x":354,"y":724,"width":73,"height":39},{"text":"아주","x":446,"y":724,"width":68,"height":39},{"text":"초보적인","x":528,"y":725,"width":138,"height":38},{"text":"수준에서","x":681,"y":726,"width":135,"height":39},{"text":"컴퓨터는","x":838,"y":727,"width":136,"height":40},{"text":"통신할","x":989,"y":727,"width":105,"height":39},{"text":"때마다","x":1110,"y":726,"width":103,"height":39},{"text":"네트워크를","x":1229,"y":725,"width":175,"height":40},{"text":"사용하거나","x":1418,"y":725,"width":177,"height":41},{"text":"생성","x":1610,"y":725,"width":67,"height":40}]},{"text":"한다. 이들 네트워크는 성능과 신뢰도에 차이가 있다.","words":[{"text":"한다.","x":303,"y":790,"width":75,"height":39},{"text":"이들","x":395,"y":790,"width":68,"height":38},{"text":"네트워크는","x":477,"y":790,"width":171,"height":39},{"text":"성능과","x":662,"y":792,"width":104,"height":38},{"text":"신뢰도에","x":779,"y":792,"width":135,"height":39},{"text":"차이가","x":930,"y":793,"width":105,"height":39},{"text":"있다.","x":1050,"y":792,"width":73,"height":40}]},{"text":"일부 운영체제는 네트워크 연결 제공 개념을 넘어서서 네트워크 및 분산 시스템 개","words":[{"text":"일부","x":369,"y":856,"width":66,"height":38},{"text":"운영체제는","x":449,"y":855,"width":175,"height":39},{"text":"네트워크","x":640,"y":856,"width":138,"height":40},{"text":"연결","x":796,"y":857,"width":65,"height":39},{"text":"제공","x":879,"y":857,"width":68,"height":40},{"text":"개념을","x":965,"y":857,"width":102,"height":39},{"text":"넘어서서","x":1083,"y":858,"width":133,"height":38},{"text":"네트워크","x":1238,"y":857,"width":138,"height":39},{"text":"및","x":1393,"y":858,"width":30,"height":39},{"text":"분산","x":1440,"y":858,"width":72,"height":38},{"text":"시스템","x":1526,"y":858,"width":101,"height":38},{"text":"개","x":1647,"y":858,"width":30,"height":38}]},{"text":"님을 취했다. 네트워크 운영체제는 다른 컴퓨터의 다른 프로세스가 메시지를 교환할 수","w