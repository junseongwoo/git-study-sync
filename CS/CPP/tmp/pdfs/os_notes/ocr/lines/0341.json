s":[{"text":"다.","x":309,"y":1785,"width":40,"height":36},{"text":"그다음","x":365,"y":1783,"width":101,"height":36},{"text":"페이지는","x":480,"y":1784,"width":131,"height":36},{"text":"또","x":622,"y":1789,"width":33,"height":25},{"text":"다른","x":669,"y":1785,"width":64,"height":36},{"text":"프레임에","x":745,"y":1786,"width":123,"height":36},{"text":"적재되고,","x":885,"y":1786,"width":130,"height":37},{"text":"또","x":1029,"y":1791,"width":31,"height":25},{"text":"그","x":1073,"y":1792,"width":31,"height":24},{"text":"프레임","x":1115,"y":1788,"width":91,"height":35},{"text":"번호가","x":1223,"y":1789,"width":94,"height":35},{"text":"페이지","x":1329,"y":1788,"width":91,"height":37},{"text":"테이블에","x":1438,"y":1789,"width":125,"height":36}]},{"text":"기록되며 이 과정이 반복된다(그림 9.11).","words":[{"text":"기록되며","x":312,"y":1844,"width":127,"height":37},{"text":"이","x":456,"y":1844,"width":28,"height":36},{"text":"과정이","x":500,"y":1844,"width":94,"height":37},{"text":"반복된다(그림","x":610,"y":1845,"width":199,"height":40},{"text":"9.11).","x":824,"y":1850,"width":79,"height":36}]},{"text":"페이징의 가장 중요한 특징은 메모리에 대한 프로그래머의 인식과 실제 내용이 서로","words":[{"text":"페이징의","x":373,"y":1905,"width":129,"height":36},{"text":"가장","x":519,"y":1905,"width":65,"height":36},{"text":"중요한","x":594,"y":1906,"width":99,"height":36},{"text":"특징은","x":703,"y":1907,"width":96,"height":36},{"text":"메모리에","x":810,"y":1907,"width":121,"height":37},{"text":"대한","x":946,"y":1907,"width":62,"height":37},{"text":"프로그래머의","x":1017,"y":1909,"width":183,"height":36},{"text":"인식과","x":1216,"y":1910,"width":93,"height":36},{"text":"실제","x":1320,"y":1909,"width":59,"height":36},{"text":"내용이","x":1394,"y":1909,"width":92,"height":36},{"text":"서로","x":1502,"y":1910,"width":64,"height":35}]},{"text":"다르다는 것이다. 프로그래머는 메모리가 하나의 연속적인 공간이며, 메모리에는 이 프","words":[{"text":"다르다는","x":312,"y":1965,"width":134,"height":37},{"text":"것이다.","x":461,"y":1966,"width":104,"height":36},{"text":"프로그래머는","x":582,"y":1968,"width":193,"height":36},{"text":"메모리가","x":789,"y":1968,"width":124,"height":37},{"text":"하나의","x":925,"y":1968,"width":90,"height":37},{"text":"연속적인","x":1033,"y":1969,"width":120,"height":36},{"text":"공간이며,","x":1167,"y":1970,"width":133,"height":37},{"text":"메모리에는","x":1316,"y":1970,"width":158,"height":37},{"text":"이","x":1489,"y":1970,"width":27,"height":36},{"text":"프","x":1534,"y":1974,"width":32,"height":26}]},{"text":"로그램만 있다고 생각한다. 그러나 실제로는 프로그램은 여러 곳에 프레임 단위로 분한","words":[{"text":"로그램만","x":312,"y":2026,"width":135,"height":35},{"text":"있다고","x":463,"y":2026,"width":96,"height":36},{"text":"생각한다.","x":573,"y":2027,"width":135,"height":37},{"text":"그러나","x":724,"y":2029,"width":95,"height":36},{"text":"실제로는","x":833,"y":2029,"width":123,"height":37},{"text":"프로그램은","x":968,"y":2029,"width":154,"height":36},{"text":"여러","x":1136,"y":2030,"width":57,"height":36},{"text":"곳에","x":1208,"y":2031,"width":61,"height":36},{"text":"프레임","x":1285,"y":2031,"width":91,"height":36},{"text":"단위로","x":1392,"y":2030,"width":96,"height":36},{"text":"분한","x":1501,"y":2031,"width":67,"height":34}]},{"text":"되어 있고, 많은 다른 프로그램이 올라와 있다. 프로그래머가 생각하는 메모리와 실제 물","words":[{"text":"되어","x":314,"y":2086,"width":61,"height":36},{"text":"있고,","x":394,"y":2086,"width":73,"height":37},{"text":"많은","x":481,"y":2086,"width":66,"height":37},{"text":"다른","x":558,"y":2088,"width":65,"height":35},{"text":"프로그램이","x":634,"y":2089,"width":155,"height":36},{"text":"올라와","x":804,"y":2090,"width":95,"height":36},{"text":"있다.","x":910,"y":2090,"width":65,"height":36},{"text":"프로그래머가","x":989,"y":2090,"width":186,"height":37},{"text":"생각하는","x":1185,"y":2091,"width":125,"height":36},{"text":"메모리와","x":1322,"y":2090,"width":126,"height":37},{"text":"실제","x":1459,"y":2090,"width":61,"height":36},{"text":"물","x":1534,"y":2092,"width":33,"height":33}]},{"text":"리 메모리의 차이는 주소 변환 하드웨어에 의해 해소된다. 논리 주소는 물리 주소로 변","words":[{"text":"리","x":316,"y":2146,"width":26,"height":36},{"text":"메모리의","x":362,"y":2146,"width":130,"height":36},{"text":"차이는","x":510,"y":2147,"width":100,"height":37},{"text":"주소","x":621,"y":2150,"width":66,"height":34},{"text":"변환","x":702,"y":2149,"width":62,"height":35},{"text":"하드웨어에","x":777,"y":2150,"width":152,"height":36},{"text":"의해","x":945,"y":2150,"width":59,"height":36},{"text":"해소된다.","x":1019,"y":2151,"width":129,"height":36},{"text":"논리","x":1164,"y":2151,"width":59,"height":36},{"text":"주소는","x":1240,"y":2153,"width":95,"height":35},{"text":"물리","x":1347,"y":2152,"width":60,"height":35},{"text":"주소로","x":1424,"y":2153,"width":96,"height":34},{"text":"변","x":1536,"y":2151,"width":30,"height":34}]},{"text":"환된다. 이 시상은 프로그래머에게는 안 보이고 운영체제에 의해 조정된다. 따라서 사용","words":[{"text":"환된다.","x":313,"y":2207,"width":109,"height":36},{"text":"이","x":440,"y":2207,"width":27,"height":36},{"text":"시상은","x":485,"y":2208,"width":99,"height":36},{"text":"프로그래머에게는","x":596,"y":2210,"width":253,"height":35},{"text":"안","x":862,"y":2210,"width":30,"height":34},{"text":"보이고","x":903,"y":2210,"width":92,"height":36},{"text":"운영체제에","x":1006,"y":2211,"width":152,"height":36},{"text":"의해","x":1174,"y":2211,"width":59,"height":36},{"text":"조정된다.","x":1248,"y":2212,"width":132,"height":36},{"text":"따라서","x":1394,"y":2211,"width":92,"height":36},{"text":"사용","x":1502,"y":2210,"width":66,"height":36}]},{"text":"자 프로세스는 자기의 것이 아닌 메모리는 접근조차 할 수가 없다. 페이지 테이블을 통","words":[{"text":"자","x":314,"y":2266,"width":35,"height":38},{"text":"프로세스는","x":363,"y":2267,"width":168,"height":36},{"text":"자기의","x":544,"y":2268,"width":95,"height":36},{"text":"것이","x":659,"y":2269,"width":58,"height":37},{"text":"아닌","x":735,"y":2270,"width":59,"height":36},{"text":"메모리는","x":810,"y":2270,"width":122,"height":36},{"text":"접근조차","x":946,"y":2270,"width":122,"height":36},{"text":"할","x":1080,"y":2271,"width":32,"height":34},{"text":"수가","x":1124,"y":2271,"width":64,"height":36},{"text":"없다.","x":1203,"y":2271,"width":66,"height":36},{"text":"페이지","x":1286,"y":2271,"width":89,"height":36},{"text":"테이블을","x":1393,"y":2270,"width":129,"height":37},{"text":"통","x":1534,"y":2272,"width":34,"height":35}]},{"text":"하지 않고서는 다른 공간에 접근할 길이 없으며 페이지 테이블은 그 프로세스가 소유하","words":[{"text":"하지","x":314,"y":2327,"width":64,"height":37},{"text":"않고서는","x":397,"y":2327,"width":134,"height":36},{"text":"다른","x":544,"y":2328,"width":65,"height":35},{"text":"공간에","x":622,"y":2329,"width":94,"height":36},{"text":"접근할","x":733,"y":2329,"width":91,"height":36},{"text":"길이","x":838,"y":2330,"width":56,"height":35},{"text":"없으며","x":912,"y":2329,"width":86,"height":36},{"text":"페이지","x":1014,"y":2330,"width":89,"height":36},{"text":"테이블은","x":1119,"y":2330,"width":124,"height":36},{"text":"그","x":1256,"y":2336,"width":31,"height":24},{"text":"프로세스가","x":1299,"y":2331,"width":159,"height":37},{"text":"소유하","x":1470,"y":2331,"width":98,"height":36}]},{"text":"고 있는 페이지들만을 가리키고 있기 때문이다.","words":[{"text":"고","x":314,"y":2392,"width":34,"height":25},{"text":"있는","x":363,"y":2387,"width":66,"height":36},{"text":"페이지들만을","x":441,"y":2387,"width":197,"height":37},{"text":"가리키고","x":651,"y":2389,"width":124,"height":35},{"text":"있기","x":789,"y":2389,"width":55,"height":35},{"text":"때문이다.","x":860,"y":2389,"width":126,"height":36}]}]}