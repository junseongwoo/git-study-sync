}]},{"text":"가 다 도착하면 버퍼는 그때 가서 한꺼번에 드라이브에 기록될 수 있다. 드라이브 쓰기","words":[{"text":"가","x":288,"y":1257,"width":29,"height":34},{"text":"다","x":330,"y":1258,"width":29,"height":33},{"text":"도착하면","x":371,"y":1257,"width":115,"height":33},{"text":"버퍼는","x":501,"y":1256,"width":85,"height":34},{"text":"그때","x":598,"y":1255,"width":55,"height":34},{"text":"가서","x":669,"y":1255,"width":53,"height":33},{"text":"한꺼번에","x":739,"y":1255,"width":116,"height":33},{"text":"드라이브에","x":871,"y":1254,"width":151,"height":34},{"text":"기록될","x":1040,"y":1254,"width":94,"height":34},{"text":"수","x":1150,"y":1256,"width":34,"height":33},{"text":"있다.","x":1202,"y":1255,"width":70,"height":34},{"text":"드라이브","x":1290,"y":1254,"width":134,"height":34},{"text":"쓰기","x":1440,"y":1254,"width":59,"height":34}]},{"text":"가 즉각적이지 않고 네트워크 인터페이스는 여전히 추가 수신 데이터를 저장할 장소가","words":[{"text":"가","x":287,"y":1315,"width":30,"height":33},{"text":"즉각적이지","x":328,"y":1314,"width":143,"height":34},{"text":"않고","x":488,"y":1314,"width":56,"height":33},{"text":"네트워크","x":558,"y":1312,"width":114,"height":35},{"text":"인터페이스는","x":688,"y":1312,"width":176,"height":34},{"text":"여전히","x":879,"y":1312,"width":86,"height":34},{"text":"추가","x":983,"y":1312,"width":64,"height":34},{"text":"수신","x":1060,"y":1312,"width":64,"height":34},{"text":"데이터를","x":1142,"y":1313,"width":133,"height":34},{"text":"저장할","x":1292,"y":1312,"width":100,"height":34},{"text":"장소가","x":1407,"y":1311,"width":97,"height":35}]},{"text":"필요하므로 두 개의 버퍼가 시용된다. 네트워크가 첫 번째 버퍼를 채운 후 드라이브 쓰","words":[{"text":"필요하므로","x":286,"y":1372,"width":146,"height":34},{"text":"두","x":444,"y":1373,"width":29,"height":32},{"text":"개의","x":488,"y":1370,"width":51,"height":34},{"text":"버퍼가","x":556,"y":1370,"width":87,"height":34},{"text":"시용된다.","x":654,"y":1369,"width":122,"height":34},{"text":"네트워크가","x":794,"y":1369,"width":150,"height":35},{"text":"첫","x":960,"y":1369,"width":27,"height":35},{"text":"번째","x":1005,"y":1369,"width":58,"height":35},{"text":"버퍼를","x":1082,"y":1370,"width":97,"height":35},{"text":"채운","x":1195,"y":1371,"width":66,"height":34},{"text":"후","x":1275,"y":1370,"width":35,"height":35},{"text":"드라이브","x":1324,"y":1369,"width":134,"height":35},{"text":"쓰","x":1473,"y":1372,"width":31,"height":25}]},{"text":"기가 요청된다. 그런 다음 네트워크는 첫 번째 버퍼가 저장장치에 기록되는 동안 두 번","words":[{"text":"기가","x":286,"y":1430,"width":59,"height":34},{"text":"요청된다.","x":356,"y":1428,"width":122,"height":35},{"text":"그런","x":492,"y":1427,"width":56,"height":33},{"text":"다음","x":563,"y":1428,"width":57,"height":33},{"text":"네트워크는","x":634,"y":1427,"width":145,"height":34},{"text":"첫","x":793,"y":1427,"width":28,"height":34},{"text":"번째","x":837,"y":1428,"width":56,"height":33},{"text":"버퍼가","x":911,"y":1427,"width":92,"height":35},{"text":"저장장치에","x":1017,"y":1427,"width":159,"height":35},{"text":"기록되는","x":1196,"y":1428,"width":132,"height":35},{"text":"동안","x":1342,"y":1427,"width":70,"height":34},{"text":"두","x":1425,"y":1429,"width":34,"height":32},{"text":"번","x":1475,"y":1427,"width":28,"height":33}]},{"text":"째 버퍼를 채우기 시작한다. 네트워크가 두 번째 버퍼를 채울 때 첫 번째 버퍼의 드라이","words":[{"text":"째","x":284,"y":1488,"width":27,"height":34},{"text":"버퍼를","x":328,"y":1487,"width":86,"height":34},{"text":"채우기","x":426,"y":1486,"width":81,"height":34},{"text":"시작한다.","x":523,"y":1485,"width":120,"height":35},{"text":"네트워크가","x":658,"y":1485,"width":147,"height":35},{"text":"두","x":817,"y":1487,"width":30,"height":33},{"text":"번째","x":861,"y":1485,"width":56,"height":34},{"text":"버퍼를","x":934,"y":1485,"width":93,"height":35},{"text":"채울","x":1040,"y":1486,"width":64,"height":34},{"text":"때","x":1118,"y":1486,"width":28,"height":34},{"text":"첫","x":1165,"y":1486,"width":31,"height":34},{"text":"번째","x":1213,"y":1486,"width":61,"height":34},{"text":"버퍼의","x":1293,"y":1485,"width":96,"height":35},{"text":"드라이","x":1406,"y":1484,"width":95,"height":35}]},{"text":"보 쓰기가 완료되었으므로 드라이브가 두 번째 버퍼를 쓰는 동안 네트워크가 첫 번째 버","words":[{"text":"보","x":285,"y":1549,"width":29,"height":26},{"text":"쓰기가","x":325,"y":1545,"width":88,"height":35},{"text":"완료되었으므로","x":423,"y":1544,"width":201,"height":35},{"text":"드라이브가","x":635,"y":1543,"width":147,"height":35},{"text":"두","x":793,"y":1545,"width":30,"height":33},{"text":"번째","x":836,"y":1543,"width":56,"height":35},{"text":"버퍼를","x":908,"y":1543,"width":92,"height":35},{"text":"쓰는","x":1011,"y":1545,"width":64,"height":32},{"text":"동안","x":1087,"y":1544,"width":67,"height":34},{"text":"네트워크가","x":1168,"y":1544,"width":167,"height":34},{"text":"첫","x":1350,"y":1543,"width":30,"height":34},{"text":"번째","x":1397,"y":1543,"width":60,"height":34},{"text":"버","x":1475,"y":1543,"width":26,"height":34}]},{"text":"퍼로 다시 전환할 수 있다. 이 이중 버퍼링은 데이터 소비자로부터 생산자와의 밀접성을","words":[{"text":"퍼로","x":286,"y":1604,"width":58,"height":35},{"text":"다시","x":355,"y":1603,"width":54,"height":35},{"text":"전환할","x":425,"y":1603,"width":85,"height":34},{"text":"수","x":520,"y":1603,"width":29,"height":34},{"text":"있다.","x":562,"y":1603,"width":61,"height":35},{"text":"이","x":638,"y":1602,"width":24,"height":35},{"text":"이중","x":678,"y":1602,"width":58,"height":35},{"text":"버퍼링은","x":748,"y":1602,"width":119,"height":35},{"text":"데이터","x":879,"y":1601,"width":87,"height":35},{"text":"소비자로부터","x":982,"y":1601,"width":190,"height":35},{"text":"생산자와의","x":1190,"y":1601,"width":166,"height":36},{"text":"밀접성을","x":1375,"y":1601,"width":130,"height":34}]},{"text":"해제하여 데이터 간의 타이밍 요구 사항을 완화한다. 이 밀접성 해제의 필요성이 그림","words":[{"text":"해제하여","x":286,"y":1662,"width":112,"height":35},{"text":"데이터","x":417,"y":1662,"width":80,"height":34},{"text":"간의","x":515,"y":1662,"width":54,"height":34},{"text":"타이밍","x":586,"y":1662,"width":83,"height":34},{"text":"요구","x":686,"y":1663,"width":59,"height":33},{"text":"사항을","x":759,"y":1661,"width":91,"height":35},{"text":"완화한다.","x":863,"y":1660,"width":129,"height":35},{"text":"이","x":1012,"y":1660,"width":25,"height":35},{"text":"밀접성","x":1058,"y":1660,"width":93,"height":35},{"text":"해제의","x