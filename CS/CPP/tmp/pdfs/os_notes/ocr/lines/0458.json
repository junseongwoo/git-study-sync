고장과 무관하다. 그러면 하나의 MTBF가 100,0側시간이라","words":[{"text":"의","x":298,"y":639,"width":28,"height":35},{"text":"고장은","x":342,"y":639,"width":98,"height":35},{"text":"다른","x":453,"y":639,"width":64,"height":35},{"text":"드라이브의","x":528,"y":640,"width":153,"height":36},{"text":"고장과","x":696,"y":641,"width":90,"height":35},{"text":"무관하다.","x":797,"y":641,"width":126,"height":36},{"text":"그러면","x":937,"y":642,"width":90,"height":36},{"text":"하나의","x":1040,"y":643,"width":89,"height":36},{"text":"MTBF가","x":1144,"y":644,"width":132,"height":35},{"text":"100,0側시간이라","x":1288,"y":643,"width":252,"height":37}]},{"text":"고 가정하고 평균 수리 시간이 10시간이라고 한다면, 미러드 디스크 시스템의 평균 데이","words":[{"text":"고","x":297,"y":703,"width":33,"height":25},{"text":"가정하고","x":343,"y":698,"width":130,"height":36},{"text":"평균","x":486,"y":699,"width":63,"height":36},{"text":"수리","x":560,"y":700,"width":59,"height":36},{"text":"시간이","x":636,"y":700,"width":86,"height":36},{"text":"10시간이라고","x":738,"y":701,"width":185,"height":35},{"text":"한다면,","x":934,"y":702,"width":100,"height":36},{"text":"미러드","x":1046,"y":702,"width":92,"height":36},{"text":"디스크","x":1151,"y":703,"width":92,"height":35},{"text":"시스템의","x":1256,"y":704,"width":124,"height":35},{"text":"평균","x":1398,"y":704,"width":62,"height":35},{"text":"데이","x":1474,"y":704,"width":61,"height":36}]},{"text":"터 분실 시간은 100,0002/(2 x 10) = 500 x 106시간, 57,000년이다.","words":[{"text":"터","x":299,"y":759,"width":27,"height":35},{"text":"분실","x":341,"y":759,"width":65,"height":35},{"text":"시간은","x":420,"y":759,"width":97,"height":36},{"text":"100,0002/(2","x":529,"y":757,"width":178,"height":42},{"text":"x","x":720,"y":770,"width":18,"height":22},{"text":"10)","x":750,"y":763,"width":44,"height":36},{"text":"=","x":805,"y":776,"width":19,"height":11},{"text":"500","x":833,"y":764,"width":51,"height":29},{"text":"x","x":897,"y":771,"width":18,"height":22},{"text":"106시간,","x":928,"y":758,"width":115,"height":41},{"text":"57,000년이다.","x":1054,"y":762,"width":199,"h