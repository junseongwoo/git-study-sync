{"page":308,"width":1645,"height":2509,"text_angle":0,"lines":[{"text":"366","words":[{"text":"366","x":178,"y":132,"width":57,"height":28}]},{"text":"Chapter 8 교착 상대","words":[{"text":"Chapter","x":303,"y":135,"width":113,"height":26},{"text":"8","x":429,"y":135,"width":19,"height":21},{"text":"교착","x":476,"y":136,"width":42,"height":22},{"text":"상대","x":526,"y":137,"width":40,"height":24}]},{"text":"최대 소요랑","words":[{"text":"최대","x":797,"y":254,"width":53,"height":34},{"text":"소요랑","x":864,"y":254,"width":88,"height":34}]},{"text":"10","words":[{"text":"10","x":857,"y":313,"width":30,"height":27}]},{"text":"4","words":[{"text":"4","x":866,"y":369,"width":17,"height":26}]},{"text":"9","words":[{"text":"9","x":865,"y":425,"width":16,"height":27}]},{"text":"현재 사용량","words":[{"text":"현재","x":1090,"y":254,"width":57,"height":34},{"text":"사용량","x":1162,"y":254,"width":96,"height":35}]},{"text":"5","words":[{"text":"5","x":1162,"y":314,"width":17,"height":27}]},{"text":"2","words":[{"text":"2","x":1162,"y":369,"width":17,"height":27}]},{"text":"2","words":[{"text":"2","x":1161,"y":426,"width":17,"height":27}]},{"text":"to에서 시스템의 상대는 안전하다. \u003cTI, 더, T2\u003e 순서가 있으므로 안전 상태이다. 왜","words":[{"text":"to에서","x":356,"y":514,"width":79,"height":37},{"text":"시스템의","x":451,"y":514,"width":112,"height":34},{"text":"상대는","x":578,"y":514,"width":85,"height":34},{"text":"안전하다.","x":674,"y":513,"width":120,"height":35},{"text":"\u003cTI,","x":806,"y":513,"width":61,"height":35},{"text":"더,","x":878,"y":513,"width":40,"height":36},{"text":"T2\u003e","x":929,"y":512,"width":54,"height":36},{"text":"순서가","x":993,"y":512,"width":92,"height":35},{"text":"있으므로","x":1098,"y":512,"width":125,"height":35},{"text":"안전","x":1236,"y":512,"width":63,"height":33},{"text":"상태이다.","x":1313,"y":510,"width":136,"height":36},{"text":"왜","x":1464,"y":513,"width":26,"height":34}]},{"text":"나하면 저이 시스템 보유부으로 먼저 끝내고 나면(이젠 원래 3개에 남았던 것에 지이 반","words":[{"text":"나하면","x":300,"y":570,"width":88,"height":35},{"text":"저이","x":400,"y":571,"width":59,"height":37},{"text":"시스템","x":475,"y":571,"width":82,"height":34},{"text":"보유부으로","x":570,"y":572,"width":143,"height":33},{"text":"먼저","x":726,"y":570,"width":52,"height":34},{"text":"끝내고","x":792,"y":570,"width":86,"height":35},{"text":"나면(이젠","x":890,"y":569,"width":128,"height":38},{"text":"원래","x":1032,"y":569,"width":56,"height":35},{"text":"3개에","x":1102,"y":570,"width":80,"height":34},{"text":"남았던","x":1197,"y":569,"width":95,"height":34},{"text":"것에","x":1308,"y":568,"width":61,"height":35},{"text":"지이","x":1384,"y":568,"width":64,"height":37},{"text":"반","x":1464,"y":570,"width":30,"height":33}]},{"text":"남하는 2를 추가하여 5개가 시스템 보유분이 된다), T()이 그 다섯 개를 가져가 끝낼 수","words":[{"text":"남하는","x":299,"y":628,"width":90,"height":34},{"text":"2를","x":401,"y":630,"width":47,"height":32},{"text":"추가하여","x":460,"y":628,"width":113,"height":34},{"text":"5개가","x":587,"y":627,"width":76,"height":34},{"text":"시스템","x":676,"y":627,"width":82,"height":35},{"text":"보유분이","x":773,"y":626,"width":113,"height":35},{"text":"된다),","x":902,"y":627,"width":77,"height":37},{"text":"T()이","x":995,"y":626,"width":59,"height":38},{"text":"그","x":1071,"y":632,"width":30,"height":23},{"text":"다섯","x":1116,"y":626,"width":62,"height":35},{"text":"개를","x":1194,"y":626,"width":64,"height":33},{"text":"가져가","x":1273,"y":625,"width":98,"height":35},{"text":"끝낼","x":1384,"y":625,"width":64,"height":33},{"text":"수","x":1462,"y":627,"width":32,"height":34}]},{"text":"있고, 마지막으로 T2가 끝내면 된다(이제 시스템 보흙별-은 다시 12개가 된다).","words":[{"text":"있고,","x":300,"y":685,"width":65,"height":35},{"text":"마지막으로","x":378,"y":685,"width":146,"height":34},{"text":"T2가","x":535,"y":685,"width":60,"height":37},{"text":"끝내면","x":604,"y":685,"width":84,"height":34},{"text":"된다(이제","x":701,"y":684,"width":123,"height":37},{"text":"시스템","x":838,"y":683,"width":84,"height":35},{"text":"보흙별-은","x":936,"y":684,"width":120,"height":34},{"text":"다시","x":1068,"y":684,"width":57,"height":35},{"text":"12개가","x":1141,"y":683,"width":102,"height":35},{"text":"된다).","x":1255,"y":683,"width":84,"height":37}]},{"text":"시스템은 안전 상대에 있다기도 불안전 상대로 전이할 수 있다. 예를 들어 서에서 T2","words":[{"text":"시스템은","x":356,"y":742,"width":116,"height":34},{"text":"안전","x":483,"y":742,"width":56,"height":34},{"text":"상대에","x":552,"y":742,"width":82,"height":35},{"text":"있다기도","x":648,"y":741,"width":114,"height":35},{"text":"불안전","x":773,"y":741,"width":85,"height":34},{"text":"상대로","x":870,"y":741,"width":89,"height":35},{"text":"전이할","x":972,"y":741,"width":91,"height":34},{"text":"수","x":1073,"y":742,"width":31,"height":34},{"text":"있다.","x":1118,"y":741,"width":68,"height":35},{"text":"예를","x":1203,"y":741,"width":64,"height":35},{"text":"들어","x":1279,"y":741,"width":62,"height":34},{"text":"서에서","x":1358,"y":740,"width":87,"height":37},{"text":"T2","x":1461,"y":745,"width":32,"height":34}]},{"text":"가 자원 한 개를 추가로 요청하여 그것을 주었다고 가정해 보자. 그러면 이제 시스템 상","words":[{"text":"가","x":299,"y":800,"width":29,"height":33},{"text":"자원","x":340,"y":800,"width":57,"height":33},{"text":"한","x":410,"y":800,"width":30,"height":33},{"text":"개를","x":453,"y":800,"width":56,"height":34},{"text":"추가로","x":520,"y":800,"width":86,"height":33},{"text":"요청하여","x":617,"y":799,"width":112,"height":35},{"text":"그것을","x":744,"y":799,"width":87,"height":34},{"text":"주었다고","x":842,"y":799,"width":118,"height":34},{"text":"가정해","x":973,"y":799,"width":89,"height":34},{"text":"보자.","x":1077,"y":799,"width":68,"height":33},{"text":"그러면","x":1161,"y":798,"width":96,"height":34},{"text":"이제","x":1274,"y":798,"width":61,"height":34},{"text":"시스템","x":1352,"y":798,"width":94,"height":34},{"text":"상","x":1462,"y":800,"width":32,"height":33}]},{"text":"태는 더 이상 안전하지 않게 된다. 이 상태에서는 치만이 원히는 자원을 다 할당받을 수","words":[{"text":"태는","x":298,"y":857,"width":59,"height":33},{"text":"더","x":370,"y":857,"width":23,"height":34},{"text":"이상","x":410,"y":857,"width":58,"height":35},{"text":"안전하지","x":479,"y":857,"width":111,"height":34},{"text":"않게","x":605,"y":857,"width":54,"height":35},{"text":"된다.","x":673,"y":857,"width":63,"height":34},{"text":"이","x":751,"y":856,"width":24,"height":35},{"text":"상태에서는","x":790,"y":856,"width":146,"height":35},{"text":"치만이","x":949,"y":856,"width":90,"height":38},{"text":"원히는","x":1056,"y":856,"width":93,"height":34},{"text":"자원을","x":1161,"y":856,"width":98,"height":34},{"text":"다","x":1273,"y":856,"width":33,"height":34},{"text":"할당받을","x":1318,"y":855,"width":132,"height":34},{"text":"수","x":1462,"y":857,"width":31,"height":33}]},{"text":"있다. 지이 마치고 자원을 반납해도 시스템 보유분은 4개뿐이다. To가 5개를 가지고 있","words":[{"text":"있다.","x":298,"y":914,"width":63,"height":34},{"text":"지이","x":376,"y":915,"width":58,"height":37},{"text":"마치고","x":450,"y":914,"width":86,"height":35},{"text":"자원을","x":549,"y":914,"width":85,"height":34},{"text":"반납해도","x":646,"y":914,"width":114,"height":34},{"text":"시스템","x":773,"y":914,"width":83,"height":34},{"text":"보유분은","x":872,"y":915,"width":120,"height":34},{"text":"4개뿐이다.","x":1003,"y":914,"width":149,"height":34},{"text":"To가","x":1170,"y":914,"width":69,"height":37},{"text":"5개를","x":1251,"y":914,"width":87,"height":33},{"text":"가지고","x":1352,"y":913,"width":96,"height":34},{"text":"있","x":1465,"y":915,"width":27,"height":34}]},{"text":"고 최대 10개를 필요로 하므로 추가로 과까지를 더 요청할 수 있다. 그릴 경우 자원의","words":[{"text":"고","x":296,"y":976,"width":29,"height":23},{"text":"최대","x":339,"y":972,"width":55,"height":34},{"text":"10개를","x":410,"y":972,"width":90,"height":34},{"text":"필요로","x":513,"y":972,"width":85,"height":34},{"text":"하므로","x":610,"y":972,"width":85,"height":34},{"text":"추가로","x":707,"y":971,"width":87,"height":35},{"text":"과까지를","x":806,"y":972,"width":135,"height":34},{"text":"더","x":956,"y":972,"width":24,"height":33},{"text":"요청할","x":997,"y":972,"width":93,"height":34},{"text":"수","x":1102,"y":972,"width":33,"height":34},{"text":"있다.","x":1150,"y":971,"width":70,"height":35},{"text":"그릴","x":1237,"y":971,"width":63,"height":34},{"text":"경우","x":1318,"y":971,"width":66,"height":34},{"text":"자원의","x":1398,"y":970,"width":92,"height":37}]},{"text":"개수가 부촉하므로 저은 끝내지 못하고 기다릴 수밖에 없게 된다. 마찬가지로 T2도 6개","words":[{"text":"개수가","x":297,"y":1029,"width":87,"height":34},{"text":"부촉하므로","x":394,"y":1029,"width":145,"height":34},{"text":"저은","x":551,"y":1030,"width":60,"height":37},{"text":"끝내지","x":622,"y":1029,"width":83,"height":35},{"text":"못하고","x":720,"y":1029,"width":87,"height":34},{"text":"기다릴","x":819,"y":1029,"width":85,"height":35},{"text":"수밖에","x":918,"y":1029,"width":88,"height":35},{"text":"없게","x":1024,"y":1029,"width":56,"height":35},{"text":"된다.","x":1097,"y":1029,"width":70,"height":35},{"text":"마찬가지로","x":1183,"y":1029,"width":165,"height":35},{"text":"T2도","x":1363,"y":1032,"width":68,"height":34},{"text":"6개","x":1444,"y":1030,"width":46,"height":35}]},{"text":"까지의 자원을 추가로 요청할 수 있다. 그러면 이 스레드도 기다려야 한다. 결과는 교착","words":[{"text":"까지의","x":294,"y":1086,"width":86,"height":35},{"text":"자원을","x":395,"y":1088,"width":87,"height":34},{"text":"추가로","x":492,"y":1087,"width":87,"height":34},{"text":"요청할","x":590,"y":1087,"width":87,"height":35},{"text":"수","x":688,"y":1087,"width":30,"height":35},{"text":"있다.","x":731,"y":1087,"width":61,"height":34},{"text":"그러면","x":806,"y":1088,"width":87,"height":34},{"text":"이","x":909,"y":1087,"width":24,"height":34},{"text":"스레드도","x":949,"y":1087,"width":123,"height":35},{"text":"기다려야","x":1086,"y":1087,"width":129,"height":35},{"text":"한다.","x":1227,"y":1087,"width":73,"height":35},{"text":"결과는","x":1319,"y":1087,"width":99,"height":34},{"text":"교착","x":1430,"y":1089,"width":64,"height":33}]},{"text":"상태이다. 그러므로 위에서 T2가 자원을 한 개 더 달라고 할 때 그 요청을 그대로 들어주","words":[{"text":"상태이다.","x":293,"y":1144,"width":124,"height":35},{"text":"그러므로","x":430,"y":1145,"width":114,"height":34},{"text":"위에서","x":556,"y":1145,"width":82,"height":35},{"text":"T2가","x":652,"y":1145,"width":61,"height":38},{"text":"자원을","x":723,"y":1145,"width":87,"height":35},{"text":"한","x":821,"y":1145,"widt