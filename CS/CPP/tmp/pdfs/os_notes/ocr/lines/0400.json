7,"width":59,"height":34},{"text":"것이다.","x":536,"y":1207,"width":91,"height":35},{"text":"가까운의","x":642,"y":1206,"width":117,"height":36},{"text":"정의는","x":777,"y":1207,"width":90,"height":35},{"text":"“최소","x":881,"y":1207,"width":74,"height":35},{"text":"지연시간을","x":971,"y":1207,"width":157,"height":35},{"text":"가진”이","x":1144,"y":1206,"width":107,"height":36},{"text":"되며,","x":1272,"y":1206,"width":73,"height":36},{"text":"통상","x":1362,"y":1206,"width":67,"height":35},{"text":"CPU","x":1443,"y":1210,"width":76,"height":29}]},{"text":"와 같은 보드에 장착된 메모리를 의미한다. 따라서 프로세스가 페이지 폴트를 일으기면","words":[{"text":"와","x":296,"y":1266,"width":32,"height":34},{"text":"같은","x":341,"y":1266,"width":59,"height":35},{"text":"보드에","x":412,"y":1265,"width":86,"height":35},{"text":"장착된","x":514,"y":1265,"width":86,"height":36},{"text":"메모리를","x":614,"y":1265,"width":117,"height":36},{"text":"의미한다.","x":745,"y":1265,"width":125,"height":36},{"text":"따라서","x":886,"y":1265,"width":88,"height":36},{"text":"프로세스가","x":991,"y":1265,"width":161,"height":35},{"text":"페이지","x":1165,"y":1265,"width":94,"height":35},{"text":"폴트를","x":1277,"y":1266,"width":101,"height":33},{"text":"일으기면","x":1393,"y":1265,"width":126,"height":36}]},{"text":"NUMA 인식 가상 메모리 시스템은 프로세스가 실행 중인 CPU에 최대한 가까운 프레","words":[{"text":"NUMA","x":296,"y":1328,"width":115,"height":28},{"text":"인식","x":426,"y":1324,"width":54,"height":35},{"text":"가상","x":496,"y":1325,"width":58,"height":35},{"text":"메모리","x":565,"y":1325,"width":83,"height":35},{"text":"시스템은","x":665,"y":1325,"width":119,"height":35},{"text":"프로세스가","x":794,"y":1324,"width":154,"height":35},{"text":"실행","x":960,"y":1324,"width":57,"height":35},{"text":"중인","x":1032,"y":1323,"width":63,"height":36},{"text":"CPU에","x":1108,"y":1324,"width":109,"height":34},{"text":"최대한","x":1234,"y":1323,"width":99,"height":35},{"text":"가까운","x":1346,"y":1324,"width":99,"height":35},{"text":"프레","x":1457,"y":1325,"width":60,"height":35}]},{"text":"임을 할당한다.","words":[{"text":"임을","x"