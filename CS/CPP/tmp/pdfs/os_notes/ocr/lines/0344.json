{"page":344,"width":1658,"height":2491,"text_angle":0,"lines":[{"text":"404","words":[{"text":"404","x":163,"y":139,"width":57,"height":28}]},{"text":"Chapter 9 에인 메모리","words":[{"text":"Chapter","x":289,"y":142,"width":115,"height":27},{"text":"9","x":416,"y":142,"width":20,"height":21},{"text":"에인","x":465,"y":143,"width":40,"height":24},{"text":"메모리","x":514,"y":144,"width":61,"height":23}]},{"text":"저장한다. CPU가 논리 주소를 생성하면 MMU는 해당 페이지 번호가 TLB에 있는지","words":[{"text":"저장한다.","x":294,"y":264,"width":125,"height":36},{"text":"CPU가","x":433,"y":264,"width":102,"height":35},{"text":"논리","x":547,"y":264,"width":55,"height":35},{"text":"주소를","x":619,"y":266,"width":87,"height":33},{"text":"생성하면","x":720,"y":264,"width":114,"height":35},{"text":"MMU는","x":849,"y":268,"width":123,"height":31},{"text":"해당","x":986,"y":265,"width":62,"height":35},{"text":"페이지","x":1063,"y":265,"width":89,"height":36},{"text":"번호가","x":1174,"y":264,"width":96,"height":35},{"text":"TLB에","x":1284,"y":263,"width":102,"height":34},{"text":"있는지","x":1407,"y":263,"width":90,"height":36}]},{"text":"확인한다. 페이지 번호가 발견되면 해당 프레임 번호를 즉시 알 수 있고 메모리를 접근","words":[{"text":"확인한다.","x":292,"y":322,"width":127,"height":36},{"text":"페이지","x":434,"y":321,"width":84,"height":36},{"text":"번호가","x":536,"y":321,"width":86,"height":35},{"text":"발견되면","x":634,"y":320,"width":114,"height":36},{"text":"해당","x":763,"y":321,"width":57,"height":36},{"text":"프레임","x":833,"y":321,"width":86,"height":35},{"text":"번호를","x":937,"y":323,"width":90,"height":33},{"text":"즉시","x":1040,"y":322,"width":59,"height":35},{"text":"알","x":1118,"y":322,"width":31,"height":34},{"text":"수","x":1161,"y":322,"width":34,"height":34},{"text":"있고","x":1212,"y":321,"width":64,"height":35},{"text":"메모리를","x":1291,"y":320,"width":132,"height":35},{"text":"접근","x":1439,"y":320,"width":62,"height":35}]},{"text":"하는 데 시용된다. 앞서 언급한 것처럼 이러한 절치들은 CPU 내부에서 명령어 파이프","words":[{"text":"하는","x":292,"y":381,"width":62,"height":34},{"text":"데","x":366,"y":380,"width":26,"height":34},{"text":"시용된다.","x":409,"y":379,"width":122,"height":36},{"text":"앞서","x":547,"y":379,"width":53,"height":35},{"text":"언급한","x":618,"y":379,"width":86,"height":34},{"text":"것처럼","x":718,"y":378,"width":81,"height":36},{"text":"이러한","x":817,"y":378,"width":89,"height":36},{"text":"절치들은","x":920,"y":378,"width":120,"height":37},{"text":"CPU","x":1053,"y":382,"width":75,"height":28},{"text":"내부에서","x":1145,"y":378,"width":126,"height":36},{"text":"명령어","x":1292,"y":377,"width":94,"height":37},{"text":"파이프","x":1405,"y":377,"width":95,"height":35}]},{"text":"라인의 일환으로 실행되기 때문에 페이징을 시용하지 않는 시스템과 비교하면 성능 저","words":[{"text":"라인의","x":293,"y":438,"width":86,"height":35},{"text":"일환으로","x":398,"y":437,"width":115,"height":35},{"text":"실행되기","x":527,"y":436,"width":111,"height":36},{"text":"때문에","x":656,"y":437,"width":83,"height":35},{"text":"페이징을","x":756,"y":436,"width":116,"height":35},{"text":"시용하지","x":885,"y":436,"width":117,"height":36},{"text":"않는","x":1021,"y":436,"width":62,"height":36},{"text":"시스템과","x":1098,"y":436,"width":129,"height":35},{"text":"비교하면","x":1243,"y":436,"width":130,"height":35},{"text":"성능","x":1392,"y":435,"width":63,"height":35},{"text":"저","x":1472,"y":437,"width":25,"height":35}]},{"text":"하는 전혀 없다.","words":[{"text":"하는","x":292,"y":496,"width":60,"height":35},{"text":"전혀","x":364,"y":496,"width":55,"height":34},{"text":"없다.","x":434,"y":495,"width":63,"height":35}]},{"text":"페이지 번호가 TLB에 없으면(TLB 미스라고 함) 주소 변환은 9.3.1절에 설명된 단","words":[{"text":"페이지","x":348,"y":553,"width":85,"height":35},{"text":"번호가","x":450,"y":552,"width":86,"height":35},{"text":"TLB에","x":547,"y":552,"width":88,"height":35},{"text":"없으면(TLB","x":652,"y":552,"width":159,"height":38},{"text":"미스라고","x":827,"y":551,"width":118,"height":37},{"text":"함)","x":958,"y":552,"width":40,"height":38},{"text":"주소","x":1013,"y":553,"width":62,"height":34},{"text":"변환은","x":1091,"y":552,"width":95,"height":34},{"text":"9.3.1절에","x":1199,"y":552,"width":141,"height":35},{"text":"설명된","x":1358,"y":551,"width":96,"height":35},{"text":"단","x":1470,"y":552,"width":31,"height":34}]},{"text":"계에 따라 진행되며, 여기서 페이지 테이블에 대한 메모리 참조가 이루어져야 한다. 프레","words":[{"text":"계에","x":291,"y":611,"width":56,"height":34},{"text":"따라","x":361,"y":610,"width":60,"height":35},{"text":"진행되며,","x":432,"y":609,"width":122,"height":36},{"text":"여기서","x":567,"y":609,"width":82,"height":36},{"text":"페이지","x":664,"y":609,"width":83,"height":37},{"text":"테이블에","x":761,"y":610,"width":115,"height":36},{"text":"대한","x":891,"y":610,"width":60,"height":35},{"text":"메모리","x":961,"y":610,"width":88,"height":35},{"text":"참조가","x":1064,"y":610,"width":96,"height":35},{"text":"이루어져야","x":1173,"y":610,"width":165,"height":36},{"text":"한다.","x":1350,"y":610,"width":73,"height":34},{"text":"프레","x":1437,"y":611,"width":60,"height":34}]},{"text":"임 번호가 확보되면 이를 시용하여 메모리에 액세스 할 수 있다(그림 9.12). 또한 페이지","words":[{"text":"임","x":289,"y":668,"width":26,"height":33},{"text":"번호가","x":331,"y":667,"width":89,"height":35},{"text":"확보되면","x":430,"y":667,"width":116,"height":35},{"text":"이를","x":559,"y":667,"width":57,"height":36},{"text":"시용하여","x":626,"y":667,"width":113,"height":37},{"text":"메모리에","x":754,"y":668,"width":115,"height":36},{"text":"액세스","x":884,"y":668,"width":89,"height":35},{"text":"할","x":984,"y":668,"width":32,"height":34},{"text":"수","x":1026,"y":668,"width":32,"height":35},{"text":"있다(그림","x":1072,"y":668,"width":135,"height":37},{"text":"9.12).","x":1222,"y":672,"width":88,"height":34},{"text":"또한","x":1325,"y":668,"width":67,"height":34},{"text":"페이지","x":1405,"y":668,"width":91,"height":35}]},{"text":"번호와 프레임 번호를 TLB에 추가하여 다음 참조에서 빠르게 찾을 수 있도록 한다.","words":[{"text":"번호와","x":288,"y":725,"width":91,"height":35},{"text":"프레임","x":388,"y":725,"width":86,"height":35},{"text":"번호를","x":489,"y":725,"width":85,"height":35},{"text":"TLB에","x":584,"y":726,"width":88,"height":34},{"text":"추가하여","x":685,"y":726,"width":114,"height":35},{"text":"다음","x":813,"y":726,"width":59,"height":34},{"text":"참조에서","x":882,"y":726,"width":118,"height":35},{"text":"빠르게","x":1016,"y":726,"width":90,"height":35},{"text":"찾을","x":1121,"y":726,"width":65,"height":34},{"text":"수","x":1197,"y":727,"width":34,"height":35},{"text":"있도록","x":1244,"y":727,"width":98,"height":34},{"text":"한다.","x":1354,"y":726,"width":73,"height":34}]},{"text":"만약 TLB가 가특 차면, 기존 항목 중에서 교체될 항목을 선택해야 한다. 교체 정책","words":[{"text":"만약","x":343,"y":783,"width":61,"height":34},{"text":"TLB가","x":414,"y":783,"width":94,"height":35},{"text":"가특","x":520,"y":783,"width":57,"height":35},{"text":"차면,","x":588,"y":783,"width":65,"height":36},{"text":"기존","x":668,"y":783,"width":57,"height":35},{"text":"항목","x":737,"y":784,"width":59,"height":35},{"text":"중에서","x":808,"y":784,"width":85,"height":34},{"text":"교체될","x":909,"y":784,"width":90,"height":35},{"text":"항목을","x":1014,"y":784,"width":95,"height":35},{"text":"선택해야","x":1122,"y":784,"width":131,"height":35},{"text":"한다.","x":1266,"y":784,"width":73,"height":35},{"text":"교체","x":1356,"y":784,"width":63,"height":34},{"text":"정책","x":1438,"y":784,"width":58,"height":35}]},{"text":"은 정책은 LRU부터 라운드 로빈, 무작위 등 다양한 정책이 A卜\u0026된다. 몇몇 CPU는 운","words":[{"text":"은","x":285,"y":841,"width":32,"height":33},{"text":"정책은","x":330,"y":841,"width":90,"height":35},{"text":"LRU부터","x":430,"y":841,"width":125,"height":35},{"text":"라운드","x":572,"y":841,"width":86,"height":35},{"text":"로빈,","x":670,"y":841,"width":66,"height":36},{"text":"무작위","x":750,"y":842,"width":85,"height":35},{"text":"등","x":850,"y":843,"width":31,"height":33},{"text":"다양한","x":894,"y":842,"width":93,"height":34},{"text":"정책이","x":1001,"y":842,"width":88,"height":35},{"text":"A卜\u0026된다.","x":1106,"y":842,"width":138,"height":35},{"text":"몇몇","x":1262,"y":842,"width":63,"height":35},{"text":"CPU는","x":1341,"y":844,"width":114,"height":32},{"text":"운","x":1467,"y":843,"width":32,"height":33}]},{"text":"영체제가 LRU 항목 교체에 참여하는 것을 허용하는 반면에, 다른 CPU는 자신이 직접","words":[{"text":"영체제가","x":288,"y":898,"width":119,"height":36},{"text":"LRU","x":417,"y":902,"width":69,"height":28},{"text":"항목","x":498,"y":899,"width":59,"height":35},{"text":"교체에","x":568,"y":900,"width":85,"height":35},{"text":"참여하는","x":668,"y":899,"width":116,"height":36},{"text":"것을","x":797,"y":899,"width":59,"height":35},{"text":"허용하는","x":868,"y":899,"width":122,"height":36},{"text":"반면에,","x":1002,"y":900,"width":102,"height":36},{"text":"다른","x":1118,"y":900,"width":65,"height":34},{"text":"CPU는","x":1195,"y":902,"width":114,"height":32},{"text":"자신이","x":1322,"y":900,"width":97,"height":35},{"text":"직접","x":1438,"y":900,"width":57,"height":35}]},{"text":"선택한다. 더욱이 몇몇 TLB는 특정 항목 들 을 TLB에 고정하는데, 이러한 항목들은 TLB","words":[{"text":"선택한다.","x":289,"y":957,"width":124,"height":35},{"text":"더욱이","x":427,"y":957,"width":82,"height":35},{"text":"몇몇","x":524,"y":958,"width":55,"height":34},{"text":"TLB는","x":590,"y":960,"width":92,"height":31},{"text":"특정","x":691,"y":958,"width":56,"height":34},{"text":"항목","x":761,"y":957,"width":53,"height":35},{"text":"들","x":824,"y":958,"width":21,"height":33},{"text":"을","x":855,"y":957,"width":20,"height":33},{"text":"TLB에","x":889,"y":958,"width":94,"height":34},{"text":"고정하는데,","x":997,"y":958,"width":167,"height":35},{"text":"이러한","x":1179,"y":959,"width":98,"height":33},{"text":"항목들은","x":1288,"y":958,"width":134,"height":34},{"text":"TLB","x":1432,"y":962,"width":66,"height":27}]},{"text":"에서 제거될 수 없다. 보통 중요 커널 코드를 TLB에 고정한다.","words":[{"text":"에서","x":289,"y":1015,"width":55,"height":35},{"text":"제거될","x":360,"y":1015,"width":85,"height":36},{"text":"수","x":456,"y":1016,"width":30,"height":34},{"text":"없다.","x":497,"y":1016,"width":62,"height":35},{"text":"보통","x":572,"y":1018,"width":57,"height":33},{"text":"중요","x":639,"y":1017,"width":59,"height":34},{"text":"커널","x":710,"y":1016,"width":54,"height":35},{"text":"코드를","x":777,"y":1016,"width":90,"height":33},{"text":"TLB에","x":876,"y":1016,"width":93,"height":35},{"text":"고정한다.","x":984,"y":1016,"width":131,"height":35}]},{"text":"어떤 TLB는 각 항목에 ASIDs (address-space identifiers)를 저장하기도 한다.","words":[{"text":"어떤","x":345,"y":1074,"width":58,"height":35},{"text":"TLB는","x":414,"y":1076,"width":93,"height":32},{"text":"각","x":519,"y":1074,"width":29,"height":34},{"text":"항목에","x":560,"y":1074,"width":84,"height":35},{"text":"ASIDs","x":659,"y":1077,"width":102,"height":28},{"text":"(address-space","x":774,"y":1076,"width":228,"height":37},{"text":"identifiers)를","x":1015,"y":1076,"width":217,"height":33},{"text":"저장하기도","x":1249,"y":1074,"width":164,"height":36},{"text":"한다.","x":1427,"y":1074,"width":70,"height":35}]},{"text":"ASID는 그 TLB 항목이 어느 프로세스에 속한 것인지를 알려주며 그 프로세스의 정보","words":[{"text":"ASID는","x":288,"y":1134,"width":115,"height":33},{"text":"그","x":413,"y":1137,"width":30,"height":23},{"text":"TLB","x":454,"y":1136,"width":61,"height":27},{"text":"항목이","x":528,"y":1133,"width":82,"height":34},{"text":"어느","x":628,"y":1132,"width":56,"height":36},{"text":"프로세스에","x":696,"y":1132,"width":146,"height":35},{"text":"속한","x":856,"y":1132,"width":61,"height":34},{"text":"것인지를","x":931,"y":1133,"width":123,"height":35},{"text":"알려주며","x":1068,"y":1133,"width":123,"height":35},{"text":"그","x":1208,"y":1138,"width":34,"height":23},{"text":"프로세스의","x":1256,"y":1132,"width":162,"height":35},{"text":"정보","x":1437,"y":1132,"width":61,"height":35}]},{"text":"를 보호하기 위해 A卜우된다. TLB에서 가상 주소를 변환할 때 현재 수행 중인 프로세스","words":[{"text":"를","x":289,"y":1192,"width":31,"height":32},{"text":"보호하기","x":331,"y":1191,"width":115,"height":34},{"text":"위해","x":463,"y":1190,"width":55,"height":34},{"text":"A卜우된다.","x":532,"y":1190,"width":121,"height":35},{"text":"TLB에서","x":668,"y":1190,"width":117,"height":35},{"text":"가상","x":803,"y":1190,"width":59,"height":35},{"text":"주소를","x":873,"y":1192,"width":92,"height":32},{"text":"변환할","x":979,"y":1191,"width":93,"height":34},{"text":"때","x":1086,"y":1191,"width":27,"height":35},{"text":"현재","x":1131,"y":1191,"width":60,"height":34},