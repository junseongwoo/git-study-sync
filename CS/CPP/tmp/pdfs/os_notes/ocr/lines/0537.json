":347,"y":1207,"width":253,"height":36},{"text":"특히","x":617,"y":1206,"width":60,"height":36},{"text":"중요한데","x":694,"y":1207,"width":124,"height":36},{"text":"한","x":835,"y":1208,"width":32,"height":34},{"text":"사람이","x":880,"y":1208,"width":91,"height":36},{"text":"공유되고","x":988,"y":1208,"width":126,"height":36},{"text":"있는","x":1130,"y":1208,"width":60,"height":35},{"text":"디렉터리에","x":1205,"y":1208,"width":153,"height":36},{"text":"파일을","x":1374,"y":1208,"width":97,"height":36},{"text":"만들","x":1486,"y":1208,"width":62,"height":36}]},{"text":"거나 지우면 그것이 다른 모든 공유하고 있는 서브디렉터리에 자동으로 반영된다.","words":[{"text":"거나","x":299,"y":1267,"width":65,"height":37},{"text":"지우면","x":377,"y":1267,"width":94,"height":37},{"text":"그것이","x":484,"y":1267,"width":91,"height":36},{"text":"다른","x":590,"y":1267,"width":64,"height":35},{"text":"모든","x":664,"y":1269,"width":64,"height":32},{"text":"공유하고","x":739,"y":1268,"width":125,"height":35},{"text":"있는","x":878,"y":1268,"width":61,"height":36},{"text":"서브디렉터리에","x":950,"y":1268,"width":216,"height":36},{"text":"자동으로","x":1179,"y":1268,"width":125,"height":36},{"text":"반영된다.","x":1316,"y":1268,"width":132,"height":36}]},{"text":"팀을 이루어 작업을 할 때, 공유되어야 할 모든 파일은 하나의 디렉터리에 놓일 수","words":[{"text":"팀을","x":361,"y":1328,"width":63,"height":36},{"text":"이루어","x":440,"y":1328,"width":91,"height":36},{"text":"작업을","x":549,"y":1327,"width":95,"height":36},{"text":"할","x":657,"y":1328,"width":33,"height":35},{"text":"때,","x":704,"y":1328,"width":37,"height":36},{"text":"공유되어야","x":756,"y":1328,"width":159,"height":37},{"text":"할","x":928,"y":1329,"width":32,"height":35},{"text":"모든","x":973,"y":1330,"width":65,"height":34},{"text":"파일은","x":1051,"y":1329,"width":94,"height":36},{"text":"하나의","x":1158,"y":1328,"width":90,"height":37},{"text":"디렉터리에","x":1266,"y":1328,"width":154,"height":36},{"text":"놓일","x":1436,"y":1328,"width":62,"height":36},{"text":"수","x":1513,"y":1329,"width":33,"height":36}]},{"text":"있다. 각 팀 구성원의 홈 디렉터리에는 공유파일 디렉터리가 서브디렉터리로