:640,"width":72,"height":39},{"text":"5.6절에서","x":384,"y":640,"width":146,"height":40},{"text":"실시간","x":552,"y":641,"width":98,"height":39},{"text":"시스템의","x":667,"y":641,"width":130,"height":39},{"text":"스게줄링","x":817,"y":643,"width":132,"height":39},{"text":"요구","x":970,"y":646,"width":67,"height":37},{"text":"조건에","x":1053,"y":644,"width":100,"height":39},{"text":"관해","x":1172,"y":645,"width":67,"height":39},{"text":"탐구한다.","x":1258,"y":645,"width":146,"height":40},{"text":"선점형","x":1424,"y":645,"width":97,"height":39},{"text":"커널에","x":1544,"y":645,"width":98,"height":39}]},{"text":"는 공유 커널 데이터 구조에 액세스 할 때 경쟁 조건을 방지하기 위해 mutex 락과 같은","words":[{"text":"는","x":292,"y":708,"width":35,"height":35},{"text":"공유","x":339,"y":706,"width":67,"height":38},{"text":"커널","x":421,"y":705,"width":62,"height":39},{"text":"데이터","x":501,"y":707,"width":94,"height":39},{"text":"구조에","x":612,"y":706,"width":99,"height":39},{"text":"액세스","x":728,"y":708,"width":101,"height":37},{"text":"할","x":843,"y":709,"width":34,"height":37},{"text":"때","x":892,"y":708,"width":28,"height":39},{"text":"경쟁","x":939,"y":709,"width":62,"height":39},{"text":"조건을","x":1018,"y":709,"width":103,"height":38},{"text":"방지하기","x":1136,"y":710,"width":133,"height":40},{"text":"위해","x":1289,"y":711,"width":64,"height":39},{"text":"mutex","x":1370,"y":718,"width":109,"height":27},{"text":"락과","x":1496,"y":711,"width":68,"height":38},{"text":"같은","x":1578,"y":710,"width":68,"height":39}]},{"text":"기법이 필요하다. 대부분의 최신 운영체세는 이제 커널 모드에서 실행될 때 완전히 선점","words":[{"text":"기법이","x":294,"y":770,"width":95,"height":39},{"text":"필요하다.","x":408,"y":771,"width":140,"height":40},{"text":"대부분의","x":566,"y":771,"width":129,"height":39},{"text":"최신","x":714,"y":772,"width":65,"height":37},{"text":"운영체세는","x":793,"y":773,"width":172,"height":39},{"text":"이제","x":980,"y":774,"width":64,"height":39},{"text":"커널","x":1063,"y":774,"width":63,"height":38},{"text":"모드에서","x":1142,"y":776,"width":135,"height":38},{"text":"실행될","x":1296,"y":776,"width":100,"height":39},{"text":"때","x":1414,"y":776,"width":29,"height":38},{"text":"완전히","x":1460,"y":776,"width":99,"height":39},{"text":"선점","x":1578,"y":776,"width":63,"height":38}]},{"text":"될수 있다.","words":[{"text":"될수","x":293,"y":835,"width":78,"height":38},{"text":"있다.","x":385,"y":835,"width":72,"height":39}]},{"text":"정의에 의하면 인터럽트는 어느 시점에서건 일어날 수 있고, 커널에 의해서 항상 무","words":[{"text":"정의에","x":356,"y":900,"width":96,"height":39},{"text":"의하면","x":469,"y":901,"width":99,"height":39},{"text":"인터럽트는","x":586,"y":901,"width":168,"height":38},{"text":"어느","x":769,"y":902,"width":68,"height":38},{"text":"시점에서건","x":852,"y":903,"width":169,"height":39},{"text":"일어날","x":1040,"y":904,"width":100,"height":38},{"text":"수","x":1153,"y":905,"width":35,"height":38},{"text":"있고,","x":1204,"y":905,"width":75,"height":39},{"text":"커널에","x":1296,"y":905,"width":99,"height":39},{"text":"의해서","x":1414,"y":905,"width":97,"height":39},{"text":"항상","x":1529,"y":905,"width":70,"height":39},{"text":"무","x":1611,"y":907,"width":35,"height":36}]},{"text":"시될 수는 없기 때문에, 인터럽트에 의해서 영향을 받는 코드 부분-은 반드시 동시 사용","words":[{"text":"시될","x":291,"y":965,"width":64,"height":38},{"text":"수는","x":372,"y":965,"width":68,"height":38},{"text":"없기","x":457,"y":966,"width":61,"height":39},{"text":"때문에,","x":539,"y":966,"width":108,"height":39},{"text":"인터럽트에","x":666,"y":966,"width":167,"height":40},{"text":"의해서","x":853,"y":968,"width":97,"height":38},{"text":"영향을","x":973,"y":968,"width":101,"height":39},{"text":"받는","x":1089,"y":969,"width":68,"height":38},{"text":"코드","x":1173,"y":973,"width":68,"height":28},{"text":"부분-은","x":1256,"y":970,"width":104,"height":37},{"text":"반드시","x":1376,"y":970,"width":99,"height":38},{"text":"동시","x":1494,"y":969,"width":65,"height":39},{"text":"사용","x":1578,"y":969,"width":69,"height":38}]},{"text":"으로부터 보호되어야 한다. 운영체제는 거의 항상 인터럽트를 받아들일 필요가 있는데,","words":[{"text":"으로부터","x":290,"y":1030,"width":130,"height":39},{"text":"보호되어야","x":440,"y":1031,"width":170,"height":39},{"text":"한다.","x":625,"y":1031,"width":75,"height":38},{"text":"운영체제는","x":718,"y":1032,"width":174,"height":39},{"text":"거의","x":909,"y":1033,"width":63,"height":38},{"text":"항상","x":991,"y":1034,"width":70,"height":38},{"text":"인터럽트를","x":1078,"y":1034,"width":170,"height":38},{"text":"받아들일","x":1264,"y":1034,"width":136,"height":38},{"text":"필요가","x":1419,"y":1034,"width":102,"height":38},{"text":"있는데,","x":1538,"y":1032,"width":109,"height":40}]},{"text":"그렇지 않으면 입력을 잃어버리거나 또는 출력이 겹쳐서 쓰일 수 있다. 따라서 이러한","words":[{"text":"그렇지","x":291,"y":1096,"width":97,"height":39},{"text":"않으면","x":409,"y":1096,"width":99,"height":39},{"text":"입력을","x":528,"y":1096,"width":99,"height":39},{"text":"잃어버리거나","x":646,"y":1096,"width":205,"height":40},{"text":"또는","x":868,"y":1100,"width":69,"height":36},{"text":"출력이","x":953,"y":1098,"width":100,"height":38},{"text":"겹쳐서","x":1075,"y":1098,"width":97,"height":38},{"text":"쓰일","x":1193,"y":1098,"width":66,"height":37},{"text":"수","x":1278,"y":1098,"width":34,"height":38},{"text":"있다.","x":1331,"y":1098,"width":75,"height":38},{"text":"따라서","x":1425,"y":1098,"width":99,"height":38},{"text":"이러한","x":1546,"y":1097,"width":102,"height":39}]},{"text":"코드 부분은 다수 프로세스가 병행으로 접근할 수 없도록 그 진입점에서 인터럽트를 불","words":[{"text":"코드","x":292,"y":1166,"width":67,"height":28},{"text":"부분은","x":372,"y":1162,"width":102,"height":38},{"text":"다수","x":488,"y":1162,"width":67,"height":39},{"text":"프로세스가","x":569,"y":1162,"width":172,"height":38},{"text":"병행으로","x":756,"y":1162,"width":137,"height":40},{"text":"접근할","x":909,"y":1163,"width":104,"height":38},{"text":"수","x":1026,"y":1164,"width":35,"height":37},{"text":"없도록","x":1077,"y":1163,"width":101,"height":38},{"text":"그","x":1192,"y":1167,"width":34,"height":26},{"text":"진입점에서","x":1241,"y":1162,"width":168,"height":39},{"text":"인터럽트를","x":1430,"y":1162,"width":169,"height":39},{"text":"불","x":1612,"y":1162,"width":35,"height":38}]},{"text":"능화하고, 출구에서 인터럽트를 다시 가능화한다. 인터럽트 불-능화는 자주 발생해서