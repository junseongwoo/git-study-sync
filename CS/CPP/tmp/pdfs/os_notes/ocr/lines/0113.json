의","x":576,"y":2579,"width":77,"height":41},{"text":"의미를","x":672,"y":2580,"width":102,"height":40},{"text":"가지려면","x":790,"y":2580,"width":133,"height":41},{"text":"서버가","x":939,"y":2581,"width":103,"height":39},{"text":"요청을","x":1056,"y":2581,"width":104,"height":39},{"text":"받지","x":1174,"y":2582,"width":66,"height":40},{"text":"못하는","x":1258,"y":2581,"width":109,"height":40},{"text":"위험을","x":1383,"y":2581,"width":110,"height":39},{"text":"제거할","x":1509,"y":2582,"width":112,"height":41},{"text":"필요","x":1637,"y":2582,"width":66,"height":39}]},{"text":"가 있다. 이를 완수하려면 서버는 위에서 설명한 “최대 한 번” 프로토콜을 구현하고 추","words":[{"text":"가","x":328,"y":2647,"width":35,"height":39},{"text":"있다.","x":380,"y":2645,"width":73,"height":41},{"text":"이를","x":473,"y":2645,"width":68,"height":40},{"text":"완수하려면","x":555,"y":2646,"width":172,"height":41},{"text":"서버는","x":745,"y":2646,"width":102,"height":41},{"text":"위에서","x":862,"y":2646,"width":95,"height":40},{"text":"설명한","x":978,"y":2646,"width":102,"height":39},{"text":"“최대","x":1095,"y":2648,"width":79,"height":39},{"text":"한","x":1193,"y":2648,"width":36,"height":37},{"text":"번”","x":1245,"y":2648,"width":47,"height":37},{"text":"프로토콜을","x":1309,"y":2648,"width":182,"height":38},{"text":"구현하고","x":1507,"y":2649,"width":148,"height":40},{"text":"추","x":1669,"y":2649,"width":34,"height":39}]}]}