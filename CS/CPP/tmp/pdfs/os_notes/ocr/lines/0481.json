,{"text":"모든","x":886,"y":2087,"width":62,"height":31},{"text":"기능한","x":963,"y":2085,"width":94,"height":34},{"text":"인터럽트의","x":1074,"y":2084,"width":159,"height":34},{"text":"진원지를","x":1256,"y":2083,"width":136,"height":35},{"text":"찾아야","x":1408,"y":2081,"width":99,"height":36}]},{"text":"할 필요를 줄인다. 그러나 컴퓨터는 인터럽트 벡터 내에 있는 주소들보다 더 많은 수의","words":[{"text":"할","x":284,"y":2142,"width":31,"height":33},{"text":"필요를","x":329,"y":2142,"width":88,"height":34},{"text":"줄인다.","x":429,"y":2142,"width":92,"height":34},{"text":"그러나","x":536,"y":2141,"width":87,"height":35},{"text":"컴퓨터는","x":637,"y":2141,"width":117,"height":35},{"text":"인터럽트","x":769,"y":2142,"width":116,"height":34},{"text":"벡터","x":900,"y":2142,"width":54,"height":35},{"text":"내에","x":974,"y":2142,"width":58,"height":34},{"text":"있는","x":1049,"y":2142,"width":63,"height":34},{"text":"주소들보다","x":1125,"y":2141,"width":170,"height":35},{"text":"더","x":1311,"y":2141,"width":28,"height":34},{"text":"많은","x":1359,"y":2140,"width":69,"height":35},{"text":"수의","x":1441,"y":2139,"width":62,"height":36}]},{"text":"장치가 있다. 이러한 문제를 해결하기 위해 인터럽트 사슬회(chaining) 기술을 시용한","words":[{"text":"장치가","x":283,"y":2200,"width":92,"height":35},{"text":"있다.","x":390,"y":2200,"width":62,"height":35},{"text":"이러한","x":468,"y":2200,"width":86,"height":34},{"text":"문제를","x":566,"y":2199,"width":87,"height":34},{"text":"해결하기","x":667,"y":2200,"width":113,"height":34},{"text":"위해","x":799,"y":2200,"width":56,"height":34},{"text":"인터럽트","x":872,"y":2201,"width":119,"height":34},{"text":"사슬회(chaining)","x":1004,"y":2200,"width":266,"height":38},{"text":"기술을","x":1290,"y":2198,"width":102,"height":34},{"text":"시용한","x":1406,"y":2197,"width":101,"height":35}]},{"text":"다. 인터럽트 사슬회에서는 인터럽트 벡터의 각 원소가 여러 인터럽트 핸들러들로 이루","words":[{"text":"다.","x":285,"y":2258,"width":35,"height":35},{"text":"인터럽트","x":338,"y":2258,"width":116,"height":35},{"text":"사슬회에서는","x":466,"y":2257,"width":173,"height":35},{"text":"인터럽트","x":653,"y":2256,"width":115,"heigh