:55,"height":34},{"text":"종류의","x":488,"y":1461,"width":85,"height":34},{"text":"장치","x":586,"y":1461,"width":54,"height":34},{"text":"부류들을","x":654,"y":1462,"width":120,"height":33},{"text":"제공할","x":786,"y":1461,"width":90,"height":34},{"text":"수","x":886,"y":1462,"width":31,"height":34},{"text":"있도록","x":930,"y":1461,"width":91,"height":34},{"text":"설계되어","x":1032,"y":1459,"width":125,"height":35},{"text":"있다.","x":1176,"y":1458,"width":71,"height":35},{"text":"시스템","x":1263,"y":1457,"width":96,"height":36},{"text":"콜은","x":1375,"y":1459,"width":67,"height":32},{"text":"통상","x":1453,"y":1458,"width":64,"height":33}]},{"text":"적으로 자신을 호출한 프로세스를 봉쇄시기지만, 그렇게 하지 말이야 할 경우가 있","words":[{"text":"적으로","x":349,"y":1518,"width":88,"height":33},{"text":"자신을","x":450,"y":1518,"width":88,"height":33},{"text":"호출한","x":550,"y":1518,"width":89,"height":33},{"text":"프로세스를","x":650,"y":1518,"width":149,"height":34},{"text":"봉쇄시기지만,","x":812,"y":1518,"width":191,"height":34},{"text":"그렇게","x":1018,"y":1517,"width":93,"height":35},{"text":"하지","x":1129,"y":1516,"width":61,"height":35},{"text":"말이야","x":1209,"y":1517,"width":102,"height":34},{"text":"할","x":1324,"y":1516,"width":35,"height":33},{"text":"경우가","x":1375,"y":1515,"width":98,"height":35},{"text":"있","x":1488,"y":1515,"width":28,"height":34}]},{"text":"기 때문에 시스템은 비봉쇄형과 비동기 호출을 제공한다. 이들은 커널 자신에 의해","words":[{"text":"기","x":349,"y":1575,"width":24,"height":33},{"text":"때문에","x":392,"y":1575,"width":84,"height":33},{"text":"시스템은","x":492,"y":1575,"width":116,"height":33},{"text":"비봉쇄형과","x":622,"y":1575,"width":148,"height":34},{"text":"비동기","x":784,"y":1576,"width":84,"height":34},{"text":"호출을","x":885,"y":1575,"width":93,"height":33},{"text":"제공한다.","x":992,"y":1574,"width":134,"height":34},{"text":"이들은","x":1144,"y":1574,"width":100,"height":34},{"text":"커널","x":1259,"y":1574,"width":63,"height":34},{"text":"자신에","x":1340,"y":1573,"width":97,"height":35},{"text":"의해","x":1455,"y":1573,"width":59,"height":33}]},{"text":"불리기도 하며, 입출력 동작의 완료를 기다릴 동안 수면(sleep) 상태로 들어가지 말","words":[{"text":"불리기도","x":347,"y":1632,"width":119,"height":33},{"text":"하며,","x":478,"y":1632,"width":64,"height":34},{"text":"입출력","x":557,"y":1633,"width":82,"height":33},{"text":"동작의","x":653,"y":1633,"width":87,"height":33},{"text":"완료를","x":755,"y":1632,"width":91,"height":33},{"text":"기다릴","x":859,"y":1632,"width":87,"height":34},{"text":"동안","x":960,"y":1632,"width":64,"height":34},{"text":"수면(sleep)","x":1035,"y":1632,"width":175,"height":39},{"text":"상태로","x":1226,"y":1632,"width":102,"height":35},{"text":"들어가지","x":1341,"y":1630,"width":129,"height":34},{"text":"말","x":1486,"y":1631,"width":32,"height":33}]},{"text":"이야 할 핑용 프로그램들에 의해서도 시용된다.","words":[{"text":"이야","x":347,"y":1689,"width":60,"height":33},{"text":"할","x":417,"y":1688,"width":30,"height":34},{"text":"핑용","x":456,"y":1689,"width":59,"height":34},{"text":"프로그램들에","x":525,"y":1689,"width":173,"height":35},{"text":"의해서도","x":712,"y":1689,"width":119,"height":34},{"text":"시용된다.","x":841,"y":1689,"width":129,"height":35}]},{"text":"• 커널의 입출력 서브시스템은 많은 서비스를 제공한다. 입출력 스케줄, 버퍼링, 스풀","words":[{"text":"•","x":310,"y":1766,"width":13,"height":13},{"text":"커널의","x":348,"y":1755,"width":84,"height":35},{"text":"입출력","x":450,"y":1756,"width":81,"height":34},{"text":"서브시스템은","x":548,"y":1757,"width":176,"height":34},{"text":"많은","x":736,"y":1757,"width":60,"height":34},{"text":"서비스를","x":809,"y":1757,"width":121,"height":35},{"text":"제공한다.","x":944,"y":1757,"width":131,"height":34},{"text":"입출력","x":1094,"y":1757,"width":92,"height":35},{"text":"스케줄,","x":1205,"y":1758,"width":109,"height":34},{"text":"버퍼링,","x":1333,"y":1756,"width":106,"height":35},{"text":"스풀","x":1454,"y":1757,"width":64,"height":32}]},{"text":"링, 오류 처리, 장치 예약 등이 그것이다. 이외의 서비스로는 하드웨어 장치와","words":[{"text":"링,","x":349,"y":1814,"width":34,"height":35},{"text":"오류","x":398,"y":1816,"width":59,"height":32},{"text":"처리,","x":472,"y":1815,"width":62,"height":34},{"text":"장치","x":548,"y":181