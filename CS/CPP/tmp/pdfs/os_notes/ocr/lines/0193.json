458,"width":34,"height":36},{"text":"부하를","x":1504,"y":456,"width":107,"height":39}]},{"text":"가지고 있으면서 준비 큐에 처리기를 기다리는 스레드들이 많은 상황에서 하나 이상의","words":[{"text":"가지고","x":280,"y":523,"width":96,"height":39},{"text":"있으면서","x":395,"y":523,"width":125,"height":40},{"text":"준비","x":539,"y":524,"width":63,"height":39},{"text":"큐에","x":620,"y":523,"width":62,"height":40},{"text":"처리기를","x":702,"y":523,"width":129,"height":40},{"text":"기다리는","x":848,"y":522,"width":132,"height":40},{"text":"스레드들이","x":995,"y":522,"width":165,"height":41},{"text":"많은","x":1181,"y":522,"width":67,"height":41},{"text":"상황에서","x":1264,"y":523,"width":135,"height":40},{"text":"하나","x":1419,"y":521,"width":69,"height":41},{"text":"이상의","x":1506,"y":520,"width":101,"height":40}]},{"text":"처리기가 쉬게 된다. 부하 균등화(load balancing)는 SMP 시스템의 모든 처리기 사이","words":[{"text":"처리기가","x":280,"y":588,"width":131,"height":39},{"text":"쉬게","x":425,"y":588,"width":62,"height":39},{"text":"된다.","x":504,"y":589,"width":70,"height":39},{"text":"부하","x":590,"y":590,"width":66,"height":38},{"text":"균등화(load","x":669,"y":589,"width":182,"height":42},{"text":"balancing)는","x":866,"y":589,"width":212,"height":44},{"text":"SMP","x":1091,"y":591,"width":81,"height":33},{"text":"시스템의","x":1187,"y":589,"width":133,"height":40},{"text":"모든","x":1338,"y":591,"width":70,"height":37},{"text":"처리기","x":1423,"y":586,"width":98,"height":42},{"text":"사이","x":1540,"y":586,"width":67,"height":40}]},{"text":"에 부하가 고르게 배분되도록 시도한다. 부하 균등화는 통상 각 처리기가 실행할 스레드","words":[{"text":"에","x":278,"y":654,"width":28,"height":38},{"text":"부하가","x":322,"y":653,"width":101,"height":39},{"text":"고르게","x":435,"y":654,"width":96,"height":39},{"text":"배분되도록","x":549,"y":654,"width":162,"height":38},{"text":"시도한다.","x":725,"y":654,"width":138,"height":39},{"text":"부하","x":879,"y":654,"width":66,"height":39},{"text":"균등화는","x":958,"y":654,"width":135,"height":39},{"text":"통상","x":1105,"y":655,"width":69,"height":39},{"text":"각","x":1188,"y":656,"width":33,"heigh