{"page":509,"width":1666,"height":2501,"text_angle":0,"lines":[{"text":"570","words":[{"text":"570","x":160,"y":144,"width":58,"height":29}]},{"text":"Chapter 12 입출력 시스템","words":[{"text":"Chapter","x":288,"y":147,"width":116,"height":27},{"text":"12","x":416,"y":148,"width":35,"height":21},{"text":"입출력","x":479,"y":147,"width":61,"height":25},{"text":"시스템","x":550,"y":149,"width":61,"height":25}]},{"text":"STREAMS 입출력은 A卜岳자 프로세스가 스트림 헤드와 통신할 때를 제외하고 비동","words":[{"text":"STREAMS","x":347,"y":272,"width":161,"height":29},{"text":"입출력은","x":521,"y":270,"width":117,"height":34},{"text":"A卜岳자","x":648,"y":271,"width":88,"height":35},{"text":"프로세스가","x":746,"y":270,"width":150,"height":36},{"text":"스트림","x":906,"y":272,"width":89,"height":34},{"text":"헤드와","x":1011,"y":272,"width":95,"height":35},{"text":"통신할","x":1118,"y":272,"width":99,"height":35},{"text":"때를","x":1230,"y":272,"width":66,"height":34},{"text":"제외하고","x":1309,"y":271,"width":131,"height":34},{"text":"비동","x":1455,"y":271,"width":60,"height":35}]},{"text":"기(비봉쇄적)이다 스트림에 쓰기를 할 때 시용자 프로세스는 디음 큐가 흐름 제어를 사","words":[{"text":"기(비봉쇄적)이다","x":293,"y":326,"width":238,"height":38},{"text":"스트림에","x":545,"y":327,"width":114,"height":35},{"text":"쓰기를","x":674,"y":328,"width":88,"height":34},{"text":"할","x":774,"y":328,"width":29,"height":34},{"text":"때","x":816,"y":328,"width":25,"height":34},{"text":"시용자","x":857,"y":328,"width":92,"height":35},{"text":"프로세스는","x":961,"y":329,"width":158,"height":34},{"text":"디음","x":1133,"y":329,"width":65,"height":34},{"text":"큐가","x":1212,"y":328,"width":67,"height":34},{"text":"흐름","x":1293,"y":329,"width":67,"height":32},{"text":"제어를","x":1376,"y":327,"width":96,"height":34},{"text":"사","x":1485,"y":328,"width":31,"height":34}]},{"text":"용한다고 가정할 경우 메시지를 복사할 공간이 있을 1내7/찌 봉쇄(block)된다. 마찬가지","words":[{"text":"용한다고","x":290,"y":384,"width":123,"height":35},{"text":"가정할","x":427,"y":384,"width":87,"height":35},{"text":"경우","x":528,"y":384,"width":56,"height":35},{"text":"메시지를","x":597,"y":385,"width":117,"height":35},{"text":"복사할","x":725,"y":385,"width":89,"height":35},{"text":"공간이","x":825,"y":384,"width":87,"height":36},{"text":"있을","x":931,"y":385,"width":60,"height":35},{"text":"1내7/찌","x":1005,"y":385,"width":89,"height":36},{"text":"봉쇄(block)된다.","x":1112,"y":384,"width":258,"height":38},{"text":"마찬가지","x":1388,"y":384,"width":124,"height":35}]},{"text":"로 사용자 프로세스는 스트림으로부터 읽기를 할 때 데이터가 이용 기능할 때까지 봉쇄","words":[{"text":"로","x":291,"y":446,"width":31,"height":25},{"text":"사용자","x":334,"y":441,"width":92,"height":36},{"text":"프로세스는","x":437,"y":441,"width":147,"height":35},{"text":"스트림으로부터","x":596,"y":442,"width":201,"height":35},{"text":"읽기를","x":816,"y":442,"width":88,"height":35},{"text":"할","x":916,"y":443,"width":31,"height":34},{"text":"때","x":961,"y":443,"width":26,"height":34},{"text":"데이터가","x":1005,"y":442,"width":126,"height":36},{"text":"이용","x":1146,"y":441,"width":65,"height":36},{"text":"기능할","x":1226,"y":442,"width":100,"height":34},{"text":"때까지","x":1341,"y":441,"width":94,"height":35},{"text":"봉쇄","x":1452,"y":441,"width":61,"height":36}]},{"text":"된다.","words":[{"text":"된다.","x":292,"y":499,"width":67,"height":35}]},{"text":"앞서 언급한 것처럼 스트림 헤드와 모듈과 미국까지로 드라이버 엔드도 읽기와 쓰","words":[{"text":"앞서","x":350,"y":557,"width":56,"height":34},{"text":"언급한","x":425,"y":557,"width":87,"height":34},{"text":"것처럼","x":527,"y":556,"width":81,"height":36},{"text":"스트림","x":626,"y":558,"width":84,"height":34},{"text":"헤드와","x":728,"y":558,"width":88,"height":35},{"text":"모듈과","x":830,"y":558,"width":90,"height":35},{"text":"미국까지로","x":934,"y":558,"width":157,"height":35},{"text":"드라이버","x":1107,"y":557,"width":128,"height":35},{"text":"엔드도","x":1257,"y":557,"width":99,"height":34},{"text":"읽기와","x":1375,"y":556,"width":96,"height":35},{"text":"쓰","x":1485,"y":560,"width":30,"height":25}]},{"text":"기 큐를 가지고 있다는 점에서 스트림 헤드나 모듈과 비슷하다. 그러나 드라이버 엔드는","words":[{"text":"기","x":294,"y":615,"width":24,"height":34},{"text":"큐를","x":334,"y":616,"width":61,"height":33},{"text":"가지고","x":408,"y":615,"width":87,"height":35},{"text":"있다는","x":508,"y":614,"width":85,"height":35},{"text":"점에서","x":606,"y":615,"width":82,"height":35},{"text":"스트림","x":703,"y":616,"width":85,"height":34},{"text":"헤드나","x":804,"y":616,"width":89,"height":35},{"text":"모듈과","x":904,"y":617,"width":94,"height":34},{"text":"비슷하다.","x":1011,"y":616,"width":133,"height":35},{"text":"그러나","x":1160,"y":616,"width":101,"height":34},{"text":"드라이버","x":1273,"y":615,"width":130,"height":34},{"text":"엔드는","x":1421,"y":614,"width":94,"height":34}]},{"text":"네트워크로부터 프레임이 읽기 준비가 되었을 때 촉발되는 것과 같은 인터럽트에 반드","words":[{"text":"네트워크로부터","x":292,"y":672,"width":206,"height":35},{"text":"프레임이","x":515,"y":672,"width":113,"height":35},{"text":"읽기","x":646,"y":673,"width":53,"height":35},{"text":"준비가","x":716,"y":673,"width":89,"height":36},{"text":"되었을","x":819,"y":673,"width":90,"height":36},{"text":"때","x":923,"y":674,"width":26,"height":35},{"text":"촉발되는","x":966,"y":674,"width":128,"height":35},{"text":"것과","x":1110,"y":674,"width":64,"height":34},{"text":"같은","x":1189,"y":674,"width":67,"height":34},{"text":"인터럽트에","x":1274,"y":673,"width":162,"height":34},{"text":"반드","x":1454,"y":672,"width":61,"height":34}]},{"text":"시 응답해야 한다. 다음 큐에 메시지를 복사할 수 없을 때 봉쇄되는 스트림 헤드와는 달","words":[{"text":"시","x":293,"y":730,"width":25,"height":35},{"text":"응답해야","x":334,"y":731,"width":121,"height":36},{"text":"한다.","x":466,"y":730,"width":65,"height":35},{"text":"다음","x":545,"y":730,"width":58,"height":35},{"text":"큐에","x":614,"y":731,"width":56,"height":34},{"text":"메시지를","x":685,"y":731,"width":118,"height":36},{"text":"복사할","x":814,"y":732,"width":92,"height":35},{"text":"수","x":917,"y":733,"width":31,"height":34},{"text":"없을","x":962,"y":732,"width":61,"height":35},{"text":"때","x":1037,"y":733,"width":27,"height":34},{"text":"봉쇄되는","x":1080,"y":732,"width":132,"height":35},{"text":"스트림","x":1226,"y":732,"width":97,"height":34},{"text":"헤드와는","x":1341,"y":731,"width":131,"height":35},{"text":"달","x":1486,"y":732,"width":29,"height":33}]},{"text":"리 드라이버 엔드는 모든 들어오는 데이터를 처리해야 한다. 드라이버 역시 흐름 제어를","words":[{"text":"리","x":293,"y":788,"width":25,"height":35},{"text":"드라이버","x":333,"y":788,"width":117,"height":35},{"text":"엔드는","x":466,"y":789,"width":86,"height":33},{"text":"모든","x":562,"y":790,"width":59,"height":32},{"text":"들어오는","x":632,"y":789,"width":118,"height":35},{"text":"데이터를","x":763,"y":790,"width":118,"height":34},{"text":"처리해야","x":894,"y":790,"width":124,"height":35},{"text":"한다.","x":1029,"y":791,"width":70,"height":33},{"text":"드라이버","x":1114,"y":790,"width":130,"height":34},{"text":"역시","x":1264,"y":790,"width":60,"height":34},{"text":"흐름","x":1342,"y":791,"width":66,"height":33},{"text":"제어를","x":1422,"y":789,"width":93,"height":34}]},{"text":"반드시 지원해야 한다. 그러나 디바이스의 버퍼가 기득 잤다면 디바이스는 전형적으로","words":[{"text":"반드시","x":291,"y":846,"width":87,"height":35},{"text":"지원해야","x":398,"y":846,"width":117,"height":35},{"text":"한다.","x":528,"y":846,"width":64,"height":34},{"text":"그러나","x":608,"y":846,"width":88,"height":35},{"text":"디바이스의","x":710,"y":847,"width":144,"height":36},{"text":"버퍼가","x":873,"y":848,"width":92,"height":35},{"text":"기득","x":980,"y":849,"width":62,"height":34},{"text":"잤다면","x":1057,"y":848,"width":95,"height":35},{"text":"디바이스는","x":1171,"y":848,"width":168,"height":35},{"text":"전형적으로","x":1356,"y":847,"width":158,"height":34}]},{"text":"수신되는 메시지를 버리는 방법을 택한다. 입력 버퍼가 기득 찬 네트워크 카드를 생각해","words":[{"text":"수신되는","x":290,"y":904,"width":123,"height":34},{"text":"메시지를","x":424,"y":904,"width":117,"height":35},{"text":"버리는","x":553,"y":904,"width":86,"height":35},{"text":"방법을","x":650,"y":904,"width":89,"height":35},{"text":"택한다.","x":751,"y":905,"width":93,"height":36},{"text":"입력","x":861,"y":906,"width":54,"height":35},{"text":"버퍼가","x":933,"y":906,"width":93,"height":36},{"text":"기득","x":1039,"y":906,"width":63,"height":35},{"text":"찬","x":1115,"y":906,"width":33,"height":33},{"text":"네트워크","x":1161,"y":906,"width":133,"height":35},{"text":"카드를","x":1308,"y":906,"width":100,"height":34},{"text":"생각해","x":1421,"y":905,"width":91,"height":36}]},{"text":"보자. 네트워크 카드는 들어오는 메시지를 저징활 버퍼 공간이 확보될 때까지 메시지를","words":[{"text":"보자.","x":290,"y":962,"width":68,"height":35},{"text":"네트워크","x":373,"y":962,"width":119,"height":36},{"text":"카드는","x":504,"y":962,"width":88,"height":35},{"text":"들어오는","x":602,"y":962,"width":119,"height":35},{"text":"메시지를","x":733,"y":963,"width":119,"height":35},{"text":"저징활","x":866,"y":964,"width":91,"height":35},{"text":"버퍼","x":971,"y":965,"width":57,"height":34},{"text":"공간이","x":1046,"y":964,"width":93,"height":35},{"text":"확보될","x":1157,"y":964,"width":99,"height":34},{"text":"때까지","x":1274,"y":963,"width":95,"height":36},{"text":"메시지를","x":1388,"y":963,"width":126,"height":35}]},{"text":"단순히 버린다.","words":[{"text":"단순히","x":290,"y":1020,"width":88,"height":35},{"text":"버린다.","x":394,"y":1021,"width":93,"height":35}]},{"text":"STREAMS를 사\u0026함으로써 얻어지는 이득은 디바이스 드라이버와 네트워크 프로","words":[{"text":"STREAMS를","x":346,"y":1081,"width":190,"height":32},{"text":"사\u0026함으로써","x":549,"y":1079,"width":172,"height":35},{"text":"얻어지는","x":740,"y":1079,"width":118,"height":36},{"text":"이득은","x":873,"y":1080,"width":91,"height":34},{"text":"디바이스","x":979,"y":1080,"width":127,"height":35},{"text":"드라이버와","x":1121,"y":1079,"width":170,"height":36},{"text":"네트워크","x":1306,"y":1079,"width":131,"height":35},{"text":"프로","x":1452,"y":1083,"width":62,"height":25}]},{"text":"토콜을 작성할 때 모듈식이며 점진적인 접근을 위한 프레임워크를 제공한다는 것이다.","words":[{"text":"토콜을","x":290,"y":1137,"width":92,"height":34},{"text":"작성할","x":395,"y":1137,"width":90,"height":35},{"text":"때","x":498,"y":1137,"width":25,"height":34},{"text":"모듈식이며","x":539,"y":1137,"width":143,"height":35},{"text":"점진적인","x":701,"y":1137,"width":116,"height":34},{"text":"접근을","x":834,"y":1138,"width":90,"height":34},{"text":"위한","x":939,"y":1137,"width":63,"height":35},{"text":"프레임워크를","x":1016,"y":1137,"width":196,"height":35},{"text":"제공한다는","x":1229,"y":1137,"width":168,"height":34},{"text":"것이다.","x":1414,"y":1136,"width":98,"height":35}]},{"text":"모듈은 다른 스트림 그러므로 다른 디바이스에 의해 시용될 수 있다. 예를 들어, 네크워","words":[{"text":"모듈은","x":290,"y":1196,"width":92,"height":32},{"text":"다른","x":393,"y":1195,"width":60,"height":34},{"text":"스트림","x":464,"y":1195,"width":83,"height":34},{"text":"그러므로","x":562,"y":1195,"width":118,"height":35},{"text":"다른","x":693,"y":1195,"width":59,"height":34},{"text":"디바이스에","x":765,"y":1195,"width":147,"height":35},{"text":"의해","x":928,"y":1195,"width":59,"height":35},{"text":"시용될","x":1003,"y":1194,"width":94,"height":35},{"text":"수","x":1112,"y":1195,"width":34,"height":34},{"text":"있다.","x":1161,"y":1195,"width":71,"height":34},{"text":"예를","x":1250,"y":1195,"width":67,"height":34},{"text":"들어,","x":1329,"y":1194,"width":76,"height":34},{"text":"네크워","x":1421,"y":1194,"width":90,"height":34}]},{"text":"킹 모듈은 이더넷 네트워크 카드와 802.11 무선 네트워크 카드 둘 모두에 의해 시용될","words":[{"text":"킹","x":293,"y":1252,"width":24,"height":35},{"text":"모듈은","x":334,"y":1253,"width":91,"height":33},{"text":"이더넷","x":438,"y":1253,"width":85,"height":34},{"text":"네트워크","x":538,"y":1253,"width":116,"height":35},{"text":"카드와","x":668,"y":1253,"width":89,"height":35},{"text":"802.11","x":769,"y":1257,"width":91,"height":27},{"text":"무선","x":876,"y":1253,"width":60,"height":34},{"text":"네트워크","x":953,"y":1253,"width":126,"height":34},{"text":"카드","x":1094,"y":1252,"width":65,"height":35},{"text":"둘","x":1173,"y":1253,"width":34,"height":32},{"text":"모두에","x":1222,"y":1252,"width":98,"height":35},{"text":"의해","x":1339,"y":1251,"width":63,"height":35},{"text":"시용될","x":1419,"y":1251,"width":92,"height":35}]},{"text":"수 있다. 더군다나 문자 장치 입출력을 구조화되지 않은 바이트 스트림으로 취급하기보","words":[{"text":"수","x":290,"y":1311,"width":32,"height":33},{"text":"있다.","x":336,"y":1310,"width":63,"height":34},{"text":"더군다나","x":415,"y":1311,"width":116,"height":33},{"text":"문자","x":542,"y":1310,"width":60,"height":35},{"text"