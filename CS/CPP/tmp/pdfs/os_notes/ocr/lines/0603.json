":928,"y":1620,"width":57,"height":36},{"text":"상태","x":998,"y":1619,"width":58,"height":35},{"text":"정보(state","x":1072,"y":1619,"width":142,"height":38},{"text":"information)가","x":1227,"y":1619,"width":238,"height":38},{"text":"클","x":1476,"y":1623,"width":34,"height":32}]},{"text":"라이언트 서버 모두에 유지될 수 있다. 만약 서버와 클라이언트가 현재의 활동, 열린 파","words":[{"text":"라이언트","x":276,"y":1678,"width":128,"height":35},{"text":"서버","x":417,"y":1678,"width":60,"height":36},{"text":"모두에","x":494,"y":1678,"width":91,"height":36},{"text":"유지될","x":601,"y":1678,"width":91,"height":36},{"text":"수","x":707,"y":1679,"width":32,"height":35},{"text":"있다.","x":753,"y":1679,"width":66,"height":35},{"text":"만약","x":835,"y":1680,"width":61,"height":35},{"text":"서버와","x":908,"y":1680,"width":92,"height":36},{"text":"클라이언트가","x":1010,"y":1679,"width":184,"height":37},{"text":"현재의","x":1207,"y":1678,"width":89,"height":36},{"text":"활동,","x":1312,"y":1679,"width":71,"height":35},{"text":"열린","x":1401,"y":1680,"width":60,"height":34},{"text":"파","x":1476,"y":1681,"width":34,"height":35}]},{"text":"일을 알고 있다면 오류로부터 무리 없이 복구될 수 있다. 서버에 오류가 발생하고, 서버","words":[{"text":"일을","x":277,"y":1738,"width":62,"height":34},{"text":"알고","x":353,"y":1738,"width":63,"height":34},{"text":"있다면","x":433,"y":1738,"width":92,"height":36},{"text":"오류로부터","x":539,"y":1738,"width":151,"height":36},{"text":"무리","x":707,"y":1739,"width":58,"height":35},{"text":"없이","x":784,"y":1739,"width":55,"height":36},{"text":"복구될","x":855,"y":1740,"width":89,"height":35},{"text":"수","x":958,"y":1740,"width":32,"height":35},{"text":"있다.","x":1004,"y":1739,"width":64,"height":36},{"text":"서버에","x":1083,"y":1739,"width":89,"height":36},{"text":"오류가","x":1186,"y":1739,"width":95,"height":35},{"text":"발생하고,","x":1293,"y":1738,"width":136,"height":37},{"text":"서버","x":1445,"y":1740,"width":60,"height":36}]},{"text":"가 자신이 파일 시스템을 수출(export)하였고, 그것이 원격으로 마운트되었고, 몇몇 파","words":[{"text":"가","x":275,"y":1797,"width":33,"height":35},{"text":"자신이","x":321