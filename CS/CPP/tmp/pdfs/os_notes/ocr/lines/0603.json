":"파일이","x":733,"y":957,"width":88,"height":35},{"text":"열려있다.","x":838,"y":957,"width":124,"height":36},{"text":"클라이언트는","x":976,"y":957,"width":181,"height":36},{"text":"가능한","x":1169,"y":958,"width":94,"height":36},{"text":"여러","x":1275,"y":957,"width":57,"height":37},{"text":"작업","x":1348,"y":955,"width":60,"height":37},{"text":"중,","x":1424,"y":957,"width":40,"height":35},{"text":"파","x":1478,"y":956,"width":34,"height":35}]},{"text":"일을 열기 위해 디렉터리 검색을 실행하고 파일에 데이터를 읽거나 쓰며, 파일을 닫는","words":[{"text":"일을","x":277,"y":1017,"width":63,"height":34},{"text":"열기","x":358,"y":1017,"width":58,"height":36},{"text":"위해","x":438,"y":1017,"width":60,"height":36},{"text":"디렉터리","x":517,"y":1017,"width":121,"height":36},{"text":"검색을","x":658,"y":1017,"width":91,"height":36},{"text":"실행하고","x":764,"y":1017,"width":121,"height":37},{"text":"파일에","x":899,"y":1018,"width":88,"height":36},{"text":"데이터를","x":1005,"y":1018,"width":119,"height":36},{"text":"읽거나","x":1141,"y":1018,"width":91,"height":36},{"text":"쓰며,","x":1246,"y":1018,"width":70,"height":36},{"text":"파일을","x":1333,"y":1016,"width":98,"height":36},{"text":"닫는","x":1446,"y":1016,"width":66,"height":35}]},{"text":"다. 이제 서버의 고장 또는 서버의 예정된 시스템 종료에 의해 원격 파일 시스템을 더 이","words":[{"text":"다.","x":274,"y":1077,"width":39,"height":35},{"text":"이제","x":330,"y":1077,"width":61,"height":35},{"text":"서버의","x":407,"y":1077,"width":92,"height":37},{"text":"고장","x":515,"y":1077,"width":64,"height":36},{"text":"또는","x":590,"y":1080,"width":63,"height":32},{"text":"서버의","x":665,"y":1078,"width":88,"height":36},{"text":"예정된","x":769,"y":1078,"width":89,"height":36},{"text":"시스템","x":872,"y":1078,"width":86,"height":36},{"text":"종료에","x":972,"y":1078,"width":88,"height":37},{"text":"의해","x":1075,"y":1078,"width":57,"height":36},{"text":"원격","x":1147,"y":1078,"width":56,"height":36},{"text":"파일","x":1219,"y":1079,"width":60,"height":36},{"text":"시스템을","x":1294,"y":1076,"width":128,"height":38},{"text":"더","x":1436,"y":1076,"width":26,"height":36},{"text":"이","x":1481,"y":1076,"width":27,"height":36}]},{"text":"상 시용할 수 없는 상황, 즉 네트워크에 파티션이 발생한 상황을 생각해 보자. 이 시나리","words":[{"text":"상","x":273,"y":1137,"width":34,"height":36},{"text":"시용할","x":318,"y":1137,"width":100,"height":36},{"text":"수","x":429,"y":1138,"width":33,"height":36},{"text":"없는","x":477,"y":1138,"width":61,"height":36},{"text":"상황,","x":550,"y":1138,"width":70,"height":37},{"text":"즉","x":633,"y":1140,"width":31,"height":34},{"text":"네트워크에","x":678,"y":1138,"width":149,"height":37},{"text":"파티션이","x":842,"y":1139,"width":117,"height":36},{"text":"발생한","x":975,"y":1139,"width":91,"height":36},{"text":"상황을","x":1076,"y":1139,"width":92,"height":36},{"text":"생각해","x":1179,"y":1139,"width":91,"height":36},{"text":"보자.","x":1284,"y":1138,"width":70,"height":36},{"text":"이","x":1371,"y":1137,"width":26,"height":36},{"text":"시나리","x":1414,"y":1137,"width":95,"height":36}]},{"text":"오는 일반적이며 클라이언트가 로컬 파일 시스템을 분실한 경우처럼 대처하는 것은 적","words":[{"text":"오는","x":273,"y":1199,"width":66,"height":33},{"text":"일반적이며","x":356,"y":1198,"width":156,"height":37},{"text":"클라이언트가","x":530,"y":1199,"width":189,"height":36},{"text":"로컬","x":732,"y":1199,"width":59,"height":35},{"text":"파일","x":808,"y":1200,"width":59,"height":36},{"text":"시스템을","x":883,"y":1200,"width":120,"height":35},{"text":"분실한","x":1016,"y":1200,"width":91,"height":35},{"text":"경우처럼","x":1122,"y":1200,"width":118,"height":36},{"text":"대처하는","x":1260,"y":1200,"width":125,"height":36},{"text":"것은","x":1401,"y":1197,"width":65,"height":37},{"text":"적","x":1481,"y":1198,"width":28,"height":36}]},{"text":"절하지 않다. 오히려, 시스템은 분실된 서버에 대한 모든 작업을 종료하거나 다시 서버가","words":[{"text":"절하지","x":275,"y":1258,"width":92,"height":36},{"text":"않다.","x":384,"y":1259,"width":71,"height":36},{"text":"오히려,","x":469,"y":1259,"width":103,"height":37},{"text":"시스템은","x":586,"y":1260,"width":125,"height":35},{"text":"분실된","x":720,"y":1260,"width":92,"height":35},{"text":"서버에","x":825,"y":1261,"width":88,"height":36},{"text":