width":94,"height":36},{"text":"중재를","x":463,"y":414,"width":94,"height":36},{"text":"필요하기|","x":570,"y":413,"width":117,"height":37},{"text":"된다.","x":702,"y":414,"width":63,"height":36}]},{"text":"원격 파일 시스템은 더 많은 오류 가능성을 가지고 있다. 네트워크 시스템의 복잡성","words":[{"text":"원격","x":339,"y":473,"width":61,"height":36},{"text":"파일","x":417,"y":473,"width":61,"height":37},{"text":"시스템은","x":495,"y":474,"width":124,"height":35},{"text":"더","x":632,"y":473,"width":24,"height":37},{"text":"많은","x":673,"y":474,"width":58,"height":36},{"text":"오류","x":744,"y":476,"width":58,"height":35},{"text":"가능성을","x":816,"y":473,"width":118,"height":37},{"text":"가지고","x":947,"y":475,"width":91,"height":35},{"text":"있다.","x":1053,"y":474,"width":66,"height":37},{"text":"네트워크","x":1136,"y":475,"width":125,"height":36},{"text":"시스템의","x":1275,"y":473,"width":125,"height":37},{"text":"복잡성","x":1416,"y":472,"width":95,"height":36}]},{"text":"과 원격 시스템 간에 요구되는 상호작동으로 인해 많은 문제가 원격 파일 시스템의 적절","words":[{"text":"과","x":277,"y":534,"width":33,"height":36},{"text":"원격","x":324,"y":534,"width":59,"height":35},{"text":"시스템","x":402,"y":534,"width":91,"height":36},{"text":"간에","x":509,"y":534,"width":59,"height":36},{"text":"요구되는","x":583,"y":534,"width":121,"height":36},{"text":"상호작동으로","x":715,"y":534,"width":178,"height":37},{"text":"인해","x":907,"y":534,"width":56,"height":37},{"text":"많은","x":978,"y":535,"width":61,"height":36},{"text":"문제가","x":1050,"y":535,"width":94,"height":36},{"text":"원격","x":1157,"y":535,"width":57,"height":36},{"text":"파일","x":1230,"y":535,"width":61,"height":36},{"text":"시스템의","x":1307,"y":533,"width":126,"height":37},{"text":"적절","x":1451,"y":532,"width":61,"height":35}]},{"text":"한 연산을 방해한다. 네트워크의 경우 네트워크 오류가 두 호스트 간에 발생할 수도 있","words":[{"text":"한","x":277,"y":595,"width":34,"height":34},{"text":"연산을","x":327,"y":594,"width":95,"height":35},{"text":"방해한다.","x":438,"y":594,"width":131,"height":36},{"text":"네트워크의","x":588,"y":594,"width":146,"height":36},{"text":"경우","x":752,"y":59