{"page":217,"width":1830,"height":2810,"text_angle":0,"lines":[{"text":"5.8 알고리좀의 평가 271","words":[{"text":"5.8","x":1235,"y":163,"width":58,"height":24},{"text":"알고리좀의","x":1310,"y":162,"width":120,"height":29},{"text":"평가","x":1442,"y":162,"width":48,"height":28},{"text":"271","x":1566,"y":157,"width":56,"height":32}]},{"text":"프로세스 Pt을 위한 대기 시간은 0밀리초, 프로세스 P2를 위한 대기 시간은 32밀리초,","words":[{"text":"프로세스","x":308,"y":302,"width":131,"height":39},{"text":"Pt을","x":455,"y":302,"width":68,"height":43},{"text":"위한","x":540,"y":304,"width":63,"height":38},{"text":"대기","x":620,"y":304,"width":58,"height":39},{"text":"시간은","x":699,"y":304,"width":96,"height":39},{"text":"0밀리초,","x":810,"y":302,"width":127,"height":40},{"text":"프로세스","x":955,"y":301,"width":135,"height":39},{"text":"P2를","x":1106,"y":302,"width":70,"height":42},{"text":"위한","x":1193,"y":300,"width":66,"height":39},{"text":"대기","x":1276,"y":299,"width":62,"height":41},{"text":"시간은","x":1360,"y":299,"width":102,"height":40},{"text":"32밀리초,","x":1477,"y":300,"width":152,"height":42}]},{"text":"프로세스 P3는 20밀리초, 프로세스 터는 23밀리초, 프로세스 라는 40밀리초이다. 그러","words":[{"text":"프로세스","x":308,"y":366,"width":132,"height":39},{"text":"P3는","x":455,"y":368,"width":68,"height":42},{"text":"20밀리초,","x":537,"y":368,"width":143,"height":38},{"text":"프로세스","x":696,"y":367,"width":129,"height":39},{"text":"터는","x":840,"y":368,"width":70,"height":41},{"text":"23밀리초,","x":924,"y":366,"width":149,"height":41},{"text":"프로세스","x":1090,"y":366,"width":134,"height":39},{"text":"라는","x":1238,"y":368,"width":72,"height":42},{"text":"40밀리초이다.","x":1324,"y":365,"width":220,"height":40},{"text":"그러","x":1561,"y":367,"width":65,"height":38}]},{"text":"므로 평균대기 시간은 (0 + 32 + 20 + 23 + 40)/5 = 23밀리초이다.","words":[{"text":"므로","x":309,"y":433,"width":65,"height":30},{"text":"평균대기","x":389,"y":430,"width":125,"height":39},{"text":"시간은","x":532,"y":431,"width":95,"height":39},{"text":"(0","x":637,"y":432,"width":29,"height":38},{"text":"+","x":680,"y":440,"width":20,"height":22},{"text":"32","x":714,"y":432,"width":37,"height":31},{"text":"+","x":764,"y":440,"width":20,"height":22},{"text":"20","x":798,"y":432,"width":37,"height":31},{"text":"+","x":850,"y":440,"width":19,"height":22},{"text":"23","x":884,"y":433,"width":37,"height":31},{"text":"+","x":933,"y":440,"width":21,"height":23},{"text":"40)/5","x":965,"y":433,"width":94,"height":39},{"text":"=","x":1071,"y":446,"width":21,"height":13},{"text":"23밀리초이다.","x":1103,"y":431,"width":213,"height":40}]},{"text":"이 경우, SJF 정책의 평균대기 시간은 선입 선처리 스게줄링으로 얻은 평균대기 시","words":[{"text":"이","x":372,"y":494,"width":28,"height":39},{"text":"경우,","x":421,"y":494,"width":71,"height":40},{"text":"SJF","x":507,"y":498,"width":52,"height":38},{"text":"정책의","x":576,"y":496,"width":93,"height":39},{"text":"평균대기","x":688,"y":496,"width":125,"height":39},{"text":"시간은","x":834,"y":496,"width":97,"height":38},{"text":"선입","x":947,"y":496,"width":61,"height":39},{"text":"선처리","x":1029,"y":497,"width":94,"height":39},{"text":"스게줄링으로","x":1142,"y":496,"width":203,"height":39},{"text":"얻은","x":1363,"y":497,"width":67,"height":38},{"text":"평균대기","x":1446,"y":495,"width":132,"height":41},{"text":"시","x":1598,"y":495,"width":30,"height":39}]},{"text":"간의 1/2보다 작다. 라운드 로빈 알고리즘은 중간 정도이다.","words":[{"text":"간의","x":309,"y":558,"width":63,"height":39},{"text":"1/2보다","x":388,"y":559,"width":127,"height":38},{"text":"작다.","x":527,"y":560,"width":72,"height":38},{"text":"라운드","x":615,"y":560,"width":95,"height":38},{"text":"로빈","x":722,"y":560,"width":64,"height":38},{"text":"알고리즘은","x":800,"y":560,"width":165,"height":39},{"text":"중간","x":978,"y":561,"width":67,"height":39},{"text":"정도이다.","x":1058,"y":561,"width":139,"height":40}]},{"text":"결정론적 모델링은 단순하고 빠르다. 이것은 알고리즘 들 을 비교할 수 있도록 정확한","words":[{"text":"결정론적","x":373,"y":622,"width":127,"height":39},{"text":"모델링은","x":517,"y":624,"width":131,"height":38},{"text":"단순하고","x":660,"y":624,"width":130,"height":39},{"text":"빠르다.","x":804,"y":624,"width":105,"height":39},{"text":"이것은","x":925,"y":625,"width":99,"height":39},{"text":"알고리즘","x":1038,"y":626,"width":128,"height":39},{"text":"들","x":1176,"y":626,"width":22,"height":38},{"text":"을","x":1210,"y":626,"width":22,"height":38},{"text":"비교할","x":1252,"y":625,"width":100,"height":39},{"text":"수","x":1365,"y":626,"width":35,"height":38},{"text":"있도록","x":1415,"y":626,"width":100,"height":39},{"text":"정확한","x":1529,"y":625,"width":103,"height":40}]},{"text":"값을 제공한다. 그러나 이것은 입력으로 정확한 숫자를 요구하며, 그 응답도 단지 이들","words":[{"text":"값을","x":309,"y":686,"width":66,"height":38},{"text":"제공한다.","x":391,"y":686,"width":139,"height":39},{"text":"그러나","x":547,"y":688,"width":99,"height":38},{"text":"이것은","x":662,"y":688,"width":97,"height":38},{"text":"입력으로","x":776,"y":688,"width":130,"height":39},{"text":"정확한","x":923,"y":689,"width":99,"height":39},{"text":"숫자를","x":1035,"y":690,"width":101,"height":38},{"text":"요구하며,","x":1152,"y":689,"width":141,"height":39},{"text":"그","x":1311,"y":694,"width":33,"height":27},{"text":"응답도","x":1360,"y":690,"width":103,"height":38},{"text":"단지","x":1478,"y":691,"width":65,"height":38},{"text":"이들","x":1564,"y":691,"width":67,"height":39}]},{"text":"의 경우에만 적용된다. 결정론적 모델링은 주로 스케줄링 알고리즘을 설명하고, 예를 제","words":[{"text":"의","x":308,"y":750,"width":29,"height":39},{"text":"경우에만","x":355,"y":750,"width":133,"height":38},{"text":"적용된다.","x":502,"y":750,"width":137,"height":39},{"text":"결정론적","x":656,"y":751,"width":127,"height":39},{"text":"모델링은","x":800,"y":753,"width":133,"height":38},{"text":"주로","x":945,"y":755,"width":67,"height":36},{"text":"스케줄링","x":1025,"y":754,"width":129,"height":38},{"text":"알고리즘을","x":1173,"y":753,"width":168,"height":39},{"text":"설명하고,","x":1356,"y":754,"width":144,"height":40},{"text":"예를","x":1516,"y":755,"width":67,"height":39},{"text":"제","x":1597,"y":757,"width":30,"height":38}]},{"text":"공하는 데 사\u0026한다. 동일한 프로그램을 반복해 여러 번 실행하고, 프로그램의 처리 요구","words":[{"text":"공하는","x":306,"y":814,"width":102,"height":38},{"text":"데","x":421,"y":813,"width":28,"height":38},{"text":"사\u0026한다.","x":464,"y":814,"width":139,"height":39},{"text":"동일한","x":617,"y":814,"width":101,"height":38},{"text":"프로그램을","x":729,"y":816,"width":166,"height":38},{"text":"반복해","x":908,"y":818,"width":96,"height":38},{"text":"여러","x":1020,"y":818,"width":61,"height":38},{"text":"번","x":1099,"y":818,"width":30,"height":37},{"text":"실행하고,","x":1144,"y":818,"width":141,"height":38},{"text":"프로그램의","x":1299,"y":818,"width":167,"height":39},{"text":"처리","x":1484,"y":819,"width":61,"height":39},{"text":"요구","x":1561,"y":822,"width":69,"height":37}]},{"text":"사항들을 정확하게 측정할 수 있는 경유 우리는 스케줄링 알고리즘을 선택하기 위해 결","words":[{"text":"사항들을","x":306,"y":877,"width":134,"height":39},{"text":"정확하게","x":454,"y":878,"width":129,"height":38},{"text":"측정할","x":598,"y":878,"width":100,"height":38},{"text":"수","x":710,"y":878,"width":34,"height":38},{"text":"있는","x":759,"y":879,"width":64,"height":38},{"text":"경유","x":838,"y":880,"width":74,"height":40},{"text":"우리는","x":924,"y":881,"width":100,"height":39},{"text":"스케줄링","x":1037,"y":881,"width":129,"height":39},{"text":"알고리즘을","x":1184,"y":881,"width":169,"height":38},{"text":"선택하기","x":1368,"y":882,"width":130,"height":39},{"text":"위해","x":1517,"y":883,"width":63,"height":38},{"text":"결","x":1598,"y":884,"width":30,"height":37}]},{"text":"정론적 모델링을 사용할 수 있다. 게다가 결정론적 모델링은 예들의 집합에 대해, 별도로","words":[{"text":"정론적","x":307,"y":941,"width":95,"height":38},{"text":"모델링을","x":417,"y":941,"width":135,"height":39},{"text":"사용할","x":563,"y":942,"width":100,"height":38},{"text":"수","x":674,"y":942,"width":34,"height":37},{"text":"있다.","x":722,"y":942,"width":70,"height":39},{"text":"게다가","x":809,"y":943,"width":99,"height":39},{"text":"결정론적","x":921,"y":945,"width":128,"height":38},{"text":"모델링은","x":1065,"y":945,"width":134,"height":38},{"text":"예들의","x":1212,"y":945,"width":96,"height":37},{"text":"집합에","x":1326,"y":945,"width":98,"height":38},{"text":"대해,","x":1441,"y":946,"width":75,"height":38},{"text":"별도로","x":1531,"y":946,"width":100,"height":37}]},{"text":"분석하고 증명할 수 있는 경향들을 나타낼 수 있다. 예를 들어, 기술된 환경에 대해(모든","words":[{"text":"분석하고","x":304,"y":1005,"width":135,"height":39},{"text":"증명할","x":451,"y":1006,"width":101,"height":38},{"text":"수","x":563,"y":1006,"width":34,"height":38},{"text":"있는","x":612,"y":1006,"width":64,"height":38},{"text":"경향들을","x":690,"y":1006,"width":133,"height":38},{"text":"나타낼","x":835,"y":1007,"width":98,"height":38},{"text":"수","x":947,"y":1009,"width":34,"height":37},{"text":"있다.","x":996,"y":1008,"width":70,"height":39},{"text":"예를","x":1083,"y":1008,"width":67,"height":38},{"text":"들어,","x":1162,"y":1008,"width":76,"height":38},{"text":"기술된","x":1254,"y":1008,"width":99,"height":38},{"text":"환경에","x":1367,"y":1009,"width":100,"height":38},{"text":"대해(모든","x":1485,"y":1008,"width":146,"height":41}]},{"text":"프로세스들과 이들의 시간이 시간 0에 알 수 있을 때), SJF 정책은 항상 대기 시간을 최","words":[{"text":"프로세스들과","x":304,"y":1070,"width":202,"height":38},{"text":"이들의","x":521,"y":1070,"width":93,"height":39},{"text":"시간이","x":632,"y":1069,"width":95,"height":40},{"text":"시간","x":745,"y":1070,"width":67,"height":39},{"text":"0에","x":825,"y":1071,"width":50,"height":38},{"text":"알","x":892,"y":1072,"width":33,"height":37},{"text":"수","x":937,"y":1072,"width":35,"height":38},{"text":"있을","x":987,"y":1072,"width":66,"height":38},{"text":"때),","x":1067,"y":1072,"width":53,"height":40},{"text":"SJF","x":1135,"y":1074,"width":54,"height":37},{"text":"정책은","x":1205,"y":1071,"width":101,"height":37},{"text":"항상","x":1319,"y":1072,"width":69,"height":37},{"text":"대기","x":1402,"y":1072,"width":62,"height":38},{"text":"시간을","x":1484,"y":1072,"width":101,"height":37},{"text":"최","x":1600,"y":1073,"width":29,"height":37}]},{"text":"소화한다.","words":[{"text":"소화한다.","x":304,"y":1134,"width":141,"height":39}]},{"text":"5.8.2 큐잉 모밀 Queueing Mode1s","words":[{"text":"5.8.2","x":304,"y":1254,"width":125,"height":33},{"text":"큐잉","x":472,"y":1254,"width":62,"height":35},{"text":"모밀","x":545,"y":1254,"width":62,"height":34},{"text":"Queueing","x":634,"y":1263,"width":148,"height":28},{"text":"Mode1s","x":792,"y":1263,"width":113,"height":23}]},{"text":"많은 시스템에서 실행되는 프로세스들은 날마다 변화하기 때문에, 결정론적 모델링을 사","words":[{"text":"많은","x":304,"y":1333,"width":66,"height":38},{"text":"시스템에서","x":382,"y":1332,"width":163,"height":39},{"text":"실행되는","x":561,"y":1332,"width":133,"height":39},{"text":"프로세스들은","x":705,"y":1332,"width":202,"height":39},{"text":"날마다","x":919,"y":1332,"width":101,"height":39},{"text":"변화하기","x":1033,"y":1331,"width":130,"height":39},{"text":"때문에,","x":1180,"y":1331,"width":108,"height":39},{"text":"결정론적","x":1304,"y":1331,"width":130,"height":38},{"text":"모델링을","x":1449,"y":1331,"width":137,"height":40},{"text":"사","x":1598,"y":1334,"width":36,"height":40}]},{"text":"용할 수 있는 프로세스들(그리고 시간)의 정적인 집합이 없다. 그러나 결정할 수 있는 것","words":[{"text":"용할","x":302,"y":1397,"width":68,"height":38},{"text":"수","x":381,"y":1396,"width":34,"height":39},{"text":"있는","x":429,"y":1396,"width":65,"height":39},{"text":"프로세스들(그리고","x":506,"y":1397,"width":280,"height":42},{"text":"시간)의","x":799,"y":1397,"width":110,"height":42},{"text":"정적인","x":926,"y":1397,"width":100,"height":39},{"text":"집합이","x":1040,"y":1396,"width":96,"height":39},{"text":"없다.","x":1155,"y":1396,"width":72,"height":38},{"text":"그러나","x":1242,"y":1396,"width":102,"height":39},{"text":"결정할","x":1358,"y":1396,"width":101,"height":38},{"text":"수","x":1469,"y":1396,"width":35,"height":38},{"text":"있는","x":1519,"y":1397,"width":67,"height":39},{"text":"것","x":1599,"y":1400,"width":31,"height":39}]},{"text":"은 CPU와 I/O 버스트의 분포이다. 이들의 분포는 측정할 수 있으며 그런 후에 근삿값","words":[{"text":"은","x":300,"y":1462,"width":35,"height":36},{"text":"CPU와","x":348,"y":1461,"width":115,"height":38},{"text":"I/O","x":475,"y":1464,"width":66,"height":35},{"text":"버스트의","x":557,"y":1461,"width":128,"height":39},{"text":"분포이다.","x":701,"y":1461,"width":142,"height":39},{"text":"이들의","x":861,"y":1462,"width":