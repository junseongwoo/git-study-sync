th":103,"height":39},{"text":"얻게","x":449,"y":610,"width":62,"height":38},{"text":"된다.","x":527,"y":611,"width":72,"height":39}]},{"text":"다른 형태의 클러스터로 병* 클러스터와 WAN을 이용한 클러스터링","words":[{"text":"다른","x":350,"y":675,"width":68,"height":38},{"text":"형태의","x":436,"y":674,"width":98,"height":39},{"text":"클러스터로","x":553,"y":675,"width":169,"height":39},{"text":"병*","x":741,"y":674,"width":225,"height":45},{"text":"클러스터와","x":986,"y":675,"width":176,"height":40},{"text":"WAN을","x":1178,"y":677,"width":142,"height":37},{"text":"이용한","x":1339,"y":677,"width":110,"height":38},{"text":"클러스터링","x":1466,"y":678,"width":176,"height":40}]},{"text":"이 있다. 병렬 클러스터는 여러 호스트가 공유 저장장치상의 동일한 데이터에 접근할 수","words":[{"text":"이","x":287,"y":738,"width":28,"height":39},{"text":"있다.","x":334,"y":738,"width":73,"height":40},{"text":"병렬","x":424,"y":738,"width":63,"height":39},{"text":"클러스터는","x":502,"y":739,"width":167,"height":39},{"text":"여러","x":682,"y":739,"width":62,"height":39},{"text":"호스트가","x":761,"y":738,"width":136,"height":39},{"text":"공유","x":908,"y":739,"width":69,"height":38},{"text":"저장장치상의","x":992,"y":738,"width":202,"height":41},{"text":"동일한","x":1210,"y":741,"width":109,"height":38},{"text":"데이터에","x":1333,"y":741,"width":141,"height":38},{"text":"접근할","x":1493,"y":742,"width":108,"height":37},{"text":"수","x":1613,"y":744,"width":34,"height":38}]},{"text":"있게 한다. 운영체제의 대부분이 여러 호스트에 의한 이러한 동시 접근을 지원하지 않","words":[{"text":"있게","x":287,"y":802,"width":63,"height":39},{"text":"한다.","x":368,"y":802,"width":75,"height":38},{"text":"운영체제의","x":461,"y":802,"width":163,"height":41},{"text":"대부분이","x":645,"y":803,"width":128,"height":40},{"text":"여러","x":795,"y":802,"width":62,"height":40},{"text":"호스트에","x":877,"y":803,"width":133,"height":39},{"text":"의한","x":1030,"y":803,"width":69,"height":39},{"text":"이러한","x":1116,"y":805,"width":105,"height":39},{"text":"동시","x":1235,"y":806,"width":69,"height":38},{"text":"접근을","x":1327,"y":805,"width":108,"height":39},{"text":"지원하지","x":1452,"y":805,"width":140,"height":40},{"text":"않","x":1615,"y":808,"width":32,"height":39}]},{"text":"뜨므로 병렬 클러스터는 특수 소프트웨어 버전과 특별히 발매된 우우으로 달성된다. 예","words":[{"text":"뜨므로","x":284,"y":869,"width":101,"height":30},{"text":"병렬","x":401,"y":866,"width":63,"height":39},{"text":"클러스터는","x":480,"y":867,"width":168,"height":40},{"text":"특수","x":661,"y":869,"width":67,"height":38},{"text":"소프트웨어","x":742,"y":867,"width":165,"height":40},{"text":"버전과","x":927,"y":868,"width":102,"height":38},{"text":"특별히","x":1041,"y":869,"width":101,"height":39},{"text":"발매된","x":1162,"y":870,"width":104,"height":38},{"text":"우우으로","x":1282,"y":870,"width":145,"height":39},{"text":"달성된다.","x":1443,"y":869,"width":152,"height":40},{"text":"예","x":1615,"y":873,"width":28,"height":39}]},{"text":"를 들면, Oracle Real Application Cluster는 병렬 클러스터에서 수행하도록 설계된","words":[{"text":"를","x":282,"y":933,"width":35,"height":37},{"text":"들면,","x":330,"y":931,"width":76,"height":40},{"text":"Oracle","x":421,"y":934,"width":112,"height":33},{"text":"Real","x":548,"y":936,"width":73,"height":31},{"text":"Application","x":635,"y":936,"width":204,"height":42},{"text":"Cluster는","x":854,"y":934,"width":162,"height":36},{"text":"병렬","x":1033,"y":933,"width":64,"height":38},{"text":"클러스터에서","x":1115,"y":934,"width":209,"height":40},{"text":"수행하도록","x":1344,"y":935,"width":183,"height":39},{"text":"설계된","x":1543,"y":936,"width":102,"height":39}]},{"text":"Oracle의 데이터베이스 버전이다. 각 기계는 Oracle을 수행하고 하나의 소프트웨어 층","words":[{"text":"Oracle의","x":281,"y":997,"width":144,"height":39},{"text":"데이터베이스","x":443,"y":997,"width":198,"height":41},{"text":"버전이다.","x":656,"y":997,"width":140,"height":40},{"text":"각","x":813,"y":998,"width":34,"height":38},{"text":"기계는","x":862,"y":997,"width":101,"height":39},{"text":"Oracle을","x":975,"y":999,"width":151,"height":37},{"text":"수행하고","x":1138,"y":999,"width":143,"height":39},{"text":"하나의","x":1295,"y":1000,"width":104,"height":38},{"text":"소프트웨어","x":1417,"y":1000,"width":178,"height":39},{"text":"층","x":1612,"y":1002,"width":34,"height":38}]},{"text":"이 공우 디스크에 대한 접근을 관리한다. 각 기계는 데이터베이스 내의 모든 데이터에","words":[{"text":"이","x":283,"y":1063,"width":29,"height":39},{"text":"공우","x":330,"y":1063,"width":69,"height":39},{"text":"디스크에","x":415,"y":1062,"width":130,"height":40},{"text":"대한","x":565,"y":1063,"width":66,"height":39},{"text":"접근을","x":648,"y":1063,"width":99,"height":38},{"text":"관리한다.","x":761,"y":1062,"width":145,"height":39},{"text":"각","x":925,"y":1062,"width":35,"height":38},{"text":"기계는","x":977,"y":1061,"width":102,"height":39},{"text":"데이터베이스","x":1096,"y":1063,"width":212,"height":39},{"text":"내의","x":1326,"y":1065,"width":67,"height":38},{"text":"모든","x":1413,"y":1066,"width":75,"height":36},{"text":"데이터에","x":1506,"y":1064,"width":137,"height":41}]},{"text":"대한 완전한 접근을 한다. 데이터에 대한 공유 접근을 제공하기 위하여, 시스템은 접근","words":[{"text":"대한","x":282,"y":1127,"width":67,"height":39},{"text":"완전한","x":362,"y":1127,"width":103,"height":39},{"text":"접근을","x":480,"y":1128,"width":99,"height":38},{"text":"한다.","x":592,"y":1127,"width":75,"height":39},{"text":"데이터에","x":685,"y":1127,"width":132,"height":38},{"text":"대한","x":837,"y":1127,"width":68,"height":39},{"text":"공유","x":918,"y":1126,"width":69,"height":39},{"text":"접근을","x":1004,"y":1126,"width":103,"height":38},{"text":"제공하기","x":1123,"y":1128,"width":136,"height":39},{"text":"위하여,","x":1282,"y":1129,"width":115,"height":39},{"text":"시스템은","x":1416,"y":1129,"width":146,"height":39},{"text":"접근","x":1578,"y":1130,"width":68,"height":38}]},{"text":"간의 충돌이 발생하지 않는 것을 보장하기 위하여 접근 제어와 잠금 기법을 제공해야 한","words":[{"text":"간의","x":281,"y":1192,"width":62,"height":39},{"text":"충돌이","x":358,"y":1192,"width":98,"height":40},{"text":"발생하지","x":472,"y":1192,"width":130,"height":40},{"text":"않는","x":619,"y":1192,"width":67,"height":39},{"text":"것을","x":698,"y":1192,"width":68,"height":38},{"text":"보장하기","x":778,"y":1191,"width":132,"height":39},{"text":"위하여","x":928,"y":1190,"width":98,"height":40},{"text":"접근","x"