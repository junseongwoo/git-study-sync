"x":1031,"y":1481,"width":116,"height":36},{"text":"파일","x":1163,"y":1482,"width":61,"height":35},{"text":"시스템의","x":1237,"y":1481,"width":121,"height":36},{"text":"유형을","x":1374,"y":1480,"width":97,"height":36},{"text":"결","x":1485,"y":1480,"width":29,"height":35}]},{"text":"정한다. 일반적으로 마운트 포인트는 마운트되는 파일 시스템이 부작될 비어있는 디렉터","words":[{"text":"정한다.","x":294,"y":1539,"width":102,"height":36},{"text":"일반적으로","x":413,"y":1539,"width":155,"height":36},{"text":"마운트","x":580,"y":1540,"width":92,"height":35},{"text":"포인트는","x":682,"y":1540,"width":123,"height":34},{"text":"마운트되는","x":814,"y":1540,"width":151,"height":35},{"text":"파일","x":976,"y":1540,"width":58,"height":35},{"text":"시스템이","x":1046,"y":1540,"width":119,"height":36},{"text":"부작될","x":1178,"y":1542,"width":93,"height":34},{"text":"비어있는","x":1285,"y":1540,"width":123,"height":36},{"text":"디렉터","x":1421,"y":1539,"width":91,"height":36}]},{"text":"리이다. 예를 들어, UNIX 시스템에서는 사우자의 홈디렉터리를 포함하는 파일 시스템","words":[{"text":"리이다.","x":295,"y":1597,"width":101,"height":35},{"text":"예를","x":414,"y":1598,"width":63,"height":34},{"text":"들어,","x":489,"y":1599,"width":71,"height":35},{"text":"UNIX","x":574,"y":1602,"width":93,"height":28},{"text":"시스템에서는","x":681,"y":1599,"width":182,"height":35},{"text":"사우자의","x":875,"y":1599,"width":117,"height":35},{"text":"홈디렉터리를","x":1008,"y":1599,"width":184,"height":35},{"text":"포함하는","x":1205,"y":1600,"width":125,"height":35},{"text":"파일","x":1343,"y":1599,"width":61,"height":34},{"text":"시스템","x":1420,"y":1599,"width":93,"height":34}]},{"text":"이 /home으로 마운트되면, /home을 앞에 붙여 /home/jane처럼 그 파일 시스템 내의","words":[{"text":"이","x":294,"y":1656,"width":27,"height":35},{"text":"/home으로","x":339,"y":1659,"width":160,"height":29},{"text":"마운트되면,","x":512,"y":1657,"width":162,"height":36},{"text":"/home을","x":689,"y":1657,"width":122,"height":34},{"text":"앞에","x":823,"y":1658,"width":57,"height":35},{"text":"붙여","x":894,"y":1658,"width":57,"height":35},{"text":"/home/jane처럼","x":967,"y":1658,"width":