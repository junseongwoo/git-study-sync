":"NRAM","x":1566,"y":1230,"width":130,"height":33}]},{"text":"및 SSD이다. 전기적 저장장치를 NVM으로 언급될 것이다. 특정 유형의 전기적","words":[{"text":"및","x":411,"y":1303,"width":30,"height":39},{"text":"SSD이다.","x":458,"y":1302,"width":148,"height":40},{"text":"전기적","x":627,"y":1302,"width":100,"height":40},{"text":"저장장치를","x":749,"y":1302,"width":176,"height":40},{"text":"NVM으로","x":940,"y":1305,"width":177,"height":31},{"text":"언급될","x":1135,"y":1300,"width":101,"height":39},{"text":"것이다.","x":1254,"y":1299,"width":111,"height":40},{"text":"특정","x":1383,"y":1298,"width":67,"height":40},{"text":"유형의","x":1470,"y":1296,"width":103,"height":40},{"text":"전기적","x":1593,"y":1293,"width":99,"height":40}]},{"text":"저장장치(예: SSD)를 강조해야 하는 경우 명시적으로 그 용어를 사용할 것이다.","words":[{"text":"저장장치(예:","x":412,"y":1369,"width":190,"height":42},{"text":"SSD)를","x":616,"y":1371,"width":124,"height":40},{"text":"강조해야","x":753,"y":1369,"width":143,"height":39},{"text":"하는","x":907,"y":1369,"width":73,"height":39},{"text":"경우","x":992,"y":1369,"width":70,"height":39},{"text":"명시적으로","x":1075,"y":1367,"width":173,"height":40},{"text":"그","x":1261,"y":1372,"width":35,"height":26},{"text":"용어를","x":1308,"y":1366,"width":107,"height":40},{"text":"사용할","x":1426,"y":1364,"width":108,"height":41},{"text":"것이다.","x":1547,"y":1362,"width":110,"height":41}]},{"text":"기계적 저장장치는 일반적으로 전기적 저장장치보다 용량이 끄 바이트당 비용이","words":[{"text":"기계적","x":380,"y":1458,"width":96,"height":39},{"text":"저장장치는","x":497,"y":1457,"width":172,"height":40},{"text":"일반적으로","x":688,"y":1457,"width":174,"height":39},{"text":"전기적","x":880,"y":1457,"width":101,"height":39},{"text":"저장장치보다","x":1003,"y":1456,"width":210,"height":40},{"text":"용량이","x":1227,"y":1455,"width":102,"height":40},{"text":"끄","x":1349,"y":1460,"width":70,"height":27},{"text":"바이트당","x":1436,"y":1454,"width":142,"height":40},{"text":"비용이","x":1594,"y":1452,"width":98,"height":42}]},{"text":"저렴하다. 반대로, 전기적 자장장치는 일반적으로 기계적 저장장치보다 비싸고 용량","words":[{"text":"저렴하다.","x":380,"y":1524,"width