{"page":512,"width":1729,"height":2598,"text_angle":0,"lines":[{"text":"12.7 성능","words":[{"text":"12.7","x":1273,"y":156,"width":71,"height":22},{"text":"성능","x":1359,"y":155,"width":46,"height":26}]},{"text":"573","words":[{"text":"573","x":1478,"y":152,"width":60,"height":29}]},{"text":"다. 이 드라이버는 각각의 디스크도 관리하지만 11.8절에서 소개한 RAID 배열도 관리","words":[{"text":"다.","x":296,"y":286,"width":37,"height":36},{"text":"이","x":352,"y":285,"width":26,"height":35},{"text":"드라이버는","x":397,"y":285,"width":155,"height":36},{"text":"각각의","x":566,"y":284,"width":87,"height":36},{"text":"디스크도","x":672,"y":285,"width":116,"height":36},{"text":"관리하지만","x":802,"y":285,"width":153,"height":37},{"text":"11.8절에서","x":970,"y":284,"width":150,"height":36},{"text":"소개한","x":1138,"y":284,"width":98,"height":36},{"text":"RAID","x":1250,"y":288,"width":94,"height":29},{"text":"배열도","x":1361,"y":284,"width":97,"height":36},{"text":"관리","x":1472,"y":285,"width":62,"height":38}]},{"text":"한다. 이러한 일을 하기 위해서 디스크 입출력 요청들은 상호 서로 연관된 디스크 입출","words":[{"text":"한다.","x":295,"y":346,"width":71,"height":36},{"text":"이러한","x":384,"y":345,"width":94,"height":36},{"text":"일을","x":493,"y":345,"width":59,"height":36},{"text":"하기","x":567,"y":345,"width":56,"height":37},{"text":"위해서","x":642,"y":345,"width":84,"height":38},{"text":"디스크","x":745,"y":346,"width":87,"height":35},{"text":"입출력","x":848,"y":347,"width":86,"height":35},{"text":"요청들은","x":952,"y":345,"width":125,"height":37},{"text":"상호","x":1090,"y":345,"width":62,"height":37},{"text":"서로","x":1169,"y":346,"width":63,"height":36},{"text":"연관된","x":1249,"y":345,"width":94,"height":37},{"text":"디스크","x":1361,"y":345,"width":96,"height":37},{"text":"입출","x":1474,"y":346,"width":64,"height":37}]},{"text":"력 연산들로 변환된다. 이에 더하여 여러 가지 오류 관련, 그리고 데이터 복구 알고리즘","words":[{"text":"력","x":298,"y":406,"width":25,"height":35},{"text":"연산들로","x":343,"y":406,"width":125,"height":35},{"text":"변환된다.","x":483,"y":405,"width":128,"height":36},{"text":"이에","x":628,"y":406,"width":56,"height":36},{"text":"더하여","x":701,"y":407,"width":83,"height":36},{"text":"여러","x":802,"y":406,"width":55,"height":37},{"text":"가지","x":875,"y":407,"width":56,"height":36},{"text":"오류","x":947,"y":408,"width":61,"height":34},{"text":"관련,","x":1022,"y":406,"width":70,"height":37},{"text":"그리고","x":1106,"y":406,"width":96,"height":37},{"text":"데이터","x":1217,"y":407,"width":92,"height":37},{"text":"복구","x":1326,"y":408,"width":66,"height":36},{"text":"알고리즘","x":1407,"y":407,"width":132,"height":36}]},{"text":"도 수행되어야 한다. 그리고 디스크 성능이 시스템 전체 성능에 미치는 중요성을 고려하","words":[{"text":"도","x":296,"y":470,"width":32,"height":27},{"text":"수행되어야","x":340,"y":465,"width":160,"height":37},{"text":"한다.","x":512,"y":466,"width":67,"height":35},{"text":"그리고","x":595,"y":467,"width":90,"height":36},{"text":"디스크","x":699,"y":467,"width":87,"height":36},{"text":"성능이","x":800,"y":467,"width":85,"height":37},{"text":"시스템","x":901,"y":467,"width":88,"height":37},{"text":"전체","x":1005,"y":467,"width":57,"height":36},{"text":"성능에","x":1079,"y":467,"width":91,"height":37},{"text":"미치는","x":1186,"y":467,"width":96,"height":37},{"text":"중요성을","x":1294,"y":468,"width":132,"height":37},{"text":"고려하","x":1439,"y":468,"width":100,"height":36}]},{"text":"여 디스크 성능은 여러 단계를 통하여 최적화된다.","words":[{"text":"여","x":298,"y":527,"width":27,"height":35},{"text":"디스크","x":342,"y":526,"width":95,"height":36},{"text":"성능은","x":449,"y":526,"width":93,"height":36},{"text":"여러","x":554,"y":526,"width":57,"height":37},{"text":"단계를","x":626,"y":527,"width":90,"height":37},{"text":"통하여","x":727,"y":529,"width":86,"height":36},{"text":"최적화된다.","x":829,"y":529,"width":156,"height":36}]},{"text":"입출력 기능은 장치 하드웨어, 장치 드라이버, 우% 프로그램 소프트웨어 중 어느 고","words":[{"text":"입출력","x":360,"y":587,"width":90,"height":36},{"text":"기능은","x":468,"y":587,"width":92,"height":37},{"text":"장치","x":572,"y":587,"width":57,"height":37},{"text":"하드웨어,","x":644,"y":588,"width":127,"height":38},{"text":"장치","x":784,"y":589,"width":55,"height":37},{"text":"드라이버,","x":855,"y":590,"width":129,"height":37},{"text":"우%","x":996,"y":589,"width":61,"height":37},{"text":"프로그램","x":1069,"y":589,"width":122,"height":36},{"text":"소프트웨어","x":1207,"y":590,"width":158,"height":36},{"text":"중","x":1381,"y":592,"width":33,"height":35},{"text":"어느","x":1428,"y":590,"width":64,"height":36},{"text":"고","x":1505,"y":592,"width":34,"height":18}]},{"text":"에서 구현되어야 하나? 이 설명은 그림 12.17에 나타나 있다.","words":[{"text":"에서","x":299,"y":649,"width":60,"height":36},{"text":"구현되어야","x":374,"y":648,"width":160,"height":37},{"text":"하나?","x":544,"y":648,"width":76,"height":37},{"text":"이","x":635,"y":649,"width":25,"height":37},{"text":"설명은","x":676,"y":650,"width":88,"height":36},{"text":"그림","x":775,"y":650,"width":55,"height":36},{"text":"12.17에","x":846,"y":651,"width":105,"height":36},{"text":"나타나","x":966,"y":650,"width":90,"height":38},{"text":"있다.","x":1070,"y":650,"width":66,"height":37}]},{"text":"• 처음에는 응용 프로그램 수준에서 실험적인 입출력 알고리즘을 구현해 본다. 왜냐하","words":[{"text":"•","x":321,"y":750,"width":14,"height":15},{"text":"처음에는","x":362,"y":740,"width":127,"height":37},{"text":"응용","x":500,"y":740,"width":63,"height":37},{"text":"프로그램","x":575,"y":741,"width":118,"height":36},{"text":"수준에서","x":708,"y":742,"width":116,"height":37},{"text":"실험적인","x":841,"y":743,"width":118,"height":36},{"text":"입출력","x":974,"y":742,"width":84,"height":37},{"text":"알고리즘을","x":1075,"y":742,"width":156,"height":37},{"text":"구현해","x":1243,"y":743,"width":94,"height":36},{"text":"본다.","x":1351,"y":743,"width":73,"height":36},{"text":"왜냐하","x":1438,"y":744,"width":101,"height":37}]},{"text":"면 응용 프로그램은 가장 신축적이며 응용 프로그램의 버그는 시스템 전체의 고장","words":[{"text":"면","x":362,"y":802,"width":30,"height":35},{"text":"응용","x":408,"y":802,"width":64,"height":36},{"text":"프로그램은","x":488,"y":803,"width":156,"height":35},{"text":"가장","x":658,"y":803,"width":60,"height":36},{"text":"신축적이며","x":733,"y":803,"width":146,"height":37},{"text":"응용","x":896,"y":804,"width":61,"height":37},{"text":"프로그램의","x":971,"y":803,"width":148,"height":37},{"text":"버그는","x":1139,"y":804,"width":93,"height":36},{"text":"시스템","x":1248,"y":804,"width":92,"height":36},{"text":"전체의","x":1360,"y":804,"width":93,"height":36},{"text":"고장","x":1472,"y":806,"width":67,"height":36}]},{"text":"(crash)으로 이어질 가능성이 작기 때문이다. 그러므로 처음에는 응용 프로그램에서","words":[{"text":"(crash)으로","x":362,"y":866,"width":174,"height":37},{"text":"이어질","x":550,"y":864,"width":90,"height":36},{"text":"가능성이","x":653,"y":864,"width":117,"height":37},{"text":"작기","x":785,"y":864,"width":55,"height":37},{"text":"때문이다.","x":857,"y":865,"width":125,"height":36},{"text":"그러므로","x":996,"y":864,"width":121,"height":37},{"text":"처음에는","x":1130,"y":865,"width":125,"height":35},{"text":"응용","x":1265,"y":865,"width":65,"height":36},{"text":"프로그램에서","x":1341,"y":866,"width":193,"height":36}]},{"text":"실험적인 입출력 알고리즘을 구현한다. 그러면 매번 장치 드라이버 코드를 바꿀 때","words":[{"text":"실험적인","x":363,"y":924,"width":127,"height":36},{"text":"입출력","x":508,"y":925,"width":88,"height":36},{"text":"알고리즘을","x":614,"y":925,"width":152,"height":36},{"text":"구현한다.","x":778,"y":925,"width":128,"height":36},{"text":"그러면","x":921,"y":926,"width":89,"height":36},{"text":"매번","x":1025,"y":925,"width":59,"height":36},{"text":"장치","x":1099,"y":925,"width":57,"height":37},{"text":"드라이버","x":1174,"y":926,"width":122,"height":36},{"text":"코드를","x":1314,"y":927,"width":98,"height":34},{"text":"바꿀","x":1427,"y":926,"width":66,"height":36},{"text":"때","x":1507,"y":927,"width":29,"height":35}]},{"text":"마다 장지 드라이버를 재부팅 하거나 재적재할 필요가 없게 된다. 그러나 교로","words":[{"text":"마다","x":362,"y":985,"width":67,"height":35},{"text":"장지","x":441,"y":985,"width":60,"height":37},{"text":"드라이버를","x":517,"y":986,"width":156,"height":37},{"text":"재부팅","x":686,"y":986,"width":86,"height":36},{"text":"하거나","x":788,"y":986,"width":91,"height":36},{"text":"재적재할","x":891,"y":986,"width":121,"height":36},{"text":"필요가","x":1025,"y":986,"width":90,"height":36},{"text":"없게","x":1129,"y":986,"width":56,"height":36},{"text":"된다.","x":1201,"y":986,"width":69,"height":36},{"text":"그러나","x":1286,"y":986,"width":97,"height":36},{"text":"교로","x":1478,"y":989,"width":58,"height":27}]},{"text":"그램 단계에서의 구현은 문맥 교환에서의 오버헤드 때문에, 그리고 커널의 여러 기","words":[{"text":"그램","x":362,"y":1045,"width":63,"height":35},{"text":"단계에서의","x":443,"y":1045,"width":155,"height":38},{"text":"구현은","x":614,"y":1047,"width":93,"height":35},{"text":"문맥","x":719,"y":1046,"width":58,"height":35},{"text":"교환에서의","x":793,"y":1046,"width":148,"height":36},{"text":"오버헤드","x":958,"y":1046,"width":122,"height":36},{"text":"때문에,","x":1094,"y":1046,"width":98,"height":36},{"text":"그리고","x":1207,"y":1047,"width":95,"height":35},{"text":"커널의","x":1317,"y":1045,"width":94,"height":37},{"text":"여러","x":1430,"y":1045,"width":61,"height":35},{"text":"기","x":1509,"y":1045,"width":28,"height":35}]},{"text":"능(효율적인 커널 내 메시징, 스레딩, 락킹)을 활용할 수 없게 된다는 점에서 비효율","words":[{"text":"능(효율적인","x":362,"y":1106,"width":174,"height":37},{"text":"커널","x":552,"y":1107,"width":57,"height":35},{"text":"내","x":625,"y":1107,"width":26,"height":36},{"text":"메시징,","x":667,"y":1106,"width":98,"height":37},{"text":"스레딩,","x":779,"y":1106,"width":98,"height":37},{"text":"락킹)을","x":891,"y":1106,"width":102,"height":38},{"text":"활용할","x":1004,"y":1106,"width":93,"height":36},{"text":"수","x":1107,"y":1107,"width":32,"height":35},{"text":"없게","x":1152,"y":1106,"width":56,"height":35},{"text":"된다는","x":1224,"y":1106,"width":96,"height":36},{"text":"점에서","x":1334,"y":1105,"width":92,"height":35},{"text":"비효율","x":1445,"y":1105,"width":98,"height":34}]},{"text":"적일 수도 있다. 예를 들어, FUSE 시스템 인터페이스를 사용하면 파일 시스템을 사","words":[{"text":"적일","x":364,"y":1164,"width":63,"height":35},{"text":"수도","x":441,"y":1165,"width":65,"height":35},{"text":"있다.","x":520,"y":1166,"width":67,"height":35},{"text":"예를","x":603,"y":1166,"width":60,"height":35},{"text":"들어,","x":674,"y":1166,"width":69,"height":36},{"text":"FUSE","x":755,"y":1169,"width":86,"height":29},