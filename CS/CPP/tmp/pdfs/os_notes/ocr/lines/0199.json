38},{"text":"중이고","x":1350,"y":2201,"width":102,"height":37},{"text":"높은","x":1465,"y":2202,"width":70,"height":36},{"text":"우선순위","x":1548,"y":2203,"width":136,"height":37}]},{"text":"의 프로세스가 실행 준비가 되면, 높은 우선순위의 프로세스가 낮은 우선순위의 프로세","words":[{"text":"의","x":351,"y":2260,"width":29,"height":38},{"text":"프로세스가","x":398,"y":2262,"width":170,"height":38},{"text":"실행","x":583,"y":2262,"width":63,"height":37},{"text":"준비가","x":663,"y":2261,"width":102,"height":38},{"text":"되면,","x":780,"y":2262,"width":73,"height":38},{"text":"높은","x":869,"y":2263,"width":69,"height":35},{"text":"우선순위의","x":950,"y":2263,"width":166,"height":37},{"text":"프로세스가","x":1133,"y":2264,"width":170,"height":39},{"text":"낮은","x":1316,"y":2264,"width":68,"height":37},{"text":"우선순위의","x":1397,"y":2264,"width":167,"height":39},{"text":"프로세","x":1582,"y":2266,"width":102,"height":37}]},{"text":"스를 선점한다. 각각의 주기 태스크들은 시스템에 진입하게 되면 주기에 따라서 우선순","words":[{"text":"스를","x":350,"y":2326,"width":69,"height":36},{"text":"선점한다.","x":434,"y":2326,"width":141,"height":38},{"text":"각각의","x":592,"y":2324,"width":97,"height":39},{"text":"주기","x":706,"y":2325,"width":63,"height":37},{"text":"태스크들은","x":790,"y":2324,"width":167,"height":38},{"text":"시스템에","x":971,"y":2324,"width":130,"height":38},{"text":"진입하게","x":1120,"y":2326,"width":130,"height":38},{"text":"되면","x":1269,"y":2327,"width":65,"height":37},{"text":"주기에","x":1349,"y":2326,"width":99,"height":38},{"text":"따라서","x":1465,"y":2326,"width":99,"height":39},{"text":"우선순","x":1582,"y":2329,"width":106,"height":37}]},{"text":"위가 정해진다. 주기가 짧은 태스크는 높은 우선순위가, 주기가 길면 낮은 우선순위가 배","words":[{"text":"위가","x":351,"y":2388,"width":69,"height":39},{"text":"정해진다.","x":432,"y":2389,"width":141,"height":39},{"text":"주기가","x":588,"y":2388,"width":102,"height":39},{"text":"짧은","x":701,"y":2387,"width":67,"height":37},{"text":"태스크는","x":782,"y":2388,"width":132,"height":37},{"text":"높은","x":926,"y":2387,"width":67,"height":36},{"text":"우선순위가,","x":1004,"y":2388,"width":176,"height":38},{"text":"주기가","x":1193,"y":2389,"width":103,"height":38},{"text":"길면","x":1310,"y":2389,"width":64,"height":36},{"text":"낮은","x":1388,"y":2389,"width":68,"height":37},{"text":"우선순위가","x":1466,"y":2390,"width":174,"height":38},{"text":"배","x":1653,"y":2392,"width":30,"height":36}]},{"text":"정된다. 이 정책은 CPU를 더 자주 필요로 하는 태스크에 더 높은 우선순위를 주려는 원","words":[{"text":"정된다.","x":352,"y":2452,"width":108,"height":40},{"text":"이","x":478,"y":2454,"width":28,"height":37},{"text":"정책은","x":524,"y":2453,"width":100,"height":38},{"text":"CPU를","x":635,"y":2452,"width":115,"height":35},{"text":"더","x":764,"y":2451,"width":27,"height":36},{"text":"자주","x":808,"y":2450,"width":67,"height":37},{"text":"필요로","x":889,"y":2449,"width":97,"height":38},{"text":"하는","x":1000,"y":2450,"width":66,"height":37},{"text":"태스크에","x":1079,"y":2450,"width":131,"height":39},{"text":"더","x":1227,"y":2452,"width":28,"height":38},{"text":"높은","x":1270,"y":2452,"width":71,"height":36},{"text":"우선순위를","x":1352,"y":2452,"width":171,"height":38},{"text":"주려는","x":1534,"y":2454,"width":106,"height":37},{"text":"원","x":1653,"y":2455,"width":33,"height":36}]},{"text":"리에 기반을 두고 있다. 더욱이, rate-monotonic 스케줄링은 주기 프로세스들의 처리","words":[{"text":"리에","x":353,"y":2516,"width":63,"height":40},{"text":"기반을","x":436,"y":2517,"width":102,"height":39},{"text":"두고","x":552,"y":2519,"width":67,"height":36},{"text":"있다.","x":637,"y":2514,"width":71,"height":40},{"text":"더욱이,","x":728,"y":2513,"width":107,"height":39},{"text":"rate-monotonic","x":851,"y":2517,"width":260,"height":29},{"text":"스케줄링은","x":1127,"y":2515,"width":171,"height":37},{"text":"주기","x":1312,"y":2516,"width":64,"height":38},{"text":"프로세스들의","x":1396,"y":2515,"width":202,"height":41},{"text":"처리","x":1619,"y":2518,"width":64,"height":37}]}]}