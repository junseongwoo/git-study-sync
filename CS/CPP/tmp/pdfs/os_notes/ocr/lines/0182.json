":1394,"width":73,"height":38},{"text":"큐에서","x":792,"y":1392,"width":103,"height":40},{"text":"프로세스를","x":915,"y":1393,"width":180,"height":39},{"text":"스케줄","x":1109,"y":1391,"width":112,"height":40},{"text":"한다.","x":1235,"y":1390,"width":82,"height":40},{"text":"이것은","x":1338,"y":1389,"width":111,"height":40},{"text":"그림","x":1463,"y":1389,"width":74,"height":40},{"text":"5.7에","x":1557,"y":1388,"width":91,"height":40},{"text":"설명되","x":1668,"y":1389,"width":99,"height":45}]},{"text":"어 있다. 다단계 큐라고 하는 이 방법은 우선순위 스게줄링이 라운드 로빈과 결합한 경","words":[{"text":"어","x":342,"y":1459,"width":31,"height":40},{"text":"있다.","x":395,"y":1460,"width":78,"height":39},{"text":"다단계","x":491,"y":1459,"width":103,"height":40},{"text":"큐라고","x":611,"y":1460,"width":106,"height":39},{"text":"하는","x":733,"y":1459,"width":70,"height":39},{"text":"이","x":820,"y":1459,"width":29,"height":39},{"text":"방법은","x":869,"y":1458,"width":107,"height":38},{"text":"우선순위","x":990,"y":1458,"width":141,"height":39},{"text":"스게줄링이","x":1150,"y":1456,"width":180,"height":40},{"text":"라운드","x":1352,"y":1455,"width":112,"height":40},{"text":"로빈과","x":1480,"y":1454,"width":116,"height":40},{"text":"결합한","x":1613,"y":1454,"width":111,"height":38},{"text":"경","x":1737,"y":1457,"width":28,"height":40}]},{"text":"우에도 효과적이다. 우선순위가 가장 높은 큐에 여러 프로세스가 있는 경우 라운드 로빈","words":[{"text":"우에도","x":341,"y":1525,"width":108,"height":39},{"text":"효과적이다.","x":462,"y":1524,"width":184,"height":40},{"text":"우선순위가","x":661,"y":1524,"width":178,"height":40},{"text":"가장","x":852,"y":1524,"width":71,"height":39},{"text":"높은","x":936,"y":1525,"width":72,"height":37},{"text":"큐에","x":1021,"y":1523,"width":69,"height":40},{"text":"여러","x":1109,"y":1523,"width":67,"height":39},{"text":"프로세스가","x":1193,"y":1521,"width":187,"height":40},{"text":"있는","x":1396,"y":1521,"width":73,"height":39},{"text":"경우","x":1484,"y":1520,"width":76,"height":40},{"text":"라운드","x":1575,"y":1519,"width":113,"height":40},{"text":"로빈","x":1700,"y":1522,"width"