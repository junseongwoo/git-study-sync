{"page":123,"width":1864,"height":2792,"text_angle":0,"lines":[{"text":"1 개요 177","words":[{"text":"1","x":1447,"y":176,"width":14,"height":24},{"text":"개요","x":1481,"y":175,"width":49,"height":28},{"text":"177","x":1607,"y":168,"width":61,"height":31}]},{"text":"다중 고어 시스템에서 처리 능력을 향상시기도록 설계될 수 있다. 이러한 우용-은","words":[{"text":"다중","x":424,"y":309,"width":65,"height":39},{"text":"고어","x":504,"y":310,"width":61,"height":39},{"text":"시스템에서","x":585,"y":310,"width":162,"height":42},{"text":"처리","x":768,"y":313,"width":60,"height":39},{"text":"능력을","x":846,"y":312,"width":104,"height":40},{"text":"향상시기도록","x":963,"y":312,"width":210,"height":40},{"text":"설계될","x":1187,"y":312,"width":101,"height":40},{"text":"수","x":1304,"y":314,"width":35,"height":39},{"text":"있다.","x":1354,"y":314,"width":75,"height":39},{"text":"이러한","x":1446,"y":313,"width":105,"height":39},{"text":"우용-은","x":1562,"y":312,"width":105,"height":39}]},{"text":"다중 계산 고어를 A卜%하여 다수의 CPU-집중 작업을 병렬로 처리할 수 있다.","words":[{"text":"다중","x":308,"y":374,"width":66,"height":39},{"text":"계산","x":389,"y":373,"width":66,"height":39},{"text":"고어를","x":468,"y":374,"width":100,"height":39},{"text":"A卜%하여","x":581,"y":376,"width":130,"height":40},{"text":"다수의","x":729,"y":377,"width":96,"height":39},{"text":"CPU-집중","x":841,"y":376,"width":166,"height":40},{"text":"작업을","x":1020,"y":376,"width":104,"height":40},{"text":"병렬로","x":1139,"y":377,"width":101,"height":40},{"text":"처리할","x":1255,"y":378,"width":104,"height":39},{"text":"수","x":1369,"y":380,"width":36,"height":38},{"text":"있다.","x":1419,"y":378,"width":74,"height":40}]},{"text":"하나의 우우 프로그램이 여러 개의 비슷한 작업을 수행할 필요가 있는 상황-들이 또","words":[{"text":"하나의","x":371,"y":438,"width":98,"height":38},{"text":"우우","x":487,"y":438,"width":67,"height":39},{"text":"프로그램이","x":569,"y":440,"width":164,"height":40},{"text":"여러","x":753,"y":441,"width":63,"height":39},{"text":"개의","x":836,"y":441,"width":62,"height":39},{"text":"비슷한","x":920,"y":441,"width":101,"height":39},{"text":"작업