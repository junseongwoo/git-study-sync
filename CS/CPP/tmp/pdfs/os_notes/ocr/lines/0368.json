{"page":368,"width":1673,"height":2449,"text_angle":0,"lines":[{"text":"428 Chapter 10 가장 메모리","words":[{"text":"428","x":182,"y":135,"width":57,"height":26},{"text":"Chapter","x":309,"y":138,"width":113,"height":28},{"text":"10","x":434,"y":139,"width":35,"height":21},{"text":"가장","x":496,"y":141,"width":40,"height":23},{"text":"메모리","x":545,"y":142,"width":59,"height":22}]},{"text":"10.1 배경 Background","words":[{"text":"10.1","x":181,"y":259,"width":101,"height":33},{"text":"배경","x":330,"y":258,"width":67,"height":39},{"text":"Background","x":427,"y":268,"width":196,"height":29}]},{"text":"9징에서 살펴본 메모리 관리 일고리즘들은 현재 실행되고 있는 코드는 반드시 물리 메","words":[{"text":"9징에서","x":308,"y":344,"width":105,"height":34},{"text":"살펴본","x":430,"y":344,"width":87,"height":34},{"text":"메모리","x":530,"y":344,"width":82,"height":34},{"text":"관리","x":628,"y":344,"width":54,"height":34},{"text":"일고리즘들은","x":699,"y":344,"width":173,"height":34},{"text":"현재","x":886,"y":344,"width":56,"height":34},{"text":"실행되고","x":960,"y":344,"width":120,"height":34},{"text":"있는","x":1096,"y":344,"width":62,"height":32},{"text":"코드는","x":1172,"y":346,"width":98,"height":31},{"text":"반드시","x":1286,"y":345,"width":94,"height":33},{"text":"물리","x":1399,"y":345,"width":60,"height":34},{"text":"메","x":1478,"y":347,"width":26,"height":32}]},{"text":"모리에 존재해야 한다는 기본적인 요구 조건을 만족히는 데 필요하였다. 이 요구 조건","words":[{"text":"모리에","x":307,"y":399,"width":89,"height":34},{"text":"존재해야","x":412,"y":400,"width":118,"height":33},{"text":"한다는","x":542,"y":400,"width":87,"height":33},{"text":"기본적인","x":644,"y":400,"width":112,"height":34},{"text":"요구","x":771,"y":401,"width":57,"height":32},{"text":"조건을","x":842,"y":399,"width":89,"height":34},{"text":"만족히는","x":946,"y":399,"width":122,"height":34},{"text":"데","x":1083,"y":398,"width":27,"height":34},{"text":"필요하였다.","x":1130,"y":398,"width":168,"height":36},{"text":"이","x":1318,"y":400,"width":27,"height":34},{"text":"요구","x":1365,"y":403,"width":66,"height":31},{"text":"조건","x":14