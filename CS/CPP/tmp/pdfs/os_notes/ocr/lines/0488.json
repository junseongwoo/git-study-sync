idth":93,"height":36},{"text":"서브시스템에","x":481,"y":647,"width":185,"height":37},{"text":"제공하는","x":681,"y":648,"width":119,"height":36},{"text":"것이다.","x":814,"y":648,"width":95,"height":36},{"text":"이렇게","x":923,"y":648,"width":88,"height":37},{"text":"되면","x":1027,"y":649,"width":58,"height":36},{"text":"입출력","x":1100,"y":649,"width":88,"height":36},{"text":"서브시스템은","x":1204,"y":650,"width":196,"height":37},{"text":"하드웨어","x":1411,"y":651,"width":128,"height":38}]},{"text":"와 독립적으로 되어서 운영체제 개발자의 작업을 간단하게 해준다. 이것은 하드웨어 제","words":[{"text":"와","x":290,"y":708,"width":35,"height":35},{"text":"독립적으로","x":337,"y":708,"width":166,"height":35},{"text":"되어서","x":518,"y":708,"width":89,"height":36},{"text":"운영체제","x":624,"y":708,"width":121,"height":36},{"text":"개발자의","x":762,"y":708,"width":116,"height":36},{"text":"작업을","x":894,"y":708,"width":92,"height":36},{"text":"간단하게","x":1000,"y":709,"width":118,"height":36},{"text":"해준다.","x":1136,"y":709,"width":100,"height":37},{"text":"이것은","x":1254,"y":711,"width":97,"height":36},{"text":"하드웨어","x":1365,"y":712,"width":127,"height":36},{"text":"제","x":1510,"y":713,"width":29,"height":36}]},{"text":"조업자에게도 이익을 가져다준다. 그들이 새로운 장치들을 개발할 때 그 컨트롤러를 기","words":[{"text":"조업자에게도","x":290,"y":768,"width":199,"height":36},{"text":"이익을","x":505,"y":768,"width":94,"height":36},{"text":"가져다준다.","x":614,"y":768,"width":159,"height":37},{"text":"그들이","x":788,"y":768,"width":86,"height":37},{"text":"새로운","x":892,"y":768,"width":91,"height":36},{"text":"장치들을","x":995,"y":769,"width":123,"height":36},{"text":"개발할","x":1132,"y":769,"width":95,"height":37},{"text":"때","x":1241,"y":770,"width":27,"height":37},{"text":"그","x":1285,"y":776,"width":33,"height":24},{"text":"컨트롤러를","x":1334,"y":772,"width":161,"height":36},{"text":"기","x":1510,"y":774,"width":27,"height":35}]},{"text":"존 컨트롤러 인터페이스와 같게 만들어 주든지(예를 들면 SATA) 아니면 이 장치를 위","words":[{"text":"존","x":289,"y":830,"width":35,"height":32},{"text":"컨트롤러","x":340,"y":828,"width":127,"height":36},{"