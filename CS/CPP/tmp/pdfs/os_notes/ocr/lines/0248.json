:1554,"width":85,"height":24}]},{"text":"추성鬱화된 데이터 형(abstract data type, ADT)은 데이터와 이 데이터를 조작하는 함","words":[{"text":"추성鬱화된","x":280,"y":1617,"width":118,"height":35},{"text":"데이터","x":412,"y":1618,"width":82,"height":35},{"text":"형(abstract","x":510,"y":1617,"width":153,"height":37},{"text":"data","x":676,"y":1618,"width":64,"height":28},{"text":"type,","x":755,"y":1621,"width":73,"height":35},{"text":"ADT)은","x":843,"y":1617,"width":122,"height":36},{"text":"데이터와","x":979,"y":1616,"width":125,"height":35},{"text":"이","x":1118,"y":1616,"width":25,"height":35},{"text":"데이터를","x":1162,"y":1616,"width":129,"height":35},{"text":"조작하는","x":1305,"y":1616,"width":132,"height":35},{"text":"함","x":1450,"y":1618,"width":32,"height":33}]},{"text":"수들의 집합을 하나의 단위로 묶어 보호한다. 이때 함수의 구현은 ADT의 특정한 구현","words":[{"text":"수들의","x":278,"y":1674,"width":89,"height":34},{"text":"집합을","x":383,"y":1675,"width":86,"height":34},{"text":"하나의","x":481,"y":1675,"width":82,"height":35},{"text":"단위로","x":578,"y":1674,"width":86,"height":34},{"text":"묶어","x":677,"y":1673,"width":55,"height":35},{"text":"보호한다.","x":748,"y":1673,"width":126,"height":35},{"text":"이때","x":891,"y":1674,"width":56,"height":34},{"text":"함수의","x":964,"y":1674,"width":89,"height":35},{"text":"구현은","x":1069,"y":1674,"width":96,"height":35},{"text":"ADT의","x":1177,"y":1674,"width":110,"height":34},{"text":"특정한","x":1304,"y":1674,"width":101,"height":35},{"text":"구현","x":1417,"y":1675,"width":63,"height":35}]},{"text":"과는 독립적이다. 모니터 항은 모니터 내부에서 상호 배제가 보장되는 프로그래머가 정","words":[{"text":"과는","x":278,"y":1731,"width":62,"height":34},{"text":"독립적이다.","x":352,"y":1733,"width":150,"height":34},{"text":"모니터","x":514,"y":1732,"width":88,"height":35},{"text":"항은","x":617,"y":1732,"width":55,"height":35},{"text":"모니터","x":684,"y":1731,"width":85,"height":35},{"text":"내부에서","x":787,"y":1731,"width":115,"height":35},{"text":"상호","x":917,"y":1731,"width":62,"height":35},{"text":"배제가","x":993,"y":1732,"width":93,"height":35},{"text":"보장되는","x":1098,"y":1732,"width":128,"height":34},{"text":"프로그래머가","x":1238,"y":1732,"width":200,"height":35},{"text":"정","x":1451,"y":1733,"width":26,"height":34}]},{"text":"의한 일련의 연산자 집합을 포함하는 ADT이다. 모니터 형은 또한 변수들의 선언을 포","words":[{"text":"의한","x":279,"y":1789,"width":61,"height":34},{"text":"일련의","x":354,"y":1789,"width":82,"height":35},{"text":"연산자","x":453,"y":1790,"width":85,"height":34},{"text":"집합을","x":550,"y":1790,"width":86,"height":34},{"text":"포함하는","x":648,"y":1790,"width":118,"height":34},{"text":"ADT이다.","x":777,"y":1789,"width":141,"height":35},{"text":"모니터","x":933,"y":1789,"width":88,"height":35},{"text":"형은","x":1040,"y":1790,"width":62,"height":34},{"text":"또한","x":1115,"y":1790,"width":65,"height":33},{"text":"변수들의","x":1194,"y":1790,"width":125,"height":35},{"text":"선언을","x":1339,"y":1790,"width":98,"height":34},{"text":"포","x":1450,"y":1794,"width":31,"height":25}]},{"text":"함하고 있는데 이 변수들의 값은 그 형에 해당하는 한 인스턴스의 상태를 정의한다. 그","words":[{"text":"함하고","x":278,"y":1847,"width":90,"height":34},{"text":"있는데","x":383,"y":1847,"width":81,"height":35},{"text":"이","x":480,"y":1847,"width":24,"height":35},{"text":"변수들의","x":522,"y":1848,"width":111,"height":34},{"text":"값은","x":648,"y":1848,"width":59,"height":34},{"text":"그","x":720,"y":1853,"width":28,"height":23},{"text":"형에","x":762,"y":1848,"width":55,"height":35},{"text":"해당하는","x":834,"y":1847,"width":120,"height":36},{"text":"한","x":966,"y":1847,"width":32,"height":34},{"text":"인스턴스의","x":1013,"y":1848,"width":151,"height":34},{"text":"상태를","x":1181,"y":1848,"width":98,"height":34},{"text":"정의한다.","x":1294,"y":1848,"width":138,"height":35},{"text":"그","x":1449,"y":1853,"width":31,"height":23}]},{"text":"리고 모니터 형은 이 변수들을 조작할 수 있는 프로시저 또는 함수들의 본체도 같이 포","words":[{"text":"리고","x":281,"y":1904,"width":57,"height":35},{"text":"모니터","x":351,"y":1905,"width":83,"height":34},{"text":"형은","x":450,"y":1905,"width":57,"height":34},{"text":"이","x":520,"y":1906,"width":24,"height":33},{"text":"변수들을","x":562,"y":1905,"width":114,"height":35},{"text":"조작할","x":688,"y":1907,"width":89,"height":34},{"text":"수","x":788,"y":1907,"width":30,"height":34},{"text":"있는","x":833,"y":1906,"width":57,"height":35},{"text":"프로시저","x":903,"y":1905,"width":118,"height":36},{"text":"또는","x":1037,"y":1908,"width":63,"height":31},{"text":"함수들의","x":1113,"y":1906,"width":125,"height":35},{"text":"본체도","x":1255,"y":1906,"width":100,"height":34},{"text":"같이","x":1369,"y":1906,"width":62,"height":34},{"text":"포","x":1449,"y":1909,"width":31,"height":25}]},{"text":"함하고 있다. 모니터의 구문을 소개하면 그림 6.11과 같다. 모니터 형의 표현은 다른 프","words":[{"text":"함하고","x":278,"y":1962,"width":90,"height":35},{"text":"있다.","x":381,"y":1962,"width":62,"height":35},{"text":"모니터의","x":456,"y":1962,"width":113,"height":36},{"text":"구문을","x":584,"y":1964,"width":88,"height":35},{"text":"소개하면","x":683,"y":1965,"width":116,"height":34},{"text":"그림","x":812,"y":1964,"width":56,"height":35},{"text":"6.11과","x":884,"y":1964,"width":90,"height":36},{"text":"같다.","x":986,"y":1963,"width":67,"height":36},{"text":"모니터","x":1068,"y":1964,"width":91,"height":35},{"text":"형의","x":1178,"y":1964,"width":60,"height":34},{"text":"표현은","x":1255,"y":1964,"width":101,"height":34},{"text":"다른","x":1370,"y":1964,"width":66,"height":36},{"text":"프","x":1448,"y":1967,"width":32,"height":24}]},{"text":"로세스들이 직접 사용할 수 없다. 따라서 모니터 내에 정의된 함수만이 오직 모니터 내","words":[{"text":"로세스들이","x":277,"y":2020,"width":144,"height":35},{"text":"직접","x":438,"y":2020,"width":53,"height":36},{"text":"사용할","x":506,"y":2021,"width":89,"height":35},{"text":"수","x":606,"y":2022,"width":30,"height":34},{"text":"없다.","x":650,"y":2022,"width":62,"height":35},{"text":"따라서","x":728,"y":2023,"width":83,"height":36},{"text":"모니터","x":827,"y":2023,"width":86,"height":35},{"text":"내에","x":932,"y":2023,"width":55,"height":35},{"text":"정의된","x":1005,"y":2022,"width":90,"height":35},{"text":"함수만이","x":1110,"y":2022,"width":124,"height":36},{"text":"오직","x":1253,"y":2022,"width":62,"height":35},{"text":"모니터","x":1334,"y":2022,"width":95,"height":35},{"text":"내","x":1449,"y":2021,"width":27,"height":35}]},{"text":"에 지역적으로 선언된 변수들과 형식 매개변수들에만 접근할 수 있다. 마찬가지로 모니","words":[{"text":"에","x":278,"y":2078,"width":26,"height":35},{"text":"지역적으로","x":320,"y":2078,"width":144,"height":36},{"text":"선언된","x":477,"y":2080,"width":85,"height":34},{"text":"변수들과","x":578,"y":2080,"width":116,"height":35},{"text":"형식","x":706,"y":2081,"width":53,"height":35},{"text":"매개변수들에만","x":776,"y":2081,"width":208,"height":36},{"text":"접근할","x":997,"y":2081,"width":93,"height":35},{"text":"수","x":1101,"y":2081,"width":32,"height":35},{"text":"있다.","x":1149,"y":2081,"width":67,"height":35},{"text":"마찬가지로","x":1233,"y":2081,"width":167,"height":35},{"text":"모니","x":1414,"y":2079,"width":60,"height":36}]},{"text":"터 내의 지역 변수는 오직 지역 함수만이 접근할수 있다.","words":[{"text":"터","x":278,"y":2137,"width":24,"height":35},{"text":"내의","x":318,"y":2137,"width":54,"height":36},{"text":"지역","x":387,"y":2138,"width":53,"height":36},{"text":"변수는","x":454,"y":2138,"width":87,"height":36},{"text":"오직","x":550,"y":2139,"width":56,"height":35},{"text":"지역","x":621,"y":2139,"width":54,"height":35},{"text":"함수만이","x":689,"y":2139,"width":112,"height":36},{"text":"접근할수","x":816,"y":2140,"width":128,"height":35},{"text":"있다.","x":957,"y":2140,"width":64,"height":35}]},{"text":"모니터 구조물은 모니터 안에 항상 하나의 프로세스만이 활성화되도록 보장해 준","words":[{"text":"모니터","x":331,"y":2197,"width":84,"height":36},{"text":"구조물은","x":433,"y":2198,"width":118,"height":36},{"text":"모니터","x":564,"y":2198,"width":85,"height":35},{"text":"안에","x":669,"y":2198,"width":54,"height":35},{"text":"항상","x":740,"y":2198,"width":59,"height":35},{"text":"하나의","x":813,"y":2199,"width":85,"height":34},{"text":"프로세스만이","x":916,"y":2198,"width":180,"height":36},{"text":"활성화되도록","x":1115,"y":2198,"width":198,"height":36},{"text":"보장해","x":1330,"y":2199,"width":98,"height":36},{"text":"준","x":1446,"y":2200,"width":34,"height":32}]},{"text":"다. 그러므로 프로그래머들은 이와 같은 동기화 제약 조건을 명시적으로 코딩해야 할 필","words":[{"text":"다.","x":277,"y":2254,"width":34,"height":35},{"text":"그러므로","x":325,"y":2257,"width":117,"height":35},{"text":"프로그래머들은","x":453,"y":2256,"width":205,"height":36},{"text":"이와","x":670,"y":2257,"width":58,"height":34},{"text":"같은","x":738,"y":2257,"width":58,"height":33},{"text":"동기화","x":806,"y":2256,"width":90,"height":35},{"text":"제약","x":907,"y":2257,"width":60,"height":35},{"text":"조건을","x":977,"y":2257,"width":93,"height":34},{"text":"명시적으로","x":1083,"y":2257,"width":157,"height":36},{"text":"코딩해야","x":1253,"y":2259,"width":137,"height":36},{"text":"할","x":1402,"y":2258,"width":34,"height":36},{"text":"필","x":1449,"y":2257,"width":28,"height":35}]}]}