{"page":166,"width":1834,"height":2869,"text_angle":0,"lines":[{"text":"220","words":[{"text":"220","x":179,"y":145,"width":67,"height":30}]},{"text":"5.1","words":[{"text":"5.1","x":180,"y":297,"width":86,"height":37}]},{"text":"Chapter 5","words":[{"text":"Chapter","x":330,"y":153,"width":134,"height":32},{"text":"5","x":480,"y":154,"width":24,"height":24}]},{"text":"CPU 스케줄링","words":[{"text":"CPU","x":538,"y":155,"width":59,"height":25},{"text":"스케줄링","x":608,"y":154,"width":98,"height":29}]},{"text":"기보 7H념 Basic Concepts","words":[{"text":"기보","x":332,"y":296,"width":84,"height":38},{"text":"7H념","x":429,"y":295,"width":79,"height":44},{"text":"Basic","x":545,"y":307,"width":109,"height":28},{"text":"Concepts","x":668,"y":307,"width":189,"height":36}]},{"text":"코어가 하나인 시스템에서는 한순간에 오직 하나의 프로세스만이 실행될 수 있다. 나머","words":[{"text":"코어가","x":328,"y":398,"width":110,"height":40},{"text":"하나인","x":453,"y":398,"width":105,"height":40},{"text":"시스템에서는","x":576,"y":399,"width":213,"height":41},{"text":"한순간에","x":803,"y":400,"width":139,"height":40},{"text":"오직","x":960,"y":400,"width":66,"height":40},{"text":"하나의","x":1046,"y":400,"width":104,"height":40},{"text":"프로세스만이","x":1169,"y":400,"width":216,"height":40},{"text":"실행될","x":1408,"y":400,"width":107,"height":41},{"text":"수","x":1534,"y":403,"width":37,"height":39},{"text":"있다.","x":1590,"y":402,"width":77,"height":40},{"text":"나머","x":1686,"y":403,"width":60,"height":45}]},{"text":"지 프로세스는 CPU의 코어가 기용 상대가 되어 다시 스케줄 될 수 있을 t내까지 기다려","words":[{"text":"지","x":330,"y":464,"width":30,"height":39},{"text":"프로세스는","x":379,"y":465,"width":181,"height":39},{"text":"CPU의","x":572,"y":465,"width":118,"height":41},{"text":"코어가","x":708,"y":466,"width":108,"height":41},{"text":"기용","x":830,"y":467,"width":69,"height":40},{"text":"상대가","x":912,"y":466,"width":108,"height":41},{"text":"되어","x":1035,"y":467,"width":66,"height":40},{"text":"다시","x":1120,"y":466,"width":66,"height":41},{"text":"스케줄","x":1205,"y":466,"width":110,"height":40},{"text":"될","x":1331,"y":467,"width":32,"height":38},{"text":"수","x":1381,"y":467,"width":37,"height":39},{"text":"있을","x":1435,"y":467,"width":73,"height":40},{"text":"t내까지","x":1524,"y":468,"width":107,"height":39},{"text":"기다려","x":1651,"y":468,"width":95,"height":45}]},{"text":"야 한다. 다중 프로그래밍의 목적은 CPU 이용률을 최대화하기 위해 항상 실행 중인 프","words":[{"text":"야","x":328,"y":530,"width":37,"height":40},{"text":"한다.","x":378,"y":531,"width":80,"height":39},{"text":"다중","x":476,"y":531,"width":71,"height":41},{"text":"프로그래밍의","x":561,"y":532,"width":210,"height":41},{"text":"목적은","x":788,"y":533,"width":107,"height":40},{"text":"CPU","x":907,"y":537,"width":86,"height":31},{"text":"이용률을","x":1010,"y":533,"width":143,"height":40},{"text":"최대화하기","x":1168,"y":532,"width":177,"height":41},{"text":"위해","x":1367,"y":532,"width":69,"height":40},{"text":"항상","x":1454,"y":533,"width":77,"height":39},{"text":"실행","x":1547,"y":533,"width":70,"height":40},{"text":"중인","x":1634,"y":533,"width":70,"height":40},{"text":"프","x":1719,"y":541,"width":30,"height":31}]},{"text":"로세스를 가지게 하는 데 있다. 니중 프로그래밍에 대한 기본 아이디어는 비교적 간단하","words":[{"text":"로세스를","x":327,"y":597,"width":146,"height":39},{"text":"가지게","x":488,"y":598,"width":102,"height":41},{"text":"하는","x":606,"y":599,"width":71,"height":40},{"text":"데","x":692,"y":599,"width":29,"height":40},{"text":"있다.","x":741,"y":599,"width":75,"height":40},{"text":"니중","x":834,"y":600,"width":69,"height":39},{"text":"프로그래밍에","x":916,"y":600,"width":213,"height":39},{"text":"대한","x":1147,"y":599,"width":72,"height":40},{"text":"기본","x":1234,"y":598,"width":71,"height":40},{"text":"아이디어는","x":1319,"y":598,"width":188,"height":40},{"text":"비교적","x":1523,"y":599,"width":107,"height":39},{"text":"간단하","x":1648,"y":599,"width":102,"height":44}]},{"text":"다. 하나의 프로세스는, 전형적으로 어떤 1/0 요청이 완료되기를 기다려야만 할 때까지","words":[{"text":"다.","x":327,"y":662,"width":43,"height":40},{"text":"하나의","x":388,"y":663,"width":104,"height":40},{"text":"프로세스는,","x":509,"y":665,"width":186,"height":40},{"text":"전형적으로","x":712,"y":665,"width":176,"height":40},{"text":"어떤","x":902,"y":664,"width":68,"height":40},{"text":"1/0","x":985,"y":668,"width":71,"height":36},{"text":"요청이","x":1071,"y":665,"width":104,"height":40},{"text":"완료되기를","x":1193,"y":664,"width":185,"height":40},{"text":"기다려야만","x":1394,"y":664,"width":189,"height":40},{"text":"할","x":1596,"y":665,"width":39,"height":39},{"text":"때까지","x":1649,"y":665,"width":96,"height":45}]},{"text":"실행된다. 이렇게 되면, 단순한 컴퓨터 시스템에서 CPU는 그저 놀고 있게 된다. 이러한","words":[{"text":"실행된다.","x":326,"y":728,"width":152,"height":41},{"text":"이렇게","x":497,"y":730,"width":102,"height":41},{"text":"되면,","x":616,"y":731,"width":77,"height":41},{"text":"단순한","x":709,"y":730,"width":107,"height":40},{"text":"컴퓨터","x":830,"y":730,"width":99,"height":41},{"text":"시스템에서","x":949,"y":731,"width":175,"height":41},{"text":"CPU는","x":1141,"y":733,"width":125,"height":36},{"text":"그저","x":1280,"y":731,"width":69,"height":40},{"text":"놀고","x":1368,"y":732,"width":74,"height":37},{"text":"있게","x":1460,"y":731,"width":69,"height":39},{"text":"된다.","x":1548,"y":731,"width":82,"height":40},{"text":"이러한","x":1649,"y":731,"width":100,"height":44}]},{"text":"모든 대기 시간은 당비되며, 어떤 유용한 직법도 수행하지 못한다. 다중 프로그래밍에서","words":[{"text":"모든","x":324,"y":798,"width":74,"height":36},{"text":"대기","x":412,"y":796,"width":66,"height":40},{"text":"시간은","x":498,"y":797,"width":105,"height":39},{"text":"당비되며,","x":617,"y":797,"width":149,"height":41},{"text":"어떤","x":783,"y":797,"width":67,"height":40},{"text":"유용한","x":865,"y":797,"width":109,"height":40},{"text":"직법도","x":986,"y":797,"width":108,"height":40},{"text":"수행하지","x":1108,"y":797,"width":141,"height":41},{"text":"못한다.","x":1267,"y":797,"width":120,"height":40},{"text":"다중","x":1406,"y":797,"width":74,"height":39},{"text":"프로그래밍에서","x":1494,"y":798,"width":250,"height":44}]},{"text":"는, 우리는 이러한 시간을 생산적으로 활용하려고 시도한다. 어느 한순간에 다수의 프로","words":[{"text":"는,","x":323,"y":862,"width":45,"height":40},{"text":"우리는","x":384,"y":862,"width":109,"height":39},{"text":"이러한","x":508,"y":864,"width":105,"height":39},{"text":"시간을","x":627,"y":864,"width":105,"height":39},{"text":"생산적으로","x":745,"y":863,"width":177,"height":40},{"text":"활용하려고","x":936,"y":863,"width":181,"height":40},{"text":"시도한다.","x":1131,"y":864,"width":154,"height":39},{"text":"어느","x":1304,"y":864,"width":72,"height":38},{"text":"한순간에","x":1391,"y":862,"width":148,"height":39},{"text":"다수의","x":1557,"y":863,"width":108,"height":40},{"text":"프로","x":1683,"y":869,"width":65,"height":32}]},{"text":"세스를 메모리 내에 유지한다. 어떤 프로세스가 대기해야 할 경우, 운영체제는 CPU를","words":[{"text":"세스를","x":323,"y":928,"width":109,"height":40},{"text":"메모리","x":448,"y":928,"width":102,"height":41},{"text":"내에","x":571,"y":929,"width":66,"height":40},{"text":"유지한다.","x":654,"y":929,"width":150,"height":40},{"text":"어떤","x":824,"y":928,"width":67,"height":40},{"text":"프로세스가","x":909,"y":929,"width":182,"height":39},{"text":"대기해야","x":1107,"y":929,"width":146,"height":39},{"text":"할","x":1268,"y":929,"width":38,"height":38},{"text":"경우,","x":1323,"y":929,"width":82,"height":39},{"text":"운영체제는","x":1423,"y":928,"width":192,"height":39},{"text":"CPU를","x":1630,"y":933,"width":119,"height":39}]},{"text":"그 프로세스로부터 회수해 다른 프로세스에 할당한다. 이러한 패턴은 계속된다. 하나의","words":[{"text":"그","x":322,"y":1000,"width":36,"height":25},{"text":"프로세스로부터","x":373,"y":994,"width":245,"height":41},{"text":"회수해","x":638,"y":995,"width":102,"height":40},{"text":"다른","x":759,"y":995,"width":70,"height":40},{"text":"프로세스에","x":843,"y":994,"width":178,"height":40},{"text":"할당한다.","x":1040,"y":995,"width":152,"height":40},{"text":"이러한","x":1213,"y":995,"width":110,"height":39},{"text":"패턴은","x":1339,"y":994,"width":112,"height":39},{"text":"계속된다.","x":1468,"y":993,"width":159,"height":40},{"text":"하나의","x":1646,"y":995,"width":99,"height":45}]},{"text":"프로세스가 대기해야 할 때마다, 다른 프로세스가 CPU 시용을 양도받을 수 있다. 다중","words":[{"text":"프로세스가","x":320,"y":1060,"width":181,"height":40},{"text":"대기해야","x":515,"y":1061,"width":142,"height":40},{"text":"할","x":670,"y":1061,"width":36,"height":39},{"text":"때마다,","x":720,"y":1061,"width":114,"height":40},{"text":"다른","x":851,"y":1061,"width":71,"height":39},{"text":"프로세스가","x":936,"y":1061,"width":182,"height":41},{"text":"CPU","x":1131,"y":1065,"width":88,"height":31},{"text":"시용을","x":1235,"y":1060,"width":112,"height":39},{"text":"양도받을","x":1363,"y":1059,"width":151,"height":39},{"text":"수","x":1527,"y":1060,"width":40,"height":38},{"text":"있다.","x":1585,"y":1060,"width":79,"height":40},{"text":"다중","x":1683,"y":1062,"width":65,"height":41}]},{"text":"코어 시스템에서 CPU를 바쁘게 유지하는 이 개념은 시스템의 모든 처리 코어로 확장","words":[{"text":"코어","x":319,"y":1125,"width":67,"height":40},{"text":"시스템에서","x":408,"y":1126,"width":173,"height":40},{"text":"CPU를","x":600,"y":1129,"width":122,"height":36},{"text":"바쁘게","x":738,"y":1127,"width":103,"height":39},{"text":"유지하는","x":860,"y":1126,"width":146,"height":40},{"text":"이","x":1024,"y":1127,"width":29,"height":39},{"text":"개념은","x":1076,"y":1127,"width":108,"height":39},{"text":"시스템의","x":1201,"y":1125,"width":144,"height":39},{"text":"모든","x":1366,"y":1127,"width":76,"height":36},{"text":"처리","x":1460,"y":1125,"width":70,"height":39},{"text":"코어로","x":1552,"y":1126,"width":114,"height":38},{"text":"확장","x":1681,"y":1128,"width":68,"height":41}]},{"text":"된다.","words":[{"text":"된다.","x":318,"y":1191,"width":79,"height":39}]},{"text":"이러한 종류의 스케줄링은 운영체제의 기본적인 기능이다. 거의 모든 컴퓨터 자원들","words":[{"text":"이러한","x":385,"y":1257,"width":105,"height":39},{"text":"종류의","x":502,"y":1257,"width":102,"height":39},{"text":"스케줄링은","x":620,"y":1258,"width":180,"height":39},{"text":"운영체제의","x":811,"y":1257,"width":178,"height":39},{"text":"기본적인","x":1007,"y":1257,"width":142,"height":39},{"text":"기능이다.","x":1166,"y":1256,"width":154,"height":40},{"text":"거의","x":1339,"y":1256,"width":69,"height":39},{"text":"모든","x":1426,"y":1258,"width":77,"height":36},{"text":"컴퓨터","x":1519,"y":1256,"width":107,"height":39},{"text":"자원들","x":1645,"y":1257,"width":103,"height":41}]},{"text":"은 시용되기 전에 스케줄 된다. 물론 CPU는 중요한 컴퓨터 자원 중의 하나이다. 따라서","words":[{"text":"은","x":314,"y":1324,"width":37,"height":36},{"text":"시용되기","x":364,"y":1322,"width":137,"height":40},{"text":"전에","x":520,"y":1323,"width":66,"height":39},{"text":"스케줄","x":602,"y":1323,"width":107,"height":38},{"text":"된다.","x":722,"y":1323,"width":78,"height":39},{"text":"물론","x":817,"y":1325,"width":73,"height":36},{"text":"CPU는","x":902,"y":1325,"width":125,"height":35},{"text":"중요한","x":1040,"y":1322,"width":110,"height":39},{"text":"컴퓨터","x":1165,"y":1322,"width":103,"height":38},{"text":"자원","x":1287,"y":1321,"width":73,"height":39},{"text":"중의","x":1376,"y":1321,"width":71,"height":39},{"text":"하나이다.","x":1466,"y":1321,"width":160,"height":39},{"text":"따라서","x":1644,"y":1322,"width":99,"height":43}]},{"text":"CPU의 스케줄링은 운영체제 설계의 핵심이 된다.","words":[{"text":"CPU의","x":314,"y":1388,"width":117,"height":39},{"text":"스케줄링은","x":448,"y":1388,"width":176,"height":39},{"text":"운영체제","x":635,"y":1388,"width":140,"height":39},{"text":"설계의","x":792,"y":1388,"width":103,"height":39},{"text":"핵심이","x":913,"y":1388,"width":103,"height":39},{"text":"된다.","x":1034,"y":1388,"width":80,"height":38}]},{"text":"5.1.1 CPU-I/O 버쓰 사이클 CPU-I/O Burst cycle","words":[{"text":"5.1.1","x":315,"y":1512,"width":107,"height":33},{"text":"CPU-I/O","x":471,"y":1510,"width":161,"height":35},{"text":"버쓰","x":648,"y":1510,"width":98,"height":35},{"text":"사이클","x":756,"y":1510,"width":102,"height":36},{"text":"CPU-I/O","x":887,"y":1519,"width":135,"height":24},{"text":"Burst","x":1033,"y":1520,"width":92,"height":22},{"text":"cycle","x":1135,"y":1518,"width":95,"height":29}]},{"text":"CPU 스케줄링의 성공은 프로세스들의 다음과 같은 관찰된 성질에 의해 좌우된다. 프로","words":[{"text":"CPU","x":313,"y":1595,"width":85,"height":32},{"text":"스케줄링의","x":412,"y":1590,"width":171,"height":40},{"text":"성공은","x":601,"y":1590,"width":106,"height":40},{"text":"프로세스들의","x":719,"y":1590,"width":213,"height":40},{"text":"다음과","x":950,"y":1590,"width":110,"height":40},{"text":"같은","x":1072,"y":1589,"width":74,"height":39},{"text":"관찰된","x":1159,"y":1589,"width":110,"height":39},{"text":"성질에","x":1285,"y":1588,"width":109,"height":40},{"text":"의해","x":1412,"y":1589,"width":71,"height":40},{"text":"좌우된다.","x":1500,"y":1589,"width":161,"height":39},{"text":"프로","x":1678,"y":1594,"width":68,"height":31}]},{"text":"세스 실행은 CPU 실행과 I/O 대기의 사이클로 구성된다. 프로세스들은 이들 두 상태","words":[{"text":"세스","x":313,"y":1657,"width":71,"height":39},{"text":"실행은","x":400,"y":1657,"width":105,"height":39},{"text":"CPU","x":519,"y":1660,"width":84,"height":32},{"text":"실행과","x":620,"y":1657,"width":106,"height":39},{"text":"I/O","x":739,"y":1659,"width":71,"height":37},{"text":"대기의","x":829,"y":1657,"width":103,"height":39},{"text":"사이클로","x":952,"y":1656,"width":145,"height":40},{"text":"구성된다.","x":1113,"y":1655,"width":156,"height":40},{"text":"프로세스들은","x":1288,"y":1655,"width":226,"height":39},{"text":"이들","x":1533,"y":1655,"width":75,"height":40},{"text":"두","x":1624,"y":1657,"width":38,"height":37},{"text":"상태","x":1676,"y":1657,"width":67,"height":41}]},{"text":"사이를 교대로 왔다 갔다 한다. 프로세스 실행은 CPU 버스트(burst)로 시작된다. 뒤이","words":[{"text":"사이를","x":311,"y":1723,"width":108,"height":40},{"text":"교대로","x":432,"y":1723,"width":106,"height":40},{"text":"왔다","x":552,"y":1723,"width":71,"height":40},{"text":"갔다","x":638,"y":1723,"width":70,"height":41},{"text":"한다.","x":721,"y":1723,"width":79,"height":40},{"text":"프로세스","x":818,"y":1722,"width":144,"height":40},{"text":"실행은","x":977,"y":1723,"width":110,"height":39},{"text":"CPU","x":1102,"y":1727,"width":88,"height":31},{"text":"버스트(burst)로","x":1208,"y":1722,"width":275,"height":42},{"text":"시작된다.","x":1499,"y":1721,"width":159,"height":40},{"text":"뒤이","x":1678,"y":1723,"width":64,"height":42}]},{"text":"어 1/0 버스트가 발생하고, 그 뒤를 이어 또 다른 CPU 버스트가 발생하며, 이어 또 다","words":[{"text":"어","x":311,"y":1789,"width":30,"height":40},{"text":"1/0","x":360,"y":1793,"width":60,"height":31},{"text":"버스트가","x":439,"y":1790,"width":141,"height":40},{"text":"발생하고,","x":594,"y":1791,"width":149,"height":40},{"text":"그","x":760,"y":1796,"width":35,"height":27},{"text":"뒤를","x":811,"y":1790,"width":71,"height":41},{"text":"이어","x":898,"y":1790,"width":66,"height":40},{"text":"또","x":983,"y":1795,"width":36,"height":29},{"text":"다른","x":1035,"y":1790,"width":73,"height":40},{"text":"CPU","x":1122,"y":1793,"width":89,"height":32},{"text":"버스트가","x":1230,"y":1788,"width":148,"height":42},{"text":"발생하며,","x":1392,"y":1788,"width":160,"height":41},{"text":"이어","x":1572,"y":1788,"width":69,"height":40},{"text":"또","x":1661,"y":1794,"width":37,"height":28},{"text":"다","x":1713,"y":1792,"width":34,"height":40}]},{"text":"른 I/O 버스트 등등으로 진행된다. 결국 마지막 CPU 버스트는 또 다른 1/0 버스트가","words":[{"text":"른","x":309,"y":1858,"width":36,"height":37},{"text":"I/O","x":358,"y":1858,"width":70,"height":38},{"text":"버스트","x":446,"y":1857,"width":104,"height":39},{"text":"등등으로","x":564,"y":1859,"width":142,"height":39},{"text":"진행된다.","x":722,"y":1857,"width":149,"height":41},{"text":"결국","x":889,"y":1858,"width":71,"height":39},{"text":"마지막","x":975,"y":1857,"width":110,"height":41},{"text":"CPU","x":1098,"y":1861,"width":89,"height":32},{"text":"버스트는","x":1205,"y":1858,"width":147,"height":40},{"text":"또","x":1366,"y":1860,"width":38,"height":29},{"text":"다른","x":1420,"y":1855,"width":75,"height":40},{"text":"1/0","x":1508,"y":1858,"width":76,"height":37},{"text":"버스트가","x":1602,"y":1856,"width":146,"height":43}]},{"text":"뒤따르는 대신, 실행을 종료하기 위한 시스템 요청과 함께 끝난다(그림 5.1).","words":[{"text":"뒤따르는","x":311,"y":1923,"width":140,"height":40},{"text":"대신,","x":464,"y":1924,"width":78,"height":41},{"text":"실행을","x":558,"y":1925,"width":106,"height":39},{"text":"종료하기","x":675,"y":1925,"width":139,"height":39},{"text":"위한","x":833,"y":1925,"width":71,"height":41},{"text":"시스템","x":916,"y":1925,"width":105,"height":40},{"text":"요청과","x":1037,"y":1925,"width":112,"height":40},{"text":"함께","x":1160,"y":1926,"width":72,"height":40},{"text":"끝난다(그림","x":1248,"y":1923,"width":196,"height":45},{"text":"5.1).","x":1462,"y":1927,"width":77,"height":40}]},{"text":"이들 CPU 버스트들의 지속 시간을 광범위하게 측정하였다. 이들은 프로세스마다","words":[{"text":"이들","x":377,"y":1990,"width":70,"height":40},{"text":"CPU","x":462,"y":1995,"width":84,"height":32},{"text":"버스트들의","x":566,"y":1992,"width":173,"height":40},{"text":"지속","x":761,"y":1992,"width":71,"height":39},{"text":"시간을","x":850,"y":1992,"width":108,"height":40},{"text":"광범위하게","x":975,"y":1992,"width":180,"height":41},{"text":"측정하였다.","x":1175,"y":1993,"width":196,"height":41},{"text":"이들은","x":1394,"y":1991,"width":112,"height":41},{"text":"프로세스마다","x":1523,"y":1991,"width":225,"height":42}]},{"text":"그리고 컴퓨터마다 상당히 변화가 크지만, 그림 5.2에 보인 바와 유사한 빈도수 곡선을","words":[{"text":"그리고","x":312,"y":2057,"width":104,"height":41},{"text":"컴퓨터마다","x":433,"y":2059,"width":174,"height":41},{"text":"상당히","x":621,"y":2059,"width":103,"height":40},{"text":"변화가","x":746,"y":2059,"width":107,"height":40},{"text":"크지만,","x":868,"y":2059,"width":116,"height":41},{"text":"그림","x":1001,"y":2059,"width":68,"height":40},{"text":"5.2에","x":1089,"y":2060,"width":87,"height":39},{"text":"보인","x":1195,"y":2061,"width":74,"height":38},{"text":"바와","x":1287,"y":2060,"width":76,"height":41},{"text":"유사한","x":1377,"y":2058,"width":115,"height":41},{"text":"빈도수","x":1509,"y":2058,"width":114,"height":40},{"text":"곡선을","x":1638,"y":2059,"width":110,"height":39}]},{"text":"갖는 경향이 있다. 이 곡선은 일반적으로 지수형 또는 초지수형(hyperexponential)으","words":[{"text":"갖는","x":313,"y":2125,"width":70,"height":40},{"text":"경향이","x":399,"y":2125,"width":99,"height":42},{"text":"있다.","x":520,"y":2127,"width":74,"height":40},{"text":"이","x":613,"y":2126,"width":29,"height":40},{"text":"곡선은","x":662,"y":2126,"width":106,"height":40},{"text":"일반적으로","x":786,"y":2126,"width":177,"height":40},{"text":"지수형","x":980,"y":2126,"width":103,"height":40},{"text":"또는","x":1102,"y":2129,"width":76,"height":36},{"text":"초지수형(hyperexponential)으","x":1192,"y":2128,"width":555,"height":45}]},{"text":"로 특성화된다. 짧은 CPU 버스트가 많이 있으며, 긴 CPU 버스트는 적다. I/O 중심의","words":[{"text":"로","x":312,"y":2197,"width":35,"height":29},{"text":"특성화된다.","x":361,"y":2193,"width":183,"height":41},{"text":"짧은","x":560,"y":2194,"width":71,"height":39},{"text":"CPU","x":643,"y":2196,"width":84,"height":33},{"text":"버스트가","x":744,"y":2193,"width":142,"height":39},{"text":"많이","x":900,"y":2193,"width":67,"height":39},{"text":"있으며,","x":989,"y":2193,"width":114,"height":40},{"text":"긴","x":1121,"y":2194,"width":33,"height":37},{"text":"CPU","x":1171,"y":2197,"width":90,"height":32},{"text":"버스트는","x":1278,"y":2195,"width":149,"height":39},{"text":"적다.","x":1443,"y":2194,"width":83,"height":39},{"text":"I/O","x":1544,"y":2196,"width":76,"height":36},{"text":"중심의","x":1636,"y":2193,"width":107,"height":41}]},{"text":"프로그램은 전형적으로 짧은 CPU 버스트를 많이 가질 것이다. CPU 지향 프로그램은","words":[{"text":"프로그램은","x":312,"y":2260,"width":177,"height":39},{"text":"전형적으로","x":505,"y":2261,"width":173,"height":39},{"text":"짧은","x":693,"y":2259,"width":70,"height":40},{"text":"CPU","x":777,"y":2263,"width":85,"height":31},{"text":"버스트를","x":881,"y":2259,"width":141,"height":40},{"text":"많이","x":1038,"y":2259,"width":68,"height":40},{"text":"가질","x":1127,"y":2259,"width":71,"height":39},{"text":"것이다.","x":1219,"y":2260,"width":118,"height":40},{"text":"CPU","x":1356,"y":2264,"width":90,"height":31},{"text":"지향","x":1466,"y":2261,"width":77,"height":39},{"text":"프로그램은","x":1558,"y":2260,"width":189,"height":39}]},{"text":"다수의 긴 CPU 버스트를 가질 수 있다. 이러한 분포는 CPU 스케줄링 알고리즘을 구현","words":[{"text":"다수의","x":312,"y":2326,"width":102,"height":41},{"text":"긴","x":432,"y":2327,"width":32,"height":38},{"text":"CPU","x":479,"y":2331,"width":83,"height":31},{"text":"버스트를","x":578,"y":2327,"width":137,"height":40},{"text":"가질","x":729,"y":2325,"width":66,"height":42},{"text":"수","x":809,"y":2326,"width":36,"height":41},{"text":"있다.","x":860,"y":2325,"width":75,"height":42},{"text":"이러한","x":953,"y":2325,"width":107,"height":40},{"text":"분포는","x":1072,"y":2327,"width":111,"height":37},{"text":"CPU","x":1196,"y":2329,"width":90,"height":33},{"text":"스케줄링","x":1300,"y":2327,"width":147,"height":40},{"text":"알고리즘을","x":1467,"y":2327,"width":192,"height":40},{"text":"구현","x":1672,"y":2326,"width":72,"height":40}]},{"text":"할 때 매우 중요할 수 있다.","words":[{"text":"할","x":312,"y":2393,"width":36,"height":39},{"text":"때","x":361,"y":2393,"width":30,"height":39},{"text":"매우","x":408,"y":2393,"width":71,"height":39},{"text":"중요할","x":490,"y":2394,"width":107,"height":40},{"text":"수","x":608,"y":2395,"width":36,"height":39},{"text":"있다.","x":658,"y":2393,"width":74,"height":40}]},{"text":"5.1.2 CPU 스케줄러 scheduler","words":[{"text":"5.1.2","x":313,"y":2517,"width":121,"height":33},{"text":"CPU","x":482,"y":2519,"width":81,"height":34},{"text":"스케줄러","x":577,"y":2517,"width":131,"height":37},{"text":"scheduler","x":817,"y":2527,"width":164,"height":23}]},{"text":"CPU가 유휴 상태가 될 때마다, 운영체제는 준비 큐에 있는 프로세스 중에서 하나를 선","words":[{"text":"CPU가","x":313,"y":2598,"width":121,"height":40},{"text":"유휴","x":447,"y":2598,"width":71,"height":41},{"text":"상태가","x":531,"y":2600,"width":108,"height":39},{"text":"될","x":653,"y":2599,"width":32,"height":39},{"text":"때마다,","x":703,"y":2599,"width":111,"height":40},{"text":"운영체제는","x":829,"y":2598,"width":174,"height":41},{"text":"준비","x":1016,"y":2596,"width":67,"height":40},{"text":"큐에","x":1101,"y":2597,"width":69,"height":39},{"text":"있는","x":1191,"y":2597,"width":72,"height":40},{"text":"프로세스","x":1277,"y":2599,"width":151,"height":40},{"text":"중에서","x":1443,"y":2600,"width":113,"height":40},{"text":"하나를","x":1577,"y":2598,"width":115,"height":42},{"text":"선","x":1708,"y":2597,"width":36,"height":39}]}]}