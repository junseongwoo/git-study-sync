{"page":451,"width":1673,"height":2520,"text_angle":0,"lines":[{"text":"512","words":[{"text":"512","x":185,"y":144,"width":57,"height":27}]},{"text":"Chapter 11 대용량 자장,장弋| 구조","words":[{"text":"Chapter","x":312,"y":146,"width":113,"height":27},{"text":"11","x":437,"y":148,"width":27,"height":20},{"text":"대용량","x":494,"y":148,"width":62,"height":25},{"text":"자장,장弋|","x":564,"y":149,"width":82,"height":24},{"text":"구조","x":654,"y":149,"width":41,"height":23}]},{"text":"리 메모리를 뽼 만큼을 제인한다. 과거에 Linux는 물리 메모리 그기에 두 배를 제안하","words":[{"text":"리","x":315,"y":268,"width":24,"height":34},{"text":"메모리를","x":357,"y":267,"width":119,"height":35},{"text":"뽼","x":490,"y":269,"width":28,"height":34},{"text":"만큼을","x":532,"y":269,"width":87,"height":35},{"text":"제인한다.","x":633,"y":269,"width":119,"height":35},{"text":"과거에","x":768,"y":268,"width":85,"height":36},{"text":"Linux는","x":868,"y":270,"width":121,"height":33},{"text":"물리","x":1002,"y":269,"width":58,"height":35},{"text":"메모리","x":1078,"y":269,"width":90,"height":35},{"text":"그기에","x":1187,"y":270,"width":94,"height":34},{"text":"두","x":1298,"y":272,"width":33,"height":32},{"text":"배를","x":1346,"y":270,"width":65,"height":34},{"text":"제안하","x":1427,"y":270,"width":92,"height":35}]},{"text":"였다. 현재는 페이징 알고리즘이 발전하였으며 대부분의 Linux 시스템들은 그보다 훨씬","words":[{"text":"였다.","x":314,"y":325,"width":65,"height":34},{"text":"현재는","x":393,"y":325,"width":89,"height":34},{"text":"페이징","x":493,"y":326,"width":83,"height":35},{"text":"알고리즘이","x":591,"y":326,"width":141,"height":35},{"text":"발전하였으며","x":746,"y":326,"width":172,"height":35},{"text":"대부분의","x":934,"y":326,"width":118,"height":36},{"text":"Linux","x":1066,"y":329,"width":93,"height":28},{"text":"시스템들은","x":1174,"y":327,"width":162,"height":35},{"text":"그보다","x":1348,"y":326,"width":98,"height":34},{"text":"훨씬","x":1458,"y":327,"width":60,"height":35}]},{"text":"작은 스왑 공간을 시용한다.","words":[{"text":"작은","x":312,"y":382,"width":60,"height":34},{"text":"스왑","x":383,"y":382,"width":61,"