ht":35},{"text":"별도의","x":906,"y":794,"width":86,"height":36},{"text":"파티션을","x":1009,"y":794,"width":126,"height":36},{"text":"만들어","x":1148,"y":795,"width":93,"height":35},{"text":"시용할","x":1258,"y":795,"width":100,"height":35},{"text":"수도","x":1371,"y":795,"width":64,"height":35},{"text":"있다.","x":1451,"y":794,"width":65,"height":36}]},{"text":"스왑 공간이 만일 하나의 커다란 파일이라면, 통상의 파일 시스템 루틴을 시용하여 스왑","words":[{"text":"스왑","x":308,"y":850,"width":62,"height":34},{"text":"공간이","x":380,"y":850,"width":87,"height":36},{"text":"만일","x":482,"y":851,"width":56,"height":35},{"text":"하나의","x":551,"y":851,"width":84,"height":35},{"text":"커다란","x":651,"y":850,"width":86,"height":36},{"text":"파일이라면,","x":747,"y":850,"width":155,"height":38},{"text":"통상의","x":915,"y":853,"width":89,"height":35},{"text":"파일","x":1019,"y":853,"width":60,"height":35},{"text":"시스템","x":1095,"y":853,"width":91,"height":35},{"text":"루틴을","x":1202,"y":854,"width":99,"height":34},{"text":"시용하여","x":1314,"y":853,"width":126,"height":35},{"text":"스왑","x":1456,"y":853,"width":63,"height":34}]},{"text":"공간을 생성/삭제하고, 스왑 공간을 관리할 수 있다.","words":[{"text":"공간을","x":307,"y":908,"width":92,"height":34},{"text":"생성/삭제하고,","x":409,"y":909,"width":204,"height":36},{"text":"스왑","x":625,"y":909,"width":58,"height":34},{"text":"공간을","x":692,"y":908,"width":89,"height":35},{"text":"관리할","x":790,"y":909,"width":90,"height":35},{"text":"수","x":890,"y":910,"width":31,"height":35},{"text":"있다.","x":934,"y":911,"width":64,"height":34}]},{"text":"그 대신에, 스왑 공간은 별도의 raw 파티션에 만들어질 수 있다. 그리고 일반 파일","words":[{"text":"그","x":364,"y":971,"width":30,"height":23},{"text":"대신에,","x":408,"y":966,"width":95,"height":36},{"text":"스왑","x":517,"y":968,"width":59,"height":34},{"text":"공간은","x":587,"y":967,"width":88,"height":35},{"text":"별도의","x":688,"y":967,"width":83,"height":34},{"text":"raw","x":787,"y":979,"width":58,"height":18},{"text":"파티션에","x":858,"y":968,"width":118,"height":35},{"text":"만들어질","x":992,"y":969,"width":123,"height":35},{"text":"수","x":1131,"y":970,"width":32,"height":34},{"text":"있다.","x":1180,"y":970,"width":69,"height":34},{"text":"그리고","x":1265,"y":970,"width":100,"height":35},{"text":"일반","x":1381,"y":969,"width":63,"height":34},{"text":"파일","x":1456,"y":969,"width":59,"height":34}]},{"text":"이나 디렉터리는 이 공간에 저장되지 않는다. 이 파티션은 별도의 스왑 관리루틴에 의해","words":[{"text":"이나","x":308,"y":1024,"width":60,"height":34},{"text":"디렉터리는","x":381,"y":1024,"width":147,"height":35},{"text":"이","x":540,"y":1025,"width":24,"height":35},{"text":"공간에","x":578,"y":1025,"width":85,"height":35},{"text":"저장되지","x":678,"y":1025,"width":112,"height":35},{"text":"않는다.","x":807,"y":1025,"width":94,"height":36},{"text":"이","x":917,"y":1026,"width":24,"height":36},{"text":"파티션은","x":957,"y":1027,"width":125,"height":35},{"text":"별도의","x":1096,"y":1027,"width":91,"height":35},{"text":"스왑","x":1203,"y":1028,"width":67,"height":34},{"text":"관리루틴에","x":1281,"y":1027,"width":160,"height":36},{"text":"의해","x":1457,"y":1026,"width":58,"height":36}]},{"text":"스와핑을 하는 데에만 시용된다. 스왑 관리 루틴은 공간 효율성보다는 속도 효율성을 최","words":[{"text":"스와핑을","x":307,"y":1082,"width":121,"height":35},{"text":"하는","x":440,"y":1083,"width":59,"height":34},{"text":"데에만","x":510,"y":1083,"width":88,"height":35},{"text":"시용된다.","x":608,"y":1083,"width":122,"height":35},{"text":"스왑","x":744,"y":1084,"width":60,"height":35},{"text":"관리","x":813,"y":1084,"width":57,"height":35},{"text":"루틴은","x":885,"y":1085,"width":91,"height":34},{"text":"공간","x":987,"y":1085,"width":64,"height":35},{"text":"효율성보다는","x":1062,"y":1085,"width":194,"height":35},{"text":"속도","x":1267,"y":1086,"width":68,"height":34},{"text":"효율성을","x":1347,"y":1084,"width":129,"height":35},{"text":"최","x":1489,"y":1085,"width":25,"height":34}]},{"text":"적화하기 위한 알고리즘을 시용한다. 왜냐하면 스왑 공간은 시용될 때 파일 시스템보다","words":[{"text":"적화하기","x":307,"y":1140,"width":117,"height":35},{"text":"위한","x":441,"y":1141,"width":59,"height":34},{"text":"알고리즘을","x":513,"y":1141,"width":144,"height":35},{"text":"시용한다.","x"