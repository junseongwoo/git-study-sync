{"page":33,"width":1912,"height":2893,"text_angle":0,"lines":[{"text":"1.5 자원 관리","words":[{"text":"1.5","x":1398,"y":179,"width":52,"height":24},{"text":"자원","x":1467,"y":179,"width":49,"height":28},{"text":"관리","x":1526,"y":179,"width":48,"height":28}]},{"text":"Linux 다이매","words":[{"text":"Linux","x":898,"y":370,"width":106,"height":33},{"text":"다이매","x":1021,"y":367,"width":100,"height":42}]},{"text":"29","words":[{"text":"29","x":1654,"y":174,"width":42,"height":30}]},{"text":"Linux 시스템에서 커널 구성 매개변수 HZ는 타이머 인터럽트의 발생 빈도를 지정","words":[{"text":"Linux","x":373,"y":456,"width":103,"height":34},{"text":"시스템에서","x":490,"y":455,"width":168,"height":41},{"text":"커널","x":677,"y":456,"width":64,"height":40},{"text":"구성","x":756,"y":456,"width":65,"height":41},{"text":"매개변수","x":839,"y":457,"width":137,"height":41},{"text":"HZ는","x":987,"y":459,"width":77,"height":37},{"text":"타이머","x":1077,"y":456,"width":99,"height":41},{"text":"인터럽트의","x":1196,"y":455,"width":169,"height":42},{"text":"발생","x":1382,"y":456,"width":65,"height":40},{"text":"빈도를","x":1466,"y":455,"width":105,"height":40},{"text":"지정","x":1584,"y":456,"width":66,"height":40}]},{"text":"한다. 250의 HZ 값은 타이머가 초당 250개의 인터럽트를 생성하거나 4밀리초마다","words":[{"text":"한다.","x":373,"y":520,"width":77,"height":40},{"text":"250의","x":466,"y":522,"width":91,"height":40},{"text":"HZ","x":573,"y":528,"width":40,"height":28},{"text":"값은","x":629,"y":521,"width":68,"height":41},{"text":"타이머가","x":710,"y":521,"width":138,"height":42},{"text":"초당","x":860,"y":524,"width":69,"height":40},{"text":"250개의","x":940,"y":523,"width":126,"height":41},{"text":"인터럽트를","x":1085,"y":522,"width":171,"height":41},{"text":"생성하거나","x":1269,"y":522,"width":176,"height":42},{"text":"4밀리초마다","x":1456,"y":522,"width":200,"height":41}]},{"text":"1개의 인터럽트를 발생하는 것을 의미한다. HZ의 값은 커널이 구성되는 방법과 커","words":[{"text":"1개의","x":374,"y":587,"width":86,"height":40},{"text":"인터럽트를","x":479,"y":588,"width":170,"height":40},{"text":"발생하는","x":663,"y":588,"width":137,"height":41},{"text":"것을","x":814,"y":589,"width":68,"height":40},{"text":"의미한다.","x":895,"y":590,"width":144,"height":41},{"text":"HZ의","x":1054,"y":589,"width":73,"height":41},{"text":"값은","x":1144,"y":589,"width":71,"height":40},{"text":"커널이","x":1229,"y":589,"width":98,"height":41},{"text":"구성되는","x":1344,"y":589,"width":142,"height":41},{"text":"방법과","x":1499,"y":588,"width":107,"height":41},{"text":"커","x":1620,"y":589,"width":30,"height":41}]},{"text":"널이 실행되는 시스템 유형 및 아기텍처에 따라 다르다. 관련된 커널 변수는 jif-","words":[{"text":"널이","x":375,"y":652,"width":64,"height":41},{"text":"실행되는","x":458,"y":653,"width":137,"height":41},{"text":"시스템","x":609,"y":654,"width":99,"height":40},{"text":"유형","x":725,"y":654,"width":64,"height":41},{"text":"및","x":808,"y":656,"width":31,"height":40},{"text":"아기텍처에","x":855,"y":656,"width":167,"height":40},{"text":"따라","x":1040,"y":656,"width":69,"height":40},{"text":"다르다.","x":1122,"y":655,"width":110,"height":42},{"text":"관련된","x":1248,"y":655,"width":104,"height":40},{"text":"커널","x":1369,"y":656,"width":66,"height":41},{"text":"변수는","x":1452,"y":656,"width":104,"height":40},{"text":"jif-","x":1569,"y":662,"width":84,"height":37}]},{"text":"fies이며 시스템 부팅 이후 발생한 타이머 인터럽트 개수를 나타낸다. 2장의 프로","words":[{"text":"fies이며","x":373,"y":720,"width":150,"height":40},{"text":"시스템","x":541,"y":720,"width":98,"height":40},{"text":"부팅","x":655,"y":721,"width":64,"height":39},{"text":"이후","x":738,"y":720,"width":68,"height":41},{"text":"발생한","x":818,"y":721,"width":104,"height":40},{"text":"타이머","x":933,"y":722,"width":99,"height":40},{"text":"인터럽트","x":1051,"y":722,"width":136,"height":40},{"text":"개수를","x":1201,"y":723,"width":104,"height":39},{"text":"나타낸다.","x":1317,"y":722,"width":147,"height":41},{"text":"2장의","x":1479,"y":722,"width":87,"height":41},{"text":"프로","x":1583,"y":727,"width":71,"height":30}]},{"text":"그래밍 프로젝트는 Linux 커널에서의 타이밍을 더 탐구한다.","words":[{"text":"그래밍","x":373,"y":786,"width":100,"height":40},{"text":"프로젝트는","x":489,"y":786,"width