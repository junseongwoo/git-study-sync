{"page":419,"width":1739,"height":2675,"text_angle":0,"lines":[{"text":"10.9 기타고려사항 479","words":[{"text":"10.9","x":1147,"y":155,"width":70,"height":23},{"text":"기타고려사항","x":1234,"y":153,"width":156,"height":29},{"text":"479","x":1463,"y":149,"width":59,"height":30}]},{"text":"방식에서는 디스크에 블록을 쓰기 위해서는 해당 블록을 담고 있는 페이지를 일단 잠가","words":[{"text":"방식에서는","x":267,"y":285,"width":166,"height":39},{"text":"디스크에","x":448,"y":285,"width":124,"height":39},{"text":"블록을","x":589,"y":286,"width":93,"height":37},{"text":"쓰기","x":695,"y":288,"width":56,"height":37},{"text":"위해서는","x":768,"y":288,"width":120,"height":38},{"text":"해당","x":901,"y":288,"width":61,"height":38},{"text":"블록을","x":974,"y":287,"width":93,"height":38},{"text":"담고","x":1080,"y":287,"width":63,"height":37},{"text":"있는","x":1158,"y":287,"width":63,"height":38},{"text":"페이지를","x":1234,"y":287,"width":130,"height":38},{"text":"일단","x":1380,"y":286,"width":65,"height":38},{"text":"잠가","x":1458,"y":287,"width":68,"height":39}]},{"text":"야 한다. 시스템은 예전처럼 수행을 계속할 수 있다. I/0가 완료될 때 그 페이지의 잠금","words":[{"text":"야","x":267,"y":348,"width":33,"height":38},{"text":"한다.","x":313,"y":349,"width":73,"height":37},{"text":"시스템은","x":403,"y":348,"width":130,"height":37},{"text":"예전처럼","x":546,"y":348,"width":121,"height":38},{"text":"수행을","x":682,"y":349,"width":91,"height":38},{"text":"계속할","x":786,"y":350,"width":89,"height":38},{"text":"수","x":886,"y":350,"width":31,"height":37},{"text":"있다.","x":930,"y":350,"width":66,"height":37},{"text":"I/0가","x":1010,"y":349,"width":93,"height":38},{"text":"완료될","x":1115,"y":350,"width":93,"height":37},{"text":"때","x":1224,"y":350,"width":27,"height":37},{"text":"그","x":1268,"y":355,"width":32,"height":26},{"text":"페이지의","x":1315,"y":349,"width":127,"height":39},{"text":"잠금","x":1458,"y":350,"width":67,"height":38}]},{"text":"은 해제된다.","words":[{"text":"은","x":266,"y":411,"width":35,"height":35},{"text":"해제된다.","x":314,"y":410,"width":138,"height":38}]},{"text":"잠금 비트는 다양한 상황에서 A卜%된다. 빈번하게 운영체제 커널의 일부 혹은 전체","words":[{"text":"잠금","x":330,"y":472,"width":67,"height":37},{"text":"비트는","x":413,"y":473,"width":98,"height":37},{"text":"다양한","x":525,"y":473,"width":96,"height":38},{"text":"상황에서","x":633,"y":474,"width":119,"height":38},{"text":"A卜%된다.","x":769,"y":475,"width":126,"height":37},{"text":"빈번하게","x":913,"y":474,"width":117,"height":38},{"text":"운영체제","x":1046,"y":475,"width":123,"height":38},{"text":"커널의","x":1187,"y":475,"width":92,"height":39},{"text":"일부","x":1299,"y":476,"width":64,"height":38},{"text":"혹은","x":1376,"y":476,"width":68,"height":36},{"text":"전체","x":1460,"y":476,"width":62,"height":38}]},{"text":"를 메모리에 잠근다. 많은 운영체제가 메모리 관리를 담당하는 부분을 포함하여 커널 또","words":[{"text":"를","x":267,"y":536,"width":34,"height":35},{"text":"메모리에","x":314,"y":534,"width":130,"height":37},{"text":"잠근다.","x":461,"y":534,"width":104,"height":38},{"text":"많은","x":580,"y":536,"width":63,"height":37},{"text":"운영체제가","x":655,"y":536,"width":152,"height":39},{"text":"메모리","x":819,"y":537,"width":85,"height":38},{"text":"관리를","x":920,"y":537,"width":90,"height":37},{"text":"담당하는","x":1022,"y":537,"width":125,"height":38},{"text":"부분을","x":1158,"y":538,"width":98,"height":37},{"text":"포함하여","x":1268,"y":538,"width":126,"height":38},{"text":"커널","x":1413,"y":539,"width":62,"height":37},{"text":"또","x":1491,"y":543,"width":35,"height":27}]},{"text":"는 특정 커널 모듈에서 발생하는 페이지 폴트를 처리할 수 없다. 또한 사용자 프로세스","words":[{"text":"는","x":271,"y":599,"width":25,"height":33},{"text":"특정","x":315,"y":596,"width":63,"height":37},{"text":"커널","x":400,"y":596,"width":60,"height":37},{"text":"모듈에서","x":478,"y":597,"width":126,"height":38},{"text":"발생하는","x":622,"y":598,"width":124,"height":37},{"text":"페이지","x":760,"y":599,"width":84,"height":38},{"text":"폴트를","x":860,"y":600,"width":91,"height":35},{"text":"처리할","x":967,"y":600,"width":89,"height":37},{"text":"수","x":1069,"y":600,"width":32,"height":37},{"text":"없다.","x":1116,"y":600,"width":67,"height":37},{"text":"또한","x":1200,"y":601,"width":66,"height":37},{"text":"사용자","x":1278,"y":601,"width":99,"height":38},{"text":"프로세스","x":1390,"y":601,"width":135,"height":38}]},{"text":"도 페이지를 메모리에 잠글 필요가 있다. 예를 들어, 데이터베이스 프로세스는 데이터 사","words":[{"text":"도","x":267,"y":663,"width":33,"height":27},{"text":"페이지를","x":314,"y":658,"width":133,"height":37},{"text":"메모리에","x":460,"y":658,"width":126,"height":38},{"text":"잠글","x":601,"y":660,"width":63,"height":36},{"text":"필요가","x":677,"y":660,"width":90,"height":38},{"text":"있다.","x":780,"y":661,"width":64,"height":37},{"text":"예를","x":858,"y":660,"width":59,"height":38},{"text":"들어,","x":928,"y":662,"width":67,"height":37},{"text":"데이터베이스","x":1008,"y":662,"width":186,"height":38},{"text":"프로세스는","x":1205,"y":664,"width":163,"height":37},{"text":"데이터","x":1381,"y":664,"width":93,"height":37},{"text":"사","x":1491,"y":664,"width":35,"height":38}]},{"text":"용방식에 관해 자신이 제일 잘 알고 있으므로 메모리와 보조저장장치 사이의 블록을 이","words":[{"text":"용방식에","x":266,"y":720,"width":133,"height":38},{"text":"관해","x":416,"y":720,"width":63,"height":37},{"text":"자신이","x":496,"y":720,"width":92,"height":38},{"text":"제일","x":607,"y":722,"width":59,"height":36},{"text":"잘","x":682,"y":722,"width":31,"height":36},{"text":"알고","x":726,"y":723,"width":60,"height":35},{"text":"있으므로","x":800,"y":723,"width":118,"height":37},{"text":"메모리와","x":931,"y":723,"width":122,"height":38},{"text":"보조저장장치","x":1065,"y":725,"width":184,"height":38},{"text":"사이의","x":1267,"y":727,"width":94,"height":37},{"text":"블록을","x":1378,"y":726,"width":100,"height":37},{"text":"이","x":1493,"y":727,"width":28,"height":37}]},{"text":"동시기는 데 이러한 필요한 메모리 영역을 직접 관리하기를 원할 수 있다. 이러한 페이","words":[{"text":"동시기는","x":266,"y":782,"width":136,"height":39},{"text":"데","x":417,"y":782,"width":29,"height":37},{"text":"이러한","x":466,"y":782,"width":97,"height":37},{"text":"필요한","x":578,"y":783,"width":94,"height":36},{"text":"메모리","x":686,"y":784,"width":87,"height":37},{"text":"영역을","x":793,"y":785,"width":88,"height":37},{"text":"직접","x":896,"y":785,"width":55,"height":37},{"text":"관리하기를","x":967,"y":786,"width":153,"height":38},{"text":"원할","x":1135,"y":787,"width":62,"height":37},{"text":"수","x":1209,"y":789,"width":33,"height":36},{"text":"있다.","x":1258,"y":789,"width":69,"height":37},{"text":"이러한","x":1346,"y":789,"width":98,"height":37},{"text":"페이","x":1458,"y":789,"width":63,"height":37}]},{"text":"지 고정(pmnmg)은 널리 시용되며 대부분의 운영체제에는 -응용이 자신의 영역을 메모","words":[{"text":"지","x":268,"y":846,"width":28,"height":36},{"text":"고정(pmnmg)은","x":314,"y":845,"width":259,"height":43},{"text":"널리","x":587,"y":845,"width":58,"height":37},{"text":"시용되며","x":663,"y":846,"width":119,"height":38},{"text":"대부분의","x":800,"y":847,"width":116,"height":37},{"text":"운영체제에는","x":932,"y":848,"width":183,"height":38},{"text":"-응용이","x":1127,"y":849,"width":90,"height":38},{"text":"자신의","x":1235,"y":850,"width":93,"height":37},{"text":"영역을","x":1348,"y":850,"width":97,"height":38},{"text":"메모","x":1458,"y":851,"width":67,"height":36}]},{"text":"리에 고정할 수 있도록 요청하는 시스템 콜이 한한다. 이러한 기능은 악용될 수 있으","words":[{"text":"리에","x":269,"y":907,"width":61,"height":38},{"text":"고정할","x":348,"y":907,"width":102,"height":37},{"text":"수","x":463,"y":907,"width":33,"height":37},{"text":"있도록","x":513,"y":906,"width":95,"height":38},{"text":"요청하는","x":621,"y":908,"width":126,"height":37},{"text":"시스템","x":761,"y":909,"width":88,"height":37},{"text":"콜이","x":865,"y":909,"width":57,"height":37},{"text":"한한다.","x":939,"y":910,"width":128,"height":37},{"text":"이러한","x":1083,"y":911,"width":92,"height":36},{"text":"기능은","x":1190,"y":912,"width":94,"height":36},{"text":"악용될","x":1299,"y":912,"width":94,"height":37},{"text":"수","x":1409,"y":913,"width":34,"height":35},{"text":"있으","x":1460,"y":912,"width":65,"height":36}]},{"text":"며 메모리 관리 알고리즘에 부담을 준다. 따라서 메모리 고정 요청을 하기 위해서 응용","words":[{"text":"며","x":268,"y":971,"width":28,"height":36},{"text":"메모리","x":315,"y":969,"width":96,"height":37},{"text":"관리","x":430,"y":969,"width":62,"height":37},{"text":"알고리즘에","x":512,"y":969,"width":157,"height":39},{"text":"부담을","x":685,"y":971,"width":93,"height":37},{"text":"준다.","x":791,"y":972,"width":68,"height":36},{"text":"따라서","x":875,"y":971,"width":87,"height":37},{"text":"메모리","x":979,"y":972,"width":87,"height":36},{"text":"고정","x":1083,"y":973,"width":57,"height":36},{"text":"요청을","x":1157,"y":974,"width":95,"height":35},{"text":"하기","x":1266,"y":974,"width":59,"height":37},{"text":"위해서","x":1345,"y":973,"width":93,"height":37},{"text":"응용","x":1456,"y":973,"width":70,"height":36}]},{"text":"은 특권을 가지고 있어야 한다.","words":[{"text":"은","x":266,"y":1034,"width":34,"height":35},{"text":"특권을","x":312,"y":1032,"width":101,"height":36},{"text":"가지고","x":426,"y":1032,"width":98,"height":37},{"text":"있어야","x":539,"y":1032,"width":94,"height":38},{"text":"한다.","x":644,"y":1033,"width":68,"height":37}]},{"text":"잠금 비트의 일반적인 페이지 교체 시의 사용 예를 보자. 우선순위가 낮은 프로세스","words":[{"text":"잠금","x":329,"y":1094,"width":67,"height":36},{"text":"비트의","x":412,"y":1094,"width":94,"height":37},{"text":"일반적인","x":525,"y":1095,"width":125,"height":36},{"text":"페이지","x":665,"y":1096,"width":88,"height":37},{"text":"교체","x":770,"y":1096,"width":58,"height":36},{"text":"시의","x":844,"y":1096,"width":57,"height":37},{"text":"사용","x":916,"y":1096,"width":61,"height":36},{"text":"예를","x":990,"y":1096,"width":60,"height":36},{"text":"보자.","x":1061,"y":1096,"width":67,"height":37},{"text":"우선순위가","x":1142,"y":1097,"width":158,"height":37},{"text":"낮은","x":1313,"y":1097,"width":66,"height":37},{"text":"프로세스","x":1390,"y":1094,"width":136,"height":36}]},{"text":"가 페이지 폴트를 발생, 필요한 페이지를 메모리로 읽어 들인다. 이어서 이 우선순위가","words":[{"text":"가","x":268,"y":1157,"width":33,"height":36},{"text":"페이지","x":316,"y":1155,"width":95,"height":37},{"text":"폴트를","x":430,"y":1157,"width":101,"height":35},{"text":"발생,","x":545,"y":1157,"width":72,"height":37},{"text":"필요한","x":635,"y":1157,"width":93,"height":36},{"text":"페이지를","x":742,"y":1158,"width":122,"height":36},{"text":"메모리로","x":87