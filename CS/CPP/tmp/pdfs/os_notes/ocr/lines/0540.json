41,"y":1784,"width":59,"height":36},{"text":"것들을","x":412,"y":1785,"width":86,"height":34},{"text":"수집하고","x":509,"y":1784,"width":115,"height":36},{"text":"시용","x":636,"y":1784,"width":59,"height":36},{"text":"기능한","x":707,"y":1784,"width":90,"height":36},{"text":"공간","x":808,"y":1784,"width":62,"height":36},{"text":"리스트에","x":883,"y":1785,"width":119,"height":36},{"text":"추가한다(비슷한","x":1018,"y":1786,"width":245,"height":38},{"text":"절차가","x":1277,"y":1787,"width":102,"height":35},{"text":"검색하는","x":1393,"y":1785,"width":126,"height":37}]},{"text":"동안 파일시스템의 모든 것을 한 번만 검색할 수 있다는 것을 보장하게 시용될 수 있다).","words":[{"text":"동안","x":299,"y":1844,"width":60,"height":35},{"text":"파일시스템의","x":370,"y":1843,"width":171,"height":36},{"text":"모든","x":555,"y":1846,"width":57,"height":32},{"text":"것을","x":624,"y":1844,"width":56,"height":35},{"text":"한","x":691,"y":1844,"width":30,"height":34},{"text":"번만","x":733,"y":1844,"width":59,"height":34},{"text":"검색할","x":804,"y":1844,"width":90,"height":35},{"text":"수","x":904,"y":1845,"width":31,"height":35},{"text":"있다는","x":949,"y":1845,"width":92,"height":35},{"text":"것을","x":1055,"y":1845,"width":64,"height":35},{"text":"보장하게","x":1130,"y":1846,"width":131,"height":36},{"text":"시용될","x":1277,"y":1846,"width":99,"height":35},{"text":"수","x":1390,"y":1846,"width":34,"height":35},{"text":"있다).","x":1439,"y":1844,"width":78,"height":38}]},{"text":"그러나 디스크 기반의 파일 시스템에서 가비지 컬렉션은 존재하면 시간을 매우 많이 소","words":[{"text":"그러나","x":300,"y":1903,"width":89,"height":35},{"text":"디스크","x":403,"y":1903,"width":85,"height":35},{"text":"기반의","x":501,"y":1904,"width":81,"height":35},{"text":"파일","x":597,"y":1904,"width":56,"height":34},{"text":"시스템에서","x":667,"y":1904,"width":143,"height":35},{"text":"가비지","x":827,"y":1904,"width":86,"height":35},{"text":"컬렉션은","x":932,"y":1904,"width":124,"height":35},{"text":"존재하면","x":1068,"y":1905,"width":131,"height":35},{"text":"시간을","x":1215,"y":1906,"width":102,"height":35},{"text":"매우","x":1330,"y":1905,"width":67,"height":36},{"text":"많이","x":1411,"y":1904,"width":60,"height":36},{"text":"소","x":1488,"y":1905,"width":30,"height":28}]},{"text":"모하므로, 좀처럼 이용되지는 않는다.","words":[{"text":"모하므로,","x":301,"y":1962,"width":124,"height":36},{"text":"좀처럼","x":437,"y":1962,"width":83,"height":35},{"text":"이용되지는","x":535,"y":1962,"width":143,"height":36},{"text":"않는다.","x":689,"y":1963,"width":93,"height":35}]},{"text":"가비지 컬렉션은 그래프에 순환이 생길 경우에만 필요하기 때문에 비순환 그래프는","words":[{"text":"가비지","x":358,"y":2021,"width":83,"height":35},{"text":"컬렉션은","x":458,"y":2021,"width":114,"height":35},{"text":"그래프에","x":583,"y":2021,"width":112,"height":35},{"text":"순환이","x":709,"y":2022,"width":84,"height":34},{"text":"생길","x":809,"y":2022,"width":58,"height":35},{"text":"경우에만","x":883,"y":2022,"width":122,"height":35},{"text":"필요하기","x":1018,"y":2022,"width":124,"height":36},{"text":"때문에","x":1161,"y":2024,"width":96,"height":34},{"text":"비순환","x":1276,"y":2023,"width":101,"height":36},{"text":"그래프는","x":1389,"y":2023,"width":128,"height":35}]},{"text":"다루기 훨씬 쉽다. 새로운 링크가 디렉터리 구조에 추가될 때 순환이 생기지 않도록 하","words":[{"text":"다루기","x":302,"y":2080,"width":84,"height":35},{"text":"훨씬","x":404,"y":2080,"width":56,"height":34},{"text":"쉽다.","x":475,"y":2081,"width":62,"height":34},{"text":"새로운","x":552,"y":2081,"width":86,"height":34},{"text":"링크가","x":652,"y":2080,"width":86,"height":36},{"text":"디렉터리","x":751,"y":2081,"width":113,"height":34},{"text":"구조에","x":881,"y":2081,"width":89,"height":35},{"text":"추가될","x":985,"y":2081,"width":94,"height":35},{"text":"때","x":1097,"y":2082,"width":28,"height":34},{"text":"순환이","x":1142,"y":2082,"width":97,"height":35},{"text":"생기지","x":1257,"y":2082,"width":98,"height":35},{"text":"않도록","x":1375,"y":2082,"width":98,"height":35},{"text":"하","x":1487,"y":2082,"width":31,"height":35}]},{"text":"는 것이 주된 일이다. 새로운 링크가 순흰을 만들지 어떻게 알 수 있을까? 그래프에 순환","words":[{"text":"는","x":301,"y":2141,"width":31,"height":31},{"text":"것이","x":344,"y":2139,"width":54,"height":34},{"text":"주된","x":412,"y":2139,"width":57,"height":34},{"text":"일이다.","x":483,"y":2139,"width":89,"height":35},{"text":"새로운","x":585,"y":2139,"width":86,"height":34},{"text":"링크가","x":683,"y":2139,"width":85,"height":35},{"text":"순흰을","x":778,"y":2140,"width":90,"height":33},{"text":"만들지","x":879,"y":2139,"width":87,"height":35},{"text":"어떻게","x":983,"y":2139,"width":90,"height":36},{"text":"알","x":1089,"y":2140,"width":31,"height":34},{"text":"수","x":1131,"y":2141,"width":34,"height":34},{"text":"있을까?","x":1179,"y":2141,"width":114,"height":35},{"text":"그래프에","x":1307,"y":2141,"width":133,"height":35},{"text":"순환","x":1453,"y":2142,"width":65,"height":34}]},{"text":"이 존재하는지 검색하는 알고리즘은 많이 있다. 하지만, 그래프가 디스크에 있을 때 그것","words":[{"text":"이","x":303,"y":2197,"width":25,"height":34},{"text":"존재하는지","x":342,"y":2198,"width":143,"height":34},{"text":"검색하는","x":501,"y":2198,"width":112,"height":34},{"text":"알고리즘은","x":624,"y":2197,"width":144,"height":35},{"text":"많이","x":778,"y":2198,"width":55,"height":35},{"text":"있다.","x":850,"y":2198,"width":63,"height":34},{"text":"하지만,","x":928,"y":2198,"width":99,"height":36},{"text":"그래프가","x":1040,"y":2199,"width":130,"height":35},{"text":"디스크에","x":1184,"y":2200,"width":130,"height":34},{"text":"있을","x":1331,"y":2200,"width":66,"height":35},{"text":"때","x":1410,"y":2200,"width":28,"height":36},{"text":"그것","x":1453,"y":2201,"width":62,"height":35}]},{"text":"들은 대부분 많은 계산량을 필요로 한다. 디렉터리와 링크의 특별한 경우에 좀 더 간단","words":[{"text":"들은","x":301,"y":2256,"width":60,"height":32},{"text":"대부분","x":376,"y":2255,"width":86,"height":35},{"text":"많은","x":475,"y":2256,"width":57,"height":35},{"text":"계산량을","x":546,"y":2256,"width":112,"height":35},{"text":"필요로","x":672,"y":2256,"width":85,"height":33},{"text":"한다.","x":770,"y":2256,"width":65,"height":35},{"text":"디렉터리와","x":853,"y":2256,"width":150,"height":35},{"text":"링크의","x":1018,"y":2257,"width":89,"height":34},{"text":"특별한","x":1124,"y":2257,"width":101,"height":34},{"text":"경우에","x":1240,"y":2258,"width":98,"height":35},{"text":"좀","x":1355,"y":2261,"width":36,"height":32},{"text":"더","x":1406,"y":2259,"width":27,"height":36},{"text":"간단","x":1452,"y":2260,"width":65,"height":35}]},{"text":"한 알고리즘은 디렉터리를 탐색하는 도중 링크는 검색하지 않는 것이다. 순환도 피할 수","words":[{"text":"한","x":301,"y":2313,"width":30,"height":32},{"text":"알고리즘은","x":343,"y":2313,"width":146,"height":34},{"text":"디렉터리를","x":502,"y":2314,"width":141,"height":34},{"text":"탐색하는","x":654,"y":2313,"width":116,"height":34},{"text":"도중","x":780,"y":2316,"width":60,"height":32},{"text":"링크는","x":853,"y":2314,"width":87,"height":34},{"text":"검색하지","x":953,"y":2314,"width":119,"height":35},{"text":"않는","x":1090,"y":2315,"width":64,"height":34},{"text":"것이다.","x":1168,"y":2315,"width":105,"height":35},{"text":"순환도","x":1289,"y":2317,"width":103,"height":33},{"text":"피할","x":1406,"y":2318,"width":66,"height":35},{"text":"수","x":1483,"y":2319,"width":32,"height":35}]}]}