,"y":1288,"width":62,"height":35},{"text":"사용자","x":680,"y":1287,"width":88,"height":35},{"text":"메모리로부터의","x":779,"y":1287,"width":205,"height":36},{"text":"입출력과","x":1003,"y":1287,"width":125,"height":35},{"text":"다른","x":1140,"y":1287,"width":65,"height":34},{"text":"많은","x":1219,"y":1286,"width":67,"height":35},{"text":"서비스를","x":1300,"y":1285,"width":132,"height":35},{"text":"제공","x":1446,"y":1285,"width":61,"height":35}]},{"text":"할 수 있다. 예를 들어, 다중 처리기 시스템 운영체제는 한 프로세스의 상태를 레지스터","words":[{"text":"할","x":305,"y":1345,"width":31,"height":34},{"text":"수","x":346,"y":1346,"width":31,"height":33},{"text":"있다.","x":391,"y":1345,"width":62,"height":35},{"text":"예를","x":468,"y":1347,"width":57,"height":34},{"text":"들어,","x":535,"y":1347,"width":64,"height":35},{"text":"다중","x":613,"y":1347,"width":57,"height":34},{"text":"처리기","x":683,"y":1345,"width":82,"height":35},{"text":"시스템","x":781,"y":1345,"width":84,"height":35},{"text":"운영체제는","x":880,"y":1346,"width":153,"height":34},{"text":"한","x":1046,"y":1346,"width":32,"height":33},{"text":"프로세스의","x":1090,"y":1344,"width":159,"height":35},{"text":"상태를","x":1266,"y":1344,"width":101,"height":35},{"text":"레지스터","x":1381,"y":1343,"width":122,"height":35}]},{"text":"로부터 메인 메모리로 저장하고 다음 프로세스의 문맥을 메인 메모리로부터 레지스터로","words":[{"text":"로부터","x":305,"y":1404,"width":85,"height":35},{"text":"메인","x":406,"y":1403,"width":57,"height":36},{"text":"메모리로","x":475,"y":1405,"width":114,"height":35},{"text":"저장하고","x":601,"y":1404,"width":113,"height":36},{"text":"다음","x":726,"y":1404,"width":58,"height":35},{"text":"프로세스의","x":795,"y":1404,"width":145,"height":35},{"text":"문맥을","x":954,"y":1403,"width":93,"height":35},{"text":"메인","x":1060,"y":1404,"width":62,"height":34},{"text":"메모리로부터","x":1136,"y":1403,"width":193,"height":35},{"text":"레지스터로","x":1349,"y":1401,"width":158,"height":36}]},{"text":"저장하는 문맥 교환을 반드시 실행해야 한다.","words":[{"text":"저장하는","x":307,"y":1461,"width":117,"height":35},{"text":"문맥","x":433,"y":1463,"width":55,"height":34},{"text":"교환을","x":501,"y":1464,"width":86,"height":34},{"text":"반드시","x":597,"y":1462,"width":81,"height":35},{"text":"실행해야","x":693,"y":1462,"width":117,"height":35},{"text":"한다.","x":819,"y":1463,"width":65,"height":33}]},{"text":"9.1.2 주소의 할당 Address Binding","words":[{"text":"9.1.2","x":306,"y":1571,"width":102,"height":29},{"text":"주소의","x":445,"y":1572,"width":80,"height":32},{"text":"할당","x":535,"y":1572,"width":54,"height":32},{"text":"Address","x":609,"y":1580,"width":112,"height":20},{"text":"Binding","x":730,"y":1579,"width":100,"height":26}]},{"text":"프로그램은 원래 이진 실행 파일 형태로 디스크에 저장되어 있다. 실행하려면 프로그램","words":[{"text":"프로그램은","x":307,"y":1642,"width":147,"height":35},{"text":"원래","x":467,"y":1643,"width":53,"height":36},{"text":"이진","x":536,"y":1644,"width":55,"height":35},{"text":"실행","x":605,"y":1643,"width":53,"height":35},{"text":"파일","x":673,"y":1643,"width":55,"height":34},{"text":"형태로","x":743,"y":1643,"width":87,"height":34},{"text":"디스크에","x":844,"y":1642,"width":114,"height":35},{"text":"저장되어","x":974,"y":1642,"width":119,"height":35},{"text":"있다.","x":1113,"y":1641,"width":69,"height":35},{"text":"실행하려면","x":1200,"y":1641,"width":166,"height":35},{"text":"프로그램","x":1381,"y":1641,"width":125,"height":34}]},{"text":"을 메모리로 가져와서 프로세스 문맥(2.5절에 설명된 대로) 내에 배치해야 한다. 이 시점","words":[{"text":"을","x":307,"y":1700,"width":31,"height":35},{"text":"메모리로","x":349,"y":1701,"width":115,"height":35},{"text":"가져와서","x":476,"y":1702,"width":109,"height":35},{"text":"프로세스","x":600,"y":1702,"width":114,"height":34},{"text":"문맥(2.5절에","x":723,"y":1701,"width":168,"height":37},{"text":"설명된","x":905,"y":1700,"width":88,"height":35},{"text":"대로)","x":1007,"y":1701,"width":70,"height":37},{"text":"내에","x":1093,"y":1700,"width":60,"height":35},{"text":"배치해야","x":1169,"y":1699,"width":133,"height":35},{"text":"한다.","x":1313,"y":1699,"width":75,"height":35},{"text":"이","x":1404,"y":1699,"width":27,"height":35},{"text":"시점","x":1448,"y":1699,"width":57,"height":35}]},{"text":"에 가용한CPU에서 실행할 수 있게 된다. 프로세스가 실행되면 메모리에서 명령 및 데","words":[{"text":"에","x":309,"y":1759,"width":26,"height":35},{"text":"가용한CPU에서","x":351,"y":1760,"width":220,"height":36},{"text":"실행할","x":587,"y":1760,"width":85,"height":35},{"text":"수","x":682,"y":1760,"width":30,"height":34},{"text":"있게","x":725,"y":1759,"width":52,"height":35},{"text":"된다.","x":792,"y":1759,"width":64,"height":35},{"text":"프로세스가","x":870,"y":1759,"width":151,"height":35},{"text":"실행되면","x":1033,"y":1758,"width":125,"height":36},{"text":"메모리에서","x":1174,"y":1757,"width":162,"height":35},{"text":"명령","x":1357,"y":1758,"width":60,"height":34},{"text":"및","x":1436,"y":1758,"width":28,"height":34},{"text":"데","x":1480,"y":1758,"width":26,"height":34}]},{"text":"이터에 액세스 한다. 결국 프로세스가 종료되고 다른 프로세스에서 사용하기 위해 메모","words":[{"text":"이터에","x":310,"y":1818,"width":85,"height":36},{"text":"액세스","x":411,"y":1819,"width":85,"height":35},{"text":"한다.","x":507,"y":1820,"width":63,"height":34},{"text":"결국","x":586,"y":1819,"width":56,"height":34},{"text":"프로세스가","x":653,"y":1818,"width":145,"height":35},{"text":"종료되고","x":809,"y":1818,"width":117,"height":35},{"text":"다른","x":939,"y":1817,"width":60,"height":36},{"text":"프로세스에서","x":1012,"y":1816,"width":187,"height":36},{"text":"사용하기","x":1218,"y":1816,"width":130,"height":35},{"text":"위해","x":1369,"y":1816,"width":62,"height":35},{"text":"메모","x":1448,"y":1816,"width":62,"height":35}]},{"text":"리가 회수된다.","words":[{"text":"리가","x":312,"y":1877,"width":58,"height":35},{"text":"회수된다.","x":381,"y":1878,"width":119,"height":34}]},{"text":"대부분의 시스템은 사용자 프로세스가 메모리 내 어느 부분으로도 올근卜을 수 있도록","words":[{"text":"대부분의","x":367,"y":1936,"width":110,"height":36},{"text":"시스템은","x":491,"y":1937,"width":115,"height":35},{"text":"사용자","x":616,"y":1937,"width":86,"height":35},{"text":"프로세스가","x":712,"y":1936,"width":144,"height":36},{"text":"메모리","x":867,"y":1936,"width":83,"height":35},{"text":"내","x":966,"y":1936,"width":26,"height":35},{"text":"어느","x":1008,"y":1936,"width":59,"height":35},{"text":"부분으로도","x":1079,"y":1937,"width":163,"height":34},{"text":"올근卜을","x":1254,"y":1934,"width":103,"height":35},{"text":"수","x":1368,"y":1934,"width":35,"height":35},{"text":"있도록","x":1417,"y":1934,"width":93,"height":35}]},{"text":"지원하고 있다. 사용자 프로세스의 주소가 00000번지부터 시작된다고 해서 이 프로그램","words":[{"text":"지원하고","x":312,"y":1995,"width":115,"height":35},{"text":"있다.","x":440,"y":1995,"width":60,"height":35},{"text":"사용자","x":512,"y":1996,"width":88,"height":35},{"text":"프로세스의","x":610,"y":1996,"width":140,"height":35},{"text":"주소가","x":764,"y":1995,"width":87,"height":36},{"text":"00000번지부터","x":860,"y":1995,"width":202,"height":35},{"text":"시작된다고","x":1079,"y":1994,"width":162,"height":36},{"text":"해서","x":1255,"y":1993,"width":62,"height":36},{"text":"이","x":1336,"y":1993,"width":28,"height":35},{"text":"프로그램","x":1381,"y":1994,"width":126,"height":34}]},{"text":"이 메모리의 町0번지부터 올라오뺘 할 필요는 없다. 여러분은 운영체제가 프로세스를","words":[{"text":"이","x":312,"y":2053,"width":24,"height":35},{"text":"메모리의","x":351,"y":2054,"width":111,"height":35},{"text":"町0번지부터","x":475,"y":2055,"width":196,"height":34},{"text":"올라오뺘","x":685,"y":2054,"width":115,"height":35},{"text":"할","x":810,"y":2054,"width":29,"height":34},{"text":"필요는","x":850,"y":2054,"width":86,"height":34},{"text":"없다.","x":949,"y":2054,"width":64,"height":35},{"text":"여러분은","x":1029,"y":2054,"width":125,"height":36},{"text":"운영체제가","x":1164,"y":2053,"width":171,"height":35},{"text":"프로세스를","x":1347,"y":2052,"width":163,"height":36}]},{"text":"실제로 물리 메모리에 적재하는 방법에 대해서 보게 될 것이다. 대부분의 경우 사용자","words":[{"text":"실제로","x":311,"y":2112,"width":86,"height":34},{"text":"물리","x":411,"y":2112,"width":53,"height":34},{"text":"메모리에","x":482,"y":2113,"width":113,"height":34},{"text":"적재하는","x":612,"y":2113,"width":115,"height":34},{"text":"방법에","x":741,"y":2113,"width":82,"height":35},{"text":"대해서","x":840,"y":2113,"width":82,"height":35},{"text":"보게","x":940,"y":2113,"width":56,"height":34},{"text":"될","x":1014,"y":2113,