{"page":468,"width":1730,"height":2572,"text_angle":0,"lines":[{"text":"11.8 RAID 구조","words":[{"text":"11.8","x":1205,"y":154,"width":64,"height":22},{"text":"RAID","x":1287,"y":154,"width":62,"height":23},{"text":"구조","x":1358,"y":153,"width":48,"height":24}]},{"text":"(기 전통적인 볼•국과 파일 시스템","words":[{"text":"(기","x":750,"y":594,"width":25,"height":28},{"text":"전통적인","x":785,"y":593,"width":87,"height":27},{"text":"볼•국과","x":882,"y":593,"width":69,"height":26},{"text":"파일","x":958,"y":593,"width":45,"height":27},{"text":"시스템","x":1013,"y":593,"width":68,"height":27}]},{"text":"529","words":[{"text":"529","x":1478,"y":147,"width":58,"height":29}]},{"text":"ZFS","words":[{"text":"ZFS","x":719,"y":720,"width":56,"height":26}]},{"text":"ZFS","words":[{"text":"ZFS","x":881,"y":719,"width":56,"height":27}]},{"text":"저장장치 불","words":[{"text":"저장장치","x":848,"y":826,"width":91,"height":28},{"text":"불","x":948,"y":827,"width":23,"height":26}]},{"text":"ZFS","words":[{"text":"ZFS","x":1046,"y":721,"width":57,"height":25}]},{"text":"(미 ZFS와 풀 형식의 저장장치","words":[{"text":"(미","x":763,"y":1028,"width":28,"height":27},{"text":"ZFS와","x":800,"y":1027,"width":71,"height":25},{"text":"풀","x":878,"y":1027,"width":23,"height":26},{"text":"형식의","x":910,"y":1026,"width":68,"height":27},{"text":"저장장치","x":988,"y":1027,"width":90,"height":26}]},{"text":"그림 11.18 ZFS 모델과 비교한 전통적인 볼름 및 파일 시스템","words":[{"text":"그림","x":557,"y":1097,"width":49,"height":27},{"text":"11.18","x":617,"y":1098,"width":71,"height":23},{"text":"ZFS","x":716,"y":1098,"width":50,"height":24},{"text":"모델과","x":776,"y":1097,"width":75,"height":28},{"text":"비교한","x":860,"y":1096,"width":73,"height":28},{"text":"전통적인","x":941,"y":1097,"width":97,"height":28},{"text":"볼름","x":1048,"y":1097,"width":49,"height":27},{"text":"및","x":1107,"y":1097,"width":22,"height":27},{"text":"파일","x":1139,"y":1096,"width":48,"height":28},{"text":"시스템","x":1197,"y":1096,"width":74,"height":28}]},{"text":"은 RAID 집합을 통해 집합적으로 저장장치의 풀을 구성한다. 이 풀은 하나 또는 그 이","words":[{"text":"은","x":291,"y":1226,"width":34,"height":34},{"text":"RAID","x":337,"y":1229,"width":95,"height":28},{"text":"집합을","x":448,"y":1226,"width":95,"height":35},{"text":"통해","x":555,"y":1227,"width":60,"height":35},{"text":"집합적으로","x":632,"y":1226,"width":154,"height":36},{"text":"저장장치의","x":800,"y":1226,"width":150,"height":36},{"text":"풀을","x":965,"y":1226,"width":64,"height":34},{"text":"구성한다.","x":1040,"y":1225,"width":132,"height":36},{"text":"이","x":1188,"y":1225,"width":26,"height":36},{"text":"풀은","x":1230,"y":1226,"width":65,"height":34},{"text":"하나","x":1307,"y":1225,"width":66,"height":36},{"text":"또는","x":1385,"y":1225,"width":67,"height":33},{"text":"그","x":1465,"y":1229,"width":34,"height":24},{"text":"이","x":1513,"y":1225,"width":28,"height":36}]},{"text":"상의 ZFS 파일 시스템을 저장할 수 있다. 풀의 가용 공간 전체가 풀 안의 모든 파일 시","words":[{"text":"상의","x":291,"y":1284,"width":63,"height":36},{"text":"ZFS","x":369,"y":1288,"width":66,"height":29},{"text":"파일","x":449,"y":1285,"width":62,"height":35},{"text":"시스템을","x":528,"y":1285,"width":125,"height":35},{"text":"저장할","x":667,"y":1285,"width":92,"height":36},{"text":"수","x":770,"y":1286,"width":32,"height":34},{"text":"있다.","x":817,"y":1286,"width":66,"height":34},{"text":"풀의","x":897,"y":1285,"width":61,"height":35},{"text":"가용","x":974,"y":1285,"width":62,"height":36},{"text":"공간","x":1048,"y":1285,"width":63,"height":35},{"text":"전체가","x":1125,"y":1285,"width":93,"height":35},{"text":"풀","x":1230,"y":1286,"width":33,"height":33},{"text":"안의","x":1276,"y":1284,"width":60,"height":36},{"text":"모든","x":1352,"y":1285,"width":67,"height":33},{"text":"파일","x":1432,"y":1284,"width":63,"height":35},{"text":"시","x":1512,"y":1284,"width":28,"height":36}]},{"text":"스템을 위해 八卜우될 수 있다. ZFS는 파일 시스템 안에서 블록이 사용되고 반환되는 것과","words":[{"text":"스템을","x":291,"y":1344,"width":100,"height":35},{"text":"위해","x":402,"y":1344,"width":61,"height":35},{"text":"八卜우될","x":477,"y":1344,"width":93,"height":35},{"text":"수","x":582,"y":1346,"width":33,"height":34},{"text":"있다.","x":628,"y":1345,"width":66,"height":36},{"text":"ZFS는","x":707,"y":1347,"width":95,"height":32},{"text":"파일","x":812,"y":1345,"width":60,"height":36},{"text":"시스템","x":885,"y":1344,"width":90,"height":36},{"text":"안에서","x":990,"y":1344,"width":88,"height":35},{"text":"블록이","x":1092,"y":1344,"width":91,"height":35},{"text":"사용되고","x":1198,"y":1344,"width":127,"height":35},{"text":"반환되는","x":1336,"y":1343,"width":130,"height":35},{"text":"것과","x":1479,"y":1344,"width":65,"height":36}]},{"text":"같이 각 파일 시스템을 위한 저장장치를 할당하고 반환하는 데 malloc()과 free() 모","words":[{"text":"같이","x":292,"y":1403,"width":61,"height":35},{"text":"각","x":369,"y":1403,"width":34,"height":35},{"text":"파일","x":414,"y":1403,"width":61,"height":36},{"text":"시스템을","x":490,"y":1403,"width":126,"height":36},{"text":"위한","x":629,"y":1405,"width":62,"height":35},{"text":"저장장치를","x":703,"y":1404,"width":154,"height":36},{"text":"할당하고","x":868,"y":1404,"width":124,"height":35},{"text":"반환하는","x":1004,"y":1403,"width":126,"height":35},{"text":"데","x":1141,"y":1403,"width":27,"height":36},{"text":"malloc()과","x":1181,"y":1403,"width":188,"height":36},{"text":"free()","x":1380,"y":1406,"width":111,"height":30},{"text":"모","x":1510,"y":1409,"width":33,"height":24}]},{"text":"델을 시용한다. 결과적으로 저장장치를 사우하는 데 있어 인위적인 제한을 두지 않으며","words":[{"text":"델을","x":292,"y":1461,"width":66,"height":35},{"text":"시용한다.","x":370,"y":1462,"width":137,"height":36},{"text":"결과적으로","x":524,"y":1463,"width":156,"height":35},{"text":"저장장치를","x":696,"y":1463,"width":153,"height":36},{"text":"사우하는","x":861,"y":1463,"width":125,"height":35},{"text":"데","x":1000,"y":1462,"width":26,"height":36},{"text":"있어","x":1045,"y":1463,"width":57,"height":35},{"text":"인위적인","x":1121,"y":1463,"width":123,"height":35},{"text":"제한을","x":1258,"y":1463,"width":96,"height":35},{"text":"두지","x":1367,"y":1463,"width":60,"height":35},{"text":"않으며","x":1446,"y":1463,"width":93,"height":36}]},{"text":"볼륨 간에 파일 시스템을 재배치하거나 볼륨의 크기를 재조정할 필요가 없다. ZFS는 파","words":[{"text":"볼륨","x":291,"y":1521,"width":67,"height":34},{"text":"간에","x":370,"y":1521,"width":62,"height":35},{"text":"파일","x":446,"y":1522,"width":63,"height":35},{"text":"시스템을","x":523,"y":1522,"width":127,"height":35},{"text":"재배치하거나","x":662,"y":1523,"width":186,"height":36},{"text":"볼륨의","x":859,"y":1522,"width":90,"height":35},{"text":"크기를","x":964,"y":1522,"width":95,"height":35},{"text":"재조정할","x":1071,"y":1522,"width":126,"height":36},{"text":"필요가","x":1209,"y":1522,"width":95,"height":37},{"text":"없다.","x":1317,"y":1522,"width":68,"height":36},{"text":"ZFS는","x":1400,"y":1525,"width":99,"height":33},{"text":"파","x":1510,"y":1524,"width":34,"height":36}]},{"text":"일 시스템의 크기를 제한하기 위하여 쿼터(qu잓a)를 제공하고 파일 시스템이 지정된 크","words":[{"text":"일","x":294,"y":1579,"width":28,"height":35},{"text":"시스템의","x":337,"y":1580,"width":127,"height":36},{"text":"크기를","x":479,"y":1581,"width":96,"height":35},{"text":"제한하기","x":587,"y":1582,"width":121,"height":35},{"text":"위하여","x":725,"y":1582,"width":88,"height":36},{"text":"쿼터(qu잓a)를","x":830,"y":1582,"width":207,"height":40},{"text":"제공하고","x":1049,"y":1581,"width":127,"height":36},{"text":"파일","x":1185,"y":1582,"width":62,"height":35},{"text":"시스템이","x":1263,"y":1582,"width":122,"height":36},{"text":"지정된","x":1402,"y":1583,"width":95,"height":36},{"text":"크","x":1511,"y":1588,"width":32,"height":25}]},{"text":"기만큼의 확장을 보장하기 위하여 예약(reservation)을 제공한다. 그러나 이 변수들은","words":[{"text":"기만큼의","x":293,"y":1638,"width":126,"height":37},{"text":"확장을","x":437,"y":1640,"width":98,"height":35},{"text":"보장하기","x":548,"y":1641,"width":122,"height":36},{"text":"위하여","x":690,"y":1642,"width":89,"height":36},{"text":"예약(reservation)을","x":798,"y":1641,"width":295,"height":38},{"text":"제공한다.","x":1106,"y":1641,"width":133,"height":36},{"text":"그러나","x":1256,"y":1642,"width":96,"height":35},{"text":"이","x":1368,"y":1642,"width":26,"height":36},{"text":"변수들은","x":1415,"y":1643,"width":129,"height":35}]},{"text":"파일 시스템 소유주에 의해 아무 때나 변경 가능하다. Linux와 같은 다른 시스템에는 볼","words":[{"text":"파일","x":292,"y":1698,"width":64,"height":35},{"text":"시스템","x":370,"y":1699,"width":93,"height":36},{"text":"소유주에","x":478,"y":1700,"width":124,"height":36},{"text":"의해","x":617,"y":1700,"width":59,"height":36},{"text":"아무","x":690,"y":1701,"width":62,"height":35},{"text":"때나","x":763,"y":1701,"width":62,"height":35},{"text":"변경","x":836,"y":1700,"width":57,"height":35},{"text":"가능하다.","x":908,"y":1699,"width":130,"height":36},{"text":"Linux와","x":1051,"y":1701,"width":128,"height":35},{"text":"같은","x":1189,"y":1701,"width":63,"height":34},{"text":"다른","x":1264,"y":1701,"width":63,"height":35},{"text":"시스템에는","x":1339,"y":1701,"width":161,"height":35},{"text":"볼","x":1511,"y":1703,"width":33,"height":34}]},{"text":"관리자가 있어 여러 디스크를 논리적으로 결합하여 큰 파일 시스템을 보유하기 위해","words":[{"text":"관리자가","x":338,"y":1757,"width":132,"height":37},{"text":"있어","x":484,"y":1759,"width":57,"height":35},{"text":"여러","x":560,"y":1759,"width":57,"height":35},{"text":"디스크를","x":635,"y":1759,"width":124,"height":35},{"text":"논리적으로","x":771,"y":1759,"width":155,"height":36},{"text":"결합하여","x":939,"y":1758,"width":119,"height":36},{"text":"큰","x":1074,"y":1762,"width":32,"height":31},{"text":"파일","x":1119,"y":1759,"width":62,"height":36},{"text":"시스템을","x":1196,"y":1760,"width":128,"height":35},{"text":"보유하기","x":1336,"y":1760,"width":125,"height":35},{"text":"위해","x":1480,"y":1762,"width":61,"height":35}]},{"text":"디스크보다 큰 볼륨을 만들 수 있다. 그림 11.18(a)는 전통적인 볼륨과 파일 시스템을 도","words":[{"text":"디스크보다","x":294,"y":1817,"width":162,"height":36},{"text":"큰","x":467,"y":1821,"width":33,"height":31},{"text":"볼륨을","x":511,"y":1818,"width":96,"height":35},{"text":"만들","x":617,"y":1818,"width":63,"height":34},{"text":"수","x":690,"y":1819,"width":33,"height":35},{"text":"있다.","x":736,"y":1818,"width":65,"height":36},{"text":"그림","x":814,"y":1818,"width":58,"height":34},{"text":"11.18(a)는","x":888,"y":1819,"width":151,"height":36},{"text":"전통적인","x":1050,"y":1818,"width":124,"height":35},{"text":"볼륨과","x":1186,"y":1818,"width":97,"height":35},{"text":"파일","x":1293,"y":1818,"width":63,"height":35},{"text":"시스템을","x":1371,"y":1819,"width":129,"height":35},{"text":"도","x":1511,"y":1825,"width":33,"height":25}]},{"text":"시하고, 그림 11.18(b)는 ZFS 모델을 설명하고 있다.","words":[{"text":"시하고,","x":294,"y":1876,"width":105,"height":36},{"text":"그림","x":413,"y":1877,"width":60,"height":35},{"text":"11.18(b)는","x":489,"y":1879,"width":155,"height":36},{"text":"ZFS","x":654,"y":1881,"width":63,"height":28},{"text":"모델을","x":728,"y":1877,"width":94,"height":35},{"text":"설명하고","x":832,"y":1876,"width":122,"height":36},{"text":"있다.","x":967,"y":1876,"width":67,"height":35}]},{"text":"11.8.7 객체 저장소 0bJectStorage","words":[{"text":"11.8.7","x":294,"y":1988,"width":134,"height":29},{"text":"객체","x":469,"y":1987,"width":58,"height":33},{"text":"저장소","x":539,"y":1987,"width":88,"height":32},{"text":"0bJectStorage","x":651,"y":1995,"width":215,"height":27}]},{"text":"범용 컴퓨터는 일반적으로 파일 시스템을 사우하여 사용자의 콘텐츠를 저장한다. 데이터","words":[{"text":"범용","x":296,"y":2058,"width":64,"height":36},{"text":"컴퓨터는","x":373,"y":2060,"width":129,"height":35},{"text":"일반적으로","x":515,"y":2059,"width":154,"height":35},{"text":"파일","x":680,"y":2060,"width":60,"height":35},{"text":"시스템을","x":754,"y":2059,"width":122,"height":36},{"text":"사우하여","x":885,"y":2059,"width":119,"height":35},{"text":"사용자의","x":1019,"y":2059,"width":122,"height":36},{"text":"콘텐츠를","x":1155,"y":2060,"width":128,"height":34},{"text":"저장한다.","x":1296,"y":2059,"width":134,"height":36},{"text":"데이터","x":1444,"y":2060,"width":94,"height":36}]},{"text":"저장장지에 대한 또 다른 접근법은 저장장지 풀로 시작하여 해당 풀에 객체를 배치하는","words":[{"text":"저장장지에","x":296,"y":2118,"width":159,"height":36},{"text":"대한","x":472,"y":2119,"width":64,"height":35},{"text":"또","x":548,"y":2122,"width":31,"height":26},{"text":"다른","x":592,"y":2119,"width":63,"height":35},{"text":"접근법은","x":669,"y":2119,"width":122,"height":35},{"text":"저장장지","x":804,"y":2119,"width":116,"height":35},{"text":"풀로","x":935,"y":2120,"width":62,"height":33},{"text":"시작하여","x":1010,"y":2119,"width":121,"height":35},{"text":"해당","x":1148,"y":2119,"width":64,"height":35},{"text":"풀에","x":1224,"y":2119,"width":62,"height":35},{"text":"객체를","x":1304,"y":2119,"width":94,"height":35},{"text":"배치하는","x":1412,"y":2118,"width":130,"height":35}]},{"text":"것이다. 이 방법은 풀을 탐색하고 해당 객체를 찾을 방법이 없다는 점에서 파일 시스템","words":[{"text":"것이다.","x":296,"y":2177,"width":103,"height":36},{"text":"이","x":418,"y":2178,"width":26,"height":36},{"text":"방법은","x":462,"y":2178,"width":97,"height":35},{"text":"풀을","x":571,"y":2178,"width":65,"height":34},{"text":"탐색하고","x":648,"y":2178,"width":124,"height":35},{"text":"해당","x":786,"y":2177,"width":60,"height":35},{"text":"객체를","x":859,"y":2177,"width":90,"height":35},{"text":"찾을","x":961,"y":2178,"width":63,"height":34},{"text":"방법이","x":1037,"y":2177,"width":91,"height":36},{"text":"없다는","x":1147,"y":2178,"width":93,"height":35},{"text":"점에서","x":1255,"y":2177,"width":91,"height":36},{"text":"파일","x":1364,"y":2176,"width":62,"height":35},{"text":"시스템","x":1443,"y":2176,"width":94,"height":35}]},{"text":"과 다르다. 따라서 객체 지향은 사용자 지향적이 아니라 컴퓨터 지향적이며 프로그램에","words":[{"text":"과","x":294,"y":2236,"width":34,"height":36},{"text":"다르다.","x":342,"y":2236,"width":103,"height":36},{"text":"따라서","x":462,"y":2237,"width":91,"height":35},{"text":"객체","x":572,"y":2237,"width":59,"height":35},{"text":"지향은","x":648,"y":2237,"width":92,"height":35},{"text":"사용자","x":752,"y":2236,"width":91,"height":36},{"text":"지향적이","x":857,"y":2236,"width":115,"height":36},{"text":"아니라","x":989,"y":2236,"width":94,"height":36},{"text":"컴퓨터","x":1097,"y":2237,"width":89,"height":35},{"text":"지향적이며","x":1204,"y":2237,"width":155,"height":35},{"text":"프로그램에","x":1377,"y":2235,"width":160,"height":36}]},{"text":"서 시용하도록 설계되었다. 일반적인 순서는 다음과 같다.","words":[{"text":"서","x":294,"y":2296,"width":29,"height":35},{"text":"시용하도록","x":338,"y":2296,"width":163,"height":36},{"text":"설계되었다.","x":513,"y":2296,"width":164,"height":36},{"text":"일반적인","x":692,"y":2296,"width":118,"height":35},{"text":"순서는","x":821,"y":2295,"width":91,"height":36},{"text":"다음과","x":922,"y":2296,"width":93,"height":35},{"text":"같다.","x":1025,"y":2296,"width":70,"height":36}]}]}