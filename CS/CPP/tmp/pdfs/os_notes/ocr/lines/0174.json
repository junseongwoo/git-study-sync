{"page":174,"width":1799,"height":2813,"text_angle":0,"lines":[{"text":"228","words":[{"text":"228","x":186,"y":141,"width":66,"height":30}]},{"text":"Chapter 5 CPU 스케줄링","words":[{"text":"Chapter","x":334,"y":146,"width":132,"height":31},{"text":"5","x":482,"y":147,"width":23,"height":23},{"text":"CPU","x":539,"y":148,"width":58,"height":25},{"text":"스케줄링","x":607,"y":147,"width":97,"height":29}]},{"text":"여 CPU를 방출할 때까지 CPU를 점유한다. 선입 선처리 알고리즘은 특히 대화형 시스","words":[{"text":"여","x":336,"y":284,"width":30,"height":38},{"text":"CPU를","x":384,"y":285,"width":121,"height":36},{"text":"방출할","x":519,"y":283,"width":105,"height":39},{"text":"때까지","x":638,"y":283,"width":97,"height":39},{"text":"CPU를","x":752,"y":285,"width":118,"height":36},{"text":"점유한다.","x":886,"y":282,"width":143,"height":40},{"text":"선입","x":1047,"y":282,"width":64,"height":38},{"text":"선처리","x":1131,"y":282,"width":100,"height":39},{"text":"알고리즘은","x":1251,"y":283,"width":182,"height":40},{"text":"특히","x":1448,"y":287,"width":70,"height":38},{"text":"대화형","x":1539,"y":288,"width":104,"height":38},{"text":"시스","x":1664,"y":291,"width":61,"height":38}]},{"text":"템에서 문제가 되는데, 그 이그옥는 대화형 시스템에서는 각 프로세스가 규칙적인 간격으","words":[{"text":"템에서","x":335,"y":347,"width":101,"height":39},{"text":"문제가","x":455,"y":347,"width":107,"height":39},{"text":"되는데,","x":576,"y":347,"width":110,"height":40},{"text":"그","x":702,"y":353,"width":34,"height":27},{"text":"이그옥는","x":753,"y":348,"width":102,"height":39},{"text":"대화형","x":870,"y":346,"width":97,"height":40},{"text":"시스템에서는","x":988,"y":346,"width":208,"height":40},{"text":"각","x":1211,"y":346,"width":36,"height":39},{"text":"프로세스가","x":1261,"y":348,"width":185,"height":39},{"text":"규칙적인","x":1461,"y":350,"width":147,"height":38},{"text":"간격으","x":1626,"y":351,"width":98,"height":41}]},{"text":"로 CPU의 몫을 얻는 것이 매우 중요하기 때문이다. 한 프로세스가 지나치게 오랫동안","words":[{"text":"로","x":333,"y":415,"width":35,"height":29},{"text":"CPU의","x":383,"y":411,"width":118,"height":39},{"text":"몫을","x":520,"y":412,"width":71,"height":39},{"text":"얻는","x":607,"y":413,"width":67,"height":38},{"text":"것이","x":690,"y":412,"width":63,"height":40},{"text":"매우","x":772,"y":412,"width":68,"height":40},{"text":"중요하기","x":855,"y":411,"width":133,"height":40},{"text":"때문이다.","x":1009,"y":410,"width":145,"height":40},{"text":"한","x":1173,"y":410,"width":36,"height":39},{"text":"프로세스가","x":1224,"y":411,"width":183,"height":41},{"text":"지나치게","x":1425,"y":413,"width":143,"height":39},{"text":"오랫동안","x":1588,"y":414,"width":136,"height":45}]},{"text":"CPU를 점유하게 허용하는 것은 손해가 클 것이다.","words":[{"text":"CPU를","x":332,"y":477,"width":123,"height":37},{"text":"점유하게","x":468,"y":476,"width":136,"height":40},{"text":"허용하는","x":621,"y":477,"width":136,"height":40},{"text":"것은","x":770,"y":477,"width":68,"height":40},{"text":"손해가","x":848,"y":477,"width":104,"height":39},{"text":"클","x":964,"y":478,"width":35,"height":37},{"text":"것이다.","x":1012,"y":475,"width":110,"height":41}]},{"text":"5.3.2 최단 우선 스케줄링 Shottest-Job-First scheduling","words":[{"text":"5.3.2","x":332,"y":597,"width":136,"height":32},{"text":"최단","x":513,"y":597,"width":66,"height":36},{"text":"우선","x":664,"y":598,"width":63,"height":36},{"text":"스케줄링","x":739,"y":598,"width":126,"height":37},{"text":"Shottest-Job-First","x":893,"y":608,"width":296,"height":24},{"text":"scheduling","x":1198,"y":607,"width":185,"height":31}]},{"text":"CPU 스케줄링의 다른 접근 방법은 최단 작업 우선(shortest-job-first, SJF) 알고리즘","words":[{"text":"CPU","x":331,"y":679,"width":87,"height":31},{"text":"스케줄링의","x":434,"y":676,"width":171,"height":40},{"text":"다른","x":624,"y":677,"width":68,"height":40},{"text":"접근","x":708,"y":677,"width":67,"height":39},{"text":"방법은","x":790,"y":678,"width":103,"height":39},{"text":"최단","x":908,"y":679,"width":68,"height":40},{"text":"작업","x":990,"y":679,"width":66,"height":39},{"text":"우선(shortest-job-first,","x":1075,"y":679,"width":396,"height":46},{"text":"SJF)","x":1490,"y":684,"width":78,"height":39},{"text":"알고리즘","x":1588,"y":680,"width":134,"height":40}]},{"text":"이다. 이 알고리즘은 각 프로세스에 니음 CPU 버스트 길이를 연관시킨다. CPU가 이용","words":[{"text":"이다.","x":333,"y":740,"width":78,"height":39},{"text":"이","x":429,"y":741,"width":29,"height":40},{"text":"알고리즘은","x":477,"y":742,"width":172,"height":39},{"text":"각","x":661,"y":743,"width":35,"height":39},{"text":"프로세스에","x":707,"y":743,"width":169,"height":40},{"text":"니음","x":892,"y":743,"width":69,"height":41},{"text":"CPU","x":973,"y":748,"width":83,"height":32},{"text":"버스트","x":1072,"y":744,"width":103,"height":40},{"text":"길이를","x":1191,"y":744,"width":105,"height":40},{"text":"연관시킨다.","x":1313,"y":746,"width":189,"height":39},{"text":"CPU가","x":1519,"y":745,"width":126,"height":39},{"text":"이용","x":1660,"y":746,"width":62,"height":40}]},{"text":"가능해지면, 가장 작은 다음 CPU 버스트를 가진 프로세스에 할당한다. 두 프로세스가","words":[{"text":"가능해지면,","x":333,"y":805,"width":184,"height":42},{"text":"가장","x":536,"y":807,"width":68,"height":40},{"text":"작은","x":618,"y":808,"width":69,"height":39},{"text":"다음","x":702,"y":808,"width":69,"height":39},{"text":"CPU","x":785,"y":811,"width":82,"height":32},{"text":"버스트를","x":886,"y":808,"width":136,"height":40},{"text":"가진","x":1039,"y":810,"width":67,"height":39},{"text":"프로세스에","x":1123,"y":810,"width":175,"height":39},{"text":"할당한다.","x":1318,"y":811,"width":156,"height":39},{"text":"두","x":1494,"y":813,"width":37,"height":37},{"text":"프로세스가","x":1548,"y":810,"width":173,"height":42}]},{"text":"동일한 길이의 다음 CPU 버스트를 가지면, 순위를 정하기 위해 선입 선처리 스케줄링","words":[{"text":"동일한","x":331,"y":871,"width":109,"height":38},{"text":"길이의","x":456,"y":872,"width":98,"height":39},{"text":"다음","x":573,"y":872,"width":68,"height":40},{"text":"CPU","x":654,"y":876,"width":82,"height":31},{"text":"버스트를","x":753,"y":872,"width":137,"height":39},{"text":"가지면,","x":905,"y":873,"width":111,"height":41},{"text":"순위를","x":1033,"y":875,"width":106,"height":38},{"text":"정하기","x":1155,"y":875,"width":101,"height":38},{"text":"위해","x":1278,"y":875,"width":69,"height":39},{"text":"선입","x":1367,"y":875,"width":68,"height":38},{"text":"선처리","x":1457,"y":875,"width":107,"height":39},{"text":"스케줄링","x":1584,"y":875,"width":133,"height":40}]},{"text":"을 적용한다. 이 스게줄링은 프로세스의 전체 길이가 아니라 다음 CPU 버스트의 길이","words":[{"text":"을","x":330,"y":935,"width":38,"height":38},{"text":"적용한다.","x":384,"y":936,"width":145,"height":40},{"text":"이","x":548,"y":937,"width":28,"height":39},{"text":"스게줄링은","x":595,"y":937,"width":171,"height":39},{"text":"프로세스의","x":780,"y":938,"width":169,"height":39},{"text":"전체","x":970,"y":938,"width":64,"height":39},{"text":"길이가","x":1054,"y":939,"width":105,"height":38},{"text":"아니라","x":1174,"y":939,"width":108,"height":39},{"text":"다음","x":1298,"y":939,"width":73,"height":39},{"text":"CPU","x":1386,"y":943,"width":89,"height":31},{"text":"버스트의","x":1495,"y":939,"width":142,"height":40},{"text":"길이","x":1658,"y":940,"width":59,"height":40}]},{"text":"에 의해 스케줄링이 되기 때문에, 최단 나음 CPtI 비스트(shortest-next-CPU-burst)","words":[{"text":"에","x":331,"y":1000,"width":32,"height":39},{"text":"의해","x":382,"y":1001,"width":67,"height":39},{"text":"스케줄링이","x":466,"y":1002,"width":168,"height":39},{"text":"되기","x":654,"y":1001,"width":62,"height":39},{"text":"때문에,","x":737,"y":1002,"width":110,"height":40},{"text":"최단","x":864,"y":1003,"width":71,"height":39},{"text":"나음","x":951,"y":1003,"width":68,"height":39},{"text":"CPtI","x":1035,"y":1008,"width":87,"height":30},{"text":"비스트(shortest-next-CPU-burst)","x":1142,"y":1004,"width":578,"height":44}]},{"text":"알고리즘이라는 용어가 더 적합하다는 사실에 유의하라. 대부분의 사람과 교과서가 이런","words":[{"text":"알고리즘이라는","x":331,"y":1066,"width":242,"height":39},{"text":"용어가","x":583,"y":1066,"width":104,"height":40},{"text":"더","x":699,"y":1067,"width":28,"height":39},{"text":"적합하다는","x":745,"y":1066,"width":172,"height":41},{"text":"사실에","x":928,"y":1068,"width":102,"height":39},{"text":"유의하라.","x":1045,"y":1069,"width":150,"height":39},{"text":"대부분의","x":1212,"y":1068,"width":140,"height":40},{"text":"사람과","x":1369,"y":1068,"width":113,"height":39},{"text":"교과서가","x":1495,"y":1068,"width":150,"height":40},{"text":"이런","x":1658,"y":1069,"width":62,"height":39}]},{"text":"유형의 스케줄링 정책을 SJF로 언급하기 때문에 우리도 SJF라는 용어를 시용한다.","words":[{"text":"유형의","x":329,"y":1131,"width":101,"height":39},{"text":"스케줄링","x":445,"y":1131,"width":133,"height":40},{"text":"정책을","x":596,"y":1132,"width":101,"height":39},{"text":"SJF로","x":707,"y":1136,"width":92,"height":38},{"text":"언급하기","x":814,"y":1133,"width":130,"height":39},{"text":"때문에","x":963,"y":1133,"width":100,"height":39},{"text":"우리도","x":1078,"y":1133,"width":108,"height":39},{"text":"SJF라는","x":1199,"y":1133,"width":132,"height":41},{"text":"용어를","x":1342,"y":1133,"width":113,"height":37},{"text":"시용한다.","x":1468,"y":1133,"width":158,"height":38}]},{"text":"하나의 예로 밀리초 단위의 CPU 버스트 길이를 가진 나음과 같은 프로세스들의 집","words":[{"text":"하나의","x":394,"y":1197,"width":99,"height":40},{"text":"예로","x":511,"y":1198,"width":67,"height":38},{"text":"밀리초","x":592,"y":1197,"width":100,"height":39},{"text":"단위의","x":706,"y":1198,"width":100,"height":40},{"text":"CPU","x":822,"y":1202,"width":82,"height":31},{"text":"버스트","x":921,"y":1199,"width":102,"height":38},{"text":"길이를","x":1038,"y":1198,"width":106,"height":38},{"text":"가진","x":1158,"y":1198,"width":69,"height":39},{"text":"나음과","x":1244,"y":1197,"width":109,"height":38},{"text":"같은","x":1367,"y":1197,"width":74,"height":37},{"text":"프로세스들의","x":1455,"y":1196,"width":219,"height":40},{"text":"집","x":1692,"y":1199,"width":26,"height":37}]},{"text":"합을 고려해 보자.","words":[{"text":"합을","x":329,"y":1264,"width":69,"height":38},{"text":"고려해","x":409,"y":1263,"width":101,"height":39},{"text":"보자.","x":523,"y":1263,"width":76,"height":40}]},{"text":"프로세스","words":[{"text":"프로세스","x":760,"y":1357,"width":137,"height":38}]},{"text":"버스트 시간","words":[{"text":"버스트","x":1061,"y":1355,"width":105,"height":38},{"text":"시간","x":1180,"y":1353,"width":73,"height":39}]},{"text":"6","words":[{"text":"6","x":1144,"y":1424,"wid