","x":1286,"y":2076,"width":114,"height":40},{"text":"16밀리초,","x":1420,"y":2075,"width":172,"height":40},{"text":"프로세","x":1614,"y":2078,"width":104,"height":40}]},{"text":"스 P3는 9밀리초이고, 프로세스 P4는 0초이다. 그러므로, 평균대기 시간은 (3 + 16 + 9","words":[{"text":"스","x":331,"y":2152,"width":33,"height":29},{"text":"P3는","x":378,"y":2148,"width":72,"height":40},{"text":"9밀리초이고,","x":463,"y":2145,"width":195,"height":39},{"text":"프로세스","x":675,"y":2145,"width":135,"height":39},{"text":"P4는","x":824,"y":2147,"width":73,"height":40},{"text":"0초이다.","x":912,"y":2144,"width":132,"height":39},{"text":"그러므로,","x":1063,"y":2144,"width":152,"height":40},{"text":"평균대기","x":1235,"y":2142,"width":142,"height":40},{"text":"시간은","x":1400,"y":2142,"width":114,"height":39},{"text":"(3","x":1529,"y":2142,"width":33,"height":40},{"text":"+","x":1577,"y":2151,"width":25,"height":22},{"text":"16","x":1617,"y":2144,"width":40,"height":31},{"text":"+","x":1671,"y":2153,"width":22,"height":22},{"text":"9","x":1705,"y":2147,"width":17,"height":29}]},{"text":"+ 0/4 = 7밀리초이다. 비교 차원에서 만일 선입선출 스케줄링을 시용한다면, 평균대기","words":[{"text":"+","x":329,"y":2224,"width":21,"height":20},{"text":"0/4","x":362,"y":2212,"width":74,"height":40},{"text":"=","x":448,"y":2226,"width":21,"height":12},{"text":"7밀리초이다.","x":482,"y":2210,"width":192,"height":39},{"text":"비교","x":691,"y":2210,"width":66,"height":39},{"text":"차원에서","x":771,"y":2210,"width":131,"height":40},{"text":"만일","x":921,"y":2210,"width":66,"height":38},{"text":"선입선출","x":1005,"y":2209,"width":141,"height":39},{"text":"스케줄링을","x":1160,"y":2209,"width":184,"height":40},{"text":"시용한다면,","x":1358,"y":2207,"width":200,"height":41},{"text":"평균대기","x":1577,"y":2207,"width":139,"height":41}]},{"text":"시간은 10.25밀리초가 되었을 것이다.","words":[{"text":"시간은","x":331,"y":2277,"width":101,"height":39},{"text":"10.25밀리초가","x":444,"y":2276,"width":222,"height":39},{"text":"되었을","x":678,"y":2276,"width":98,"height":39},{"text":"것이다.","x":790,"y":2276,"width":106,"height":40}]},{"text":"