{"page":256,"width":1668,"height":2493,"text_angle":0,"lines":[{"text":"312","words":[{"text":"312","x":164,"y":139,"width":56,"height":29}]},{"text":"Chapter 6 동기하 도구들","words":[{"text":"Chapter","x":290,"y":141,"width":117,"height":28},{"text":"6","x":420,"y":143,"width":20,"height":22},{"text":"동기하","x":469,"y":146,"width":63,"height":24},{"text":"도구들","x":540,"y":147,"width":63,"height":24}]},{"text":"6.8.2 우선순위 역전","words":[{"text":"6.8.2","x":293,"y":265,"width":116,"height":28},{"text":"우선순위","x":447,"y":265,"width":112,"height":32},{"text":"역전","x":570,"y":266,"width":55,"height":32}]},{"text":"높은 우선순위 프로세스가 현재 낮은 우선순위 프로세스 또는 연속된 낮은 우선순위 프","words":[{"text":"높은","x":292,"y":333,"width":62,"height":34},{"text":"우선순위","x":365,"y":333,"width":120,"height":35},{"text":"프로세스가","x":500,"y":334,"width":149,"height":34},{"text":"현재","x":661,"y":334,"width":56,"height":33},{"text":"낮은","x":731,"y":334,"width":59,"height":33},{"text":"우선순위","x":801,"y":334,"width":118,"height":34},{"text":"프로세스","x":934,"y":335,"width":121,"height":34},{"text":"또는","x":1068,"y":336,"width":63,"height":32},{"text":"연속된","x":1146,"y":334,"width":92,"height":34},{"text":"낮은","x":1254,"y":334,"width":64,"height":34},{"text":"우선순위","x":1330,"y":331,"width":126,"height":36},{"text":"프","x":1472,"y":336,"width":29,"height":24}]},{"text":"로세스들에 의해 접근되고 있는 커널 데이터를 읽거니 변경할 필요가 있을 때 스케줄링","words":[{"text":"로세스들에","x":291,"y":390,"width":151,"height":34},{"text":"의해","x":458,"y":391,"width":57,"height":34},{"text":"접근되고","x":532,"y":391,"width":116,"height":34},{"text":"있는","x":661,"y":390,"width":58,"height":34},{"text":"커널","x":732,"y":390,"width":54,"height":34},{"text":"데이터를","x":802,"y":390,"width":119,"height":34},{"text":"읽거니","x":935,"y":390,"width":83,"height":35},{"text":"변경할","x":1038,"y":391,"width":93,"height":34},{"text":"필요가","x":1145,"y":392,"width":95,"height":34},{"text":"있을","x":1255,"y":391,"width":63,"height":34},{"text":"때","x":1332,"y":389,"width":28,"height":34},{"text":"스케줄링","x":1376,"y":389,"width":122,"height":34}]},{"text":"의 어려움이 생기게 된다. 통상 커널 데이터는 리에 의해 보호되기 때문에 낮은 우선순","words":[{"text":"의","x":293,"y":447,"width":26,"height":33},{"text":"어려움이","x":336,"y":447,"width":118,"height":34},{"text":"생기게","x":472,"y":448,"width":86,"height":34},{"text":"된다.","x":574,"y":447,"width":64,"height":35},{"text":"통상","x":653,"y":446,"width":59,"height":35},{"text":"커널","x":726,"y":446,"width":54,"height":34},{"text":"데이터는","x":797,"y":446,"width":119,"height":36},{"text":"리에","x":929,"y":448,"width":57,"height":33},{"text":"의해","x":1003,"y":448,"width":58,"height":34},{"text":"보호되기","x":1077,"y":448,"width":123,"height":35},{"text":"때문에","x":1220,"y":448,"width":92,"height":34},{"text":"낮은","x":1330,"y":446,"width":64,"height":35},{"text":"우선순","x":1408,"y":446,"width":94,"height":34}]},{"text":"위 프로세스가 자원의 시정을 마칠 때까지 높은 우선순위 프로세스가 기다려야 한다. 낮","words":[{"text":"위","x":293,"y":503,"width":26,"height":34},{"text":"프로세스가","x":334,"y":504,"width":152,"height":34},{"text":"자원의","x":498,"y":504,"width":85,"height":34},{"text":"시정을","x":597,"y":503,"width":88,"height":35},{"text":"마칠","x":696,"y":502,"width":56,"height":34},{"text":"때까지","x":768,"y":503,"width":83,"height":35},{"text":"높은","x":867,"y":505,"width":61,"height":32},{"text":"우선순위","x":938,"y":504,"width":119,"height":35},{"text":"프로세스가","x":1072,"y":505,"width":160,"height":35},{"text":"기다려야","x":1246,"y":504,"width":129,"height":36},{"text":"한다.","x":1387,"y":504,"width":69,"height":33},{"text":"낮","x":1471,"y":504,"width":30,"height":35}]},{"text":"은 우선순위 프로세스가 또 다른 높은 우선순위 프로세스에 의해 선점되는 경우에 상황","words":[{"text":"은","x":291,"y":561,"width":31,"height":32},{"text":"우선순위","x":334,"y":560,"width":119,"height":35},{"text":"프로세스가","x":469,"y":560,"width":147,"height":35},{"text":"또","x":628,"y":564,"width":28,"height":25},{"text":"다른","x":669,"y":560,"width":59,"height":34},{"text":"높은","x":740,"y":560,"width":59,"height":33},{"text":"우선순위","x":811,"y":560,"width":117,"height":35},{"text":"프로세스에","x":944,"y":561,"width":150,"height":35},{"text":"의해","x":1112,"y":562,"width":59,"height":35},{"text":"선점되는","x":1188,"y":562,"width":129,"height":35},{"text":"경우에","x":1332,"y":561,"width":91,"height":35},{"text":"상황","x":1439,"y":561,"width":62,"height":34}]},{"text":"은 더욱 복잡해진다.","words":[{"text":"은","x":291,"y":618,"width":31,"height":32},{"text":"더욱","x":334,"y":617,"width":60,"height":34},{"text":"복잡해진다.","x":404,"y":618,"width":156,"height":34}]},{"text":"예를 들어, 우선순위가 L \u003c M \u003c H 순서인 L, M, H 세 개의 프로세스가 존재한다","words":[{"text":"예를","x":349,"y":675,"width":61,"height":34},{"text":"들어,","x":422,"y":676,"width":67,"height":35},{"text":"우선순위가","x":502,"y":675,"width":148,"height":35},{"text":"L","x":661,"y":678,"width":17,"height":27},{"text":"\u003c","x":692,"y":685,"width":19,"height":19},{"text":"M","x":723,"y":677,"width":32,"height":27},{"text":"\u003c","x":769,"y":684,"width":20,"height":20},{"text":"H","x":801,"y":677,"width":27,"height":27},{"text":"순서인","x":840,"y":674,"width":89,"height":35},{"text":"L,","x":942,"y":679,"width":27,"height":32},{"text":"M,","x":982,"y":679,"width":41,"height":33},{"text":"H","x":1037,"y":680,"width":29,"height":27},{"text":"세","x":1079,"y":677,"width":28,"height":35},{"text":"개의","x":1124,"y":678,"width":59,"height":34},{"text":"프로세스가","x":1200,"y":677,"width":163,"height":34},{"text":"존재한다","x":1374,"y":675,"width":126,"height":35}]},{"text":"고 가정하자. 프로세스 H가 세마포 S가 필요하고 이 자원은 현재 프로세스 L에 의해 접","words":[{"text":"고","x":292,"y":736,"width":30,"height":24},{"text":"가정하자.","x":336,"y":733,"width":126,"height":35},{"text":"프로세스","x":476,"y":733,"width":118,"height":35},{"text":"H가","x":604,"y":733,"width":56,"height":34},{"text":"세마포","x":672,"y":732,"width":88,"height":35},{"text":"S가","x":771,"y":732,"width":49,"height":35},{"text":"필요하고","x":833,"y":732,"width":118,"height":35},{"text":"이","x":965,"y":733,"width":25,"height":34},{"text":"자원은","x":1006,"y":733,"width":94,"height":35},{"text":"현재","x":1112,"y":735,"width":60,"height":34},{"text":"프로세스","x":1187,"y":735,"width":130,"height":34},{"text":"L에","x":1329,"y":734,"width":50,"height":34},{"text":"의해","x":1395,"y":733,"width":60,"height":35},{"text":"접","x":1471,"y":734,"width":25,"height":33}]},{"text":"근되고 있는 상황을 생각해 보자. 보통은 프로세스 H는 L이 자원의 시용을 마칠 때까지","words":[{"text":"근되고","x":292,"y":790,"width":92,"height":34},{"text":"있는","x":398,"y":792,"width":59,"height":33},{"text":"상황을","x":468,"y":792,"width":88,"height":34},{"text":"생각해","x":569,"y":791,"width":84,"height":35},{"text":"보자.","x":666,"y":790,"width":65,"height":34},{"text":"보통은","x":745,"y":790,"width":89,"height":34},{"text":"프로세스","x":845,"y":790,"width":120,"height":34},{"text":"H는","x":977,"y":793,"width":59,"height":31},{"text":"L이","x":1048,"y":791,"width":48,"height":35},{"text":"자원의","x":1112,"y":792,"width":92,"height":35},{"text":"시용을","x":1220,"y":792,"width":98,"height":34},{"text":"마칠","x":1331,"y":792,"width":61,"height":34},{"text":"때까지","x":1408,"y":790,"width":88,"height":35}]},{"text":"기다리게 된다. 그러나 이 순간 프로세스 M이 실행 가능 상태가 되고, 따라서 프로세스","words":[{"text":"기다리게","x":294,"y":848,"width":118,"height":35},{"text":"된다.","x":428,"y":849,"width":65,"height":34},{"text":"그러나","x":507,"y":849,"width":88,"height":34},{"text":"이","x":607,"y":849,"width":25,"height":34},{"text":"순간","x":647,"y":848,"width":59,"height":34},{"text":"프로세스","x":717,"y":848,"width":119,"height":34},{"text":"M이","x":846,"y":848,"width":60,"height":34},{"text":"실행","x":923,"y":848,"width":57,"height":34},{"text":"가능","x":996,"y":848,"width":61,"height":34},{"text":"상태가","x":1069,"y":848,"width":96,"height":36},{"text":"되고,","x":1179,"y":850,"width":70,"height":35},{"text":"따라서","x":1264,"y":849,"width":94,"height":35},{"text":"프로세스","x":1375,"y":848,"width":125,"height":34}]},{"text":"L을 선점한다고 가정하자. 간접적으로 낮은 우선순위 프로세스(프로세스 M)는 프로세","words":[{"text":"L을","x":293,"y":906,"width":51,"height":34},{"text":"선점한다고","x":359,"y":907,"width":148,"height":35},{"text":"가정하자.","x":522,"y":906,"width":122,"height":35},{"text":"간접적으로","x":660,"y":905,"width":147,"height":35},{"text":"낮은","x":821,"y":905,"width":59,"height":35},{"text":"우선순위","x":893,"y":905,"width":119,"height":34},{"text":"프로세스(프로세스","x":1029,"y":906,"width":267,"height":38},{"text":"M)는","x":1310,"y":909,"width":82,"height":35},{"text":"프로세","x":1408,"y":907,"width":89,"height":34}]},{"text":"스 H가 L이 자원을 양도할 때까지 기다려야 하는 시간에 영향을 주게 된다.","words":[{"text":"스","x":293,"y":967,"width":31,"height":25},{"text":"H가","x":334,"y":965,"width":60,"height":34},{"text":"L이","x":403,"y":965,"width":46,"height":34},{"text":"자원을","x":464,"y":965,"width":87,"height":35},{"text":"양도할","x":561,"y":965,"width":88,"height":34},{"text":"때까지","x":659,"y":963,"width":84,"height":35},{"text":"기다려야","x":758,"y":962,"width":119,"height":36},{"text":"하는","x":887,"y":962,"width":60,"height":35},{"text":"시간에","x":958,"y":962,"width":89,"height":35},{"text":"영향을","x":1063,"y":963,"width":92,"height":34},{"text":"주게","x":1166,"y":965,"width":62,"height":34},{"text":"된다.","x":1244,"y":965,"width":70,"height":34}]},{"text":"이 라이브니스 문제는 우선순위 역전(priority mversion) 문제로 알려져 있으며,","words":[{"text":"이","x":352,"y":1022,"width":26,"height":34},{"text":"라이브니스","x":397,"y":1023,"width":147,"height":34},{"text":"문제는","x":557,"y":1023,"width":89,"height":33},{"text":"우선순위","x":658,"y":1021,"width":116,"height":35},{"text":"역전(priority","x":793,"y":1021,"width":187,"height":39},{"text":"mversion)","x":995,"y":1024,"width":160,"height":34},{"text":"문제로","x":1173,"y":1022,"width":97,"height":34},{"text":"알려져","x":1287,"y":1022,"width":92,"height":34},{"text":"있으며,","x":1401,"y":1021,"width":99,"height":36}]},{"text":"이 문제는 셋 이상의 우선순위를 가진 시스템에서만 발생한다. 통상 우선순위 역전 문제","words":[{"text":"이","x":295,"y":1080,"width":26,"height":34},{"text":"문제는","x":336,"y":1080,"width":92,"height":34},{"text":"셋","x":439,"y":1080,"width":27,"height":34},{"text":"이상의","x":479,"y":1080,"width":84,"height":34},{"text":"우선순위를","x":576,"y":1079,"width