의된다.","x":912,"y":872,"width":144,"height":39}]},{"text":"1.5.3 파일 시스템 관리 Fi1e-System Management","words":[{"text":"1.5.3","x":345,"y":994,"width":120,"height":31},{"text":"파일","x":508,"y":993,"width":64,"height":35},{"text":"시스템","x":585,"y":992,"width":93,"height":35},{"text":"관리","x":692,"y":992,"width":62,"height":35},{"text":"Fi1e-System","x":783,"y":1000,"width":188,"height":28},{"text":"Management","x":982,"y":1001,"width":214,"height":29}]},{"text":"컴퓨터 시스템의 편리한 시용을 위해, 운영체제는 정보 저장장지에 대한 균일한 논리적","words":[{"text":"컴퓨터","x":348,"y":1071,"width":96,"height":39},{"text":"시스템의","x":464,"y":1071,"width":133,"height":39},{"text":"편리한","x":617,"y":1071,"width":103,"height":39},{"text":"시용을","x":734,"y":1070,"width":105,"height":39},{"text":"위해,","x":853,"y":1070,"width":77,"height":39},{"text":"운영체제는","x":946,"y":1071,"width":175,"height":39},{"text":"정보","x":1137,"y":1072,"width":67,"height":37},{"text":"저장장지에","x":1220,"y":1072,"width":170,"height":39},{"text":"대한","x":1408,"y":1072,"width":70,"height":38},{"text":"균일한","x":1491,"y":1072,"width":106,"height":37},{"text":"논리적","x":1610,"y":1072,"width":102,"height":39}]},{"text":"관점을 제공한다. 운영체제는 저장장치의 물리적 특성을 추상화하여 논리적인 저장 단위","words":[{"text":"관점을","x":345,"y":1136,"width":104,"height":37},{"text":"제공한다.","x":462,"y":1136,"width":144,"height":39},{"text":"운영체제는","x":620,"y":1135,"width":175,"height":39},{"text":"저장장치의","x":808,"y":1135,"width":170,"height":39},{"text":"물리적","x":994,"y":1136,"width":100,"height":38},{"text":"특성을","x":1110,"y":1136,"width":105,"height":38},{"text":"추상화하여","x":1226,"y":1137,"width":171,"height":38},{"text":"논리적인","x":1413,"y":1136,"width":139,"height":39},{"text":"저장","x":1567,"y":1136,"width":68,"height":38},{"text":"단위","x":1648,"y":1137,"width":66,"height":39}]},{"text":"인 파일을 정의한다. 운영체제는 파일을 물리적 매체로 매핑하며, 저장장치를 통해 이들","words":[{"text":"인","x":348,"y":1200,"width":30,"height":38},{"text":"파일을","x":393,"y":1200,"width":104,"height":39},{"text":"정의한다.","x":512,"y":1200,"width":143,"height":39},{"text":"운영체제는","x":671,"y":1200,"width":176,"height":39},{"text":"파일을","x":860,"y":1199,"width":106,"height":39},{"text":"물리적","x":978,"y":1201,"width":101,"height":38},{"text":"매체로","x":1097,"y":1200,"width":105,"height":39},{"text":"매핑하며,","x":1215,"y":1201,"width":147,"height":39},{"text":"저장장치를","x":1379,"y":1201,"width":173,"height":39},{"text":"통해","x":1565,"y":1201,"width":67,"height":39},{"text":"이들","x":1649,"y":1202,"width":70,"height":38}]},{"text":"파일에 접근한다.","words":[{"text":"파일에","x":345,"y":1265,"width":100,"height":39},{"text":"접근한다.","x":462,"y":1265,"width":144,"height":39}]},{"text":"파일 관리는 가장 눈에 띄는 운영체제 구성요소 중의 하나이다. 컴퓨터는 여러 유형","words":[{"text":"파일","x":409,"y":1330,"width":67,"height":38},{"text":"관리는","x":491,"y":1330,"width":106,"height":38},{"text":"가장","x":611,"y":1330,"width":69,"height":39},{"text":"눈에","x":693,"y":1330,"width":67,"height":38},{"text":"띄는","x":778,"y":1329,"width":69,"height":39},{"text":"운영체제","x":860,"y":1330,"width":139,"height":39},{"text":"구성요소","x":1016,"y":1331,"width":140,"height":38},{"text":"중의","x":1168,"y":1331,"width":66,"height":38},{"text":"하나이다.","x":1252,"y":1331,"width":146,"height":38},{"text":"컴퓨터는","x":1416,"y":1331,"width":137,"height":38},{"text":"여러","x":1568,"y":1331,"width":63,"height":39},{"text":"유형","x":1649,"y":1333,"width":65,"height":39}]},{"text":"의 물리적 매체에 정보를 저장할 수 있다. 2자 저장장치가 가장 일반적이지만 3차 저장","words":[{"text":"의","x":346,"y":1395,"width":29,"height":38},{"text":"물리적","x":393,"y":1394,"width":100,"height":39},{"text":"매체에","x":513,"y":1395,"width":100,"height":39},{"text":"정보를","x":632,"y":1395,"width":104,"height":38},{"text":"저장할","x":753,"y":1395,"width":104,"height":39},{"text":"수","x":870,"y":1395,"width":36,"height":39},{"text":"있다.","x":924,"y":1395,"width":75,"height":39},{"text":"2자","x":1016,"y":1396,"width":57,"height":39},{"text":"저장장치가","x":1089,"y":1395,"width":172,"height":40},{"text":"가장","x":1275,"y":1395,"width":69,"height":39},{"text":"일반적이지만","x":1361,"y":1396,"width":205,"height":40},{"text":"3차","x":1578,"y":1398,"width":56,"height":39},{"text":"저장","x":1649,"y":1399,"width":70,"height":40}]},{"text":"장치도 가능하다. 이러한 각 매체는 자신의 특성과 물리적 구성을 가지고 있다. 대부부","words":[{"text":"장치도","x":345,"y":1459,"width":103,"height":38},{"text":"가능하다.","x":464,"y":1458,"width":145,"height":40},{"text":"이러한","x":630,"y":1460,"width":104,"height":38},{"text":"각","x":748,"y":1460,"width":36,"height":39},{"text":"매체는","x":800,"y":1460,"width":106,"height":39},{"text":"자신의","x":921,"y":1461,"width":103,"height":40},{"text":"특성과","x":1043,"y":1461,"width":107,"height":39},{"text":"물리적","x":1163,"y":1460,"width":100,"height":39},{"text":"구성을","x":1281,"y":1461,"width":104,"height":39},{"text":"가지고","x":1401,"y":1462,"width":102,"height":39},{"text":"있다.","x":1521,"y":1463,"width":72,"height":39},{"text":"대부부","x":1614,"y":1465,"width":103,"height":39}]},{"text":"의 매체는 디스크 드라이브와 같은 장치에 의해 제어되며, 이들 장치 또한 자신의 독특","words":[{"text":"의","x":346,"y":1523,"width":29,"height":39},{"text":"매체는","x":395,"y":1523,"width":103,"height":39},{"text":"디스크","x":514,"y":1524,"width":102,"height":39},{"text":"드라이브와","x":632,"y":1525,"width":177,"height":39},{"text":"같은","x":823,"y":1526,"width":71,"height":37},{"text":"장치에","x":908,"y":1526,"width":104,"height":39},{"text":"의해","x":1032,"y":1527,"width":66,"height":38},{"text":"제어되며,","x":1117,"y":1526,"width":144,"height":40},{"text":"이들","x":1280,"y":1526,"width":66,"height":39},{"text":"장치","x":1360,"y":1528,"width":66,"height":39},{"text":"또한","x":1444,"y":1529,"width":70,"height":38},{"text":"자신의","x":1528,"y":1529,"width":99,"height":39},{"text":"독특","x":1645,"y":1532,"width":70,"height":37}]},{"text":"한 특성이 있다. 이러한 속성에는 접근 속도, 용량, 데이터 전송률, 그리고 접근 방식(순","words":[{"text":"한","x":345,"y":1588,"width":35,"height":37},{"text":"특성이","x":393,"y":1588,"width":99,"height":39},{"text":"있다.","x":514,"y":1589,"width":74,"height":39},{"text":"이러한","x":607,"y":1589,"width":103,"height":39},{"text":"속성에는","x":723,"y":15