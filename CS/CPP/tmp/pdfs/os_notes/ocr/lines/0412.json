idth":120,"height":35},{"text":"같이","x":819,"y":1678,"width":56,"height":34},{"text":"제한된","x":891,"y":1676,"width":90,"height":36},{"text":"메모리를","x":995,"y":1675,"width":127,"height":35},{"text":"가진","x":1134,"y":1674,"width":64,"height":34},{"text":"시스템을","x":1213,"y":1674,"width":134,"height":35},{"text":"위해","x":1360,"y":1673,"width":63,"height":35},{"text":"설계","x":1440,"y":1674,"width":60,"height":35}]},{"text":"된다. SLOB는 \"smple list of blocks”의 약어이며, 3종류의 객체 리스트를 유지한다.","words":[{"text":"된다.","x":275,"y":1739,"width":66,"height":34},{"text":"SLOB는","x":355,"y":1741,"width":117,"height":31},{"text":"\"smple","x":484,"y":1739,"width":111,"height":40},{"text":"list","x":608,"y":1741,"width":45,"height":28},{"text":"of","x":666,"y":1741,"width":30,"height":28},{"text":"blocks”의","x":708,"y":1737,"width":138,"height":35},{"text":"약어이며,","x":863,"y":1735,"width":128,"height":37},{"text":"3종류의","x":1005,"y":1733,"width":112,"height":35},{"text":"객체","x":1136,"y":1732,"width":60,"height":35},{"text":"리스트를","x":1216,"y":1732,"width":133,"height":35},{"text":"유지한다.","x":1362,"y":1733,"width":139,"height":35}]},{"text":"3종류의 객체는 256바이트보다 작은 객체의 리스트인 small, 1,024바이트보다 작은 객","words":[{"text":"3종류의","x":273,"y":1798,"width":106,"height":34},{"text":"객체는","x":395,"y":1798,"width":87,"height":34},{"text":"256바이트보다","x":491,"y":1797,"width":201,"height":35},{"text":"작은","x":702,"y":1797,"width":61,"height":35},{"text":"객체의","x":776,"y":1796,"width":86,"height":36},{"text":"리스트인","x":879,"y":1794,"width":119,"height":37},{"text":"small,","x":1011,"y":1795,"width":99,"height":33},{"text":"1,024바이트보다","x":1125,"y":1792,"width":254,"height":36},{"text":"작은","x":1392,"y":1792,"width":67,"height":35},{"text":"객","x":1473,"y":1792,"width":27,"height":36}]},{"text":"체의 리스트인 medium, 1,024바이트보다 큰 객체의 리스트인 large이다. 메모리 요청","words":[{"text":"체의","x":275,"y":1856,"width":56,"height":36},{"text":"리스트인","x":348,"y":1856,"width":115,"height":35},{"text":"medium,","x":476,"y":1858,"width":1