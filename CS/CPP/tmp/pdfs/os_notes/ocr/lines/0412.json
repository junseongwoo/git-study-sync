,"width":93,"height":35},{"text":"오버헤드를","x":1008,"y":2031,"width":160,"height":35},{"text":"그게","x":1182,"y":2029,"width":64,"height":35},{"text":"줄였다.","x":1262,"y":2030,"width":109,"height":35},{"text":"예를","x":1391,"y":2030,"width":65,"height":34},{"text":"들","x":1474,"y":2031,"width":24,"height":33}]},{"text":"어, SLAB는 특정 메타데이터를 슬랩마다 저장하는 것과 달리 SLUB는 각 페이지마다","words":[{"text":"어,","x":276,"y":2090,"width":35,"height":34},{"text":"SLAB는","x":324,"y":2091,"width":115,"height":31},{"text":"특정","x":451,"y":2089,"width":56,"height":34},{"text":"메타데이터를","x":524,"y":2089,"width":176,"height":34},{"text":"슬랩마다","x":713,"y":2090,"width":121,"height":34},{"text":"저장하는","x":848,"y":2090,"width":122,"height":34},{"text":"것과","x":985,"y":2089,"width":62,"height":36},{"text":"달리","x":1061,"y":2089,"width":59,"height":35},{"text":"SLUB는","x":1138,"y":2090,"width":131,"height":32},{"text":"각","x":1284,"y":2089,"width":35,"height":34},{"text":"페이지마다","x":1334,"y":2089,"width":168,"height":35}]},{"text":"유지하는 페이지 자료구조에 저장한다. 게다가 SLUB는 SLAB 할당기가 각 개시의 객","words":[{"text":"유지하는","x":274,"y":2147,"width":117,"height":34},{"text":"페이지","x":405,"y":2146,"width":83,"height":35},{"text":"자료구조에","x":505,"y":2146,"width":144,"height":35},{"text":"저장한다.","x":666,"y":2146,"width":123,"height":36},{"text":"게다가","x":806,"y":2147,"width":90,"height":36},{"text":"SLUB는","x":909,"y":2149,"width":122,"height":31},{"text":"SLAB","x":1044,"y":2150,"width":92,"height":27},{"text":"할당기가","x":1152,"y":2146,"width":136,"height":36},{"text":"각","x":1302,"y":2147,"width":36,"height":35},{"text":"개시의","x":1353,"y":2147,"width":97,"height":36},{"text":"객","x":1470,"y":2147,"width":28,"height":35}]},{"text":"체를 위해 유지하던 CPU당 큐를 포함하지 않는다. 많은 수의 처리기를 가진 시스템의","words":[{"text":"체를","x":275,"y":2204,"width":58,"height":34},{"text":"위해","x":346,"y":2204,"width":55,"height":34},{"text":"유지하던","x":416,"y":2204,"width":115,"height":35},{"text":"CPU당","x":545,"y":2204,"width":102,"height":35},{"text":"큐를","x":659,"y