 하나의 CPU를 포함하는 단","words":[{"text":"몇","x":350,"y":2045,"width":30,"height":38},{"text":"년","x":396,"y":2045,"width":31,"height":37},{"text":"전,","x":443,"y":2045,"width":40,"height":39},{"text":"대부부의","x":498,"y":2045,"width":130,"height":40},{"text":"컴퓨터","x":646,"y":2046,"width":94,"height":39},{"text":"시스템은","x":758,"y":2045,"width":135,"height":39},{"text":"단일","x":906,"y":2045,"width":66,"height":38},{"text":"처리","x":988,"y":2045,"width":63,"height":39},{"text":"코어를","x":1068,"y":2045,"width":106,"height":38},{"text":"가진","x":1187,"y":2045,"width":68,"height":39},{"text":"하나의","x":1270,"y":2045,"width":102,"height":39},{"text":"CPU를","x":1388,"y":2047,"width":123,"height":36},{"text":"포함하는","x":1523,"y":2045,"width":144,"height":39},{"text":"단","x":1679,"y":2045,"width":35,"height":37}]},{"text":"일 프로세서를 시용했다. 코어는 명령을 실행하고 로컬로 데이터를 저장하기 위한 레지","words":[{"text":"일","x":350,"y":2109,"width":30,"height":39},{"text":"프로세서를","x":397,"y":2110,"width":169,"height":39},{"text":"시용했다.","x":580,"y":2110,"width":141,"height":40},{"text":"코어는","x":738,"y":2111,"width":102,"height":38},{"text":"명령을","x":855,"y":2110,"width":101,"height":39},{"text":"실행하고","x":971,"y":2110,"width":137,"height":39},{"text":"로컬로","x":1122,"y":2110,"width":105,"height":38},{"text":"데이터를","x":1244,"y":2111,"width":141,"height":38},{"text":"저장하기","x":1400,"y":2110,"width":137,"height":40},{"text":"위한","x":1558,"y":2110,"width":72,"height":39},{"text":"레지","x":1645,"y":2110,"width":63,"height":39}]},{"text":"스터를 포함하는 구성요소이다. 코어를 가진 하나의 메인 CPU는 프로세스의 명령어를","words":[{"text":"스터를","x":347,"y":2175,"width":103,"height":38},{"text":"포함하는","x":464,"y":2175,"width":136,"height":38},{"text":"구성요소이다.","x":614,"y":2175,"width":208,"height":39},{"text":"코어를","x":839,"y":2175,"width":103,"height":39},{"text":"가진","x":957,"y":2176,"width":65,"height":39},{"text":"하나의","x":1038,"y":2175,"width":100,"height":39},{"text":"메인","x":1157,"y":2175,"width":67,"height":39},{"text":"CPU는","x":1241,"y":2178,"width":122,"height":35},{"text":"프로세스의","x":1377,"y":2175,"width":175,"height":39},{"text":"명령어를","x":1573,"y":2175,"width":140,"height":39}]},{"text":"포함하여 범용 명령어 세트를 실행할 수 있다. 이 시스템에는 다른 특수 목적 프로세서","words":[{"text":"포함하여","x":347,"y":2239,"width":133,"height":39},{"text":"범용","x":501,"y":2240,"width":66,"height":38},{"text":"명령어","x":582,"y":2240,"width":96,"height":39},{"text":"세트를","x":697,"y":2240,"width":101,"height":39},{"text":"실행할","x":813,"y":2240,"width":101,"height":38},{"text":"수","x":928,"y":2241,"width":34,"height":39},{"text":"있다.","x":979,"y":2241,"width":71,"height":39},{"text":"이","x":1071,"y":2240,"width":28,"height":38},{"text":"시스템에는","x":1118,"y":2240,"width":177,"height":39},{"text":"다른","x":1310,"y":2240,"width":71,"height":39},{"text":"특수","x":1395,"y":2240,"width":73,"height":39},{"text":"목적","x":1482,"y":2240,"width":68,"height":38},{"text":"프로세서","x":1570,"y":2240,"width":138,"height":39}]},{"text":"도 있다. 디스크, 기보드 및 그래픽 컨트롤러와 같은 장치별 프로세서 형태로 제공될 수","words":[{"text":"도","x":346,"y":2310,"width":34,"height":29},{"text":"있다.","x":397,"y":2305,"width":72,"height":39},{"text":"디스크,","x":488,"y":2304,"width":109,"height":40},{"text":"기보드","x":614,"y":2305,"width":100,"height":39},{"text":"및","x":729,"y":2305,"width":30,"height":38},{"text":"그래픽","x":775,"y":2305,"width":96,"height":39},{"text":"컨트롤러와","x":891,"y":2305,"width":169,"height":40},{"text":"같은","x":1072,"y":2304,"width":69,"height":39},{"text":"장치별","x":1154,"y":2305,"width":104,"height":39},{"text":"프로세서","x":1274,"y":2305,"width":139,"height":39},{"text":"형태로","x":1433,"y":2305,"width":107,"height":39},{"text":"제공될","x":1556,"y":2304,"width":105,"height":39},{"text":"수","x":1676,"y":2305,"width":36,"height":38}]},{"text":"도 있다.","words":[{"text":"도","x":345,"y":2377,"width":35,"height":28},{"text":"있다.","x":395,"y":2370,"width":72,"height":40}]},{"text":"이 모든 전용 처리기들은 제한된 명령어 집합을 실행하고 사용자 프로세스를 실행","words":[{"text":"이","x":412,"y":2437,"width":27,"height":39},{"text":"모든","x":459,"y":2437,"