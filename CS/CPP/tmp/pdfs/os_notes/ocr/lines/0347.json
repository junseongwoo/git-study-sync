ight":28}]},{"text":"나타나면 트랩을 발생시킨다.","words":[{"text":"나타나면","x":280,"y":1371,"width":135,"height":36},{"text":"트랩을","x":429,"y":1371,"width":101,"height":35},{"text":"발생시킨다.","x":542,"y":1370,"width":169,"height":36}]},{"text":"9.3.4 공유 페이지 Shared Pages","words":[{"text":"9.3.4","x":281,"y":1482,"width":129,"height":30},{"text":"공유","x":452,"y":1483,"width":64,"height":32},{"text":"페이지","x":527,"y":1482,"width":92,"height":33},{"text":"Shared","x":644,"y":1490,"width":107,"height":21},{"text":"Pages","x":760,"y":1490,"width":93,"height":26}]},{"text":"페이징의 장점은 공통의 코드를 공유할 수 있다는 점이다. 여러 프로세스가 있는 환경에","words":[{"text":"페이징의","x":282,"y":1554,"width":132,"height":37},{"text":"장점은","x":430,"y":1555,"width":103,"height":35},{"text":"공통의","x":545,"y":1556,"width":95,"height":35},{"text":"코드를","x":656,"y":1556,"width":96,"height":33},{"text":"공유할","x":764,"y":1555,"width":95,"height":36},{"text":"수","x":870,"y":1557,"width":33,"height":35},{"text":"있다는","x":916,"y":1557,"width":91,"height":35},{"text":"점이다.","x":1019,"y":1556,"width":97,"height":36},{"text":"여러","x":1131,"y":1556,"width":57,"height":36},{"text":"프로세스가","x":1202,"y":1555,"width":158,"height":36},{"text":"있는","x":1374,"y":1555,"width":64,"height":36},{"text":"환경에","x":1449,"y":1556,"width":98,"height":38}]},{"text":"서 특히 중요하게 고려해야 할 점이다. 많은 버전의 UNIX 및 Linux에 대한 시스템 콜","words":[{"text":"서","x":283,"y":1613,"width":28,"height":36},{"text":"특히","x":329,"y":1615,"width":64,"height":35},{"text":"중요하게","x":410,"y":1615,"width":133,"height":35},{"text":"고려해야","x":560,"y":1615,"width":131,"height":35},{"text":"할","x":703,"y":1615,"width":32,"height":34},{"text":"점이다.","x":749,"y":1615,"width":99,"height":36},{"text":"많은","x":864,"y":1617,"width":63,"height":35},{"text":"버전의","x":941,"y":1617,"width":86,"height":36},{"text":"UNIX","x":1042,"y":1620,"width":92,"height":28},{"text":"및","x":1150,"y":1617,"width":26,"height":35},{"text":"Linux에","x":1190,"y":1616,"width":122,"height":36},{"text":"대한","x":1329,"y":1616,