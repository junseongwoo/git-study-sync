text":"할당받아서","x":699,"y":1836,"width":167,"height":40},{"text":"점유한다.","x":886,"y":1836,"width":143,"height":38},{"text":"그동안","x":1045,"y":1836,"width":104,"height":39},{"text":"다른","x":1161,"y":1836,"width":68,"height":39},{"text":"모든","x":1241,"y":1838,"width":69,"height":35},{"text":"프로세스는","x":1322,"y":1837,"width":171,"height":38},{"text":"I/0를","x":1505,"y":1838,"width":102,"height":37},{"text":"끝","x":1619,"y":1838,"width":34,"height":36}]},{"text":"내고 준비 큐로 이동하여 CPU를 기다릴 것이다. 프로세스들이 준비 큐에서 기다리는","words":[{"text":"내고","x":314,"y":1900,"width":65,"height":37},{"text":"준비","x":395,"y":1900,"width":62,"height":39},{"text":"큐로","x":477,"y":1904,"width":67,"height":35},{"text":"이동하여","x":563,"y":1901,"width":129,"height":38},{"text":"CPU를","x":712,"y":1902,"width":117,"height":36},{"text":"기다릴","x":847,"y":1900,"width":99,"height":39},{"text":"것이다.","x":968,"y":1901,"width":107,"height":39},{"text":"프로세스들이","x":1094,"y":1901,"width":201,"height":39},{"text":"준비","x":1315,"y":1901,"width":63,"height":39},{"text":"큐에서","x":1398,"y":1902,"width":99,"height":38},{"text":"기다리는","x":1518,"y":1901,"width":135,"height":40}]},{"text":"동안, 1/0 장지들은 쉬고 있다. 마침내 CPU 중심 프로세스가 자신의 CPU 버스트를","words":[{"text":"동안,","x":312,"y":1963,"width":75,"height":38},{"text":"1/0","x":403,"y":1966,"width":66,"height":35},{"text":"장지들은","x":486,"y":1965,"width":135,"height":38},{"text":"쉬고","x":638,"y":1965,"width":66,"height":37},{"text":"있다.","x":723,"y":1965,"width":72,"height":38},{"text":"마침내","x":815,"y":1965,"width":99,"height":38},{"text":"CPU","x":933,"y":1968,"width":82,"height":31},{"text":"중심","x":1032,"y":1966,"width":64,"height":38},{"text":"프로세스가","x":1116,"y":1966,"width":171,"height":38},{"text":"자신의","x":1301,"y":1966,"width":99,"height":38},{"text":"CPU","x":1418,"y":1969,"width":81,"height":31},{"text":"버스트를","x":1518,"y":1967,"width":135,"height":38}]},{"text":"끝내고 I/O 장치로 이동한다. 모든 I/O 중심의 프로세스들은 매우 짧은 CPU 버스트","words":[{"text":"끝내고","x":313,"y":2027,"width":100,"height"