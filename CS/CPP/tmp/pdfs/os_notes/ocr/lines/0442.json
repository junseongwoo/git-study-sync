width":60,"height":35},{"text":"스게줄링","x":1005,"y":1337,"width":120,"height":35},{"text":"알고리즘을","x":1142,"y":1337,"width":156,"height":35},{"text":"사용하든지","x":1309,"y":1336,"width":157,"height":36},{"text":"요청","x":1482,"y":1338,"width":62,"height":35}]},{"text":"개수와 유형에 따라 성능은 크게 달라진다. 예를 들어, 보통 큐에 대기 중인 요청이 하나","words":[{"text":"개수와","x":305,"y":1396,"width":97,"height":36},{"text":"유형에","x":412,"y":1396,"width":93,"height":35},{"text":"따라","x":521,"y":1395,"width":63,"height":36},{"text":"성능은","x":595,"y":1395,"width":93,"height":36},{"text":"크게","x":700,"y":1396,"width":59,"height":35},{"text":"달라진다.","x":774,"y":1396,"width":130,"height":36},{"text":"예를","x":920,"y":1397,"width":62,"height":34},{"text":"들어,","x":992,"y":1396,"width":71,"height":36},{"text":"보통","x":1075,"y":1398,"width":63,"height":34},{"text":"큐에","x":1149,"y":1397,"width":60,"height":35},{"text":"대기","x":1224,"y":1397,"width":58,"height":35},{"text":"중인","x":1297,"y":1396,"width":63,"height":35},{"text":"요청이","x":1373,"y":1396,"width":93,"height":36},{"text":"하나","x":1482,"y":1397,"width":67,"height":35}]},{"text":"만 있다고 가정하자. 그러면 디스크 헤드를 이동할 위치를 하나만 선택할 수 있기 때문","words":[{"text":"만","x":303,"y":1455,"width":33,"height":34},{"text":"있다고","x":352,"y":1456,"width":94,"height":35},{"text":"가정하자.","x":461,"y":1455,"width":131,"height":36},{"text":"그러면","x":608,"y":1455,"width":92,"height":34},{"text":"디스크","x":717,"y":1456,"width":92,"height":34},{"text":"헤드를","x":823,"y":1456,"width":93,"height":35},{"text":"이동할","x":930,"y":1455,"width":93,"height":36},{"text":"위치를","x":1037,"y":1456,"width":93,"height":35},{"text":"하나만","x":1143,"y":1456,"width":95,"height":36},{"text":"선택할","x":1251,"y":1456,"width":95,"height":35},{"text":"수","x":1358,"y":1456,"width":33,"height":35},{"text":"있기","x":1406,"y":1455,"width":58,"height":35},{"text":"때문","x":1484,"y":1456,"width":65,"height":35}]},{"text":"에 모든 스게줄링 알고리즘이 동일하게 작동한다. 즉, 모두 FCFS 스케줄링과 같이 작동","words":[{"text":"에","x":304,"y":1514,"width":28,"heigh