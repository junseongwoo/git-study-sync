33,"height":34},{"text":"있으며,","x":1281,"y":1694,"width":102,"height":36},{"text":"이로","x":1402,"y":1694,"width":64,"height":35},{"text":"인해","x":1485,"y":1695,"width":61,"height":36}]},{"text":"Linux가 마감시간(deadline) 스케줄러를 만들었다. 이 스게줄러는 읽기와 쓰기 별로 큐","words":[{"text":"Linux가","x":302,"y":1753,"width":132,"height":36},{"text":"마감시간(deadline)","x":445,"y":1753,"width":285,"height":39},{"text":"스케줄러를","x":745,"y":1754,"width":154,"height":35},{"text":"만들었다.","x":911,"y":1754,"width":131,"height":35},{"text":"이","x":1057,"y":1754,"width":26,"height":35},{"text":"스게줄러는","x":1098,"y":1754,"width":158,"height":35},{"text":"읽기와","x":1270,"y":1753,"width":94,"height":36},{"text":"쓰기","x":1374,"y":1753,"width":60,"height":36},{"text":"별로","x":1441,"y":1754,"width":62,"height":35},{"text":"큐","x":1516,"y":1758,"width":32,"height":33}]},{"text":"를 유지 관리하며 프로세스가 쓸 때보다 읽을 때 봉쇄될 가능성이 높으므로 읽기 연산","words":[{"text":"를","x":304,"y":1814,"width":33,"height":33},{"text":"유지","x":351,"y":1813,"width":61,"height":35},{"text":"관리하며","x":430,"y":1812,"width":123,"height":36},{"text":"프로세스가","x":571,"y":1813,"width":157,"height":35},{"text":"쓸","x":741,"y":1813,"width":31,"height":35},{"text":"때보다","x":787,"y":1813,"width":92,"height":35},{"text":"읽을","x":895,"y":1813,"width":60,"height":35},{"text":"때","x":969,"y":1814,"width":27,"height":35},{"text":"봉쇄될","x":1013,"y":1814,"width":93,"height":35},{"text":"가능성이","x":1122,"y":1813,"width":122,"height":36},{"text":"높으므로","x":1261,"y":1815,"width":128,"height":33},{"text":"읽기","x":1406,"y":1813,"width":58,"height":36},{"text":"연산","x":1486,"y":1815,"width":64,"height":34}]},{"text":"에 높은 우선순위를 준다. 대기열은 LBA 순서로 정렬되어 기본적으로 C-SCAN을 구","words":[{"text":"에","x":305,"y":1872,"width":29,"height":35},{"text":"높은","x":352,"y":1873,"width":65,"height":33},{"text":"우선순위를","x":430,"y":1872,"width":159,"height":35},{"text":"준다.","x":601,"y":1872,"width":69,"height":35},{"text":"대기열은","x":688,"y":1872,"width":123,"height":36},{"text":"LBA","x":824,"y":1877,"