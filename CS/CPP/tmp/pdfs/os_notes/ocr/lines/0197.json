{"page":197,"width":1873,"height":2754,"text_angle":0,"lines":[{"text":"5.6 실시간 CPU 스케줄링","words":[{"text":"5.6","x":1200,"y":164,"width":58,"height":25},{"text":"실시간","x":1275,"y":164,"width":74,"height":28},{"text":"CPU","x":1357,"y":166,"width":59,"height":25},{"text":"스케줄링","x":1426,"y":164,"width":95,"height":27}]},{"text":"1. 인터럽트지인시간","words":[{"text":"1.","x":363,"y":310,"width":26,"height":28},{"text":"인터럽트지인시간","x":418,"y":304,"width":276,"height":38}]},{"text":"2. 디스패치 지인시간","words":[{"text":"2.","x":364,"y":373,"width":27,"height":28},{"text":"디스패치","x":419,"y":368,"width":127,"height":38},{"text":"지인시간","x":565,"y":368,"width":131,"height":38}]},{"text":"251","words":[{"text":"251","x":1598,"y":159,"width":55,"height":31}]},{"text":"인터럽트 지연시간은 CPU에 인터럽트가 발생한 시점부터 해당 인터럽트 처리 루틴","words":[{"text":"인터럽트","x":399,"y":496,"width":133,"height":37},{"text":"지연시간은","x":546,"y":495,"width":163,"height":38},{"text":"CPU에","x":721,"y":495,"width":111,"height":38},{"text":"인터럽트가","x":849,"y":493,"width":165,"height":39},{"text":"발생한","x":1026,"y":493,"width":101,"height":38},{"text":"시점부터","x":1139,"y":493,"width":129,"height":38},{"text":"해당","x":1286,"y":493,"width":68,"height":39},{"text":"인터럽트","x":1368,"y":492,"width":133,"height":39},{"text":"처리","x":1516,"y":489,"width":62,"height":40},{"text":"루틴","x":1594,"y":489,"width":68,"height":39}]},{"text":"이 시작하기까지의 시간을 말한다. 인터럽트가 발생하면 운영체제는 우선 수행 중인 명","words":[{"text":"이","x":334,"y":558,"width":28,"height":37},{"text":"시작하기까지의","x":382,"y":558,"width":231,"height":38},{"text":"시간을","x":633,"y":557,"width":98,"height":37},{"text":"말한다.","x":746,"y":558,"width":106,"height":38},{"text":"인터럽트가","x":871,"y":557,"width":164,"height":38},{"text":"발생하면","x":1050,"y":556,"width":132,"height":39},{"text":"운영체제는","x":1197,"y":557,"width":171,"height":38},{"text":"우선","x":1381,"y":556,"width":67,"height":39},{"text":"수행","x":1463,"y":555,"width":65,"height":38},{"text":"중인","x":1545,"y":553,"width":68,"height":39},{"text":