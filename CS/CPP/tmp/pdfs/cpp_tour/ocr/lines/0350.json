,"y":1682,"width":57,"height":31},{"text":"에러가","x":1209,"y":1682,"width":88,"height":33}]},{"text":"적으며, 빠르다는 것이다. 이를 위해서는 일관된 프로그래밍 스타일을 개발하고 퍼트","words":[{"text":"적으며,","x":190,"y":1747,"width":94,"height":33},{"text":"빠르다는","x":298,"y":1747,"width":126,"height":33},{"text":"것이다.","x":437,"y":1747,"width":91,"height":33},{"text":"이를","x":546,"y":1747,"width":56,"height":32},{"text":"위해서는","x":614,"y":1747,"width":113,"height":32},{"text":"일관된","x":740,"y":1747,"width":81,"height":32},{"text":"프로그래밍","x":833,"y":1747,"width":139,"height":33},{"text":"스타일을","x":986,"y":1746,"width":114,"height":34},{"text":"개발하고","x":1112,"y":1747,"width":114,"height":32},{"text":"퍼트","x":1240,"y":1748,"width":56,"height":32}]},{"text":"리며 지원해야 한다. 더 나아가 예전 코드가 현대적이고 효과적이며, 일관된 스타일로","words":[{"text":"리며","x":190,"y":1811,"width":54,"height":33},{"text":"지원해야","x":261,"y":1811,"width":117,"height":34},{"text":"한다.","x":388,"y":1811,"width":64,"height":33},{"text":"더","x":470,"y":1812,"width":24,"height":32},{"text":"나아가","x":510,"y":1811,"width":85,"height":33},{"text":"예전","x":608,"y":1812,"width":54,"height":31},{"text":"코드가","x":675,"y":1812,"width":85,"height":33},{"text":"현대적이고","x":772,"y":1813,"width":139,"height":33},{"text":"효과적이며,","x":923,"y":1812,"width":147,"height":34},{"text":"일관된","x":1084,"y":1812,"width":83,"height":32},{"text":"스타일로","x":1180,"y":1813,"width":115,"height":31}]},{"text":"진화하도록 지원해야 한다.","words":[{"text":"진화하도록","x":189,"y":1875,"width":148,"height":32},{"text":"지원해야","x":354,"y":1875,"width":117,"height":33},{"text":"한다.","x":486,"y":1876,"width":65,"height":33}]},{"text":"역사럽 호환성 357","words":[{"text":"역사럽","x":1086,"y":2028,"width":62,"height":21},{"text":"호환성","x":1160,"y":2027,"width":63,"height":24},{"text":"357","x":1246,"y":2026,"width":47,"height":25}]}]}