idth":64,"height":36},{"text":"부동산","x":979,"y":1889,"width":102,"height":37},{"text":"개발","x":1092,"y":1889,"width":67,"height":36},{"text":"프로젝트","x":1169,"y":1889,"width":138,"height":36},{"text":"책임자입니다.","x":1320,"y":1886,"width":218,"height":38},{"text":"여러분은","x":1558,"y":1886,"width":136,"height":36}]},{"text":"개발될 부동산에 대한 다양한 정보를 제공받았고, 이를 활용하여 최대한 저렴하게 도로 시스템을","words":[{"text":"개발될","x":233,"y":1962,"width":103,"height":36},{"text":"부동산에","x":352,"y":1961,"width":133,"height":37},{"text":"대한","x":501,"y":1961,"width":64,"height":36},{"text":"다양한","x":576,"y":1961,"width":96,"height":36},{"text":"정보를","x":684,"y":1961,"width":95,"height":36},{"text":"제공받았고,","x":791,"y":1960,"width":168,"height":38},{"text":"이를","x":977,"y":1960,"width":65,"height":37},{"text":"활용하여","x":1054,"y":1959,"width":130,"height":37},{"text":"최대한","x":1202,"y":1960,"width":103,"height":36},{"text":"저렴하게","x":1318,"y":1958,"width":137,"height":37},{"text":"도로","x":1472,"y":1961,"width":70,"height":26},{"text":"시스템을","x":1556,"y":1956,"width":138,"height":38}]},{"text":"설계해야 합니다.","words":[{"text":"설계해야","x":232,"y":2032,"width":143,"height":37},{"text":"합니다.","x":385,"y":2031,"width":108,"height":37}]},{"text":"많은 주택 단지가 호수, 숲 및 산이 많은 지역에 건설될 예정입니다. 이러한 지역에는 지반이 너무","words":[{"text":"많은","x":232,"y":2119,"width":72,"height":36},{"text":"주택","x":315,"y":2119,"width":67,"height":37},{"text":"단지가","x":396,"y":2118,"width":102,"height":37},{"text":"호수,","x":507,"y":2118,"width":72,"height":38},{"text":"숲","x":594,"y":2119,"width":33,"height":35},{"text":"및","x":640,"y":2118,"width":28,"height":36},{"text":"산이","x":680,"y":2118,"width":60,"height":36},{"text":"많은","x":755,"y":2118,"width":64,"height":36},{"text":"지역에","x":831,"y":2119,"width":92,"height":36},{"text":"건설될","x":939,"y":2117,"width":93,"height":36},{"text":"예정입니다.","x":1047,"y":2117,"width":172,"height":37},{"text":"이러한","x":1238,"y":2118,"width":104,"height":36},{"text":"지역에는","x":1354,"y":2117,"width":141,"height":35},{"text":"지반이","x":1507,"y":2115,"width":101,"height":37},{"text":"너무","x":1626,"y":2115,"width":66,"height":37}]},{"text":"단단해서 단지 건설이 훨씬 더 복잡해질 수 있습니다. 건설 비펑은 지반 강도에 영향-을 받는다고","words":[{"text":"단단해서","x":232,"y":2189,"width":137,"height":36},{"text":"단지","x":387,"y":2189,"width":62,"height":36},{"text":"건설이","x":468,"y":2188,"width":92,"height":35},{"text":"훨씬","x":577,"y":2188,"width":63,"height":35},{"text":"더","x":655,"y":2188,"width":26,"height":36},{"text":"복잡해질","x":697,"y":2188,"width":126,"height":35},{"text":"수","x":838,"y":2189,"width":33,"height":35},{"text":"있습니다.","x":885,"y":2188,"width":134,"height":36},{"text":"건설","x":1039,"y":2188,"width":61,"height":35},{"text":"비펑은","x":1117,"y":2187,"width":99,"height":37},{"text":"지반","x":1231,"y":2188,"width":69,"height":36},{"text":"강도에","x":1313,"y":2187,"width":102,"height":37},{"text":"영향-을","x":1435,"y":2187,"width":104,"height":36},{"text":"받는다고","x":1553,"y":2186,"width":138,"height":37}]},{"text":"알려져 있습니다. 일단 도로가 건설되는 위치의 지반 강도와 관련하여 비용이 선형으로 증가한다","words":[{"text":"알려져","x":233,"y":2258,"width":101,"height":38},{"text":"있습니다.","x":354,"y":2258,"width":137,"height":37},{"text":"일단","x":512,"y":2257,"width":63,"height":36},{"text":"도로가","x":585,"y":2258,"width":98,"height":36},{"text":"건설되는","x":696,"y":2258,"width":126,"height":36},{"text":"위치의","x":835,"y":2258,"width":92,"height":35},{"text":"지반","x":944,"y":2257,"width":64,"height":36},{"text":"강도와","x":1020,"y":2257,"width":99,"height":36},{"text":"관련하여","x":1129,"y":2257,"width":132,"height":38},{"text":"비용이","x":1280,"y":2258,"width":98,"height":37},{"text":"선형으로","x":1397,"y":2258,"width":141,"height":36},{"text":"증가한다","x":1551,"y":2257,"width":140,"height":38}]},{"text":"고 고려해야 합니다.","words":[{"text":"고","x":234,"y":2332,"width":35,"height":26},{"text":"고려해야","x":281,"y":2329,"width":137,"height":36},{"text":"합니다.","x":428,"y":2328,"width":105,"height":37}]}]}