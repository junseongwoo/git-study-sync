{"page":96,"width":2000,"height":2796,"text_angle":0,"lines":[{"text":"STRUCTURES \u0026 ALGORITHMS","words":[{"text":"STRUCTURES","x":1233,"y":183,"width":195,"height":22},{"text":"\u0026","x":1447,"y":183,"width":16,"height":20},{"text":"ALGORITHMS","x":1483,"y":181,"width":198,"height":22}]},{"text":"2.6","words":[{"text":"2.6","x":225,"y":201,"width":144,"height":92}]},{"text":"그래프","words":[{"text":"그래프","x":458,"y":254,"width":206,"height":76}]},{"text":"트리는 계층적 데이터를 표현하는 좋은 방법이지만, 하나의 노드에서 다른 노드로 이동하는 경로","words":[{"text":"트리는","x":225,"y":440,"width":107,"height":39},{"text":"계층적","x":346,"y":440,"width":99,"height":40},{"text":"데이터를","x":465,"y":440,"width":138,"height":40},{"text":"표현하는","x":616,"y":438,"width":141,"height":39},{"text":"좋은","x":769,"y":437,"width":71,"height":39},{"text":"방법이지만,","x":854,"y":438,"width":182,"height":42},{"text":"하나의","x":1055,"y":438,"width":100,"height":39},{"text":"노드에서","x":1172,"y":437,"width":137,"height":39},{"text":"다른","x":1327,"y":436,"width":70,"height":40},{"text":"노드로","x":1409,"y":440,"width":106,"height":29},{"text":"이동하는","x":1530,"y":436,"width":141,"height":39},{"text":"경로","x":1686,"y":435,"width":70,"height":40}]},{"text":"가 하나만 존재하기 때문에 원형 또는 순환적인 종속성을 표현할 수 없습니다. 그러나 실생활에","words":[{"text":"가","x":226,"y":517,"width":35,"height":39},{"text":"하나만","x":276,"y":516,"width":105,"height":39},{"text":"존재하기","x":395,"y":515,"width":135,"height":40},{"text":"때문에","x":552,"y":514,"width":101,"height":40},{"text":"원형","x":672,"y":513,"width":65,"height":39},{"text":"또는","x":756,"y":514,"width":70,"height":37},{"text":"순환적인","x":841,"y":514,"width":140,"height":38},{"text":"종속성을","x":997,"y":513,"width":141,"height":40},{"text":"표현할","x":1153,"y":513,"width":107,"height":39},{"text":"수","x":1273,"y":513,"width":36,"height":39},{"text":"없습니다.","x":1327,"y":512,"width":145,"height":40},{"text":"그러나","x":1492,"y":512,"width":108,"height":39},{"text":"실생활에","x":1616,"y":512,"width":137,"height":40}]},{"text":"서 순환 구조를 久卜우하여 표현해야 하는 시나리오도 많이 존재합니다. 예를 들어 도로망을 생각해","words":[{"text":"서","x":225,"y":593,"width":30,"height":39},{"text":"순환","x":270,"y":592,"width":73,"height":39},{"text":"구조를","x":352,"y":593,"width":106,"height":39},{"text":"久卜우하여","x":469,"y":590,"width":137,"height":41},{"text":"표현해야","x":622,"y":589,"width":142,"height":39},{"text":"하는","x":776,"y":589,"width":71,"height":39},{"text":"시나리오도","x":860,"y":590,"width":175,"height":39},{"text":"많이","x":1048,"y":589,"width":65,"height":40},{"text":"존재합니다.","x":1128,"y":589,"width":184,"height":40},{"text":"예를","x":1331,"y":589,"width":70,"height":39},{"text":"들어","x":1412,"y":588,"width":67,"height":40},{"text":"도로망을","x":1496,"y":589,"width":143,"height":39},{"text":"생각해","x":1651,"y":589,"width":102,"height":39}]},{"text":"보면, 특정 장소(노드)에서 다른 장소로 이동하기 위한 다양한 경로가 존재할 수 있습니다. 이러한","words":[{"text":"보면,","x":223,"y":669,"width":77,"height":41},{"text":"특정","x":317,"y":668,"width":66,"height":39},{"text":"장소(노드)에서","x":398,"y":665,"width":231,"height":42},{"text":"다른","x":646,"y":666,"width":71,"height":38},{"text":"장소로","x":728,"y":665,"width":106,"height":39},{"text":"이동하기","x":848,"y":665,"width":136,"height":41},{"text":"위한","x":1002,"y":666,"width":70,"height":39},{"text":"다양한","x":1083,"y":666,"width":106,"height":39},{"text":"경로가","x":1202,"y":665,"width":105,"height":40},{"text":"존재할","x":1318,"y":665,"width":107,"height":40},{"text":"수","x":1436,"y":666,"width":36,"height":39},{"text":"있습니다.","x":1486,"y":665,"width":148,"height":40},{"text":"이러한","x":1653,"y":665,"width":105,"height":39}]},{"text":"경우에는 그래프(graph) 구조를 A卜\u0026하는 것이 더욱 바람직합니다.","words":[{"text":"경우에는","x":224,"y":745,"width":138,"height":40},{"text":"그래프(graph)","x":372,"y":743,"width":208,"height":39},{"text":"구조를","x":595,"y":743,"width":108,"height":38},{"text":"A卜\u0026하는","x":714,"y":741,"width":144,"height":40},{"text":"것이","x":871,"y":743,"width":65,"height":39},{"text":"더욱","x":954,"y":742,"width":70,"height":40},{"text":"바람직합니다.","x":1035,"y":741,"width":218,"height":40}]},{"text":"그래프는 노드 데이터뿐만 아니라 노드 사이의 에지 데이터도 저장해야 합니다. 도로망을 예로 들","words":[{"text":"그래프는","x":222,"y":840,"width":138,"height":40},{"text":"노드","x":371,"y":842,"width":71,"height":29},{"text":"데이터뿐만","x":455,"y":836,"width":177,"height":41},{"text":"아니라","x":644,"y":836,"width":107,"height":40},{"text":"노드","x":762,"y":841,"width":72,"height":29},{"text":"사이의","x":846,"y":838,"width":104,"height":39},{"text":"에지","x":967,"y":838,"width":65,"height":39},{"text":"데이터도","x":1051,"y":836,"width":138,"height":40},{"text":"저장해야","x":1203,"y":836,"width":140,"height":40},{"text":"합니다.","x":1354,"y":837,"width":115,"height":39},{"text":"도로망을","x":1486,"y":837,"width":143,"height":39},{"text":"예로","x":1641,"y":837,"width":70,"height":39},{"text":"들","x":1722,"y":838,"width":37,"height":36}]},{"text":"면 각각의 노드(장소)에 다른 어떤 노드들이 연결되어 있는지에 대한 정보를 가지고 있어야 합니","words":[{"text":"면","x":224,"y":918,"width":31,"height":37},{"text":"각각의","x":270,"y":915,"width":100,"height":41},{"text":"노드(장소)에","x":387,"y":913,"width":196,"height":41},{"text":"다른","x":601,"y":913,"width":72,"height":39},{"text":"어떤","x":689,"y":914,"width":68,"height":39},{"text":"노드들이","x":772,"y":915,"width":140,"height":39},{"text":"연결되어","x":934,"y":914,"width":135,"height":39},{"text":"있는지에","x":1090,"y":912,"width":134,"height":40},{"text":"대한","x":1243,"y":913,"width":71,"height":39},{"text":"정보를","x":1328,"y":913,"width":105,"height":39},{"text":"가지고","x":1448,"y":913,"width":106,"height":39},{"text":"있어야","x":1570,"y":913,"width":105,"height":39},{"text":"합니","x":1688,"y":913,"width":66,"height":38}]},{"text":"다. 이런 방법으로 필요한 모든 노드와 에지가 있는 그래프를 만들 수 있으며, 이러한 그래프를 비","words":[{"text":"다.","x":222,"y":994,"width":41,"height":38},{"text":"이런","x":282,"y":993,"width":66,"height":39},{"text":"방법으로","x":362,"y":991,"width":138,"height":40},{"text":"필요한","x":513,"y":990,"width":107,"height":39},{"text":"모든","x":630,"y":992,"width":73,"height":37},{"text":"노드와","x":715,"y":991,"widt