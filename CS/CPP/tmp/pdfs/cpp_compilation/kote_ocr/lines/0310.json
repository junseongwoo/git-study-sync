 해석할 수","words":[{"text":"•","x":237,"y":1732,"width":11,"height":11},{"text":"미로에","x":281,"y":1721,"width":99,"height":36},{"text":"점수를","x":398,"y":1721,"width":101,"height":36},{"text":"무한히","x":510,"y":1721,"width":96,"height":37},{"text":"낮출","x":622,"y":1722,"width":66,"height":35},{"text":"수","x":698,"y":1722,"width":34,"height":36},{"text":"있는","x":745,"y":1722,"width":61,"height":36},{"text":"경로가","x":818,"y":1721,"width":91,"height":36},{"text":"있는지를","x":921,"y":1720,"width":118,"height":37},{"text":"판단하는","x":1050,"y":1719,"width":120,"height":36},{"text":"것은","x":1182,"y":1718,"width":61,"height":36},{"text":"수음과","x":1253,"y":1717,"width":93,"height":35},{"text":"같이","x":1357,"y":1716,"width":57,"height":36},{"text":"해석할","x":1429,"y":1716,"width":95,"height":36},{"text":"수","x":1534,"y":1717,"width":33,"height":35}]},{"text":"있습니다. 즉, 미로를 가중 그래프로 표현하고, 여기에 음수 가중치 사이클이 있는지를 판단","words":[{"text":"있습니다.","x":283,"y":1787,"width":143,"height":36},{"text":"즉,","x":441,"y":1789,"width":43,"height":35},{"text":"미로를","x":501,"y":1787,"width":99,"height":36},{"text":"가중","x":611,"y":1788,"width":65,"height":35},{"text":"그래프로","x":686,"y":1787,"width":127,"height":36},{"text":"표현하고,","x":822,"y":1787,"width":129,"height":37},{"text":"여기에","x":966,"y":1786,"width":86,"height":37},{"text":"음수","x":1064,"y":1786,"width":61,"height":35},{"text":"가중치","x":1134,"y":1784,"width":88,"height":36},{"text":"사이클이","x":1235,"y":1782,"width":120,"height":37},{"text":"있는지를","x":1371,"y":1782,"width":121,"height":35},{"text":"판단","x":1503,"y":1782,"width":64,"height":36}]},{"text":"하는 것과 같습니다. 그리고 이러한 문제 해결은 앞에서 다룬 바가 있습니다. 그수음으로 판","words":[{"text":"하는","x":281,"y":1853,"width":70,"height":37},{"text":"것과","x":364,"y":1853,"width":67,"height":36},{"text":"같습니다.","x":442,"y":1852,"width":141,"height":36},{"text":"그리고","x":598,"y":1853,"width":99,"height":35},{"text":"이러한","x":709,"y":1853,"width":94,"height":35},{"text":"문제","x":811,"y":1852,"width":60,"height":36},{"text":"해