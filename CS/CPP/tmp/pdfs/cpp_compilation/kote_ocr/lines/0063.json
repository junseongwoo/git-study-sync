,"height":41},{"text":"선형","x":542,"y":1476,"width":68,"height":40},{"text":"구조에서는","x":627,"y":1477,"width":184,"height":41},{"text":"최대","x":824,"y":1477,"width":69,"height":41},{"text":"두","x":910,"y":1480,"width":38,"height":37},{"text":"가지","x":962,"y":1478,"width":69,"height":40},{"text":"방향(순방향과","x":1050,"y":1477,"width":239,"height":42},{"text":"역방향)으로","x":1305,"y":1476,"width":201,"height":42},{"text":"자료를","x":1520,"y":1476,"width":119,"height":40},{"text":"순회할","x":1652,"y":1476,"width":121,"height":41},{"text":"수","x":1785,"y":1476,"width":40,"height":40},{"text":"있","x":1841,"y":1477,"width":34,"height":39}]},{"text":"습니다. 그러나 이러한 구조는 매우 제한적이어서 복잡한 문제에는 적용하기 어렵습니다. 이 장에","words":[{"text":"습니다.","x":240,"y":1556,"width":121,"height":40},{"text":"그러나","x":379,"y":1555,"width":112,"height":40},{"text":"이러한","x":504,"y":1555,"width":110,"height":41},{"text":"구조는","x":624,"y":1558,"width":111,"height":38},{"text":"매우","x":746,"y":1557,"width":74,"height":40},{"text":"제한적이어서","x":832,"y":1556,"width":218,"height":41},{"text":"복잡한","x":1065,"y":1557,"width":115,"height":40},{"text":"문제에는","x":1190,"y":1556,"width":154,"height":40},{"text":"적용하기","x":1357,"y":1555,"width":147,"height":41},{"text":"어렵습니다.","x":1525,"y":1554,"width":203,"height":41},{"text":"이","x":1750,"y":1554,"width":32,"height":40},{"text":"장에","x":1800,"y":1554,"width":72,"height":41}]},{"text":"서는 좀 더 고수준의 문제를 다를 것이며, 이 경우 이전 장에서 구현했던 방법들을 그대로 적용하","words":[{"text":"서는","x":242,"y":1634,"width":75,"height":40},{"text":"좀","x":328,"y":1637,"width":39,"height":37},{"text":"더","x":381,"y":1634,"width":31,"height":41},{"text":"고수준의","x":429,"y":1634,"width":144,"height":41},{"text":"문제를","x":590,"y":1636,"width":111,"height":39},{"text":"다를","x":714,"y":1635,"width":73,"height":40},{"text":"것이며,","x":801,"y":1635,"width":117,"height":42},{"text":"이","x":938,"y":1636,"width":31,"height":40},{"text":"경우","x":989,"y":1636,"width":73,"height":40},{"text":"이전","x":1077,"y":1635,"width":71,"height"