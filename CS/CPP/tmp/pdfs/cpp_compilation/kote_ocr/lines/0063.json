":230,"height":40}]},{"text":"다. 그러고 나서 좀 더 복잡한 형태의 자료 구조인 그래프에 대해 살펴볼 것입니다. 그래프는 두","words":[{"text":"다.","x":246,"y":2122,"width":45,"height":40},{"text":"그러고","x":311,"y":2120,"width":109,"height":41},{"text":"나서","x":436,"y":2120,"width":67,"height":40},{"text":"좀","x":521,"y":2121,"width":39,"height":37},{"text":"더","x":576,"y":2119,"width":29,"height":39},{"text":"복잡한","x":625,"y":2119,"width":112,"height":39},{"text":"형태의","x":751,"y":2118,"width":104,"height":41},{"text":"자료","x":873,"y":2118,"width":73,"height":40},{"text":"구조인","x":961,"y":2117,"width":108,"height":41},{"text":"그래프에","x":1085,"y":2116,"width":146,"height":40},{"text":"대해","x":1251,"y":2116,"width":71,"height":40},{"text":"살펴볼","x":1340,"y":2115,"width":116,"height":40},{"text":"것입니다.","x":1473,"y":2115,"width":164,"height":41},{"text":"그래프는","x":1659,"y":2116,"width":161,"height":39},{"text":"두","x":1834,"y":2117,"width":40,"height":38}]},{"text":"가지 형태로 구현할 수 있습니다. 이들 구조는 실세계에서 접할 수 있는 문제를 수학적 형태로 표","words":[{"text":"가지","x":247,"y":2200,"width":67,"height":41},{"text":"형태로","x":333,"y":2200,"width":109,"height":40},{"text":"구현할","x":454,"y":2197,"width":111,"height":41},{"text":"수","x":576,"y":2197,"width":38,"height":39},{"text":"있습니다.","x":630,"y":2197,"width":151,"height":41},{"text":"이들","x":801,"y":2197,"width":72,"height":40},{"text":"구조는","x":885,"y":2198,"width":110,"height":38},{"text":"실세계에서","x":1009,"y":2194,"width":177,"height":41},{"text":"접할","x":1207,"y":2194,"width":75,"height":40},{"text":"수","x":1293,"y":2194,"width":39,"height":38},{"text":"있는","x":1348,"y":2192,"width":74,"height":40},{"text":"문제를","x":1434,"y":2192,"width":119,"height":40},{"text":"수학적","x":1565,"y":2193,"width":115,"height":40},{"text":"형태로","x":1701,"y":2193,"width":118,"height":40},{"text":"표","x":1833,"y":2197,"width":39,"height":29}]},{"text":"현합니다. 그런 다음 실제 프로그래밍을 통해 주어진 문제를 해결해보겠습니다.","words":[{"text":"현합니다.","x":246,"y":2278,"width":153,"height":41},{"text":"그런","x":416,"y":2277,"width":71,