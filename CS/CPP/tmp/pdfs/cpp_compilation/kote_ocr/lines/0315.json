":1618,"y":1521,"width":70,"height":36},{"text":"방","x":1705,"y":1520,"width":36,"height":37}]},{"text":"법을 가지고 있으며, 프로그래머에게 직관적인 작업 방식을 크게 뛰어넘는 통찰력을 선사하기도","words":[{"text":"법을","x":226,"y":1594,"width":67,"height":37},{"text":"가지고","x":307,"y":1593,"width":98,"height":38},{"text":"있으며,","x":421,"y":1593,"width":105,"height":38},{"text":"프로그래머에게","x":545,"y":1594,"width":231,"height":37},{"text":"직관적인","x":793,"y":1592,"width":135,"height":37},{"text":"작업","x":944,"y":1592,"width":66,"height":37},{"text":"방식을","x":1028,"y":1593,"width":107,"height":37},{"text":"크게","x":1148,"y":1592,"width":69,"height":37},{"text":"뛰어넘는","x":1236,"y":1592,"width":142,"height":37},{"text":"통찰력을","x":1392,"y":1592,"width":148,"height":37},{"text":"선사하기도","x":1556,"y":1592,"width":183,"height":38}]},{"text":"합니다.","words":[{"text":"합니다.","x":224,"y":1666,"width":109,"height":38}]},{"text":"이전 장에서는 분할 정복과 그리디 알고리즘 같은 기법들에 대해 알아봤습니다. 이러한 방법들은","words":[{"text":"이전","x":225,"y":1755,"width":66,"height":37},{"text":"장에서는","x":304,"y":1755,"width":132,"height":37},{"text":"분할","x":447,"y":1755,"width":67,"height":36},{"text":"정복과","x":527,"y":1755,"width":99,"height":37},{"text":"그리디","x":637,"y":1756,"width":96,"height":36},{"text":"알고리즘","x":751,"y":1754,"width":135,"height":37},{"text":"같은","x":899,"y":1754,"width":69,"height":36},{"text":"기법들에","x":981,"y":1753,"width":137,"height":37},{"text":"대해","x":1136,"y":1753,"width":68,"height":38},{"text":"알아봤습니다.","x":1221,"y":1753,"width":224,"height":37},{"text":"이러한","x":1467,"y":1753,"width":110,"height":37},{"text":"방법들은","x":1591,"y":1752,"width":147,"height":37}]},{"text":"특정 상횡에서는 상당히 효과적이지만, 그렇지 않은 경우에는 최적의 결과를 도출하지 못할 수 있","words":[{"text":"특정","x":222,"y":1827,"width":65,"height":36},{"text":"상횡에서는","x":302,"y":1827,"width":165,"height":37},{"text":"상당히","x":477,"y":1827,"width":95,"height":37},{"text":"효과적이지만,","x":587,"y":1827,"width":207,"height":37},{"text":"그렇지","x":810,"y":1826,"width":99,"height":38},{"text":"않은","x":926,"y"