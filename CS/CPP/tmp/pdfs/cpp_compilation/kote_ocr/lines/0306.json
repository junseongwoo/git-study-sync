text":"자동으로","x":962,"y":1150,"width":124,"height":35},{"text":"생성하는","x":1097,"y":1150,"width":122,"height":35},{"text":"시스템을","x":1232,"y":1150,"width":119,"height":34},{"text":"개발했습니다.","x":1365,"y":1151,"width":193,"height":35}]},{"text":"그런데 자동 생성된 미로 중 일부에서 플레이어의 점수를 무한히 낮출 수 있는 이동 경로가 존재","words":[{"text":"그런데","x":193,"y":1218,"width":94,"height":35},{"text":"자동","x":304,"y":1218,"width":67,"height":34},{"text":"생성된","x":384,"y":1218,"width":98,"height":35},{"text":"미로","x":498,"y":1218,"width":64,"height":34},{"text":"중","x":573,"y":1219,"width":34,"height":33},{"text":"일부에서","x":622,"y":1218,"width":120,"height":34},{"text":"플레이어의","x":758,"y":1217,"width":154,"height":36},{"text":"점수를","x":929,"y":1219,"width":93,"height":35},{"text":"무한히","x":1032,"y":1218,"width":88,"height":35},{"text":"낮출","x":1136,"y":1218,"width":61,"height":35},{"text":"수","x":1208,"y":1218,"width":31,"height":34},{"text":"있는","x":1253,"y":1218,"width":59,"height":34},{"text":"이동","x":1324,"y":1218,"width":59,"height":35},{"text":"경로가","x":1397,"y":1219,"width":90,"height":35},{"text":"존재","x":1498,"y":1220,"width":62,"height":34}]},{"text":"한다는 점을 알게 되었습니다. 또한 몇몇 플레이어는 시작 지점에 따라 점수 계산에 불이익을 받","words":[{"text":"한다는","x":193,"y":1286,"width":98,"height":34},{"text":"점을","x":305,"y":1286,"width":66,"height":33},{"text":"알게","x":385,"y":1286,"width":62,"height":34},{"text":"되었습니다.","x":464,"y":1285,"width":169,"height":35},{"text":"또한","x":650,"y":1285,"width":66,"height":33},{"text":"몇몇","x":728,"y":1285,"width":60,"height":35},{"text":"플레이어는","x":801,"y":1286,"width":158,"height":35},{"text":"시작","x":971,"y":1287,"width":62,"height":34},{"text":"지점에","x":1045,"y":1287,"width":88,"height":34},{"text":"따라","x":1148,"y":1287,"width":62,"height":33},{"text":"점수","x":1222,"y":1286,"width":60,"height":34},{"text":"계산에","x":1296,"y":1286,"width":85,"height":34},{"text":"불이익을","x":1396,"y":1287,"width":122,"height":34},{"text":"받","x":1531,"y":1288,"width":32,"height":33}]},{"text":"을 수 있다