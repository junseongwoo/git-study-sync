"식별해주는","x":890,"y":1223,"width":130,"height":30},{"text":"역할을","x":1031,"y":1221,"width":78,"height":30},{"text":"하는","x":1118,"y":1222,"width":55,"height":29},{"text":"필드를","x":1185,"y":1221,"width":79,"height":29}]},{"text":"기(key)라고 한다. 학생들의 레코드의 경우에는 학번이 카가 될 수 있다. 정렬이란 결국 레코드","words":[{"text":"기(key)라고","x":142,"y":1275,"width":145,"height":32},{"text":"한다.","x":299,"y":1276,"width":59,"height":30},{"text":"학생들의","x":374,"y":1276,"width":102,"height":30},{"text":"레코드의","x":490,"y":1275,"width":97,"height":31},{"text":"경우에는","x":602,"y":1276,"width":99,"height":30},{"text":"학번이","x":710,"y":1275,"width":73,"height":31},{"text":"카가","x":798,"y":1276,"width":50,"height":30},{"text":"될","x":858,"y":1275,"width":24,"height":30},{"text":"수","x":893,"y":1275,"width":27,"height":30},{"text":"있다.","x":932,"y":1274,"width":55,"height":31},{"text":"정렬이란","x":1004,"y":1272,"width":103,"height":32},{"text":"결국","x":1120,"y":1272,"width":52,"height":30},{"text":"레코드","x":1184,"y":1272,"width":80,"height":30}]},{"text":"들 을 카값의 순서로 재배열하는 것이다.","words":[{"text":"들","x":144,"y":1328,"width":19,"height":28},{"text":"을","x":172,"y":1327,"width":19,"height":29},{"text":"카값의","x":205,"y":1327,"width":78,"height":30},{"text":"순서로","x":295,"y":1328,"width":81,"height":29},{"text":"재배열하는","x":386,"y":1327,"width":130,"height":30},{"text":"것이다.","x":526,"y":1328,"width":80,"height":30}]},{"text":"학생들의 레코드","words":[{"text":"학생들의","x":182,"y":1430,"width":84,"height":22},{"text":"레코드","x":276,"y":1431,"width":62,"height":21}]},{"text":"레코드","words":[{"text":"레코드","x":144,"y":1642,"width":62,"height":22}]},{"text":"이름","words":[{"text":"이름","x":300,"y":1580,"width":41,"height":23}]},{"text":"필드","words":[{"text":"필드","x":301,"y":1644,"width":41,"height":22}]},{"text":"연락처","words":[{"text":"연락처","x":648,"y":1580,"width":56,"height":22}]},{"text":"필드","words":[{"text":"필드","x":658,"y":1643,"width":37,"height":22}]},{"text":"필드","words":[{"text":"필드","x":424,"y":1643,"width":39,"height":