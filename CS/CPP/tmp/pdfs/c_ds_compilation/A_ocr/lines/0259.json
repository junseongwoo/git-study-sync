{"page":259,"width":1689,"height":2352,"text_angle":0,"lines":[{"text":"8.4 이진 트리의 순회","words":[{"text":"8.4","x":152,"y":185,"width":57,"height":47},{"text":"이진","x":224,"y":182,"width":85,"height":51},{"text":"트리의","x":323,"y":184,"width":127,"height":50},{"text":"순회","x":465,"y":184,"width":83,"height":51}]},{"text":"기본적으로 이진 트리도 데이터를 저장하기 위한 자료 구조이다. 데이터는 노드의 데이터 필드","words":[{"text":"기본적으로","x":153,"y":322,"width":138,"height":32},{"text":"이진","x":304,"y":322,"width":52,"height":32},{"text":"트리도","x":369,"y":323,"width":81,"height":31},{"text":"데이터를","x":464,"y":323,"width":105,"height":32},{"text":"저장하기","x":582,"y":323,"width":101,"height":32},{"text":"위한","x":699,"y":325,"width":52,"height":31},{"text":"자료","x":762,"y":326,"width":52,"height":31},{"text":"구조이다.","x":825,"y":326,"width":111,"height":31},{"text":"데이터는","x":952,"y":325,"width":104,"height":32},{"text":"노드의","x":1067,"y":325,"width":79,"height":30},{"text":"데이터","x":1161,"y":325,"width":77,"height":32},{"text":"필드","x":1255,"y":326,"width":53,"height":30}]},{"text":"를 이용하여 저장된다. 이진 트리를 순회(travervll)한다는 것은 이진트리에 속하는 모든 노드를","words":[{"text":"를","x":152,"y":378,"width":27,"height":30},{"text":"이용하여","x":191,"y":375,"width":107,"height":33},{"text":"저장된다.","x":313,"y":376,"width":114,"height":32},{"text":"이진","x":442,"y":376,"width":51,"height":32},{"text":"트리를","x":504,"y":376,"width":80,"height":32},{"text":"순회(travervll)한다는","x":594,"y":376,"width":264,"height":34},{"text":"것은","x":869,"y":378,"width":50,"height":31},{"text":"이진트리에","x":930,"y":378,"width":128,"height":32},{"text":"속하는","x":1070,"y":377,"width":82,"height":31},{"text":"모든","x":1161,"y":379,"width":55,"height":29},{"text":"노드를","x":1226,"y":380,"width":83,"height":30}]},{"text":"한 번씩 방문하여 노드가 가지고 있는 데이터를 목적에 맞게 처리하는 것을 의미한다. 우리가 트","words":[{"text":"한","x":152,"y":430,"width":28,"height":31},{"text":"번씩","x":191,"y":429,"width":51,"height":30},{"text":"방문하여","x":256,"y":429,"width":106,"height":32},{"text":"노드가","x":376,"y":429,"width":80,"height":32},{"text":"가지고","x":467,"y":429,"width":79,"height":32},{"text":"있는","x":557,"y":430,"width":53,"height":31},{"text":"데이터를","x":620,"y":430,"width":105,"height":32},{"text":"목적에","x":734,"y":431,"width":77,"height":31},{"text":"맞게","x":823,"y":431,"width":50,"height":31},{"text":"처리하는","x":886,"y":431,"width":104,"height":31},{"text":"것을","x":1001,"y":431,"width":51,"height":31},{"text":"의미한다.","x":1062,"y":430,"width":113,"height":32},{"text":"우리가","x":1189,"y":430,"width":83,"height":32},{"text":"트","x":1281,"y":434,"width":28,"height":24}]},{"text":"리를 A卜올히는 목적은 트리의 노드에 자료를 저장하고 필요에 따라서 이 자료를 처리하기 위함","words":[{"text":"리를","x":154,"y":484,"width":53,"height":30},{"text":"A卜올히는","x":218,"y":482,"width":112,"height":32},{"text":"목적은","x":341,"y":483,"width":82,"height":31},{"text":"트리의","x":434,"y":482,"width":78,"height":32},{"text":"노드에","x":525,"y":483,"width":78,"height":31},{"text":"자료를","x":617,"y":483,"width":79,"height":31},{"text":"저장하고","x":708,"y":484,"width":104,"height":31},{"text":"필요에","x":825,"y":483,"width":75,"height":31},{"text":"따라서","x":915,"y":484,"width":74,"height":31},{"text":"이","x":1005,"y":484,"width":22,"height":31},{"text":"자료를","x":1042,"y":483,"width":80,"height":31},{"text":"처리하기","x":1135,"y":483,"width":104,"height":32},{"text":"위함","x":1255,"y":484,"width":54,"height":31}]},{"text":"이다. 따라서 트리가 가지고 있는 자료를 순자적으로 순회하는 것은 이진 트리에서 중요한 연산","words":[{"text":"이다.","x":153,"y":536,"width":59,"height":32},{"text":"따라서","x":228,"y":536,"width":79,"height":32},{"text":"트리가","x":322,"y":537,"width":82,"height":31},{"text":"가지고","x":415,"y":536,"width":79,"height":31},{"text":"있는","x":507,"y":536,"width":52,"height":31},{"text":"자료를","x":569,"y":536,"width":79,"height":31},{"text":"순자적으로","x":658,"y":536,"width":133,"height":32},{"text":"순회하는","x":801,"y":536,"width":106,"height":31},{"text":"것은","x":919,"y":536,"width":51,"height":31},{"text":"이진","x":980,"y":536,"width":51,"height":32},{"text":"트리에서","x":1043,"y":536,"width":104,"height":32},{"text":"중요한","x":1161,"y":537,"width":82,"height":30},{"text":"연산","x":1256,"y":537,"width":53,"height":30}]},{"text":"이다. 지금까지 공부한 자료구조. 즉 스택이나, 큐들은 대개 데이터를 선형으로 저장하고 있었","words":[{"text":"이다.","x":153,"y":590,"width":60,"height":31},{"text":"지금까지","x":231,"y":590,"width":105,"height":31},{"text":"공부한","x":352,"y":590,"width":82,"height":31},{"text":"자료구조.","x":445,"y":589,"width":113,"height":31},{"text":"즉","x":573,"y":590,"width":27,"height":29},{"text":"스택이나,","x":612,"y":589,"width":113,"height":32},{"text":"큐들은","x":740,"y":589,"width":80,"height":31},{"text":"대개","x":833,"y":589,"width":49,"height":31},{"text":"데이터를","x":897,"y":589,"width":105,"height":31},{"text":"선형으로","x":1014,"y":589,"width":106,"height":31},{"text":"저장하고","x":1134,"y":589,"width":107,"height":31},{"text":"있었","x":1256,"y":590,"width":52,"height":31}]},{"text":"다. 따라서 자료에 순자적으로 순회하는 방법은 하나뿐이었다. 그러나 트리는 그렇지 않다. 즉","words":[{"text":"다.","x":153,"y":644,"width":32,"height":31},{"text":"따라서","x":202,"y":643,"width":79,"height":32},{"text":"자료에","x":297,"y":643,"width":80,"height":32},{"text":"순자적으로","x":392,"y":642,"width":133,"height":32},{"text":"순회하는","x":536,"y":642,"width":108,"height":30},{"text":"방법은","x":656,"y":642,"width":80,"height":31},{"text":"하나뿐이었다.","x":747,"y":642,"width":164,"height":31},{"text":"그러나","x":927,"y":641,"width":79,"height":31},{"text":"트리는","x":1017,"y":642,"width":81,"height":30},{"text":"그렇지","x":1110,"y":642,"width":79,"height":31},{"text":"않다.","x":1205,"y":642,"width":59,"height":30},{"text":"즉","x":1281,"y":644,"width":27,"height":28}]},{"text":"[그림 8-20]과 같이 여러 가지 순서로 노드가 가지고 있는 자료에 접근할 수 있다.","words":[{"text":"[그림","x":152,"y":699,"width":54,"height":29},{"text":"8-20]과","x":217,"y":697,"width":98,"height":31},{"text":"같이","x":325,"y":697,"width":50,"height":31},{"text":"여러","x":389,"y":697,"width":50,"height":31},{"text":"가지","x":452,"y":696,"width":49,"height":32},{"text":"순서로","x":513,"y":696,"width":80,"height":30},{"text":