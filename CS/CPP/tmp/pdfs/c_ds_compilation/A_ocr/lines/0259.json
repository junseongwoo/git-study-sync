y":1368,"width":65,"height":37},{"text":"트리","x":234,"y":1368,"width":66,"height":38},{"text":"순회방법","x":315,"y":1368,"width":132,"height":38}]},{"text":"이진트리를 순회하는 표준적인 방법에는 전위, 중위. 후의의 3가지 방법이 있다. 이는 루트와 왼","words":[{"text":"이진트리를","x":155,"y":1435,"width":136,"height":31},{"text":"순회하는","x":300,"y":1436,"width":109,"height":30},{"text":"표준적인","x":419,"y":1436,"width":105,"height":29},{"text":"방법에는","x":536,"y":1435,"width":104,"height":30},{"text":"전위,","x":651,"y":1434,"width":56,"height":31},{"text":"중위.","x":721,"y":1434,"width":58,"height":30},{"text":"후의의","x":792,"y":1434,"width":78,"height":30},{"text":"3가지","x":883,"y":1435,"width":65,"height":30},{"text":"방법이","x":961,"y":1434,"width":77,"height":31},{"text":"있다.","x":1052,"y":1434,"width":58,"height":30},{"text":"이는","x":1124,"y":1435,"width":54,"height":29},{"text":"루트와","x":1186,"y":1435,"width":84,"height":30},{"text":"왼","x":1279,"y":1435,"width":25,"height":30}]},{"text":"쪽 서브-트리, 오른쪽 서브트리 중에서 루트를 언제 방문하느나에 따라 구분된다. 만약 루트를 방","words":[{"text":"쪽","x":153,"y":1489,"width":28,"height":28},{"text":"서브-트리,","x":192,"y":1488,"width":114,"height":31},{"text":"오른쪽","x":320,"y":1490,"width":81,"height":27},{"text":"서브트리","x":412,"y":1488,"width":102,"height":30},{"text":"중에서","x":526,"y":1487,"width":77,"height":30},{"text":"루트를","x":616,"y":1488,"width":78,"height":29},{"text":"언제","x":705,"y":1486,"width":48,"height":30},{"text":"방문하느나에","x":765,"y":1486,"width":157,"height":32},{"text":"따라","x":934,"y":1487,"width":55,"height":31},{"text":"구분된다.","x":996,"y":1487,"width":114,"height":30},{"text":"만약","x":1124,"y":1487,"width":54,"height":31},{"text":"루트를","x":1187,"y":1489,"width":82,"height":30},{"text":"방","x":1279,"y":1488,"width":28,"height":31}]},{"text":"문하는 작업을 v라고 하고 왼쪽서브-트리방는을 L, 오른쪽 서브트리 방문을 R이라고 하면 다음","words":[{"text":"문하는","x":153,"y":1539,"width":83,"height":30},{"text":"작업을","x":247,"y":1539,"width":82,"height":30},{"text":"v라고","x":339,"y":1540,"width":74,"height":30},{"text":"하고","x":425,"y":1539,"width":53,"height":31},{"text":"왼쪽서브-트리방는을","x":490,"y":1538,"width":236,"height":31},{"text":"L,","x":737,"y":1541,"width":23,"height":28},{"text":"오른쪽","x":774,"y":1539,"width":81,"height":31},{"text":"서브트리","x":866,"y":1540,"width":103,"height":31},{"text":"방문을","x":984,"y":1540,"width":79,"height":31},{"text":"R이라고","x":1074,"y":1540,"width":100,"height":31},{"text":"하면","x":1186,"y":1541,"width":52,"height":30},{"text":"다음","x":1252,"y":1541,"width":54,"height":30}]},{"text":"과 같이 3가지 년장법을 생각할 수 있다. 즉 루트를 서브 트리에 앞서서 먼저 방문하면 전위순회,","words":[{"text":"과","x":153,"y":1591,"width":28,"height":30},{"text":"같이","x":193,"y":1591,"width":50,"height":30},{"text":"3가지","x":258,"y":1591,"width":66,"height":30},{"text":"년장법을","x":340,"y":1591,"width":81,"height":30},{"text":"생각할","x":432,"y":1591,"width":80,"height":31},{"text":"수","x":521,"y":1591,"width":28,"height":30},{"text":"있다.","x":562,"y":1591,"width":56,"height":30},{"text":"즉","x":633,"y":1592,"width":27,"height":29},{"text":"루트를","x":669,"y":1591,"width":80,"height":30},{"text":"서브","x":760,"y":1590,"width":52,"height":31},{"text":"트리에","x":822,"y":1592,"width":78,"height":31},{"text":"앞서서","x":914,"y":1592,"width":76,"height":31},{"text":"먼저","x":1005,"y":1592,"width":49,"height":31},{"text":"방문하면","x":1068,"y":1592,"width":106,"height":31},{"text":"전위순회,","x":1188,"y":1593,"width":113,"height":31}]},{"text":"루트를 왼쪽과 오른쪽 서쁘트리 중간에 방문하면 중위순회, 루트를 서브 트리 방문 후에 방문하","words":[{"text":"루트를","x":153,"y":1644,"width":83,"height":29},{"text":"왼쪽과","x":246,"y":1643,"width":83,"height":29},{"text":"오른쪽","x":338,"y":1645,"width":82,"height":28},{"text":"서쁘트리","x":432,"y":1643,"width":102,"height":31},{"text":"중간에","x":547,"y":1643,"width":77,"height":30},{"text":"방문하면","x":638,"y":1642,"width":102,"height":31},{"text":"중위순회,","x":751,"y":1643,"width":112,"height":33},{"text":"루트를","x":877,"y":1646,"width":80,"height":29},{"text":"서브","x":968,"y":1645,"width":53,"height":30},{"text":"트리","x":1030,"y":1644,"width"