, 주소, 주민등록번호 등의 필드들을 포함할 수 있다. 일반","words":[{"text":"다.","x":383,"y":1445,"width":34,"height":31},{"text":"예를","x":434,"y":1446,"width":54,"height":30},{"text":"들면","x":499,"y":1446,"width":54,"height":30},{"text":"학생의","x":566,"y":1446,"width":79,"height":31},{"text":"레코드는","x":660,"y":1446,"width":108,"height":32},{"text":"이름,","x":781,"y":1446,"width":59,"height":31},{"text":"주소,","x":855,"y":1447,"width":61,"height":31},{"text":"주민등록번호","x":932,"y":1446,"width":169,"height":32},{"text":"등의","x":1112,"y":1447,"width":55,"height":32},{"text":"필드들을","x":1183,"y":1447,"width":117,"height":31},{"text":"포함할","x":1311,"y":1446,"width":90,"height":32},{"text":"수","x":1412,"y":1446,"width":31,"height":31},{"text":"있다.","x":1457,"y":1446,"width":64,"height":31},{"text":"일반","x":1540,"y":1447,"width":57,"height":31}]},{"text":"적으로 레코드들의 집합을 테이블(table)이라고 한다. 레코드들은 보통 기(key)라고 불리는 하","words":[{"text":"적으로","x":384,"y":1498,"width":82,"height":30},{"text":"레코드들의","x":481,"y":1499,"width":132,"height":32},{"text":"집합을","x":630,"y":1499,"width":80,"height":31},{"text":"테이블(table)이라고","x":724,"y":1498,"width":247,"height":33},{"text":"한다.","x":984,"y":1500,"width":62,"height":31},{"text":"레코드들은","x":1065,"y":1501,"width":142,"height":31},{"text":"보통","x":1219,"y":1502,"width":60,"height":30},{"text":"기(key)라고","x":1293,"y":1499,"width":158,"height":33},{"text":"불리는","x":1464,"y":1499,"width":91,"height":32},{"text":"하","x":1568,"y":1501,"width":29,"height":31}]},{"text":"나의 필드에 의해 식별할 수 있다. 일반적인 경우 어떤 기는 다른 기와 중복되지 않는 고유한 값","words":[{"text":"나의","x":383,"y":1551,"width":53,"height":31},{"text":"필드에","x":451,"y":1551,"width":79,"height":32},{"text":"의해","x":543,"y":1552,"width":52,"height":32},{"text":"식별할","x":608,"y":1553,"width":81,"height":31},{"text":"수","x":698,"y":1553,"width":28,"height":31},{"text":"있다.","x":738,"y":1552,"width":58,"height":31},{"text":"일반적인","x":812,"y":1552,"width":107,"height":32},{"text":"경우","x":932,"y":1554,"width":55,"height":31},{"text":"어떤","x