2052,"width":55,"height":31},{"text":"수학적으로는","x":954,"y":2050,"width":161,"height":32},{"text":"G","x":1123,"y":2051,"width":21,"height":26},{"text":"=","x":1155,"y":2059,"width":17,"height":10},{"text":"(V.","x":1183,"y":2048,"width":35,"height":32},{"text":"E)와","x":1231,"y":2048,"width":59,"height":32}]},{"text":"같이 표시한다. 여기서, V(G)는 그래프 G의 정점들의 집합을, E(G)는 그래프 G의 간선들의 집합","words":[{"text":"같이","x":158,"y":2111,"width":49,"height":31},{"text":"표시한다.","x":219,"y":2111,"width":114,"height":32},{"text":"여기서,","x":348,"y":2109,"width":84,"height":32},{"text":"V(G)는","x":444,"y":2107,"width":84,"height":32},{"text":"그래프","x":536,"y":2107,"width":77,"height":30},{"text":"G의","x":621,"y":2105,"width":43,"height":31},{"text":"정점들의","x":677,"y":2104,"width":97,"height":31},{"text":"집합을,","x":786,"y":2105,"width":80,"height":31},{"text":"E(G)는","x":878,"y":2104,"width":82,"height":31},{"text":"그래프","x":968,"y":2103,"width":80,"height":30},{"text":"G의","x":1056,"y":2102,"width":45,"height":31},{"text":"간선들의","x":1114,"y":2101,"width":106,"height":31},{"text":"집합","x":1234,"y":2102,"width":54,"height":30}]},{"text":"CHAPTERIO 그래픠 363","words":[{"text":"CHAPTERIO","x":1287,"y":2224,"width":86,"height":19},{"text":"그래픠","x":1389,"y":2222,"width":73,"height":23},{"text":"363","x":1488,"y":2220,"width":54,"height":27}]}]}