{"page":442,"width":1621,"height":2305,"text_angle":0,"lines":[{"text":"[그림 12-11] 삽입 정릴의 예","words":[{"text":"[그림","x":142,"y":602,"width":52,"height":28},{"text":"12-11]","x":205,"y":602,"width":66,"height":28},{"text":"삽입","x":287,"y":605,"width":42,"height":23},{"text":"정릴의","x":339,"y":606,"width":62,"height":23},{"text":"예","x":410,"y":606,"width":20,"height":23}]},{"text":"삽입 정렬은 정렬되어 있는 리스트에 새로운 레코드를 적절한 위치에 삼입하는 과정을 반복한","words":[{"text":"삽입","x":171,"y":695,"width":51,"height":31},{"text":"정렬은","x":236,"y":694,"width":81,"height":31},{"text":"정렬되어","x":328,"y":694,"width":102,"height":30},{"text":"있는","x":445,"y":695,"width":51,"height":30},{"text":"리스트에","x":508,"y":695,"width":98,"height":30},{"text":"새로운","x":618,"y":695,"width":76,"height":30},{"text":"레코드를","x":705,"y":695,"width":102,"height":30},{"text":"적절한","x":816,"y":694,"width":76,"height":30},{"text":"위치에","x":901,"y":694,"width":74,"height":29},{"text":"삼입하는","x":987,"y":692,"width":103,"height":31},{"text":"과정을","x":1098,"y":692,"width":80,"height":30},{"text":"반복한","x":1188,"y":691,"width":78,"height":30}]},{"text":"다. 선택 정릴과 마찬가지로 입력 배열을 선택 정렬과 유사하게 입력배열을 정렬된 부분과 정렬","words":[{"text":"다.","x":142,"y":749,"width":30,"height":30},{"text":"선택","x":189,"y":747,"width":49,"height":30},{"text":"정릴과","x":253,"y":745,"width":81,"height":31},{"text":"마찬가지로","x":344,"y":745,"width":133,"height":31},{"text":"입력","x":489,"y":746,"width":48,"height":30},{"text":"배열을","x":551,"y":746,"width":76,"height":30},{"text":"선택","x":638,"y":745,"width":48,"height":30},{"text":"정렬과","x":700,"y":746,"width":76,"height":30},{"text":"유사하게","x":785,"y":745,"width":100,"height":31},{"text":"입력배열을","x":899,"y":744,"width":127,"height":31},{"text":"정렬된","x":1037,"y":744,"width":75,"height":30},{"text":"부분과","x":1124,"y":743,"width":79,"height":30},{"text":"정렬","x":1215,"y":742,"width":49,"height":31}]},{"text":"되지 않은 부골으로 나누어서 사용하면 된다.","words":[{"text":"되지","x":142,"y":800,"width":48,"height":31},{"text":"않은","x":203,"