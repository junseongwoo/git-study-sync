37,"y":1239,"width":80,"height":29},{"text":"후","x":227,"y":1239,"width":27,"height":30},{"text":"해당","x":264,"y":1238,"width":55,"height":30},{"text":"위치에","x":329,"y":1238,"width":78,"height":31},{"text":"이","x":420,"y":1239,"width":23,"height":29},{"text":"숫자를","x":456,"y":1239,"width":79,"height":30},{"text":"삼입하게","x":545,"y":1238,"width":101,"height":30},{"text":"되면,","x":659,"y":1238,"width":56,"height":31},{"text":"정렬된","x":729,"y":1238,"width":74,"height":30},{"text":"부분의","x":813,"y":1237,"width":74,"height":31},{"text":"크기는","x":899,"y":1236,"width":79,"height":30},{"text":"하나","x":987,"y":1236,"width":53,"height":30},{"text":"커지게","x":1051,"y":1235,"width":75,"height":30},{"text":"되고,","x":1139,"y":1234,"width":58,"height":30},{"text":"정렬","x":1211,"y":1232,"width":51,"height":31}]},{"text":"이 되지 않은 부분의 크기는 하나 줄어들게 된다. 이러한 삽입 연산을 정렬되지 않은 부분이 빌","words":[{"text":"이","x":138,"y":1291,"width":22,"height":29},{"text":"되지","x":174,"y":1290,"width":49,"height":30},{"text":"않은","x":239,"y":1290,"width":53,"height":30},{"text":"부분의","x":302,"y":1290,"width":79,"height":30},{"text":"크기는","x":395,"y":1290,"width":81,"height":30},{"text":"하나","x":485,"y":1290,"width":54,"height":30},{"text":"줄어들게","x":549,"y":1290,"width":101,"height":30},{"text":"된다.","x":663,"y":1290,"width":56,"height":29},{"text":"이러한","x":734,"y":1288,"width":76,"height":31},{"text":"삽입","x":819,"y":1288,"width":48,"height":30},{"text":"연산을","x":882,"y":1287,"width":76,"height":29},{"text":"정렬되지","x":968,"y":1286,"width":100,"height":31},{"text":"않은","x":1083,"y":1286,"width":53,"height":30},{"text":"부분이","x":1145,"y":1285,"width":78,"height":30},{"text":"빌","x":1238,"y":1284,"width":23,"height":30}]},{"text":"때까지 반복하게 되면 전체 리스트가 정렬된다. 전체 리스트 (5.3,8,1,2,7)를 삽입 정렬하는 과정","words":[{"text":"때까지","x":136,"y":1342,"width":76,"height":30},{"text":"반복하게","x":225,"y":1341,"width":106,"height":30},{"text":"되면","x":345,"y":1342,"width":51,"height":29},{"text":"전체","x":408,"y":1342,"width":49,"height":30}