idth":47,"height":31}]},{"text":"에 새로운 데이터를 삽입하기나 삭제하기 위해서는 기존의 데이터들을 이동하여야 한다.","words":[{"text":"에","x":393,"y":451,"width":26,"height":30},{"text":"새로운","x":431,"y":452,"width":81,"height":30},{"text":"데이터를","x":521,"y":451,"width":105,"height":31},{"text":"삽입하기나","x":636,"y":450,"width":131,"height":33},{"text":"삭제하기","x":776,"y":451,"width":102,"height":32},{"text":"위해서는","x":891,"y":451,"width":106,"height":32},{"text":"기존의","x":1008,"y":451,"width":77,"height":31},{"text":"데이터들을","x":1098,"y":451,"width":140,"height":31},{"text":"이동하여야","x":1249,"y":451,"width":144,"height":31},{"text":"한다.","x":1403,"y":452,"width":62,"height":31}]},{"text":"연결 리스트는 그기가 제한되지 않고. 중7`뻬서 쉽게 삽입하거나 삭제할 수 있는 유연한 리스","words":[{"text":"연결","x":425,"y":504,"width":52,"height":31},{"text":"리스트는","x":491,"y":504,"width":104,"height":31},{"text":"그기가","x":606,"y":503,"width":78,"height":32},{"text":"제한되지","x":695,"y":504,"width":102,"height":31},{"text":"않고.","x":810,"y":504,"width":58,"height":31},{"text":"중7`뻬서","x":881,"y":504,"width":104,"height":32},{"text":"쉽게","x":1000,"y":504,"width":51,"height":31},{"text":"삽입하거나","x":1063,"y":504,"width":139,"height":31},{"text":"삭제할","x":1212,"y":504,"width":88,"height":30},{"text":"수","x":1310,"y":504,"width":29,"height":30},{"text":"있는","x":1352,"y":504,"width":56,"height":31},{"text":"유연한","x":1419,"y":505,"width":83,"height":31},{"text":"리스","x":1513,"y":506,"width":45,"height":30}]},{"text":"트를 구현할 수 있다. 하지만 연결 리스트도 단점이 있는데. 구현이 복잡하고, 임의의 항목(1번째","words":[{"text":"트를","x":393,"y":557,"width":55,"height":30},{"text":"구현할","x":458,"y":557,"width":81,"height":30},{"text":"수","x":548,"y":556,"width":27,"height":31},{"text":"있다.","x":585,"y":556,"width":57,"height":31},{"text":"하지만","x":656,"y":556,"width":79,"height":32},{"text":"연결","x":745,"y":557,"width":50,"height":31},{"text":"리스트도","x":808,"y":557,"width":104,"height":31},{"text":"단점이","x":922,"y":557,"width":77,"height":30},{"text":"있는데.","x":1013,"y":556,"width":86,"height":32},{"tex