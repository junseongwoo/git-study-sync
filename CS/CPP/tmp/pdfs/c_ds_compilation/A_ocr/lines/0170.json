:79,"height":32},{"text":"공간이","x":1485,"y":1410,"width":72,"height":32}]},{"text":"할당되므로, 이것을 리스트의 순자적 표현(sequentlal representation)라고도 한다.","words":[{"text":"할당되므로,","x":398,"y":1459,"width":145,"height":31},{"text":"이것을","x":556,"y":1458,"width":81,"height":31},{"text":"리스트의","x":648,"y":1458,"width":101,"height":32},{"text":"순자적","x":760,"y":1457,"width":76,"height":31},{"text":"표현(sequentlal","x":848,"y":1457,"width":189,"height":33},{"text":"representation)라고도","x":1046,"y":1458,"width":288,"height":32},{"text":"한다.","x":1344,"y":1461,"width":63,"height":32}]},{"text":"[이 [1] [2] [3] [4] [5]","words":[{"text":"[이","x":411,"y":1646,"width":29,"height":22},{"text":"[1]","x":469,"y":1647,"width":29,"height":22},{"text":"[2]","x":526,"y":1648,"width":29,"height":21},{"text":"[3]","x":583,"y":1648,"width":28,"height":22},{"text":"[4]","x":638,"y":1648,"width":28,"height":21},{"text":"[5]","x":693,"y":1647,"width":27,"height":22}]},{"text":"배열을 사용하면 리스트의 항목을 아주 자연스럽게 저장할 수 있다. 좀 더 자세한 내용은 다음","words":[{"text":"배열을","x":438,"y":1753,"width":84,"height":32},{"text":"사용하면","x":531,"y":1754,"width":108,"height":32},{"text":"리스트의","x":651,"y":1755,"width":100,"height":31},{"text":"항목을","x":762,"y":1754,"width":78,"height":31},{"text":"아주","x":849,"y":1754,"width":52,"height":32},{"text":"자연스럽게","x":910,"y":1754,"width":129,"height":33},{"text":"저장할","x":1052,"y":1755,"width":79,"height":32},{"text":"수","x":1140,"y":1755,"width":27,"height":32},{"text":"있다.","x":1178,"y":1755,"width":59,"height":31},{"text":"좀","x":1251,"y":1756,"width":29,"height":30},{"text":"더","x":1291,"y":1756,"width":24,"height":32},{"text":"자세한","x":1329,"y":1756,"width":86,"height":32},{"text":"내용은","x":1425,"y":1756,"width":80,"height":30},{"text":"다음","x":1514,"y":1756,"width":47,"height":30}]},{"text":"의 가상 실습 소프트웨어를 이용해서 살펴보자.","words":[{"text":"의","x":408,"y":1806,"width":24,"height":32},{"text":"가상","x":445,"y":1807,"width":57,"height":32},{"text":"실습","x":510,"y":1808,"width":56,"height":31