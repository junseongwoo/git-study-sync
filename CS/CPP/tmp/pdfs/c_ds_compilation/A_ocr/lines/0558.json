","x":302,"y":994,"width":178,"height":31},{"text":"달리","x":491,"y":994,"width":56,"height":32},{"text":"해싱은","x":562,"y":995,"width":90,"height":31},{"text":"삽입이","x":661,"y":996,"width":86,"height":31},{"text":"쉽다.","x":762,"y":996,"width":65,"height":32},{"text":"해성을","x":842,"y":996,"width":89,"height":31},{"text":"이진","x":943,"y":996,"width":57,"height":31},{"text":"탐색","x":1011,"y":997,"width":57,"height":31},{"text":"트리와","x":1081,"y":997,"width":91,"height":31},{"text":"비교하여","x":1182,"y":997,"width":113,"height":32},{"text":"보면","x":1309,"y":995,"width":59,"height":31},{"text":"이진","x":1382,"y":994,"width":57,"height":32},{"text":"탐","x":1451,"y":994,"width":30,"height":31}]},{"text":"색 트리는 현재값보다 다음으로 큰값이나 다음으로 작은 값을 쉽게 찾을 수 있는 장점이 있다.","words":[{"text":"색","x":198,"y":1047,"width":28,"height":31},{"text":"트리는","x":242,"y":1048,"width":92,"height":30},{"text":"현재값보다","x":347,"y":1047,"width":149,"height":32},{"text":"다음으로","x":509,"y":1048,"width":120,"height":31},{"text":"큰값이나","x":641,"y":1049,"width":121,"height":31},{"text":"다음으로","x":774,"y":1049,"width":119,"height":30},{"text":"작은","x":905,"y":1049,"width":61,"height":30},{"text":"값을","x":978,"y":1049,"width":60,"height":31},{"text":"쉽게","x":1051,"y":1049,"width":56,"height":32},{"text":"찾을","x":1122,"y":1051,"width":60,"height":30},{"text":"수","x":1193,"y":1051,"width":30,"height":30},{"text":"있는","x":1237,"y":1050,"width":58,"height":31},{"text":"장점이","x":1307,"y":1049,"width":86,"height":32},{"text":"있다.","x":1412,"y":1048,"width":63,"height":31}]},{"text":"또한 이진 탐색 트리에서는 값의 크기순으로 순회하는 것이 쉽다. 이에 반하여 해싱은 그야말로","words":[{"text":"또한","x":198,"y":1101,"width":62,"height":29},{"text":"이진","x":272,"y":1101,"width":59,"height":31},{"text":"탐색","x":344,"y":1100,"width":56,"height":31},{"text":"트리에서는","x":415,"y":1101,"width":151,"height":31},{"text":"값의","x":577,"y":1101,"width":56,"height":31},{"text":"크기순으로","x":648,"y":1102,"width":149,"height":30},{"text":"순회하는","x":808,"y":1102,"width":120,"height":3