{"page":249,"width":1657,"height":2315,"text_angle":0,"lines":[{"text":"트리의 종류","words":[{"text":"트리의","x":129,"y":175,"width":101,"height":39},{"text":"종류","x":245,"y":177,"width":71,"height":38}]},{"text":"트리를 컴퓨터 메모리상에서 표현하는 방법은 여러 가지가 있을 수 있다. 트리를 프로그램 안에","words":[{"text":"트리를","x":129,"y":246,"width":82,"height":31},{"text":"컴퓨터","x":224,"y":245,"width":80,"height":33},{"text":"메모리상에서","x":320,"y":247,"width":161,"height":32},{"text":"표현하는","x":495,"y":247,"width":107,"height":32},{"text":"방법은","x":613,"y":248,"width":78,"height":31},{"text":"여러","x":702,"y":248,"width":48,"height":32},{"text":"가지가","x":764,"y":248,"width":77,"height":32},{"text":"있을","x":852,"y":248,"width":50,"height":31},{"text":"수","x":912,"y":248,"width":26,"height":31},{"text":"있다.","x":950,"y":248,"width":56,"height":31},{"text":"트리를","x":1021,"y":247,"width":80,"height":31},{"text":"프로그램","x":1111,"y":246,"width":106,"height":31},{"text":"안에","x":1230,"y":246,"width":53,"height":32}]},{"text":"서 표현하는 가장 일반적인 방법은 [그림 8제 (a)와 같이. 각 노드가 데이터를 저장하는 데이터","words":[{"text":"서","x":130,"y":299,"width":22,"height":31},{"text":"표현하는","x":167,"y":298,"width":113,"height":32},{"text":"가장","x":293,"y":300,"width":56,"height":31},{"text":"일반적인","x":362,"y":299,"width":107,"height":32},{"text":"방법은","x":483,"y":300,"width":80,"height":31},{"text":"[그림","x":574,"y":301,"width":53,"height":30},{"text":"8제","x":639,"y":302,"width":50,"height":29},{"text":"(a)와","x":702,"y":301,"width":58,"height":32},{"text":"같이.","x":771,"y":301,"width":56,"height":32},{"text":"각","x":842,"y":301,"width":26,"height":31},{"text":"노드가","x":878,"y":300,"width":78,"height":32},{"text":"데이터를","x":968,"y":300,"width":104,"height":32},{"text":"저장하는","x":1085,"y":299,"width":107,"height":32},{"text":"데이터","x":1205,"y":298,"width":77,"height":33}]},{"text":"필드와 자식 노드를 가리기는 링크 필드를 가지게 하는 것이다. [그림 ㈜61 (a)에서 n은 자식 노드","words":[{"text":"필드와","x":131,"y":352,"width":81,"height":31},{"text":"자식","x":221,"y":352,"width":54,"height":31},{"text":"노드를","x":288,"y":354,"width":85,"height":30},{"text":"가리기는","x":382,"y":353,"width":110,"height":31},{"text":"링크","x":503,"y":353,"width":51,"height":31},{"text":"필드를","x":565,"y":354,"width":78,"height":31},{"text":"가지게","x":653,"y":354,"width":74,"height":31},{"text":"하는","x":739,"y":354,"width":52,"height":32},{"text":"것이다.","x":801,"y":354,"width":82,"height":32},{"text":"[그림","x":895,"y":353,"width":52,"height":31},{"text":"㈜61","x":957,"y":354,"width":51,"height":30},{"text":"(a)에서","x":1020,"y":353,"width":82,"height":32},{"text":"n은","x":1116,"y":352,"width":43,"height":32},{"text":"자식","x":1169,"y":352,"width":50,"height":32},{"text":"노드","x":1232,"y":355,"width":55,"height":24}]},{"text":"의 개수. 즉 노드의 치수이다. 일반적인 트리에서 각 노드들은 서로 다른 개수의 자식 노드를 가","words":[{"text":"의","x":131,"y":405,"width":23,"height":31},{"text":"개수.","x":168,"y":405,"width":61,"height":32},{"text":"즉","x":243,"y":407,"width":29,"height":29},{"text":"노드의","x":283,"y":407,"width":82,"height":31},{"text":"치수이다.","x":378,"y":406,"width":115,"height":32},{"text":"일반적인","x":510,"y":407,"width":104,"height":31},{"text":"트리에서","x":625,"y":407,"width":101,"height":32},{"text":"각","x":740,"y":408,"width":26,"height":31},{"text":"노드들은","x":776,"y":407,"width":103,"height":32},{"text":"서로","x":890,"y":407,"width":51,"height":31},{"text":"다른","x":952,"y":407,"width":51,"height":31},{"text":"개수의","x":1015,"y":407,"width":76,"height":33},{"text":"자식","x":1104,"y":406,"width":51,"height":32},{"text":"노드를","x":1169,"y":406,"width":81,"height":31},{"text":"가","x":1261,"y":405,"width":27,"height":32}]},{"text":"지므로 노드에 따라서 링크 필드의 개수가 달라진다.","words":[{"text":"지므로","x":132,"y":459,"width":80,"height":31},{"text":"노드에","x":222,"y":459,"width":82,"height":32},{"text":"따라서","x":317,"y":460,"width":80,"height":32},{"text":"링크","x":412,"y":459,"width":52,"height":32},{"text":"필드의","x":475,"y":459,"width":77,"height":33},{"text":"개수가","x":566,"y":460,"width":79,"height":33},{"text":"달라진다.","x":653,"y":461,"