:1009,"width":54,"height":23}]},{"text":"의 개수에 따라서 노드의 크기가 커지기도 하고 작아지기도 한다. 이와 같이 노드의 그기가 일정","words":[{"text":"의","x":137,"y":1061,"width":22,"height":30},{"text":"개수에","x":173,"y":1059,"width":78,"height":31},{"text":"따라서","x":264,"y":1058,"width":80,"height":31},{"text":"노드의","x":357,"y":1058,"width":81,"height":31},{"text":"크기가","x":451,"y":1057,"width":82,"height":31},{"text":"커지기도","x":542,"y":1058,"width":106,"height":30},{"text":"하고","x":657,"y":1058,"width":53,"height":30},{"text":"작아지기도","x":719,"y":1058,"width":130,"height":30},{"text":"한다.","x":858,"y":1058,"width":58,"height":30},{"text":"이와","x":931,"y":1058,"width":54,"height":30},{"text":"같이","x":994,"y":1058,"width":50,"height":30},{"text":"노드의","x":1056,"y":1058,"width":79,"height":30},{"text":"그기가","x":1147,"y":1058,"width":83,"height":31},{"text":"일정","x":1241,"y":1058,"width":49,"height":31}]},{"text":"하지 않으면 프로그램이 복잡하게 된다. 따라서 이 책에서는 [그림 8-6] (b)와 같이 자식 노드의","words":[{"text":"하지","x":137,"y":1112,"width":49,"height":31},{"text":"않으면","x":201,"y":1111,"width":82,"height":31},{"text":"프로그램이","x":295,"y":1111,"width":136,"height":30},{"text":"복잡하게","x":445,"y":1110,"width":106,"height":31},{"text":"된다.","x":565,"y":1110,"width":58,"height":31},{"text":"따라서","x":638,"y":1110,"width":76,"height":31},{"text":"이","x":729,"y":1110,"width":22,"height":31},{"text":"책에서는","x":765,"y":1110,"width":104,"height":30},{"text":"[그림","x":879,"y":1110,"width":53,"height":29},{"text":"8-6]","x":944,"y":1111,"width":52,"height":28},{"text":"(b)와","x":1009,"y":1109,"width":61,"height":32},{"text":"같이","x":1080,"y":1110,"width":51,"height":30},{"text":"자식","x":1145,"y":1110,"width":53,"height":30},{"text":"노드의","x":1211,"y":1110,"width":80,"height":31}]},{"text":"개수가 2개인 이진트리만을 다루기로 한다. 사실 일반 트리도 이진 트리로 변환할 수 있는 방법","words":[{"text":"개수가","x":138,"y":1163,"width":80,"height":31},{"text":"2개인","x":228,"y":1163,"width":71,"height":31},{"text":"이진트리만을","x":312,"y":1162,"width":164,"height":32},{"text":"다루기로","x":487,"y