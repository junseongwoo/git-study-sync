69,"y":963,"width":53,"height":32},{"text":"식으로","x":835,"y":964,"width":81,"height":32},{"text":"방문되는","x":928,"y":965,"width":110,"height":32},{"text":"것일까?","x":1051,"y":966,"width":99,"height":32},{"text":"이진","x":1164,"y":967,"width":55,"height":32},{"text":"트리에서","x":1232,"y":968,"width":115,"height":32},{"text":"각각의","x":1364,"y":968,"width":87,"height":32},{"text":"서브","x":1467,"y":969,"width":59,"height":31},{"text":"트리","x":1538,"y":969,"width":54,"height":31}]},{"text":"도 이진 트리임을 정의한 적이 있다. 따라서 서브 트리에게도 전체 이진 트리와 똑같은 방법을","words":[{"text":"도","x":376,"y":1020,"width":30,"height":22},{"text":"이진","x":419,"y":1017,"width":54,"height":31},{"text":"트리임을","x":485,"y":1017,"width":112,"height":32},{"text":"정의한","x":609,"y":1017,"width":81,"height":32},{"text":"적이","x":702,"y":1017,"width":51,"height":32},{"text":"있다.","x":770,"y":1017,"width":58,"height":32},{"text":"따라서","x":845,"y":1018,"width":78,"height":32},{"text":"서브","x":940,"y":1019,"width":54,"height":32},{"text":"트리에게도","x":1006,"y":1020,"width":140,"height":32},{"text":"전체","x":1160,"y":1021,"width":54,"height":32},{"text":"이진","x":1230,"y":1022,"width":57,"height":31},{"text":"트리와","x":1301,"y":1022,"width":92,"height":32},{"text":"똑같은","x":1404,"y":1022,"width":92,"height":32},{"text":"방법을","x":1509,"y":1023,"width":86,"height":31}]},{"text":"적용할 수 있다. 즉 전위 순회라면 서브 트리에 들어 있는 노드들도 VLR의 순서대로 순회된다.","words":[{"text":"적용할","x":379,"y":1070,"width":84,"height":32},{"text":"수","x":470,"y":1072,"width":29,"height":31},{"text":"있다.","x":510,"y":1071,"width":59,"height":32},{"text":"즉","x":582,"y":1073,"width":29,"height":29},{"text":"전위","x":620,"y":1071,"width":51,"height":31},{"text":"순회라면","x":682,"y":1071,"width":109,"height":32},{"text":"서브","x":802,"y":1072,"width":54,"height":31},{"text":"트리에","x":865,"y":1072,"width":81,"height":32},{"text":"들어","x":957,"y":1073,"width":52,"height":32},{"text":"있는","x":1024,"y":1074,"width":54,"height":31},{"text":"노드들도","x":1087,"y":1076,"width":113,"height":30},{"text":"VLR의","x":1209,"y":1075,"width":90,"height":32},{"text":"순서대로","x":1312,"y":1075,"width":121,"height":32},{"text":"순회된다.","x":1443,"y":1076,"width":125,"height":32}]},{"text":"트리 순회 알고리즘은 우리가 앞에서 공부하였던 순환 기법을 시용한다. 사실 복잡한 이진트","words":[{"text":"트리","x":409,"y":1125,"width":54,"height":32},{"text":"순회","x":477,"y":1125,"width":52,"height":32},{"text":"알고리즘은","x":544,"y":1124,"width":136,"height":32},{"text":"우리가","x":690,"y":1125,"width":83,"height":32},{"text":"앞에서","x":785,"y":1125,"width":78,"height":32},{"text":"공부하였던","x":877,"y":1127,"width":136,"height":32},{"text":"순환","x":1026,"y":1128,"width":57,"height":30},{"text":"기법을","x":1095,"y":1128,"width":84,"height":31},{"text":"시용한다.","x":1190,"y":1128,"width":125,"height":32},{"text":"사실","x":1331,"y":1129,"width":59,"height":31},{"text":"복잡한","x":1403,"y":1130,"width":93,"height":30},{"text":"이진트","x":1508,"y":1130,"width":87,"height":32}]},{"text":"리를 순회하여야 할 때 순환을 시용하지 않고서는 도저히 순회 알고리즘을 만들 수 없다. 그러면","words":[{"text":"리를","x":380,"y":1177,"width":55,"height":32},{"text":"순회하여야","x":444,"y":1178,"width":139,"height":32},{"text":"할","x":591,"y":1178,"width":28,"height":30},{"text":"때","x":630,"y":1178,"width":23,"height":32},{"text":"순환을","x":665,"y":1178,"width":83,"height":32},{"text":"시용하지","x":757,"y":1178,"width":106,"height":34},{"text":"않고서는","x":877,"y":1179,"width":110,"height":34},{"text":"도저히","x":997,"y":1181,"width":79,"height":32},{"text":"순회","x":1089,"y":1182,"width":54,"height":32},{"text":"알고리즘을","x":1157,"y":1182,"width":145,"height":31},{"text":"만들","x":1312,"y":1183,"width":60,"height":31},{"text":"수","x":1382,"y":1184,"width":32,"height":30},{"text":"없다.","x":1427,"y":1184,"width":64,"height":30},{"text":"그러면","x":1506,"y":1184,"width":86,"height":30}]},{"text":"순회 알고리수은 어떻게 순환을 이용하는 것일까? [그림 8-2기의 이진트리에서 보면 전체 트리나","words":[{"text":"순회","x":377,"y":1232,"width":55,"height":31},{"text":"알고리수은","x":445,"y":1232,"width":138,"height":31},{"text":"어떻게","x":593,"y":1232,"width":78,"height":32},{"text":"순환을","x":683,"y":1232,"width":83,"height":32},{"text":"이용하는","x":776,"y":1234,"width":109,"height":32},{"text":"것일까?","x":896,"y":1234,"width":97,"height":33},{"text":"[그림","x":1004,"y":1236,"width":54,"height":30},{"text":"8-2기의","x":1070,"y":1235,"width":94,"height":32},{"text":"이진트리에서","x":1178,"y":1235,"width":171,"height":33},{"text":"보면","x":1363,"y":1236,"width":60,"height":30},{"text":"전체","x":1437,"y":1236,"width":56,"height":31},{"text":"트리나","x":1505,"y":1236,"width":89,"height":31}]},{"text":"서브 트리나 그 구조는 완전히 동일하다. 따라서 전체 트리 순회에 사통된 알고리즘은 똑같이 서","words":[{"text":"서브","x":380,"y":1285,"width":56,"height":32},{"text":"트리나","x":445,"y":1286,"width":83,"height":32},{"text":"그","x":537,"y":1290,"width":28,"height":21},{"text":"구조는","x":574,"y":1287,"width":83,"height":30},{"text":"완전히","x":666,"y":1286,"width":79,"height":32},{"text":"동일하다.","x":758,"y":1288,"width":115,"height":32},{"text":"따라서","x":888,"y":1288,"width":79,"height":32},{"text":"전체","x":981,"y":1289,"width":52,"height":31},{"text":"트리","x":1044,"y":1289,"width":54,"height":31},{"text":"순회에","x":1110,"y":1289,"width":83,"height":31},{"text":"사통된","x":1206,"y":1289,"width":86,"height":31},{"text":"알고리즘은","x":1305,"y":1289,"width":150,"height":31},{"text":"똑같이","x":1464,"y":1289,"width":87,"height":30},{"text":"서","x":1566,"y":1290,"width":24,"height":30}]},{"text":"보 트리에 적용할 수 있는 것이다. 다만 문제의 크기가 직아진다. 따라서 순환에서 공부했듯이","words":[{"text":"보","x":379,"y":1341,"width":29,"height":24},{"text":"트리에","x":419,"y":1339,"width":82,"height":32},{"text":"적용할","x":516,"y":1339,"width":82,"height":32},{"text":"수","x":608,"y":1340,"width":29,"height":31},{"text":"있는","x":650,"y":1340,"width":54,"height":31},{"text":"것이다.","x":717,"y":1340,"width":86,"height":33},{"text":"다만","x":820,"y":1341,"width":55,"height":32},{"text":"문제의","x":885,"y":1342,"width":81,"height":31},{"text":"크기가","x":981,"y":1342,"width":84,"height":32},{"text":"직아진다.","x":1077,"y":1342,"width":118,"height":31},{"text":"따라서","x":1212,"y":1342,"width":84,"height":31},{"text":"순환에서","x":1312,"y":1341,"width":116,"height":31},{"text":"공부했듯이","x":1445,"y":1341,"width":145,"height":32}]},{"text":"문제의 구조는 같고 크기만 직아지는 경우라면 순한을 적용할 수 있다. 따라서 전체 순회에 시용","words":[{"text":"문제의","x":379,"y":1393,"width":82,"height":31},{"text":"구조는","x":474,"y":1395,"width":82,"height":30},{"text":"같고","x":566,"y":1393,"width":55,"height":31},{"text":"크기만","x":630,"y":1394,"width":83,"height":31},{"text":"직아지는","x":722,"y":1394,"width":110,"height":32},{"text":"경우라면","x":842,"y":1394,"width":108,"height":32},{"text":"순한을","x":960,"y":1395,"width":85,"height":31},{"text":"적용할","x":1055,"y":1395,"width":83,"height":31},{"text":"수","x":1147,"y":1396,"width":30,"height":30},{"text":"있다.","x":1189,"y":1395,"width":61,"height":31},{"text":"따라서","x":1265,"y":1394,"width":84,"height":32},{"text":"전체","x":1365,"y":1394,"width":56,"height":30},{"text":"순회에","x":1434,"y":1394,"width":88,"height":30},{"text":"시용","x":1535,"y":1394,"width":59,"height":31}]},{"text":"된 알고리즘을 다시 서브 트리에 적용하는 것이 가능해진다. 전위 순회부터 차례대로 살펴보자.","words":[{"text":"된","x":381,"y":1446,"width":27,"height":30},{"text":"알고리즘을","x":419,"y":1446,"width":138,"height":32},{"text":"다시","x":566,"y":1447,"width":51,"height":32},{"text":"서브","x":630,"y":1448,"width":54,"height":31},{"text":"트리에","x":693,"y":1448,"width":80,"height":32},{"text":"적용하는","x":786,"y":1448,"width":108,"height":31},{"text":"것이","x":904,"y":1448,"width":51,"height":31},{"text":"가능해진다.","x":968,"y":1448,"width":144,"height":31},{"text":"전위","x":1128,"y":1448,"width":52,"height":31},{"text":"순회부터","x":1193,"y":1448,"width":112,"height":31},{"text":"차례대로","x":1319,"y":1446,"width":118,"height":32},{"text":"살펴보자.","x":1446,"y":1446,"width":127,"height":30}]},{"text":"八八 八八","words":[{"text":"八八","x":465,"y":1874,"width":144,"height":79},{"text":"八八","x":699,"y":1876,"width":142,"height":78}]},{"text":"[그림 8-2기 전체 트리나 서브 트리나 구조는 동일하다.","words":[{"text":"[그림","x":387,"y":2005,"width":54,"height":