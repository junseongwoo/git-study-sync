ight":28}]},{"text":"1","words":[{"text":"1","x":396,"y":1353,"width":8,"height":47}]},{"text":"data","words":[{"text":"data","x":376,"y":1402,"width":52,"height":20}]},{"text":"[그림 13-5] 영어사전에서 단어를 찾는 경우 data는 move보다 앞에 있으므로 사전의 뒷부분은 탐색범위에서 제외된다.","words":[{"text":"[그림","x":159,"y":1475,"width":55,"height":28},{"text":"13-5]","x":226,"y":1474,"width":65,"height":28},{"text":"영어사전에서","x":310,"y":1476,"width":135,"height":25},{"text":"단어를","x":455,"y":1476,"width":67,"height":24},{"text":"찾는","x":532,"y":1475,"width":44,"height":24},{"text":"경우","x":586,"y":1475,"width":44,"height":25},{"text":"data는","x":644,"y":1475,"width":80,"height":24},{"text":"move보다","x":732,"y":1475,"width":103,"height":24},{"text":"앞에","x":843,"y":1475,"width":43,"height":24},{"text":"있으므로","x":896,"y":1475,"width":89,"height":23},{"text":"사전의","x":993,"y":1474,"width":65,"height":25},{"text":"뒷부분은","x":1067,"y":1473,"width":88,"height":25},{"text":"탐색범위에서","x":1163,"y":1473,"width":129,"height":24},{"text":"제외된다.","x":1301,"y":1472,"width":90,"height":24}]},{"text":"이진 탐색에서는 비교가 이루어질 때마다 담색 범위가 급격하게 줄어든다. 찾고자하는 항목이","words":[{"text":"이진","x":193,"y":1581,"width":57,"height":31},{"text":"탐색에서는","x":261,"y":1581,"width":149,"height":31},{"text":"비교가","x":420,"y":1581,"width":88,"height":31},{"text":"이루어질","x":519,"y":1580,"width":113,"height":32},{"text":"때마다","x":646,"y":1580,"width":87,"height":32},{"text":"담색","x":742,"y":1580,"width":55,"height":31},{"text":"범위가","x":812,"y":1579,"width":86,"height":32},{"text":"급격하게","x":907,"y":1579,"width":111,"height":32},{"text":"줄어든다.","x":1030,"y":1578,"width":118,"height":31},{"text":"찾고자하는","x":1162,"y":1578,"width":138,"height":31},{"text":"항목이","x":1309,"y":1578,"width":80,"height":31}]},{"text":"속해있지 않은 무콮은 전혀 고려할 필요가 없기 때문이다. 이러한 방법을 반복적으로 시용하는","words":[{"text":"속해있지","x":158,"y":1634,"width":115,"height":31},{"text":"않은","x":291,"y":1634,"width":59,"height":31},{"text":"무콮은","x":361,"y":1634,"width":89,"height":30},{"text":"전혀","x":463,"y":1634,"width":53,"height":30},{"text":"고려할","x":532,"y":1634,"width":89,"height":30},{"text":"필요가","x":634,"y":1634,"width":88,"height":30},{"text":"없기","x":735,"y":1633,"width":52,"height":31},{"text":"때문이다.","x":804,"y":1633,"width":120,"height":31},{"text":"이러한","x":942,"y":1632,"width":84,"height":32},{"text":"방법을","x":1037,"y":1632,"width":84,"height":31},{"text":"반복적으로","x":1133,"y":1631,"width":138,"height":31},{"text":"시용하는","x":1282,"y":1631,"width":110,"height":31}]},{"text":"방법이 이진 탐색이다. 이진 탐색을 적용하려면 탐색하기 전에 배열이 반드시 정렬되어 있어야","words":[{"text":"방법이","x":160,"y":1688,"width":83,"height":31},{"text":"이진","x":261,"y":1688,"width":58,"height":30},{"text":"탐색이다.","x":332,"y":1687,"width":124,"height":31},{"text":"이진","x":474,"y":1687,"width":56,"height":31},{"text":"탐색을","x":544,"y":1687,"width":88,"height":31},{"text":"적용하려면","x":645,"y":1687,"width":144,"height":31},{"text":"탐색하기","x":803,"y":1686,"width":111,"height":31},{"text":"전에","x":931,"y":1686,"width":53,"height":31},{"text":"배열이","x":999,"y":1685,"width":79,"height":32},{"text":"반드시","x":1093,"y":1684,"width":81,"height":31},{"text":"정렬되어","x":1190,"y":1684,"width":105,"height":31},{"text":"있어야","x":1312,"y":1684,"width":80,"height":31}]},{"text":"한다. 따라서 이진 탐색은 데이터의 삽입이나 삭제가 빈번할 시에는 적합하지 않고. 주로 고정된","words":[{"text":"한다.","x":160,"y":1741,"width":64,"height":31},{"text":"따라서","x":240,"y":1740,"width":85,"height":31},{"text":"이진","x":341,"y":1740,"width":56,"height":31},{"text":"탐색은","x":409,"y":1740,"width":89,"height":30},{"text":"데이터의","x":509,"y":1740,"width":113,"height":31},{"text":"삽입이나","x":635,"y":1740,"width":118,"height":31},{"text":"삭제가","x":763,"y":1740,"width":88,"height":31},{"text":"빈번할","x":862,"y":1740,"width":85,"height":30},{"text":"시에는","x":956,"y":1739,"width":84,"height":31},{"text":"적합하지","x":1051,"y":1737,"width":106,"height":32},{"text":"않고.","x":1171,"y":1737,"width":61,"height":31},{"text":"주로","x":1245,"y":1739,"width":55,"height":29},{"text":"고정된","x":1309,"y":1737,"widt