{"page":337,"width":1646,"height":2345,"text_angle":0,"lines":[{"text":"LPT 알고리즘의 구현","words":[{"text":"LPT","x":131,"y":193,"width":63,"height":33},{"text":"알고리즘의","x":206,"y":188,"width":165,"height":41},{"text":"구현","x":384,"y":188,"width":65,"height":40}]},{"text":"이기서는 기계의 종료 시간이 중요하다. 종료 시간이 최소인 기계가 항상 선대되기 때문이다. 따","words":[{"text":"이기서는","x":131,"y":260,"width":107,"height":31},{"text":"기계의","x":249,"y":258,"width":76,"height":32},{"text":"종료","x":337,"y":259,"width":53,"height":30},{"text":"시간이","x":401,"y":257,"width":75,"height":33},{"text":"중요하다.","x":489,"y":257,"width":111,"height":33},{"text":"종료","x":613,"y":259,"width":53,"height":31},{"text":"시간이","x":678,"y":258,"width":74,"height":32},{"text":"최소인","x":766,"y":259,"width":77,"height":31},{"text":"기계가","x":856,"y":258,"width":77,"height":33},{"text":"항상","x":943,"y":258,"width":55,"height":32},{"text":"선대되기","x":1009,"y":256,"width":105,"height":32},{"text":"때문이다.","x":1128,"y":255,"width":116,"height":33},{"text":"따","x":1259,"y":256,"width":27,"height":31}]},{"text":"라서 기계의 종료 시간을 최소 히프에 넣고 최소 히프에서 기계를 꺼내서 그 기계에 작업을 할당","words":[{"text":"라서","x":131,"y":312,"width":49,"height":32},{"text":"기계의","x":195,"y":312,"width":76,"height":32},{"text":"종료","x":283,"y":312,"width":53,"height":31},{"text":"시간을","x":348,"y":311,"width":78,"height":31},{"text":"최소","x":437,"y":311,"width":51,"height":31},{"text":"히프에","x":499,"y":311,"width":76,"height":32},{"text":"넣고","x":588,"y":311,"width":52,"height":32},{"text":"최소","x":651,"y":312,"width":51,"height":31},{"text":"히프에서","x":713,"y":312,"width":102,"height":32},{"text":"기계를","x":829,"y":311,"width":78,"height":33},{"text":"꺼내서","x":918,"y":311,"width":77,"height":33},{"text":"그","x":1009,"y":314,"width":26,"height":23},{"text":"기계에","x":1047,"y":309,"width":79,"height":33},{"text":"작업을","x":1139,"y":308,"width":82,"height":31},{"text":"할당","x":1231,"y":308,"width":55,"height":32}]},{"text":"하면 된다. 작업을 할당한 후에는 기계의 종료 시간을 작업 시간만큼 중가시킨 후에 다시 최소","words":[{"