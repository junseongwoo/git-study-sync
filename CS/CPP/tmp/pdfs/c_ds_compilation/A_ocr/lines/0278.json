"y":801,"width":30,"height":31},{"text":"있다.","x":1252,"y":801,"width":63,"height":31},{"text":"단","x":1330,"y":801,"width":31,"height":30},{"text":"이진","x":1372,"y":800,"width":57,"height":32},{"text":"트리를","x":1441,"y":800,"width":90,"height":31},{"text":"사용","x":1542,"y":801,"width":58,"height":32}]},{"text":"하기 때문에 하나의 디렉토리 안에 다른 디렉토리가 2개를 초과하면 안 된다. 예를 들어 다음과","words":[{"text":"하기","x":385,"y":857,"width":54,"height":32},{"text":"때문에","x":454,"y":858,"width":81,"height":32},{"text":"하나의","x":548,"y":858,"width":79,"height":31},{"text":"디렉토리","x":642,"y":857,"width":104,"height":31},{"text":"안에","x":760,"y":857,"width":51,"height":31},{"text":"다른","x":825,"y":856,"width":53,"height":31},{"text":"디렉토리가","x":890,"y":855,"width":136,"height":32},{"text":"2개를","x":1037,"y":855,"width":70,"height":31},{"text":"초과하면","x":1118,"y":853,"width":114,"height":32},{"text":"안","x":1245,"y":854,"width":30,"height":30},{"text":"된다.","x":1286,"y":853,"width":65,"height":32},{"text":"예를","x":1368,"y":853,"width":60,"height":31},{"text":"들어","x":1439,"y":853,"width":57,"height":32},{"text":"다음과","x":1512,"y":853,"width":88,"height":33}]},{"text":"같은 디렉토리 구조에서 루트 디렉토리인 “나의 문서”의 용량을 알려면 어떻게 하여야 할까?","words":[{"text":"같은","x":385,"y":910,"width":58,"height":32},{"text":"디렉토리","x":452,"y":912,"width":107,"height":31},{"text":"구조에서","x":571,"y":911,"width":106,"height":32},{"text":"루트","x":689,"y":912,"width":55,"height":30},{"text":"디렉토리인","x":754,"y":909,"width":132,"height":32},{"text":"“나의","x":897,"y":909,"width":63,"height":31},{"text":"문서”의","x":972,"y":908,"width":91,"height":31},{"text":"용량을","x":1075,"y":907,"width":84,"height":31},{"text":"알려면","x":1169,"y":906,"width":85,"height":31},{"text":"어떻게","x":1267,"y":906,"width":86,"height":32},{"text":"하여야","x":1366,"y":906,"width":90,"height":32},{"text":"할까?","x":1466,"y":906,"width":77,"height":32}]},{"text":"나의 문서","words":[{"text":"나의","x":581,"y":1096,"width":40,"height":24},{"text":"문서","x":629,"y":1096,"width":41,"height":23}]},{"text":"50KB","words":[{"text":"50KB","x":497,"y":1201,"width":53,"height":19}]},{"text":"음악","words":[{"text":"음악","x":408,"y":1276,"width":45,"height":24}]},{"text":"200KB","words":[{"text":"200KB","x":633,"y":1381,"width":62,"height":18}]},{"text":"정지영상","words":[{"text":"정지영상","x":706,"y":1456,"width":84,"height":24}]},{"text":"[그림 8-34] 디렉토리의 용량 계산 문제","words":[{"text":"[그림","x":389,"y":1521,"width":56,"height":30},{"text":"8-34]","x":455,"y":1525,"width":66,"height":29},{"text":"디렉토리의","x":539,"y":1528,"width":105,"height":24},{"text":"용량","x":652,"y":1527,"width":43,"height":25},{"text":"계산","x":704,"y":1527,"width":42,"height":24},{"text":"문제","x":753,"y":1527,"width":42,"height":24}]},{"text":"100KB","words":[{"text":"100KB","x":883,"y":1195,"width":63,"height":18}]},{"text":"그림","words":[{"text":"그림","x":797,"y":1274,"width":40,"height":23}]},{"text":"500KB","words":[{"text":"500KB","x":965,"y":1378,"width":63,"height":19}]},{"text":"동영상","words":[{"text":"동영상","x":867,"y":1457,"width":64,"height":23}]},{"text":"하나의 디렉토리 인에 다른 디렉토리가 있을 수 있으므로 먼저 서브 디렉토리의 용량을 모두","words":[{"text":"하나의","x":422,"y":1631,"width":82,"height":32},{"text":"디렉토리","x":519,"y":1632,"width":104,"height":32},{"text":"인에","x":638,"y":1632,"width":50,"height":31},{"text":"다른","x":702,"y":1632,"width":55,"height":30},{"text":"디렉토리가","x":768,"y":1631,"width":135,"height":32},{"text":"있을","x":916,"y":1631,"width":53,"height":31},{"text":"수","x":979,"y":1632,"width":29,"height":31},{"text":"있으므로","x":1021,"y":1632,"width":109,"height":31},{"text":"먼저","x":1143,"y":1631,"width":52,"height":31},{"text":"서브","x":1211,"y":1631,"width":57,"height":31},{"text":"디렉토리의","x":1281,"y":1630,"width":140,"height":32},{"text":"용량을","x":1435,"y":1629,"width":89,"height":33},{"text":"모두","x":1535,"y":1631,"width":57,"height":30}]},{"text":"계산한 다음에 루트 디렉토리의 용근åk을 계산하여야 할 것이다. 따라서 후위 순회를 시용하여야","words":[{"text":"계산한","x":392,"y":1682,"width":84,"height":32},{"text":"다음에","x":488,"y":1684,"width":79,"height":31},{"text":"루트","x":580,"y":1687,"width":55,"height":29},{"text":"디렉토리의","x":647,"y":1684,"width":131,"height":31},{"text":"용근åk을","x":792,"y":1684,"width":81,"height":31},{"text":"계산하여야","x":886,"y":1683,"width":137,"height":32},{"text":"할","x":1033,"y":1684,"width":29,"height":30},{"text":"것이다.","x":1075,"y":1684,"width":88,"height":31},{"text":"따라서","x":1180,"y":1684,"width":83,"height":31},{"text":"후위","x":1278,"y":1684,"width":55,"height":31},{"text":"순회를","x":1348,"y":1684,"width":88,"height":31},{"text":"시용하여야","x":1448,"y":1683,"width":144,"height":32}]},{"text":"한다. 후위 순회를 사용하되 순환 호출되는 순회 함수가 용량을 반환하도록 만들어야 한다. 따","words":[{"text":"한다.","x":390,"y":1736,"width":64,"height":31},{"text":"후위","x":470,"y":1737,"width":53,"height":31},{"text":"순회를","x":537,"y":1738,"width":82,"height":30},{"text":"사용하되","x":630,"y":1736,"width":105,"height":31},{"text":"순환","x":749,"y":1737,"width":56,"height":29},{"text":"호출되는","x":816,"y":1736,"width":108,"height":31},{"text":"순회","x":936,"y":1736,"width":52,"height":31},{"text":"함수가","x":1004,"y":1736,"width":83,"height":31},{"text":"용량을","x":1098,"y":1736,"width":86,"height":31},{"text":"반환하도록","x":1197,"y":1737,"width":144,"height":31},{"text":"만들어야","x":1353,"y":1737,"width":117,"height":31},{"text":"한다.","x":1481,"y":1737,"width":64,"height":31},{"text":"따","x":1563,"y":1737,"width":28,"height":31}]},{"text":"라서 순회 함수를 조금 변경하면 된다. 다음 프로그램 8.7에 소스를 나타내었다. 프로그램을 간","words":[{"text":"라서","x":392,"y":1787,"width":53,"height":32},{"text":"순회","x":459,"y":1789,"width":53,"height":31},{"text":"함수를","x":526,"y":1789,"width":82,"height":31},{"text":"조금","x":617,"y":1790,"width":55,"height":29},{"text":"변경하면","x":683,"y":1788,"width":105,"height":31},{"text":"된다.","x":801,"y":1788,"width":59,"height":31},{"text":"다음","x":875,"y":1788,"width":55,"height":31},{"text":"프로그램","x":941,"y":1789,"width":107,"height":30},{"text":"8.7에","x":1062,"y":1789,"width":66,"height":30},{"text":"소스를","x":1142,"y":1790,"width":86,"height":29},{"text":"나타내었다.","x":1240,"y":1789,"width":149,"height":31},{"text":"프로그램을","x":1405,"y":1790,"width":145,"height":30},{"text":"간","x":1561,"y":1790,"width":29,"height":30}]},{"text":"단하게 하기 위하여 트리의 노드를 정적으로 생성하였지만 실제로는 동적으로 생성하는 편이","words":[{"text":"단하게","x":392,"y":1840,"width":82,"height":31},{"text":"하기","x":490,"y":1841,"width":51,"height":31},{"text":"위하여","x":559,"y":1841,"width":78,"height":31},{"text":"트리의","x":653,"y":1840,"width":77,"height":31},{"text":"노드를","x":746,"y":1842,"width":81,"height":28},{"text":"정적으로","x":841,"y":1840,"width":108,"height":30},{"text":"생성하였지만","x":963,"y":1840,"width":167,"height":32},{"text":"실제로는","x":1144,"y":1841,"width":114,"height":30},{"text":"동적으로","x":1270,"y":1841,"width":117,"height":30},{"text":"생성하는","x":1401,"y":1842,"width":116,"height":30},{"text":"편이","x":1532,"y":1842,"width":52,"height":32}]},{"text":"좋다.","words":[{"text":"좋다.","x":392,"y":1892,"width":62,"height":30}]},{"text":"286 C언어로 쉽게 불어쓴 자료구조","words":[{"text":"286","x":123,"y":2269,"width":58,"height":27},{"text":"C언어로","x":208,"y":2271,"width":81,"height":23},{"text":"쉽게","x":297,"y":2271,"width":42,"height":23},{"text":"불어쓴","x":348,"y":2272,"width":64,"height":23},{"text":"자료구조","x":420,"y":2272,"width":85,"height":22}]}]}