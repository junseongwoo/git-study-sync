{"page":588,"width":1598,"height":2136,"text_angle":0,"lines":[{"text":"㉦","words":[{"text":"㉦","x":187,"y":328,"width":67,"height":64}]},{"text":"㉦","words":[{"text":"㉦","x":457,"y":324,"width":64,"height":66}]},{"text":"다시 해 선택의 시간이 돌아왔습니다. 빈도가 가장 작은 2개의 노드를 골라야 하는데 마침 딱 2개만","words":[{"text":"다시","x":149,"y":566,"width":54,"height":30},{"text":"해","x":216,"y":566,"width":26,"height":30},{"text":"선택의","x":254,"y":566,"width":80,"height":29},{"text":"시간이","x":346,"y":566,"width":76,"height":29},{"text":"돌아왔습니다.","x":432,"y":566,"width":161,"height":30},{"text":"빈도가","x":606,"y":565,"width":77,"height":31},{"text":"가장","x":691,"y":564,"width":51,"height":30},{"text":"작은","x":750,"y":563,"width":54,"height":29},{"text":"2개의","x":812,"y":560,"width":65,"height":31},{"text":"노드를","x":889,"y":560,"width":80,"height":29},{"text":"골라야","x":978,"y":558,"width":83,"height":31},{"text":"하는데","x":1070,"y":557,"width":82,"height":31},{"text":"마침","x":1164,"y":556,"width":55,"height":31},{"text":"딱","x":1232,"y":556,"width":29,"height":31},{"text":"2개만","x":1272,"y":557,"width":78,"height":30}]},{"text":"남았군요. 새 노-드를 만들고 여기에 노드 a와 b. c. d의 뿌리 노드를 자식 노-드로 연결시킵니다. 여","words":[{"text":"남았군요.","x":148,"y":623,"width":120,"height":30},{"text":"새","x":281,"y":622,"width":26,"height":29},{"text":"노-드를","x":318,"y":624,"width":81,"height":27},{"text":"만들고","x":408,"y":623,"width":78,"height":28},{"text":"여기에","x":496,"y":623,"width":75,"height":30},{"text":"노드","x":581,"y":626,"width":52,"height":22},{"text":"a와","x":641,"y":622,"width":43,"height":30},{"text":"b.","x":692,"y":625,"width":24,"height":28},{"text":"c.","x":728,"y":632,"width":21,"height":21},{"text":"d의","x":761,"y":620,"width":43,"height":30},{"text":"뿌리","x":816,"y":619,"width":49,"height":31},{"text":"노드를","x":877,"y":619,"width":81,"height":29},{"text":"자식","x":967,"y":617,"width":52,"height":31},{"text":"노-드로","x":1032,"y":620,"width":84,"height":23},{"text":"연결시킵니다.","x":1127,"y":616,"width":179,"height":31},{"text":"여","x":1321,"y":616,"width":26,"height":30}]},{"text":"전히 모든 기호 노드가 잎 노드이지요? 이제 이 새로운 노드를 노드 집힘에 추가합니다.","words":[{"text":"전히","x":150,"y":679,"width":53,"height":30},{"text":"모든","x":214,"y":680,"width":58,"height":29},{"text":"기호","x":280,"y":678,"width":54,"height":30},{"text":"노드가","x":342,"y":678,"width":80,"height":30},{"text":"잎","x":430,"y":678,"width":23,"height":30},{"text":"노드이지요?","x":464,"y":680,"width":144,"height":30},{"text":"이제","x":617,"y":679,"width":49,"height":30},{"text":"이","x":676,"y":679,"width":23,"height":30},{"text":"새로운","x":710,"y":679,"width":79,"height":30},{"text":"노드를","x":797,"y":678,"width":79,"height":29},{"text":"노드","x":884,"y":679,"width":54,"height":23},{"text":"집힘에","x":948,"y":675,"width":78,"height":31},{"text":"추가합니다.","x":1037,"y":675,"width":148,"height":30}]},{"text":"이제 노드 집합에는 단 하나의 노드만 남아 있습니다. 이것은 곧 접두어 트리가 완성되었음을 의미","words":[{"text":"이제","x":154,"y":1264,"width":55,"height":31},{"text":"노드","x":221,"y":1267,"width":57,"height":23},{"text":"집합에는","x":289,"y":1264,"width":108,"height":30},{"text":"단","x":406,"y":1264,"width":29,"height":29},{"text":"하나의","x":444,"y":1263,"width":77,"height":31},{"text":"노드만","x":533,"y":1264,"width":80,"height":29},{"text":"남아","x":622,"y":1264,"width":53,"height":30},{"text":"있습니다.","x":685,"y":1262,"width":107,"height":32},{"text":"이것은","x":806,"y":1262,"width":79,"height":30},{"text":"곧","x":894,"y":1264,"width":26,"height":28},{"text":"접두어","x":931,"y":1261,"width":79,"height":31},{"text":"트리가","x":1022,"y":1259,"width":86,"height":31},{"text":"완성되었음을","x":1118,"y":1258,"width":176,"height":31},{"text":"의미","x":1306,"y":1258,"width":57,"height":31}]},{"text":"합니다. 이제 이 집힘에서 남아 있는 노드를 꺼내면 이 노드가 곧 허프만 트리가 됩니다.","words":[{"text":"합니다.","x":152,"y":1323,"width":92,"height":30},{"text":"이제","x":258,"y":1322,"width":53,"height":30},{"text":"이","x":323,"y":1322,"width":23,"height":30},{"text":"집힘에서","x":359,"y":1322,"width":103,"height":30},{"text":"남아","x":474,"y":1322,"width":54,