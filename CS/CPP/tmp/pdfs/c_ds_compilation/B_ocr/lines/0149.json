06,"y":1802,"width":70,"height":37},{"text":"수식을","x":1189,"y":1801,"width":95,"height":37},{"text":"나타내고","x":1293,"y":1800,"width":124,"height":37},{"text":"계산까지","x":1427,"y":1799,"width":118,"height":36},{"text":"처리하","x":1561,"y":1800,"width":95,"height":36}]},{"text":"는 수식 트리. 그리고 트리를 이용한 분리 집합 자료구조","words":[{"text":"는","x":854,"y":1876,"width":34,"height":33},{"text":"수식","x":900,"y":1873,"width":61,"height":37},{"text":"트리.","x":977,"y":1873,"width":71,"height":37},{"text":"그리고","x":1064,"y":1873,"width":95,"height":36},{"text":"트리를","x":1171,"y":1872,"width":93,"height":35},{"text":"이용한","x":1277,"y":1870,"width":93,"height":37},{"text":"분리","x":1381,"y":1871,"width":58,"height":35},{"text":"집합","x":1457,"y":1869,"width":60,"height":36},{"text":"자료구조","x":1529,"y":1869,"width":127,"height":37}]},{"text":"를 이 징에서 만나볼 수 있습니다.","words":[{"text":"를","x":855,"y":1945,"width":33,"height":34},{"text":"이","x":900,"y":1944,"width":28,"height":36},{"text":"징에서","x":941,"y":1943,"width":92,"height":38},{"text":"만나볼","x":1046,"y":1942,"width":95,"height":36},{"text":"수","x":1149,"y":1942,"width":33,"height":35},{"text":"있습니다.","x":1193,"y":1940,"width":129,"height":37}]},{"text":"그럼 시작해볼까요?","words":[{"text":"그럼","x":856,"y":2025,"width":62,"height":36},{"text":"시작해볼까요?","x":932,"y":2024,"width":206,"height":38}]}]}