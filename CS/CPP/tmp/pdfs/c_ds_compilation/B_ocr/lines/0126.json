t":"를","x":176,"y":765,"width":34,"height":32},{"text":"옮기는","x":220,"y":763,"width":96,"height":34},{"text":"대신","x":328,"y":762,"width":58,"height":35},{"text":"전단의","x":400,"y":762,"width":87,"height":35},{"text":"위치만","x":502,"y":762,"width":91,"height":36},{"text":"변경히는","x":605,"y":762,"width":119,"height":35},{"text":"것입니다.","x":735,"y":761,"width":127,"height":35},{"text":"이와","x":878,"y":761,"width":62,"height":35},{"text":"함께","x":950,"y":761,"width":60,"height":35},{"text":"후단을","x":1022,"y":761,"width":94,"height":35},{"text":"가리기는","x":1127,"y":761,"width":123,"height":36},{"text":"변수도","x":1263,"y":761,"width":94,"height":34},{"text":"도입해서","x":1368,"y":760,"width":131,"height":36},{"text":"삽","x":1515,"y":760,"width":37,"height":35}]},{"text":"입이 일어날 때마다 후단의 위치를 변경합니다. 후단을 가리기는 변수에는 \u0027실제 후단의 위치 + 1\u0027","words":[{"text":"입이","x":178,"y":830,"width":60,"height":34},{"text":"일어날","x":254,"y":830,"width":91,"height":34},{"text":"때마다","x":357,"y":830,"width":90,"height":34},{"text":"후단의","x":457,"y":830,"width":89,"height":35},{"text":"위치를","x":562,"y":831,"width":89,"height":34},{"text":"변경합니다.","x":664,"y":829,"width":156,"height":35},{"text":"후단을","x":835,"y":829,"width":93,"height":35},{"text":"가리기는","x":940,"y":829,"width":122,"height":36},{"text":"변수에는","x":1075,"y":829,"width":121,"height":36},{"text":"\u0027실제","x":1207,"y":829,"width":69,"height":35},{"text":"후단의","x":1290,"y":829,"width":94,"height":35},{"text":"위치","x":1401,"y":829,"width":62,"height":35},{"text":"+","x":1482,"y":835,"width":23,"height":23},{"text":"1\u0027","x":1522,"y":829,"width":28,"height":31}]},{"text":"한 값을 담습니다. 삽입이 이루어질 때 후단이 가리카는 위치에 데이터를 바로 입력하면 되도록 말","words":[{"text":"한","x":176,"y":896,"width":34,"height":33},{"text":"값을","x":221,"y":896,"width":62,"height":34},{"text":"담습니다.","x":294,"y":896,"width":127,"height":35},{"text":"삽입이","x":436,"y":896,"width":89,"height":36},{"text":"이루어질","x":540,"y":896,"width":117,"height":37},{"text":"때","x":671,"y":896,"widt