{"page":126,"width":1699,"height":2484,"text_angle":0,"lines":[{"text":"이 그림에 있는 큐 배열의 크기는 8이며 그 안에는 1, 2, 3, 4의 값을 가진 요소가 있습니다. 전단인","words":[{"text":"이","x":180,"y":211,"width":29,"height":35},{"text":"그림에","x":222,"y":210,"width":95,"height":35},{"text":"있는","x":331,"y":210,"width":61,"height":35},{"text":"큐","x":402,"y":213,"width":32,"height":32},{"text":"배열의","x":444,"y":210,"width":89,"height":36},{"text":"크기는","x":546,"y":210,"width":93,"height":35},{"text":"8이며","x":648,"y":210,"width":76,"height":35},{"text":"그","x":737,"y":215,"width":30,"height":24},{"text":"안에는","x":778,"y":210,"width":89,"height":34},{"text":"1,","x":878,"y":214,"width":22,"height":30},{"text":"2,","x":914,"y":212,"width":25,"height":31},{"text":"3,","x":953,"y":211,"width":26,"height":32},{"text":"4의","x":992,"y":207,"width":47,"height":35},{"text":"값을","x":1052,"y":207,"width":60,"height":35},{"text":"가진","x":1122,"y":206,"width":59,"height":36},{"text":"요소가","x":1192,"y":206,"width":95,"height":36},{"text":"있습니다.","x":1297,"y":203,"width":136,"height":37},{"text":"전단인","x":1451,"y":203,"width":101,"height":35}]},{"text":"1을 제거하면 배열 내에 첫 번째 인덱스의 요소가 비게 되고 빈 자리를 채우기 위해 뒤에 있던 2, 3,","words":[{"text":"1을","x":182,"y":278,"width":50,"height":34},{"text":"제거하면","x":243,"y":277,"width":125,"height":35},{"text":"배열","x":380,"y":277,"width":60,"height":35},{"text":"내에","x":452,"y":278,"width":58,"height":34},{"text":"첫","x":525,"y":277,"width":28,"height":34},{"text":"번째","x":566,"y":277,"width":57,"height":34},{"text":"인덱스의","x":637,"y":276,"width":116,"height":34},{"text":"요소가","x":765,"y":275,"width":90,"height":36},{"text":"비게","x":866,"y":275,"width":55,"height":35},{"text":"되고","x":934,"y":274,"width":60,"height":35},{"text":"빈","x":1005,"y":274,"width":27,"height":34},{"text":"자리를","x":1044,"y":273,"width":91,"height":36},{"text":"채우기","x":1145,"y":273,"width":87,"height":36},{"text":"위해","x":1246,"y":273,"width":60,"height":36},{"text":"뒤에","x":1320,"y":272,"width":61,"height":35},{"text":"있던","x":1397,"y":270,"width":64,"height":36},{"text":"2,","x":1475,"y":275,"width":29,"height":31},{"text":"3,","x":1519,"y":275,"width":30,"height":32}]},{"text":"4 요소가 앞으로 한 간씩 옮겨옵니다.","words":[{"text":"4","x":178,"y":347,"width":19,"height":29},{"text":"요소가","x":209,"y":344,"width":97,"height":35},{"text":"앞으로","x":315,"y":344,"width":93,"height":34},{"text":"한","x":418,"y":343,"width":32,"height":34},{"text":"간씩","x":460,"y":343,"width":57,"height":34},{"text":"옮겨옵니다.","x":529,"y":342,"width":158,"height":35}]},{"text":"이 방식에는 문제가 있는데요. 바로 전단을 제거한 후 나머지 요소들을 한 간씩 앞으로 옮기는 데 드","words":[{"text":"이","x":179,"y":420,"width":29,"height":35},{"text":"방식에는","x":221,"y":419,"width":127,"height":36},{"text":"문제가","x":357,"y":418,"width":94,"height":35},{"text":"있는데요.","x":462,"y":418,"width":126,"height":35},{"text":"바로","x":603,"y":418,"width":60,"height":34},{"text":"전단을","x":674,"y":417,"width":89,"height":34},{"text":"제거한","x":773,"y":418,"width":90,"height":35},{"text":"후","x":871,"y":418,"width":31,"height":34},{"text":"나머지","x":912,"y":417,"width":87,"height":35},{"text":"요소들을","x":1011,"y":417,"width":123,"height":34},{"text":"한","x":1142,"y":417,"width":33,"height":33},{"text":"간씩","x":1184,"y":416,"width":57,"height":35},{"text":"앞으로","x":1255,"y":416,"width":96,"height":34},{"text":"옮기는","x":1360,"y":415,"width":102,"height":35},{"text":"데","x":1473,"y":414,"width":31,"height":34},{"text":"드","x":1517,"y":417,"width":35,"height":26}]},{"text":"는 비용이 상당하다는 점입니다. 큐 용량이 100개라면 한 번의 제거 연산에서 99번의 이동 작업을","words":[{"text":"는","x":177,"y":489,"width":35,"height":32},{"text":"비용이","x":224,"y":486,"width":91,"height":36},{"text":"상당하다는","x":328,"y":485,"width":155,"height":36},{"text":"점입니다.","x":495,"y":485,"width":126,"height":34},{"text":"큐","x":636,"y":487,"width":31,"height":32},{"text":"용량이","x":677,"y":484,"width":88,"height":35},{"text":"100개라면","x":781,"y":485,"width":142,"height":34},{"text":"한","x":936,"y":485,"width":31,"height":33},{"text":"번의","x":