{"page":240,"width":1755,"height":2299,"text_angle":0,"lines":[{"text":"06","words":[{"text":"06","x":840,"y":608,"width":304,"height":216}]},{"text":"Chapter","words":[{"text":"Chapter","x":416,"y":667,"width":227,"height":61}]},{"text":"탐색, 다른 말로 검색은 구글에게 가장 많은 돈을 벌어주","words":[{"text":"탐색,","x":848,"y":1275,"width":69,"height":37},{"text":"다른","x":933,"y":1277,"width":61,"height":35},{"text":"말로","x":1006,"y":1278,"width":61,"height":34},{"text":"검색은","x":1080,"y":1278,"width":88,"height":34},{"text":"구글에게","x":1177,"y":1282,"width":118,"height":34},{"text":"가장","x":1308,"y":1282,"width":60,"height":34},{"text":"많은","x":1378,"y":1282,"width":60,"height":35},{"text":"돈을","x":1448,"y":1282,"width":60,"height":34},{"text":"벌어주","x":1520,"y":1283,"width":90,"height":34}]},{"text":"는 기술 중 하나입니다. 사실 사업 초기에는 검색이 구글","words":[{"text":"는","x":848,"y":1342,"width":34,"height":32},{"text":"기술","x":893,"y":1341,"width":61,"height":35},{"text":"중","x":965,"y":1344,"width":33,"height":33},{"text":"하나입니다.","x":1009,"y":1343,"width":155,"height":34},{"text":"사실","x":1179,"y":1345,"width":59,"height":34},{"text":"사업","x":1251,"y":1347,"width":55,"height":33},{"text":"초기에는","x":1321,"y":1347,"width":118,"height":33},{"text":"검색이","x":1451,"y":1347,"width":85,"height":34},{"text":"구글","x":1549,"y":1350,"width":61,"height":31}]},{"text":"그 자체였죠. 이번에 우리가 다를 탐색 알고리즘은 여러분","words":[{"text":"그","x":849,"y":1411,"width":32,"height":23},{"text":"자체였죠.","x":890,"y":1407,"width":129,"height":36},{"text":"이번에","x":1033,"y":1409,"width":86,"height":34},{"text":"우리가","x":1130,"y":1409,"width":91,"height":35},{"text":"다를","x":1229,"y":1411,"width":60,"height":34},{"text":"탐색","x":1297,"y":1412,"width":57,"height":33},{"text":"알고리즘은","x":1366,"y":1411,"width":148,"height":34},{"text":"여러분","x":1522,"y":1411,"width":89,"height":33}]},{"text":"이 데이터 탐색 기능을 애플리게이션에 불어넣을 때 필요","words":[{"text":"이","x":852,"y":1472,"width":27,"height":35},{"text":"데이터","x":893,"y":1473,"width":88,"height":36},{"text"