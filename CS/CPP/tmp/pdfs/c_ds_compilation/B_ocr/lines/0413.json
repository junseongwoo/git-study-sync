:57,"height":32}]},{"text":"간선이 없는 정점은 A와 B가 있지만 A에서부터 시작해보겠습니다. A - C - F - H를 타고 그래프","words":[{"text":"간선이","x":242,"y":782,"width":95,"height":32},{"text":"없는","x":353,"y":781,"width":62,"height":33},{"text":"정점은","x":426,"y":781,"width":89,"height":32},{"text":"A와","x":523,"y":781,"width":55,"height":31},{"text":"B가","x":587,"y":781,"width":53,"height":31},{"text":"있지만","x":651,"y":780,"width":86,"height":32},{"text":"A에서부터","x":745,"y":780,"width":138,"height":32},{"text":"시작해보겠습니다.","x":898,"y":780,"width":242,"height":32},{"text":"A","x":1152,"y":786,"width":24,"height":24},{"text":"-","x":1187,"y":795,"width":21,"height":4},{"text":"C","x":1218,"y":786,"width":22,"height":25},{"text":"-","x":1252,"y":796,"width":20,"height":4},{"text":"F","x":1282,"y":786,"width":17,"height":24},{"text":"-","x":1311,"y":796,"width":20,"height":4},{"text":"H를","x":1342,"y":783,"width":56,"height":31},{"text":"타고","x":1408,"y":781,"width":59,"height":33},{"text":"그래프","x":1476,"y":782,"width":92,"height":32}]},{"text":"안쪽으로 탐색하면 H를 만납니다. H에서 옮겨갈 수 있는 인접 정점이 더 이상 없으므로 H를 리스","words":[{"text":"안쪽으로","x":242,"y":844,"width":130,"height":32},{"text":"탐색하면","x":384,"y":842,"width":122,"height":32},{"text":"H를","x":517,"y":843,"width":57,"height":31},{"text":"만납니다.","x":585,"y":842,"width":124,"height":33},{"text":"H에서","x":723,"y":842,"width":83,"height":33},{"text":"옮겨갈","x":820,"y":842,"width":90,"height":32},{"text":"수","x":919,"y":842,"width":31,"height":32},{"text":"있는","x":962,"y":842,"width":59,"height":32},{"text":"인접","x":1033,"y":841,"width":55,"height":32},{"text":"정점이","x":1104,"y":842,"width":85,"height":34},{"text":"더","x":1204,"y":844,"width":25,"height":32},{"text":"이상","x":1244,"y":844,"width":58,"height":33},{"text":"없으므로","x":1314,"y":845,"width":115,"height":32},{"text":"H를","x":1438,"y":846,"width":57,"height":31},{"text":"리스","x":1508,"y":845,"width":58,"height":32}]},{"text":"트의 \u0027헤드로 삽입합니다.","words":[{"text":"트의","x":242,"y":906,"width":64,"height":32},