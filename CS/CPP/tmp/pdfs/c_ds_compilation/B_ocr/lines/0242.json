":27,"height":29},{"text":"있습니다.","x":1384,"y":784,"width":107,"height":29}]},{"text":"• 수천 페이지나 되는 영어사전에서 원하는 단어를 1 분 인에 찾을 수 있습니다","words":[{"text":"•","x":288,"y":858,"width":13,"height":11},{"text":"수천","x":317,"y":849,"width":56,"height":29},{"text":"페이지나","x":382,"y":848,"width":108,"height":30},{"text":"되는","x":498,"y":848,"width":53,"height":28},{"text":"영어사전에서","x":559,"y":848,"width":155,"height":31},{"text":"원하는","x":723,"y":849,"width":77,"height":29},{"text":"단어를","x":808,"y":850,"width":75,"height":28},{"text":"1","x":893,"y":853,"width":10,"height":24},{"text":"분","x":909,"y":851,"width":26,"height":28},{"text":"인에","x":942,"y":851,"width":50,"height":28},{"text":"찾을","x":1001,"y":850,"width":50,"height":29},{"text":"수","x":1057,"y":851,"width":28,"height":28},{"text":"있습니다","x":1092,"y":850,"width":105,"height":29}]},{"text":"• 상대방이 마음속으로 생弔는 1~2.0% 人삐의 임의 숫자를 1 1 번의 질문 내로 맞취서 상대방을 놀라게 할","words":[{"text":"•","x":288,"y":924,"width":13,"height":11},{"text":"상대방이","x":318,"y":915,"width":109,"height":29},{"text":"마음속으로","x":440,"y":913,"width":132,"height":30},{"text":"생弔는","x":582,"y":915,"width":105,"height":29},{"text":"1~2.0%","x":698,"y":918,"width":120,"height":26},{"text":"人삐의","x":830,"y":916,"width":75,"height":28},{"text":"임의","x":916,"y":916,"width":50,"height":28},{"text":"숫자를","x":975,"y":916,"width":77,"height":28},{"text":"1","x":1064,"y":918,"width":10,"height":25},{"text":"1","x":1082,"y":918,"width":9,"height":25},{"text":"번의","x":1098,"y":916,"width":49,"height":29},{"text":"질문","x":1158,"y":917,"width":50,"height":28},{"text":"내로","x":1218,"y":917,"width":49,"height":27},{"text":"맞취서","x":1277,"y":916,"width":74,"height":29},{"text":"상대방을","x":1362,"y":917,"width":104,"height":29},{"text":"놀라게","x":1475,"y":916,"width":79,"height":29},{"text":"할","x":1566,"y":916,"width":28,"height":29}]},{"text":"수 있습니다.","words":[{"text":"수","x":317,"y":970,"width":30,"height":28},{"text":"있습니다.","x":356,"y":969,"width":113,"height":29}]},{"text":"이제부터 우리는 가장 간단한 탐색 알고리즘인 순차 탐색과 이를 개선하는 방법을 살펴본 후 이진","words":[{"text":"이제부터","x":231,"y":1060,"width":129,"height":35},{"text":"우리는","x":376,"y":1060,"width":99,"height":33},{"text":"가장","x":487,"y":1059,"width":64,"height":35},{"text":"간단한","x":563,"y":1061,"width":95,"height":33},{"text":"탐색","x":669,"y":1062,"width":60,"height":33},{"text":"알고리즘인","x":744,"y":1061,"width":150,"height":33},{"text":"순차","x":906,"y":1061,"width":62,"height":35},{"text":"탐색과","x":979,"y":1062,"width":92,"height":34},{"text":"이를","x":1083,"y":1062,"width":59,"height":34},{"text":"개선하는","x":1154,"y":1062,"width":117,"height":34},{"text":"방법을","x":1282,"y":1063,"width":89,"height":33},{"text":"살펴본","x":1381,"y":1063,"width":93,"height":33},{"text":"후","x":1483,"y":1064,"width":33,"height":33},{"text":"이진","x":1528,"y":1063,"width":61,"height":34}]},{"text":"탐색을 살펴볼 것입니다. 이진 탐색은 놀라운 성능-을 보여주는 탐색 알고리즘이지만 모든 자료구조","words":[{"text":"탐색을","x":229,"y":1125,"width":103,"height":34},{"text":"살펴볼","x":342,"y":1124,"width":99,"height":33},{"text":"것입니다.","x":453,"y":1124,"width":133,"height":34},{"text":"이진","x":602,"y":1125,"width":60,"height":34},{"text":"탐색은","x":674,"y":1125,"width":94,"height":34},{"text":"놀라운","x":777,"y":1125,"width":92,"height":34},{"text":"성능-을","x":880,"y":1125,"width":91,"height":34},{"text":"보여주는","x":980,"y":1127,"width":123,"height":33},{"text":"탐색","x":1112,"y":1127,"width":57,"height":33},{"text":"알고리즘이지만","x":1182,"y":1127,"width":206,"height":34},{"text":"모든","x":1396,"y":1129,"width":61,"height":31},{"text":"자료구조","x":1466,"y":1128,"width":122,"height":34}]},{"text":"에서 사용할 수 있는 것은 아닙니다. 각 요소가 메모리에 순차적으로 적재되어 있어 그 주소를 바로","words":[{"text":"에서","x":230,"y":1189,"width":63,"height":35},{"text":"사용할","x":308,"y":1188,"width":101,"height":34},{"text":"수","x":417,"y":1188,"width":35,"height":34},{"text":"있는","x":464,"y":1188,"width":63,"height":34},{"text":"것은","x":538,"y":1189,"width":64,"height":34},{"text":"아닙니다.","x":612,"y":1189,"width":130,"height":35},{"te