eight":32},{"text":"괄호","x":1564,"y":553,"width":65,"height":32}]},{"text":"로 함께 묶어 표현하는 방법입니다. 예를 들어 다음 그림에서 왼쪽 트리를 중접된 괄호 표현법으로","words":[{"text":"로","x":228,"y":621,"width":33,"height":24},{"text":"함께","x":273,"y":616,"width":62,"height":34},{"text":"묶어","x":348,"y":616,"width":61,"height":32},{"text":"표현하는","x":424,"y":616,"width":128,"height":32},{"text":"방법입니다.","x":564,"y":616,"width":161,"height":32},{"text":"예를","x":742,"y":616,"width":61,"height":31},{"text":"들어","x":814,"y":615,"width":60,"height":32},{"text":"다음","x":889,"y":615,"width":63,"height":33},{"text":"그림에서","x":963,"y":613,"width":122,"height":33},{"text":"왼쪽","x":1101,"y":614,"width":63,"height":32},{"text":"트리를","x":1175,"y":613,"width":96,"height":33},{"text":"중접된","x":1281,"y":614,"width":95,"height":32},{"text":"괄호","x":1389,"y":615,"width":65,"height":32},{"text":"표현법으로","x":1465,"y":616,"width":163,"height":32}]},{"text":"표현하면 오른쪽 형식처럼 나타낼 수 있습니다. 이 방법은 읽기는 다소 어렵지만 트리를 하나의 공","words":[{"text":"표현하면","x":227,"y":679,"width":127,"height":34},{"text":"오른쪽","x":366,"y":681,"width":96,"height":31},{"text":"형식처럼","x":474,"y":679,"width":123,"height":33},{"text":"나타낼","x":613,"y":678,"width":90,"height":33},{"text":"수","x":716,"y":678,"width":33,"height":32},{"text":"있습니다.","x":762,"y":678,"width":128,"height":33},{"text":"이","x":908,"y":677,"width":27,"height":33},{"text":"방법은","x":950,"y":677,"width":94,"height":33},{"text":"읽기는","x":1057,"y":676,"width":93,"height":34},{"text":"다소","x":1162,"y":676,"width":62,"height":33},{"text":"어렵지만","x":1237,"y":677,"width":128,"height":32},{"text":"트리를","x":1376,"y":678,"width":96,"height":32},{"text":"하나의","x":1484,"y":678,"width":95,"height":33},{"text":"공","x":1593,"y":680,"width":34,"height":31}]},{"text":"식처럼 표현할 수 있다는 것이 장점입니다.","words":[{"text":"식처럼","x":228,"y":744,"width":91,"height":34},{"text":"표현할","x":333,"y":743,"width":95,"height":33},{"text":"수","x":437,"y":744,"width":32,"height":32},{"text":"있다는","x":481,"y":742,"width":94,"height":34}