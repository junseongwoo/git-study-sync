{"page":308,"width":1718,"height":2245,"text_angle":0,"lines":[{"text":"07","words":[{"text":"07","x":816,"y":584,"width":264,"height":208}]},{"text":"Chapter","words":[{"text":"Chapter","x":395,"y":642,"width":223,"height":54}]},{"text":"\u003e 우선순위 큐와 힙","words":[{"text":"\u003e","x":710,"y":1068,"width":28,"height":53},{"text":"우선순위","x":808,"y":1050,"width":320,"height":88},{"text":"큐와","x":1158,"y":1054,"width":164,"height":86},{"text":"힙","x":1350,"y":1054,"width":73,"height":85}]},{"text":"“또 큐 이야기예요? 3징뻬서 설명할 때 한꺼번에 할 것이","words":[{"text":"“또","x":816,"y":1222,"width":45,"height":29},{"text":"큐","x":870,"y":1226,"width":31,"height":32},{"text":"이야기예요?","x":911,"y":1225,"width":159,"height":33},{"text":"3징뻬서","x":1080,"y":1225,"width":101,"height":34},{"text":"설명할","x":1195,"y":1226,"width":85,"height":35},{"text":"때","x":1289,"y":1228,"width":26,"height":34},{"text":"한꺼번에","x":1328,"y":1229,"width":113,"height":33},{"text":"할","x":1452,"y":1229,"width":31,"height":32},{"text":"것이","x":1493,"y":1228,"width":53,"height":34}]},{"text":"지 왜 이제 다시 이야기를 꺼내나요?”","words":[{"text":"지","x":817,"y":1285,"width":27,"height":34},{"text":"왜","x":856,"y":1287,"width":28,"height":33},{"text":"이제","x":896,"y":1288,"width":55,"height":33},{"text":"다시","x":962,"y":1288,"width":55,"height":32},{"text":"이야기를","x":1030,"y":1288,"width":114,"height":33},{"text":"꺼내나요?”","x":1152,"y":1289,"width":142,"height":34}]},{"text":"너무 홍분하지 말고 제 설명을 들어보세요. 우선순위 큐는","words":[{"text":"너무","x":818,"y":1359,"width":60,"height":33},{"text":"홍분하지","x":886,"y":1360,"width":112,"height":34},{"text":"말고","x":1010,"y":1361,"width":58,"height":32},{"text":"제","x":1077,"y":1361,"width":26,"height":32},{"text":"설명을","x":1114,"y":1361,"width":88,"height":33},{"text":"들어보세요.","x":1209,"y":1363,"width":147,"height":33},{"text":"우선순위","x":1368,"y":1363,"width":114,"height":33},{"text":"큐는","x":1492,"y":1365,"width":58,"height":30}]},{"text":"우리가 3징에서 다웠던 큐외는 다릅니다. 선입선출 방식","words":[{"text":"우리가","x":817,"y":1423,"width":91,"height":35},{"text":"3징에서","x":919,"y":1424,"width":101,"height":34},{"text":"다웠던","x":1035,"y":1424,"width":84,"height":34},{"text":"큐외는","x":1132,"y":1426,"width":88,"height":32},{"text":"다릅니다.","x":1231,"y":1426,"width":119,"height":33},{"text":"선입선출","x":1366,"y":1427,"width":117,"height":32},{"text":"방식","x":1494,"y":1425,"width":54,"height":34}]},{"text":"으로 -동작하지 않고 우선순위에 따라 데이터의 출력 순서","words":[{"text":"으로","x":818,"y":1487,"width":60,"height":27},{"text":"-동작하지","x":888,"y":1486,"width":112,"height":34},{"text":"않고","x":1014,"y":1487,"width":57,"height":33},{"text":"우선순위에","x":1080,"y":1487,"width":142,"height":34},{"text":"따라","x":1234,"y":1488,"width":57,"height":32},{"text":"데이터의","x":1301,"y":1488,"width":113,"height":34},{"text":"출력","x":1426,"y":1489,"width":57,"height":32},{"text":"순서","x":1496,"y":1486,"width":55,"height":34}]},{"text":"가 결정되거든요. 우선순위 큐의 핵심은 데이터의 입출력","words":[{"text":"가","x":819,"y":1549,"width":31,"height":33},{"text":"결정되거든요.","x":860,"y":1549,"width":178,"height":34},{"text":"우선순위","x":1052,"y":1550,"width":113,"height":33},{"text":"큐의","x":1177,"y":1550,"width":55,"height":33},{"text":"핵심은","x":1245,"y":1550,"width":85,"height":32},{"text":"데이터의","x":1340,"y":1551,"width":115,"height":32},{"text":"입출력","x":1470,"y":1548,"width":81,"height":33}]},{"text":"이 이루어질 때마다 최소 비용으로 최우선순위의 데이터","words":[{"text":"이","x":819,"y":1611,"width":26,"height":33},{"text":"이루어질","x":862,"y":1612,"width":113,"height":33},{"text":"때마다","x":990,"y":1612,"width":86,"height":33},{"text":"최소","x":1088,"y":1613,"width":57,"height":32},{"text":"비용으로","x":1158,"y":1613,"width":112,"height":33},{"text":"최우선순위의","x":1282,"y":1612,"width":172,"height":33},{"text":"데이터","x":1469,"y":1610,"width":84,"height":34}]},{"text":"를 헤드에 위치시기는, 알고리즘 효율을 높이는 데 있습니","words":[{"text":"를","x":818,"y":1675,"width":30,"height":30},{"text":"헤드에","x":858,"y":1674,"width":85,"height":34},{"text":"위치시기는,","x":954,"y":1674,"width":149,"height":35},{"text":"알고리즘","x":1116,"y":1675,"width":114,"height":32},{"text":"효율을","x":1238,"y":1675,"width":86,"height":32},{"text":"높이는","x":1332,"y":1675,"width":89,"height":32},{"text":"데","x":1430,"y":1674,"width":27,"height":33},{"text":"있습니","x":1471,"y":1673,"width":84,"height":33}]},{"text":"다. 이 알고리즘을 이해하려면 6장에서 공부한 내용을 활","words":[{"text":"다.","x":818,"y":1736,"width":36,"height":32},{"text":"이","x":870,"y":1737,"width":26,"height":33},{"text":"알고리즘을","x":909,"y":1738,"width":145,"height":33},{"text":"이해하려면","x":1064,"y":1738,"width":141,"height":33},{"text":"6장에서","x":1215,"y":1738,"width":101,"height":33},{"text":"공부한","x":1329,"y":1738,"width":90,"height":33},{"text":"내용을","x":1429,"y":1737,"width":89,"height":33},{"text":"활","x":1528,"y":1736,"width":31,"height":32}]},{"text":"용해야 합니다. 그래서 3장이 아닌 7장에서 우선순위 큐","words":[{"text":"용해야","x":817,"y":1798,"width":90,"height":34},{"text":"합니다.","x":917,"y":1800,"width":93,"height":33},{"text":"그래서","x":1026,"y":1800,"width":83,"height":32},{"text":"3장이","x":1123,"y":1800,"width":73,"height":32},{"text":"아닌","x":1210,"y":1800,"width":56,"height":32},{"text":"7장에서","x":1278,"y":1800,"width":104,"height":33},{"text":"우선순위","x":1397,"y":1799,"width":116,"height":34},{"text":"큐","x":1527,"y":1800,"width":30,"height":30}]},{"text":"를 소개하게 되었습니다. 그러면 힘은 뭐냐고요? 그것은","words":[{"text":"를","x":817,"y":1862,"width":31,"height":31},{"text":"소개하게","x":859,"y":1861,"width":114,"height":33},{"text":"되었습니다.","x":988,"y":1860,"width":147,"height":34},{"text":"그러면","x":1151,"y":1861,"width":86,"height":32},{"text":"힘은","x":1252,"y":1861,"width":58,"height":32},{"text":"뭐냐고요?","x":1323,"y":1861,"width":134,"height":32},{"text":"그것은","x":1468,"y":1859,"width":89,"height":32}]},{"text":"본문에서 알려드릴게요.","words":[{"text":"본문에서","x":817,"y":1923,"width":113,"height":34},{"text":"알려드릴게요.","x":942,"y":1921,"width":175,"height":35}]}]}