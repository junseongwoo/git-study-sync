ight":33},{"text":"합니다.","x":897,"y":646,"width":96,"height":33},{"text":"링크드","x":1009,"y":646,"width":88,"height":33},{"text":"리스트에서는","x":1108,"y":644,"width":175,"height":34},{"text":"노드","x":1292,"y":648,"width":58,"height":23},{"text":"삽입이","x":1358,"y":643,"width":82,"height":33},{"text":"간단하","x":1452,"y":643,"width":86,"height":32}]},{"text":"지만 배열에서 요소 사이에 새로운 요소를 삽입하려면 다른 요소를 이동시켜야 하는데 이때 오버헤","words":[{"text":"지만","x":222,"y":711,"width":63,"height":32},{"text":"배열에서","x":296,"y":711,"width":118,"height":33},{"text":"요소","x":428,"y":712,"width":60,"height":26},{"text":"사이에","x":498,"y":710,"width":88,"height":33},{"text":"새로운","x":599,"y":711,"width":91,"height":32},{"text":"요소를","x":699,"y":711,"width":91,"height":31},{"text":"삽입하려면","x":800,"y":710,"width":148,"height":33},{"text":"다른","x":961,"y":710,"width":60,"height":32},{"text":"요소를","x":1030,"y":710,"width":91,"height":31},{"text":"이동시켜야","x":1132,"y":707,"width":148,"height":33},{"text":"하는데","x":1289,"y":707,"width":83,"height":32},{"text":"이때","x":1385,"y":706,"width":54,"height":32},{"text":"오버헤","x":1451,"y":705,"width":85,"height":31}]},{"text":"드가 크다는 문제가 있습니다.","words":[{"text":"드가","x":220,"y":773,"width":64,"height":33},{"text":"크다는","x":293,"y":774,"width":94,"height":33},{"text":"문제가","x":394,"y":773,"width":92,"height":33},{"text":"있습니다.","x":497,"y":773,"width":124,"height":33}]},{"text":"그래서 우리는 분할 시 발생하는 요소의 이동을 최소화하기 위해 일종의 \u0027수색 섬멸\u0027 작전을 펼칠 것","words":[{"text":"그래서","x":219,"y":846,"width":92,"height":33},{"text":"우리는","x":324,"y":846,"width":93,"height":33},{"text":"분할","x":425,"y":846,"width":63,"height":32},{"text":"시","x":497,"y":846,"width":26,"height":33},{"text":"발생하는","x":538,"y":846,"width":119,"height":33},{"text":"요소의","x":665,"y":845,"width":87,"height":32},{"text":"이동을","x":766,"y":845,"width":89,"height":32},{"text":"최소화하기","x":865,"y":845,"width":143,"height":32},{"text":"위해","x":1021,"y":844,"width":57,"height":32},{"text":"일종의","x":1091,"y":844,"width":85