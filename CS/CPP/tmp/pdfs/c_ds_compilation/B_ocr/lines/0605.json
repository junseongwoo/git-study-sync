ight":34},{"text":"한","x":1458,"y":1833,"width":30,"height":34}]},{"text":"눈에 반해 버렸습니다. 그래서 그녀는 테세우스를 살릴 방법을 생각했고, 그가 제물로 바쳐져 궁전","words":[{"text":"눈에","x":202,"y":1903,"width":58,"height":34},{"text":"반해","x":275,"y":1903,"width":56,"height":34},{"text":"버렸습니다.","x":346,"y":1901,"width":150,"height":35},{"text":"그래서","x":512,"y":1901,"width":85,"height":35},{"text":"그녀는","x":611,"y":1901,"width":89,"height":34},{"text":"테세우스를","x":711,"y":1900,"width":143,"height":35},{"text":"살릴","x":865,"y":1898,"width":55,"height":35},{"text":"방법을","x":934,"y":1898,"width":86,"height":36},{"text":"생각했고,","x":1031,"y":1899,"width":121,"height":36},{"text":"그가","x":1166,"y":1900,"width":59,"height":35},{"text":"제물로","x":1236,"y":1900,"width":84,"height":34},{"text":"바쳐져","x":1331,"y":1899,"width":84,"height":35},{"text":"궁전","x":1429,"y":1899,"width":56,"height":36}]},{"text":"에 들어갈 때 검과 실을 주었습니다. 테세우스는 실의 한쪽 끝을 궁전 입구에 묶어놓고 다른 한쪽 끝","words":[{"text":"에","x":202,"y":1969,"width":28,"height":35},{"text":"들어갈","x":242,"y":1968,"width":90,"height":35},{"text":"때","x":342,"y":1968,"width":25,"height":34},{"text":"검과","x":381,"y":1967,"width":58,"height":35},{"text":"실을","x":448,"y":1968,"width":59,"height":33},{"text":"주었습니다.","x":516,"y":1967,"width":153,"height":35},{"text":"테세우스는","x":683,"y":1966,"width":144,"height":35},{"text":"실의","x":836,"y":1965,"width":55,"height":34},{"text":"한쪽","x":902,"y":1965,"width":59,"height":33},{"text":"끝을","x":969,"y":1965,"width":58,"height":34},{"text":"궁전","x":1036,"y":1965,"width":57,"height":34},{"text":"입구에","x":1105,"y":1966,"width":82,"height":34},{"text":"묶어놓고","x":1199,"y":1966,"width":113,"height":34},{"text":"다른","x":1322,"y":1966,"width":58,"height":34},{"text":"한쪽","x":1389,"y":1966,"width":58,"height":34},{"text":"끝","x":1456,"y":1967,"width":30,"height":33}]},{"text":"Chapter 15• 력트래킹 607","words":[{"text":"Chapter","x":1145,"y":2200,"width":104,"height":30},{"text":"15•","x":1260,"y":2202,"width":43,"height":24},{"text":"력트래킹","x":