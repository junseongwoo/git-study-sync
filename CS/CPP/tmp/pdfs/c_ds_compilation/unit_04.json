  "syntax": [
    {
      "label": "프로그램 2.1 순환적인 팩토리얼",
      "code": "int factorial(int n)\n{\n    if( n <= 1 ) return(1);\n    else return (n * factorial(n-1) );\n}",
      "refs": [
        {
          "source": "A",
          "section": "2.1 프로그램 2.1",
          "pages": [
            35
          ]
        }
      ],
      "evidence": "n * factorial",
      "note": null
    },
    {
      "label": "프로그램 2.5 순환적인 거듭제곱",
      "code": "double power(double x, int n)\n{\n    if( n==0 ) return 1;\n    else if ( (n%2)==0 )\n        return power(x*x, n/2);\n    else return x*power(x*x, (n-1)/2);\n}",
      "refs": [
        {
          "source": "A",
          "section": "2.2 프로그램 2.5",
          "pages": [
