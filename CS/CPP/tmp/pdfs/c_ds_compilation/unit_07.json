  "syntax": [
    {
      "label": "원형큐 공백·포화 검출 함수",
      "code": "int is_empty(QueueType *q)\n{\n    return (q->front == q->rear);\n}\nint is_full(QueueType *q)\n{\n    return ((q->rear + 1) % MAX_QUEUE_SIZE == q->front);\n}",
