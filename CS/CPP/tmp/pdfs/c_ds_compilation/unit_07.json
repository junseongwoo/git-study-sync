      "note": null
    }
  ],
  "formulas": [
    {
      "label": "A의 원형 회전",
      "expression": "front ← (front+1) % MAX_QUEUE_SIZE; rear ← (rear+1) % MAX_QUEUE_SIZE;",
      "refs": [
        {
          "source": "A",
          "section": "5.3 원형큐의 삽입, 삭제 알고리즘",
