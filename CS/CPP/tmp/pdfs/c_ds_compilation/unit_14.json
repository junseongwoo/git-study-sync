  "syntax": [
    {
      "label": "seq_search() 원문 발췌",
      "code": "int seq_search(int key, int low, int high)\n{\n    int i;\n    for (i = low; i <= high; i++)\n        if (list[i] == key)\n            return i; // 탐색에 성공하면 키 값의 인덱스 반환\n    return -1;        // 탐색에 실패하면 -1 반환\n}",
      "refs": [
        {
          "source": "A",
          "section": "13.2 프로그램 13.1",
          "pages": [
            488
          ]
        }
      ],
      "evidence": "int seq_search",
      "note": null
    }
  ],
